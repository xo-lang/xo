// The worker pool in Xo (decision 0212 stage 2, decision 0195
// prerequisite 6): the runtime's locks and their futex style waits, the
// worker records and the inject queue, waking and idling workers, the
// steal rounds, the run loop of a worker thread and its start, and the
// fiber stacks (mapped with a guard page, kept in caches). The C runtime
// (std/llrt/xo_rt.c) calls them through cabi.xo (xo_x_pool_push and
// friends); sched.xo below them is the run queue ring and the fibers'
// switches. Their C path (XO_LLRT_C=sched, -DXO_SCHED_C) was deleted on
// 2026-10-14.
//
// Lock order (decision 0286, 2026-10-20): a park's lock (PK_*, a
// context's C_PARK) before the pool's (the pool record's word 0): signal
// holds a park's lock while push and wakep take the pool's, so code that
// holds the pool's lock never takes a park's (the other order deadlocked
// xo's own parallel build, gotchas/scheduler-lock-order.md). With
// XO_LOCKCHECK=1 plock and klock check it on every acquisition (klock with
// the pool's lock held is a fatal "lock order" error).
//
// The records are xo_rt.c's (the pool, xo_worker, the fiber cache, the
// lock), asserted there with _Static_assert against the constants
// below. The code keeps sched.xo's discipline without its check (it
// calls its own functions, which compiler/ssa contract.xo's check does
// not allow): Int words only, wrapping arithmetic, nothing allocated
// from the heap of Xo values (records come from rt.heap_large, the C's
// malloc), and no fault, so it runs on a worker's own stack with no
// current context and never unwinds into its C callers.
use native/llrt/linux
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sched
use native/llrt/sysio
use native/llrt/tracerec
use native/llrt/twflags
use native/rt
use native/sys_darwin
use native/sys_windows

/// C11's orders of the slot atomics.
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2
const SEQ_CST = 4

/// The pool record (made by ctx.xo init; word indexes for the slot atomics and
/// byte offsets for loads): its lock (pool.mu: the idle list,
/// starting workers), the CPUs, the spin rounds, the records used, the
/// worker threads alive, idle, and spinning, the idle list, the inject
/// queue's lock, buffer, head, length, and capacity, the fiber cache's
/// record, the address of xo_x_worker_main, and the records from word 16.
const P_MU = 0
const P_NCPU = 8
const P_SPIN_ROUNDS = 16
const P_NW = 3
const P_ALIVE = 4
const P_NIDLE = 5
const P_SPINNING = 6
const P_IDLE = 56
const P_IMU = 64
const P_IBUF = 72
const P_IHEAD = 80
const P_ILEN = 11
const P_ILEN_AT = 88
const P_ICAP = 96
const P_FIBERS = 104
const P_WORKER_MAIN = 112
const P_DLK = 120
const P_WS = 128
const MAXW = 4096

/// xo_worker (byte offsets): the ring (sched.xo), next and when it was
/// put there, live, the hooks word, the idle futex word (word 279), the
/// idle list's link, the steal rounds' random state, nonext, the fiber
/// cache and its count, the pool, and a scratch batch of RUNQ / 2 + 1
/// words (a steal's, the inject queue's share, a full ring's half).
const W_NEXT = 2184
const W_NEXT_I = 273
const W_NEXT_AT = 2192
const W_LIVE = 2200
const W_HOOKS = 2216
const W_WAKEW = 2232
const W_WAKEW_I = 279
const W_IDLE_NEXT = 2240
const W_RNG = 2248
const W_NONEXT = 2256
const W_FCACHE = 2264
const W_NFCACHE = 2328
const W_POOL = 2360
const W_BATCH = 2368
/// When this worker took a deferred wake (defer_wake), 0 for none.
const W_DEFER_AT = 3400
/// A root's record (poolsetup.xo W_ROOT: main's thread, not a worker).
const W_ROOT = 2204
/// W_DEFER_AT as a word index (the slot atomics; a constant: `W_DEFER_AT
/// / 8` was divided at run time, 2026-10-16).
const W_DEFER_AT_W = 425
/// The waker's runtime calls since (defer_check reads the clock every
/// 16th).
const W_DEFER_N = 3408
/// The execution trace's current chunk of this worker (trace.xo
/// W_CHUNK, decision 0240), 0 when off.
const W_TRACE = 3416
/// ctx.xo C_TRACE: the context's trace word.
const C_TRACE = 344
/// ctx.xo C_WHY, C_PARK_FP (`xo dump`, decision 0251)
const C_WHY = 336
const C_PARK_FP = 352
/// When this worker last granted readers a RWMutex (mutex.xo
/// grant_readers; ns): a thief leaves its ring alone for GRACE_NS after
/// (steal_round), so the granted readers run here, with the lock's cache
/// lines and the value, when this worker gets to them in time.
const W_GRACE_AT = 3424
const W_GRACE_AT_W = 428
/// The least time a steal round of this worker found left on another's
/// grace (ns, 0 when none): find_work waits it out once, the bound on how
/// long a grant can wait for a worker that keeps computing.
const W_GRACE_WAIT = 3432
/// Whether this worker's thread holds the pool's lock (plock, checked by
/// klock when XO_LOCKCHECK=1).
const W_POOLHELD = 3440
/// When this worker started running its current fiber (mono ns, 0 between
/// items; slot word 431), and when the monitor asked it to yield (mono
/// ns, 0 for not asked; slot word 432): preemption (decision 0286 step 3,
/// mon_scan, preempt).
const W_RUN_AT_I = 431
const W_PREEMPT_I = 432
/// How many runtime locks this worker's thread holds (held): preempt
/// yields only at none (decision 0286 step 3: std's loops poll, and the
/// runtime calls std with its spin locks held).
const W_LOCKS = 3464
/// Asynchronous preemption (decision 0318): the fibers this worker
/// preempted with SIGURG (head and tail, linked by F_NEXT), which only it
/// resumes; its thread (darwin's pthread_t, Linux's thread id) for the
/// monitor's signal; 1 while its run loop runs fibers (worker_main,
/// root_main); 1 between the handler's yield and run_fiber's requeue;
/// SIGURG's bit in a signal set (the handler's unblock).
const W_PIN = 3472
const W_PIN_TAIL = 3480
const W_THREAD = 3488
const W_APOK = 3496
const W_ASYNC = 3504
const W_URGSET = 3512
/// The fiber this worker runs (run_fiber; 0 between fibers): Windows'
/// preemption reads it from the monitor's thread (decision 0318).
const W_RUNF = 3520
/// The record's size; poolsetup.xo's W_SIZE (the root's record) must match
/// (XO_HEAP_GUARD found it 8 bytes short, 2026-10-20).
const W_SIZE = 3528
const FCACHE = 8

/// xo_runq: head (word 0), tail (word 16).
const RQ_TAIL = 16
const RQ_TAIL_AT = 128
const RUNQ = 256
const RUNQ_HALF = 128

/// The fiber cache record (xo_rt.c `fibers`): its lock, the list, its
/// length, the stack size (without the guard page), the page size, the
/// address of xo_x_fiber_main (where a fiber starts).
const FS_MU = 0
const FS_LIST = 1
const FS_LIST_AT = 8
const FS_N = 16
const FS_STACK = 24
const FS_PAGE = 32
const FS_MAIN = 40
/// The shared cache's takes and returns so far (under its lock): a worker
/// that slept FIBER_TRIM_US with no change trims the cache (fiber_trim).
const FS_OPS = 48
/// The stacks the shared cache keeps: up to the recent peak, FIBER_CACHE
/// at most, and FIBER_KEEP once the pool has been idle FIBER_TRIM_US
/// (2026-10-19, Go's scavenger in spirit: with 64 at most, a burst of 2,000
/// connections mapped and unmapped about 1,840 stacks, 116,000 minor
/// faults per 150 bursts and server threads waiting on munmap's lock;
/// Xo Lang 3's loadgen -burst on linux/arm64).
const FIBER_CACHE = 4096
const FIBER_KEEP = 64
const FIBER_TRIM_US = 3000000

/// xo_fiber (sched.xo): the mapping and its size, the task, the context,
/// the state (word 5), the end flag, the cache's link, the hooks word.
const F_SP = 0
const F_MEM = 8
const F_SIZE = 16
const F_TASK = 24
const F_CUR = 32
const F_STATE = 5
const F_DONE = 48
const F_NEXT = 64
const F_HOOKS = 80
/// The fiber's no-preemption count (decision 0318 stage 4): LLVM builds'
/// runtime functions that reach a thread's own structures hold it up
/// while they run (compiler/llvm apreempt.xo), and the signal handler
/// declines while it is not 0.
pub const F_NOPRE = 120
const F_RECORD = 128
/// Main's fiber (decision 0286 step 1): the marker in its task word (a
/// task record is never at 1), the program's entry, its root's record,
/// whether main ended (word 13), and its record's size.
pub const MAIN_TASK = 1
pub const F_ENTRY = 88
const F_ROOT = 96
const F_ENDED = 104
const F_ENDED_I = 13
/// The park of main's counted wait while it is parked, 0 for none
/// (root_idle counts it blocked): byte 112, word 14.
const F_WAIT_I = 14
const F_MAIN_RECORD = 128

/// The part of a fiber's stack committed up front on Windows.
const WIN_COMMIT = 65536

/// The words of the thread local table (sched.xo TLS_*): the worker
/// record, and a scratch word for the platform calls that take the
/// address of a value (WaitOnAddress, SetThreadStackGuarantee).
const TLS_CUR = 0
const TLS_W = 2
/// The fiber this thread runs now (sched.xo TLS_FIB_AT / 8), 0 on its
/// scheduler's stack.
const TLS_FIB = 1
const TLS_SCRATCH_AT = 32

/// The test world's clock move after a deadlock check, while the clock
/// is virtual: cabi_tw.xo's tw_kick, which twrun.xo start puts in the
/// test world's record (it was rt.sched_rt op 2 to the C's weak call).
fn kick() {
  let w = twflags.rec()
  if w != 0 {
    let f = rt.mem_load(w, twflags.TW_KICK, 8)
    if f != 0 {
      let _r = rt.call_c2(f, 0, 0)
    }
  }
}

/// The statistics' counters (xo_rt.c st, in its order).
const ST_STEAL = 1
const ST_INJECT = 2
const ST_WAKE = 3
const ST_IDLE_SLEEP = 4
const ST_SPIN_ROUND = 5
const ST_FIBER_NEW = 7
const ST_THREAD_WAIT = 8
const ST_THREAD_WAKE = 9
const ST_LOCK_SLOW = 10
const ST_MON_TICK = 23
const ST_MON_WAKE = 24
const ST_DEFER = 25
/// futex (ulock, WaitOnAddress) calls, and the slow paths of the
/// inject queue's, a descriptor's (poll.xo), the pool's, and a park's
/// locks (2026-10-21: which handoff costs the futex calls)
const ST_FUTEX_WAIT = 26
const ST_FUTEX_WAKE = 27
const ST_LOCK_INJECT = 28
pub const ST_LOCK_PD = 29
const ST_LOCK_POOL = 30
const ST_LOCK_PARK = 31
pub const ST_LOCK_HTTP = 32
pub const ST_LOCK_CHAN = 33
pub const ST_LOCK_MUTEX = 34
pub const ST_LOCK_TASK = 35
const ST_PREEMPT = 36

/// How long a fiber stays in its waker's next before a thief may take
/// it (xo_rt.c XO_NEXT_GRACE_NS).
const NEXT_GRACE_NS = 50000

/// A reader grant's grace (W_GRACE_AT).
const GRACE_NS = 20000

/// The stack a worker thread reserves (as the threads before fibers).
const THREAD_STACK = 67108864

/// The OS layer of the build (sysio.xo layer): 1 Linux system calls, 2
/// libSystem, 3 kernel32, 0 none (a wasm module has no pool).
fn layer() -> Int {
  match target.arch {
    TargetArch.Wasm32 => 0
    TargetArch.Arm64 | TargetArch.Amd64 => {
      match target.os {
        TargetOs.Linux => 1
        TargetOs.Darwin => 2
        TargetOs.Windows => 3
        TargetOs.Wasi => 0
      }
    }
  }
}

fn stat(k: Int) {
  rtstats.count(k)
}

// ---------------------------------------------------------------------------
// Futexes (decision 0077): wait while the 32 bit word at an address (the
// low half of a lock or futex word) holds a value, and wake a thread
// waiting on it. Darwin has no public futex: its __ulock calls are what
// libc++ uses for std::atomic::wait.

/// Sleeps while the 32 bit word at a holds v (or until a wake up, or
/// spuriously).
pub fn futex_wait(a: Int, v: Int) {
  stat(ST_FUTEX_WAIT)
  match layer() {
    1 => {
      // FUTEX_WAIT_PRIVATE
      let _r = linux.futex(a, 128, v, 0)
    }
    2 => {
      // UL_COMPARE_AND_WAIT | ULF_NO_ERRNO
      let _r = sys_darwin.__ulock_wait(16777217, a, v, 0)
    }
    3 => {
      let cmp = rt.tlocal_addr().wrapping_add(TLS_SCRATCH_AT)
      rt.mem_store(cmp, 0, v, 4)
      let _r = sys_windows.WaitOnAddress(a, cmp, 4, 4294967295)
    }
    _ => {}
  }
}

/// futex_wait for at most about us microseconds.
pub fn futex_wait_us(a: Int, v: Int, us: Int) {
  stat(ST_FUTEX_WAIT)
  match layer() {
    1 => {
      // a relative struct timespec in the thread's scratch words
      let ts = rt.tlocal_addr().wrapping_add(TLS_SCRATCH_AT)
      rt.mem_store(ts, 0, us / 1000000, 8)
      rt.mem_store(ts, 8, (us % 1000000) * 1000, 8)
      let _r = linux.futex(a, 128, v, ts)
    }
    2 => {
      let _r = sys_darwin.__ulock_wait(16777217, a, v, us)
    }
    3 => {
      let cmp = rt.tlocal_addr().wrapping_add(TLS_SCRATCH_AT)
      rt.mem_store(cmp, 0, v, 4)
      let ms = if us < 1000 { 1 } else { us / 1000 }
      let _r = sys_windows.WaitOnAddress(a, cmp, 4, ms)
    }
    _ => {}
  }
}

/// Wakes a thread sleeping on the word at a.
pub fn futex_wake(a: Int) {
  stat(ST_FUTEX_WAKE)
  match layer() {
    1 => {
      // FUTEX_WAKE_PRIVATE
      let _r = linux.futex(a, 129, 1, 0)
    }
    2 => {
      let _r = sys_darwin.__ulock_wake(16777217, a, 0)
    }
    3 => sys_windows.WakeByAddressSingle(a)
    _ => {}
  }
}

// ---------------------------------------------------------------------------
// Locks (xo_rt.c xo_lock, decision 0077): a word that is 0 (free), 1
// (held), or 2 (held, a thread may sleep on it). A contended lock spins
// a little, then sleeps on the word; an unlock makes a system call only
// when someone may sleep. The C takes and releases the word inline and
// calls lock_slow and futex_wake for the rest; so does the code here
// (`if !rt.slot_cas(l, 0, 0, 1, ACQUIRE) { lock_slow(l) }` at each site:
// a call of a lock function cost arm64 builds a call per lock).

/// Takes the lock at l after its first try failed.
pub fn lock_slow(l: Int) {
  stat(ST_LOCK_SLOW)
  var i = 0
  while i < 100 {
    rt.spin_hint()
    if rt.slot_load(l, 0, RELAXED) == 0 && rt.slot_cas(l, 0, 0, 1, ACQUIRE) {
      return
    }
    i = i.wrapping_add(1)
  }
  while rt.slot_swap(l, 0, 2, ACQUIRE) != 0 {
    futex_wait(l, 2)
  }
}

/// Takes the lock word l (xo_rt.c lk).
pub fn lock(l: Int) {
  if !rt.slot_cas[Int](l, 0, 0, 1, ACQUIRE) {
    lock_slow(l)
  }
  held(1)
}

/// lock, counting a slow path as statistic k (one of the ST_LOCK_* of
/// the runtime's modules, under XO_RTSTATS=1).
pub fn lock_k(l: Int, k: Int) {
  if !rt.slot_cas[Int](l, 0, 0, 1, ACQUIRE) {
    stat(k)
    lock_slow(l)
  }
  held(1)
}

pub fn unlock(l: Int) {
  held(-1)
  if rt.slot_swap(l, 0, 0, RELEASE) == 2 {
    futex_wake(l)
  }
}

// ---------------------------------------------------------------------------
// Worker threads

/// Sets worker record w's hooks word while the statistics count
/// (xo_rt.c sched_hooks; the sanitizers' part is sanhook.xo
/// worker_start).
pub fn stat_hooks(w: Int) { rt.mem_store(w, W_HOOKS, if rtstats.on() { 1 } else { 0 }, 8) }

/// Adds worker record w to the records thieves look at (the pool's lock
/// held).
pub fn register_worker(p: Int, w: Int) {
  let n = rt.mem_load(p, P_NW * 8, 8)
  if n >= MAXW {
    let _r = rt.call_c2(rt.fn_addr("oom"), 0, 0)
  }
  rt.mem_store(w, W_RNG, w.wrapping_mul(-7046029254386353131) | 1, 8)
  rt.mem_store(w, W_POOL, p, 8)
  rt.mem_store(p, P_WS.wrapping_add(n.wrapping_shl(3)), w, 8)
  rt.slot_store(p, P_NW, n.wrapping_add(1), SEQ_CST)
}

/// Starts a thread running the C function at f with arg (detached, a 64
/// MiB stack reserved): whether it started.
pub fn thread_start(f: Int, arg: Int) -> Bool {
  match layer() {
    2 => {
      // pthread_attr_t (64 bytes) and the pthread_t
      let a = rt.heap_large(80)
      var ok = Int(sys_darwin.pthread_attr_init(a)) == 0
      if ok {
        let _s = sys_darwin.pthread_attr_setstacksize(a, THREAD_STACK)
        // PTHREAD_CREATE_DETACHED
        let _d = sys_darwin.pthread_attr_setdetachstate(a, 2)
        ok = Int(sys_darwin.pthread_create(a.wrapping_add(64), a, f, arg)) == 0
        let _x = sys_darwin.pthread_attr_destroy(a)
      }
      rt.heap_release(a.wrapping_sub(8))
      ok
    }
    3 => {
      // STACK_SIZE_PARAM_IS_A_RESERVATION: Windows commits the stack as
      // it grows (guard page)
      let h = sys_windows.CreateThread(0, THREAD_STACK, f, arg, 65536, 0)
      if h == 0 {
        return false
      }
      let _c = sys_windows.CloseHandle(h)
      true
    }
    _ => sanhook.thread_start(f, arg, THREAD_STACK)
  }
}

/// Runs the C function f with arg on n threads at once, each with a stack
/// of size bytes reserved, and waits for them all (main's thread, which
/// entry.xo main starts with run_main: 1 GiB, n copies): whether every
/// one started (those that did are waited for).
pub fn thread_run(f: Int, arg: Int, size: Int, n: Int) -> Bool {
  match layer() {
    2 => {
      // pthread_attr_t (64 bytes), then the n pthread_t
      let a = rt.heap_large(64 + n * 8)
      let ts = a.wrapping_add(64)
      var started = 0
      if Int(sys_darwin.pthread_attr_init(a)) == 0 {
        let _s = sys_darwin.pthread_attr_setstacksize(a, size)
        while started < n && Int(sys_darwin.pthread_create(ts.wrapping_add(started * 8), a, f, arg)) == 0 {
          started = started + 1
        }
        let _x = sys_darwin.pthread_attr_destroy(a)
      }
      var i = 0
      while i < started {
        let _j = sys_darwin.pthread_join(rt.mem_load(ts, i * 8, 8), 0)
        i = i + 1
      }
      rt.heap_release(a.wrapping_sub(8))
      started == n
    }
    3 => {
      // STACK_SIZE_PARAM_IS_A_RESERVATION; run_main sets its stack
      // guarantee (the stack overflow handler's)
      let hs = rt.heap_large(n * 8)
      var started = 0
      while started < n {
        let h = sys_windows.CreateThread(0, size, f, arg, 65536, 0)
        if h == 0 {
          break
        }
        rt.mem_store(hs, started * 8, h, 8)
        started = started + 1
      }
      var i = 0
      while i < started {
        let h = rt.mem_load(hs, i * 8, 8)
        let _w = sys_windows.WaitForSingleObject(h, 4294967295)
        let _c = sys_windows.CloseHandle(h)
        i = i + 1
      }
      rt.heap_release(hs.wrapping_sub(8))
      started == n
    }
    _ => sanhook.thread_run(f, arg, size, n)
  }
}

/// Starts a worker thread, which starts spinning (the pool's lock held, a
/// spinning count already taken for it): whether it started.
fn start_worker(p: Int) -> Bool {
  let w = rt.heap_large(W_SIZE)
  rt.mem_set(w, 0, W_SIZE)
  rt.mem_store(w, W_LIVE, 1, 4)
  register_worker(p, w)
  rt.slot_store(p, P_ALIVE, rt.slot_load(p, P_ALIVE, SEQ_CST).wrapping_add(1), SEQ_CST)
  if thread_start(rt.mem_load(p, P_WORKER_MAIN, 8), w) {
    return true
  }
  rt.mem_store(w, W_LIVE, 0, 4)
  rt.slot_store(p, P_ALIVE, rt.slot_load(p, P_ALIVE, SEQ_CST).wrapping_sub(1), SEQ_CST)
  false
}

/// Makes sure queued work gets a worker: unless one is spinning, an idle
/// worker is woken (or a new one started while fewer than one per CPU
/// run) as a spinning worker.
/// The worker threads alive: P_ALIVE without the roots in their loop.
fn workers(p: Int) -> Int {
  rt.slot_load(p, P_ALIVE, SEQ_CST).wrapping_sub(rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_LOOPS, SEQ_CST))
}

fn wakep(p: Int) {
  if rt.slot_load(p, P_SPINNING, SEQ_CST) != 0 {
    return
  }
  let ncpu = rt.mem_load(p, P_NCPU, 8)
  if rt.slot_load(p, P_NIDLE, SEQ_CST) == 0 && workers(p) >= ncpu {
    // every worker busy: one waiting in the poller takes it (decision
    // 0324), and the monitor's ticks preempt one past its slice
    np_break(p)
    preempt_arm(p)
    return
  }
  if !rt.slot_cas(p, P_SPINNING, 0, 1, SEQ_CST) {
    return
  }
  plock(p)
  let w = rt.mem_load(p, P_IDLE, 8)
  if w != 0 {
    rt.mem_store(p, P_IDLE, rt.mem_load(w, W_IDLE_NEXT, 8), 8)
    rt.mem_store(w, W_IDLE_NEXT, 0, 8)
    rt.slot_add(p, P_NIDLE, -1, SEQ_CST)
    punlock(p)
    stat(ST_WAKE)
    if tracerec.built() && tracerec.on() {
      tracerec.ev(tracerec.K_WAKEP, 0, w, 0)
    }
    rt.slot_store(w, W_WAKEW_I, 1, RELEASE)
    futex_wake(w.wrapping_add(W_WAKEW))
    return
  }
  let started = workers(p) < ncpu && start_worker(p)
  punlock(p)
  if !started {
    rt.slot_add(p, P_SPINNING, -1, SEQ_CST)
    np_break(p)
  }
}

// ---------------------------------------------------------------------------
// Workers polling the network themselves (decision 0324, Go's netpoller
// model): a worker out of work polls without waiting (find_work), an idle
// one waits in the poller instead of its futex (go_idle), one at a time
// (poll.xo's token); the poller thread is their fallback. Through the
// exports cabi.xo np_poll and np_break: poll.xo imports this module.

/// w polls once (block: waiting for the next event or timer), the fibers
/// it readies pushed to its ring with no wake each (W_NONEXT 2), then
/// spread (np_spread): the events and timers handled, or -1 when it did
/// not poll.
fn np_poll(p: Int, w: Int, block: Bool) -> Int {
  let was = rt.mem_load(w, W_NONEXT, 8)
  rt.mem_store(w, W_NONEXT, 2, 8)
  let n = rt.call_c2(rt.fn_addr("np_poll"), if block { 1 } else { 0 }, 0)
  rt.mem_store(w, W_NONEXT, was, 8)
  if n > 0 {
    np_spread(p, w)
  }
  n
}

/// After a poll queued k fibers on w's ring with no wake each: one wakep
/// when more than one did, and a woken worker that finds work wakes the
/// next (find_work), as Go's injectglist with no idle P. Waking an idle
/// worker for each (Go's rule with idle Ps) cut inject but raised the
/// wakes and futex calls a request by 12 to 19% on bench/perf http
/// (2026-10-21).
fn np_spread(p: Int, w: Int) {
  let k = rt.slot_load(w, RQ_TAIL, SEQ_CST).wrapping_sub(rt.slot_load(w, 0, SEQ_CST))
  if k > 1 {
    wakep(p)
  }
}

/// An idle w waits in the poller instead of its futex, off the idle
/// list and counted by DLK_NPBLK: -1 when it could not (the token is
/// taken, workers do not poll), else the events and timers it handled
/// (0: look again). The root passes main's fiber mf (else 0): main
/// ending breaks the wait too (main_ended).
fn np_block(p: Int, w: Int, mf: Int) -> Int {
  let dlk = rt.mem_load(p, P_DLK, 8)
  rt.slot_add(dlk, DLK_NPBLK, 1, SEQ_CST)
  // a push (or main's end) before the count went up broke no wait: look
  if any_work(p) != 0 || mf != 0 && rt.slot_load(mf, F_ENDED_I, SEQ_CST) != 0 {
    rt.slot_add(dlk, DLK_NPBLK, -1, SEQ_CST)
    return 0
  }
  plock(p)
  dl_check(p)
  punlock(p)
  let n = np_poll(p, w, true)
  rt.slot_add(dlk, DLK_NPBLK, -1, SEQ_CST)
  n
}

/// Breaks the wait of a worker in the poller, if one waits (wakep found
/// no other worker for the work).
fn np_break(p: Int) {
  if rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_NPBLK, SEQ_CST) > 0 {
    let _b = rt.call_c2(rt.fn_addr("np_break"), 0, 0)
  }
}

// ---------------------------------------------------------------------------
// The inject queue: items from threads without a record (the poller), and
// half of a ring that was full.

/// Adds the n items at src, then x unless it is 0, to the inject queue.
fn inject_add(p: Int, src: Int, n: Int, x: Int) {
  let im = p.wrapping_add(P_IMU)
  let all = if x != 0 { n.wrapping_add(1) } else { n }
  if !rt.slot_cas(im, 0, 0, 1, ACQUIRE) {
    stat(ST_LOCK_INJECT)
    lock_slow(im)
  }
  held(1)
  let len = rt.mem_load(p, P_ILEN_AT, 8)
  var cap = rt.mem_load(p, P_ICAP, 8)
  var head = rt.mem_load(p, P_IHEAD, 8)
  var buf = rt.mem_load(p, P_IBUF, 8)
  if len.wrapping_add(all) > cap {
    var nc = if cap != 0 { cap.wrapping_shl(1) } else { 64 }
    while nc < len.wrapping_add(all) {
      nc = nc.wrapping_shl(1)
    }
    let nb = rt.heap_large(nc.wrapping_shl(3))
    var i = 0
    while i < len {
      rt.mem_store(nb, i.wrapping_shl(3), rt.mem_load(buf, (head.wrapping_add(i) % cap).wrapping_shl(3), 8), 8)
      i = i.wrapping_add(1)
    }
    if buf != 0 {
      rt.heap_release(buf.wrapping_sub(8))
    }
    buf = nb
    head = 0
    cap = nc
    rt.mem_store(p, P_IBUF, buf, 8)
    rt.mem_store(p, P_IHEAD, 0, 8)
    rt.mem_store(p, P_ICAP, cap, 8)
  }
  var i = 0
  while i < all {
    let it = if i < n { rt.mem_load(src, i.wrapping_shl(3), 8) } else { x }
    rt.mem_store(buf, (head.wrapping_add(len).wrapping_add(i) % cap).wrapping_shl(3), it, 8)
    i = i.wrapping_add(1)
  }
  rt.slot_store(p, P_ILEN, len.wrapping_add(all), SEQ_CST)
  unlock(im)
}

/// Takes a share of the inject queue for w (0: a thread without a
/// record, which takes one item): one item to run, the rest into w's
/// empty ring; 0 when it is empty.
fn inject_pop(p: Int, w: Int) -> Int {
  if rt.slot_load(p, P_ILEN, SEQ_CST) == 0 {
    return 0
  }
  let im = p.wrapping_add(P_IMU)
  var n = 0
  var first = 0
  if !rt.slot_cas(im, 0, 0, 1, ACQUIRE) {
    stat(ST_LOCK_INJECT)
    lock_slow(im)
  }
  held(1)
  let len = rt.mem_load(p, P_ILEN_AT, 8)
  if len > 0 {
    n = (len / rt.mem_load(p, P_NCPU, 8).wrapping_add(1)).wrapping_add(1)
    if n > len {
      n = len
    }
    if n > RUNQ_HALF {
      n = RUNQ_HALF
    }
    if w == 0 {
      n = 1
    }
    let buf = rt.mem_load(p, P_IBUF, 8)
    let cap = rt.mem_load(p, P_ICAP, 8)
    var head = rt.mem_load(p, P_IHEAD, 8)
    var i = 0
    while i < n {
      let it = rt.mem_load(buf, head.wrapping_shl(3), 8)
      if i == 0 {
        first = it
      } else {
        rt.mem_store(w, W_BATCH.wrapping_add(i.wrapping_sub(1).wrapping_shl(3)), it, 8)
      }
      head = head.wrapping_add(1) % cap
      i = i.wrapping_add(1)
    }
    rt.mem_store(p, P_IHEAD, head, 8)
    rt.slot_store(p, P_ILEN, len.wrapping_sub(n), RELAXED)
  }
  unlock(im)
  if n == 0 {
    return 0
  }
  if w != 0 {
    if rt.mem_load(w, W_HOOKS, 8) != 0 {
      stat(ST_INJECT)
    }
    if n > 1 {
      owner_check(w)
      sched.rq_put_batch(w, w.wrapping_add(W_BATCH), n.wrapping_sub(1))
    }
  }
  first
}

/// Takes the item at the head of w's ring (the owner) when it is a task
/// of scope s, else 0 (scope_join). The item is taken first, then looked
/// at: a task only a queue entry holds may be run and freed by a thief
/// once it takes the entry, so its fields are read only while the entry
/// is this thread's (ThreadSanitizer, conc_stress, 2026-10-17). Another
/// item goes back to the ring's tail, and the join stops taking.
fn ring_get_scope(p: Int, w: Int, s: Int) -> Int {
  owner_check(w)
  let x = sched.rq_get(w)
  if x == 0 {
    return 0
  }
  if (x & 1) == 0 && rt.mem_load(x, T_SCOPE, 8) == s {
    // this thread runs its own work: no wake is owed (as take_local; a
    // deferral left set made the monitor wake the one worker 1 ms into
    // a long join, which then stole from it, TestOneThreadSpawnJoin)
    if rt.slot_load(w, W_DEFER_AT_W, RELAXED) != 0 {
      rt.slot_store(w, W_DEFER_AT_W, 0, RELAXED)
    }
    return x
  }
  rq_put(p, w, x)
  0
}

/// Takes the inject queue's oldest item when it is a task of scope s,
/// else 0 (scope_join: the tasks a ring that was full moved here).
fn inject_get_scope(p: Int, s: Int) -> Int {
  if rt.slot_load(p, P_ILEN, SEQ_CST) == 0 {
    return 0
  }
  let im = p.wrapping_add(P_IMU)
  if !rt.slot_cas(im, 0, 0, 1, ACQUIRE) {
    stat(ST_LOCK_INJECT)
    lock_slow(im)
  }
  held(1)
  var it = 0
  let len = rt.mem_load(p, P_ILEN_AT, 8)
  if len > 0 {
    let buf = rt.mem_load(p, P_IBUF, 8)
    let cap = rt.mem_load(p, P_ICAP, 8)
    let head = rt.mem_load(p, P_IHEAD, 8)
    let x = rt.mem_load(buf, head.wrapping_shl(3), 8)
    if (x & 1) == 0 && rt.mem_load(x, T_SCOPE, 8) == s {
      it = x
      rt.mem_store(p, P_IHEAD, head.wrapping_add(1) % cap, 8)
      rt.slot_store(p, P_ILEN, len.wrapping_sub(1), RELAXED)
    }
  }
  unlock(im)
  it
}

// ---------------------------------------------------------------------------
// Queues

/// Adds x to the ring of w (the owner); a full ring moves half of itself
/// and x to the inject queue.
fn rq_put(p: Int, w: Int, x: Int) {
  while true {
    owner_check(w)
    if sched.rq_put(w, x) != 0 {
      return
    }
    let h = rt.slot_load(w, 0, ACQUIRE)
    let t = rt.mem_load(w, RQ_TAIL_AT, 8)
    if t.wrapping_sub(h) < RUNQ {
      // thieves took some meanwhile
      continue
    }
    // half of the ring into w's batch, taken with one compare and swap
    let n = t.wrapping_sub(h) >> 1
    let batch = w.wrapping_add(W_BATCH)
    var i = 0
    while i < n {
      rt.mem_store(batch, i.wrapping_shl(3), rt.slot_load(w, (17).wrapping_add(h.wrapping_add(i) & 255), RELAXED), 8)
      i = i.wrapping_add(1)
    }
    if rt.slot_cas(w, 0, h, h.wrapping_add(n), RELEASE) {
      inject_add(p, batch, n, x)
      return
    }
    // thieves took some: the ring has room again
  }
}

fn push(p: Int, t: Int, handoff: Bool) {
  let w = rt.tlocal_get(TLS_W)
  if w == 0 {
    inject_add(p, 0, 0, t)
  } else if (t & 1) != 0 && rt.mem_load(w, W_NONEXT, 8) == 0 {
    rt.slot_store(w, W_NEXT_AT / 8, sysio.mono_ns(), RELAXED)
    let old = rt.slot_swap(w, W_NEXT_I, t, SEQ_CST)
    if old != 0 {
      rq_put(p, w, old)
    } else if handoff && defer_wake(p, w) {
      if tracerec.built() && tracerec.on() {
        tracerec.ev(tracerec.K_DEFER, 0, w, t)
      }
      return
    }
  } else {
    rq_put(p, w, t)
    if rt.mem_load(w, W_NONEXT, 8) == 2 {
      // a batch of wakes (mutex.xo grant_readers): one wakep after it
      return
    }
  }
  wakep(p)
}

/// The wake after a batch of pushes that skipped theirs (W_NONEXT 2): a
/// spinning worker that finds work wakes the next (find_work), so one
/// starts the chain, and the wakes happen on the workers taking the
/// work, not one by one on the pushing thread (bench/perf/http at 1024
/// connections: an RWMutex writer's unlock woke each waiting reader with
/// its own futex call, 35% of the server's CPU in ulock_wake,
/// 2026-10-21).
pub fn batch_wake(p: Int) { wakep(p) }

/// Takes w's own work: next, then the head of its ring.
fn take_local(w: Int) -> Int {
  var t = 0
  if rt.slot_load(w, W_NEXT_I, RELAXED) != 0 {
    t = rt.slot_swap(w, W_NEXT_I, 0, SEQ_CST)
  }
  if t == 0 {
    owner_check(w)
    t = sched.rq_get(w)
  }
  if t == 0 && rt.mem_load(w, W_PIN, 8) != 0 {
    // a fiber SIGURG preempted (decision 0318): only this worker runs it
    t = pin_pop(w) | 1
  }
  if t != 0 && rt.slot_load(w, W_DEFER_AT_W, RELAXED) != 0 {
    // this worker runs its own work: no wake is owed
    rt.slot_store(w, W_DEFER_AT_W, 0, RELAXED)
  }
  t
}

/// Looks once at every other record, from a random one, and takes half of
/// the first ring it finds items in: one to run, the rest into w's
/// (empty) ring; next only when last is not 0 and it waited there longer
/// than the grace.
pub fn steal_round(p: Int, w: Int, last: Int) -> Int {
  let n = rt.slot_load(p, P_NW, SEQ_CST)
  if n == 0 {
    return 0
  }
  var r = rt.mem_load(w, W_RNG, 8)
  r = r ^ r.wrapping_shl(13)
  r = r ^ r.shr_logical(7)
  r = r ^ r.wrapping_shl(17)
  rt.mem_store(w, W_RNG, r, 8)
  let start = r.shr_logical(1) % n
  let batch = w.wrapping_add(W_BATCH)
  rt.mem_store(w, W_GRACE_WAIT, 0, 8)
  var now = 0
  var i = 0
  while i < n {
    let v = rt.mem_load(p, P_WS.wrapping_add((start.wrapping_add(i) % n).wrapping_shl(3)), 8)
    i = i.wrapping_add(1)
    if v == w {
      continue
    }
    var t = 0
    let nonempty = rt.slot_load(v, 0, SEQ_CST) != rt.slot_load(v, RQ_TAIL, SEQ_CST)
    let ga = if nonempty { rt.slot_load(v, W_GRACE_AT_W, ACQUIRE) } else { 0 }
    if ga != 0 {
      if now == 0 {
        now = sysio.mono_ns()
      }
      let left = GRACE_NS.wrapping_sub(now.wrapping_sub(ga))
      if left > 0 {
        // readers its grant woke, theirs to run for a moment yet
        let seen = rt.mem_load(w, W_GRACE_WAIT, 8)
        if seen == 0 || left < seen {
          rt.mem_store(w, W_GRACE_WAIT, left, 8)
        }
        continue
      }
    }
    let got = if nonempty { sched.rq_grab(v, batch) } else { 0 }
    if got > 0 {
      t = rt.mem_load(batch, got.wrapping_sub(1).wrapping_shl(3), 8)
      if got > 1 {
        owner_check(w)
        sched.rq_put_batch(w, batch, got.wrapping_sub(1))
      }
    }
    if t == 0 && last != 0 {
      let x = rt.slot_load(v, W_NEXT_I, ACQUIRE)
      if x != 0 && sysio.mono_ns().wrapping_sub(rt.slot_load(v, W_NEXT_AT / 8, RELAXED)) > NEXT_GRACE_NS && rt.slot_cas(v, W_NEXT_I, x, 0, SEQ_CST) {
        t = x
      }
    }
    if t != 0 {
      if rt.mem_load(w, W_HOOKS, 8) != 0 {
        stat(ST_STEAL)
      }
      return t
    }
  }
  0
}

/// Whether some queue holds an item (a worker about to sleep looks again
/// after it counted itself idle): 1 or 0.
pub fn any_work(p: Int) -> Int {
  if rt.slot_load(p, P_ILEN, SEQ_CST) > 0 {
    return 1
  }
  let n = rt.slot_load(p, P_NW, SEQ_CST)
  var i = 0
  while i < n {
    let v = rt.mem_load(p, P_WS.wrapping_add(i.wrapping_shl(3)), 8)
    if rt.slot_load(v, W_NEXT_I, SEQ_CST) != 0 || rt.slot_load(v, 0, SEQ_CST) != rt.slot_load(v, RQ_TAIL, SEQ_CST) {
      return 1
    }
    i = i.wrapping_add(1)
  }
  0
}

/// Looks for an item for w: its own, the inject queue, then, if spinning
/// (not 0), steals for a few rounds (the last one also takes next); 0
/// when it found none.
pub fn find_work(p: Int, w: Int, spinning: Int) -> Int {
  var t = take_local(w)
  if t == 0 {
    t = inject_pop(p, w)
  }
  if t == 0 && np_poll(p, w, false) > 0 {
    // the network's ready fibers, on this worker (decision 0324)
    t = take_local(w)
  }
  if t != 0 || spinning == 0 {
    return t
  }
  let rounds = rt.mem_load(p, P_SPIN_ROUNDS, 8)
  let hooks = rt.mem_load(w, W_HOOKS, 8)
  var r = 0
  while r <= rounds && t == 0 {
    if hooks != 0 {
      stat(ST_SPIN_ROUND)
    }
    t = steal_round(p, w, if r == rounds { 1 } else { 0 })
    if t == 0 {
      t = inject_pop(p, w)
    }
    if t == 0 && r < rounds {
      // 32 pauses, unrolled by 8 (clang unrolls the C's loop): a
      // spinning worker's loop overhead was most of a ping pong's
      // difference on arm64 (gotchas/scheduler-instruction-counts-spin.md)
      var i = 0
      while i < 4 {
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        rt.spin_hint()
        i = i.wrapping_add(1)
      }
    }
    r = r.wrapping_add(1)
  }
  let wait = rt.mem_load(w, W_GRACE_WAIT, 8)
  if t == 0 && wait > 0 {
    // a ring left alone for a grant's grace: wait it out, then take from
    // it (the readers' bound when the granting worker keeps computing)
    let until = sysio.mono_ns().wrapping_add(wait)
    while sysio.mono_ns() < until {
      rt.spin_hint()
      rt.spin_hint()
      rt.spin_hint()
      rt.spin_hint()
    }
    t = steal_round(p, w, 1)
  }
  t
}

/// Marks the calling worker's ring as granted readers now (mutex.xo
/// grant_readers, before it signals them): W_GRACE_AT.
pub fn grace_begin() {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    rt.slot_store(w, W_GRACE_AT_W, sysio.mono_ns(), RELEASE)
  }
}

/// Puts w on the idle list and sleeps until wakep takes it off: 1, or 0
/// when work showed up meanwhile (w is then off the list again and not
/// spinning).
fn go_idle(p: Int, w: Int) -> Int {
  count_main(p)
  // decision 0324: wait in the network poller when no one does
  if np_block(p, w, 0) >= 0 {
    return 0
  }
  plock(p)
  rt.slot_store(w, W_WAKEW_I, 0, RELAXED)
  rt.mem_store(w, W_IDLE_NEXT, rt.mem_load(p, P_IDLE, 8), 8)
  rt.mem_store(p, P_IDLE, w, 8)
  rt.slot_add(p, P_NIDLE, 1, SEQ_CST)
  dl_check(p)
  punlock(p)
  if twflags.vclock() != 0 {
    kick()
  }
  // a push before the count went up was not seen by its wakep: look
  if any_work(p) != 0 {
    plock(p)
    var prev = 0
    var x = rt.mem_load(p, P_IDLE, 8)
    while x != 0 && x != w {
      prev = x
      x = rt.mem_load(x, W_IDLE_NEXT, 8)
    }
    if x != 0 {
      let next = rt.mem_load(w, W_IDLE_NEXT, 8)
      if prev == 0 {
        rt.mem_store(p, P_IDLE, next, 8)
      } else {
        rt.mem_store(prev, W_IDLE_NEXT, next, 8)
      }
      rt.mem_store(w, W_IDLE_NEXT, 0, 8)
      rt.slot_add(p, P_NIDLE, -1, SEQ_CST)
      punlock(p)
      return 0
    }
    punlock(p)
    // wakep took it off the list and counted it spinning: wait for its
    // wake up
  }
  if tracerec.built() && tracerec.on() {
    tracerec.ev(tracerec.K_IDLE, 0, w, 0)
  }
  // with stacks past FIBER_KEEP cached, sleep FIBER_TRIM_US first: no
  // wake up and no fiber taken or returned since, and the excess goes
  // (the count and ops read under the cache's lock: plain words other
  // workers write under it)
  let fs = rt.mem_load(p, P_FIBERS, 8)
  if !rt.slot_cas(fs, 0, 0, 1, ACQUIRE) {
    lock_slow(fs)
  }
  held(1)
  let cached = rt.mem_load(fs, FS_N, 8)
  let ops = rt.mem_load(fs, FS_OPS, 8)
  unlock(fs)
  if cached > FIBER_KEEP && rt.slot_load(w, W_WAKEW_I, ACQUIRE) == 0 {
    stat(ST_IDLE_SLEEP)
    futex_wait_us(w.wrapping_add(W_WAKEW), 0, FIBER_TRIM_US)
    if rt.slot_load(w, W_WAKEW_I, ACQUIRE) == 0 {
      fiber_trim(fs, ops)
    }
  }
  while rt.slot_load(w, W_WAKEW_I, ACQUIRE) == 0 {
    stat(ST_IDLE_SLEEP)
    futex_wait(w.wrapping_add(W_WAKEW), 0)
  }
  if tracerec.built() && tracerec.on() {
    tracerec.ev(tracerec.K_IDLE, 1, w, 0)
  }
  1
}

/// The run loop of a worker thread (the C function its thread starts
/// with record w): looks for work, runs it, spins, and sleeps.
pub fn worker_main(w: Int) -> Int {
  let p = rt.mem_load(w, W_POOL, 8)
  rt.tlocal_set(TLS_W, w)
  if layer() == 3 {
    // the stack the thread keeps for its stack overflow handler
    // (xo_rt.c on_overflow), past the guard page
    let g = rt.tlocal_addr().wrapping_add(TLS_SCRATCH_AT)
    rt.mem_store(g, 0, 65536, 4)
    let _g = sys_windows.SetThreadStackGuarantee(g)
  }
  // the hooks word for the statistics, then the sanitizers' record of
  // the thread (decision 0232)
  stat_hooks(w)
  sanhook.worker_start(w)
  async_thread(w)
  // wakep started it as a spinning worker
  var spinning = 1
  while true {
    let it = find_work(p, w, spinning)
    if it != 0 {
      if spinning != 0 {
        spinning = 0
        // the last spinner found work: another one looks for more
        if rt.slot_add(p, P_SPINNING, -1, SEQ_CST) == 1 {
          wakep(p)
        }
      }
      run_item(p, w, it)
      continue
    }
    if spinning != 0 {
      spinning = 0
      rt.slot_add(p, P_SPINNING, -1, SEQ_CST)
    } else if rt.slot_load(p, P_SPINNING, SEQ_CST).wrapping_shl(1) < rt.slot_load(p, P_ALIVE, SEQ_CST).wrapping_sub(rt.slot_load(p, P_NIDLE, SEQ_CST)) {
      // at most half the busy workers spin (Go's rule)
      rt.slot_add(p, P_SPINNING, 1, SEQ_CST)
      spinning = 1
      continue
    }
    if go_idle(p, w) == 0 {
      rt.slot_add(p, P_SPINNING, 1, SEQ_CST)
    }
    // wakep counted it spinning, or it counted itself
    spinning = 1
  }
  0
}

/// Runs a queue item on w's thread: resumes a fiber, or starts a task on
/// a new fiber unless a helper ran it already.
pub fn run_item(p: Int, w: Int, it: Int) {
  if (it & 1) != 0 {
    run_fiber(p, w, it ^ 1)
    return
  }
  if sched.task_claim(it) == 0 {
    // run by a thread that helped: its queue entry is over, and the
    // scope's join waits for that too (no queue holds a task the scope
    // frees)
    let s = rt.mem_load(it, T_SCOPE, 8)
    if sched.task_dequeued(it, s) != 0 {
      let j = rt.mem_load(s, S_JOINER, 8)
      sanhook.release(j)
      park_signal(p, j)
    }
    return
  }
  // claimed: the entry is counted taken when the task ends (one atomic
  // on the scope instead of two)
  run_fiber(p, w, fiber_new(rt.mem_load(p, P_FIBERS, 8), w, it))
}

/// Runs fiber f on w until it parks or ends (then its stack is kept;
/// main's tells its root, root_main).
fn run_fiber(p: Int, w: Int, f: Int) {
  rt.slot_store(w, W_RUN_AT_I, sysio.mono_ns(), RELAXED)
  rt.slot_store(w, W_RUNF / 8, f, RELEASE)
  let r = sched.fiber_run(w, f)
  rt.slot_store(w, W_RUNF / 8, 0, RELEASE)
  if rt.mem_load(w, W_LOCKS, 8) != 0 && rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_LOCKCHECK, RELAXED) != 0 {
    // a fiber switched away holding a runtime lock (XO_LOCKCHECK=1)
    let _r = rt.call_c2(rt.fn_addr("lock_held_switch"), 0, 0)
  }
  rt.slot_store(w, W_RUN_AT_I, 0, RELAXED)
  rt.slot_store(w, W_PREEMPT_I, 0, RELAXED)
  if r == 2 {
    if rt.mem_load(w, W_ASYNC, 8) != 0 {
      // preempted by SIGURG (decision 0318): its registers and the values
      // it derived from this thread are in the signal frame on its stack,
      // so it resumes here, after this worker's queued work
      rt.mem_store(w, W_ASYNC, 0, 8)
      pin_push(w, f)
      return
    }
    // preempted: behind everything queued (the inject queue's tail), and
    // this worker's own ring runs first
    inject_add(p, 0, 0, f | 1)
    return
  }
  if r != 0 {
    if rt.mem_load(f, F_TASK, 8) == MAIN_TASK {
      main_ended(p, f)
      return
    }
    fiber_free(rt.mem_load(p, P_FIBERS, 8), w, f)
  }
}

/// A runtime lock taken (d 1) or released (d -1) by this thread: its
/// worker's count (W_LOCKS; a thread without a worker record counts
/// nothing, and it runs no fiber to preempt). Every spin lock of the
/// runtime calls it after taking and before releasing.
pub fn held(d: Int) {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    rt.mem_store(w, W_LOCKS, rt.mem_load(w, W_LOCKS, 8).wrapping_add(d), 8)
  }
}

/// The slow path of a preemption poll (generated code's loop back edges
/// test the static word W_PREEMPT, decision 0286 step 3): yields the
/// running fiber when the monitor asked this worker to (it has run its
/// item SLICE_NS while work waits); else returns at once (the flag is the
/// pool's, every busy thread sees it). A thread without a fiber (a root
/// with XO_MAIN_FIBER=0, the poller, the monitor) never yields.
pub fn preempt() {
  let w = rt.tlocal_get(TLS_W)
  if w == 0 || rt.slot_load(w, W_PREEMPT_I, RELAXED) == 0 {
    return
  }
  let f = rt.tlocal_get(TLS_FIB)
  if f == 0 || rt.mem_load(w, W_LOCKS, 8) != 0 {
    // no fiber, or a runtime lock held (std code the runtime called):
    // the request stays, for the next poll after the release
    return
  }
  // the ask served: the poll flag counts the asks still out (decision
  // 0286 step 3), so the other workers' polls stop calling the stub
  let a = rt.slot_load(w, W_PREEMPT_I, RELAXED)
  if a != 0 && rt.slot_cas(w, W_PREEMPT_I, a, 0, RELAXED) {
    let _d = rt.slot_add[Int](rt.static_word(W_PREEMPT), 0, -1, RELEASE)
  }
  stat(ST_PREEMPT)
  sched.fiber_yield(f)
}

// ---------------------------------------------------------------------------
// Asynchronous preemption (decision 0318): with no loop polls (the native
// arm64 backend on darwin and Linux, not --race), the monitor sends SIGURG
// to a worker that ran its fiber a slice while work waits, and the
// handler yields from inside itself: the kernel's signal frame on the
// fiber's stack is the continuation, restored exactly by sigreturn when
// the fiber runs again (pinned to its worker). The handler declines at a
// PC outside the program's code: the emitter's tables (compiler/arm64
// apreempt.xo) list each file's functions' text and the unsafe ranges in
// it (the runtime's functions and the runtime code inlined into the
// program's).

/// rt.static_word: the list of the unsafe range tables (the emitter sets
/// it; 0: no asynchronous preemption, the program polls).
const W_UNSAFE = 77
const SIGURG_DARWIN = 16
const SIGURG_LINUX = 23
/// The stack a handler needs above the fiber's mapping start (its guard
/// page, up to 16 KiB): the signal frame (about 1 KiB on Linux, 0.8 on
/// darwin, the vector registers included) and the switch.
const ASYNC_ROOM = 49152
/// Windows: sizeof(CONTEXT) on x86_64, and the save area at a fiber
/// stack's top: two 1,280 byte halves, the interrupted CONTEXT and below
/// it the copy win_kick sends (win_save, win_ctx).
const WIN_CTX = 1232
const WIN_SAVE = 2560

/// Whether the program preempts asynchronously.
fn async_on() -> Bool {
  layer() != 0 && rt.mem_load(rt.static_word(W_UNSAFE), 0, 8) != 0
}

/// SIGURG's handler (cabi.xo on_urg), SA_SIGINFO and SA_RESTART, on the
/// interrupted stack (no SA_ONSTACK), nothing else blocked while it runs.
fn async_install() {
  let h = rt.fn_addr("on_urg")
  match layer() {
    1 => {
      let _r = linux.sigaction(SIGURG_LINUX, h, 4 | 268435456)
    }
    2 => {
      // struct sigaction: the handler, the mask (4 bytes), the flags
      let sa = rt.heap_large(16)
      rt.mem_store(sa, 0, h, 8)
      rt.mem_store(sa, 8, 0, 4)
      rt.mem_store(sa, 12, 64 | 2, 4)
      let _r = sys_darwin.sigaction(SIGURG_DARWIN, sa, 0)
      rt.heap_release(sa - 8)
    }
    _ => {}
  }
}

/// Records the calling thread in worker record w for the monitor's
/// signal, and that its loop runs fibers.
fn async_thread(w: Int) {
  if !async_on() {
    return
  }
  match layer() {
    3 => {
      // a handle the monitor suspends, reads, and redirects:
      // THREAD_SUSPEND_RESUME, THREAD_GET_CONTEXT, THREAD_SET_CONTEXT,
      // THREAD_QUERY_INFORMATION
      rt.mem_store(w, W_THREAD, sys_windows.OpenThread(90, 0, Int(sys_windows.GetCurrentThreadId())), 8)
    }
    1 => {
      // gettid(2)
      rt.mem_store(w, W_THREAD, rt.sys6(if layer_arch() == 1 { 178 } else { 186 }, 0, 0, 0, 0, 0, 0), 8)
      rt.mem_store(w, W_URGSET, (1).wrapping_shl(SIGURG_LINUX - 1), 8)
    }
    _ => {
      rt.mem_store(w, W_THREAD, sys_darwin.pthread_self(), 8)
      rt.mem_store(w, W_URGSET, (1).wrapping_shl(SIGURG_DARWIN - 1), 8)
    }
  }
  rt.mem_store(w, W_APOK, 1, 8)
}

/// The monitor's ask to worker w: SIGURG to its thread.
fn async_kick(w: Int) {
  let t = rt.mem_load(w, W_THREAD, 8)
  if t == 0 {
    return
  }
  match layer() {
    3 => win_kick(w, t)
    1 => {
      // tgkill(getpid(), tid, SIGURG)
      let a64 = layer_arch() == 1
      let pid = rt.sys6(if a64 { 172 } else { 39 }, 0, 0, 0, 0, 0, 0)
      let _r = rt.sys6(if a64 { 131 } else { 234 }, pid, t, SIGURG_LINUX, 0, 0, 0)
    }
    _ => {
      let _r = sys_darwin.pthread_kill(t, SIGURG_DARWIN)
    }
  }
}

/// Windows (no signals): the monitor suspends worker w's thread t, and
/// when it runs a fiber in the program's code with no runtime lock and an
/// ask out, saves its CONTEXT in the fiber's save area (win_ctx) and
/// sends it to cabi.xo on_wpark on the fiber's stack (Windows x64 has no
/// red zone), then resumes it: the park routine yields, and restores the
/// CONTEXT (RtlRestoreContext) when the fiber runs again.
fn win_kick(w: Int, t: Int) {
  if Int(sys_windows.SuspendThread(t)) == -1 {
    return
  }
  let f = rt.slot_load(w, W_RUNF / 8, ACQUIRE)
  if f != 0 && rt.mem_load(w, W_APOK, 8) != 0 && rt.mem_load(w, W_LOCKS, 8) == 0 && rt.mem_load(f, F_NOPRE, 8) == 0 {
    let cx = win_ctx(f)
    // CONTEXT_FULL: control, integer, floating point
    rt.mem_store(cx, 48, 1048587, 4)
    if Int(sys_windows.GetThreadContext(t, cx)) != 0 {
      let pc = rt.mem_load(cx, 248, 8)
      let sp = rt.mem_load(cx, 152, 8)
      let a = rt.slot_load(w, W_PREEMPT_I, RELAXED)
      if a != 0 && sp.wrapping_sub(rt.mem_load(f, F_MEM, 8)) >= ASYNC_ROOM && async_pc_ok(pc) && rt.slot_cas(w, W_PREEMPT_I, a, 0, RELAXED) {
        let _d = rt.slot_add[Int](rt.static_word(W_PREEMPT), 0, -1, RELEASE)
        // a copy to change: rip, rsp (below what the interrupted code
        // used, at a call's alignment), rcx the saved CONTEXT; only
        // control and integer set
        let nx = cx.wrapping_sub(WIN_SAVE / 2)
        rt.mem_copy(nx, cx, WIN_CTX)
        rt.mem_store(nx, 48, 1048579, 4)
        rt.mem_store(nx, 248, rt.fn_addr("on_wpark"), 8)
        rt.mem_store(nx, 152, (sp.wrapping_sub(256) & -16).wrapping_sub(8), 8)
        rt.mem_store(nx, 128, cx, 8)
        let _s = sys_windows.SetThreadContext(t, nx)
      }
    }
  }
  let _r = sys_windows.ResumeThread(t)
}

/// The park routine of Windows' preemption (cabi.xo on_wpark, entered
/// with the thread's registers redirected by win_kick, cx the interrupted
/// CONTEXT): yields the fiber, then resumes the interrupted code exactly.
pub fn async_wpark(cx: Int) {
  let w = rt.tlocal_get(TLS_W)
  let f = rt.tlocal_get(TLS_FIB)
  stat(ST_PREEMPT)
  rt.mem_store(w, W_ASYNC, 1, 8)
  sched.fiber_yield(f)
  sys_windows.RtlRestoreContext(cx, 0)
}

/// Puts fiber f, preempted by SIGURG, on w's own list.
fn pin_push(w: Int, f: Int) {
  rt.mem_store(f, F_NEXT, 0, 8)
  let tail = rt.mem_load(w, W_PIN_TAIL, 8)
  if tail == 0 {
    rt.mem_store(w, W_PIN, f, 8)
  } else {
    rt.mem_store(tail, F_NEXT, f, 8)
  }
  rt.mem_store(w, W_PIN_TAIL, f, 8)
}

/// Takes the first fiber of w's list (not empty).
fn pin_pop(w: Int) -> Int {
  let f = rt.mem_load(w, W_PIN, 8)
  let next = rt.mem_load(f, F_NEXT, 8)
  rt.mem_store(w, W_PIN, next, 8)
  if next == 0 {
    rt.mem_store(w, W_PIN_TAIL, 0, 8)
  }
  rt.mem_store(f, F_NEXT, 0, 8)
  f
}

/// Whether pc is in the program's own code outside every unsafe range:
/// in some file's functions' text (tables: base, size, the ranges' count,
/// then (start, end) offsets as 32 bit pairs, in order), not in a range.
/// A count of -1 (the LLVM backend's one table, compiler/llvm
/// apreempt.xo): the second word is the text's end, and no ranges.
fn async_pc_ok(pc: Int) -> Bool {
  let parts = rt.mem_load(rt.static_word(W_UNSAFE), 0, 8)
  let n = rt.mem_load(parts, 0, 8)
  var i = 0
  while i < n {
    let t = rt.mem_load(parts, 8 + 8 * i, 8)
    let base = rt.mem_load(t, 0, 8)
    let off = pc.wrapping_sub(base)
    let nr = rt.mem_load(t, 16, 8)
    let size = if nr < 0 { rt.mem_load(t, 8, 8).wrapping_sub(base) } else { rt.mem_load(t, 8, 8) }
    if off >= 0 && off < size {
      if nr < 0 {
        return true
      }
      // the last range starting at or before off
      var lo = 0
      var hi = nr
      while lo < hi {
        let mid = (lo + hi) / 2
        if rt.mem_load(t, 24 + 8 * mid, 4) <= off {
          lo = mid + 1
        } else {
          hi = mid
        }
      }
      return lo == 0 || off >= rt.mem_load(t, 24 + 8 * (lo - 1) + 4, 4)
    }
    i += 1
  }
  false
}

/// SIGURG's handler (cabi.xo on_urg) with the interrupted thread's
/// ucontext uc: yields the fiber when the monitor asked this worker to and
/// the interrupted code is the program's own (decision 0318), else
/// returns at once (the monitor asks again).
pub fn async_signal(uc: Int) {
  let w = rt.tlocal_get(TLS_W)
  if w == 0 || uc == 0 || rt.mem_load(w, W_APOK, 8) == 0 || rt.slot_load(w, W_PREEMPT_I, RELAXED) == 0 {
    return
  }
  let f = rt.tlocal_get(TLS_FIB)
  if f == 0 || rt.mem_load(w, W_LOCKS, 8) != 0 || rt.mem_load(f, F_NOPRE, 8) != 0 {
    return
  }
  // the interrupted pc and sp (unwind.xo prof_regs' layouts). arm64:
  // darwin's arm_thread_state64 at 16 in uc_mcontext (a pointer at 48),
  // Linux's sigcontext at 176; x86_64: darwin's x86_thread_state64 at 16
  // in uc_mcontext (rsp word 7, rip 16), Linux's gregs at 40 (rsp 15,
  // rip 16)
  var pc = 0
  var sp = 0
  if layer_arch() == 1 {
    if layer() == 2 {
      let ss = rt.mem_load(uc, 48, 8) + 16
      sp = rt.mem_load(ss, 248, 8)
      pc = rt.mem_load(ss, 256, 8) & 281474976710655
    } else {
      sp = rt.mem_load(uc, 432, 8)
      pc = rt.mem_load(uc, 440, 8)
    }
  } else if layer() == 2 {
    let ss = rt.mem_load(uc, 48, 8) + 16
    sp = rt.mem_load(ss, 56, 8)
    pc = rt.mem_load(ss, 128, 8)
  } else {
    sp = rt.mem_load(uc, 160, 8)
    pc = rt.mem_load(uc, 168, 8)
  }
  let mem = rt.mem_load(f, F_MEM, 8)
  if mem == 0 || sp.wrapping_sub(mem) < ASYNC_ROOM || !async_pc_ok(pc) {
    return
  }
  // the ask served (preempt's accounting)
  let a = rt.slot_load(w, W_PREEMPT_I, RELAXED)
  if a == 0 || !rt.slot_cas(w, W_PREEMPT_I, a, 0, RELAXED) {
    return
  }
  let _d = rt.slot_add[Int](rt.static_word(W_PREEMPT), 0, -1, RELEASE)
  // SIGURG unblocked for the worker's other fibers; this one's sigreturn
  // restores the interrupted code's mask
  if layer() == 2 {
    let _m = sys_darwin.pthread_sigmask(2, w + W_URGSET, 0)
  } else {
    let _m = linux.rt_sigprocmask(1, w + W_URGSET, 0)
  }
  stat(ST_PREEMPT)
  rt.mem_store(w, W_ASYNC, 1, 8)
  sched.fiber_yield(f)
}

// ---------------------------------------------------------------------------
// Fiber stacks (decision 0069): every task a worker starts runs on a
// stack of its own, mapped with a guard page below (on Windows reserved,
// its top committed, and a guard page below that: the system grows it as
// a thread's), kept in its worker's cache, then in a shared one.

/// The mapping of a fiber stack of size bytes with a guard page of page
/// bytes at its bottom: its address, or 0 (out of address space, the
/// error in the scratch word of the thread's table). On Linux under
/// ThreadSanitizer the C library maps it (sanhook.xo stack_map):
/// ThreadSanitizer keeps a program's mappings in its application ranges
/// through its mmap interceptor, which a system call bypasses.
fn map_stack(size: Int, page: Int, hooks: Int) -> Int {
  match layer() {
    1 => {
      if hooks != 0 && sanhook.tsan() {
        return sanhook.stack_map(size, page)
      }
      // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE
      let m = linux.mmap(0, size, 3, 16418, -1, 0)
      if m < 0 && m > -4096 {
        rt.tlocal_set(4, (0).wrapping_sub(m))
        return 0
      }
      // mprotect(PROT_NONE)
      let _r = rt.sys6(if layer_arch() == 1 { 226 } else { 10 }, m, page, 0, 0, 0, 0)
      m
    }
    2 => {
      // MAP_PRIVATE | MAP_ANON | MAP_NORESERVE
      let m = sys_darwin.mmap(0, size, 3, 4162, -1, 0)
      if m == -1 {
        rt.tlocal_set(4, rt.mem_load(sys_darwin.__error(), 0, 4))
        return 0
      }
      let _r = sys_darwin.mprotect(m, page, 0)
      m
    }
    3 => {
      // MEM_RESERVE, then MEM_COMMIT of the top and of a PAGE_GUARD page
      // below it (PAGE_READWRITE)
      let m = sys_windows.VirtualAlloc(0, size, 8192, 4)
      if m == 0 {
        rt.tlocal_set(4, 0)
        return 0
      }
      let top = m.wrapping_add(size).wrapping_sub(WIN_COMMIT)
      if sys_windows.VirtualAlloc(top, WIN_COMMIT, 4096, 4) == 0 || sys_windows.VirtualAlloc(top.wrapping_sub(page), page, 4096, 260) == 0 {
        rt.tlocal_set(4, 0)
        return 0
      }
      m
    }
    _ => 0
  }
}

/// 1 on arm64, 2 on x86_64.
fn layer_arch() -> Int {
  match target.arch {
    TargetArch.Arm64 => 1
    TargetArch.Amd64 => 2
    TargetArch.Wasm32 => 0
  }
}

/// Unmaps a fiber stack (mapped by map_stack with the same hooks).
fn unmap_stack(m: Int, size: Int, hooks: Int) {
  match layer() {
    1 => {
      if hooks != 0 && sanhook.tsan() {
        sanhook.stack_unmap(m, size)
      } else {
        let _r = linux.munmap(m, size)
      }
    }
    2 => {
      let _r = sys_darwin.munmap(m, size)
    }
    3 => {
      // MEM_RELEASE
      let _r = sys_windows.VirtualFree(m, 0, 32768)
    }
    _ => {}
  }
}

/// A fiber for w that starts running task t (claimed) when it is first
/// switched to: from w's cache, the shared one (the record at fs), or a
/// new mapping.
fn fiber_new(fs: Int, w: Int, t: Int) -> Int {
  var f = 0
  let nc = rt.mem_load(w, W_NFCACHE, 8)
  if nc > 0 {
    let k = nc.wrapping_sub(1)
    rt.mem_store(w, W_NFCACHE, k, 8)
    f = rt.mem_load(w, W_FCACHE.wrapping_add(k.wrapping_shl(3)), 8)
  } else if rt.slot_load(fs, FS_LIST, RELAXED) != 0 {
    if !rt.slot_cas(fs, 0, 0, 1, ACQUIRE) {
      lock_slow(fs)
    }
    held(1)
    f = rt.mem_load(fs, FS_LIST_AT, 8)
    if f != 0 {
      rt.slot_store(fs, FS_LIST, rt.mem_load(f, F_NEXT, 8), RELAXED)
      rt.mem_store(fs, FS_N, rt.mem_load(fs, FS_N, 8).wrapping_sub(1), 8)
      rt.mem_store(fs, FS_OPS, rt.mem_load(fs, FS_OPS, 8).wrapping_add(1), 8)
    }
    unlock(fs)
  }
  if f == 0 {
    stat(ST_FIBER_NEW)
    let page = rt.mem_load(fs, FS_PAGE, 8)
    let size = rt.mem_load(fs, FS_STACK, 8).wrapping_add(page)
    let m = map_stack(size, page, rt.mem_load(w, W_HOOKS, 8))
    if m == 0 {
      // out of address space more often than of memory: cabi.xo says
      // how much the stacks took, and exits
      let _r = rt.call_c2(rt.fn_addr("fiber_map_failed"), rt.tlocal_get(4), 0)
    }
    f = rt.heap_large(F_RECORD)
    rt.mem_set(f, 0, F_RECORD)
    rt.mem_store(f, F_MEM, m, 8)
    rt.mem_store(f, F_SIZE, size, 8)
    // counted, and its ThreadSanitizer fiber
    rtstats.fiber_counted(1)
    if rt.mem_load(w, W_HOOKS, 8) != 0 {
      sanhook.fiber_new(f)
    }
  }
  rt.mem_store(f, F_TASK, t, 8)
  rt.mem_store(f, F_CUR, 0, 8)
  rt.mem_store(f, F_DONE, 0, 8)
  rt.mem_store(f, F_NOPRE, 0, 8)
  rt.mem_store(f, F_HOOKS, rt.mem_load(w, W_HOOKS, 8), 8)
  rt.slot_store(f, F_STATE, 0, RELAXED)
  // the first frame, for the switch the compiler emits
  let mem = rt.mem_load(f, F_MEM, 8)
  let size = rt.mem_load(f, F_SIZE, 8)
  rt.mem_store(f, F_SP, sched.fiber_frame(f, mem, size - win_save(mem, size), WIN_COMMIT - win_save(mem, size), rt.mem_load(fs, FS_MAIN, 8)), 8)
  f
}

/// The bytes at the top of a fiber's stack (at mem, size bytes) kept for
/// Windows' asynchronous preemption (decision 0318): the interrupted
/// thread's CONTEXT, 16 byte aligned, in committed memory above the
/// fiber's first frame (win_ctx); 0 elsewhere.
fn win_save(mem: Int, size: Int) -> Int {
  if layer() != 3 {
    return 0
  }
  let end = mem.wrapping_add(size)
  (end & 15) + WIN_SAVE
}

/// The interrupted CONTEXT's place in fiber f's save area (win_save): its
/// upper half; win_kick's copy is the lower.
fn win_ctx(f: Int) -> Int {
  let end = rt.mem_load(f, F_MEM, 8).wrapping_add(rt.mem_load(f, F_SIZE, 8))
  end.wrapping_sub(end & 15).wrapping_sub(WIN_SAVE / 2)
}

/// Main's stack for its fiber (decision 0286 step 1): size bytes and a
/// guard page of page bytes below, reserved, never committed (map_stack),
/// mapped by entry.xo before main's thread starts, where the thread's own
/// 1 GiB was reserved before (under an address space limit, ulimit -v, a
/// mapping made later failed where the thread's had not): its address, or
/// 0 (main then runs on a thread of its own, as before).
pub fn map_main_stack(size: Int, page: Int) -> Int {
  map_stack(size.wrapping_add(page), page, 1)
}

/// Main's fiber for root record w (decision 0286 step 1) on the stack at
/// m of total bytes (map_main_stack), not in the caches, that starts the
/// program's entry with context c.
pub fn main_fiber(p: Int, w: Int, entry: Int, c: Int, m: Int, total: Int) -> Int {
  let fs = rt.mem_load(p, P_FIBERS, 8)
  let hooks = rt.mem_load(w, W_HOOKS, 8)
  let f = rt.heap_large(F_MAIN_RECORD)
  rt.mem_set(f, 0, F_MAIN_RECORD)
  rt.mem_store(f, F_MEM, m, 8)
  rt.mem_store(f, F_SIZE, total, 8)
  rt.mem_store(f, F_TASK, MAIN_TASK, 8)
  rt.mem_store(f, F_ENTRY, entry, 8)
  rt.mem_store(f, F_ROOT, w, 8)
  rt.mem_store(f, F_CUR, c, 8)
  rt.mem_store(f, F_HOOKS, hooks, 8)
  if hooks != 0 {
    sanhook.fiber_new(f)
  }
  rt.mem_store(f, F_SP, sched.fiber_frame(f, m, total - win_save(m, total), WIN_COMMIT - win_save(m, total), rt.mem_load(fs, FS_MAIN, 8)), 8)
  rt.slot_store(rt.mem_load(p, P_DLK, 8), DLK_MAINF, f, RELEASE)
  f
}

/// The root thread's loop while main runs on fiber mf (decision 0286 step
/// 1): it runs main first, and whatever else is queued while main is
/// parked, as a worker does (counted alive, idle on the pool's list, so a
/// wake of main or a spawn finds it); a parked main is a queue item like
/// any fiber, so an idle worker resumes it while the root computes. It
/// returns when main has ended, wherever it ran.
pub fn root_main(p: Int, w: Int, mf: Int) {
  let dlk = rt.mem_load(p, P_DLK, 8)
  rt.slot_add(dlk, DLK_LOOPS, 1, SEQ_CST)
  rt.slot_add(p, P_ALIVE, 1, SEQ_CST)
  async_thread(w)
  var it = mf | 1
  var spinning = 0
  while rt.slot_load(mf, F_ENDED_I, ACQUIRE) == 0 {
    if it == 0 {
      it = find_work(p, w, spinning)
      if spinning != 0 {
        spinning = 0
        // wakep counted it spinning: another one looks for more
        if rt.slot_add(p, P_SPINNING, -1, SEQ_CST) == 1 && it != 0 {
          wakep(p)
        }
      }
    }
    if it != 0 {
      run_item(p, w, it)
      it = 0
      continue
    }
    let r = root_idle(p, w, mf)
    if r == 0 {
      // work showed up while it went idle: look for it as a spinner does,
      // stealing (find_work without spinning takes only its own and the
      // inject queue's, and work in a busy worker's ring kept the root
      // going round, idle and back, at 100% CPU: rt_threads, 2026-10-20)
      rt.slot_add(p, P_SPINNING, 1, SEQ_CST)
      spinning = 1
    } else if r == 1 {
      spinning = 1
    }
  }
  rt.slot_add(p, P_ALIVE, -1, SEQ_CST)
  rt.slot_add(dlk, DLK_LOOPS, -1, SEQ_CST)
}

/// The root's idle wait (go_idle's, with main's end checked under the
/// pool's lock, so main_ended either sees the root on the idle list or
/// the root sees that main ended): 0 when work showed up as it went idle
/// (it then spins: root_main), 1 when wakep woke it (it then owns a
/// spinning count), 2 when main ended.
/// Main's fiber parked in a counted wait: blocked from now (its signal, or
/// its resume, takes it off). Every thread going idle does this before
/// its deadlock check (root_idle, go_idle): main parks on whichever worker
/// runs it, after its root may have gone idle, and a count only at the
/// root's idle missed it (TestCompileProperty seed 7 hung, 2026-10-21).
/// Under the park's lock alone, before the pool's: signal holds a park's
/// lock when it takes the pool's (wakep), so the other order deadlocked
/// (xo's own parallel build, 2026-10-20).
fn count_main(p: Int) {
  let dlk = rt.mem_load(p, P_DLK, 8)
  let mf = rt.slot_load(dlk, DLK_MAINF, ACQUIRE)
  if mf == 0 {
    return
  }
  let wp = rt.slot_load(mf, F_WAIT_I, ACQUIRE)
  if wp != 0 {
    klock(wp)
    // still parked there (PK_FIBER is main's until its signal or resume,
    // both under this lock): main may have resumed since the read above
    if rt.mem_load(wp, PK_FIBER, 8) == mf && rt.slot_load(wp, PK_SIGNALED, ACQUIRE) == 0 && rt.mem_load(wp, PK_COUNTED, 4) == 0 {
      rt.mem_store(wp, PK_COUNTED, 1, 4)
      rt.slot_add(dlk, DLK_BLOCKED, 1, SEQ_CST)
    }
    unlock(wp)
  }
}

fn root_idle(p: Int, w: Int, mf: Int) -> Int {
  count_main(p)
  // decision 0324: wait in the network poller when no one does (a
  // program that never spawns has no worker to)
  if rt.slot_load(mf, F_ENDED_I, ACQUIRE) == 0 && np_block(p, w, mf) >= 0 {
    return 0
  }
  plock(p)
  if rt.slot_load(mf, F_ENDED_I, ACQUIRE) != 0 {
    punlock(p)
    return 2
  }
  rt.slot_store(w, W_WAKEW_I, 0, RELAXED)
  rt.mem_store(w, W_IDLE_NEXT, rt.mem_load(p, P_IDLE, 8), 8)
  rt.mem_store(p, P_IDLE, w, 8)
  rt.slot_add(p, P_NIDLE, 1, SEQ_CST)
  dl_check(p)
  punlock(p)
  if twflags.vclock() != 0 {
    kick()
  }
  if any_work(p) != 0 && idle_unlist(p, w) {
    return 0
  }
  if tracerec.built() && tracerec.on() {
    tracerec.ev(tracerec.K_IDLE, 0, w, 0)
  }
  while rt.slot_load(w, W_WAKEW_I, ACQUIRE) == 0 {
    stat(ST_IDLE_SLEEP)
    futex_wait(w.wrapping_add(W_WAKEW), 0)
  }
  if tracerec.built() && tracerec.on() {
    tracerec.ev(tracerec.K_IDLE, 1, w, 0)
  }
  // 1 from wakep (a spinning count), 2 from main_ended
  rt.slot_load(w, W_WAKEW_I, ACQUIRE)
}

/// Takes w off the idle list if it is still on it (then whether it was).
fn idle_unlist(p: Int, w: Int) -> Bool {
  plock(p)
  var prev = 0
  var x = rt.mem_load(p, P_IDLE, 8)
  while x != 0 && x != w {
    prev = x
    x = rt.mem_load(x, W_IDLE_NEXT, 8)
  }
  if x == 0 {
    punlock(p)
    return false
  }
  let next = rt.mem_load(w, W_IDLE_NEXT, 8)
  if prev == 0 {
    rt.mem_store(p, P_IDLE, next, 8)
  } else {
    rt.mem_store(prev, W_IDLE_NEXT, next, 8)
  }
  rt.mem_store(w, W_IDLE_NEXT, 0, 8)
  rt.slot_add(p, P_NIDLE, -1, SEQ_CST)
  punlock(p)
  true
}

/// Main's fiber f ended (on whichever thread ran it): its root's loop
/// returns (woken if it is idle).
fn main_ended(p: Int, f: Int) {
  let w = rt.mem_load(f, F_ROOT, 8)
  plock(p)
  rt.slot_store(f, F_ENDED_I, 1, SEQ_CST)
  punlock(p)
  // the root may wait in the poller (np_block reads the end after its
  // count went up)
  np_break(p)
  if idle_unlist(p, w) {
    rt.slot_store(w, W_WAKEW_I, 2, RELEASE)
    futex_wake(w.wrapping_add(W_WAKEW))
  }
}

/// Keeps f's stack for reuse: in w's cache, else the shared one
/// (decision 0077: a shared cache only took a lock per task), else
/// unmaps it.
fn fiber_free(fs: Int, w: Int, f: Int) {
  let nc = rt.mem_load(w, W_NFCACHE, 8)
  if nc < FCACHE {
    rt.mem_store(w, W_FCACHE.wrapping_add(nc.wrapping_shl(3)), f, 8)
    rt.mem_store(w, W_NFCACHE, nc.wrapping_add(1), 8)
    return
  }
  if !rt.slot_cas(fs, 0, 0, 1, ACQUIRE) {
    lock_slow(fs)
  }
  held(1)
  let n = rt.mem_load(fs, FS_N, 8)
  if n < FIBER_CACHE {
    rt.mem_store(f, F_NEXT, rt.mem_load(fs, FS_LIST_AT, 8), 8)
    rt.slot_store(fs, FS_LIST, f, RELAXED)
    rt.mem_store(fs, FS_N, n.wrapping_add(1), 8)
    rt.mem_store(fs, FS_OPS, rt.mem_load(fs, FS_OPS, 8).wrapping_add(1), 8)
    unlock(fs)
    return
  }
  unlock(fs)
  fiber_unmap(f)
}

/// Gives back fiber f's stack and record (fiber_free, fiber_trim).
fn fiber_unmap(f: Int) {
  if rt.mem_load(f, F_HOOKS, 8) != 0 {
    sanhook.fiber_free(f)
  }
  rtstats.fiber_counted(-1)
  unmap_stack(rt.mem_load(f, F_MEM, 8), rt.mem_load(f, F_SIZE, 8), rt.mem_load(f, F_HOOKS, 8))
  rt.heap_release(f.wrapping_sub(8))
}

/// Unmaps the shared cache's stacks past FIBER_KEEP when no fiber was
/// taken or returned since ops was read (go_idle, after FIBER_TRIM_US
/// asleep): the list cut under the lock, the stacks unmapped after.
fn fiber_trim(fs: Int, ops: Int) {
  if !rt.slot_cas(fs, 0, 0, 1, ACQUIRE) {
    lock_slow(fs)
  }
  held(1)
  let n = rt.mem_load(fs, FS_N, 8)
  if n <= FIBER_KEEP || rt.mem_load(fs, FS_OPS, 8) != ops {
    unlock(fs)
    return
  }
  // keep the first FIBER_KEEP, cut the rest
  var f = rt.mem_load(fs, FS_LIST_AT, 8)
  var k = 1
  while k < FIBER_KEEP {
    f = rt.mem_load(f, F_NEXT, 8)
    k = k.wrapping_add(1)
  }
  var rest = rt.mem_load(f, F_NEXT, 8)
  rt.mem_store(f, F_NEXT, 0, 8)
  rt.mem_store(fs, FS_N, FIBER_KEEP, 8)
  unlock(fs)
  while rest != 0 {
    let next = rt.mem_load(rest, F_NEXT, 8)
    fiber_unmap(rest)
    rest = next
  }
}

// ---------------------------------------------------------------------------
// Parks (xo_rt.c xo_park): where one context waits. signaled is also the
// futex word of a thread (a root context) that sleeps on it; a fiber
// that waits parks instead (decision 0069). All zero is a fresh park.

/// xo_park (byte offsets; signaled is word 1): its lock, signaled, a
/// thread sleeps on it (a C int), a root asleep here counts in the
/// blocked roots (a C int), the fiber parked here.
const PK_SIGNALED = 1
const PK_SIGNALED_AT = 8
const PK_SLEEPING = 16
const PK_COUNTED = 20
const PK_FIBER = 24

/// The deadlock counts (the pool record's P_DLK, words): roots made, roots asleep in
/// a counted wait, contexts in a wait a timer, the network, or a signal
/// can end.
const DLK_ROOTS = 0
const DLK_BLOCKED = 1
const DLK_UNCOUNTED = 2
/// The roots in their loop (root_main, decision 0286 step 1): counted
/// alive and idle as workers, for the deadlock check, but not against the
/// worker threads' limit (workers).
const DLK_LOOPS = 3
/// XO_LOCKCHECK=1 (poolsetup.xo setup): plock and klock check the lock
/// order.
pub const DLK_LOCKCHECK = 4
/// Whether the first spawn switched the heap to a record per thread
/// (scope_add_at).
const DLK_THREADED = 5
/// Main's fiber while it runs on one (decision 0286 step 1), else 0: every
/// thread going idle counts its counted wait blocked (count_main).
const DLK_MAINF = 6
/// XO_PREEMPT=0 (poolsetup.xo setup): the monitor asks no worker to yield.
pub const DLK_NOPREEMPT = 7
/// The workers waiting in the network poller (decision 0324): counted
/// idle by the deadlock check, and wakep breaks their wait when no other
/// worker can take the work (ctx.xo DLK_SIZE).
const DLK_NPBLK = 8

/// Takes the pool's lock (record p's word 0), marking it held by this
/// thread's worker record when the lock order is checked.
fn plock(p: Int) {
  if !rt.slot_cas(p, 0, 0, 1, ACQUIRE) {
    stat(ST_LOCK_POOL)
    lock_slow(p)
  }
  held(1)
  if rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_LOCKCHECK, RELAXED) != 0 {
    let w = rt.tlocal_get(TLS_W)
    if w != 0 {
      rt.mem_store(w, W_POOLHELD, 1, 8)
    }
  }
}

/// Releases the pool's lock (plock).
fn punlock(p: Int) {
  if rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_LOCKCHECK, RELAXED) != 0 {
    let w = rt.tlocal_get(TLS_W)
    if w != 0 {
      rt.mem_store(w, W_POOLHELD, 0, 8)
    }
  }
  unlock(p)
}

/// With XO_LOCKCHECK=1, that w is the calling thread's own record: only a
/// ring's owner puts at its tail and takes at its head (sched.xo rq_put,
/// rq_get, rq_put_batch; thieves rq_grab). A fiber that keeps a record
/// across a park and resumes on another thread breaks it (scope_join did,
/// a rare ThreadSanitizer race, 2026-10-20); this makes it a fatal "ring
/// owner" error at once.
fn owner_check(w: Int) {
  let p = rt.mem_load(w, W_POOL, 8)
  if p != 0 && rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_LOCKCHECK, RELAXED) != 0 && rt.tlocal_get(TLS_W) != w {
    let _r = rt.call_c2(rt.fn_addr("ring_owner"), 0, 0)
  }
}

/// Takes park k's lock; with the lock order checked, holding the pool's
/// lock here is fatal (cabi.xo lock_order).
fn klock(k: Int) {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 && rt.mem_load(w, W_POOLHELD, 8) != 0 {
    let _r = rt.call_c2(rt.fn_addr("lock_order"), 0, 0)
  }
  if !rt.slot_cas(k, 0, 0, 1, ACQUIRE) {
    stat(ST_LOCK_PARK)
    lock_slow(k)
  }
  held(1)
}

/// The test world's record (twflags.xo, byte offsets): the verdict for
/// the next move of the virtual clock, the moves' epoch.
const TW_VPENDING = twflags.TW_VPENDING
const TW_VEPOCH = twflags.TW_VEPOCH

/// Faults when the program is deadlocked, the lock of pool p held
/// (xo_rt.c dlk, decision 0077): every root context sleeps in a counted
/// wait, every worker is idle, no context waits for a timer, the network
/// or a signal, and no queue holds an item. In the test world with a
/// virtual clock it records the verdict instead, and the clock jumps to
/// the next timer (xo_testing.c tw_kick, after the lock is released).
pub fn dl_check(p: Int) {
  let tw = twflags.vclock()
  // read before the counts: a move of the clock in progress or ended
  // since then makes this check's verdict stale (tw_kick_once)
  let epoch = if tw == 0 { 0 } else { rt.slot_load[Int](tw + TW_VEPOCH, 0, SEQ_CST) }
  let dlk = rt.mem_load(p, P_DLK, 8)
  let roots = rt.slot_load(dlk, DLK_ROOTS, SEQ_CST)
  if roots <= 0 || rt.slot_load(dlk, DLK_BLOCKED, SEQ_CST) != roots {
    return
  }
  if rt.slot_load(p, P_NIDLE, SEQ_CST).wrapping_add(rt.slot_load(dlk, DLK_NPBLK, SEQ_CST)) != rt.slot_load(p, P_ALIVE, SEQ_CST) {
    return
  }
  if rt.slot_load(dlk, DLK_UNCOUNTED, SEQ_CST) != 0 || any_work(p) != 0 {
    return
  }
  if tw != 0 {
    rt.slot_store[Int](tw + TW_VPENDING, 0, epoch + 1, SEQ_CST)
    return
  }
  // flushes standard output, says so and exits with 70 (cabi.xo deadlock)
  let _d = rt.call_c2(rt.fn_addr("deadlock"), 0, 0)
}

/// xo_node (byte offsets; canceled is word 4): parent, child, prev,
/// next, canceled, the waiter's park, its lock.
const N_PARENT = 0
const N_CHILD = 8
const N_PREV = 16
const N_NEXT = 24
const N_CANCELED = 4
const N_CANCELED_AT = 32
const N_WAITER = 40
const N_MU = 48

/// xo_ctx (byte offsets): its innermost node, the shield count (a C
/// int), its park.
const C_NODE = 0
const C_SHIELD = 12
const C_PARK = 16

/// Makes the park at p unsignaled.
pub fn park_reset(p: Int) {
  klock(p)
  rt.slot_store(p, PK_SIGNALED, 0, RELAXED)
  unlock(p)
}

/// Whether the park at p was signaled since its last park_reset (its
/// waiter has not run since, or not yet re-armed it).
pub fn park_signaled(p: Int) -> Bool { rt.slot_load(p, PK_SIGNALED, ACQUIRE) != 0 }

/// Wakes the context waiting at p. The waiter takes p's lock before it
/// returns, so p stays valid until the unlock here.
pub fn park_signal(pl: Int, p: Int) { signal(pl, p, false) }

/// park_signal of a channel's hand off (pool_push_handoff).
pub fn park_signal_handoff(pl: Int, p: Int) { signal(pl, p, true) }

fn signal(pl: Int, p: Int, handoff: Bool) {
  // the wakee's context's trace word (ctx.xo C_TRACE): every park is a
  // context's, at C_PARK (2026-10-16: chan, select, mutex and wait list
  // entries, the poller's timers and descriptors, scope_join, hserve and
  // h2srv all park c + C_PARK; no park is made outside a context), and
  // tracerec.ev checks the static switch again
  if tracerec.built() && rt.mem_load(p, C_TRACE - C_PARK, 8) != 0 {
    // the waker's context (0 on the monitor or the poller), the park
    // (its context's C_PARK); bit 0 a hand off, bit 1 the park was
    // signaled already (a wake that changes nothing)
    let again = if rt.slot_load(p, PK_SIGNALED, RELAXED) != 0 { 2 } else { 0 }
    tracerec.ev(tracerec.K_WAKE, (if handoff { 1 } else { 0 }) | again, rt.tlocal_get(0), p)
  }
  klock(p)
  rt.slot_store(p, PK_SIGNALED, 1, RELEASE)
  if rt.mem_load(p, PK_COUNTED, 4) != 0 {
    rt.mem_store(p, PK_COUNTED, 0, 4)
    rt.slot_add(rt.mem_load(pl, P_DLK, 8), DLK_BLOCKED, -1, SEQ_CST)
  }
  let f = rt.mem_load(p, PK_FIBER, 8)
  if f != 0 {
    rt.mem_store(p, PK_FIBER, 0, 8)
    if sched.fiber_wake(f) != 0 {
      push(pl, f | 1, handoff)
    }
  } else if rt.mem_load(p, PK_SLEEPING, 4) != 0 {
    stat(ST_THREAD_WAKE)
    futex_wake(p.wrapping_add(PK_SIGNALED_AT))
  }
  unlock(p)
}

/// Whether node n is canceled.
fn node_canceled(n: Int) -> Bool { rt.slot_load(n, N_CANCELED, ACQUIRE) != 0 }

/// Adds n below parent (canceled at once when parent is).
pub fn node_link(n: Int, parent: Int) {
  let pm = parent.wrapping_add(N_MU)
  if !rt.slot_cas(pm, 0, 0, 1, ACQUIRE) {
    lock_slow(pm)
  }
  held(1)
  rt.mem_store(n, N_PARENT, parent, 8)
  rt.mem_store(n, N_PREV, 0, 8)
  let c = rt.mem_load(parent, N_CHILD, 8)
  rt.mem_store(n, N_NEXT, c, 8)
  if c != 0 {
    rt.mem_store(c, N_PREV, n, 8)
  }
  rt.mem_store(parent, N_CHILD, n, 8)
  if rt.mem_load(parent, N_CANCELED_AT, 8) != 0 {
    rt.slot_store(n, N_CANCELED, 1, RELEASE)
  }
  unlock(pm)
}

/// Takes n out of its parent's children. A task's node is not unlinked
/// when the task ends: it goes with its scope's node of tasks.
pub fn node_unlink(n: Int) {
  let p = rt.mem_load(n, N_PARENT, 8)
  if p == 0 {
    return
  }
  let pm = p.wrapping_add(N_MU)
  if !rt.slot_cas(pm, 0, 0, 1, ACQUIRE) {
    lock_slow(pm)
  }
  held(1)
  let prev = rt.mem_load(n, N_PREV, 8)
  let next = rt.mem_load(n, N_NEXT, 8)
  if prev != 0 {
    rt.mem_store(prev, N_NEXT, next, 8)
  } else {
    rt.mem_store(p, N_CHILD, next, 8)
  }
  if next != 0 {
    rt.mem_store(next, N_PREV, prev, 8)
  }
  rt.mem_store(n, N_PARENT, 0, 8)
  rt.mem_store(n, N_PREV, 0, 8)
  rt.mem_store(n, N_NEXT, 0, 8)
  unlock(pm)
}

/// Cancels n and its subtree (n's lock held): a walk holds the locks
/// from the node down to the one it visits, so locks are always taken
/// parent first.
fn cancel_locked(pl: Int, n: Int) {
  if rt.mem_load(n, N_CANCELED_AT, 8) == 0 {
    rt.slot_store(n, N_CANCELED, 1, RELEASE)
  }
  // a canceled node's subtree may have gained children since: walk it
  let w = rt.mem_load(n, N_WAITER, 8)
  if w != 0 {
    park_signal(pl, w)
  }
  var c = rt.mem_load(n, N_CHILD, 8)
  while c != 0 {
    let cm = c.wrapping_add(N_MU)
    if !rt.slot_cas(cm, 0, 0, 1, ACQUIRE) {
      lock_slow(cm)
    }
    held(1)
    cancel_locked(pl, c)
    unlock(cm)
    c = rt.mem_load(c, N_NEXT, 8)
  }
}

/// Cancels n and its subtree (core 7.2) and wakes every context blocked
/// in it.
pub fn node_cancel(pl: Int, n: Int) {
  let m = n.wrapping_add(N_MU)
  if !rt.slot_cas(m, 0, 0, 1, ACQUIRE) {
    lock_slow(m)
  }
  held(1)
  cancel_locked(pl, n)
  unlock(m)
}

/// Sets the park of the context blocked at node n (0: none).
pub fn node_set_waiter(n: Int, p: Int) {
  let m = n.wrapping_add(N_MU)
  if !rt.slot_cas(m, 0, 0, 1, ACQUIRE) {
    lock_slow(m)
  }
  held(1)
  rt.mem_store(n, N_WAITER, p, 8)
  unlock(m)
}

/// Blocks context c until its park is signaled or, when cancelable is
/// not 0, its node is canceled (xo_rt.c park_wait_n). A task on a fiber
/// parks: its worker runs other work meanwhile (decision 0069). A root
/// thread runs queued work while it waits, and sleeps only when it finds
/// none (decision 0077). counted (not 0) tells that the wait counts as
/// blocked for deadlock detection; a wait that a timer, the network, or
/// a signal can end does not. The C caller flushes pending output and
/// pauses c's budget around it (waiting is not running time, decision
/// 0175), and in the test world counts every wait (timers are virtual:
/// nothing outside the program ends one). f is the fiber running c (0:
/// none), rw the record of c's root thread when it helps (0: none; a
/// root helps once the pool exists, so a program that only sleeps stays
/// single threaded), both found by the C.
pub fn park_wait(pl: Int, c: Int, cancelable0: Int, counted: Int, f: Int, rw: Int) {
  var cancelable = cancelable0
  if rt.mem_load(c, C_SHIELD, 4) != 0 {
    cancelable = 0
  }
  let node = rt.mem_load(c, C_NODE, 8)
  let p = c.wrapping_add(C_PARK)
  if cancelable != 0 {
    node_set_waiter(node, p)
  }
  let dlk = rt.mem_load(pl, P_DLK, 8)
  if counted == 0 {
    rt.slot_add(dlk, DLK_UNCOUNTED, 1, SEQ_CST)
  }
  klock(p)
  while rt.slot_load(p, PK_SIGNALED, ACQUIRE) == 0 && !(cancelable != 0 && node_canceled(node)) {
    if f != 0 {
      // main's fiber (decision 0286 step 1) waits as a root: a counted
      // wait is counted blocked when its root goes idle (root_idle: the
      // deadlock check runs only then, not on every park), and the signal
      // takes it off, as a root's sleep below
      let main = counted != 0 && rt.mem_load(f, F_TASK, 8) == MAIN_TASK
      if main {
        // read by its root's thread while main may run on another
        rt.slot_store(f, F_WAIT_I, p, RELEASE)
      }
      rt.mem_store(p, PK_FIBER, f, 8)
      sched.fiber_parking(f)
      unlock(p)
      sched.fiber_park(f)
      klock(p)
      rt.mem_store(p, PK_FIBER, 0, 8)
      if main {
        rt.slot_store(f, F_WAIT_I, 0, RELEASE)
        if rt.mem_load(p, PK_COUNTED, 4) != 0 {
          // counted, then not signaled (a spurious resume)
          rt.mem_store(p, PK_COUNTED, 0, 4)
          rt.slot_add(dlk, DLK_BLOCKED, -1, SEQ_CST)
        }
      }
      continue
    }
    unlock(p)
    var it = 0
    if rw != 0 {
      if root_hand_off(pl, rw) {
        it = root_next(rw)
      } else {
        it = find_work(pl, rw, 0)
        if it == 0 {
          it = steal_round(pl, rw, 0)
        }
      }
    }
    if it != 0 {
      run_item(pl, rw, it)
      rt.tlocal_set(TLS_CUR, c)
      klock(p)
      continue
    }
    klock(p)
    if rt.slot_load(p, PK_SIGNALED, ACQUIRE) != 0 || (cancelable != 0 && node_canceled(node)) {
      break
    }
    rt.mem_store(p, PK_SLEEPING, 1, 4)
    rt.mem_store(p, PK_COUNTED, counted, 4)
    unlock(p)
    if counted != 0 {
      // a signal meanwhile cleared counted and took one off
      plock(pl)
      rt.slot_add(dlk, DLK_BLOCKED, 1, SEQ_CST)
      dl_check(pl)
      punlock(pl)
      if twflags.vclock() != 0 {
        kick()
      }
    }
    stat(ST_THREAD_WAIT)
    futex_wait(p.wrapping_add(PK_SIGNALED_AT), 0)
    klock(p)
    rt.mem_store(p, PK_SLEEPING, 0, 4)
    if rt.mem_load(p, PK_COUNTED, 4) != 0 {
      // not signaled (a spurious wake up)
      rt.mem_store(p, PK_COUNTED, 0, 4)
      rt.slot_add(dlk, DLK_BLOCKED, -1, SEQ_CST)
    }
  }
  rt.slot_store(p, PK_SIGNALED, 0, RELAXED)
  unlock(p)
  if counted == 0 {
    rt.slot_add(dlk, DLK_UNCOUNTED, -1, SEQ_CST)
  }
  if cancelable != 0 {
    node_set_waiter(node, 0)
  }
}

/// Whether root record rw, parked with a task that runs on its own stack
/// (main's body, or a task a join runs inline: it cannot move to another
/// thread), leaves the work queued for anyone to the workers (decision
/// 0286 step 0): when a worker is idle or can start, it wakes one for its
/// ring and the inject queue and runs only its next item (root_next), the
/// fiber its own task just woke (a channel's partner, which hands back in
/// microseconds: a ping pong). Running the other work made the parked
/// task's wake wait for the whole item: an 86 ms handler held an HTTP
/// accept loop on the root while 10 workers were idle (found by Xo
/// Publish). With every worker busy (or none) it helps as before
/// (decision 0077).
fn root_hand_off(p: Int, rw: Int) -> Bool {
  if rt.slot_load(p, P_NIDLE, SEQ_CST) == 0 && workers(p) >= rt.mem_load(p, P_NCPU, 8) {
    return false
  }
  if rt.slot_load(p, P_ILEN, SEQ_CST) > 0 || rt.slot_load(rw, 0, SEQ_CST) != rt.slot_load(rw, RQ_TAIL, SEQ_CST) {
    wakep(p)
  }
  true
}

/// The root's next item (0 for none), which its parked task woke.
fn root_next(rw: Int) -> Int {
  if rt.slot_load(rw, W_NEXT_I, RELAXED) == 0 {
    return 0
  }
  let t = rt.slot_swap(rw, W_NEXT_I, 0, SEQ_CST)
  if t != 0 && rt.slot_load(rw, W_DEFER_AT_W, RELAXED) != 0 {
    // it runs its own work: no wake is owed
    rt.slot_store(rw, W_DEFER_AT_W, 0, RELAXED)
  }
  t
}

// ---------------------------------------------------------------------------
// Scopes (xo_rt.c "Scopes and tasks", core 7.1): a spawn links its task
// into the scope and queues it; the close helps with the tasks nobody
// started and waits for the rest. The records are made, counted, and
// freed by the C (the task's closure and result, faults, budgets).

/// xo_scope (byte offsets; pending is word 30): the node of its tasks,
/// its lock, the joiner's park, every task (each a reference, linked by
/// snext), closed (a C int), the list's length and the length at which a
/// spawn prunes it next, closing (a C int).
const S_TASKS = 72
const S_MU = 104
const S_PENDING = 30
const S_JOINER = 248
const S_LIST = 384
const S_CLOSED = 400
const S_NLIST = 432
const S_PRUNE_AT = 440
const S_CLOSING = 448

/// xo_task (byte offsets; state is word 10, gone word 22): the count of
/// its header, its node, its scope, its link in the scope's list.
const T_RC = 0
const T_NODE = 16
const T_SCOPE = 72
const T_STATE = 10
const T_SNEXT = 168
const T_GONE = 22

/// Links task t into scope s and queues it in the ring of w, the
/// spawning thread's record (s.spawn): the tasks it
/// pruned from s's list (linked by snext, for the C to release), 0, or -1
/// when s has ended (nothing done).
pub fn scope_add(pl: Int, s: Int, t: Int, w: Int) -> Int { scope_add_at(pl, s, t, w, false) }

/// scope_add, own when w is the calling thread's own record (its thread
/// local TLS_W): defer_check then takes it without reading the thread
/// local again. Not own (a root thread's spawn into the root worker's
/// ring), defer_check finds no record of the thread's and does nothing,
/// as before (checking the root worker's deferral there made the
/// multi-threaded spawn take 1.7 times the cycles, 2026-10-17).
pub fn scope_add_at(pl: Int, s: Int, t: Int, w: Int, own: Bool) -> Int {
  let dlk = rt.mem_load(pl, P_DLK, 8)
  if rt.slot_load(dlk, DLK_THREADED, RELAXED) == 0 {
    // the program's first spawn: one heap record per thread from now on
    // (cabi.xo heap_threads), on this thread, the only one running Xo
    // code until the task is queued (decision 0286 step 1: main's fiber
    // needs the pool from the start, and a program that never spawns
    // stays single threaded; done in start_worker it ran on the monitor's
    // thread while main allocated, a race TSan found)
    let _t = rt.call_c2(rt.fn_addr("heap_threads"), 0, 0)
    rt.slot_store(dlk, DLK_THREADED, 1, RELEASE)
  }
  if own {
    let mon = rt.slot_load[Int](rt.static_word(W_MON), 0, RELAXED)
    if mon != 0 && mon != 1 {
      defer_check_w(w)
    }
  } else {
    defer_check()
  }
  let m = s.wrapping_add(S_MU)
  if !rt.slot_cas(m, 0, 0, 1, ACQUIRE) {
    lock_slow(m)
  }
  held(1)
  if rt.mem_load(s, S_CLOSED, 4) != 0 {
    unlock(m)
    return -1
  }
  rt.mem_store(t, T_SCOPE, s, 8)
  // counted before a helper can find it in the list: the task runs and
  // its queue entry is taken (two units of two)
  rt.slot_add(s, S_PENDING, 4, 3)
  node_link(t.wrapping_add(T_NODE), rt.mem_load(s, S_TASKS, 8))
  rt.mem_store(t, T_SNEXT, rt.mem_load(s, S_LIST, 8), 8)
  rt.mem_store(s, S_LIST, t, 8)
  let n = rt.mem_load(s, S_NLIST, 8).wrapping_add(1)
  rt.mem_store(s, S_NLIST, n, 8)
  var dead = 0
  if n >= rt.mem_load(s, S_PRUNE_AT, 8) && rt.mem_load(s, S_CLOSING, 4) == 0 {
    dead = scope_prune(s)
  }
  unlock(m)
  // a new task goes to the spawning thread's ring (w, its record); when
  // it is the ring's only item, the spawner's own join or next park
  // likely runs it: no idle worker is woken unless the monitor finds it
  // waiting 1 ms later (defer_wake). With one worker every spawn defers:
  // the spawner's join or park runs them (as Go's GOMAXPROCS=1 and
  // tokio's current thread runtime do), not a woken worker one by one
  let alone = rt.mem_load(pl, P_NCPU, 8) < 2 || rt.slot_load(w, 0, ACQUIRE) == rt.mem_load(w, RQ_TAIL_AT, 8)
  rq_put(pl, w, t)
  if !(alone && defer_wake(pl, w)) {
    wakep(pl)
  }
  dead
}

/// Takes the tasks that are over and that only s's list holds out of the
/// list (s's lock held), linked by snext. A task is over when its run
/// ended and its queue entry was taken (gone 2); with a count of one
/// (shared: -1) nobody else has it (decision 0118: a long lived scope of
/// a server kept every connection's task).
fn scope_prune(s: Int) -> Int {
  var dead = 0
  var pp = s.wrapping_add(S_LIST)
  var n = rt.mem_load(s, S_NLIST, 8)
  while true {
    let u = rt.mem_load(pp, 0, 8)
    if u == 0 {
      break
    }
    if rt.slot_load(u, T_GONE, ACQUIRE) == 2 && rt.slot_load(u, T_RC, ACQUIRE) == -1 {
      rt.mem_store(pp, 0, rt.mem_load(u, T_SNEXT, 8), 8)
      rt.mem_store(u, T_SNEXT, dead, 8)
      dead = u
      n = n.wrapping_sub(1)
    } else {
      pp = u.wrapping_add(T_SNEXT)
    }
  }
  rt.mem_store(s, S_NLIST, n, 8)
  let twice = n.wrapping_shl(1)
  rt.mem_store(s, S_PRUNE_AT, if twice > 64 { twice } else { 64 }, 8)
  dead
}

/// The close of scope s by context c after its tasks were canceled as
/// the mode asks: runs the tasks that have not started on this thread
/// (tasks spawned meanwhile go to the head of the list: it looks again
/// until a pass finds none; a task's link is fixed once it is in the
/// list), then waits (not a cancellation point: a canceled body still
/// waits) until every task ended and every queue entry was taken: it sets
/// bit 0 of pending while that is not zero, and the last unit signals
/// its park. f and rw are park_wait's.
pub fn scope_join(pl: Int, s: Int, c: Int, f: Int, rw: Int) {
  // waiting for its tasks, also while it runs them here (`xo dump`,
  // decision 0251; ctx.xo C_WHY, C_PARK_FP)
  rt.mem_store(c, C_WHY, tracerec.WHY_JOIN, 8)
  rt.mem_store(c, C_PARK_FP, rt.frame_addr(), 8)
  let m = s.wrapping_add(S_MU)
  // first the scope's tasks at the heads of this thread's own ring and
  // of the inject queue (where a full ring moved its older half): each
  // runs here and its entry is taken with it (units 4), where one run
  // from the list below leaves its entry for a later, cold visit
  // (pool.xo run_item: 15% of a spawn loop's samples, 2026-10-17)
  while rt.tlocal_get(TLS_W) != 0 {
    // this thread's ring, read again each round: a task run here can park
    // and the joiner (a fiber: a task, or main's since decision 0286 step
    // 1) resume on another worker, whose ring only its own thread pops
    // (a stale ring raced its owner's rq_put under ThreadSanitizer)
    let w = rt.tlocal_get(TLS_W)
    var t = ring_get_scope(pl, w, s)
    if t == 0 {
      t = inject_get_scope(pl, s)
    }
    if t == 0 {
      break
    }
    if sched.task_claim(t) != 0 {
      sanhook.acquire(t)
      let _r = rt.call_c2(rt.fn_addr("run_claimed"), t, 4)
    } else {
      // a thread that helped runs it: the entry was ours to take (this
      // join has not set its waiting bit, so nobody is signaled)
      let _d = sched.task_dequeued(t, s)
    }
  }
  var found = true
  while found {
    found = false
    if !rt.slot_cas(m, 0, 0, 1, ACQUIRE) {
      lock_slow(m)
    }
    held(1)
    var t = rt.mem_load(s, S_LIST, 8)
    unlock(m)
    while t != 0 {
      if rt.slot_load(t, T_STATE, ACQUIRE) == 0 && sched.task_claim(t) != 0 {
        // claimed: it runs here, its queue entry still queued (its
        // spawn released it)
        sanhook.acquire(t)
        let _r = rt.call_c2(rt.fn_addr("run_claimed"), t, 2)
        found = true
      }
      t = rt.mem_load(t, T_SNEXT, 8)
    }
  }
  let p = c.wrapping_add(C_PARK)
  rt.mem_store(s, S_JOINER, p, 8)
  while true {
    park_reset(p)
    let v = rt.slot_load(s, S_PENDING, ACQUIRE)
    if (v >> 1) == 0 {
      break
    }
    if (v & 1) == 0 && !rt.slot_cas(s, S_PENDING, v, v | 1, 3) {
      continue
    }
    let tr = tracerec.built() && rt.mem_load(c, C_TRACE, 8) != 0
    if tracerec.built() && tr {
      tracerec.ev(tracerec.K_PARK, tracerec.WHY_JOIN, c, 0)
    }
    park_wait(pl, c, 0, 1, f, rw)
    if tracerec.built() && tr {
      tracerec.ev(tracerec.K_RESUME, 0, c, 0)
    }
  }
  rt.mem_store(c, C_WHY, 0, 8)
  rt.mem_store(c, C_PARK_FP, 0, 8)
}

// ---------------------------------------------------------------------------
// Deferred wakes and their monitor (decision 0077's addendum, as Go's
// sysmon): a channel's hand off to a task, or a spawn of a ring's only
// task, puts the work on the waker's own worker and wakes no idle one
// (a futex call each, and that worker's spin and sleep: most of the CPU
// of a ping pong or a spawn loop). Its owner usually runs it when its
// task parks or ends (take_local clears the mark). The monitor, a thread
// started on the first deferral, wakes an idle worker for a deferral
// that has waited DEFER_NS with its work still queued, so the work starts
// within about 2 ms even when the waker keeps computing (no preemption).
// It ticks every DEFER_NS while deferrals come, and after MON_IDLE_TICKS
// ticks without one it sleeps until the next deferral wakes it: an idle
// program has no ticks. With one worker (XO_THREADS=1) every spawn
// defers, and a root's deferral waits for its join, its next park, or the
// monitor's tick, with no 50 us wake (defer_wake).

/// rt.static_word: the monitor's record (0: not started; 1: deferral
/// off, defer_off, or the monitor could not start).
const W_MON = 75
/// rt.static_word: the preemption flag generated code polls: the number of
/// asks to yield still out (mon_scan adds one, the asked worker's preempt
/// or the monitor's withdrawal takes it back). Not a flag kept set while
/// work waits: every poll of every worker calls the stub while it is
/// nonzero, which cost a loaded server a quarter of its throughput
/// (2026-10-21).
const W_PREEMPT = 76
/// The record: asleep (a word: 1 while it sleeps without a timeout), its
/// futex word, and started (claimed by the first deferral).
const M_ASLEEP = 0
const M_WAKE = 1
const M_WAKE_AT = 8
const M_SIZE = 24
const DEFER_NS = 1000000
const DEFER_US = 1000
/// The age at which the waker's own next runtime call wakes for its
/// deferral (defer_check): the bound that does not depend on the
/// monitor's timer.
const DEFER_CHECK_NS = 50000
const MON_IDLE_TICKS = 10
/// How long a fiber runs while work waits before the monitor asks its
/// worker to yield (Go's forcePreemptNS).
const SLICE_NS = 10000000

/// Defers the wake for work w just queued: whether it did (false without
/// a monitor). With one worker (XO_THREADS=1) a root's deferral is not
/// woken when it is DEFER_CHECK_NS old: the root's join or next park runs
/// its ring, else the monitor's tick wakes the worker (decision 0077's
/// addendum: a spawn loop woke the one worker per task, a futex call of
/// about 70 us each on macOS).
fn defer_wake(p: Int, w: Int) -> Bool {
  let m = monitor(p)
  if m == 0 {
    return false
  }
  let at = rt.slot_load(w, W_DEFER_AT_W, RELAXED)
  if at == 0 {
    rt.mem_store(w, W_DEFER_N, 0, 8)
    rt.slot_store(w, W_DEFER_AT_W, sysio.mono_ns(), SEQ_CST)
  } else if !(rt.mem_load(p, P_NCPU, 8) < 2 && rt.mem_load(w, W_ROOT, 4) != 0) && sysio.mono_ns().wrapping_sub(at) >= DEFER_CHECK_NS {
    // an older deferral is due: wake now for both
    rt.slot_store(w, W_DEFER_AT_W, 0, SEQ_CST)
    return false
  }
  stat(ST_DEFER)
  if rt.slot_load(m, M_ASLEEP, SEQ_CST) != 0 && rt.slot_cas(m, M_ASLEEP, 1, 0, SEQ_CST) {
    rt.slot_store(m, M_WAKE, 1, RELEASE)
    futex_wake(m.wrapping_add(M_WAKE_AT))
  }
  true
}

/// Every worker is busy and work was just queued (wakep): the monitor
/// ticks, to preempt a worker past its slice (mon_scan). One static load
/// and, when the monitor sleeps, a wake.
fn preempt_arm(p: Int) {
  let m = monitor(p)
  if m == 0 {
    return
  }
  if rt.slot_load(m, M_ASLEEP, RELAXED) != 0 && rt.slot_cas(m, M_ASLEEP, 1, 0, SEQ_CST) {
    rt.slot_store(m, M_WAKE, 1, RELEASE)
    futex_wake(m.wrapping_add(M_WAKE_AT))
  }
}

/// The monitor's record, started on first use (its thread runs mon_main):
/// 0 when its thread cannot start.
fn monitor(p: Int) -> Int {
  let wm = rt.static_word(W_MON)
  let m = rt.slot_load[Int](wm, 0, ACQUIRE)
  if m != 0 {
    return if m == 1 { 0 } else { m }
  }
  plock(p)
  var r = rt.slot_load[Int](wm, 0, ACQUIRE)
  if r == 0 {
    let n = rt.heap_large(M_SIZE)
    rt.mem_set(n, 0, M_SIZE)
    if async_on() {
      // the monitor preempts with SIGURG (decision 0318)
      async_install()
    }
    if thread_start(rt.fn_addr("mon_main"), p) {
      r = n
    } else {
      // 1: it could not start; never try again
      rt.heap_release(n - 8)
      r = 1
    }
    rt.slot_store[Int](wm, 0, r, RELEASE)
  }
  punlock(p)
  if r == 1 { 0 } else { r }
}

/// The monitor's thread (cabi.xo mon_main): see above.
pub fn mon_main(p: Int) -> Int {
  var m = rt.slot_load[Int](rt.static_word(W_MON), 0, ACQUIRE)
  while m == 0 {
    // the starter stores the record right after the thread starts
    rt.spin_hint()
    m = rt.slot_load[Int](rt.static_word(W_MON), 0, ACQUIRE)
  }
  var quiet = 0
  while true {
    futex_wait_us(m.wrapping_add(M_WAKE_AT), 0, DEFER_US)
    stat(ST_MON_TICK)
    let busy = mon_scan(p)
    if tracerec.built() && tracerec.on() {
      tracerec.ev(tracerec.K_MON, if busy { 1 } else { 0 }, 0, 0)
    }
    if busy {
      quiet = 0
      continue
    }
    quiet = quiet.wrapping_add(1)
    if quiet < MON_IDLE_TICKS {
      continue
    }
    // no deferral for a while: sleep until one comes (defer_wake wakes
    // it), looking once more after saying so
    rt.slot_store(m, M_WAKE, 0, RELAXED)
    rt.slot_store(m, M_ASLEEP, 1, SEQ_CST)
    if mon_scan(p) && rt.slot_cas(m, M_ASLEEP, 1, 0, SEQ_CST) {
      quiet = 0
      continue
    }
    while rt.slot_load(m, M_WAKE, ACQUIRE) == 0 {
      futex_wait(m.wrapping_add(M_WAKE_AT), 0)
    }
    rt.slot_store(m, M_WAKE, 0, RELAXED)
    quiet = 0
  }
  0
}

/// Wakes an idle worker for every deferral older than DEFER_NS whose
/// worker still has work queued (clearing the rest), and with work queued
/// asks every worker that has run its fiber SLICE_NS to yield (decision
/// 0286 step 3; W_PREEMPT counts the asks out): whether any
/// deferral was pending or any worker runs while work waits (the monitor
/// keeps ticking).
fn mon_scan(p: Int) -> Bool {
  let n = rt.slot_load(p, P_NW, SEQ_CST)
  let now = sysio.mono_ns()
  var pending = false
  // work waits, no worker is idle to take it, and no other can start
  // (wakep wakes or starts one then: preempting then only moved the waiting task
  // onto the long runner's thread, TestRuntimeTasks' magazines, whose
  // spawner spins while another worker frees)
  let async = async_on()
  let waiting = any_work(p) != 0 && rt.slot_load(p, P_NIDLE, SEQ_CST) == 0 && workers(p) >= rt.mem_load(p, P_NCPU, 8) && rt.slot_load(rt.mem_load(p, P_DLK, 8), DLK_NOPREEMPT, RELAXED) == 0
  var i = 0
  while i < n {
    let w = rt.mem_load(p, P_WS.wrapping_add(i.wrapping_shl(3)), 8)
    let ra = rt.slot_load(w, W_RUN_AT_I, RELAXED)
    let ask = rt.slot_load(w, W_PREEMPT_I, RELAXED)
    // a fiber SIGURG preempted waits for its own worker (decision 0318),
    // which no other worker can help: work waits for it alone (a plain
    // read of the worker's word, a hint)
    let waiting = waiting || (async && rt.mem_load(w, W_PIN, 8) != 0)
    if ask != 0 {
      pending = true
      // an ask not served in a slice (the worker blocked, or no work
      // waits any more) is withdrawn: while any is out every worker's
      // polls call the stub
      if (!waiting || now.wrapping_sub(ask) >= SLICE_NS) && rt.slot_cas(w, W_PREEMPT_I, ask, 0, RELAXED) {
        let _d = rt.slot_add[Int](rt.static_word(W_PREEMPT), 0, -1, RELEASE)
      } else if async {
        // the handler declined (runtime code, a lock held): again
        async_kick(w)
      }
    } else if waiting && ra != 0 {
      pending = true
      if now.wrapping_sub(ra) >= SLICE_NS && rt.slot_cas(w, W_PREEMPT_I, 0, now, RELAXED) {
        let _i = rt.slot_add[Int](rt.static_word(W_PREEMPT), 0, 1, RELEASE)
        if async {
          async_kick(w)
        }
      }
    }
    let at = rt.slot_load(w, W_DEFER_AT_W, SEQ_CST)
    if at != 0 {
      pending = true
      if now.wrapping_sub(at) >= DEFER_NS && rt.slot_cas(w, W_DEFER_AT_W, at, 0, SEQ_CST) {
        let queued = rt.slot_load(w, W_NEXT_I, SEQ_CST) != 0 || rt.slot_load(w, 0, SEQ_CST) != rt.slot_load(w, RQ_TAIL, SEQ_CST)
        if queued {
          stat(ST_MON_WAKE)
          if tracerec.built() && tracerec.on() {
            // a late wake by the monitor: the deferral's age
            tracerec.ev(tracerec.K_LATE, 1, w, now.wrapping_sub(at))
          }
          wakep(p)
        }
      }
    }
    i = i.wrapping_add(1)
  }
  pending
}

/// The tasks scope s's list holds, under its lock: std/internal
/// rt_probe's "listed" (decision 0241, the prune test).
pub fn scope_listed(s: Int) -> Int {
  lock(s + S_MU)
  let n = rt.mem_load(s, S_NLIST, 8)
  unlock(s + S_MU)
  n
}

/// The waker side of a deferral's bound (decision 0077's addendum): at a
/// runtime call of the task on worker w (a channel operation, a Mutex's,
/// a spawn), a deferral of w older than DEFER_CHECK_NS whose work is
/// still queued gets its idle worker woken now, so the monitor's timer
/// (which oversleeps under load, gotchas/monitor-tick-oversleep.md) is
/// only the last resort, for a task that computes without calling the
/// runtime. One thread local load when nothing is deferred.
pub fn defer_check() {
  // no monitor (one worker, nothing deferred yet) or deferral off: one
  // static load (relaxed: the monitor's thread stores it), no thread
  // local read
  let m = rt.slot_load[Int](rt.static_word(W_MON), 0, RELAXED)
  if m == 0 || m == 1 {
    return
  }
  let w = rt.tlocal_get(TLS_W)
  if w == 0 {
    return
  }
  defer_check_w(w)
}

/// defer_check for the calling thread's record w (scope_add has it: no
/// thread local read, a _tlv_get_addr on macOS, per spawn).
fn defer_check_w(w: Int) {
  let at = rt.slot_load(w, W_DEFER_AT_W, RELAXED)
  if at == 0 {
    return
  }
  // a root at one worker (XO_THREADS=1): its join or next park runs what
  // it deferred, and this call shows it is not blocked; waking the worker
  // made the two threads take the same tasks (Linux spawn: 400 wakes, 1.6
  // threads busy); the monitor stays the bound for a root blocked in the
  // system. Before the count and the clock, which it never needs
  if rt.mem_load(w, W_ROOT, 4) != 0 && rt.mem_load(rt.mem_load(w, W_POOL, 8), P_NCPU, 8) < 2 {
    return
  }
  // the clock every 16th call (a clock read cost a ping pong 12% more
  // instructions on macOS): the bound is DEFER_CHECK_NS or 16 calls,
  // whichever is later
  let n = rt.mem_load(w, W_DEFER_N, 8).wrapping_add(1)
  rt.mem_store(w, W_DEFER_N, n, 8)
  if (n & 15) != 0 || sysio.mono_ns().wrapping_sub(at) < DEFER_CHECK_NS {
    return
  }
  if rt.slot_cas(w, W_DEFER_AT_W, at, 0, SEQ_CST) && queued(w) {
    stat(ST_MON_WAKE)
    if tracerec.built() && tracerec.on() {
      // a late wake by the waker's own check
      tracerec.ev(tracerec.K_LATE, 2, w, sysio.mono_ns().wrapping_sub(at))
    }
    wakep(rt.mem_load(w, W_POOL, 8))
  }
}

/// Whether w has work in its next slot or ring.
fn queued(w: Int) -> Bool { rt.slot_load(w, W_NEXT_I, SEQ_CST) != 0 || rt.slot_load(w, 0, SEQ_CST) != rt.slot_load(w, RQ_TAIL, SEQ_CST) }

/// Turns deferred wakes off for the rest of the run, waking for every
/// pending one: a program with real-time sections (the compiler's mark
/// at main's start, cabi.xo rt_program, and every section's entry,
/// rt_enter), or XO_DEFER_WAKE=0 (poolsetup.xo). p is the pool record
/// (0 before there is one). A load when off already.
pub fn defer_off(p: Int) {
  let wm = rt.static_word(W_MON)
  let m = rt.slot_load[Int](wm, 0, ACQUIRE)
  if m == 1 {
    return
  }
  if m == 0 && rt.slot_cas[Int](wm, 0, 0, 1, SEQ_CST) {
    return
  }
  // the monitor runs (it sleeps from now on: nothing defers): deferral
  // off, then every pending one woken
  rt.slot_store[Int](wm, 0, 1, SEQ_CST)
  if p == 0 {
    return
  }
  let n = rt.slot_load(p, P_NW, SEQ_CST)
  var i = 0
  while i < n {
    let w = rt.mem_load(p, P_WS.wrapping_add(i.wrapping_shl(3)), 8)
    let at = rt.slot_load(w, W_DEFER_AT_W, SEQ_CST)
    if at != 0 && rt.slot_cas(w, W_DEFER_AT_W, at, 0, SEQ_CST) && queued(w) {
      wakep(p)
    }
    i = i.wrapping_add(1)
  }
}

/// The workers alive and the CPUs the pool counts, of pool record p:
/// std/internal rt_probe's "workers" and "cpus" (decision 0241, the event
/// loop test: the workers stay near one per CPU however many tasks
/// sleep).
pub fn alive(p: Int) -> Int { rt.slot_load(p, P_ALIVE, SEQ_CST) }

pub fn cpus(p: Int) -> Int { rt.mem_load(p, P_NCPU, 8) }

/// XO_HEAP_GUARD=1 (libcmem.xo guard_large): a read and write mapping of
/// size bytes (a multiple of GUARD_PAGE) whose last GUARD_PAGE bytes are
/// inaccessible, so an access past a block placed against them faults;
/// its address, or 0. Under ThreadSanitizer, 0 (the C library's mappings
/// only, as map_stack).
pub fn guard_map(size: Int) -> Int {
  let top = size.wrapping_sub(GUARD_PAGE)
  match layer() {
    1 => {
      if sanhook.tsan() {
        return 0
      }
      // PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS
      let m = linux.mmap(0, size, 3, 34, -1, 0)
      if m < 0 && m > -4096 {
        return 0
      }
      let _r = linux.mprotect(m.wrapping_add(top), GUARD_PAGE, 0)
      m
    }
    2 => {
      // MAP_PRIVATE | MAP_ANON
      let m = sys_darwin.mmap(0, size, 3, 4098, -1, 0)
      if m == -1 {
        return 0
      }
      let _r = sys_darwin.mprotect(m.wrapping_add(top), GUARD_PAGE, 0)
      m
    }
    3 => {
      // MEM_RESERVE of it all, MEM_COMMIT (PAGE_READWRITE) of all but the
      // last GUARD_PAGE bytes: a reserved page faults on any access
      let m = sys_windows.VirtualAlloc(0, size, 8192, 4)
      if m == 0 {
        return 0
      }
      if sys_windows.VirtualAlloc(m, top, 4096, 4) == 0 {
        let _f = sys_windows.VirtualFree(m, 0, 32768)
        return 0
      }
      m
    }
    _ => 0
  }
}

/// Unmaps a guard_map mapping of size bytes.
pub fn guard_unmap(m: Int, size: Int) {
  match layer() {
    1 => {
      let _r = linux.munmap(m, size)
    }
    2 => {
      let _r = sys_darwin.munmap(m, size)
    }
    3 => {
      // MEM_RELEASE
      let _r = sys_windows.VirtualFree(m, 0, 32768)
    }
    _ => {}
  }
}

/// The guard of guard_map and its granularity: 64 KiB, a multiple of
/// every target's page (4 KiB, 16 KiB on darwin/arm64, 64 KiB on some
/// Linux arm64 kernels) and Windows' allocation granularity.
pub const GUARD_PAGE = 65536
