// The HTTP/2 frame writer of the native std/http, written in Xo (the
// zero-C audit's B28, its bytes only part): the frames the server and
// the client send (RFC 9113 4.1, 6) and the server's response heads as
// net/http's responseWriterState.writeChunk makes them. They were C
// (std/llrt/xo_h2.c's h2_fh, h2_put_rst, h2_put_winup, h2_put_goaway,
// h2_put_setting, h2_put_block, h2_head); the bytes written are the
// same, but for a handler that sets one field name twice in different
// cases, whose fields now keep their order (Go's sort.Strings of the
// keys keeps each key's values in order; qsort did not promise it).
//
// The C connection code keeps the connection's buffers and calls these
// through the exports of cabi_http.xo (decision 0204), writing into room
// it reserved (each function says how much).
use native/llrt/http1_tables
use native/llrt/http1w
use native/llrt/raw
use native/rt

// The frame types and flags (RFC 9113 6).
const T_HEADERS: Int = 1
const T_RST: Int = 3
const T_SETTINGS: Int = 4
const T_GOAWAY: Int = 7
const T_WINUP: Int = 8
const T_CONT: Int = 9
const F_END_STREAM: Int = 1
const F_END_HEADERS: Int = 4

fn byte(d: Int, at: Int, v: Int) { rt.mem_store(d, at, v & 255, 1) }

/// v as 4 bytes, the most significant first.
fn be32(d: Int, at: Int, v: Int) {
  byte(d, at, v >> 24)
  byte(d, at + 1, v >> 16)
  byte(d, at + 2, v >> 8)
  byte(d, at + 3, v)
}

/// v as 4 bytes little endian (the encoder job's numbers, xo_h2.c
/// xo_h2_enc_job).
fn le32(d: Int, at: Int, v: Int) { rt.mem_store(d, at, v & 0xFFFFFFFF, 4) }

// ---------------------------------------------------------------------------
// Frames

/// Writes the 9 byte header of a frame at d: the payload's length, the
/// type, the flags, the stream (its reserved bit clear); 9.
pub fn frame_head(d: Int, len: Int, ty: Int, flags: Int, sid: Int) -> Int {
  byte(d, 0, len >> 16)
  byte(d, 1, len >> 8)
  byte(d, 2, len)
  byte(d, 3, ty)
  byte(d, 4, flags)
  be32(d, 5, sid & 0x7FFFFFFF)
  9
}

/// RST_STREAM of the stream with the error code; 13.
pub fn rst(d: Int, sid: Int, code: Int) -> Int {
  let n = frame_head(d, 4, T_RST, 0, sid)
  be32(d, n, code)
  n + 4
}

/// WINDOW_UPDATE of the stream (0: the connection) by inc; 13.
pub fn winup(d: Int, sid: Int, inc: Int) -> Int {
  let n = frame_head(d, 4, T_WINUP, 0, sid)
  be32(d, n, inc)
  n + 4
}

/// GOAWAY with the last stream, the error code, and the dn bytes of debug
/// data at dp; 17 + dn.
pub fn goaway(d: Int, last: Int, code: Int, dp: Int, dn: Int) -> Int {
  let n = frame_head(d, 8 + dn, T_GOAWAY, 0, 0)
  be32(d, n, last)
  be32(d, n + 4, code)
  if dn > 0 {
    rt.mem_copy(d + n + 8, dp, dn)
  }
  n + 8 + dn
}

/// One setting of a SETTINGS frame's payload: the id, the value; 6.
pub fn setting(d: Int, id: Int, v: Int) -> Int {
  byte(d, 0, id >> 8)
  byte(d, 1, id)
  be32(d, 2, v)
  6
}

/// The room block needs for bn bytes in frames of at most max.
pub fn block_room(bn: Int, max: Int) -> Int { bn + 9 * (bn / max + 1) }

/// The bn bytes of the header block at bp as a HEADERS frame and
/// CONTINUATION frames of at most max bytes each, END_STREAM on the first
/// when end_stream; the bytes written (block_room's bound).
pub fn block(d: Int, sid: Int, bp: Int, bn: Int, end_stream: Bool, max: Int) -> Int {
  var at = 0
  var off = 0
  var first = true
  while first || off < bn {
    let k = if bn - off > max { max } else { bn - off }
    var flags = 0
    if off + k == bn {
      flags = flags | F_END_HEADERS
    }
    if first && end_stream {
      flags = flags | F_END_STREAM
    }
    at += frame_head(d + at, k, if first { T_HEADERS } else { T_CONT }, flags, sid)
    if k > 0 {
      rt.mem_copy(d + at, bp + off, k)
    }
    at += k
    off += k
    first = false
  }
  at
}

// ---------------------------------------------------------------------------
// Response heads

/// strconv.ParseUint(s, 10, 63) of the n bytes at p: the value, or -1.
pub fn parse_uint63(p: Int, n: Int) -> Int {
  if n == 0 {
    return -1
  }
  var v = 0
  var i = 0
  while i < n {
    let c = rt.mem_load(p, i, 1)
    if c < 48 || c > 57 || v > (9223372036854775807 - (c - 48)) / 10 {
      return -1
    }
    v = v * 10 + (c - 48)
    i += 1
  }
  v
}

/// validWireHeaderFieldName of a name once lower cased: ASCII token
/// bytes.
fn name_ok(p: Int, n: Int) -> Bool {
  if n == 0 {
    return false
  }
  var i = 0
  while i < n {
    let c = rt.mem_load(p, i, 1)
    if c >= 0x80 || (Int(http1_tables.CLASS[lower(c)]) & 1) == 0 {
      return false
    }
    i += 1
  }
  true
}

/// httpguts.ValidHeaderFieldValue: no control bytes but tab.
fn value_ok(p: Int, n: Int) -> Bool {
  var i = 0
  while i < n {
    let c = rt.mem_load(p, i, 1)
    if (c < 32 && c != 9) || c == 0x7f {
      return false
    }
    i += 1
  }
  true
}

fn lower(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// One field of a head in the job's form: the name's and the value's
/// lengths, the name, the value; the offset after it.
fn field(d: Int, at: Int, k: Str, vp: Int, vn: Int) -> Int {
  le32(d, at, k.len())
  le32(d, at + 4, vn)
  let a = http1w.put(d, at + 8, k)
  if vn > 0 {
    rt.mem_copy(d + a, vp, vn)
  }
  a + vn
}

/// The room head needs for the hn fields at ha: each field's name and
/// value and 8 bytes, and 256 for the count and the fields it adds.
pub fn head_room(ha: Int, hn: Int) -> Int {
  var n = 256
  var i = 0
  while i < hn {
    n += http1w.key_n(ha, i) + http1w.val_n(ha, i) + 8
    i += 1
  }
  n
}

/// Writes at d the response head of status for the handler's hn fields
/// at ha (canonical names) as writeChunk sends it with the pn bytes at p,
/// the first bytes of the body (all of it when done), in the form of the
/// encoder's job (xo_h2.c xo_h2_enc_job: the number of fields, then each
/// as field writes it): :status, the fields sorted by name in lower case
/// (invalid ones, Connection, Content-Length, and Transfer-Encoding but
/// "trailers" left out), then content-type (sniffed), content-length, and
/// date. head_req: the request is HEAD. Stores 1 at res when the handler
/// asked for Connection: close, else 0. The bytes written (head_room's
/// bound).
pub fn head(d: Int, ha: Int, hn: Int, status: Int, head_req: Bool, p: Int, pn: Int, done: Bool, res: Int) -> Int {
  var nf = 1
  var at = field(d, 4, ":status", 0, 0)
  // the status text after the field's lengths were written
  let st = "${status}"
  le32(d, 8, st.len())
  at = http1w.put(d, at, st)
  let allowed = http1w.body_allowed(status)
  let ci = http1w.find(ha, hn, "Content-Length")
  let has_clen = ci >= 0 && parse_uint63(http1w.val_p(ha, ci), http1w.val_n(ha, ci)) >= 0
  let cei = http1w.find(ha, hn, "Content-Encoding")
  let sniff = http1w.find(ha, hn, "Content-Type") < 0 && http1w.val_len(ha, cei) == 0 && allowed && pn > 0
  let close = http1w.val_is(ha, http1w.find(ha, hn, "Connection"), "close")
  rt.mem_store(res, 0, if close { 1 } else { 0 }, 8)
  for i in http1w.sorted(ha, hn) {
    let kp = http1w.key_p(ha, i)
    let kn = http1w.key_n(ha, i)
    let vp = http1w.val_p(ha, i)
    let vn = http1w.val_n(ha, i)
    if http1w.mem_is(kp, kn, "Content-Length") || http1w.mem_is(kp, kn, "Connection") {
      continue
    }
    if !name_ok(kp, kn) || !value_ok(vp, vn) {
      continue
    }
    // the name lower cased in place after its lengths
    le32(d, at, kn)
    le32(d, at + 4, vn)
    var j = 0
    while j < kn {
      byte(d, at + 8 + j, lower(rt.mem_load(kp, j, 1)))
      j += 1
    }
    if http1w.mem_is(d + at + 8, kn, "transfer-encoding") && !http1w.mem_is(vp, vn, "trailers") {
      continue
    }
    if vn > 0 {
      rt.mem_copy(d + at + 8 + kn, vp, vn)
    }
    at += 8 + kn + vn
    nf += 1
  }
  if sniff {
    let ct = http1w.sniff(p, pn)
    at = field(d, at, "content-type", raw.data(ct), ct.len())
    nf += 1
  }
  if has_clen {
    at = field(d, at, "content-length", http1w.val_p(ha, ci), http1w.val_n(ha, ci))
    nf += 1
  } else if done && allowed && (pn > 0 || !head_req) {
    let cl = "${pn}"
    at = field(d, at, "content-length", raw.data(cl), cl.len())
    nf += 1
  }
  if http1w.find(ha, hn, "Date") < 0 {
    le32(d, at, 4)
    le32(d, at + 4, 29)
    let a = http1w.put(d, at + 8, "date")
    at = http1w.put_date(d, a)
    nf += 1
  }
  le32(d, 0, nf)
  at
}

// ---------------------------------------------------------------------------
// Reading frames

// The frame types the reader checks (RFC 9113 6) and the flags.
const T_DATA: Int = 0
const T_PRIORITY: Int = 2
const T_PUSH: Int = 5
const T_PING: Int = 6
const F_PADDED: Int = 8
const F_PRIORITY: Int = 0x20

// The error codes the checks give (RFC 9113 7).
const E_PROTOCOL: Int = 1
const E_FRAME_SIZE: Int = 6

// frame_check's results.
pub const FC_OK: Int = 0
pub const FC_IGNORE: Int = 1
pub const FC_CONN: Int = 2
pub const FC_STREAM: Int = 3

fn get32(p: Int) -> Int { rt.mem_load(p, 0, 1) << 24 | rt.mem_load(p, 1, 1) << 16 | rt.mem_load(p, 2, 1) << 8 | rt.mem_load(p, 3, 1) }

/// Checks the frame of the 9 byte header at h and the payload at p as
/// the server's reader does before it acts on one (checkFrameOrder and
/// the Framer's parsers): FC_OK with three words at res, the offset and
/// the length of the frame's data in the payload (padding and priority
/// taken off) and the stream a HEADERS frame depends on; FC_IGNORE for an
/// unknown type; FC_CONN or FC_STREAM with the error code at res for a
/// connection or a stream error. hb_on: a header block is being received,
/// on stream hb_sid.
pub fn frame_check(h: Int, p: Int, hb_on: Bool, hb_sid: Int, res: Int) -> Int {
  let len = rt.mem_load(h, 0, 1) << 16 | rt.mem_load(h, 1, 1) << 8 | rt.mem_load(h, 2, 1)
  let ty = rt.mem_load(h, 3, 1)
  let flags = rt.mem_load(h, 4, 1)
  let sid = get32(h + 5) & 0x7FFFFFFF
  if hb_on {
    if ty != T_CONT || sid != hb_sid {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
  } else if ty == T_CONT {
    return fail(res, FC_CONN, E_PROTOCOL)
  }
  var off = 0
  var dn = len
  var dep = 0
  if ty == T_DATA || ty == T_HEADERS {
    if sid == 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
    var pad = 0
    if (flags & F_PADDED) != 0 {
      if dn < 1 {
        return fail(res, FC_CONN, E_PROTOCOL)
      }
      pad = rt.mem_load(p, 0, 1)
      off = 1
      dn -= 1
    }
    if ty == T_HEADERS && (flags & F_PRIORITY) != 0 {
      if dn < 5 {
        return fail(res, FC_CONN, E_PROTOCOL)
      }
      dep = get32(p + off) & 0x7FFFFFFF
      off += 5
      dn -= 5
    }
    if pad > dn {
      // parseHeadersFrame's is a stream error
      return fail(res, if ty == T_HEADERS { FC_STREAM } else { FC_CONN }, E_PROTOCOL)
    }
    dn -= pad
  } else if ty == T_PRIORITY {
    if sid == 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
    if len != 5 {
      return fail(res, FC_CONN, E_FRAME_SIZE)
    }
  } else if ty == T_RST {
    if len != 4 {
      return fail(res, FC_CONN, E_FRAME_SIZE)
    }
    if sid == 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
  } else if ty == T_SETTINGS {
    if sid != 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
  } else if ty == T_PUSH || ty == T_CONT {
    if sid == 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
  } else if ty == T_PING {
    if len != 8 {
      return fail(res, FC_CONN, E_FRAME_SIZE)
    }
    if sid != 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
  } else if ty == T_GOAWAY {
    if sid != 0 {
      return fail(res, FC_CONN, E_PROTOCOL)
    }
    if len < 8 {
      return fail(res, FC_CONN, E_FRAME_SIZE)
    }
  } else if ty == T_WINUP {
    if len != 4 {
      return fail(res, FC_CONN, E_FRAME_SIZE)
    }
    if (get32(p) & 0x7FFFFFFF) == 0 {
      return fail(res, if sid == 0 { FC_CONN } else { FC_STREAM }, E_PROTOCOL)
    }
  } else {
    return FC_IGNORE
  }
  rt.mem_store(res, 0, off, 8)
  rt.mem_store(res, 8, dn, 8)
  rt.mem_store(res, 16, dep, 8)
  FC_OK
}

fn fail(res: Int, kind: Int, code: Int) -> Int {
  rt.mem_store(res, 0, code, 8)
  kind
}

// ---------------------------------------------------------------------------
// Received header fields

/// validWireHeaderFieldName: token bytes, no upper case.
fn wire_name_ok(p: Int, n: Int) -> Bool {
  if n == 0 {
    return false
  }
  var i = 0
  while i < n {
    let c = rt.mem_load(p, i, 1)
    if (c >= 65 && c <= 90) || (Int(http1_tables.CLASS[c & 255]) & 1) == 0 {
      return false
    }
    i += 1
  }
  true
}

/// The checks Framer.readMetaFrame makes of each field of a header block
/// (the nn bytes of the name at np, the vn of the value at vp) with the
/// block's state in four words at st: the size the header list may still
/// take, then whether a field was invalid, whether the list was cut, and
/// whether a regular field came (after which a pseudo field is invalid).
/// True when the field is kept.
pub fn field_keep(np: Int, nn: Int, vp: Int, vn: Int, st: Int) -> Bool {
  if rt.mem_load(st, 8, 8) != 0 || rt.mem_load(st, 16, 8) != 0 {
    return false
  }
  if !value_ok(vp, vn) {
    rt.mem_store(st, 8, 1, 8)
    return false
  }
  if nn > 0 && rt.mem_load(np, 0, 1) == 58 {
    if rt.mem_load(st, 24, 8) != 0 {
      rt.mem_store(st, 8, 1, 8)
      return false
    }
  } else {
    rt.mem_store(st, 24, 1, 8)
    if !wire_name_ok(np, nn) {
      rt.mem_store(st, 8, 1, 8)
      return false
    }
  }
  let size = nn + vn + 32
  let remain = rt.mem_load(st, 0, 8)
  if size > remain {
    rt.mem_store(st, 16, 1, 8)
    rt.mem_store(st, 0, 0, 8)
    return false
  }
  rt.mem_store(st, 0, remain - size, 8)
  true
}

/// MetaHeadersFrame.checkPseudos of the hn fields at ha: the pseudo
/// fields known, none twice, not both a request's and a response's.
/// Stores 1 at resp when there was :status, else 0.
pub fn pseudos_ok(ha: Int, hn: Int, resp: Int) -> Bool {
  var req = false
  var res = false
  var i = 0
  while i < hn {
    let kp = http1w.key_p(ha, i)
    let kn = http1w.key_n(ha, i)
    if kn > 0 && rt.mem_load(kp, 0, 1) == 58 {
      if http1w.mem_is(kp, kn, ":method") || http1w.mem_is(kp, kn, ":path") || http1w.mem_is(kp, kn, ":scheme") || http1w.mem_is(kp, kn, ":authority") || http1w.mem_is(kp, kn, ":protocol") {
        req = true
      } else if http1w.mem_is(kp, kn, ":status") {
        res = true
      } else {
        return false
      }
      var j = 0
      while j < i {
        if http1w.key_n(ha, j) == kn && raw.mem_eq(http1w.key_p(ha, j), kp, kn) {
          return false
        }
        j += 1
      }
    }
    i += 1
  }
  rt.mem_store(resp, 0, if res { 1 } else { 0 }, 8)
  !(req && res)
}

// ---------------------------------------------------------------------------
// Requests

// request_check's kinds (xo_h2.c H2K_*).
pub const K_MALFORMED: Int = -1
pub const K_APP: Int = 0
pub const K_431: Int = 1
pub const K_400: Int = 2
pub const K_OPTIONS: Int = 3

/// The index of the field named name exactly (the received names are
/// lower case), or -1.
fn field_at(ha: Int, hn: Int, name: Str) -> Int { http1w.find(ha, hn, name) }

fn has(ha: Int, hn: Int, name: Str) -> Bool { field_at(ha, hn, name) >= 0 }

fn val(ha: Int, i: Int) -> Str { if i < 0 { "" } else { raw.str_at(http1w.val_p(ha, i), http1w.val_n(ha, i)) } }

/// What a request of the hn checked fields at ha is (processHeaders,
/// newWriterAndRequest, checkValidHTTP2RequestHeaders): K_MALFORMED (a
/// stream error), K_431 when the header list was cut (truncated), K_400
/// with its error text written zero terminated at msg (120 bytes), K_OPTIONS
/// for OPTIONS *, else K_APP.
pub fn request_check(ha: Int, hn: Int, truncated: Bool, msg: Int) -> Int {
  if has(ha, hn, ":protocol") {
    return K_MALFORMED // extended CONNECT is off
  }
  let mi = field_at(ha, hn, ":method")
  let method = val(ha, mi)
  let path = val(ha, field_at(ha, hn, ":path"))
  let scheme = val(ha, field_at(ha, hn, ":scheme"))
  let auth = val(ha, field_at(ha, hn, ":authority"))
  if mi >= 0 && method == "CONNECT" {
    if path.len() > 0 || scheme.len() > 0 || auth.len() == 0 {
      return K_MALFORMED
    }
  } else if method.len() == 0 || path.len() == 0 || !(scheme == "https" || scheme == "http") {
    return K_MALFORMED
  }
  if auth.contains("@") && (scheme == "http" || scheme == "https") {
    return K_MALFORMED
  }
  if truncated {
    return K_431
  }
  // connection specific fields, in net/http's order
  for k in ["Connection", "Keep-Alive", "Proxy-Connection", "Transfer-Encoding", "Upgrade"] {
    if has(ha, hn, k.to_lower()) {
      let _n = raw.put_cstr(msg, "request header \"${k}\" is not valid in HTTP/2")
      return K_400
    }
  }
  var tes = 0
  var te_ok = true
  var i = 0
  while i < hn {
    if http1w.mem_is(http1w.key_p(ha, i), http1w.key_n(ha, i), "te") {
      tes += 1
      let v = val(ha, i)
      te_ok = te_ok && (v == "trailers" || v.len() == 0)
    }
    i += 1
  }
  if tes > 0 && (tes > 1 || !te_ok) {
    let _n = raw.put_cstr(msg, "request header \"TE\" may only be \"trailers\" in HTTP/2")
    return K_400
  }
  if method == "OPTIONS" && path == "*" {
    return K_OPTIONS
  }
  K_APP
}

// ---------------------------------------------------------------------------
// SETTINGS

// The settings the checks know (RFC 9113 6.5.2, RFC 8441).
const S_ENABLE_PUSH: Int = 2
const S_INITIAL_WINDOW: Int = 4
const S_MAX_FRAME: Int = 5
const S_CONNECT: Int = 8
const E_FLOW: Int = 3

/// The checks of the n bytes of a SETTINGS frame's payload at p (not an
/// ACK) that need no state (SettingsFrame's and serverConn.processSetting's):
/// the index of the first setting that fails one, times 16, plus its error
/// code; the number of settings times 16 when none fails. A payload that
/// is not whole settings, has more than 100, or names one twice fails at
/// 0, before any setting applies.
pub fn settings_check(p: Int, n: Int) -> Int {
  if n % 6 != 0 {
    return E_FRAME_SIZE
  }
  let k = n / 6
  if k > 100 {
    return E_PROTOCOL
  }
  var i = 0
  while i < k {
    let id = rt.mem_load(p, 6 * i, 1) << 8 | rt.mem_load(p, 6 * i + 1, 1)
    var j = 0
    while j < i {
      if id == (rt.mem_load(p, 6 * j, 1) << 8 | rt.mem_load(p, 6 * j + 1, 1)) {
        return E_PROTOCOL
      }
      j += 1
    }
    i += 1
  }
  i = 0
  while i < k {
    let id = rt.mem_load(p, 6 * i, 1) << 8 | rt.mem_load(p, 6 * i + 1, 1)
    let v = get32(p + 6 * i + 2)
    if (id == S_ENABLE_PUSH || id == S_CONNECT) && v > 1 {
      return 16 * i + E_PROTOCOL
    }
    if id == S_INITIAL_WINDOW && v > 0x7FFFFFFF {
      return 16 * i + E_FLOW
    }
    if id == S_MAX_FRAME && (v < 16384 || v > 16777215) {
      return 16 * i + E_PROTOCOL
    }
    i += 1
  }
  16 * k
}
