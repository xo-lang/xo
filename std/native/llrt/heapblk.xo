// The runtime's records by the address rt.heap_large returned (task #354,
// class guard 5 of 2026-11-18): rt.heap_release and rt.heap_large_resize
// take the block's prefix, 8 bytes before that address, and five fixes
// (94d73568b, 5d3d1380a, 30c685590, ab1d601c0, 652514dcc) were a caller's
// `- 8` done wrong or not at all. Callers pass the address they hold and
// these do the `- 8`; repotest's TestNoHandPrefixFree rejects a hand
// `rt.heap_release(x - 8)` in std/native. A leaf (rt only),
// so every runtime module may import it without a cycle.
use native/rt

/// Gives back the block rt.heap_large (or resize) returned at p.
pub fn release(p: Int) {
  if checking() {
    check(p)
  }
  rt.heap_release(p.wrapping_sub(8))
}

/// The block rt.heap_large returned at p made n bytes (its first bytes
/// kept): the address after its new prefix, as rt.heap_large's.
pub fn resize(p: Int, n: Int) -> Int {
  if checking() {
    check(p)
  }
  rt.heap_large_resize(p.wrapping_sub(8), n)
}

/// Static word 110 (std/native/rt.xo's table): 1 under the free check,
/// 3 with the frees' stacks (XO_FREE_CHECK=stack), 2 once its report
/// runs (report_on).
const W_CHECK = 110

/// Turns the prefix check on: XO_FREE_CHECK's start (heapos.xo
/// free_check_on), while one thread runs; stacks: each free's stack is
/// recorded too (stacks_on).
pub fn check_on(stacks: Bool) {
  rt.mem_store(rt.static_word(W_CHECK), 0, if stacks { 3 } else { 1 }, 8)
}

/// Whether the free check records each free's stack (XO_FREE_CHECK=stack,
/// task #343).
pub fn stacks_on() -> Bool {
  rt.mem_load(rt.static_word(W_CHECK), 0, 8) == 3
}

/// Whether the free check runs (`xo test --check=free`, XO_FREE_CHECK=1,
/// decision 0484): one load and test on every free and resize.
fn checking() -> Bool {
  rt.mem_load(rt.static_word(W_CHECK), 0, 8) != 0
}

/// The free check's report has begun (heapos.xo written_after_free, task
/// #343): word W_CHECK is 2, the prefix check stays on, and heapos.xo
/// free_hold gives blocks back at once, so the report's own frees cannot
/// report again.
pub fn report_on() {
  rt.mem_store(rt.static_word(W_CHECK), 0, 2, 8)
}

/// Whether the free check's report runs (report_on).
pub fn reporting() -> Bool {
  rt.mem_load(rt.static_word(W_CHECK), 0, 8) == 2
}

/// Under the free check: the word before p is a heap_large prefix (minus
/// the block's size, so 0 or below and above minus 2^47), else p is no
/// address rt.heap_large returned and the program ends (status 70) with
/// heapos.xo bad_release's message, given an address no prefix has (odd).
fn check(p: Int) {
  let w = rt.mem_load(p.wrapping_sub(8), 0, 8)
  if w > 0 || w < MIN_PREFIX {
    rt.heap_release(p.wrapping_sub(8) | 1)
  }
}

/// The lowest prefix: minus the largest block (2^47 bytes, past any
/// address space a target has).
const MIN_PREFIX = -0x800000000000
