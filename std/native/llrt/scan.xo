// The bulk byte scans of the native runtime, written in Xo over the scan
// intrinsics of decision 0201 (decision 0195 prerequisite 4): searches
// for a byte and for a text, comparisons of ranges, the count of UTF-8
// continuation bytes, the runs of std/native/llrt/unicode.xo's quoting,
// and the Str and Bytes operations that are only such scans and copies
// (Str.split, Str.lines, Str.rune_count, Bytes.to_hex), which decision
// 0193 kept C. Sixteen bytes a step through rt.bytes_eq16 and
// rt.bytes_high16 (NEON on arm64, a <16 x i8> compare on LLVM, two words
// in the wasm runtime; on amd64 their _bits forms, pmovmskb's one bit a
// byte, through eq16_1 and high16_1), eight a step through rt.bytes_word, the lowest
// match by rt.ctz. A range shorter than a step that ends at least a step
// into its value is read as the step ending at its end, its bytes before
// the range shifted out; only bytes of the value are ever read. Decision
// 0198 deleted the selectable C path (`XO_LLRT_C=scan`); the C functions
// stay for the C runtime's own callers.
use native/rt
use native/llrt/raw

// Words of eight equal bytes.
const ONES: Int = 72340172838076673
const HIGHS: Int = -9187201950435737472
const LOW7S: Int = 9187201950435737471
const SPACES: Int = 2314885530818453536
const QUOTES: Int = 2459565876494606882
const BACKSLASHES: Int = 6655295901103053916
/// Bit 0 of every nibble (0x1111111111111111, a logical immediate on
/// arm64): one bit a byte of a mask of rt.bytes_eq16.
const NIBS: Int = 1229782938247303441

/// One bit a byte for the 16 bytes of b from i equal to c: bit k << bsh()
/// for byte i + k. On amd64 pmovmskb's bits (rt.bytes_eq16_bits, bsh 0:
/// the nibble narrowing was eleven SSE instructions a step, 2026-10-23),
/// elsewhere the nibble mask's low bits (bsh 2).
fn eq16_1(b: Bytes, i: Int, c: Int) -> Int {
  match target.arch {
    TargetArch.Amd64 => rt.bytes_eq16_bits(b, i, c)
    _ => rt.bytes_eq16(b, i, c) & NIBS
  }
}

/// eq16_1 for the bytes 0x80 and above.
fn high16_1(b: Bytes, i: Int) -> Int {
  match target.arch {
    TargetArch.Amd64 => rt.bytes_high16_bits(b, i)
    _ => rt.bytes_high16(b, i) & NIBS
  }
}

/// The shift from a bit of eq16_1's mask to its byte: 0 on amd64, else 2.
fn bsh() -> Int {
  match target.arch {
    TargetArch.Amd64 => 0
    _ => 2
  }
}

fn addw(a: Int, b: Int) -> Int { a.wrapping_add(b) }

fn subw(a: Int, b: Int) -> Int { a.wrapping_sub(b) }

fn mulw(a: Int, b: Int) -> Int { a.wrapping_mul(b) }

fn shl(a: Int, k: Int) -> Int { a.wrapping_shl(k) }

fn shr(a: Int, k: Int) -> Int { a.shr_logical(k) }

/// The high bit of each byte of w that is the byte of r (eight copies of
/// one byte), exactly.
fn eq8(w: Int, r: Int) -> Int {
  let y = w ^ r
  ((addw(y & LOW7S, LOW7S) | y) ^ -1) & HIGHS
}

/// The index of the first byte c (0 to 255) of b from `from` to `to`
/// (to <= b.len()), or -1.
pub fn find_byte(b: Bytes, from: Int, to: Int, c: Int) -> Int {
  var i = from
  while to - i >= 16 {
    let m = eq16_1(b, i, c)
    if m != 0 {
      return i + (rt.ctz(m) >> bsh())
    }
    i += 16
  }
  if i >= to {
    return -1
  }
  if to >= 16 {
    // the 16 bytes ending at to; those before i were searched
    let k = to - 16
    let m = shr(eq16_1(b, k, c), shl(i - k, bsh()))
    if m == 0 {
      return -1
    }
    return i + (rt.ctz(m) >> bsh())
  }
  find_short(b, i, to, c)
}

/// find_byte from i to `to` < 16 (fewer than 16 bytes).
fn find_short(b: Bytes, from: Int, to: Int, c: Int) -> Int {
  var i = from
  let r = mulw(c, ONES)
  if to - i >= 8 {
    let m = eq8(rt.bytes_word(b, i), r)
    if m != 0 {
      return i + (rt.ctz(m) >> 3)
    }
    i += 8
    if i == to {
      return -1
    }
  }
  if to >= 8 {
    let k = to - 8
    let m = shr(eq8(rt.bytes_word(b, k), r), 8 * (i - k))
    if m == 0 {
      return -1
    }
    return i + (rt.ctz(m) >> 3)
  }
  while i < to {
    if Int(b[i]) == c {
      return i
    }
    i += 1
  }
  -1
}

/// The number of the byte c (0 to 255) in b from `from` to `to` (to <=
/// b.len()), 16 bytes a step: bytes.Count for a one byte sub.
pub fn count_byte(b: Bytes, from: Int, to: Int, c: Int) -> Int {
  var n = 0
  var i = from
  while to - i >= 16 {
    n += rt.popcount(eq16_1(b, i, c))
    i = addw(i, 16)
  }
  if i < to {
    n += rt.popcount(tail16(b, i, to, c))
  }
  n
}

/// Whether the n bytes of a from ai are the n bytes of b from bi (both
/// ranges inside their values).
pub fn eq_at(a: Bytes, ai: Int, b: Bytes, bi: Int, n: Int) -> Bool {
  // 8 to 16 bytes: two words, the second ending at the end (overlapping
  // the first); 4 to 7: the same with 4 byte words. With a literal for b
  // n is a constant once inlined, so no loop remains.
  if n >= 8 && n <= 16 {
    return rt.bytes_word(a, ai) == rt.bytes_word(b, bi) && rt.bytes_word(a, ai + n - 8) == rt.bytes_word(b, bi + n - 8)
  }
  if n >= 4 && n < 8 {
    let pa = raw.bytes_addr(a).wrapping_add(ai)
    let pb = raw.bytes_addr(b).wrapping_add(bi)
    return rt.mem_load(pa, 0, 4) == rt.mem_load(pb, 0, 4) && rt.mem_load(pa, n - 4, 4) == rt.mem_load(pb, n - 4, 4)
  }
  if n >= 8 {
    var t = 0
    while n - t > 8 {
      if rt.bytes_word(a, ai + t) != rt.bytes_word(b, bi + t) {
        return false
      }
      t += 8
    }
    return rt.bytes_word(a, ai + n - 8) == rt.bytes_word(b, bi + n - 8)
  }
  if n >= 4 {
    // 4 to 7 bytes: the first four and the last four, overlapping
    let pa = raw.bytes_addr(a) + ai
    let pb = raw.bytes_addr(b) + bi
    return rt.mem_load(pa, 0, 4) == rt.mem_load(pb, 0, 4) && rt.mem_load(pa, n - 4, 4) == rt.mem_load(pb, n - 4, 4)
  }
  var t = 0
  while t < n {
    if a[ai + t] != b[bi + t] {
      return false
    }
    t += 1
  }
  true
}

/// Whether p is the text of s at i, for a caller that knows 0 <= i and
/// i + p.len() <= s.len(): eq_at on the text's words with no Bytes values
/// and no bounds checks (the trim_prefix and trim_suffix tests).
pub fn eq_text(s: Str, i: Int, p: Str) -> Bool {
  let n = p.len()
  let a = raw.data(s).wrapping_add(i)
  let b = raw.data(p)
  var t = 0
  if n >= 4 {
    // 4-byte words, then the last word (overlapping)
    while n.wrapping_sub(t) > 4 {
      if rt.mem_load(a, t, 4) != rt.mem_load(b, t, 4) {
        return false
      }
      t = t.wrapping_add(4)
    }
    let e = n.wrapping_sub(4)
    return rt.mem_load(a, e, 4) == rt.mem_load(b, e, 4)
  }
  if n >= 2 {
    let e = n.wrapping_sub(2)
    return rt.mem_load(a, 0, 2) == rt.mem_load(b, 0, 2) && rt.mem_load(a, e, 2) == rt.mem_load(b, e, 2)
  }
  n == 0 || rt.mem_load(a, 0, 1) == rt.mem_load(b, 0, 1)
}

/// strings.Index of sub in s from `from` (rt.str_find): from below 0 is
/// 0, from past the end finds nothing, an empty sub is found at from.
pub fn find(s: Str, sub: Str, from: Int) -> Int {
  let n = s.len()
  let m = sub.len()
  let f = if from < 0 { 0 } else { from }
  if f > n {
    return -1
  }
  if m == 0 {
    return f
  }
  if m > n - f {
    return -1
  }
  let b = s.bytes()
  let p = sub.bytes()
  let c = Int(p[0])
  // the starts that leave room for sub
  let last = n - m + 1
  var i = f
  while true {
    i = find_byte(b, i, last, c)
    if i < 0 {
      return -1
    }
    if m == 1 || eq_at(b, i + 1, p, 1, m - 1) {
      return i
    }
    i += 1
  }
  -1
}

/// Whether the bytes of s from i (clamped to 0 and s.len()) start with
/// p: rt.str_starts_with(raw.str_slice(s, i, s.len()), p) without the
/// copy.
pub fn has_at(s: Str, i: Int, p: Str) -> Bool {
  let n = s.len()
  let lo = if i < 0 { 0 } else if i > n { n } else { i }
  p.len() <= n - lo && eq_at(s.bytes(), lo, p.bytes(), 0, p.len())
}

pub fn contains(s: Str, sub: Str) -> Bool { find(s, sub, 0) >= 0 }

/// strings.Count: the number of non-overlapping copies of sub in s; for ""
/// the count of s's runes plus one (Go's utf8.RuneCountInString(s) + 1).
pub fn count(s: Str, sub: Str) -> Int {
  let m = sub.len()
  if m == 0 {
    return rune_count(s) + 1
  }
  var n = 0
  var i = find(s, sub, 0)
  while i >= 0 {
    n += 1
    i = find(s, sub, i + m)
  }
  n
}

pub fn starts_with(s: Str, p: Str) -> Bool { p.len() <= s.len() && eq_at(s.bytes(), 0, p.bytes(), 0, p.len()) }

pub fn ends_with(s: Str, p: Str) -> Bool { p.len() <= s.len() && eq_at(s.bytes(), s.len() - p.len(), p.bytes(), 0, p.len()) }

/// strings.IndexRune: the byte offset of r in s, or -1. r below 0x80 is a
/// byte search; otherwise s is decoded (an invalid byte decodes as U+FFFD,
/// so a U+FFFD r finds it, as Go's does).
pub fn index_rune(s: Str, r: Rune) -> Int {
  let b = s.bytes()
  if Int(r) < 0x80 {
    return find_byte(b, 0, b.len(), Int(r))
  }
  var i = 0
  while i < b.len() {
    let (x, sz) = b.decode_rune(i)
    if x == r {
      return i
    }
    i += sz
  }
  -1
}

/// Go's makeASCIISet: the bytes of b as two 64 bit words, and whether every
/// byte is ASCII (only then does the set answer for all of them).
fn ascii_set(b: Bytes) -> (Int, Int, Bool) {
  var lo = 0
  var hi = 0
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c >= 0x80 {
      return (0, 0, false)
    }
    if c < 64 {
      lo = lo | shl(1, c)
    } else {
      hi = hi | shl(1, c - 64)
    }
    i += 1
  }
  (lo, hi, true)
}

/// Whether the ASCII word pair holds byte c: a non-ASCII byte is never in a
/// set built from an ASCII chars.
fn in_set(lo: Int, hi: Int, c: Int) -> Bool {
  if c < 64 {
    return (shr(lo, c) & 1) != 0
  }
  if c < 0x80 {
    return (shr(hi, c - 64) & 1) != 0
  }
  false
}

/// strings.IndexAny: the byte offset of the first rune of chars in s, or -1.
/// A one byte chars is a rune search, as Go's; an ASCII chars of any length
/// over a long s is Go's word set path, scanning the bytes of s.
pub fn index_any(s: Str, chars: Str) -> Int {
  let n = s.len()
  let cb = chars.bytes()
  let m = cb.len()
  if m == 0 {
    return -1
  }
  if m == 1 {
    // one byte is ASCII: a Str holds valid UTF-8, so a byte of 0x80 or
    // above never stands alone (Go's RuneError case for it cannot arise)
    return index_rune(s, Rune(Int(cb[0])))
  }
  let (lo, hi, ascii) = ascii_set(cb)
  let b = s.bytes()
  if ascii && n > 8 {
    var i = 0
    while i < n {
      if in_set(lo, hi, Int(b[i])) {
        return i
      }
      i += 1
    }
    return -1
  }
  var i = 0
  while i < n {
    let (x, sz) = b.decode_rune(i)
    if index_rune(chars, x) >= 0 {
      return i
    }
    i += sz
  }
  -1
}

/// utf8.DecodeLastRuneInString: the last rune of b[0..end] and its size (a
/// byte that is not part of a complete sequence decodes as U+FFFD of 1).
fn decode_last(b: Bytes, end: Int) -> (Rune, Int) {
  let c = Int(b[end - 1])
  if c < 0x80 {
    return (Rune(c), 1)
  }
  // back over at most UTFMax - 1 continuation bytes to the start byte
  var i = end - 2
  var k = 0
  while i >= 0 && k < 3 {
    if Int(b[i]) & 0xC0 != 0x80 {
      break
    }
    i -= 1
    k += 1
  }
  if i < 0 {
    i = 0
  }
  let (r, sz) = b.decode_rune(i)
  if i + sz != end {
    return (Rune(0xFFFD), 1)
  }
  (r, sz)
}

/// strings.LastIndexAny: the byte offset of the last rune of chars in s, or
/// -1.
pub fn last_index_any(s: Str, chars: Str) -> Int {
  let n = s.len()
  let cb = chars.bytes()
  if cb.len() == 0 {
    return -1
  }
  let (lo, hi, ascii) = ascii_set(cb)
  let b = s.bytes()
  if ascii && n > 8 {
    var i = n - 1
    while i >= 0 {
      if in_set(lo, hi, Int(b[i])) {
        return i
      }
      i -= 1
    }
    return -1
  }
  var end = n
  while end > 0 {
    let (x, sz) = decode_last(b, end)
    end -= sz
    if index_rune(chars, x) >= 0 {
      return end
    }
  }
  -1
}

/// strings.Cut: the text before and after the first sep, as views of s;
/// None when sep does not occur, and sep "" cuts at the start.
pub fn cut(s: Str, sep: Str) -> (Str, Str)? {
  let i = find(s, sep, 0)
  if i < 0 {
    return None
  }
  Some((s[0..i], s[i + sep.len()..]))
}

/// strings.CutPrefix: the rest of s after prefix, a view of s; None when s
/// does not start with prefix, and prefix "" gives s.
pub fn cut_prefix(s: Str, prefix: Str) -> Str? {
  if !starts_with(s, prefix) {
    return None
  }
  Some(s[prefix.len()..])
}

/// strings.CutSuffix: s up to suffix, a view of s; None when s does not end
/// with suffix, and suffix "" gives s.
pub fn cut_suffix(s: Str, suffix: Str) -> Str? {
  if !ends_with(s, suffix) {
    return None
  }
  Some(s[0..s.len() - suffix.len()])
}

/// strings.Trim: s without its leading and trailing runes in chars, as a
/// view of s. Go's fast paths: an empty s or chars is s, a one byte ASCII
/// chars trims that byte, an ASCII chars is a bitmap, else runes are
/// decoded and looked up in chars.
pub fn trim_chars(s: Str, chars: Str) -> Str {
  if s.len() == 0 || chars.len() == 0 {
    return s
  }
  let cb = chars.bytes()
  if chars.len() == 1 && cb[0] < 0x80 {
    return trim_start_byte(trim_end_byte(s, cb[0]), cb[0])
  }
  let (lo, hi, ascii) = ascii_set(cb)
  if ascii {
    return trim_start_ascii(trim_end_ascii(s, lo, hi), lo, hi)
  }
  trim_start_unicode(trim_end_unicode(s, chars), chars)
}

/// strings.TrimLeft: s without its leading runes in chars, a view of s.
pub fn trim_start_chars(s: Str, chars: Str) -> Str {
  if s.len() == 0 || chars.len() == 0 {
    return s
  }
  let cb = chars.bytes()
  if chars.len() == 1 && cb[0] < 0x80 {
    return trim_start_byte(s, cb[0])
  }
  let (lo, hi, ascii) = ascii_set(cb)
  if ascii {
    return trim_start_ascii(s, lo, hi)
  }
  trim_start_unicode(s, chars)
}

/// strings.TrimRight: s without its trailing runes in chars, a view of s.
pub fn trim_end_chars(s: Str, chars: Str) -> Str {
  if s.len() == 0 || chars.len() == 0 {
    return s
  }
  let cb = chars.bytes()
  if chars.len() == 1 && cb[0] < 0x80 {
    return trim_end_byte(s, cb[0])
  }
  let (lo, hi, ascii) = ascii_set(cb)
  if ascii {
    return trim_end_ascii(s, lo, hi)
  }
  trim_end_unicode(s, chars)
}

// The ASCII trims cut where an ASCII byte (one of the set, or the first
// byte past them) meets the rest: a UTF-8 boundary in range, so a view
// with no range or boundary check (rt.str_view; 2026-10-23: the checked
// slice was 22% of bench/perf/trimchars trim, DS-1's profile).
fn trim_start_byte(s: Str, c: UInt8) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() && b[i] == c {
    i += 1
  }
  rt.str_view(s, i, s.len())
}

fn trim_end_byte(s: Str, c: UInt8) -> Str {
  let b = s.bytes()
  var n = b.len()
  while n > 0 && b[n - 1] == c {
    n -= 1
  }
  rt.str_view(s, 0, n)
}

fn trim_start_ascii(s: Str, lo: Int, hi: Int) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() && in_set(lo, hi, Int(b[i])) {
    i += 1
  }
  rt.str_view(s, i, s.len())
}

fn trim_end_ascii(s: Str, lo: Int, hi: Int) -> Str {
  let b = s.bytes()
  var n = b.len()
  while n > 0 && in_set(lo, hi, Int(b[n - 1])) {
    n -= 1
  }
  rt.str_view(s, 0, n)
}

fn trim_start_unicode(s: Str, chars: Str) -> Str {
  let b = s.bytes()
  var i = 0
  while i < b.len() {
    let (r, sz) = b.decode_rune(i)
    if index_rune(chars, r) < 0 {
      break
    }
    i += sz
  }
  s[i..]
}

fn trim_end_unicode(s: Str, chars: Str) -> Str {
  let b = s.bytes()
  var n = b.len()
  while n > 0 {
    let (r, sz) = decode_last(b, n)
    if index_rune(chars, r) < 0 {
      break
    }
    n -= sz
  }
  s[0..n]
}

/// The number of UTF-8 continuation bytes (0x80 to 0xBF) in w.
fn cont8(w: Int) -> Int { rt.popcount(w & (shl(w, 1) ^ -1) & HIGHS) }

/// The number of continuation bytes of b from `from` to `to`.
pub fn count_cont(b: Bytes, from: Int, to: Int) -> Int {
  var c = 0
  var i = from
  while to - i >= 8 {
    c += cont8(rt.bytes_word(b, i))
    i += 8
  }
  if i < to {
    if to >= 8 {
      // the word ending at to, its bytes before i shifted out
      let k = to - 8
      return c + cont8(shr(rt.bytes_word(b, k), 8 * (i - k)))
    }
    while i < to {
      if (Int(b[i]) & 0xC0) == 0x80 {
        c += 1
      }
      i += 1
    }
  }
  c
}

/// utf8.RuneCountInString: a Str is valid UTF-8 (core 2.2), so its runes
/// are its bytes other than continuation bytes.
pub fn rune_count(s: Str) -> Int { s.len() - count_cont(s.bytes(), 0, s.len()) }

/// The size of the UTF-8 sequence of b at i (b[i] 0x80 or above, i < n
/// = b.len()) when it is valid (2 to 4), else 1 (utf8.DecodeRune's
/// rules: no overlong forms, surrogates, or runes above U+10FFFF).
fn seq_len(b: Bytes, i: Int, n: Int) -> Int {
  let c = Int(b[i])
  var k = 0
  var lo = 0x80
  var hi = 0xBF
  if c >= 0xC2 && c <= 0xDF {
    k = 1
  } else if c >= 0xE0 && c <= 0xEF {
    k = 2
    if c == 0xE0 {
      lo = 0xA0
    } else if c == 0xED {
      hi = 0x9F
    }
  } else if c >= 0xF0 && c <= 0xF4 {
    k = 3
    if c == 0xF0 {
      lo = 0x90
    } else if c == 0xF4 {
      hi = 0x8F
    }
  } else {
    return 1
  }
  if n - i <= k {
    return 1
  }
  let c1 = Int(b[i + 1])
  if c1 < lo || c1 > hi {
    return 1
  }
  var j = 2
  while j <= k {
    if (Int(b[i + j]) & 0xC0) != 0x80 {
      return 1
    }
    j += 1
  }
  k + 1
}

/// utf8.Valid: runs of ASCII skipped 16 bytes at a time (span).
pub fn utf8_valid(b: Bytes) -> Bool {
  let n = b.len()
  var i = 0
  while i < n {
    if b[i] < 0x80 {
      i = span(b, i, 0)
      continue
    }
    let k = seq_len(b, i, n)
    if k == 1 {
      return false
    }
    i += k
  }
  true
}

// Outside bytes becoming Str (decision 0259): the only way native std
// turns bytes it read (a request, a file, the environment, an archive)
// into Str. Valid UTF-8 is copied as it is (one scan, 16 bytes at a time
// over ASCII); each byte of an invalid sequence becomes U+FFFD, as a
// decoder sees it (one rune per invalid byte: Bytes.rune_count, JSON);
// URL paths and queries keep the byte as a percent escape instead
// (url_text_at). internal/repotest TestOutsideBytesValidated lists the
// boundaries that must call these.

/// The Str of the n bytes at address p, valid UTF-8 (decision 0259).
pub fn text_at(p: Int, n: Int) -> Str { text(raw.str_at(p, n)) }

/// The Str of b, valid UTF-8 (decision 0259).
pub fn text_of(b: Bytes) -> Str { text(rt.cast[Bytes, Str](b)) }

/// s when it is valid UTF-8, else a copy with each byte of an invalid
/// sequence U+FFFD (s holds outside bytes, made with raw's conversions).
pub fn text(s: Str) -> Str {
  let b = s.bytes()
  if utf8_valid(b) {
    return s
  }
  fix_utf8(b, false)
}

/// The Str of the n bytes at p, a URL path or query: valid UTF-8 as it
/// is, each byte of an invalid sequence as a percent escape (%XX) so the
/// URL keeps it (decision 0259).
pub fn url_text_at(p: Int, n: Int) -> Str {
  let s = raw.str_at(p, n)
  let b = s.bytes()
  if utf8_valid(b) {
    return s
  }
  fix_utf8(b, true)
}

/// s (a URL path or query made from outside bytes) as url_text_at.
pub fn url_text(s: Str) -> Str {
  let b = s.bytes()
  if utf8_valid(b) {
    return s
  }
  fix_utf8(b, true)
}

/// b with each byte of an invalid sequence replaced: by U+FFFD, or (esc)
/// by its percent escape.
fn fix_utf8(b: Bytes, esc: Bool) -> Str {
  let n = b.len()
  let hex = "0123456789ABCDEF"
  var o = rt.rs_with_cap(n + 8)
  var i = 0
  while i < n {
    if b[i] < 0x80 {
      let j = span(b, i, 0)
      o = rt.rs_append_bytes(o, b, i, j, 0)
      i = j
      continue
    }
    let k = seq_len(b, i, n)
    if k > 1 {
      o = rt.rs_append_bytes(o, b, i, i + k, 0)
    } else if esc {
      let c = Int(b[i])
      o = rt.rs_push_byte(o, 37)
      o = rt.rs_push_byte(o, raw.byte_at(raw.data(hex), c >> 4))
      o = rt.rs_push_byte(o, raw.byte_at(raw.data(hex), c & 15))
    } else {
      // U+FFFD
      o = rt.rs_push_byte(rt.rs_push_byte(rt.rs_push_byte(o, 0xEF), 0xBF), 0xBD)
    }
    i += k
  }
  o
}

/// utf8.RuneCount (Bytes.rune_count): an invalid byte is one rune.
pub fn bytes_rune_count(b: Bytes) -> Int {
  let n = b.len()
  var c = 0
  var i = 0
  while i < n {
    if b[i] < 0x80 {
      let j = span(b, i, 0)
      c += j - i
      i = j
      continue
    }
    i += seq_len(b, i, n)
    c += 1
  }
  c
}

/// The high bit of each byte of w that ends a run of class 1 of span
/// (below 0x20, 0x7F and above, `"`, `\`; the lowest exact).
fn stops8(w: Int) -> Int {
  let q = w ^ QUOTES
  let s = w ^ BACKSLASHES
  let low = (subw(w, SPACES) | subw(q, ONES) | subw(s, ONES)) & ((w & q & s) ^ -1) & HIGHS
  low | (w & HIGHS) | eq8(w, LOW7S)
}

/// The end of the run of bytes of b from i in the class cls
/// (rt.bytes_span): 0 ASCII (below 0x80), 1 printable ASCII other than
/// `"` and `\` (what strconv.Quote keeps).
pub fn span(b: Bytes, from: Int, cls: Int) -> Int {
  let n = b.len()
  var i = from
  if cls == 0 {
    while n - i >= 16 {
      let m = high16_1(b, i)
      if m != 0 {
        return i + (rt.ctz(m) >> bsh())
      }
      i += 16
    }
    while n - i >= 8 {
      let m = rt.bytes_word(b, i) & HIGHS
      if m != 0 {
        return i + (rt.ctz(m) >> 3)
      }
      i += 8
    }
    while i < n && b[i] < 0x80 {
      i += 1
    }
    return i
  }
  while n - i >= 8 {
    let m = stops8(rt.bytes_word(b, i))
    if m != 0 {
      return i + (rt.ctz(m) >> 3)
    }
    i += 8
  }
  while i < n {
    let c = Int(b[i])
    if c < 0x20 || c >= 0x7F || c == 34 || c == 92 {
      return i
    }
    i += 1
  }
  i
}

/// The index of the first control byte (below 0x20, or 0x7F) of b from
/// `from` to `to` (to <= b.len()), or to: eight bytes a step, the first
/// match exact (a borrow can only mark bytes after it).
pub fn ctl_at(b: Bytes, from: Int, to: Int) -> Int {
  var i = from
  while to - i >= 8 {
    let w = rt.bytes_word(b, i)
    let m = (subw(w, SPACES) & (w ^ -1) & HIGHS) | eq8(w, LOW7S)
    if m != 0 {
      return i + (rt.ctz(m) >> 3)
    }
    i += 8
  }
  while i < to {
    let c = Int(b[i])
    if c < 0x20 || c == 0x7F {
      return i
    }
    i += 1
  }
  to
}

/// The index of the first byte c (0 to 255) of the memory at p from
/// `from` to `to`, or -1: eight bytes a step (unaligned loads; every
/// target is little endian), for a buffer that is not a Bytes (http1.xo's
/// connection input).
pub fn mem_byte(p: Int, from: Int, to: Int, c: Int) -> Int {
  let r = mulw(c, ONES)
  var i = from
  while to - i >= 8 {
    let m = eq8(rt.mem_load(p, i, 8), r)
    if m != 0 {
      return i + (rt.ctz(m) >> 3)
    }
    i += 8
  }
  while i < to {
    if rt.mem_load(p, i, 1) == c {
      return i
    }
    i += 1
  }
  -1
}

/// Bit k << bsh() set when byte i + k of b is c, for the bytes from i to n =
/// b.len() (fewer than 16, i < n): the last step of split and lines.
fn tail16(b: Bytes, i: Int, n: Int, c: Int) -> Int {
  if n >= 16 {
    // the 16 bytes ending at n, those before i shifted out
    let k = n - 16
    return shr(eq16_1(b, k, c), shl(i - k, bsh()))
  }
  var m = 0
  var j = n - 1
  while j >= i {
    m = shl(m, shl(1, bsh()))
    if Int(b[j]) == c {
      m = m | 1
    }
    j -= 1
  }
  m
}

/// strings.Split: an empty separator splits into UTF-8 sequences (an
/// invalid byte alone).
pub fn split(s: Str, sep: Str) -> List[Str] {
  var out: List[Str] = []
  let n = s.len()
  let m = sep.len()
  let b = s.bytes()
  var start = 0
  if m == 0 {
    while start < n {
      let k = if b[start] < 0x80 { 1 } else { raw.bytes_decode(b, start) & 7 }
      out.push(raw.str_slice(s, start, start + k))
      start += k
    }
    return out
  }
  if m == 1 {
    // one byte: 16 at a time, every match of a step in turn
    let c = Int(sep.bytes()[0])
    let last = n - 16
    var i = 0
    while i <= last {
      var k = eq16_1(b, i, c)
      while k != 0 {
        let end = i + (rt.ctz(k) >> bsh())
        out.push(raw.str_cut(s, start, end))
        start = end + 1
        k = k & subw(k, 1)
      }
      i = addw(i, 16)
    }
    if i < n {
      var k = tail16(b, i, n, c)
      while k != 0 {
        let end = i + (rt.ctz(k) >> bsh())
        out.push(raw.str_cut(s, start, end))
        start = end + 1
        k = k & subw(k, 1)
      }
    }
  } else {
    while true {
      let i = find(s, sep, start)
      if i < 0 {
        break
      }
      out.push(raw.str_cut(s, start, i))
      start = i + m
    }
  }
  out.push(raw.str_cut(s, start, n))
  out
}

/// Go's genSplit: s cut at each sep, at most n pieces with the unsplit rest
/// in the last (n below 0: every piece, n 0: none), and each piece ending
/// save bytes past its separator (split_after's sep length, 0 otherwise).
fn split_save(s: Str, sep: Str, save: Int, n: Int) -> List[Str] {
  var out: List[Str] = []
  if n == 0 {
    return out
  }
  if sep.is_empty() {
    return explode_n(s, n)
  }
  if n < 0 && save == 0 {
    return split(s, sep)
  }
  let sl = s.len()
  let m = sep.len()
  var start = 0
  var i = 1
  while n < 0 || i < n {
    let at = find(s, sep, start)
    if at < 0 {
      break
    }
    out.push(raw.str_cut(s, start, at + save))
    start = at + m
    i += 1
  }
  out.push(raw.str_cut(s, start, sl))
  out
}

/// Go's explode: s cut after each UTF-8 sequence, at most n pieces with the
/// rest in the last (n below 0 or above the rune count: one piece per rune).
fn explode_n(s: Str, n: Int) -> List[Str] {
  var out: List[Str] = []
  if n == 0 {
    return out
  }
  let b = s.bytes()
  let sl = b.len()
  var start = 0
  var i = 0
  var count = 0
  while i < sl && (n < 0 || count < n - 1) {
    let k = if b[i] < 0x80 { 1 } else { raw.bytes_decode(b, i) & 7 }
    out.push(raw.str_slice(s, start, start + k))
    start += k
    i += k
    count += 1
  }
  if start < sl {
    out.push(raw.str_slice(s, start, sl))
  }
  out
}

/// strings.SplitN: s cut at sep, at most n pieces (n below 0: all, n 0:
/// none, the rest in the last piece).
pub fn split_n(s: Str, sep: Str, n: Int) -> List[Str] { split_save(s, sep, 0, n) }

/// strings.SplitAfter: like split, each piece keeping its separator.
pub fn split_after(s: Str, sep: Str) -> List[Str] { split_save(s, sep, sep.len(), -1) }

/// strings.SplitAfterN: at most n pieces, each keeping its separator.
pub fn split_after_n(s: Str, sep: Str, n: Int) -> List[Str] { split_save(s, sep, sep.len(), n) }

/// The lines of s: split on \n, a trailing \r of each removed, and no
/// empty last line after a final newline.
pub fn lines(s: Str) -> List[Str] {
  var out: List[Str] = []
  let n = s.len()
  let b = s.bytes()
  var start = 0
  let last = n - 16
  var i = 0
  while i <= last {
    var k = eq16_1(b, i, 10)
    while k != 0 {
      let end = i + (rt.ctz(k) >> bsh())
      out.push(raw.str_cut(s, start, if end > start && b[end - 1] == 13 { end - 1 } else { end }))
      start = end + 1
      k = k & subw(k, 1)
    }
    i = addw(i, 16)
  }
  if i < n {
    var k = tail16(b, i, n, 10)
    while k != 0 {
      let end = i + (rt.ctz(k) >> bsh())
      out.push(raw.str_cut(s, start, if end > start && b[end - 1] == 13 { end - 1 } else { end }))
      start = end + 1
      k = k & subw(k, 1)
    }
  }
  if start < n {
    out.push(raw.str_cut(s, start, if b[n - 1] == 13 { n - 1 } else { n }))
  }
  out
}

/// The 8 lowercase hex digits of the 4 bytes in the low bytes of v (the
/// first lowest), two to a byte's 16 bit lane, all lanes at once.
fn hex4(v: Int) -> Int {
  // each byte to the low byte of a 16 bit lane, in two steps
  let u = v & 0xFFFFFFFF
  let p = (u | shl(u, 16)) & 0xFFFF0000FFFF
  let s = (p | shl(p, 8)) & 0xFF00FF00FF00FF
  let nib = (shr(s, 4) & 0xF000F000F000F) | shl(s & 0xF000F000F000F, 8)
  // 'a' - '0' - 10 more for a nibble above 9 (bit 3 and bit 2 or 1);
  // | is + of "0" below 0x10
  let alpha = shr(nib, 3) & (shr(nib, 2) | shr(nib, 1)) & ONES
  addw(nib | 0x3030303030303030, mulw(alpha, 39))
}

/// The 16 lowercase hex digits of the 8 bytes of x (the first lowest),
/// in two words.
fn hex8(x: Int) -> (Int, Int) { (hex4(x), hex4(shr(x, 32))) }

/// The lowercase hex of b (Bytes.to_hex, hex.EncodeToString): 8 bytes a
/// step, their 16 digits stored as two words into a new string with
/// room (rt.rs_put_word); the last 1 to 7 bytes read as the word ending
/// at the end.
pub fn to_hex(b: Bytes) -> Str {
  let n = b.len()
  if n == 0 {
    return ""
  }
  var out = rt.rs_with_cap(addw(raw.len_ok(shl(n, 1)), 16))
  var i = 0
  let last = n - 8
  while i <= last {
    let (h0, h1) = hex8(rt.bytes_word(b, i))
    out = rt.rs_put_word(out, shl(i, 1), h0)
    out = rt.rs_put_word(out, addw(shl(i, 1), 8), h1)
    i = addw(i, 8)
  }
  if i < n {
    var x = 0
    if n >= 8 {
      x = shr(rt.bytes_word(b, last), shl(i - last, 3))
    } else {
      var j = n - 1
      while j >= i {
        x = shl(x, 8) | Int(b[j])
        j -= 1
      }
    }
    let (h0, h1) = hex8(x)
    out = rt.rs_put_word(out, shl(i, 1), h0)
    out = rt.rs_put_word(out, addw(shl(i, 1), 8), h1)
  }
  rt.rs_set_len(out, shl(n, 1))
}
