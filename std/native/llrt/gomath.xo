pub fn erfinv(x0: Float) -> Float {
  if is_nan(x0) || x0 <= -1.0 || x0 >= 1.0 {
    if x0 == -1.0 || x0 == 1.0 {
      return inf(Int(x0))
    }
    return nan()
  }
  var x = x0
  var sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  var ans = 0.0
  if x <= 0.85 {
    let r = 0.180625 - 0.25 * x * x
    let z1 = ((((((EA7 * r + EA6) * r + EA5) * r + EA4) * r + EA3) * r + EA2) * r + EA1) * r + EA0
    let z2 = ((((((EB7 * r + EB6) * r + EB5) * r + EB4) * r + EB3) * r + EB2) * r + EB1) * r + EB0
    ans = (x * z1) / z2
  } else {
    var z1 = 0.0
    var z2 = 0.0
    var r = (LN2 - log(1.0 - x)).sqrt()
    if r <= 5.0 {
      r = r - 1.6
      z1 = ((((((EC7 * r + EC6) * r + EC5) * r + EC4) * r + EC3) * r + EC2) * r + EC1) * r + EC0
      z2 = ((((((ED7 * r + ED6) * r + ED5) * r + ED4) * r + ED3) * r + ED2) * r + ED1) * r + ED0
    } else {
      r = r - 5.0
      z1 = ((((((EE7 * r + EE6) * r + EE5) * r + EE4) * r + EE3) * r + EE2) * r + EE1) * r + EE0
      z2 = ((((((EF7 * r + EF6) * r + EF5) * r + EF4) * r + EF3) * r + EF2) * r + EF1) * r + EF0
    }
    ans = z1 / z2
  }
  if sign { -ans } else { ans }
}

pub fn erfcinv(x: Float) -> Float { erfinv(1.0 - x) }

