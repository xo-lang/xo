const TWO52: Float = 4503599627370496.0
const TWO53: Float = 9007199254740992.0

fn sin_pi(x0: Float) -> Float {
  var x = x0
  if x < 0.25 {
    return -sin(PI * x)
  }
  var z = x.floor()
  var n = 0
  if z != x {
    x = mod(x, 2.0)
    n = Int(x * 4.0)
  } else {
    if x >= TWO53 {
      x = 0.0
      n = 0
    } else {
      if x < TWO52 {
        z = x + TWO52
      }
      n = 1 & bits(z)
      x = Float(n)
      n = n * 4
    }
  }
  if n == 0 {
    x = sin(PI * x)
  } else if n == 1 || n == 2 {
    x = cos(PI * (0.5 - x))
  } else if n == 3 || n == 4 {
    x = sin(PI * (1.0 - x))
  } else if n == 5 || n == 6 {
    x = -cos(PI * (x - 1.5))
  } else {
    x = sin(PI * (x - 2.0))
  }
  -x
}

pub fn lgamma(x0: Float) -> (Float, Int) {
  let tiny = 8.470329472543003e-22
  let tc = 1.4616321449683622
  let tf = -1.21486290535849611461e-01
  let tt = -3.63867699703950536541e-18
  let two58 = 288230376151711744.0
  var sign = 1
  if is_nan(x0) || is_inf(x0, 0) {
    return (x0, sign)
  }
  if x0 == 0.0 {
    return (inf(1), sign)
  }
  var x = x0
  var neg = false
  if x < 0.0 {
    x = -x
    neg = true
  }
  if x < tiny {
    if neg {
      sign = -1
    }
    return (-log(x), sign)
  }
  var nadj = 0.0
  if neg {
    if x >= TWO52 {
      return (inf(1), sign)
    }
    let t = sin_pi(x)
    if t == 0.0 {
      return (inf(1), sign)
    }
    nadj = log(PI / abs(t * x))
    if t < 0.0 {
      sign = -1
    }
  }
  var lg = 0.0
  if x == 1.0 || x == 2.0 {
    return (0.0, sign)
  } else if x < 2.0 {
    var y = 0.0
    var i = 0
    if x <= 0.9 {
      lg = -log(x)
      if x >= 0.7316321449683623 {
        y = 1.0 - x
        i = 0
      } else if x >= 0.19163214496836226 {
        y = x - 0.46163214496836225
        i = 1
      } else {
        y = x
        i = 2
      }
    } else {
      lg = 0.0
      if x >= 1.7316321449683623 {
        y = 2.0 - x
        i = 0
      } else if x >= 1.1916321449683622 {
        y = x - tc
        i = 1
      } else {
        y = x - 1.0
        i = 2
      }
    }
    if i == 0 {
      let z = y * y
      let p1 = LGAM_A[0] + z * (LGAM_A[2] + z * (LGAM_A[4] + z * (LGAM_A[6] + z * (LGAM_A[8] + z * LGAM_A[10]))))
      let p2 = z * (LGAM_A[1] + z * (LGAM_A[3] + z * (LGAM_A[5] + z * (LGAM_A[7] + z * (LGAM_A[9] + z * LGAM_A[11])))))
      let p = y * p1 + p2
      lg = lg + (p - 0.5 * y)
    } else if i == 1 {
      let z = y * y
      let w = z * y
      let p1 = LGAM_T[0] + w * (LGAM_T[3] + w * (LGAM_T[6] + w * (LGAM_T[9] + w * LGAM_T[12])))
      let p2 = LGAM_T[1] + w * (LGAM_T[4] + w * (LGAM_T[7] + w * (LGAM_T[10] + w * LGAM_T[13])))
      let p3 = LGAM_T[2] + w * (LGAM_T[5] + w * (LGAM_T[8] + w * (LGAM_T[11] + w * LGAM_T[14])))
      let p = z * p1 - (tt - w * (p2 + y * p3))
      lg = lg + (tf + p)
    } else {
      let p1 = y * (LGAM_U[0] + y * (LGAM_U[1] + y * (LGAM_U[2] + y * (LGAM_U[3] + y * (LGAM_U[4] + y * LGAM_U[5])))))
      let p2 = 1.0 + y * (LGAM_V[1] + y * (LGAM_V[2] + y * (LGAM_V[3] + y * (LGAM_V[4] + y * LGAM_V[5]))))
      lg = lg + (-0.5 * y + p1 / p2)
    }
  } else if x < 8.0 {
    let i = Int(x)
    let y = x - Float(i)
    let p = y * (LGAM_S[0] + y * (LGAM_S[1] + y * (LGAM_S[2] + y * (LGAM_S[3] + y * (LGAM_S[4] + y * (LGAM_S[5] + y * LGAM_S[6]))))))
    let q = 1.0 + y * (LGAM_R[1] + y * (LGAM_R[2] + y * (LGAM_R[3] + y * (LGAM_R[4] + y * (LGAM_R[5] + y * LGAM_R[6])))))
    lg = 0.5 * y + p / q
    var z = 1.0
    if i >= 7 {
      z = z * (y + 6.0)
    }
    if i >= 6 {
      z = z * (y + 5.0)
    }
    if i >= 5 {
      z = z * (y + 4.0)
    }
    if i >= 4 {
      z = z * (y + 3.0)
    }
    if i >= 3 {
      z = z * (y + 2.0)
      lg = lg + log(z)
    }
  } else if x < two58 {
    let t = log(x)
    let z = 1.0 / x
    let y = z * z
    let w = LGAM_W[0] + z * (LGAM_W[1] + y * (LGAM_W[2] + y * (LGAM_W[3] + y * (LGAM_W[4] + y * (LGAM_W[5] + y * LGAM_W[6])))))
    lg = (x - 0.5) * (t - 1.0) + w
  } else {
    lg = x * (log(x) - 1.0)
  }
  if neg {
    lg = nadj - lg
  }
  (lg, sign)
}
