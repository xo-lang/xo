// 1/0.35, folded exactly by Go
const ERF_BREAK: Float = 2.857142857142857

// The shared tail of erf and erfc for 1.25 <= x: exp(-x*x-0.5625) times
// the rational correction, split as Go's (z is x with its low 32 bits 0).
fn erf_tail(x: Float) -> Float {
  let s = 1.0 / (x * x)
  var r = 0.0
  var q = 0.0
  if x < ERF_BREAK {
    r = RA0 + s * (RA1 + s * (RA2 + s * (RA3 + s * (RA4 + s * (RA5 + s * (RA6 + s * RA7))))))
    q = 1.0 + s * (SA1 + s * (SA2 + s * (SA3 + s * (SA4 + s * (SA5 + s * (SA6 + s * (SA7 + s * SA8)))))))
  } else {
    r = RB0 + s * (RB1 + s * (RB2 + s * (RB3 + s * (RB4 + s * (RB5 + s * RB6)))))
    q = 1.0 + s * (SB1 + s * (SB2 + s * (SB3 + s * (SB4 + s * (SB5 + s * (SB6 + s * SB7))))))
  }
  let z = from_bits(bits(x) & ~0xFFFFFFFF)
  exp(-z * z - 0.5625) * exp((z - x) * (z + x) + r / q)
}

pub fn erf(x0: Float) -> Float {
  let very_tiny = 2.848094538889218e-306
  let small = 3.725290298461914e-09
  if is_nan(x0) {
    return nan()
  }
  if is_inf(x0, 1) {
    return 1.0
  }
  if is_inf(x0, -1) {
    return -1.0
  }
  var x = x0
  var sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  if x < 0.84375 {
    var temp = 0.0
    if x < small {
      if x < very_tiny {
        temp = 0.125 * (8.0 * x + EFX8 * x)
      } else {
        temp = x + EFX * x
      }
    } else {
      let z = x * x
      let r = PP0 + z * (PP1 + z * (PP2 + z * (PP3 + z * PP4)))
      let s = 1.0 + z * (QQ1 + z * (QQ2 + z * (QQ3 + z * (QQ4 + z * QQ5))))
      let y = r / s
      temp = x + x * y
    }
    return if sign { -temp } else { temp }
  }
  if x < 1.25 {
    let s = x - 1.0
    let p = PA0 + s * (PA1 + s * (PA2 + s * (PA3 + s * (PA4 + s * (PA5 + s * PA6)))))
    let q = 1.0 + s * (QA1 + s * (QA2 + s * (QA3 + s * (QA4 + s * (QA5 + s * QA6)))))
    return if sign { -ERX - p / q } else { ERX + p / q }
  }
  if x >= 6.0 {
    return if sign { -1.0 } else { 1.0 }
  }
  let r = erf_tail(x)
  if sign { r / x - 1.0 } else { 1.0 - r / x }
}

pub fn erfc(x0: Float) -> Float {
  let tiny = 1.3877787807814457e-17
  if is_nan(x0) {
    return nan()
  }
  if is_inf(x0, 1) {
    return 0.0
  }
  if is_inf(x0, -1) {
    return 2.0
  }
  var x = x0
  var sign = false
  if x < 0.0 {
    x = -x
    sign = true
  }
  if x < 0.84375 {
    var temp = 0.0
    if x < tiny {
      temp = x
    } else {
      let z = x * x
      let r = PP0 + z * (PP1 + z * (PP2 + z * (PP3 + z * PP4)))
      let s = 1.0 + z * (QQ1 + z * (QQ2 + z * (QQ3 + z * (QQ4 + z * QQ5))))
      let y = r / s
      if x < 0.25 {
        temp = x + x * y
      } else {
        temp = 0.5 + (x * y + (x - 0.5))
      }
    }
    return if sign { 1.0 + temp } else { 1.0 - temp }
  }
  if x < 1.25 {
    let s = x - 1.0
    let p = PA0 + s * (PA1 + s * (PA2 + s * (PA3 + s * (PA4 + s * (PA5 + s * PA6)))))
    let q = 1.0 + s * (QA1 + s * (QA2 + s * (QA3 + s * (QA4 + s * (QA5 + s * QA6)))))
    return if sign { 1.0 + ERX + p / q } else { 1.0 - ERX - p / q }
  }
  if x < 28.0 {
    if sign && x >= ERF_BREAK && x > 6.0 {
      return 2.0
    }
    let r = erf_tail(x)
    return if sign { 2.0 - r / x } else { r / x }
  }
  if sign { 2.0 } else { 0.0 }
}

