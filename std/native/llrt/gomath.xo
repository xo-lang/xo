fn stirling(x: Float) -> (Float, Float) {
  if x > 200.0 {
    return (inf(1), 1.0)
  }
  let sqrt_two_pi = 2.5066282746310007
  let max_stirling = 143.01608
  var w = 1.0 / x
  w = 1.0 + w * ((((GAM_S0 * w + GAM_S1) * w + GAM_S2) * w + GAM_S3) * w + GAM_S4)
  var y1 = exp(x)
  var y2 = 1.0
  if x > max_stirling {
    let v = pow(x, 0.5 * x - 0.25)
    y2 = v / y1
    y1 = v
  } else {
    y1 = pow(x, x - 0.5) / y1
  }
  (y1, sqrt_two_pi * w * y2)
}

fn is_neg_int(x: Float) -> Bool {
  if x < 0.0 {
    let (_, xf) = modf(x)
    return xf == 0.0
  }
  false
}

pub fn gamma(x0: Float) -> Float {
  let euler = 0.5772156649015329
  if is_neg_int(x0) || is_inf(x0, -1) || is_nan(x0) {
    return nan()
  }
  if is_inf(x0, 1) {
    return inf(1)
  }
  if x0 == 0.0 {
    return if signbit(x0) { inf(-1) } else { inf(1) }
  }
  var x = x0
  var q = abs(x)
  var p = q.floor()
  if q > 33.0 {
    if x >= 0.0 {
      let (y1, y2) = stirling(x)
      return y1 * y2
    }
    var signgam = 1
    if (Int(p) & 1) == 0 {
      signgam = -1
    }
    var z = q - p
    if z > 0.5 {
      p = p + 1.0
      z = q - p
    }
    z = q * sin(PI * z)
    if z == 0.0 {
      return inf(signgam)
    }
    let (sq1, sq2) = stirling(q)
    let absz = abs(z)
    let d = absz * sq1 * sq2
    if is_inf(d, 0) {
      z = PI / absz / sq1 / sq2
    } else {
      z = PI / d
    }
    return Float(signgam) * z
  }
  var z = 1.0
  while x >= 3.0 {
    x = x - 1.0
    z = z * x
  }
  var small = false
  while x < 0.0 {
    if x > -1e-09 {
      small = true
      break
    }
    z = z / x
    x = x + 1.0
  }
  if !small {
    while x < 2.0 {
      if x < 1e-09 {
        small = true
        break
      }
      z = z / x
      x = x + 1.0
    }
  }
  if small {
    if x == 0.0 {
      return inf(1)
    }
    return z / ((1.0 + euler * x) * x)
  }
  if x == 2.0 {
    return z
  }
  x = x - 2.0
  p = (((((x * GAM_P0 + GAM_P1) * x + GAM_P2) * x + GAM_P3) * x + GAM_P4) * x + GAM_P5) * x + GAM_P6
  q = ((((((x * GAM_Q0 + GAM_Q1) * x + GAM_Q2) * x + GAM_Q3) * x + GAM_Q4) * x + GAM_Q5) * x + GAM_Q6) * x + GAM_Q7
  z * p / q
}

