// The C ABI exports of the network (decisions 0204, 0206 stage 3, 0207):
// like cabi.xo, every top level function here is called by the C
// runtime as xo_x_<name>. A program carries them when it dials or
// listens (the SSA builders' uses_net) or uses std/http
// (std/native/http.xo imports this module). The network's operations
// are netconn.xo's (std/llrt/xo_rt.c forwards xo_net_listen and the rest
// here); net_read and net_send were the C's reads and writes (xo_http.c,
// the TLS library's), which no C makes now. The C declares these weak (weak
// definitions on macOS and Windows), so a program without them links.
// Nothing here may fault.
use native/llrt/dns
use native/llrt/netconn
use native/llrt/raw
use native/llrt/sock
use native/rt

// ---------------------------------------------------------------------------
// The network's operations (netconn.xo): a handle's address, 0 for none
// (the C forwarder's zero handle or empty list), the error in the
// context.

fn nc_listen(lp: Int, ln: Int, p: Int, n: Int) -> Int { netconn.listen(raw.str_at(lp, ln), raw.str_at(p, n)) }

fn nc_dial(lp: Int, ln: Int, p: Int, n: Int) -> Int { netconn.dial(raw.str_at(lp, ln), raw.str_at(p, n)) }

fn nc_dial_timeout(p: Int, n: Int, d: Int) -> Int { netconn.dial_timeout(raw.str_at(p, n), d) }

fn nc_listener_addr(l: Int, np: Int) -> Int { netconn.listener_addr(l, np) }

fn nc_listener_accept(l: Int) -> Int { netconn.listener_accept(l) }

fn nc_listener_close(l: Int) { netconn.listener_close(l) }

fn nc_listener_free(l: Int) { netconn.listener_free(l) }

fn nc_conn_read(cn: Int, max: Int, np: Int) -> Int { netconn.conn_read(cn, max, np) }

fn nc_conn_write(cn: Int, p: Int, n: Int) { netconn.conn_write(cn, p, n) }

fn nc_conn_close(cn: Int) { netconn.conn_close(cn) }

fn nc_conn_free(cn: Int) { netconn.conn_free(cn) }

// ---------------------------------------------------------------------------
// System calls: the kernel's result, a negative errno on failure.

/// getpeername into the buffer at sa of the size in the 32 bit word at
/// lenp.
fn net_peername(fd: Int, sa: Int, lenp: Int) -> Int { sock.peername(fd, sa, lenp) }

/// read(2) of at most n bytes into p.
fn net_read(fd: Int, p: Int, n: Int) -> Int { sock.read(fd, p, n) }

/// send(2) of n bytes at p with MSG_NOSIGNAL (a peer gone is EPIPE, not
/// SIGPIPE).
fn net_send(fd: Int, p: Int, n: Int) -> Int { sock.send(fd, p, n, 16384) }

/// inet_ntop of the address at src (4 bytes for family AF_INET, 16 for
/// AF_INET6), written zero terminated into the buffer of bn bytes at buf
/// (cut to fit); its length, -1 for another family.
fn net_ntop(family: Int, src: Int, buf: Int, bn: Int) -> Int {
  let n = if family == sock.AF_INET { 4 } else if family == sock.af_inet6() { 16 } else { 0 }
  if n == 0 || bn < 1 {
    return -1
  }
  let s = dns.ntop(raw.str_at(src, n).bytes())
  let k = if s.len() < bn { s.len() } else { bn - 1 }
  rt.mem_copy(buf, raw.data(s), k)
  rt.mem_store(buf, k, 0, 1)
  k
}
