// The C ABI exports of the network (decisions 0204, 0206 stage 3, 0207):
// like cabi.xo, every top level function here is called by the C
// runtime as xo_x_<name>. A program carries them when it dials or
// listens (the SSA builders' uses_net) or uses std/http
// (std/native/http.xo imports this module). The network's operations
// are netconn.xo's, which generated code calls here directly
// (selfhost/ssa/exports.xo; std/llrt/xo_rt.c forwards xo_net_listen and
// the rest here for code of compilers up to 0.12.0). The C declares these weak (weak
// definitions on macOS and Windows), so a program without them links.
// Nothing here may fault.
use native/llrt/netconn
use native/llrt/raw

// ---------------------------------------------------------------------------
// The network's operations (netconn.xo): a handle's address, 0 for none
// (the C forwarder's zero handle or empty list), the error in the
// context.

fn nc_listen(lp: Int, ln: Int, p: Int, n: Int) -> Int { netconn.listen(raw.str_at(lp, ln), raw.str_at(p, n)) }

fn nc_dial(lp: Int, ln: Int, p: Int, n: Int) -> Int { netconn.dial(raw.str_at(lp, ln), raw.str_at(p, n)) }

fn nc_listener_addr(l: Int, np: Int) -> Int { netconn.listener_addr(l, np) }

fn nc_listener_accept(l: Int) -> Int { netconn.listener_accept(l) }

fn nc_listener_close(l: Int) { netconn.listener_close(l) }

fn nc_listener_free(l: Int) { netconn.listener_free(l) }

fn nc_conn_read(cn: Int, max: Int, np: Int) -> Int { netconn.conn_read(cn, max, np) }

fn nc_conn_write(cn: Int, p: Int, n: Int) { netconn.conn_write(cn, p, n) }

fn nc_conn_close(cn: Int) { netconn.conn_close(cn) }

fn nc_conn_free(cn: Int) { netconn.conn_free(cn) }

// The same for generated code, which calls them directly (selfhost/ssa
// exports.xo; the emitters turn a handle's 0 into the zero handle and a
// list's 0 into the empty list): a List[Str] of one, no length slot.

fn nc_listener_addr_list(l: Int) -> Int { netconn.listener_addr(l, 0) }

fn nc_conn_read_list(cn: Int, max: Int) -> Int { netconn.conn_read(cn, max, 0) }

fn nc_status() -> Int { netconn.status() }

fn nc_msg() -> Int { netconn.msg_list() }
