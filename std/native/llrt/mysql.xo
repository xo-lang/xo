// std/sql's MySQL driver (decision 0648): a sql.Driver over the packets of
// mysqlwire.xo and the scrambles of mysqlauth.xo, dialing through the Net
// it is given. Written from MySQL's protocol documentation (route (a),
// decision 0648 item 11): the connection phase
// (page_protocol_connection_phase), COM_QUERY and its text resultsets
// (page_protocol_com_query_response), COM_PING, COM_QUIT, and the server
// error list of the reference manual. The DSN keeps the format Go's
// go-sql-driver/mysql documents in its README, an interface the driver
// reads, not code it copies. TLS through std/tls's client after an
// SSLRequest.
//
// Stage A: TCP and Unix sockets, TLS, mysql_native_password,
// caching_sha2_password (fast path, and full authentication over a secure
// link), mysql_clear_password and sha256_password over a secure link, the
// text protocol, arguments interpolated into the text, values, errors,
// transactions, copy_from as batched INSERTs. Stage B: server side
// prepared statements and binary rows (COM_STMT_PREPARE, EXECUTE, CLOSE),
// loc zones, RSA full authentication (caching_sha2_password and
// sha256_password over plain TCP: open's server_pub_key, or the server's
// key with allowPublicKeyRetrieval=true).
use std/sql
use std/time
use std/tls
use native/llrt/mysqlwire as w
use native/llrt/num
use native/llrt/mysqlauth as auth
use native/llrt/rsa
use native/llrt/netconn
use native/llrt/netwasi
use native/rt

fn param_err(msg: Str) -> sql.SqlErr { sql.SqlErr.Param(msg: msg) }
fn conn_err(msg: Str) -> sql.SqlErr { sql.SqlErr.Conn(msg: msg) }

// ---------------------------------------------------------------------------
// Configuration (the DSN)

/// A connection's settings, from the DSN.
pub struct Config {
  pub user: Str
  pub password: Str
  /// "tcp" or "unix".
  pub net: Str
  pub addr: Str
  pub database: Str
  /// "true" (verified), "custom" (verified against open's roots),
  /// "skip-verify", "preferred" or "false".
  pub tls: Str
  pub parse_time: Bool
  /// loc's name and zone: DATE, DATETIME and TIMESTAMP are wall times
  /// there (go-sql-driver's Loc, default UTC).
  pub loc: Str
  pub zone: time.Zone
  /// The collation's number (utf8mb4_general_ci, 45, by default).
  pub collation: Int
  pub allow_native: Bool
  pub allow_cleartext: Bool
  pub allow_public_key: Bool
  /// serverPubKey's name ("" for none): the key is open's server_pub_key.
  pub server_pub_key: Str
  pub multi_statements: Bool
  pub interpolate: Bool
  pub client_found_rows: Bool
  pub columns_with_alias: Bool
  pub reject_read_only: Bool
  pub max_allowed_packet: Int
  /// timeout: the dial's limit (zero: Net.dial's own).
  pub dial_timeout: Duration
  /// readTimeout and writeTimeout: each packet read's and write's limit,
  /// as go-sql-driver's I/O deadlines (zero: none).
  pub read_timeout: Duration
  pub write_timeout: Duration
  pub attrs: List[(Str, Str)]
  /// Other parameters: system variables set after connecting.
  pub vars: List[(Str, Str)]
}

/// The collations a DSN may name (information_schema.COLLATIONS: the
/// common utf8mb4, utf8mb3, latin1, ascii and binary ones).
fn collation_id(name: Str) -> Int? {
  match name {
    "utf8mb4_general_ci" => Some(45)
    "utf8mb4_bin" => Some(46)
    "utf8mb4_unicode_ci" => Some(224)
    "utf8mb4_0900_ai_ci" => Some(255)
    "utf8mb4_0900_as_cs" => Some(278)
    "utf8mb4_0900_bin" => Some(309)
    "utf8_general_ci" | "utf8mb3_general_ci" => Some(33)
    "utf8_bin" | "utf8mb3_bin" => Some(83)
    "utf8_unicode_ci" | "utf8mb3_unicode_ci" => Some(192)
    "latin1_swedish_ci" => Some(8)
    "latin1_bin" => Some(47)
    "ascii_general_ci" => Some(11)
    "binary" => Some(63)
    _ => None
  }
}

/// A character set's default collation.
fn charset_collation(cs: Str) -> Int? {
  match cs {
    "utf8mb4" => Some(45)
    "utf8" | "utf8mb3" => Some(33)
    "latin1" => Some(8)
    "ascii" => Some(11)
    "binary" => Some(63)
    _ => None
  }
}

/// %XX escapes decoded (a DSN's parameter values); None for a bad one.
fn unescape(s: Str) -> Str? {
  let b = s.bytes()
  var w = BytesBuilder.with_capacity(b.len())
  var i = 0
  while i < b.len() {
    if b[i] == 37 {
      if i + 2 >= b.len() {
        return None
      }
      let v = Int.parse_base(b[i + 1..i + 3].to_str() ?? "", 16)?
      w.write_byte(UInt8(v))
      i += 3
    } else {
      w.write_byte(b[i])
      i += 1
    }
  }
  w.freeze().to_str()
}

fn bool_param(k: Str, v: Str) -> Bool ! sql.SqlErr {
  match v {
    "true" | "1" | "TRUE" | "True" => Ok(true)
    "false" | "0" | "FALSE" | "False" => Ok(false)
    _ => Err(param_err("${k}: invalid bool ${v.quote()}"))
  }
}

/// A duration parameter in Go's syntax ("30s", "1m30s", "500ms").
fn dur_param(k: Str, v: Str) -> Duration ! sql.SqlErr {
  Duration.parse(v).map_err(fn(_) { param_err("${k}: invalid duration ${v.quote()}") })
}

/// Parses `[user[:password]@][net[(addr)]]/dbname[?param1=value1&...]`.
pub fn config(dsn: Str) -> Config ! sql.SqlErr {
  var cfg = Config{user: "", password: "", net: "tcp", addr: "", database: "", tls: "true", parse_time: false, loc: "UTC", zone: time.utc(), collation: 45, allow_native: true, allow_cleartext: false, allow_public_key: false, server_pub_key: "", multi_statements: false, interpolate: false, client_found_rows: false, columns_with_alias: false, reject_read_only: false, max_allowed_packet: 67108864, dial_timeout: Duration.from_nanos(0), read_timeout: Duration.from_nanos(0), write_timeout: Duration.from_nanos(0), attrs: [], vars: []}
  // the database starts after the last /; the parameters after the first ?
  // that follows it
  let slash = dsn.rfind("/") ?? return Err(param_err("invalid DSN: missing the slash separating the database name"))
  let head = dsn[0..slash]
  var tail = dsn[slash + 1..dsn.len()]
  var query = ""
  if let Some((db, q)) = tail.cut("?") {
    tail = db
    query = q
  }
  cfg.database = tail
  // user:password@ before the last @ of the head
  var where_ = head
  if let Some(at) = head.rfind("@") {
    let cred = head[0..at]
    where_ = head[at + 1..head.len()]
    match cred.cut(":") {
      Some((u, p)) => {
        cfg.user = u
        cfg.password = p
      }
      None => cfg.user = cred
    }
  }
  if !where_.is_empty() {
    match where_.cut("(") {
      Some((n, rest)) => {
        if !rest.ends_with(")") {
          return Err(param_err("invalid DSN: network address not terminated (missing closing brace)"))
        }
        cfg.net = n
        cfg.addr = rest[0..rest.len() - 1]
      }
      None => cfg.net = where_
    }
  }
  match cfg.net {
    "tcp" => {
      if cfg.addr.is_empty() {
        cfg.addr = "127.0.0.1:3306"
      } else if !has_port(cfg.addr) {
        cfg.addr = if cfg.addr.contains(":") && !cfg.addr.starts_with("[") { "[${cfg.addr}]:3306" } else { "${cfg.addr}:3306" }
      }
    }
    "unix" => {
      if cfg.addr.is_empty() {
        cfg.addr = "/tmp/mysql.sock"
      }
    }
    _ => return Err(param_err("unknown network ${cfg.net}"))
  }
  if !query.is_empty() {
    for kv in query.split("&") {
      if kv.is_empty() {
        continue
      }
      let (k, raw) = kv.cut("=") ?? (kv, "")
      let v = unescape(raw) ?? return Err(param_err("invalid DSN: ${k}: invalid escape in ${raw.quote()}"))
      match k {
        "tls" => {
          match v {
            "true" | "1" => cfg.tls = "true"
            "false" | "0" => cfg.tls = "false"
            "skip-verify" | "preferred" | "custom" => cfg.tls = v
            _ => return Err(param_err("tls: invalid value ${v.quote()}: true, false, skip-verify, preferred or custom (roots: on sql.open)"))
          }
        }
        "parseTime" => cfg.parse_time = bool_param(k, v)?
        "loc" => {
          if v == "Local" {
            return Err(param_err("loc=Local: there is no process time zone without env; name the zone"))
          }
          // the zone itself comes from the driver (connect): a name looked
          // up here, known only at run time, would embed the whole zone
          // database in every std/sql program
          cfg.loc = v
        }
        "charset" => {
          // the first of a comma separated list that is known
          var found = false
          for cs in v.split(",") {
            if let Some(id) = charset_collation(cs) {
              cfg.collation = id
              found = true
              break
            }
          }
          if !found {
            return Err(param_err("charset: unknown ${v.quote()}"))
          }
        }
        "collation" => cfg.collation = collation_id(v) ?? return Err(param_err("collation: unknown ${v.quote()}"))
        "allowNativePasswords" => cfg.allow_native = bool_param(k, v)?
        "allowCleartextPasswords" => cfg.allow_cleartext = bool_param(k, v)?
        "allowPublicKeyRetrieval" => cfg.allow_public_key = bool_param(k, v)?
        "allowOldPasswords" => {
          if bool_param(k, v)? {
            return Err(param_err("allowOldPasswords: the pre 4.1 password hash is broken and not supported"))
          }
        }
        "multiStatements" => cfg.multi_statements = bool_param(k, v)?
        "interpolateParams" => cfg.interpolate = bool_param(k, v)?
        "clientFoundRows" => cfg.client_found_rows = bool_param(k, v)?
        "columnsWithAlias" => cfg.columns_with_alias = bool_param(k, v)?
        "rejectReadOnly" => cfg.reject_read_only = bool_param(k, v)?
        "maxAllowedPacket" => cfg.max_allowed_packet = Int.parse(v) ?? return Err(param_err("maxAllowedPacket: invalid number ${v.quote()}"))
        "timeout" => cfg.dial_timeout = dur_param(k, v)?
        "readTimeout" => cfg.read_timeout = dur_param(k, v)?
        "writeTimeout" => cfg.write_timeout = dur_param(k, v)?
        "connectionAttributes" => {
          for a in v.split(",") {
            if let Some((ak, av)) = a.cut(":") {
              cfg.attrs.push((ak, av))
            } else if !a.is_empty() {
              return Err(param_err("connectionAttributes: ${a.quote()} is not key:value"))
            }
          }
        }
        "serverPubKey" => cfg.server_pub_key = v
        _ => cfg.vars.push((k, v))
      }
    }
  }
  if cfg.net == "unix" && (cfg.tls == "preferred") {
    cfg.tls = "false"
  }
  Ok(cfg)
}

fn has_port(addr: Str) -> Bool {
  if addr.starts_with("[") {
    return addr.contains("]:")
  }
  match addr.rfind(":") {
    Some(i) => !addr[0..i].contains(":")
    None => false
  }
}

// ---------------------------------------------------------------------------
// The driver

pub struct MysqlDriver {
  /// PEM roots for tls=custom (open's roots argument).
  pub roots: Bytes
  /// The zone of loc (UTC unless given): DATE, DATETIME and TIMESTAMP
  /// are wall times there. A DSN's loc must name it.
  pub zone: time.Zone = time.utc()
  /// The server's RSA public key, PEM (open's server_pub_key, Go's
  /// RegisterServerPubKey): the password's encryption for full
  /// authentication over a link that is not secure.
  pub pub_key: Bytes = b""
}

/// A connection to the server: plain, or upgraded to TLS after the
/// SSLRequest.
enum Link {
  Plain(c: Conn)
  Tls(t: tls.TlsConn)
}

fn (l: Link) read(max: Int) -> Bytes? ! NetErr uses net.dial {
  match l {
    Plain(c) => c.read(max)
    Tls(t) => t.read(max)
  }
}

fn (l: Link) write(data: Bytes) -> () ! NetErr uses net.dial {
  match l {
    Plain(c) => c.write(data)
    Tls(t) => t.write(data)
  }
}

fn (l: Link) close() {
  match l {
    Plain(c) => c.close()
    Tls(t) => t.close()
  }
}

pub struct MyConn {
  c: Link
  /// What a cancellation's KILL QUERY needs, and the raw connection under
  /// any TLS for the deadlines.
  x: ConnExtra
  /// Bytes read and not yet decoded.
  buf: Mutex[Bytes]
  /// The next packet's sequence id.
  seq: Atomic[Int]
  broken: Atomic[Bool]
  /// The capabilities both sides have.
  caps: Int
  cfg: Config
  /// The server's status flags of the last OK or EOF.
  status: Atomic[Int]
}

struct ConnExtra {
  raw: Conn
  net: Net
  drv: MysqlDriver
  /// The server's connection id (the handshake's), 0 until it is read.
  thread_id: Atomic[Int]
}

/// d ns from now as c's read (1), write (2) or both (3) deadline.
fn deadline(c: Conn, which: Int, d: Int) {
  if target.arch == TargetArch.Wasm32 {
    netwasi.set_deadline(c, which, true, d)
  } else {
    netconn.set_deadline(rt.obj_addr(c), which, true, d)
  }
}

/// The limit of KILL QUERY's dial, and of its whole exchange after it
/// (under the 5 s of shielded code, core XO-F005).
const KILL_DIAL_MS = 1000
const KILL_MS = 2000

/// After a cancelled wait for the server: KILL QUERY on a second
/// connection, so the server stops the statement too (decision 0648 item
/// 10), shielded from the cancellation and capped in time. Its failure
/// is ignored: p is broken and closed either way.
fn (p: MyConn) kill() uses net.dial {
  let id = p.x.thread_id.get()
  if id == 0 {
    return
  }
  {
    defer {
      var cfg = p.cfg
      cfg.read_timeout = Duration.from_nanos(0)
      cfg.write_timeout = Duration.from_nanos(0)
      let cap = Duration.from_millis(KILL_DIAL_MS)
      if cfg.dial_timeout.nanos() <= 0 || cfg.dial_timeout > cap {
        cfg.dial_timeout = cap
      }
      if let Ok(k) = open_conn(p.x.drv, p.x.net, cfg, Duration.from_millis(KILL_MS).nanos()) {
        let _ = run(k, "KILL QUERY ${id}").is_ok()
        k.close()
      }
    }
  }
}

fn net_err(e: NetErr) -> sql.SqlErr {
  match e {
    Canceled => sql.SqlErr.Canceled
    _ => conn_err("${e}")
  }
}

fn (d: MysqlDriver) connect(net: Net, dsn: Str) -> sql.DriverConn ! sql.SqlErr uses net.dial {
  var cfg = config(dsn)?
  if cfg.loc != d.zone.name() {
    return Err(param_err("loc=${cfg.loc}: the driver's zone is ${d.zone.name()}; a zone other than UTC is given as a value (time.zone(\"${cfg.loc}\") with a constant name), not looked up from the DSN, which would embed the whole zone database"))
  }
  cfg.zone = d.zone
  Ok(open_conn(d, net, cfg, 0)?)
}

/// A connection with cfg; within total ns from the dial's end when total
/// is positive.
fn open_conn(d: MysqlDriver, net: Net, cfg: Config, total: Int) -> MyConn ! sql.SqlErr uses net.dial {
  var key: rsa.PublicKey? = None
  if !d.pub_key.is_empty() {
    key = Some(auth.pem_public_key(d.pub_key).or_err(param_err("server_pub_key: not a PEM RSA public key (PUBLIC KEY or RSA PUBLIC KEY) of 1024 bits or more"))?)
  } else if !cfg.server_pub_key.is_empty() {
    return Err(param_err("serverPubKey=${cfg.server_pub_key} needs server_pub_key: (PEM) on sql.open"))
  }
  if cfg.tls == "custom" && d.roots.is_empty() {
    return Err(param_err("tls=custom needs roots: (PEM) on sql.open"))
  }
  let addr = if cfg.net == "unix" { "unix:${cfg.addr}" } else { cfg.addr }
  let dialed = if cfg.dial_timeout.nanos() > 0 { net.dial_timeout(addr, cfg.dial_timeout) } else { net.dial(addr) }
  let c = dialed.map_err(fn(e) {
    match e {
      Denied(_) => conn_err("dial ${addr}: denied by Net.only")
      _ => net_err(e)
    }
  })?
  if total > 0 {
    deadline(c, 3, total)
  }
  let x = ConnExtra{raw: c, net: net, drv: d, thread_id: Atomic.new(0)}
  let p = MyConn{c: Link.Plain(c: c), x: x, buf: Mutex.new(b""), seq: Atomic.new(0), broken: Atomic.new(false), caps: 0, cfg: cfg, status: Atomic.new(0)}
  match handshake(p, d.roots, c, key) {
    Ok(q) => Ok(q)
    Err(e) => {
      p.c.close()
      Err(e)
    }
  }
}

fn (p: MyConn) send(payload: Bytes) -> () ! sql.SqlErr uses net.dial {
  let (data, next) = w.frame(p.seq.get(), payload)
  p.seq.set(next)
  if p.cfg.write_timeout.nanos() > 0 {
    deadline(p.x.raw, 2, p.cfg.write_timeout.nanos())
  }
  match p.c.write(data) {
    Ok(_) => Ok(())
    Err(e) => {
      p.broken.set(true)
      Err(net_err(e))
    }
  }
}

/// The next packet's payload; a failure or a sequence id out of order
/// breaks the connection.
fn (p: MyConn) recv() -> Bytes ! sql.SqlErr uses net.dial {
  while true {
    // the check and the take in one with (core 5.4)
    let got = p.buf.with(fn(var b) -> (Bytes, Int, Int)? {
      match w.join(b) {
        Some((payload, first, seq, took)) => {
          b = b[took..b.len()]
          Some((payload, first, seq))
        }
        None => None
      }
    })
    match got {
      Some((payload, first, seq)) => {
        if first != p.seq.get() {
          p.broken.set(true)
          return Err(conn_err("packets out of order: sequence id ${first}, want ${p.seq.get()}"))
        }
        p.seq.set((seq + 1) % 256)
        return Ok(payload)
      }
      None => {}
    }
    if p.cfg.read_timeout.nanos() > 0 {
      deadline(p.x.raw, 1, p.cfg.read_timeout.nanos())
    }
    match p.c.read(w.read_size(p.buf.with(fn(b) { b }))) {
      Ok(Some(more)) => p.buf.with(fn(var b) { b = b + more })
      Ok(None) => {
        p.broken.set(true)
        return Err(conn_err("unexpected EOF"))
      }
      Err(e) => {
        p.broken.set(true)
        if e is Canceled {
          p.kill()
        }
        return Err(net_err(e))
      }
    }
  }
  Err(conn_err("unreachable"))
}

fn wire_err(p: MyConn, e: w.WireErr) -> sql.SqlErr {
  p.broken.set(true)
  conn_err(e.msg)
}

/// The capabilities the driver asks for, of those the server has.
fn client_caps(server: Int, cfg: Config) -> Int {
  var c = w.CLIENT_PROTOCOL_41 | w.CLIENT_SECURE_CONNECTION | w.CLIENT_PLUGIN_AUTH | w.CLIENT_PLUGIN_AUTH_LENENC_CLIENT_DATA | w.CLIENT_LONG_PASSWORD | w.CLIENT_LONG_FLAG | w.CLIENT_TRANSACTIONS | w.CLIENT_MULTI_RESULTS | w.CLIENT_PS_MULTI_RESULTS | w.CLIENT_DEPRECATE_EOF | w.CLIENT_CONNECT_ATTRS
  if !cfg.database.is_empty() {
    c = c | w.CLIENT_CONNECT_WITH_DB
  }
  if cfg.client_found_rows {
    c = c | w.CLIENT_FOUND_ROWS
  }
  if cfg.multi_statements {
    c = c | w.CLIENT_MULTI_STATEMENTS
  }
  c & server
}

/// What the TLS failure of a server with MySQL's generated certificate
/// says (decision 0648 item 4).
fn tls_hint(cfg: Config, e: NetErr) -> sql.SqlErr {
  match e {
    Canceled => sql.SqlErr.Canceled
    _ => conn_err("tls: ${e} (with tls=${cfg.tls}, the server's certificate must verify: MySQL's auto generated certificate is self signed, so pass its CA as roots: with tls=custom, or use tls=skip-verify)")
  }
}

fn handshake(p0: MyConn, roots: Bytes, raw: Conn, key: rsa.PublicKey?) -> MyConn ! sql.SqlErr uses net.dial {
  let cfg = p0.cfg
  let hs = w.parse_handshake(p0.recv()?).map_err(fn(e) { wire_err(p0, e) })?
  p0.x.thread_id.set(hs.thread_id)
  if hs.caps & w.CLIENT_PROTOCOL_41 == 0 {
    return Err(conn_err("the server ${hs.version} does not speak protocol 4.1"))
  }
  var caps = client_caps(hs.caps, cfg)
  var p = p0
  var secure = cfg.net == "unix"
  if cfg.net == "tcp" && cfg.tls != "false" {
    if hs.caps & w.CLIENT_SSL == 0 {
      if cfg.tls != "preferred" {
        return Err(conn_err("the server does not support TLS (tls=${cfg.tls}; tls=false to connect in plain text)"))
      }
    } else {
      caps = caps | w.CLIENT_SSL
      p0.send(w.ssl_request(caps, cfg.max_allowed_packet, cfg.collation))?
      let verify = match cfg.tls {
        "true" | "custom" => tls.Verify.Full
        _ => tls.Verify.None
      }
      var rs: tls.Roots? = None
      if !roots.is_empty() {
        rs = Some(tls.roots(roots).map_err(fn(e) { param_err("roots: ${e}") })?)
      }
      let host = host_of(cfg.addr)
      let t = tls.client(raw, host, roots: rs, verify: verify).map_err(fn(e) { tls_hint(cfg, e) })?
      p = MyConn{c: Link.Tls(t: t), x: p0.x, buf: p0.buf, seq: p0.seq, broken: p0.broken, caps: caps, cfg: cfg, status: p0.status}
      secure = true
    }
  }
  p = MyConn{c: p.c, x: p.x, buf: p.buf, seq: p.seq, broken: p.broken, caps: caps, cfg: cfg, status: p.status}
  var plugin = if hs.plugin.is_empty() { "mysql_native_password" } else { hs.plugin }
  var nonce = hs.nonce
  let pw = cfg.password.bytes()
  let first = plugin_response(cfg, plugin, pw, nonce, secure, key)?
  let attrs = [("_client_name", "xo"), ("_os", "xo")] + cfg.attrs
  p.send(w.handshake_response(caps, cfg.max_allowed_packet, cfg.collation, cfg.user, first, cfg.database, plugin, attrs))?
  // the auth phase: switches and more data until OK or ERR
  while true {
    match w.parse_auth(p.recv()?, caps).map_err(fn(e) { wire_err(p, e) })? {
      Ok(ok) => {
        p.status.set(ok.status)
        break
      }
      Err(e) => return Err(server_err(e))
      Switch(name, data) => {
        if name == "mysql_old_password" {
          return Err(conn_err("the server asks for mysql_old_password, the pre 4.1 hash, which is broken and not supported"))
        }
        plugin = name
        nonce = data
        p.send(plugin_response(cfg, plugin, pw, nonce, secure, key)?)?
      }
      More(data) => {
        if plugin == "caching_sha2_password" && data.len() == 1 && Int(data[0]) == auth.SHA2_FAST_AUTH_OK {
          continue
        }
        if plugin == "caching_sha2_password" && data.len() == 1 && Int(data[0]) == auth.SHA2_PERFORM_FULL_AUTH {
          if secure {
            p.send(auth.clear(pw))?
            continue
          }
          // RSA: open's key, else the server's when allowed
          let k = match key {
            Some(k) => k
            None => {
              if !cfg.allow_public_key {
                return Err(conn_err("caching_sha2_password: the server asks for full authentication, which sends the password: over plain TCP it needs TLS, server_pub_key: (PEM) on sql.open, or allowPublicKeyRetrieval=true (a key fetched from the server can be a man in the middle's)"))
              }
              p.send(b"\x02")?
              match w.parse_auth(p.recv()?, caps).map_err(fn(e) { wire_err(p, e) })? {
                More(pem) => auth.pem_public_key(pem).or_err(conn_err("caching_sha2_password: the server's public key is not a PEM RSA key"))?
                Err(e) => return Err(server_err(e))
                _ => return Err(conn_err("caching_sha2_password: no public key after the request for it"))
              }
            }
          }
          p.send(auth.rsa_password(pw, nonce, k).or_err(conn_err("caching_sha2_password: the password is too long for the server's RSA key"))?)?
          continue
        }
        if plugin == "sha256_password" && data.len() > 1 {
          // the server's key, sent after our request (the byte 1)
          let k = auth.pem_public_key(data).or_err(conn_err("sha256_password: the server's public key is not a PEM RSA key"))?
          p.send(auth.rsa_password(pw, nonce, k).or_err(conn_err("sha256_password: the password is too long for the server's RSA key"))?)?
          continue
        }
        return Err(conn_err("${plugin}: unexpected data from the server"))
      }
    }
  }
  if !cfg.vars.is_empty() {
    // the other parameters are system variables, set as one statement
    var sets: List[Str] = []
    for (k, v) in cfg.vars {
      sets.push("${k}=${v}")
    }
    let _ = run(p, "SET ${sets.join(",")}")?
  }
  Ok(p)
}

fn host_of(addr: Str) -> Str {
  if addr.starts_with("[") {
    return (addr.cut("]") ?? (addr, "")).0[1..]
  }
  (addr.cut(":") ?? (addr, "")).0
}

/// A plugin's response, with the DSN's permissions checked.
fn plugin_response(cfg: Config, plugin: Str, pw: Bytes, nonce: Bytes, secure: Bool, key: rsa.PublicKey?) -> Bytes ! sql.SqlErr {
  if plugin == "mysql_native_password" && !cfg.allow_native {
    return Err(conn_err("mysql_native_password is not allowed (allowNativePasswords=false)"))
  }
  if plugin == "mysql_clear_password" {
    if !cfg.allow_cleartext {
      return Err(conn_err("mysql_clear_password sends the password in clear: set allowCleartextPasswords=true"))
    }
    if !secure {
      return Err(conn_err("mysql_clear_password needs TLS or a Unix socket"))
    }
  }
  if plugin == "sha256_password" && !secure && !pw.is_empty() {
    // RSA: open's key now, else a request for the server's (the byte 1)
    match key {
      Some(k) => return auth.rsa_password(pw, nonce, k).or_err(conn_err("sha256_password: the password is too long for the server's RSA key"))
      None => {
        if !cfg.allow_public_key {
          return Err(conn_err("sha256_password over plain TCP needs TLS, server_pub_key: (PEM) on sql.open, or allowPublicKeyRetrieval=true (a key fetched from the server can be a man in the middle's)"))
        }
        return Ok(b"\x01")
      }
    }
  }
  auth.first_response(plugin, pw, nonce, secure).or_err(conn_err("unknown authentication plugin ${plugin}"))
}

// ---------------------------------------------------------------------------
// Errors (the server error reference's numbers, mapped to SqlErr)

fn server_err(e: w.ErrPacket) -> sql.SqlErr {
  let msg = "Error ${e.code} (${e.state}): ${e.msg}"
  match e.code {
    1062 | 1586 => sql.SqlErr.Constraint(msg: msg, code: e.state, name: dup_key(e.msg))
    1451 | 1452 | 1216 | 1217 => sql.SqlErr.Constraint(msg: msg, code: e.state, name: fk_name(e.msg))
    1048 | 1364 => sql.SqlErr.Constraint(msg: msg, code: e.state, name: "")
    3819 => sql.SqlErr.Constraint(msg: msg, code: e.state, name: quoted_after(e.msg, "Check constraint "))
    1064 | 1149 => sql.SqlErr.Syntax(msg: msg)
    1146 => sql.SqlErr.NoTable(name: quoted_after(e.msg, "Table "))
    1317 | 3024 => sql.SqlErr.Canceled
    _ => sql.SqlErr.Server(code: e.state, msg: msg)
  }
}

/// The key of "Duplicate entry 'x' for key 'name'".
fn dup_key(msg: Str) -> Str {
  match msg.rfind(" for key '") {
    Some(i) => {
      let rest = msg[i + 10..msg.len()]
      (rest.cut("'") ?? (rest, "")).0
    }
    None => ""
  }
}

/// The constraint of "... CONSTRAINT `name` FOREIGN KEY ...".
fn fk_name(msg: Str) -> Str {
  match msg.find("CONSTRAINT `") {
    Some(i) => {
      let rest = msg[i + 12..msg.len()]
      (rest.cut("`") ?? (rest, "")).0
    }
    None => ""
  }
}

/// The name quoted with ' after prefix ("Table 'db.t' doesn't exist").
fn quoted_after(msg: Str, prefix: Str) -> Str {
  match msg.find(prefix + "'") {
    Some(i) => {
      let rest = msg[i + prefix.len() + 1..msg.len()]
      (rest.cut("'") ?? (rest, "")).0
    }
    None => ""
  }
}

// ---------------------------------------------------------------------------
// Values

/// A text row's value by its column (decision 0648 item 8).
pub fn decode_text(c: w.Column, v: Bytes?, parse_time: Bool, z: time.Zone = time.utc()) -> sql.SqlValue {
  match text_value(c, v, parse_time, z) {
    Ok(x) => x
    Err(_) => sql.SqlValue.Text(s: (v ?? b"").to_str_lossy())
  }
}

/// Whether s is one or more ASCII digits.
fn all_digits(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  for b in s.bytes() {
    if b < 48 || b > 57 {
      return false
    }
  }
  true
}

/// Go's strconv error text of a failed parse.
fn strconv_err(f: Str, s: Str, range: Bool) -> Str {
  "strconv.${f}: parsing ${s.debug()}: ${if range { "value out of range" } else { "invalid syntax" }}"
}

/// Go's ParseUint(s, 10, 64): no sign, decimal digits, at most 2^64 - 1;
/// above Int.max the digits without leading zeros (decision 0648 item 8's
/// Text of a BIGINT UNSIGNED past Int).
fn uint_value(s: Str) -> sql.SqlValue ! Str {
  if !all_digits(s) {
    return Err(strconv_err("ParseUint", s, false))
  }
  if let Some(n) = Int.parse(s) {
    return Ok(sql.SqlValue.Integer(n: n))
  }
  let d = s.trim_start_chars("0")
  if d.len() > 20 || (d.len() == 20 && d > "18446744073709551615") {
    return Err(strconv_err("ParseUint", s, true))
  }
  Ok(sql.SqlValue.Text(s: d))
}

/// Whether Float.parse refused s for its range, not its syntax: s reads
/// with its exponent cut to one digit.
fn float_out_of_range(s: Str) -> Bool {
  let i = s.find_any("eE") ?? return false
  let e = s[i + 1..]
  let sign = if e.starts_with("-") || e.starts_with("+") { e[0..1] } else { "" }
  all_digits(e[sign.len()..]) && Float.parse("${s[0..i]}e${sign}1").is_some()
}

/// A text-protocol value as go-sql-driver's textRows.readRow converts it:
/// integers by ParseInt (ParseUint for BIGINT UNSIGNED), FLOAT by
/// ParseFloat(s, 32), DOUBLE by ParseFloat(s, 64); Err with Go's text
/// when that fails (the query's error). FLOAT narrows Float.parse's
/// double to Float32, which is ParseFloat(s, 32) but for decimal text
/// within half a double ulp of a midpoint of two float32s (a server
/// sends a FLOAT's shortest float32 text, never such a number).
pub fn text_value(c: w.Column, v: Bytes?, parse_time: Bool, z: time.Zone = time.utc()) -> sql.SqlValue ! Str {
  let b = v ?? return Ok(sql.SqlValue.Null)
  let s = b.to_str_lossy()
  if c.kind == 8 && c.flags & w.FLAG_UNSIGNED != 0 {
    return uint_value(s)
  }
  Ok(match c.kind {
    0 | 246 => sql.SqlValue.Text(s: s)
    1 | 2 | 3 | 8 | 9 | 13 => match Int.parse(s) {
      Some(n) => sql.SqlValue.Integer(n: n)
      None => return Err(strconv_err("ParseInt", s, all_digits(s.trim_prefix("-").trim_prefix("+")) && (s.len() > 1 || !s.starts_with("+") && !s.starts_with("-"))))
    }
    4 => match Float.parse(s) {
      Some(f) => {
        let x = Float32(f)
        if Float(x).is_inf() && !f.is_inf() {
          return Err(strconv_err("ParseFloat", s, true))
        }
        // the Float of the float32's shortest text, as decision 0648
        // item 8 reads go-sql-driver's float32
        sql.SqlValue.Real(f: num.parse_float(num.append_json_float32("", Float(x))) ?? Float(x))
      }
      None => return Err(strconv_err("ParseFloat", s, float_out_of_range(s)))
    }
    5 => match Float.parse(s) {
      Some(f) => sql.SqlValue.Real(f: f)
      None => return Err(strconv_err("ParseFloat", s, float_out_of_range(s)))
    }
    7 | 10 | 12 | 14 => if parse_time { datetime_value(s, z)? } else { sql.SqlValue.Text(s: s) }
    16 | 255 => sql.SqlValue.Blob(b: b)
    245 => sql.SqlValue.JsonText(s: s)
    15 | 247 | 248 | 249 | 250 | 251 | 252 | 253 | 254 => if c.charset == w.CHARSET_BINARY { sql.SqlValue.Blob(b: b) } else { sql.SqlValue.Text(s: s) }
    _ => sql.SqlValue.Text(s: s)
  })
}

/// The digit at b[i] (go-sql-driver's bToi).
fn digit_at(b: Bytes, i: Int) -> Int ! Str {
  let x = Int(b[i])
  if x < 48 || x > 57 {
    return Err("not [0-9]")
  }
  Ok(x - 48)
}

/// Err unless b[i] is the separator c (go-sql-driver's "bad value for
/// field").
fn sep_at(b: Bytes, i: Int, c: Int) -> () ! Str {
  if Int(b[i]) != c {
    return Err("bad value for field: `${b[i..i + 1].to_str_lossy()}`")
  }
  Ok(())
}

/// Days from 1970-01-01 to the civil date (proleptic Gregorian, any year;
/// m 1 to 12, d from 1).
fn days_from_civil(y: Int, m: Int, d: Int) -> Int {
  let y2 = if m <= 2 { y - 1 } else { y }
  let era = (if y2 >= 0 { y2 } else { y2 - 399 }) / 400
  let yoe = y2 - era * 400
  let mp = (m + 9) % 12
  let doy = (153 * mp + 2) / 5 + d - 1
  era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468
}

/// go-sql-driver's parseDateTime of a DATE, DATETIME or TIMESTAMP's text
/// (parseTime=true): 10, 19 or 21 to 26 bytes, digits and separators at
/// their places, the fields then normalized as Go's time.Date (2024-02-30
/// is 2024-03-01, hour 25 the next day), in the zone z. Err with Go's
/// text otherwise. The zero date ("0000-00-00 ..."), and a time outside
/// Time's 1677 to 2262, stay the server's Text, as Postgres's infinity
/// (Go's zero time is outside Time's range).
fn datetime_value(s: Str, z: time.Zone) -> sql.SqlValue ! Str {
  let b = s.bytes()
  let n = b.len()
  if !(n == 10 || n == 19 || (n >= 21 && n <= 26)) {
    return Err("invalid time bytes: ${s}")
  }
  if s == "0000-00-00 00:00:00.000000"[0..n] {
    return Ok(sql.SqlValue.Text(s: s))
  }
  let year = digit_at(b, 0)? * 1000 + digit_at(b, 1)? * 100 + digit_at(b, 2)? * 10 + digit_at(b, 3)?
  sep_at(b, 4, 45)?
  let month = digit_at(b, 5)? * 10 + digit_at(b, 6)?
  sep_at(b, 7, 45)?
  let day = digit_at(b, 8)? * 10 + digit_at(b, 9)?
  var hour = 0
  var minute = 0
  var sec = 0
  var ns = 0
  if n > 10 {
    sep_at(b, 10, 32)?
    hour = digit_at(b, 11)? * 10 + digit_at(b, 12)?
    sep_at(b, 13, 58)?
    minute = digit_at(b, 14)? * 10 + digit_at(b, 15)?
    sep_at(b, 16, 58)?
    sec = digit_at(b, 17)? * 10 + digit_at(b, 18)?
    if n > 19 {
      sep_at(b, 19, 46)?
      var place = 100000
      for i in 20..n {
        ns += digit_at(b, i)? * place
        place /= 10
      }
      ns *= 1000
    }
  }
  // time.Date's normalization: the month into the year, the rest added
  var y = year
  var m0 = month - 1
  if m0 < 0 {
    y -= 1
    m0 += 12
  }
  y += m0 / 12
  m0 = m0 % 12
  let secs = (days_from_civil(y, m0 + 1, 1) + day - 1) * 86400 + hour * 3600 + minute * 60 + sec
  if secs < -9223372036 || secs > 9223372036 || (secs == 9223372036 && ns > 854775807) {
    return Ok(sql.SqlValue.Text(s: s))
  }
  Ok(sql.SqlValue.At(t: wall_in(Time.from_unix_nanos(secs * 1000000000 + ns), z)))
}

/// The instant whose wall clock in z is naive's in UTC, by Go's
/// time.Date rule (what go-sql-driver's parseDateTime gives): the offset
/// at naive taken as an instant, and if the result leaves that offset's
/// period, the offset at the result. So a wall time in a daylight saving
/// gap moves by the gap, and one in an overlap takes one of its two
/// offsets, as in Go.
pub fn wall_in(naive: Time, z: time.Zone) -> Time {
  let o1 = z.offset_at(naive)
  let u = naive - o1
  let o2 = z.offset_at(u)
  if o2 == o1 { u } else { naive - o2 }
}

/// A Str as a quoted literal: backslash escapes, or with the server's
/// NO_BACKSLASH_ESCAPES mode only the quote doubled.
pub fn quote_bytes(b: Bytes, no_backslash: Bool) -> Str {
  var o = BytesBuilder.with_capacity(b.len() + 2)
  o.write_byte(39)
  for c in b {
    if no_backslash {
      if c == 39 {
        o.write_str("''")
      } else {
        o.write_byte(c)
      }
      continue
    }
    match Int(c) {
      0 => o.write_str("\\0")
      10 => o.write_str("\\n")
      13 => o.write_str("\\r")
      26 => o.write_str("\\Z")
      34 => o.write_str("\\\"")
      39 => o.write_str("\\'")
      92 => o.write_str("\\\\")
      _ => o.write_byte(c)
    }
  }
  o.write_byte(39)
  o.freeze().to_str_lossy()
}

/// A value as SQL text.
pub fn literal(v: sql.SqlValue, no_backslash: Bool, z: time.Zone = time.utc()) -> Str ! sql.SqlErr {
  match v {
    Null => Ok("NULL")
    Integer(n) => Ok("${n}")
    Text(s) => Ok(quote_bytes(s.bytes(), no_backslash))
    Real(f) => {
      if f.is_nan() || f.is_inf() {
        return Err(param_err("MySQL has no ${f}"))
      }
      Ok("${f}")
    }
    Flag(b) => Ok(if b { "1" } else { "0" })
    At(t) => Ok(quote_bytes(datetime_text(t, z).bytes(), no_backslash))
    // _binary keeps the bytes out of the connection's character set
    Blob(b) => Ok("_binary" + quote_bytes(b, no_backslash))
    JsonText(s) => Ok(quote_bytes(s.bytes(), no_backslash))
    Array(_) => Err(param_err("MySQL has no array type"))
  }
}

/// A time as DATETIME's text, its wall clock in z (go-sql-driver formats
/// t.In(Loc)), with its fraction to microseconds, trailing zeros dropped,
/// as go-sql-driver writes it (found by scripts/mysql-diff.sh).
pub fn datetime_text(t: Time, z: time.Zone = time.utc()) -> Str {
  let r = (t + z.offset_at(t)).format_rfc3339()
  // 2026-11-15T03:04:05[.fraction]Z
  let body = r.trim_suffix("Z").replace("T", " ")
  match body.cut(".") {
    Some((sec, frac)) => {
      let f = (frac + "000000")[0..6].trim_end_chars("0")
      if f.is_empty() { sec } else { "${sec}.${f}" }
    }
    None => body
  }
}

/// q with each ? outside quotes and comments replaced by an argument's
/// literal; Param when the counts differ.
pub fn interpolate(q: Str, args: List[sql.SqlValue], no_backslash: Bool, z: time.Zone = time.utc()) -> Str ! sql.SqlErr {
  let b = q.bytes()
  var o = BytesBuilder.with_capacity(b.len() + 16 * args.len())
  var n = 0
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c == 39 || c == 34 || c == 96 {
      // a quoted string or name to its closing quote
      let start = i
      i += 1
      while i < b.len() {
        if Int(b[i]) == 92 && c != 96 && !no_backslash {
          i += 2
          continue
        }
        if Int(b[i]) == c {
          if i + 1 < b.len() && Int(b[i + 1]) == c {
            i += 2
            continue
          }
          break
        }
        i += 1
      }
      i = (i + 1).min(b.len())
      o.write(b[start..i])
      continue
    }
    if c == 35 || (c == 45 && i + 2 < b.len() && Int(b[i + 1]) == 45 && (Int(b[i + 2]) == 32 || Int(b[i + 2]) == 9)) {
      // a comment to the end of the line
      let start = i
      while i < b.len() && Int(b[i]) != 10 {
        i += 1
      }
      o.write(b[start..i])
      continue
    }
    if c == 47 && i + 1 < b.len() && Int(b[i + 1]) == 42 {
      let start = i
      i = match b[i + 2..b.len()].find(b"*/") {
        Some(j) => i + 2 + j + 2
        None => b.len()
      }
      o.write(b[start..i])
      continue
    }
    if c == 63 {
      if n >= args.len() {
        return Err(param_err("the statement has more ? placeholders than the ${args.len()} arguments"))
      }
      o.write_str(literal(args[n], no_backslash, z)?)
      n += 1
      i += 1
      continue
    }
    o.write_byte(b[i])
    i += 1
  }
  if n != args.len() {
    return Err(param_err("${args.len()} arguments for ${n} ? placeholders"))
  }
  Ok(o.freeze().to_str_lossy())
}

// ---------------------------------------------------------------------------
// Queries

/// One result set, or the OK of a statement with none.
struct Result1 {
  cols: List[w.Column]
  rows: List[List[sql.SqlValue]]
  affected: Int
  insert_id: Int
}

/// Every result of one COM_QUERY, in order.
fn run(p: MyConn, q: Str) -> List[Result1] ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  p.seq.set(0)
  p.send(w.command(w.COM_QUERY, q.bytes()))?
  results(p, false)
}

/// Every result of the command just sent (COM_QUERY, or COM_STMT_EXECUTE
/// with binary rows), in order; the first error is the call's, after the
/// rest are read so the connection stays usable.
fn results(p: MyConn, binary: Bool) -> List[Result1] ! sql.SqlErr uses net.dial {
  var out: List[Result1] = []
  var failed: sql.SqlErr? = None
  while true {
    let first = p.recv()?
    if first.is_empty() {
      p.broken.set(true)
      return Err(conn_err("an empty packet where a result starts"))
    }
    var more = false
    match Int(first[0]) {
      0 => {
        let ok = w.ok_packet(first, p.caps).map_err(fn(e) { wire_err(p, e) })?
        p.status.set(ok.status)
        out.push(Result1{cols: [], rows: [], affected: ok.affected, insert_id: ok.insert_id})
        more = ok.status & w.SERVER_MORE_RESULTS_EXISTS != 0
      }
      255 => {
        let e = w.err_packet(first, true).map_err(fn(x) { wire_err(p, x) })?
        if p.cfg.reject_read_only && (e.code == 1290 || e.code == 1792) {
          p.broken.set(true)
        }
        // an error ends the statement list
        if failed.is_none() {
          failed = Some(server_err(e))
        }
      }
      251 => {
        // LOAD DATA LOCAL INFILE: the driver sends no file
        p.send(b"")?
        let _ = p.recv()?
        if failed.is_none() {
          failed = Some(sql.SqlErr.Driver(msg: "LOAD DATA LOCAL INFILE is refused: the driver reads no file"))
        }
      }
      _ => {
        let r = read_result_set(p, first, binary)?
        out.push(r.0)
        more = r.1
      }
    }
    if !more {
      break
    }
  }
  match failed {
    Some(e) => Err(e)
    None => Ok(out)
  }
}

/// A result set from its column count packet to its end: the set, and
/// whether more results follow.
fn read_result_set(p: MyConn, first: Bytes, binary: Bool) -> (Result1, Bool) ! sql.SqlErr uses net.dial {
  var r = w.reader(first)
  let n = r.lenenc().map_err(fn(e) { wire_err(p, e) })? ?? 0
  var cols: List[w.Column] = []
  for _ in 0..n {
    cols.push(w.parse_column(p.recv()?).map_err(fn(e) { wire_err(p, e) })?)
  }
  if p.caps & w.CLIENT_DEPRECATE_EOF == 0 {
    let eof = p.recv()?
    if !w.is_end(eof) {
      p.broken.set(true)
      return Err(conn_err("no EOF after the column definitions"))
    }
  }
  var rows: List[List[sql.SqlValue]] = []
  // the first value that did not convert (Go's strconv text): the
  // statement's error once its rows are read
  var bad = ""
  while true {
    let pk = p.recv()?
    if w.is_end(pk) {
      let st = w.end_status(pk, p.caps).map_err(fn(e) { wire_err(p, e) })?
      p.status.set(st)
      let more = st & w.SERVER_MORE_RESULTS_EXISTS != 0
      if !bad.is_empty() {
        if more {
          // the result sets after it are not read
          p.broken.set(true)
        }
        return Err(sql.SqlErr.Driver(msg: bad))
      }
      return Ok((Result1{cols: cols, rows: rows, affected: 0, insert_id: 0}, more))
    }
    if pk.len() > 0 && pk[0] == 255 {
      if !bad.is_empty() {
        return Err(sql.SqlErr.Driver(msg: bad))
      }
      // an error in the middle of the rows ends the statement
      let e = w.err_packet(pk, true).map_err(fn(x) { wire_err(p, x) })?
      return Err(server_err(e))
    }
    let vals = (if binary { w.parse_binary_row(pk, cols) } else { w.parse_text_row(pk, cols.len()) }).map_err(fn(e) { wire_err(p, e) })?
    if !bad.is_empty() {
      // after a value that does not convert the rest is read and dropped,
      // as database/sql's Rows.Close has go-sql-driver do
      continue
    }
    var row: List[sql.SqlValue] = List.with_capacity(vals.len())
    for (i, v) in vals.indexed() {
      match text_value(cols[i], v, p.cfg.parse_time, p.cfg.zone) {
        Ok(x) => row.push(x)
        Err(m) => {
          bad = m
          break
        }
      }
    }
    rows.push(row)
  }
  Ok((Result1{cols: cols, rows: rows, affected: 0, insert_id: 0}, false))
}

/// The column definitions of a COM_STMT_PREPARE_OK (n of them, then an
/// EOF unless the server deprecated it).
fn read_defs(p: MyConn, n: Int) -> List[w.Column] ! sql.SqlErr uses net.dial {
  var cols: List[w.Column] = []
  for _ in 0..n {
    cols.push(w.parse_column(p.recv()?).map_err(fn(e) { wire_err(p, e) })?)
  }
  if n > 0 && p.caps & w.CLIENT_DEPRECATE_EOF == 0 {
    let eof = p.recv()?
    if !w.is_end(eof) {
      p.broken.set(true)
      return Err(conn_err("no EOF after a prepared statement's definitions"))
    }
  }
  Ok(cols)
}

/// An argument in the binary protocol, go-sql-driver's types: Integer a
/// LONGLONG, Real a DOUBLE, Flag a TINY, Text, JsonText and Blob a
/// string's bytes, At a DATETIME's text in loc.
pub fn bin_param(v: sql.SqlValue, z: time.Zone = time.utc()) -> w.BinParam ! sql.SqlErr {
  let str = fn(b: Bytes) { w.BinParam{kind: w.TYPE_STRING, unsigned: false, null: false, value: w.lenenc_str(b)} }
  match v {
    Null => Ok(w.BinParam{kind: w.TYPE_NULL, unsigned: false, null: true, value: b""})
    Integer(n) => Ok(w.BinParam{kind: w.TYPE_LONGLONG, unsigned: false, null: false, value: w.le_bytes(n, 8)})
    Real(f) => Ok(w.BinParam{kind: w.TYPE_DOUBLE, unsigned: false, null: false, value: w.le_bytes(f.to_bits(), 8)})
    Flag(b) => Ok(w.BinParam{kind: w.TYPE_TINY, unsigned: false, null: false, value: if b { b"\x01" } else { b"\x00" }})
    Text(s) => Ok(str(s.bytes()))
    JsonText(s) => Ok(str(s.bytes()))
    Blob(b) => Ok(str(b))
    At(t) => Ok(str(datetime_text(t, z).bytes()))
    Array(_) => Err(param_err("MySQL has no array type"))
  }
}

/// q prepared on the server (COM_STMT_PREPARE): its id and placeholder
/// count.
fn prepare_on(p: MyConn, q: Str) -> MyStmt ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  p.seq.set(0)
  p.send(w.command(w.COM_STMT_PREPARE, q.bytes()))?
  let first = p.recv()?
  if first.len() > 0 && first[0] == 255 {
    return Err(server_err(w.err_packet(first, true).map_err(fn(x) { wire_err(p, x) })?))
  }
  let ok = w.prepare_ok(first).map_err(fn(e) { wire_err(p, e) })?
  let _ = read_defs(p, ok.params)?
  let _ = read_defs(p, ok.columns)?
  MyStmt{p: p, id: ok.id, params: ok.params}
}

/// A statement prepared on the server (decision 0648 item 6, go-sql-driver's
/// mysqlStmt): run with COM_STMT_EXECUTE, its rows in the binary protocol,
/// freed with COM_STMT_CLOSE.
pub struct MyStmt {
  p: MyConn
  id: Int
  params: Int
}

/// Every result of one COM_STMT_EXECUTE of s with args; a count of
/// arguments that is not the statement's placeholders is Param (the
/// statement stays prepared).
fn (s: MyStmt) run(args: List[sql.SqlValue]) -> List[Result1] ! sql.SqlErr uses net.dial {
  let p = s.p
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  if s.params != args.len() {
    return Err(param_err("the statement has ${s.params} placeholders and ${args.len()} arguments"))
  }
  var ps: List[w.BinParam] = []
  for a in args {
    ps.push(bin_param(a, p.cfg.zone)?)
  }
  p.seq.set(0)
  p.send(w.stmt_execute(s.id, ps))?
  results(p, true)
}

fn (s: MyStmt) query(args: List[sql.SqlValue]) -> sql.DriverRows ! sql.SqlErr uses net.dial { driver_rows(s.p, s.run(args)?) }

fn (s: MyStmt) exec(args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial { exec_result(s.run(args)?) }

/// COM_STMT_CLOSE, which has no response; nothing on a broken connection.
fn (s: MyStmt) close() uses net.dial {
  if s.p.broken.get() {
    return
  }
  s.p.seq.set(0)
  s.p.send(w.stmt_close(s.id)).ignore_err("a failed send marks the connection broken, which the pool drops")
}

/// q prepared on the server, run once with args, closed (decision 0648
/// item 5: what go-sql-driver does for db.Query(q, args...)).
fn run_prepared(p: MyConn, q: Str, args: List[sql.SqlValue]) -> List[Result1] ! sql.SqlErr uses net.dial {
  let st = prepare_on(p, q)?
  let rs = st.run(args)
  // closed whatever the result, unless the connection broke
  st.close()
  rs
}

/// The results of q with args: prepared on the server, or with
/// interpolateParams=true (or no arguments) as text.
fn run_args(p: MyConn, q: Str, args: List[sql.SqlValue]) -> List[Result1] ! sql.SqlErr uses net.dial {
  if args.is_empty() || p.cfg.interpolate {
    return run(p, text_of(p, q, args)?)
  }
  run_prepared(p, q, args)
}

/// The status's NO_BACKSLASH_ESCAPES bit.
fn no_backslash(p: MyConn) -> Bool { p.status.get() & 512 != 0 }

/// q with its arguments in the text (interpolateParams=true).
fn text_of(p: MyConn, q: Str, args: List[sql.SqlValue]) -> Str ! sql.SqlErr {
  if args.is_empty() {
    return Ok(q)
  }
  interpolate(q, args, no_backslash(p), p.cfg.zone)
}

fn col_name(p: MyConn, c: w.Column) -> Str {
  if p.cfg.columns_with_alias && !c.table.is_empty() { "${c.table}.${c.name}" } else { c.name }
}

fn (p: MyConn) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows ! sql.SqlErr uses net.dial { driver_rows(p, run_args(p, q, args)?) }

/// The result sets of rs (those with columns, as go-sql-driver's
/// NextResultSet skips the others): the first, and the rest as `more`
/// (decision 0648 item 7: query and rows drop them, query_all returns
/// them).
fn driver_rows(p: MyConn, rs: List[Result1]) -> sql.DriverRows {
  var first: sql.DriverRows? = None
  var more: List[sql.DriverResult] = []
  for r in rs {
    if r.cols.is_empty() {
      continue
    }
    let names = r.cols.map(fn(c) { col_name(p, c) })
    if first.is_none() {
      first = Some(sql.DriverRows{columns: names, rows: r.rows, column_types: column_types(r.cols)})
    } else {
      more.push(sql.DriverResult{columns: names, rows: r.rows, column_types: column_types(r.cols)})
    }
  }
  match first {
    Some(f) => f with {more: more}
    None => sql.DriverRows{columns: [], rows: []}
  }
}

/// The last statement's counts.
fn exec_result(rs: List[Result1]) -> sql.ExecResult {
  var res = sql.ExecResult{rows_affected: 0, last_insert_id: 0}
  for r in rs {
    res = sql.ExecResult{rows_affected: r.affected, last_insert_id: r.insert_id}
  }
  res
}

fn (p: MyConn) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial { exec_result(run_args(p, q, args)?) }

fn (p: MyConn) begin() -> () ! sql.SqlErr uses net.dial {
  let _ = run(p, "START TRANSACTION")?
}

fn (p: MyConn) commit() -> () ! sql.SqlErr uses net.dial {
  let _ = run(p, "COMMIT")?
}

fn (p: MyConn) rollback() -> () ! sql.SqlErr uses net.dial {
  let _ = run(p, "ROLLBACK")?
}

fn (p: MyConn) ping() -> () ! sql.SqlErr uses net.dial {
  if p.broken.get() {
    return Err(conn_err("the connection is broken"))
  }
  p.seq.set(0)
  p.send(w.command(w.COM_PING, b""))?
  let r = p.recv()?
  if r.len() > 0 && r[0] == 255 {
    return Err(server_err(w.err_packet(r, true).map_err(fn(e) { wire_err(p, e) })?))
  }
}

fn quote_name(s: Str) -> Str { "`" + s.replace("`", "``") + "`" }

/// copy_from: INSERTs of as many rows as fit under maxAllowedPacket, in
/// the caller's transaction (decision 0648 item 10).
fn (p: MyConn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial {
  let head = "INSERT INTO ${quote_name(table)} (${columns.map(quote_name).join(", ")}) VALUES "
  let limit = (p.cfg.max_allowed_packet - 1024).max(4096)
  var total = 0
  var batch = BytesBuilder.new()
  var in_batch = 0
  while true {
    let next = rows()?
    match next {
      Some(vals) => {
        if vals.len() != columns.len() {
          return Err(param_err("a row of ${vals.len()} values for ${columns.len()} columns"))
        }
        var t: List[Str] = []
        for v in vals {
          t.push(literal(v, no_backslash(p), p.cfg.zone)?)
        }
        let one = "(${t.join(", ")})"
        if in_batch > 0 && batch.len() + one.len() + 2 > limit {
          total += p.exec(head + batch.freeze().to_str_lossy(), [])?.rows_affected
          batch = BytesBuilder.new()
          in_batch = 0
        }
        if in_batch > 0 {
          batch.write_str(", ")
        }
        batch.write_str(one)
        in_batch += 1
      }
      None => break
    }
  }
  if in_batch > 0 {
    total += p.exec(head + batch.freeze().to_str_lossy(), [])?.rows_affected
  }
  Ok(total)
}

fn (p: MyConn) close() uses net.dial {
  p.seq.set(0)
  let (data, _) = w.frame(0, w.command(w.COM_QUIT, b""))
  let _ = p.c.write(data).is_ok()
  p.c.close()
}

/// Broken by an error, or, between statements, no longer idle: bytes or
/// the end of the stream wait on the raw connection, as when the server
/// closed it after wait_timeout (go-sql-driver's connCheck before a
/// pooled connection is reused, ErrBadConn to database/sql).
fn (p: MyConn) is_broken() -> Bool {
  if p.broken.get() {
    return true
  }
  if !p.buf.with_read(fn(b) { b.is_empty() }) {
    return true
  }
  let ok = if target.arch == TargetArch.Wasm32 { netwasi.conn_idle_ok(p.x.raw) } else { netconn.conn_idle_ok(rt.obj_addr(p.x.raw)) }
  if !ok {
    p.broken.set(true)
  }
  !ok
}

/// COM_STMT_PREPARE (decision 0648 item 6): prepared on the server
/// whatever interpolateParams says, as go-sql-driver's Prepare.
fn (p: MyConn) prepare(q: Str) -> sql.DriverStmt? ! sql.SqlErr uses net.dial { Some(prepare_on(p, q)?) }

/// MySQL has no LISTEN/NOTIFY (decision 0648 item 14).
fn (p: MyConn) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial {
  Err(sql.SqlErr.Driver(msg: "mysql: LISTEN/NOTIFY is Postgres only"))
}

/// MySQL's warnings are not notices: none (decision 0648 item 14).
fn (p: MyConn) notices() -> List[sql.Notice] { [] }

/// DriverConn.pipeline (decision 0648 item 15): each batch's queries one
/// by one (go-sql-driver has no batches), in START TRANSACTION and COMMIT
/// unless in_tx, with ROLLBACK at the first error. A broken connection is
/// the call's error.
fn (p: MyConn) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr uses net.dial {
  var out: List[Result[List[sql.DriverResult], sql.SqlErr]] = List.with_capacity(batches.len())
  for b in batches {
    let r = my_batch(p, b, in_tx)
    if p.broken.get() {
      return Err(r.err() ?? conn_err("the connection is broken"))
    }
    out.push(r)
  }
  out
}

fn my_batch(p: MyConn, qs: List[sql.BatchQuery], in_tx: Bool) -> List[sql.DriverResult] ! sql.SqlErr uses net.dial {
  if qs.is_empty() {
    return []
  }
  if !in_tx {
    p.begin()?
  }
  var out: List[sql.DriverResult] = List.with_capacity(qs.len())
  for x in qs {
    match run_args(p, x.query, x.args) {
      Ok(rs) => out.push(batch_result(p, rs))
      Err(e) => {
        if !in_tx && !p.broken.get() {
          p.rollback().ignore_err("the batch's error is the one returned")
        }
        return Err(e)
      }
    }
  }
  if !in_tx {
    p.commit()?
  }
  out
}

/// A batch query's result: its last result's rows (a SELECT counts them)
/// or its count.
fn batch_result(p: MyConn, rs: List[Result1]) -> sql.DriverResult {
  match rs.last() {
    Some(r) => {
      if r.cols.is_empty() {
        sql.DriverResult{columns: [], rows: [], rows_affected: r.affected}
      } else {
        sql.DriverResult{columns: r.cols.map(fn(c) { col_name(p, c) }), rows: r.rows, column_types: column_types(r.cols), rows_affected: r.rows.len()}
      }
    }
    None => sql.DriverResult{columns: [], rows: []}
  }
}

// ---------------------------------------------------------------------------
// Column types (decision 0609)

/// MySQL's name for a column's type (the reference manual's data type
/// names), "UNSIGNED " before an unsigned integer's.
pub fn type_name(c: w.Column) -> Str {
  let unsigned = c.flags & w.FLAG_UNSIGNED != 0
  let binary = c.charset == w.CHARSET_BINARY
  let base = match c.kind {
    0 | 246 => "DECIMAL"
    1 => "TINYINT"
    2 => "SMALLINT"
    3 => "INT"
    4 => "FLOAT"
    5 => "DOUBLE"
    6 => "NULL"
    7 => "TIMESTAMP"
    8 => "BIGINT"
    9 => "MEDIUMINT"
    10 | 14 => "DATE"
    11 => "TIME"
    12 => "DATETIME"
    13 => "YEAR"
    15 | 253 => if binary { "VARBINARY" } else { "VARCHAR" }
    16 => "BIT"
    245 => "JSON"
    247 => "ENUM"
    248 => "SET"
    249 => if binary { "TINYBLOB" } else { "TINYTEXT" }
    250 => if binary { "MEDIUMBLOB" } else { "MEDIUMTEXT" }
    251 => if binary { "LONGBLOB" } else { "LONGTEXT" }
    252 => if binary { "BLOB" } else { "TEXT" }
    254 => if c.flags & 256 != 0 { "ENUM" } else if c.flags & 2048 != 0 { "SET" } else if binary { "BINARY" } else { "CHAR" }
    255 => "GEOMETRY"
    _ => ""
  }
  if unsigned && (c.kind is 1 | 2 | 3 | 8 | 9) { "UNSIGNED ${base}" } else { base }
}

fn kind_of(c: w.Column) -> Str {
  match decode_text(c, Some(b"0"), true) {
    Integer(_) => "Integer"
    Real(_) => "Real"
    Blob(_) => "Blob"
    JsonText(_) => "JsonText"
    At(_) => "At"
    _ => "Text"
  }
}

pub fn column_types(cols: List[w.Column]) -> List[sql.ColumnType] {
  cols.map(fn(c) {
    let dec = c.kind == 0 || c.kind == 246
    sql.ColumnType{name: c.name, database_type: type_name(c), precision: if dec { Some(c.length - (if c.decimals > 0 { 1 } else { 0 }) - (if c.flags & w.FLAG_UNSIGNED != 0 { 0 } else { 1 })) } else { None }, scale: if dec { Some(c.decimals) } else { None }, nullable: Some(c.flags & w.FLAG_NOT_NULL == 0), kind: kind_of(c)}
  })
}
