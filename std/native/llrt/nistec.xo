// The NIST curves P-256, P-384 and P-521, and P-224 for signatures
// (FIPS 186-5, SEC 1) for TLS (the zero-C
// audit's B31, decision 0202: Go's crypto/internal/fips140/nistec and
// ecdsa designs in Xo, replacing Mbed TLS's ecp and ecdsa): ECDH (the
// key shares of TLS 1.3 and ECDHE of TLS 1.2) and ECDSA signing and
// verification over a hash the caller computed.
//
// Field elements are L 64 bit limbs, the lowest first (L = 4 for P-256
// and P-224, 6 for P-384, 9 for P-521), in the Montgomery domain (x R mod m, R = 2^(64L)), with
// one generic Montgomery product (CIOS) for both the field (mod p) and
// the scalars (mod n). Points are projective (X:Y:Z) with the complete
// addition formulas for a = -3 of Renes, Costello and Batina (eprint
// 2015/1060, algorithm 4), which double too and take the identity
// (0:1:0) like any other point; scalar multiplication is a fixed 4 bit
// window over a table of [0]P to [15]P, every entry read under a mask
// (ct.xo), so it is constant time in the scalar. Inversion is Fermat's,
// x^(m-2), a fixed sequence for the public exponent. The rules of ct.xo
// hold for every secret (a private scalar, an ECDSA nonce, a shared
// point): wrapping arithmetic, rt.u64_mul_hi, masks, no branch or index
// on a secret. Decoding a peer's point and verifying a signature work on
// public values and branch on them.
//
// Everything of one operation lives in one List[Int], the workspace,
// reached through raw memory as ed25519.xo's: `c` is the address of its
// first word, an element takes 9 words (ES, 72 bytes) whatever L is, a
// point three elements (X, Y, Z at +0, +ES, +2 ES; PS bytes).
use native/llrt/bigmod
use native/llrt/cpu
use native/llrt/ct
use native/llrt/nistec_g256
use native/llrt/nistec_gtab
use native/llrt/raw
use native/llrt/rand
use native/rt

/// The curves (the `curve` argument of the functions below).
pub const P256: Int = 0
pub const P384: Int = 1
pub const P521: Int = 2
/// P-224: ECDSA verification of certificates (Go's crypto/ecdsa); no TLS
/// key exchange uses it.
pub const P224: Int = 3

// The workspace, in bytes: L, the curve's byte size (SZW), then a modulus
// block for p and one for n (MINV: -m^-1 mod 2^64; MLIMBS: m; MRR: R^2
// mod m; MONE: R mod m; ME2: m - 2, the exponent of an inversion).
const SZW: Int = 8
const ES: Int = 72
const PS: Int = 216
const MP: Int = 16
const MN: Int = 312
const MINV: Int = 0
const MLIMBS: Int = 8
const MRR: Int = 80
const MONE: Int = 152
const ME2: Int = 224
// b (Montgomery), the 1 of the integers (to leave the Montgomery domain)
const CB: Int = 608
const ONE1: Int = 680
// the product's L + 2 words, then a difference's L words
const TMPW: Int = 752
const DIFF: Int = 840
// pt_add's t0 to t4, X3, Y3, Z3
const T0: Int = 912
// pow's accumulator
const PW: Int = 1488
// points: the base point, three of the operations, the multiplication's
// accumulator and selection
const PG: Int = 1560
const PA: Int = 1776
const PB: Int = 1992
const PC: Int = 2208
const ACC: Int = 2424
const SEL: Int = 2640
// the multiplication's table of [0]P to [15]P
const TABLE: Int = 2856
// the elements of ECDH and ECDSA
const S0: Int = 6312
// pow's table of f^1 to f^15 (the inversion chain's temporaries too)
const POWT: Int = 6888
// the workspace in words
const WSIZE: Int = 996

fn at(c: Int, off: Int) -> Int { c.wrapping_add(off) }

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

/// The element S0 + k.
fn sk(c: Int, k: Int) -> Int { at(c, S0 + ES * k) }

fn limbs(c: Int) -> Int { ld(c, 0) }

/// The bytes of an element or scalar of the curve.
pub fn size(curve: Int) -> Int {
  if curve == P384 {
    return 48
  }
  if curve == P521 {
    return 66
  }
  if curve == P224 {
    return 28
  }
  32
}

/// The byte size of the workspace's curve.
fn csize(c: Int) -> Int { ld(c, SZW) }

// ---------------------------------------------------------------------------
// Words

/// Stores x + y + cin at h + off; the carry out.
fn adc(h: Int, off: Int, x: Int, y: Int, cin: Int) -> Int {
  let s1 = x.wrapping_add(y)
  let s = s1.wrapping_add(cin)
  st(h, off, s)
  cpu.carry(x, y) | cpu.carry(s1, cin)
}

/// Stores x - y - bin at h + off; the borrow out.
fn sbb(h: Int, off: Int, x: Int, y: Int, bin: Int) -> Int {
  let d1 = x.wrapping_sub(y)
  let d = d1.wrapping_sub(bin)
  st(h, off, d)
  cpu.borrow(x, y) | cpu.borrow(d1, bin)
}

/// Adds a * b + cin to the word at t + off; the high word of the sum.
fn mac(t: Int, off: Int, a: Int, b: Int, cin: Int) -> Int {
  let lo = a.wrapping_mul(b)
  let hi = a.mul_hi_unsigned(b)
  let x = ld(t, off)
  let s1 = lo.wrapping_add(x)
  let s2 = s1.wrapping_add(cin)
  st(t, off, s2)
  hi.wrapping_add(cpu.carry(lo, x) + cpu.carry(s1, cin))
}

// ---------------------------------------------------------------------------
// Elements modulo m (md the address of m's block; h may be f or g)

/// h = t - m when t + top 2^(64L) >= m, else t (top is 0 or 1, and t <
/// 2m).
fn final_sub(c: Int, h: Int, t: Int, md: Int, top: Int) {
  let n = limbs(c)
  let d = at(c, DIFF)
  var b = 0
  var i = 0
  while i < n {
    b = sbb(d, 8 * i, ld(t, 8 * i), ld(md, MLIMBS + 8 * i), b)
    i += 1
  }
  let keep = ct.mask_bit(b & (top ^ 1))
  i = 0
  while i < n {
    st(h, 8 * i, ct.pick(keep, ld(t, 8 * i), ld(d, 8 * i)))
    i += 1
  }
}

/// h = f g / R mod m for P-521's 9 limbs: the 18 word product, then
/// Montgomery's reduction, each row one bigmod.mac_row (a multiply and
/// add pass whose carries are cpu.adc pairs: 7 instructions a word on
/// arm64). The product and reduction use TMPW and DIFF together (2 n + 2
/// words); the result is moved down before final_sub writes DIFF.
fn mul_rows(c: Int, h: Int, f: Int, g: Int, md: Int) {
  let n = 9
  let t = at(c, TMPW)
  rt.mem_set(t, 0, 8 * (2 * n + 2))
  var i = 0
  while i < n {
    let ti = t.wrapping_add(8 * i)
    st(ti, 8 * n, bigmod.mac_row(ti, f, ld(g, 8 * i), n))
    i += 1
  }
  let m = at(md, MLIMBS)
  let inv = ld(md, MINV)
  var ext = 0
  i = 0
  while i < n {
    let ti = t.wrapping_add(8 * i)
    let cw = bigmod.mac_row(ti, m, ld(ti, 0).wrapping_mul(inv), n)
    let x = ld(ti, 8 * n)
    let y = cpu.adc(x, cw, ext)
    ext = cpu.adc_carry(x, cw, ext)
    st(ti, 8 * n, y)
    i += 1
  }
  rt.mem_copy(t, t.wrapping_add(8 * n), 8 * n)
  final_sub(c, h, t, md, ext)
}

/// h = f g / R mod m (the Montgomery product, CIOS; f, g < m).
fn mul(c: Int, h: Int, f: Int, g: Int, md: Int) {
  let n = limbs(c)
  if n == 4 {
    // P-256's field: the reduction by shifts (mul4p); its scalars and
    // P-224 (4 limbs too) mul4
    if md == at(c, MP) && csize(c) == 32 && f == g {
      sqr4p(h, f)
    } else if md == at(c, MP) && csize(c) == 32 {
      mul4p(h, f, g)
    } else {
      mul4(h, f, g, md)
    }
    return
  }
  if n == 6 {
    mul6(h, f, g, md)
    return
  }
  if n == 9 {
    mul_rows(c, h, f, g, md)
    return
  }
  let t = at(c, TMPW)
  let inv = ld(md, MINV)
  rt.mem_set(t, 0, 8 * (n + 2))
  var i = 0
  while i < n {
    let gi = ld(g, 8 * i)
    var cy = 0
    var j = 0
    while j < n {
      cy = mac(t, 8 * j, ld(f, 8 * j), gi, cy)
      j += 1
    }
    let x = ld(t, 8 * n)
    let s = x.wrapping_add(cy)
    st(t, 8 * n, s)
    st(t, 8 * (n + 1), cpu.carry(x, cy))
    // t + q m is divisible by 2^64; shift it down a word
    let q = ld(t, 0).wrapping_mul(inv)
    cy = mac(t, 0, q, ld(md, MLIMBS), 0)
    j = 1
    while j < n {
      cy = mac(t, 8 * j, q, ld(md, MLIMBS + 8 * j), cy)
      st(t, 8 * (j - 1), ld(t, 8 * j))
      j += 1
    }
    let x2 = ld(t, 8 * n)
    let s2 = x2.wrapping_add(cy)
    st(t, 8 * (n - 1), s2)
    st(t, 8 * n, ld(t, 8 * (n + 1)).wrapping_add(cpu.carry(x2, cy)))
    i += 1
  }
  final_sub(c, h, t, md, ld(t, 8 * n))
}

/// mul for 4 limbs (P-256's field and scalars): CIOS unrolled over
/// local words, the same result.
fn mul4(h: Int, f: Int, g: Int, md: Int) {
  let inv = ld(md, MINV)
  let f0 = ld(f, 0)
  let g0 = ld(g, 0)
  let m0 = ld(md, MLIMBS + 0)
  let f1 = ld(f, 8)
  let g1 = ld(g, 8)
  let m1 = ld(md, MLIMBS + 8)
  let f2 = ld(f, 16)
  let g2 = ld(g, 16)
  let m2 = ld(md, MLIMBS + 16)
  let f3 = ld(f, 24)
  let g3 = ld(g, 24)
  let m3 = ld(md, MLIMBS + 24)
  let lo1 = f0.wrapping_mul(g0)
  let hi2 = f0.mul_hi_unsigned(g0)
  let lo8 = f1.wrapping_mul(g0)
  let hi9 = f1.mul_hi_unsigned(g0)
  let s12 = lo8.wrapping_add(hi2)
  let k13 = cpu.carry(lo8, hi2)
  let c14 = hi9.wrapping_add(k13)
  let lo15 = f2.wrapping_mul(g0)
  let hi16 = f2.mul_hi_unsigned(g0)
  let s19 = lo15.wrapping_add(c14)
  let k20 = cpu.carry(lo15, c14)
  let c21 = hi16.wrapping_add(k20)
  let lo22 = f3.wrapping_mul(g0)
  let hi23 = f3.mul_hi_unsigned(g0)
  let s26 = lo22.wrapping_add(c21)
  let k27 = cpu.carry(lo22, c21)
  let c28 = hi23.wrapping_add(k27)
  let q31 = lo1.wrapping_mul(inv)
  let lo32 = q31.wrapping_mul(m0)
  let hi33 = q31.mul_hi_unsigned(m0)
  let k35 = cpu.carry(lo32, lo1)
  let c38 = hi33.wrapping_add(k35)
  let lo39 = q31.wrapping_mul(m1)
  let hi40 = q31.mul_hi_unsigned(m1)
  let s41 = lo39.wrapping_add(s12)
  let k42 = cpu.carry(lo39, s12)
  let s43 = s41.wrapping_add(c38)
  let k44 = cpu.carry(s41, c38)
  let c45 = hi40.wrapping_add(k42.wrapping_add(k44))
  let lo46 = q31.wrapping_mul(m2)
  let hi47 = q31.mul_hi_unsigned(m2)
  let s48 = lo46.wrapping_add(s19)
  let k49 = cpu.carry(lo46, s19)
  let s50 = s48.wrapping_add(c45)
  let k51 = cpu.carry(s48, c45)
  let c52 = hi47.wrapping_add(k49.wrapping_add(k51))
  let lo53 = q31.wrapping_mul(m3)
  let hi54 = q31.mul_hi_unsigned(m3)
  let s55 = lo53.wrapping_add(s26)
  let k56 = cpu.carry(lo53, s26)
  let s57 = s55.wrapping_add(c52)
  let k58 = cpu.carry(s55, c52)
  let c59 = hi54.wrapping_add(k56.wrapping_add(k58))
  let s60 = c28.wrapping_add(c59)
  let k61 = cpu.carry(c28, c59)
  let lo63 = f0.wrapping_mul(g1)
  let hi64 = f0.mul_hi_unsigned(g1)
  let s65 = lo63.wrapping_add(s43)
  let k66 = cpu.carry(lo63, s43)
  let c69 = hi64.wrapping_add(k66)
  let lo70 = f1.wrapping_mul(g1)
  let hi71 = f1.mul_hi_unsigned(g1)
  let s72 = lo70.wrapping_add(s50)
  let k73 = cpu.carry(lo70, s50)
  let s74 = s72.wrapping_add(c69)
  let k75 = cpu.carry(s72, c69)
  let c76 = hi71.wrapping_add(k73.wrapping_add(k75))
  let lo77 = f2.wrapping_mul(g1)
  let hi78 = f2.mul_hi_unsigned(g1)
  let s79 = lo77.wrapping_add(s57)
  let k80 = cpu.carry(lo77, s57)
  let s81 = s79.wrapping_add(c76)
  let k82 = cpu.carry(s79, c76)
  let c83 = hi78.wrapping_add(k80.wrapping_add(k82))
  let lo84 = f3.wrapping_mul(g1)
  let hi85 = f3.mul_hi_unsigned(g1)
  let s86 = lo84.wrapping_add(s60)
  let k87 = cpu.carry(lo84, s60)
  let s88 = s86.wrapping_add(c83)
  let k89 = cpu.carry(s86, c83)
  let c90 = hi85.wrapping_add(k87.wrapping_add(k89))
  let s91 = k61.wrapping_add(c90)
  let k92 = cpu.carry(k61, c90)
  let q93 = s65.wrapping_mul(inv)
  let lo94 = q93.wrapping_mul(m0)
  let hi95 = q93.mul_hi_unsigned(m0)
  let k97 = cpu.carry(lo94, s65)
  let c100 = hi95.wrapping_add(k97)
  let lo101 = q93.wrapping_mul(m1)
  let hi102 = q93.mul_hi_unsigned(m1)
  let s103 = lo101.wrapping_add(s74)
  let k104 = cpu.carry(lo101, s74)
  let s105 = s103.wrapping_add(c100)
  let k106 = cpu.carry(s103, c100)
  let c107 = hi102.wrapping_add(k104.wrapping_add(k106))
  let lo108 = q93.wrapping_mul(m2)
  let hi109 = q93.mul_hi_unsigned(m2)
  let s110 = lo108.wrapping_add(s81)
  let k111 = cpu.carry(lo108, s81)
  let s112 = s110.wrapping_add(c107)
  let k113 = cpu.carry(s110, c107)
  let c114 = hi109.wrapping_add(k111.wrapping_add(k113))
  let lo115 = q93.wrapping_mul(m3)
  let hi116 = q93.mul_hi_unsigned(m3)
  let s117 = lo115.wrapping_add(s88)
  let k118 = cpu.carry(lo115, s88)
  let s119 = s117.wrapping_add(c114)
  let k120 = cpu.carry(s117, c114)
  let c121 = hi116.wrapping_add(k118.wrapping_add(k120))
  let s122 = s91.wrapping_add(c121)
  let k123 = cpu.carry(s91, c121)
  let t124 = k92.wrapping_add(k123)
  let lo125 = f0.wrapping_mul(g2)
  let hi126 = f0.mul_hi_unsigned(g2)
  let s127 = lo125.wrapping_add(s105)
  let k128 = cpu.carry(lo125, s105)
  let c131 = hi126.wrapping_add(k128)
  let lo132 = f1.wrapping_mul(g2)
  let hi133 = f1.mul_hi_unsigned(g2)
  let s134 = lo132.wrapping_add(s112)
  let k135 = cpu.carry(lo132, s112)
  let s136 = s134.wrapping_add(c131)
  let k137 = cpu.carry(s134, c131)
  let c138 = hi133.wrapping_add(k135.wrapping_add(k137))
  let lo139 = f2.wrapping_mul(g2)
  let hi140 = f2.mul_hi_unsigned(g2)
  let s141 = lo139.wrapping_add(s119)
  let k142 = cpu.carry(lo139, s119)
  let s143 = s141.wrapping_add(c138)
  let k144 = cpu.carry(s141, c138)
  let c145 = hi140.wrapping_add(k142.wrapping_add(k144))
  let lo146 = f3.wrapping_mul(g2)
  let hi147 = f3.mul_hi_unsigned(g2)
  let s148 = lo146.wrapping_add(s122)
  let k149 = cpu.carry(lo146, s122)
  let s150 = s148.wrapping_add(c145)
  let k151 = cpu.carry(s148, c145)
  let c152 = hi147.wrapping_add(k149.wrapping_add(k151))
  let s153 = t124.wrapping_add(c152)
  let k154 = cpu.carry(t124, c152)
  let q155 = s127.wrapping_mul(inv)
  let lo156 = q155.wrapping_mul(m0)
  let hi157 = q155.mul_hi_unsigned(m0)
  let k159 = cpu.carry(lo156, s127)
  let c162 = hi157.wrapping_add(k159)
  let lo163 = q155.wrapping_mul(m1)
  let hi164 = q155.mul_hi_unsigned(m1)
  let s165 = lo163.wrapping_add(s136)
  let k166 = cpu.carry(lo163, s136)
  let s167 = s165.wrapping_add(c162)
  let k168 = cpu.carry(s165, c162)
  let c169 = hi164.wrapping_add(k166.wrapping_add(k168))
  let lo170 = q155.wrapping_mul(m2)
  let hi171 = q155.mul_hi_unsigned(m2)
  let s172 = lo170.wrapping_add(s143)
  let k173 = cpu.carry(lo170, s143)
  let s174 = s172.wrapping_add(c169)
  let k175 = cpu.carry(s172, c169)
  let c176 = hi171.wrapping_add(k173.wrapping_add(k175))
  let lo177 = q155.wrapping_mul(m3)
  let hi178 = q155.mul_hi_unsigned(m3)
  let s179 = lo177.wrapping_add(s150)
  let k180 = cpu.carry(lo177, s150)
  let s181 = s179.wrapping_add(c176)
  let k182 = cpu.carry(s179, c176)
  let c183 = hi178.wrapping_add(k180.wrapping_add(k182))
  let s184 = s153.wrapping_add(c183)
  let k185 = cpu.carry(s153, c183)
  let t186 = k154.wrapping_add(k185)
  let lo187 = f0.wrapping_mul(g3)
  let hi188 = f0.mul_hi_unsigned(g3)
  let s189 = lo187.wrapping_add(s167)
  let k190 = cpu.carry(lo187, s167)
  let c193 = hi188.wrapping_add(k190)
  let lo194 = f1.wrapping_mul(g3)
  let hi195 = f1.mul_hi_unsigned(g3)
  let s196 = lo194.wrapping_add(s174)
  let k197 = cpu.carry(lo194, s174)
  let s198 = s196.wrapping_add(c193)
  let k199 = cpu.carry(s196, c193)
  let c200 = hi195.wrapping_add(k197.wrapping_add(k199))
  let lo201 = f2.wrapping_mul(g3)
  let hi202 = f2.mul_hi_unsigned(g3)
  let s203 = lo201.wrapping_add(s181)
  let k204 = cpu.carry(lo201, s181)
  let s205 = s203.wrapping_add(c200)
  let k206 = cpu.carry(s203, c200)
  let c207 = hi202.wrapping_add(k204.wrapping_add(k206))
  let lo208 = f3.wrapping_mul(g3)
  let hi209 = f3.mul_hi_unsigned(g3)
  let s210 = lo208.wrapping_add(s184)
  let k211 = cpu.carry(lo208, s184)
  let s212 = s210.wrapping_add(c207)
  let k213 = cpu.carry(s210, c207)
  let c214 = hi209.wrapping_add(k211.wrapping_add(k213))
  let s215 = t186.wrapping_add(c214)
  let k216 = cpu.carry(t186, c214)
  let q217 = s189.wrapping_mul(inv)
  let lo218 = q217.wrapping_mul(m0)
  let hi219 = q217.mul_hi_unsigned(m0)
  let k221 = cpu.carry(lo218, s189)
  let c224 = hi219.wrapping_add(k221)
  let lo225 = q217.wrapping_mul(m1)
  let hi226 = q217.mul_hi_unsigned(m1)
  let s227 = lo225.wrapping_add(s198)
  let k228 = cpu.carry(lo225, s198)
  let s229 = s227.wrapping_add(c224)
  let k230 = cpu.carry(s227, c224)
  let c231 = hi226.wrapping_add(k228.wrapping_add(k230))
  let lo232 = q217.wrapping_mul(m2)
  let hi233 = q217.mul_hi_unsigned(m2)
  let s234 = lo232.wrapping_add(s205)
  let k235 = cpu.carry(lo232, s205)
  let s236 = s234.wrapping_add(c231)
  let k237 = cpu.carry(s234, c231)
  let c238 = hi233.wrapping_add(k235.wrapping_add(k237))
  let lo239 = q217.wrapping_mul(m3)
  let hi240 = q217.mul_hi_unsigned(m3)
  let s241 = lo239.wrapping_add(s212)
  let k242 = cpu.carry(lo239, s212)
  let s243 = s241.wrapping_add(c238)
  let k244 = cpu.carry(s241, c238)
  let c245 = hi240.wrapping_add(k242.wrapping_add(k244))
  let s246 = s215.wrapping_add(c245)
  let k247 = cpu.carry(s215, c245)
  let t248 = k216.wrapping_add(k247)
  sub_m4(h, s229, s236, s243, s246, t248, m0, m1, m2, m3)
}

/// mul4 for P-256's field prime (p's limbs 2^64 - 1, 2^32 - 1, 0,
/// 2^64 - 2^32 + 1; -1/p mod 2^64 = 1): CIOS over local words, every sum
/// a chain of cpu.adc (adcs), each reduction step by shifts (t0 + q m0
/// is q 2^64 for q = t0, q m1 + q is q 2^32, m2 is 0, q m3 is q 2^64 -
/// q 2^32 + q). The same result as mul4 with P-256's modulus for f and g
/// below p (the accumulator's width rests on it: field_mul); generated
/// by scripts/gen/nistecmul4p.
fn mul4p(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let lo1 = f0.wrapping_mul(g0)
  let lo2 = f1.wrapping_mul(g0)
  let hi3 = f0.mul_hi_unsigned(g0)
  let s4 = cpu.adc(lo2, hi3, 0)
  let k5 = cpu.adc_carry(lo2, hi3, 0)
  let lo6 = f2.wrapping_mul(g0)
  let hi7 = f1.mul_hi_unsigned(g0)
  let s8 = cpu.adc(lo6, hi7, k5)
  let k9 = cpu.adc_carry(lo6, hi7, k5)
  let lo10 = f3.wrapping_mul(g0)
  let hi11 = f2.mul_hi_unsigned(g0)
  let s12 = cpu.adc(lo10, hi11, k9)
  let k13 = cpu.adc_carry(lo10, hi11, k9)
  let hi14 = f3.mul_hi_unsigned(g0)
  let s15 = cpu.adc(hi14, 0, k13)
  let ql16 = lo1.wrapping_shl(32)
  let qh17 = lo1.shr_logical(32)
  let lo18 = cpu.adc(lo1, ~ql16, 1)
  let k19 = cpu.adc_carry(lo1, ~ql16, 1)
  let hi20 = cpu.adc(lo1, ~qh17, k19)
  let s21 = cpu.adc(s4, ql16, 0)
  let k22 = cpu.adc_carry(s4, ql16, 0)
  let s23 = cpu.adc(s8, qh17, k22)
  let k24 = cpu.adc_carry(s8, qh17, k22)
  let s25 = cpu.adc(s12, lo18, k24)
  let k26 = cpu.adc_carry(s12, lo18, k24)
  let s27 = cpu.adc(s15, hi20, k26)
  let k28 = cpu.adc_carry(s15, hi20, k26)
  let g1 = ld(g, 8)
  let lo29 = f0.wrapping_mul(g1)
  let s30 = cpu.adc(s21, lo29, 0)
  let k31 = cpu.adc_carry(s21, lo29, 0)
  let lo32 = f1.wrapping_mul(g1)
  let s33 = cpu.adc(s23, lo32, k31)
  let k34 = cpu.adc_carry(s23, lo32, k31)
  let lo35 = f2.wrapping_mul(g1)
  let s36 = cpu.adc(s25, lo35, k34)
  let k37 = cpu.adc_carry(s25, lo35, k34)
  let lo38 = f3.wrapping_mul(g1)
  let s39 = cpu.adc(s27, lo38, k37)
  let k40 = cpu.adc_carry(s27, lo38, k37)
  let s41 = cpu.adc(k28, 0, k40)
  let hi42 = f0.mul_hi_unsigned(g1)
  let s43 = cpu.adc(s33, hi42, 0)
  let k44 = cpu.adc_carry(s33, hi42, 0)
  let hi45 = f1.mul_hi_unsigned(g1)
  let s46 = cpu.adc(s36, hi45, k44)
  let k47 = cpu.adc_carry(s36, hi45, k44)
  let hi48 = f2.mul_hi_unsigned(g1)
  let s49 = cpu.adc(s39, hi48, k47)
  let k50 = cpu.adc_carry(s39, hi48, k47)
  let hi51 = f3.mul_hi_unsigned(g1)
  let s52 = cpu.adc(s41, hi51, k50)
  let ql53 = s30.wrapping_shl(32)
  let qh54 = s30.shr_logical(32)
  let lo55 = cpu.adc(s30, ~ql53, 1)
  let k56 = cpu.adc_carry(s30, ~ql53, 1)
  let hi57 = cpu.adc(s30, ~qh54, k56)
  let s58 = cpu.adc(s43, ql53, 0)
  let k59 = cpu.adc_carry(s43, ql53, 0)
  let s60 = cpu.adc(s46, qh54, k59)
  let k61 = cpu.adc_carry(s46, qh54, k59)
  let s62 = cpu.adc(s49, lo55, k61)
  let k63 = cpu.adc_carry(s49, lo55, k61)
  let s64 = cpu.adc(s52, hi57, k63)
  let k65 = cpu.adc_carry(s52, hi57, k63)
  let g2 = ld(g, 16)
  let lo66 = f0.wrapping_mul(g2)
  let s67 = cpu.adc(s58, lo66, 0)
  let k68 = cpu.adc_carry(s58, lo66, 0)
  let lo69 = f1.wrapping_mul(g2)
  let s70 = cpu.adc(s60, lo69, k68)
  let k71 = cpu.adc_carry(s60, lo69, k68)
  let lo72 = f2.wrapping_mul(g2)
  let s73 = cpu.adc(s62, lo72, k71)
  let k74 = cpu.adc_carry(s62, lo72, k71)
  let lo75 = f3.wrapping_mul(g2)
  let s76 = cpu.adc(s64, lo75, k74)
  let k77 = cpu.adc_carry(s64, lo75, k74)
  let s78 = cpu.adc(k65, 0, k77)
  let hi79 = f0.mul_hi_unsigned(g2)
  let s80 = cpu.adc(s70, hi79, 0)
  let k81 = cpu.adc_carry(s70, hi79, 0)
  let hi82 = f1.mul_hi_unsigned(g2)
  let s83 = cpu.adc(s73, hi82, k81)
  let k84 = cpu.adc_carry(s73, hi82, k81)
  let hi85 = f2.mul_hi_unsigned(g2)
  let s86 = cpu.adc(s76, hi85, k84)
  let k87 = cpu.adc_carry(s76, hi85, k84)
  let hi88 = f3.mul_hi_unsigned(g2)
  let s89 = cpu.adc(s78, hi88, k87)
  let ql90 = s67.wrapping_shl(32)
  let qh91 = s67.shr_logical(32)
  let lo92 = cpu.adc(s67, ~ql90, 1)
  let k93 = cpu.adc_carry(s67, ~ql90, 1)
  let hi94 = cpu.adc(s67, ~qh91, k93)
  let s95 = cpu.adc(s80, ql90, 0)
  let k96 = cpu.adc_carry(s80, ql90, 0)
  let s97 = cpu.adc(s83, qh91, k96)
  let k98 = cpu.adc_carry(s83, qh91, k96)
  let s99 = cpu.adc(s86, lo92, k98)
  let k100 = cpu.adc_carry(s86, lo92, k98)
  let s101 = cpu.adc(s89, hi94, k100)
  let k102 = cpu.adc_carry(s89, hi94, k100)
  let g3 = ld(g, 24)
  let lo103 = f0.wrapping_mul(g3)
  let s104 = cpu.adc(s95, lo103, 0)
  let k105 = cpu.adc_carry(s95, lo103, 0)
  let lo106 = f1.wrapping_mul(g3)
  let s107 = cpu.adc(s97, lo106, k105)
  let k108 = cpu.adc_carry(s97, lo106, k105)
  let lo109 = f2.wrapping_mul(g3)
  let s110 = cpu.adc(s99, lo109, k108)
  let k111 = cpu.adc_carry(s99, lo109, k108)
  let lo112 = f3.wrapping_mul(g3)
  let s113 = cpu.adc(s101, lo112, k111)
  let k114 = cpu.adc_carry(s101, lo112, k111)
  let s115 = cpu.adc(k102, 0, k114)
  let hi116 = f0.mul_hi_unsigned(g3)
  let s117 = cpu.adc(s107, hi116, 0)
  let k118 = cpu.adc_carry(s107, hi116, 0)
  let hi119 = f1.mul_hi_unsigned(g3)
  let s120 = cpu.adc(s110, hi119, k118)
  let k121 = cpu.adc_carry(s110, hi119, k118)
  let hi122 = f2.mul_hi_unsigned(g3)
  let s123 = cpu.adc(s113, hi122, k121)
  let k124 = cpu.adc_carry(s113, hi122, k121)
  let hi125 = f3.mul_hi_unsigned(g3)
  let s126 = cpu.adc(s115, hi125, k124)
  let ql127 = s104.wrapping_shl(32)
  let qh128 = s104.shr_logical(32)
  let lo129 = cpu.adc(s104, ~ql127, 1)
  let k130 = cpu.adc_carry(s104, ~ql127, 1)
  let hi131 = cpu.adc(s104, ~qh128, k130)
  let s132 = cpu.adc(s117, ql127, 0)
  let k133 = cpu.adc_carry(s117, ql127, 0)
  let s134 = cpu.adc(s120, qh128, k133)
  let k135 = cpu.adc_carry(s120, qh128, k133)
  let s136 = cpu.adc(s123, lo129, k135)
  let k137 = cpu.adc_carry(s123, lo129, k135)
  let s138 = cpu.adc(s126, hi131, k137)
  let k139 = cpu.adc_carry(s126, hi131, k137)
  sub_p256(h, s132, s134, s136, s138, k139)
}

/// mul4p of f with itself: the square's 6 cross products once, doubled,
/// plus the 4 diagonal squares (10 products where mul4p makes 16), then
/// 4 Montgomery reduction rounds over the square's low half, each one
/// chain of cpu.adc with mul4p's addend of shifts, and its high half
/// added once. The same result as mul4p for f below p; generated by
/// scripts/gen/nistecmul4p.
fn sqr4p(h: Int, f: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let lo1 = f0.wrapping_mul(f1)
  let lo2 = f0.wrapping_mul(f2)
  let hi3 = f0.mul_hi_unsigned(f1)
  let s4 = cpu.adc(lo2, hi3, 0)
  let k5 = cpu.adc_carry(lo2, hi3, 0)
  let lo6 = f0.wrapping_mul(f3)
  let hi7 = f0.mul_hi_unsigned(f2)
  let s8 = cpu.adc(lo6, hi7, k5)
  let k9 = cpu.adc_carry(lo6, hi7, k5)
  let hi10 = f0.mul_hi_unsigned(f3)
  let s11 = cpu.adc(0, hi10, k9)
  let lo12 = f1.wrapping_mul(f2)
  let lo13 = f1.wrapping_mul(f3)
  let hi14 = f1.mul_hi_unsigned(f2)
  let s15 = cpu.adc(lo13, hi14, 0)
  let k16 = cpu.adc_carry(lo13, hi14, 0)
  let hi17 = f1.mul_hi_unsigned(f3)
  let lo18 = f2.wrapping_mul(f3)
  let s19 = cpu.adc(hi17, lo18, k16)
  let k20 = cpu.adc_carry(hi17, lo18, k16)
  let hi21 = f2.mul_hi_unsigned(f3)
  let s22 = cpu.adc(0, hi21, k20)
  let s23 = cpu.adc(s8, lo12, 0)
  let k24 = cpu.adc_carry(s8, lo12, 0)
  let s25 = cpu.adc(s11, s15, k24)
  let k26 = cpu.adc_carry(s11, s15, k24)
  let s27 = cpu.adc(0, s19, k26)
  let k28 = cpu.adc_carry(0, s19, k26)
  let s29 = cpu.adc(0, s22, k28)
  let s30 = cpu.adc(lo1, lo1, 0)
  let k31 = cpu.adc_carry(lo1, lo1, 0)
  let s32 = cpu.adc(s4, s4, k31)
  let k33 = cpu.adc_carry(s4, s4, k31)
  let s34 = cpu.adc(s23, s23, k33)
  let k35 = cpu.adc_carry(s23, s23, k33)
  let s36 = cpu.adc(s25, s25, k35)
  let k37 = cpu.adc_carry(s25, s25, k35)
  let s38 = cpu.adc(s27, s27, k37)
  let k39 = cpu.adc_carry(s27, s27, k37)
  let s40 = cpu.adc(s29, s29, k39)
  let k41 = cpu.adc_carry(s29, s29, k39)
  let lo42 = f0.wrapping_mul(f0)
  let hi43 = f0.mul_hi_unsigned(f0)
  let s44 = cpu.adc(s30, hi43, 0)
  let k45 = cpu.adc_carry(s30, hi43, 0)
  let lo46 = f1.wrapping_mul(f1)
  let s47 = cpu.adc(s32, lo46, k45)
  let k48 = cpu.adc_carry(s32, lo46, k45)
  let hi49 = f1.mul_hi_unsigned(f1)
  let s50 = cpu.adc(s34, hi49, k48)
  let k51 = cpu.adc_carry(s34, hi49, k48)
  let lo52 = f2.wrapping_mul(f2)
  let s53 = cpu.adc(s36, lo52, k51)
  let k54 = cpu.adc_carry(s36, lo52, k51)
  let hi55 = f2.mul_hi_unsigned(f2)
  let s56 = cpu.adc(s38, hi55, k54)
  let k57 = cpu.adc_carry(s38, hi55, k54)
  let lo58 = f3.wrapping_mul(f3)
  let s59 = cpu.adc(s40, lo58, k57)
  let k60 = cpu.adc_carry(s40, lo58, k57)
  let hi61 = f3.mul_hi_unsigned(f3)
  let s62 = cpu.adc(k41, hi61, k60)
  let ql63 = lo42.wrapping_shl(32)
  let qh64 = lo42.shr_logical(32)
  let lo65 = cpu.adc(lo42, ~ql63, 1)
  let k66 = cpu.adc_carry(lo42, ~ql63, 1)
  let hi67 = cpu.adc(lo42, ~qh64, k66)
  let s68 = cpu.adc(s44, ql63, 0)
  let k69 = cpu.adc_carry(s44, ql63, 0)
  let s70 = cpu.adc(s47, qh64, k69)
  let k71 = cpu.adc_carry(s47, qh64, k69)
  let s72 = cpu.adc(s50, lo65, k71)
  let k73 = cpu.adc_carry(s50, lo65, k71)
  let s74 = cpu.adc(0, hi67, k73)
  let ql75 = s68.wrapping_shl(32)
  let qh76 = s68.shr_logical(32)
  let lo77 = cpu.adc(s68, ~ql75, 1)
  let k78 = cpu.adc_carry(s68, ~ql75, 1)
  let hi79 = cpu.adc(s68, ~qh76, k78)
  let s80 = cpu.adc(s70, ql75, 0)
  let k81 = cpu.adc_carry(s70, ql75, 0)
  let s82 = cpu.adc(s72, qh76, k81)
  let k83 = cpu.adc_carry(s72, qh76, k81)
  let s84 = cpu.adc(s74, lo77, k83)
  let k85 = cpu.adc_carry(s74, lo77, k83)
  let s86 = cpu.adc(0, hi79, k85)
  let ql87 = s80.wrapping_shl(32)
  let qh88 = s80.shr_logical(32)
  let lo89 = cpu.adc(s80, ~ql87, 1)
  let k90 = cpu.adc_carry(s80, ~ql87, 1)
  let hi91 = cpu.adc(s80, ~qh88, k90)
  let s92 = cpu.adc(s82, ql87, 0)
  let k93 = cpu.adc_carry(s82, ql87, 0)
  let s94 = cpu.adc(s84, qh88, k93)
  let k95 = cpu.adc_carry(s84, qh88, k93)
  let s96 = cpu.adc(s86, lo89, k95)
  let k97 = cpu.adc_carry(s86, lo89, k95)
  let s98 = cpu.adc(0, hi91, k97)
  let ql99 = s92.wrapping_shl(32)
  let qh100 = s92.shr_logical(32)
  let lo101 = cpu.adc(s92, ~ql99, 1)
  let k102 = cpu.adc_carry(s92, ~ql99, 1)
  let hi103 = cpu.adc(s92, ~qh100, k102)
  let s104 = cpu.adc(s94, ql99, 0)
  let k105 = cpu.adc_carry(s94, ql99, 0)
  let s106 = cpu.adc(s96, qh100, k105)
  let k107 = cpu.adc_carry(s96, qh100, k105)
  let s108 = cpu.adc(s98, lo101, k107)
  let k109 = cpu.adc_carry(s98, lo101, k107)
  let s110 = cpu.adc(0, hi103, k109)
  let s111 = cpu.adc(s104, s53, 0)
  let k112 = cpu.adc_carry(s104, s53, 0)
  let s113 = cpu.adc(s106, s56, k112)
  let k114 = cpu.adc_carry(s106, s56, k112)
  let s115 = cpu.adc(s108, s59, k114)
  let k116 = cpu.adc_carry(s108, s59, k114)
  let s117 = cpu.adc(s110, s62, k116)
  let k118 = cpu.adc_carry(s110, s62, k116)
  sub_p256(h, s111, s113, s115, s117, k118)
}

/// sub_m4 for P-256's p (-1, 2^32 - 1, 0, 2^64 - 2^32 + 1): ~p as
/// constants (0, -2^32, -1, 2^32 - 2), so the body is small enough for
/// the arm64 inliner at every call site (mul4p, sqr4p, add4p). The first
/// limb is t0 + 1 (one adds; t0 + 0 with a carry in was a cmp and an
/// adcs) and the keep mask (c3 | top) - 1 (two instructions, mask_bit of
/// its complement was four): add4p went under the inliner's 40 (a P-256
/// handshake on arm64 called it 29,000 times, 2026-10-17).
fn sub_p256(h: Int, t0: Int, t1: Int, t2: Int, t3: Int, top: Int) {
  let d0 = cpu.adc(t0, 1, 0)
  let c0 = cpu.adc_carry(t0, 1, 0)
  let d1 = cpu.adc(t1, -4294967296, c0)
  let c1 = cpu.adc_carry(t1, -4294967296, c0)
  let d2 = cpu.adc(t2, -1, c1)
  let c2 = cpu.adc_carry(t2, -1, c1)
  let d3 = cpu.adc(t3, 4294967294, c2)
  let c3 = cpu.adc_carry(t3, 4294967294, c2)
  // all ones when t < p (no carry out of t - p, none in top): keep t
  let keep = ct.barrier((c3 | top).wrapping_sub(1))
  rt.mem_store(h, 0, d0 ^ (keep & (t0 ^ d0)), 8)
  rt.mem_store(h, 8, d1 ^ (keep & (t1 ^ d1)), 8)
  rt.mem_store(h, 16, d2 ^ (keep & (t2 ^ d2)), 8)
  rt.mem_store(h, 24, d3 ^ (keep & (t3 ^ d3)), 8)
}

/// h = t - m when t + top 2^256 >= m, else t (4 limbs, top 0 or 1):
/// final_sub on words. t - m as t + ~m + 1, one chain of cpu.adc (an
/// adcs chain on arm64, one instruction; its last carry is 1 when there
/// was no borrow): fewer values than a borrow per limb, so the arm64
/// emitter inlines it, and ~m folds where m is a constant.
fn sub_m4(h: Int, t0: Int, t1: Int, t2: Int, t3: Int, top: Int, m0: Int, m1: Int, m2: Int, m3: Int) {
  let n0 = ~m0
  let n1 = ~m1
  let n2 = ~m2
  let n3 = ~m3
  let d0 = cpu.adc(t0, n0, 1)
  let c0 = cpu.adc_carry(t0, n0, 1)
  let d1 = cpu.adc(t1, n1, c0)
  let c1 = cpu.adc_carry(t1, n1, c0)
  let d2 = cpu.adc(t2, n2, c1)
  let c2 = cpu.adc_carry(t2, n2, c1)
  let d3 = cpu.adc(t3, n3, c2)
  let c3 = cpu.adc_carry(t3, n3, c2)
  // keep t when t < m (a borrow: no carry out) and top is 0; the mask
  // has passed ct.mask_bit's barrier, so the selects use it directly
  // (ct.pick and st as calls would put sub_m4 over the arm64 inliner's
  // block budget)
  let keep = ct.mask_bit((c3 | top) ^ 1)
  rt.mem_store(h, 0, d0 ^ (keep & (t0 ^ d0)), 8)
  rt.mem_store(h, 8, d1 ^ (keep & (t1 ^ d1)), 8)
  rt.mem_store(h, 16, d2 ^ (keep & (t2 ^ d2)), 8)
  rt.mem_store(h, 24, d3 ^ (keep & (t3 ^ d3)), 8)
}

/// add for 4 limbs.
fn add4(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let s0 = f0.wrapping_add(g0)
  let c0 = cpu.carry(f0, g0)
  let u1 = f1.wrapping_add(g1)
  let s1 = u1.wrapping_add(c0)
  let c1 = cpu.carry(f1, g1) | cpu.carry(u1, c0)
  let u2 = f2.wrapping_add(g2)
  let s2 = u2.wrapping_add(c1)
  let c2 = cpu.carry(f2, g2) | cpu.carry(u2, c1)
  let u3 = f3.wrapping_add(g3)
  let s3 = u3.wrapping_add(c2)
  let c3 = cpu.carry(f3, g3) | cpu.carry(u3, c2)
  sub_m4(h, s0, s1, s2, s3, c3, ld(md, MLIMBS), ld(md, MLIMBS + 8), ld(md, MLIMBS + 16), ld(md, MLIMBS + 24))
}

/// sub for 4 limbs: f - g, plus m when it borrowed (under a mask).
fn sub4(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let d0 = f0.wrapping_sub(g0)
  let b0 = cpu.borrow(f0, g0)
  let e1 = f1.wrapping_sub(g1)
  let d1 = e1.wrapping_sub(b0)
  let b1 = cpu.borrow(f1, g1) | cpu.borrow(e1, b0)
  let e2 = f2.wrapping_sub(g2)
  let d2 = e2.wrapping_sub(b1)
  let b2 = cpu.borrow(f2, g2) | cpu.borrow(e2, b1)
  let e3 = f3.wrapping_sub(g3)
  let d3 = e3.wrapping_sub(b2)
  let b3 = cpu.borrow(f3, g3) | cpu.borrow(e3, b2)
  let mask = ct.mask_bit(b3)
  let m0 = ld(md, MLIMBS) & mask
  let m1 = ld(md, MLIMBS + 8) & mask
  let m2 = ld(md, MLIMBS + 16) & mask
  let m3 = ld(md, MLIMBS + 24) & mask
  let s0 = d0.wrapping_add(m0)
  let c0 = cpu.carry(d0, m0)
  let u1 = d1.wrapping_add(m1)
  let s1 = u1.wrapping_add(c0)
  let c1 = cpu.carry(d1, m1) | cpu.carry(u1, c0)
  let u2 = d2.wrapping_add(m2)
  let s2 = u2.wrapping_add(c1)
  let c2 = cpu.carry(d2, m2) | cpu.carry(u2, c1)
  let s3 = d3.wrapping_add(m3).wrapping_add(c2)
  st(h, 0, s0)
  st(h, 8, s1)
  st(h, 16, s2)
  st(h, 24, s3)
}

/// add4 for P-256's field (its limbs as constants).
fn add4p(h: Int, f: Int, g: Int) {
  let f0 = rt.mem_load(f, 0, 8)
  let f1 = rt.mem_load(f, 8, 8)
  let f2 = rt.mem_load(f, 16, 8)
  let f3 = rt.mem_load(f, 24, 8)
  let g0 = rt.mem_load(g, 0, 8)
  let g1 = rt.mem_load(g, 8, 8)
  let g2 = rt.mem_load(g, 16, 8)
  let g3 = rt.mem_load(g, 24, 8)
  let s0 = cpu.adc(f0, g0, 0)
  let c0 = cpu.adc_carry(f0, g0, 0)
  let s1 = cpu.adc(f1, g1, c0)
  let c1 = cpu.adc_carry(f1, g1, c0)
  let s2 = cpu.adc(f2, g2, c1)
  let c2 = cpu.adc_carry(f2, g2, c1)
  let s3 = cpu.adc(f3, g3, c2)
  let c3 = cpu.adc_carry(f3, g3, c2)
  sub_p256(h, s0, s1, s2, s3, c3)
}

/// sub4 for P-256's field (its limbs as constants, under the mask).
fn sub4p(h: Int, f: Int, g: Int) {
  let f0 = rt.mem_load(f, 0, 8)
  let f1 = rt.mem_load(f, 8, 8)
  let f2 = rt.mem_load(f, 16, 8)
  let f3 = rt.mem_load(f, 24, 8)
  let g0 = rt.mem_load(g, 0, 8)
  let g1 = rt.mem_load(g, 8, 8)
  let g2 = rt.mem_load(g, 16, 8)
  let g3 = rt.mem_load(g, 24, 8)
  // f - g as f + ~g + 1, one chain (its last carry is 1 when there
  // was no borrow), then p added under the borrow's mask, one chain
  let d0 = cpu.adc(f0, ~g0, 1)
  let k0 = cpu.adc_carry(f0, ~g0, 1)
  let d1 = cpu.adc(f1, ~g1, k0)
  let k1 = cpu.adc_carry(f1, ~g1, k0)
  let d2 = cpu.adc(f2, ~g2, k1)
  let k2 = cpu.adc_carry(f2, ~g2, k1)
  let d3 = cpu.adc(f3, ~g3, k2)
  let k3 = cpu.adc_carry(f3, ~g3, k2)
  // all ones when f - g borrowed (k3 0): k3 - 1, two instructions
  let mask = ct.barrier(k3.wrapping_sub(1))
  let m1 = 4294967295 & mask
  let m3 = -4294967295 & mask
  let s0 = cpu.adc(d0, mask, 0)
  let c0 = cpu.adc_carry(d0, mask, 0)
  let s1 = cpu.adc(d1, m1, c0)
  let c1 = cpu.adc_carry(d1, m1, c0)
  let s2 = cpu.adc(d2, 0, c1)
  let c2 = cpu.adc_carry(d2, 0, c1)
  let s3 = cpu.adc(d3, m3, c2)
  rt.mem_store(h, 0, s0, 8)
  rt.mem_store(h, 8, s1, 8)
  rt.mem_store(h, 16, s2, 8)
  rt.mem_store(h, 24, s3, 8)
}

