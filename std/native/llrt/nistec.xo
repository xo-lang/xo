  let lo8 = rt.int_wrap(2, f1, g0)
  let hi9 = rt.u64_mul_hi(f1, g0)
  let s12 = rt.int_wrap(0, lo8, hi2)
  let k13 = cpu.carry(lo8, hi2)
  let c14 = rt.int_wrap(0, hi9, k13)
  let lo15 = rt.int_wrap(2, f2, g0)
  let hi16 = rt.u64_mul_hi(f2, g0)
  let s19 = rt.int_wrap(0, lo15, c14)
  let k20 = cpu.carry(lo15, c14)
  let c21 = rt.int_wrap(0, hi16, k20)
  let lo22 = rt.int_wrap(2, f3, g0)
  let hi23 = rt.u64_mul_hi(f3, g0)
  let s26 = rt.int_wrap(0, lo22, c21)
  let k27 = cpu.carry(lo22, c21)
  let c28 = rt.int_wrap(0, hi23, k27)
  let lo29 = rt.int_wrap(2, f4, g0)
  let hi30 = rt.u64_mul_hi(f4, g0)
  let s33 = rt.int_wrap(0, lo29, c28)
  let k34 = cpu.carry(lo29, c28)
  let c35 = rt.int_wrap(0, hi30, k34)
  let lo36 = rt.int_wrap(2, f5, g0)
  let hi37 = rt.u64_mul_hi(f5, g0)
  let s40 = rt.int_wrap(0, lo36, c35)
  let k41 = cpu.carry(lo36, c35)
  let c42 = rt.int_wrap(0, hi37, k41)
  let q45 = rt.int_wrap(2, lo1, inv)
  let lo46 = rt.int_wrap(2, q45, m0)
  let hi47 = rt.u64_mul_hi(q45, m0)
  let k49 = cpu.carry(lo46, lo1)
  let c52 = rt.int_wrap(0, hi47, k49)
  let lo53 = rt.int_wrap(2, q45, m1)
  let hi54 = rt.u64_mul_hi(q45, m1)
  let s55 = rt.int_wrap(0, lo53, s12)
  let k56 = cpu.carry(lo53, s12)
  let s57 = rt.int_wrap(0, s55, c52)
  let k58 = cpu.carry(s55, c52)
  let c59 = rt.int_wrap(0, hi54, rt.int_wrap(0, k56, k58))
  let lo60 = rt.int_wrap(2, q45, m2)
  let hi61 = rt.u64_mul_hi(q45, m2)
  let s62 = rt.int_wrap(0, lo60, s19)
  let k63 = cpu.carry(lo60, s19)
  let s64 = rt.int_wrap(0, s62, c59)
  let k65 = cpu.carry(s62, c59)
  let c66 = rt.int_wrap(0, hi61, rt.int_wrap(0, k63, k65))
  let lo67 = rt.int_wrap(2, q45, m3)
  let hi68 = rt.u64_mul_hi(q45, m3)
  let s69 = rt.int_wrap(0, lo67, s26)
  let k70 = cpu.carry(lo67, s26)
  let s71 = rt.int_wrap(0, s69, c66)
  let k72 = cpu.carry(s69, c66)
  let c73 = rt.int_wrap(0, hi68, rt.int_wrap(0, k70, k72))
  let lo74 = rt.int_wrap(2, q45, m4)
  let hi75 = rt.u64_mul_hi(q45, m4)
  let s76 = rt.int_wrap(0, lo74, s33)
  let k77 = cpu.carry(lo74, s33)
  let s78 = rt.int_wrap(0, s76, c73)
  let k79 = cpu.carry(s76, c73)
  let c80 = rt.int_wrap(0, hi75, rt.int_wrap(0, k77, k79))
  let lo81 = rt.int_wrap(2, q45, m5)
  let hi82 = rt.u64_mul_hi(q45, m5)
  let s83 = rt.int_wrap(0, lo81, s40)
  let k84 = cpu.carry(lo81, s40)
