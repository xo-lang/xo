/// h = t - m when t + top 2^256 >= m, else t (4 limbs, top 0 or 1):
/// final_sub on words.
fn sub_m4(h: Int, t0: Int, t1: Int, t2: Int, t3: Int, top: Int, m0: Int, m1: Int, m2: Int, m3: Int) {
  let d0 = rt.int_wrap(1, t0, m0)
  let b0 = cpu.borrow(t0, m0)
  let e1 = rt.int_wrap(1, t1, m1)
  let d1 = rt.int_wrap(1, e1, b0)
  let b1 = cpu.borrow(t1, m1) | cpu.borrow(e1, b0)
  let e2 = rt.int_wrap(1, t2, m2)
  let d2 = rt.int_wrap(1, e2, b1)
  let b2 = cpu.borrow(t2, m2) | cpu.borrow(e2, b1)
  let e3 = rt.int_wrap(1, t3, m3)
  let d3 = rt.int_wrap(1, e3, b2)
  let b3 = cpu.borrow(t3, m3) | cpu.borrow(e3, b2)
  let keep = ct.mask_bit(b3 & (top ^ 1))
  st(h, 0, ct.pick(keep, t0, d0))
  st(h, 8, ct.pick(keep, t1, d1))
  st(h, 16, ct.pick(keep, t2, d2))
  st(h, 24, ct.pick(keep, t3, d3))
}

/// add for 4 limbs.
fn add4(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let s0 = rt.int_wrap(0, f0, g0)
  let c0 = cpu.carry(f0, g0)
  let u1 = rt.int_wrap(0, f1, g1)
  let s1 = rt.int_wrap(0, u1, c0)
  let c1 = cpu.carry(f1, g1) | cpu.carry(u1, c0)
  let u2 = rt.int_wrap(0, f2, g2)
  let s2 = rt.int_wrap(0, u2, c1)
  let c2 = cpu.carry(f2, g2) | cpu.carry(u2, c1)
  let u3 = rt.int_wrap(0, f3, g3)
  let s3 = rt.int_wrap(0, u3, c2)
  let c3 = cpu.carry(f3, g3) | cpu.carry(u3, c2)
  sub_m4(h, s0, s1, s2, s3, c3, ld(md, MLIMBS), ld(md, MLIMBS + 8), ld(md, MLIMBS + 16), ld(md, MLIMBS + 24))
}

/// sub for 4 limbs: f - g, plus m when it borrowed (under a mask).
fn sub4(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let d0 = rt.int_wrap(1, f0, g0)
  let b0 = cpu.borrow(f0, g0)
  let e1 = rt.int_wrap(1, f1, g1)
  let d1 = rt.int_wrap(1, e1, b0)
  let b1 = cpu.borrow(f1, g1) | cpu.borrow(e1, b0)
  let e2 = rt.int_wrap(1, f2, g2)
  let d2 = rt.int_wrap(1, e2, b1)
  let b2 = cpu.borrow(f2, g2) | cpu.borrow(e2, b1)
  let e3 = rt.int_wrap(1, f3, g3)
  let d3 = rt.int_wrap(1, e3, b2)
  let b3 = cpu.borrow(f3, g3) | cpu.borrow(e3, b2)
  let mask = ct.mask_bit(b3)
  let m0 = ld(md, MLIMBS) & mask
  let m1 = ld(md, MLIMBS + 8) & mask
  let m2 = ld(md, MLIMBS + 16) & mask
  let m3 = ld(md, MLIMBS + 24) & mask
  let s0 = rt.int_wrap(0, d0, m0)
  let c0 = cpu.carry(d0, m0)
  let u1 = rt.int_wrap(0, d1, m1)
  let s1 = rt.int_wrap(0, u1, c0)
  let c1 = cpu.carry(d1, m1) | cpu.carry(u1, c0)
  let u2 = rt.int_wrap(0, d2, m2)
  let s2 = rt.int_wrap(0, u2, c1)
  let c2 = cpu.carry(d2, m2) | cpu.carry(u2, c1)
  let s3 = rt.int_wrap(0, rt.int_wrap(0, d3, m3), c2)
  st(h, 0, s0)
  st(h, 8, s1)
  st(h, 16, s2)
  st(h, 24, s3)
}

/// add4 for P-256's field (its limbs as constants).
fn add4p(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let s0 = rt.int_wrap(0, f0, g0)
  let c0 = cpu.carry(f0, g0)
  let u1 = rt.int_wrap(0, f1, g1)
  let s1 = rt.int_wrap(0, u1, c0)
  let c1 = cpu.carry(f1, g1) | cpu.carry(u1, c0)
  let u2 = rt.int_wrap(0, f2, g2)
  let s2 = rt.int_wrap(0, u2, c1)
  let c2 = cpu.carry(f2, g2) | cpu.carry(u2, c1)
  let u3 = rt.int_wrap(0, f3, g3)
  let s3 = rt.int_wrap(0, u3, c2)
  let c3 = cpu.carry(f3, g3) | cpu.carry(u3, c2)
  sub_m4(h, s0, s1, s2, s3, c3, -1, 4294967295, 0, -4294967295)
}

/// sub4 for P-256's field (its limbs as constants, under the mask).
fn sub4p(h: Int, f: Int, g: Int) {
  let f0 = ld(f, 0)
  let f1 = ld(f, 8)
  let f2 = ld(f, 16)
  let f3 = ld(f, 24)
  let g0 = ld(g, 0)
  let g1 = ld(g, 8)
  let g2 = ld(g, 16)
  let g3 = ld(g, 24)
  let d0 = rt.int_wrap(1, f0, g0)
  let b0 = cpu.borrow(f0, g0)
  let e1 = rt.int_wrap(1, f1, g1)
  let d1 = rt.int_wrap(1, e1, b0)
  let b1 = cpu.borrow(f1, g1) | cpu.borrow(e1, b0)
  let e2 = rt.int_wrap(1, f2, g2)
  let d2 = rt.int_wrap(1, e2, b1)
  let b2 = cpu.borrow(f2, g2) | cpu.borrow(e2, b1)
  let e3 = rt.int_wrap(1, f3, g3)
  let d3 = rt.int_wrap(1, e3, b2)
  let b3 = cpu.borrow(f3, g3) | cpu.borrow(e3, b2)
  let mask = ct.mask_bit(b3)
  let m1 = 4294967295 & mask
  let m3 = -4294967295 & mask
  let s0 = rt.int_wrap(0, d0, mask)
  let c0 = cpu.carry(d0, mask)
  let u1 = rt.int_wrap(0, d1, m1)
  let s1 = rt.int_wrap(0, u1, c0)
  let c1 = cpu.carry(d1, m1) | cpu.carry(u1, c0)
  let s2 = rt.int_wrap(0, d2, c1)
  let c2 = cpu.carry(d2, c1)
  let s3 = rt.int_wrap(0, rt.int_wrap(0, d3, m3), c2)
  st(h, 0, s0)
  st(h, 8, s1)
  st(h, 16, s2)
  st(h, 24, s3)
}

/// mul for 6 limbs (P-384's field and scalars): CIOS unrolled over
/// local words, the same result.
fn mul6(h: Int, f: Int, g: Int, md: Int) {
  let inv = ld(md, MINV)
  let f0 = ld(f, 0)
  let g0 = ld(g, 0)
  let m0 = ld(md, MLIMBS + 0)
  let f1 = ld(f, 8)
  let g1 = ld(g, 8)
  let m1 = ld(md, MLIMBS + 8)
  let f2 = ld(f, 16)
  let g2 = ld(g, 16)
  let m2 = ld(md, MLIMBS + 16)
