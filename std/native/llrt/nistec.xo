  let hi383 = f3.mul_hi_unsigned(g4)
  let s384 = lo382.wrapping_add(s348)
  let k385 = cpu.carry(lo382, s348)
  let s386 = s384.wrapping_add(c381)
  let k387 = cpu.carry(s384, c381)
  let c388 = hi383.wrapping_add(k385.wrapping_add(k387))
  let lo389 = f4.wrapping_mul(g4)
  let hi390 = f4.mul_hi_unsigned(g4)
  let s391 = lo389.wrapping_add(s355)
  let k392 = cpu.carry(lo389, s355)
  let s393 = s391.wrapping_add(c388)
  let k394 = cpu.carry(s391, c388)
  let c395 = hi390.wrapping_add(k392.wrapping_add(k394))
  let lo396 = f5.wrapping_mul(g4)
  let hi397 = f5.mul_hi_unsigned(g4)
  let s398 = lo396.wrapping_add(s358)
  let k399 = cpu.carry(lo396, s358)
  let s400 = s398.wrapping_add(c395)
  let k401 = cpu.carry(s398, c395)
  let c402 = hi397.wrapping_add(k399.wrapping_add(k401))
  let s403 = t360.wrapping_add(c402)
  let k404 = cpu.carry(t360, c402)
  let q405 = s363.wrapping_mul(inv)
  let lo406 = q405.wrapping_mul(m0)
  let hi407 = q405.mul_hi_unsigned(m0)
  let k409 = cpu.carry(lo406, s363)
  let c412 = hi407.wrapping_add(k409)
  let lo413 = q405.wrapping_mul(m1)
  let hi414 = q405.mul_hi_unsigned(m1)
  let s415 = lo413.wrapping_add(s372)
  let k416 = cpu.carry(lo413, s372)
  let s417 = s415.wrapping_add(c412)
  let k418 = cpu.carry(s415, c412)
  let c419 = hi414.wrapping_add(k416.wrapping_add(k418))
  let lo420 = q405.wrapping_mul(m2)
  let hi421 = q405.mul_hi_unsigned(m2)
  let s422 = lo420.wrapping_add(s379)
  let k423 = cpu.carry(lo420, s379)
  let s424 = s422.wrapping_add(c419)
  let k425 = cpu.carry(s422, c419)
  let c426 = hi421.wrapping_add(k423.wrapping_add(k425))
  let lo427 = q405.wrapping_mul(m3)
  let hi428 = q405.mul_hi_unsigned(m3)
  let s429 = lo427.wrapping_add(s386)
  let k430 = cpu.carry(lo427, s386)
  let s431 = s429.wrapping_add(c426)
  let k432 = cpu.carry(s429, c426)
  let c433 = hi428.wrapping_add(k430.wrapping_add(k432))
  let lo434 = q405.wrapping_mul(m4)
  let hi435 = q405.mul_hi_unsigned(m4)
  let s436 = lo434.wrapping_add(s393)
  let k437 = cpu.carry(lo434, s393)
  let s438 = s436.wrapping_add(c433)
  let k439 = cpu.carry(s436, c433)
  let c440 = hi435.wrapping_add(k437.wrapping_add(k439))
  let lo441 = q405.wrapping_mul(m5)
  let hi442 = q405.mul_hi_unsigned(m5)
  let s443 = lo441.wrapping_add(s400)
  let k444 = cpu.carry(lo441, s400)
  let s445 = s443.wrapping_add(c440)
  let k446 = cpu.carry(s443, c440)
  let c447 = hi442.wrapping_add(k444.wrapping_add(k446))
  let s448 = s403.wrapping_add(c447)
  let k449 = cpu.carry(s403, c447)
  let t450 = k404.wrapping_add(k449)
  let lo451 = f0.wrapping_mul(g5)
  let hi452 = f0.mul_hi_unsigned(g5)
  let s453 = lo451.wrapping_add(s417)
  let k454 = cpu.carry(lo451, s417)
  let c457 = hi452.wrapping_add(k454)
  let lo458 = f1.wrapping_mul(g5)
  let hi459 = f1.mul_hi_unsigned(g5)
  let s460 = lo458.wrapping_add(s424)
  let k461 = cpu.carry(lo458, s424)
  let s462 = s460.wrapping_add(c457)
  let k463 = cpu.carry(s460, c457)
  let c464 = hi459.wrapping_add(k461.wrapping_add(k463))
  let lo465 = f2.wrapping_mul(g5)
  let hi466 = f2.mul_hi_unsigned(g5)
  let s467 = lo465.wrapping_add(s431)
  let k468 = cpu.carry(lo465, s431)
  let s469 = s467.wrapping_add(c464)
  let k470 = cpu.carry(s467, c464)
  let c471 = hi466.wrapping_add(k468.wrapping_add(k470))
  let lo472 = f3.wrapping_mul(g5)
  let hi473 = f3.mul_hi_unsigned(g5)
  let s474 = lo472.wrapping_add(s438)
  let k475 = cpu.carry(lo472, s438)
  let s476 = s474.wrapping_add(c471)
  let k477 = cpu.carry(s474, c471)
  let c478 = hi473.wrapping_add(k475.wrapping_add(k477))
  let lo479 = f4.wrapping_mul(g5)
  let hi480 = f4.mul_hi_unsigned(g5)
  let s481 = lo479.wrapping_add(s445)
  let k482 = cpu.carry(lo479, s445)
  let s483 = s481.wrapping_add(c478)
  let k484 = cpu.carry(s481, c478)
  let c485 = hi480.wrapping_add(k482.wrapping_add(k484))
  let lo486 = f5.wrapping_mul(g5)
  let hi487 = f5.mul_hi_unsigned(g5)
  let s488 = lo486.wrapping_add(s448)
  let k489 = cpu.carry(lo486, s448)
  let s490 = s488.wrapping_add(c485)
  let k491 = cpu.carry(s488, c485)
  let c492 = hi487.wrapping_add(k489.wrapping_add(k491))
  let s493 = t450.wrapping_add(c492)
  let k494 = cpu.carry(t450, c492)
  let q495 = s453.wrapping_mul(inv)
  let lo496 = q495.wrapping_mul(m0)
  let hi497 = q495.mul_hi_unsigned(m0)
  let k499 = cpu.carry(lo496, s453)
  let c502 = hi497.wrapping_add(k499)
  let lo503 = q495.wrapping_mul(m1)
  let hi504 = q495.mul_hi_unsigned(m1)
  let s505 = lo503.wrapping_add(s462)
  let k506 = cpu.carry(lo503, s462)
  let s507 = s505.wrapping_add(c502)
  let k508 = cpu.carry(s505, c502)
  let c509 = hi504.wrapping_add(k506.wrapping_add(k508))
  let lo510 = q495.wrapping_mul(m2)
  let hi511 = q495.mul_hi_unsigned(m2)
  let s512 = lo510.wrapping_add(s469)
  let k513 = cpu.carry(lo510, s469)
  let s514 = s512.wrapping_add(c509)
  let k515 = cpu.carry(s512, c509)
  let c516 = hi511.wrapping_add(k513.wrapping_add(k515))
  let lo517 = q495.wrapping_mul(m3)
  let hi518 = q495.mul_hi_unsigned(m3)
  let s519 = lo517.wrapping_add(s476)
  let k520 = cpu.carry(lo517, s476)
  let s521 = s519.wrapping_add(c516)
  let k522 = cpu.carry(s519, c516)
  let c523 = hi518.wrapping_add(k520.wrapping_add(k522))
  let lo524 = q495.wrapping_mul(m4)
  let hi525 = q495.mul_hi_unsigned(m4)
  let s526 = lo524.wrapping_add(s483)
  let k527 = cpu.carry(lo524, s483)
  let s528 = s526.wrapping_add(c523)
  let k529 = cpu.carry(s526, c523)
  let c530 = hi525.wrapping_add(k527.wrapping_add(k529))
  let lo531 = q495.wrapping_mul(m5)
  let hi532 = q495.mul_hi_unsigned(m5)
  let s533 = lo531.wrapping_add(s490)
  let k534 = cpu.carry(lo531, s490)
  let s535 = s533.wrapping_add(c530)
  let k536 = cpu.carry(s533, c530)
  let c537 = hi532.wrapping_add(k534.wrapping_add(k536))
  let s538 = s493.wrapping_add(c537)
  let k539 = cpu.carry(s493, c537)
  let t540 = k494.wrapping_add(k539)
  sub_m6(h, s507, s514, s521, s528, s535, s538, t540, m0, m1, m2, m3, m4, m5)
}

/// h = t - m when t + top 2^384 >= m, else t (6 limbs, top 0 or 1).
fn sub_m6(h: Int, t0: Int, t1: Int, t2: Int, t3: Int, t4: Int, t5: Int, top: Int, m0: Int, m1: Int, m2: Int, m3: Int, m4: Int, m5: Int) {
  let d0 = t0.wrapping_sub(m0)
  let b0 = cpu.borrow(t0, m0)
  let e1 = t1.wrapping_sub(m1)
  let d1 = e1.wrapping_sub(b0)
  let b1 = cpu.borrow(t1, m1) | cpu.borrow(e1, b0)
  let e2 = t2.wrapping_sub(m2)
  let d2 = e2.wrapping_sub(b1)
  let b2 = cpu.borrow(t2, m2) | cpu.borrow(e2, b1)
  let e3 = t3.wrapping_sub(m3)
  let d3 = e3.wrapping_sub(b2)
  let b3 = cpu.borrow(t3, m3) | cpu.borrow(e3, b2)
  let e4 = t4.wrapping_sub(m4)
  let d4 = e4.wrapping_sub(b3)
  let b4 = cpu.borrow(t4, m4) | cpu.borrow(e4, b3)
  let e5 = t5.wrapping_sub(m5)
  let d5 = e5.wrapping_sub(b4)
  let b5 = cpu.borrow(t5, m5) | cpu.borrow(e5, b4)
  let keep = ct.mask_bit(b5 & (top ^ 1))
  st(h, 0, ct.pick(keep, t0, d0))
  st(h, 8, ct.pick(keep, t1, d1))
  st(h, 16, ct.pick(keep, t2, d2))
  st(h, 24, ct.pick(keep, t3, d3))
  st(h, 32, ct.pick(keep, t4, d4))
  st(h, 40, ct.pick(keep, t5, d5))
}

/// add for 6 limbs.
fn add6(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let g0 = ld(g, 0)
  let f1 = ld(f, 8)
  let g1 = ld(g, 8)
  let f2 = ld(f, 16)
  let g2 = ld(g, 16)
  let f3 = ld(f, 24)
  let g3 = ld(g, 24)
  let f4 = ld(f, 32)
  let g4 = ld(g, 32)
  let f5 = ld(f, 40)
  let g5 = ld(g, 40)
  let s0 = f0.wrapping_add(g0)
  let c0 = cpu.carry(f0, g0)
  let u1 = f1.wrapping_add(g1)
  let s1 = u1.wrapping_add(c0)
  let c1 = cpu.carry(f1, g1) | cpu.carry(u1, c0)
  let u2 = f2.wrapping_add(g2)
  let s2 = u2.wrapping_add(c1)
  let c2 = cpu.carry(f2, g2) | cpu.carry(u2, c1)
  let u3 = f3.wrapping_add(g3)
  let s3 = u3.wrapping_add(c2)
  let c3 = cpu.carry(f3, g3) | cpu.carry(u3, c2)
  let u4 = f4.wrapping_add(g4)
  let s4 = u4.wrapping_add(c3)
  let c4 = cpu.carry(f4, g4) | cpu.carry(u4, c3)
  let u5 = f5.wrapping_add(g5)
  let s5 = u5.wrapping_add(c4)
  let c5 = cpu.carry(f5, g5) | cpu.carry(u5, c4)
  sub_m6(h, s0, s1, s2, s3, s4, s5, c5, ld(md, MLIMBS + 0), ld(md, MLIMBS + 8), ld(md, MLIMBS + 16), ld(md, MLIMBS + 24), ld(md, MLIMBS + 32), ld(md, MLIMBS + 40))
}

/// sub for 6 limbs: f - g, plus m when it borrowed (under a mask).
fn sub6(h: Int, f: Int, g: Int, md: Int) {
  let f0 = ld(f, 0)
  let g0 = ld(g, 0)
  let f1 = ld(f, 8)
  let g1 = ld(g, 8)
  let f2 = ld(f, 16)
  let g2 = ld(g, 16)
  let f3 = ld(f, 24)
  let g3 = ld(g, 24)
  let f4 = ld(f, 32)
  let g4 = ld(g, 32)
  let f5 = ld(f, 40)
  let g5 = ld(g, 40)
  let d0 = f0.wrapping_sub(g0)
  let b0 = cpu.borrow(f0, g0)
  let e1 = f1.wrapping_sub(g1)
  let d1 = e1.wrapping_sub(b0)
  let b1 = cpu.borrow(f1, g1) | cpu.borrow(e1, b0)
  let e2 = f2.wrapping_sub(g2)
  let d2 = e2.wrapping_sub(b1)
  let b2 = cpu.borrow(f2, g2) | cpu.borrow(e2, b1)
  let e3 = f3.wrapping_sub(g3)
  let d3 = e3.wrapping_sub(b2)
  let b3 = cpu.borrow(f3, g3) | cpu.borrow(e3, b2)
  let e4 = f4.wrapping_sub(g4)
  let d4 = e4.wrapping_sub(b3)
  let b4 = cpu.borrow(f4, g4) | cpu.borrow(e4, b3)
  let e5 = f5.wrapping_sub(g5)
  let d5 = e5.wrapping_sub(b4)
  let b5 = cpu.borrow(f5, g5) | cpu.borrow(e5, b4)
  let mask = ct.mask_bit(b5)
  let m0 = ld(md, MLIMBS + 0) & mask
  let m1 = ld(md, MLIMBS + 8) & mask
  let m2 = ld(md, MLIMBS + 16) & mask
  let m3 = ld(md, MLIMBS + 24) & mask
  let m4 = ld(md, MLIMBS + 32) & mask
  let m5 = ld(md, MLIMBS + 40) & mask
  let s0 = d0.wrapping_add(m0)
  let c0 = cpu.carry(d0, m0)
  let u1 = d1.wrapping_add(m1)
  let s1 = u1.wrapping_add(c0)
  let c1 = cpu.carry(d1, m1) | cpu.carry(u1, c0)
  let u2 = d2.wrapping_add(m2)
  let s2 = u2.wrapping_add(c1)
  let c2 = cpu.carry(d2, m2) | cpu.carry(u2, c1)
  let u3 = d3.wrapping_add(m3)
  let s3 = u3.wrapping_add(c2)
  let c3 = cpu.carry(d3, m3) | cpu.carry(u3, c2)
  let u4 = d4.wrapping_add(m4)
  let s4 = u4.wrapping_add(c3)
  let c4 = cpu.carry(d4, m4) | cpu.carry(u4, c3)
  let s5 = d5.wrapping_add(m5).wrapping_add(c4)
  st(h, 0, s0)
  st(h, 8, s1)
  st(h, 16, s2)
  st(h, 24, s3)
  st(h, 32, s4)
  st(h, 40, s5)
}

/// h = f + g mod m.
fn add(c: Int, h: Int, f: Int, g: Int, md: Int) {
  let n = limbs(c)
  if n == 4 {
    add4(h, f, g, md)
    return
  }
  if n == 6 {
    add6(h, f, g, md)
    return
  }
  let t = at(c, TMPW)
  var cy = 0
  var i = 0
  while i < n {
    cy = adc(t, 8 * i, ld(f, 8 * i), ld(g, 8 * i), cy)
    i += 1
  }
  final_sub(c, h, t, md, cy)
}

/// h = f - g mod m.
fn sub(c: Int, h: Int, f: Int, g: Int, md: Int) {
  let n = limbs(c)
  if n == 4 {
    sub4(h, f, g, md)
    return
  }
  if n == 6 {
    sub6(h, f, g, md)
    return
  }
  let t = at(c, TMPW)
  var b = 0
  var i = 0
  while i < n {
    b = sbb(t, 8 * i, ld(f, 8 * i), ld(g, 8 * i), b)
    i += 1
  }
  let mask = ct.mask_bit(b)
  var cy = 0
  i = 0
  while i < n {
    cy = adc(h, 8 * i, ld(t, 8 * i), ld(md, MLIMBS + 8 * i) & mask, cy)
    i += 1
  }
}

/// h = f^e (Montgomery), e the address of L words, a public exponent:
/// a fixed window of 4 bits from the top over a table of f^1 to f^15,
/// the same steps for every f (the window's digits are the public
/// exponent's).
fn pow(c: Int, h: Int, f: Int, e: Int, md: Int) {
  let n = limbs(c)
  let tab = at(c, POWT)
  copy(c, tab, f)
  var i = 1
  while i < 15 {
    mul(c, at(tab, ES * i), at(tab, ES * (i - 1)), f, md)
    i += 1
  }
  let acc = at(c, PW)
  copy(c, acc, at(md, MONE))
  var started = false
  var w = 16 * n - 1
  while w >= 0 {
    if started {
      mul(c, acc, acc, acc, md)
      mul(c, acc, acc, acc, md)
      mul(c, acc, acc, acc, md)
      mul(c, acc, acc, acc, md)
    }
    let d = ld(e, 8 * (w / 16)).shr_logical(4 * (w % 16)) & 15
    if d != 0 {
      if started {
        mul(c, acc, acc, at(tab, ES * (d - 1)), md)
      } else {
        copy(c, acc, at(tab, ES * (d - 1)))
        started = true
      }
    }
    w -= 1
  }
  copy(c, h, acc)
}

/// k squarings of z in place.
fn sqn(c: Int, z: Int, k: Int, md: Int) {
  var i = 0
  while i < k {
    mul(c, z, z, z, md)
    i += 1
  }
}

/// h = 1/f in P-256's field: f^(p-2) by Go's addition chain (p256Invert,
/// from mmcloughlin/addchain: 255 squarings and 12 multiplications).
fn inv_p256(c: Int, h: Int, f: Int) {
  let mp = at(c, MP)
  let t = at(c, POWT)
  let x11 = t
  let x111 = at(t, ES)
  let x111111 = at(t, 2 * ES)
  let x15 = at(t, 3 * ES)
  let x16 = at(t, 4 * ES)
  let x47 = at(t, 5 * ES)
  let z = at(t, 6 * ES)
  let u = at(t, 7 * ES)
  // _11 = f^3, _111 = f^7
  mul(c, x11, f, f, mp)
  mul(c, x11, x11, f, mp)
  mul(c, x111, x11, x11, mp)
  mul(c, x111, x111, f, mp)
  // _111111 = _111 << 3 + _111
  copy(c, u, x111)
  sqn(c, u, 3, mp)
  mul(c, x111111, x111, u, mp)
  // x12 = _111111 << 6 + _111111; x15 = x12 << 3 + _111
  copy(c, u, x111111)
  sqn(c, u, 6, mp)
  mul(c, u, u, x111111, mp)
  sqn(c, u, 3, mp)
  mul(c, x15, u, x111, mp)
  // x16 = 2 x15 + 1; x32 = x16 << 16 + x16
  mul(c, x16, x15, x15, mp)
  mul(c, x16, x16, f, mp)
  copy(c, u, x16)
  sqn(c, u, 16, mp)
  mul(c, u, u, x16, mp)
  // i53 = x32 << 15; x47 = x15 + i53
  sqn(c, u, 15, mp)
  mul(c, x47, x15, u, mp)
  // ((i53 << 17 + 1) << 143 + x47) << 47, then (x47 + that) << 2 + 1
  copy(c, z, u)
  sqn(c, z, 17, mp)
  mul(c, z, z, f, mp)
  sqn(c, z, 143, mp)
  mul(c, z, z, x47, mp)
  sqn(c, z, 47, mp)
  mul(c, z, z, x47, mp)
  sqn(c, z, 2, mp)
  mul(c, h, z, f, mp)
}

/// h = 1/f (Montgomery; 0 for 0).
fn inv(c: Int, h: Int, f: Int, md: Int) {
  if csize(c) == 32 && md == at(c, MP) {
    inv_p256(c, h, f)
    return
  }
  pow(c, h, f, at(md, ME2), md)
}

fn copy(c: Int, h: Int, f: Int) { rt.mem_copy(h, f, 8 * limbs(c)) }

fn set_zero(c: Int, h: Int) { rt.mem_set(h, 0, 8 * limbs(c)) }

/// Whether f is 0 (a mask).
fn is_zero(c: Int, f: Int) -> Int {
  let n = limbs(c)
  var x = 0
  var i = 0
  while i < n {
    x = x | ld(f, 8 * i)
    i += 1
  }
  ~ct.mask_nonzero(x)
}

/// Whether f < m (a mask).
fn below(c: Int, f: Int, md: Int) -> Int {
  let n = limbs(c)
  let d = at(c, DIFF)
  var b = 0
  var i = 0
  while i < n {
    b = sbb(d, 8 * i, ld(f, 8 * i), ld(md, MLIMBS + 8 * i), b)
    i += 1
  }
  ct.mask_bit(b)
}

/// Whether f and g are equal (public values).
fn same(c: Int, f: Int, g: Int) -> Bool { raw.mem_eq(f, g, 8 * limbs(c)) }

fn to_mont(c: Int, h: Int, f: Int, md: Int) { mul(c, h, f, at(md, MRR), md) }

fn from_mont(c: Int, h: Int, f: Int, md: Int) { mul(c, h, f, at(c, ONE1), md) }

// ---------------------------------------------------------------------------
// Bytes

/// h = the big endian integer of the csize(c) bytes of b from off (the
/// top limb short of 8 bytes on P-521 and P-224).
fn load(c: Int, h: Int, b: Bytes, off: Int) {
  let n = limbs(c)
  let sz = csize(c)
  var i = 0
  while i < n {
    let lo = off + sz - 8 * (i + 1)
    if lo >= off {
      st(h, 8 * i, rt.bytes_word(b, lo).swap_bytes())
    } else {
      var v = 0
      var j = off
      while j < lo + 8 {
        v = v.wrapping_shl(8) | Int(b[j])
        j += 1
      }
      st(h, 8 * i, v)
    }
    i += 1
  }
}

/// s with the csize(c) big endian bytes of f.
fn put(c: Int, s: Str, f: Int) -> Str {
  var out = s
  let n = limbs(c)
  var top = csize(c) - 8 * (n - 1)
  var i = n - 1
  while i >= 0 {
    if top < 8 {
      let v = ld(f, 8 * i)
      var j = top - 1
      while j >= 0 {
        out = rt.rs_push_byte(out, v.shr_logical(8 * j) & 255)
        j -= 1
      }
      top = 8
    } else {
      out = rt.rs_push_word(out, ld(f, 8 * i).swap_bytes(), 8)
    }
    i -= 1
  }
  out
}

fn hexval(ch: Int) -> Int {
  if ch >= 97 {
    return ch - 87
  }
  ch - 48
}

/// h = the integer of the hex digits of s (16 L of them).
fn set_hex(c: Int, h: Int, s: Str) {
  let n = limbs(c)
  var i = 0
  while i < n {
    var v = 0
    var k = 0
    while k < 16 {
      v = v.wrapping_shl(4) | hexval(raw.str_byte(s, 16 * (n - 1 - i) + k))
      k += 1
    }
    st(h, 8 * i, v)
    i += 1
  }
}

// ---------------------------------------------------------------------------
// The curve

/// Fills m's block from its hex digits: -m^-1 mod 2^64 (Newton's
/// iteration doubles the correct low bits of 1/m0 each step), R mod m
/// (2^(64L) - m when m is above 2^(64L - 1), else 1 doubled 64 L times:
/// P-521 and P-224), R^2 mod m by 64 L doublings, and m - 2.
fn modulus(c: Int, md: Int, hex: Str) {
  let n = limbs(c)
  let m = at(md, MLIMBS)
  set_hex(c, m, hex)
  let m0 = ld(m, 0)
  var y = 1
  for _ in 0..6 {
    y = y.wrapping_mul((2).wrapping_sub(m0.wrapping_mul(y)))
  }
  st(md, MINV, (0).wrapping_sub(y))
  let one = at(md, MONE)
  var b = 0
  var i = 0
  if ld(m, 8 * (n - 1)) < 0 {
    while i < n {
      b = sbb(one, 8 * i, 0, ld(m, 8 * i), b)
      i += 1
    }
  } else {
    set_zero(c, one)
    st(one, 0, 1)
    for _ in 0..64 * n {
      add(c, one, one, one, md)
    }
  }
  let rr = at(md, MRR)
  copy(c, rr, one)
  for _ in 0..64 * n {
    add(c, rr, rr, rr, md)
  }
  let e2 = at(md, ME2)
  b = 2
  i = 0
  while i < n {
    b = sbb(e2, 8 * i, ld(m, 8 * i), b, 0)
    i += 1
  }
}

/// A new workspace for the curve: its moduli, b, and the base point.
fn workspace(curve: Int) -> List[Int] {
  let w = raw.zero_ints(WSIZE)
  let c = rt.obj_addr(w).wrapping_add(rt.layout(2))
  let mp = at(c, MP)
  st(c, SZW, size(curve))
  if curve == P521 {
    st(c, 0, 9)
    modulus(c, mp, "00000000000001ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    modulus(c, at(c, MN), "00000000000001fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffa51868783bf2f966b7fcc0148f709a5d03bb5c9b8899c47aebb6fb71e91386409")
    set_hex(c, at(c, CB), "0000000000000051953eb9618e1c9a1f929a21a0b68540eea2da725b99b315f3b8b489918ef109e156193951ec7e937b1652c0bd3bb1bf073573df883d2c34f1ef451fd46b503f00")
    set_hex(c, at(c, PG), "00000000000000c6858e06b70404e9cd9e3ecb662395b4429c648139053fb521f828af606b4d3dbaa14b5e77efe75928fe1dc127a2ffa8de3348b3c1856a429bf97e7e31c2e5bd66")
    set_hex(c, at(c, PG + ES), "000000000000011839296a789a3bc0045c8a5fb42c7d1bd998f54449579b446817afbd17273e662c97ee72995ef42640c550b9013fad0761353c7086a272c24088be94769fd16650")
  } else if curve == P224 {
    st(c, 0, 4)
    modulus(c, mp, "00000000ffffffffffffffffffffffffffffffff000000000000000000000001")
    modulus(c, at(c, MN), "00000000ffffffffffffffffffffffffffff16a2e0b8f03e13dd29455c5c2a3d")
    set_hex(c, at(c, CB), "00000000b4050a850c04b3abf54132565044b0b7d7bfd8ba270b39432355ffb4")
    set_hex(c, at(c, PG), "00000000b70e0cbd6bb4bf7f321390b94a03c1d356c21122343280d6115c1d21")
    set_hex(c, at(c, PG + ES), "00000000bd376388b5f723fb4c22dfe6cd4375a05a07476444d5819985007e34")
  } else if curve == P384 {
    st(c, 0, 6)
    modulus(c, mp, "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff")
    modulus(c, at(c, MN), "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973")
    set_hex(c, at(c, CB), "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef")
    set_hex(c, at(c, PG), "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7")
    set_hex(c, at(c, PG + ES), "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")
  } else {
    st(c, 0, 4)
    modulus(c, mp, "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff")
    modulus(c, at(c, MN), "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")
    set_hex(c, at(c, CB), "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b")
    set_hex(c, at(c, PG), "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296")
    set_hex(c, at(c, PG + ES), "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")
  }
  st(c, ONE1, 1)
  to_mont(c, at(c, CB), at(c, CB), mp)
  to_mont(c, at(c, PG), at(c, PG), mp)
  to_mont(c, at(c, PG + ES), at(c, PG + ES), mp)
  copy(c, at(c, PG + 2 * ES), at(mp, MONE))
  w
}

fn base(w: List[Int]) -> Int { rt.obj_addr(w).wrapping_add(rt.layout(2)) }

/// A use of the workspace after its last raw access (ed25519.xo's keep).
fn keep(w: List[Int]) {
  if w.len() < 0 {
    return
  }
}

// ---------------------------------------------------------------------------
// Points (r may be p or q)

/// r = p + q (complete: any two points, the identity, p = q).
fn pt_add(c: Int, r: Int, p: Int, q: Int) {
  if csize(c) == 32 {
    pt_add256(c, r, p, q)
    return
  }
  let mp = at(c, MP)
  let b = at(c, CB)
  let t0 = at(c, T0)
  let t1 = at(c, T0 + ES)
  let t2 = at(c, T0 + 2 * ES)
  let t3 = at(c, T0 + 3 * ES)
  let t4 = at(c, T0 + 4 * ES)
  let x3 = at(c, T0 + 5 * ES)
  let y3 = at(c, T0 + 6 * ES)
  let z3 = at(c, T0 + 7 * ES)
  let x1 = p
  let y1 = at(p, ES)
  let z1 = at(p, 2 * ES)
  let x2 = q
  let y2 = at(q, ES)
  let z2 = at(q, 2 * ES)
  mul(c, t0, x1, x2, mp)
  mul(c, t1, y1, y2, mp)
  mul(c, t2, z1, z2, mp)
  add(c, t3, x1, y1, mp)
  add(c, t4, x2, y2, mp)
  mul(c, t3, t3, t4, mp)
  add(c, t4, t0, t1, mp)
  sub(c, t3, t3, t4, mp)
  add(c, t4, y1, z1, mp)
  add(c, x3, y2, z2, mp)
  mul(c, t4, t4, x3, mp)
  add(c, x3, t1, t2, mp)
  sub(c, t4, t4, x3, mp)
  add(c, x3, x1, z1, mp)
  add(c, y3, x2, z2, mp)
  mul(c, x3, x3, y3, mp)
  add(c, y3, t0, t2, mp)
  sub(c, y3, x3, y3, mp)
  mul(c, z3, b, t2, mp)
  sub(c, x3, y3, z3, mp)
  add(c, z3, x3, x3, mp)
  add(c, x3, x3, z3, mp)
  sub(c, z3, t1, x3, mp)
  add(c, x3, t1, x3, mp)
  mul(c, y3, b, y3, mp)
  add(c, t1, t2, t2, mp)
  add(c, t2, t1, t2, mp)
  sub(c, y3, y3, t2, mp)
  sub(c, y3, y3, t0, mp)
  add(c, t1, y3, y3, mp)
  add(c, y3, t1, y3, mp)
  add(c, t1, t0, t0, mp)
  add(c, t0, t1, t0, mp)
  sub(c, t0, t0, t2, mp)
  mul(c, t1, t4, y3, mp)
  mul(c, t2, t0, y3, mp)
  mul(c, y3, x3, z3, mp)
  add(c, y3, y3, t2, mp)
  mul(c, x3, t3, x3, mp)
  sub(c, x3, x3, t1, mp)
  mul(c, z3, t4, z3, mp)
  mul(c, t1, t3, t0, mp)
  add(c, z3, z3, t1, mp)
  copy(c, r, x3)
  copy(c, at(r, ES), y3)
  copy(c, at(r, 2 * ES), z3)
}

/// r = 2p (Go's nistec Double: Renes, Costello and Batina's algorithm 6
/// for a = -3, complete; r may be p).
fn pt_double(c: Int, r: Int, p: Int) {
  if csize(c) == 32 {
    pt_double256(c, r, p)
    return
  }
  let mp = at(c, MP)
  let b = at(c, CB)
  let t0 = at(c, T0)
  let t1 = at(c, T0 + ES)
  let t2 = at(c, T0 + 2 * ES)
  let t3 = at(c, T0 + 3 * ES)
  let x3 = at(c, T0 + 5 * ES)
  let y3 = at(c, T0 + 6 * ES)
  let z3 = at(c, T0 + 7 * ES)
  let x = p
  let y = at(p, ES)
  let z = at(p, 2 * ES)
  mul(c, t0, x, x, mp)
  mul(c, t1, y, y, mp)
  mul(c, t2, z, z, mp)
  mul(c, t3, x, y, mp)
  add(c, t3, t3, t3, mp)
  mul(c, z3, x, z, mp)
  add(c, z3, z3, z3, mp)
  mul(c, y3, b, t2, mp)
  sub(c, y3, y3, z3, mp)
  add(c, x3, y3, y3, mp)
  add(c, y3, x3, y3, mp)
  sub(c, x3, t1, y3, mp)
  add(c, y3, t1, y3, mp)
  mul(c, y3, x3, y3, mp)
  mul(c, x3, x3, t3, mp)
  add(c, t3, t2, t2, mp)
  add(c, t2, t2, t3, mp)
  mul(c, z3, b, z3, mp)
  sub(c, z3, z3, t2, mp)
  sub(c, z3, z3, t0, mp)
  add(c, t3, z3, z3, mp)
  add(c, z3, z3, t3, mp)
  add(c, t3, t0, t0, mp)
  add(c, t0, t3, t0, mp)
  sub(c, t0, t0, t2, mp)
  mul(c, t0, t0, z3, mp)
  add(c, y3, y3, t0, mp)
  mul(c, t0, y, z, mp)
  add(c, t0, t0, t0, mp)
  mul(c, z3, t0, z3, mp)
  sub(c, x3, x3, z3, mp)
  mul(c, z3, t0, t1, mp)
  add(c, z3, z3, z3, mp)
  add(c, z3, z3, z3, mp)
  copy(c, r, x3)
  copy(c, at(r, ES), y3)
  copy(c, at(r, 2 * ES), z3)
}

/// pt_add on P-256: the same formula on the 4 limb field functions
/// with the prime's limbs as constants (no dispatch per operation).
fn pt_add256(c: Int, r: Int, p: Int, q: Int) {
  let b = at(c, CB)
  let t0 = at(c, T0)
  let t1 = at(c, T0 + ES)
  let t2 = at(c, T0 + 2 * ES)
  let t3 = at(c, T0 + 3 * ES)
  let t4 = at(c, T0 + 4 * ES)
  let x3 = at(c, T0 + 5 * ES)
  let y3 = at(c, T0 + 6 * ES)
  let z3 = at(c, T0 + 7 * ES)
  let x1 = p
  let y1 = at(p, ES)
  let z1 = at(p, 2 * ES)
  let x2 = q
  let y2 = at(q, ES)
  let z2 = at(q, 2 * ES)
  mul4p(t0, x1, x2)
  mul4p(t1, y1, y2)
  mul4p(t2, z1, z2)
  add4p(t3, x1, y1)
  add4p(t4, x2, y2)
  mul4p(t3, t3, t4)
  add4p(t4, t0, t1)
  sub4p(t3, t3, t4)
  add4p(t4, y1, z1)
  add4p(x3, y2, z2)
  mul4p(t4, t4, x3)
  add4p(x3, t1, t2)
  sub4p(t4, t4, x3)
  add4p(x3, x1, z1)
  add4p(y3, x2, z2)
  mul4p(x3, x3, y3)
  add4p(y3, t0, t2)
  sub4p(y3, x3, y3)
  mul4p(z3, b, t2)
  sub4p(x3, y3, z3)
  add4p(z3, x3, x3)
  add4p(x3, x3, z3)
  sub4p(z3, t1, x3)
  add4p(x3, t1, x3)
  mul4p(y3, b, y3)
  add4p(t1, t2, t2)
  add4p(t2, t1, t2)
  sub4p(y3, y3, t2)
  sub4p(y3, y3, t0)
  add4p(t1, y3, y3)
  add4p(y3, t1, y3)
  add4p(t1, t0, t0)
  add4p(t0, t1, t0)
  sub4p(t0, t0, t2)
  mul4p(t1, t4, y3)
  mul4p(t2, t0, y3)
  mul4p(y3, x3, z3)
  add4p(y3, y3, t2)
  mul4p(x3, t3, x3)
  sub4p(x3, x3, t1)
  mul4p(z3, t4, z3)
  mul4p(t1, t3, t0)
  add4p(z3, z3, t1)
  rt.mem_copy(r, x3, 32)
  rt.mem_copy(at(r, ES), y3, 32)
  rt.mem_copy(at(r, 2 * ES), z3, 32)
}

/// pt_double on P-256, as pt_add256.
fn pt_double256(c: Int, r: Int, p: Int) {
  let b = at(c, CB)
  let t0 = at(c, T0)
  let t1 = at(c, T0 + ES)
  let t2 = at(c, T0 + 2 * ES)
  let t3 = at(c, T0 + 3 * ES)
  let x3 = at(c, T0 + 5 * ES)
  let y3 = at(c, T0 + 6 * ES)
  let z3 = at(c, T0 + 7 * ES)
  let x = p
  let y = at(p, ES)
  let z = at(p, 2 * ES)
  sqr4p(t0, x)
  sqr4p(t1, y)
  sqr4p(t2, z)
  mul4p(t3, x, y)
  add4p(t3, t3, t3)
  mul4p(z3, x, z)
  add4p(z3, z3, z3)
  mul4p(y3, b, t2)
  sub4p(y3, y3, z3)
  add4p(x3, y3, y3)
  add4p(y3, x3, y3)
  sub4p(x3, t1, y3)
  add4p(y3, t1, y3)
  mul4p(y3, x3, y3)
  mul4p(x3, x3, t3)
  add4p(t3, t2, t2)
  add4p(t2, t2, t3)
  mul4p(z3, b, z3)
  sub4p(z3, z3, t2)
  sub4p(z3, z3, t0)
  add4p(t3, z3, z3)
  add4p(z3, z3, t3)
  add4p(t3, t0, t0)
  add4p(t0, t3, t0)
  sub4p(t0, t0, t2)
  mul4p(t0, t0, z3)
  add4p(y3, y3, t0)
  mul4p(t0, y, z)
  add4p(t0, t0, t0)
  mul4p(z3, t0, z3)
  sub4p(x3, x3, z3)
  mul4p(z3, t0, t1)
  add4p(z3, z3, z3)
  add4p(z3, z3, z3)
  rt.mem_copy(r, x3, 32)
  rt.mem_copy(at(r, ES), y3, 32)
  rt.mem_copy(at(r, 2 * ES), z3, 32)
}

fn pt_identity(c: Int, r: Int) {
  set_zero(c, r)
  copy(c, at(r, ES), at(at(c, MP), MONE))
  set_zero(c, at(r, 2 * ES))
}

/// r = [k]p, k the address of a scalar's L words (normal, below n): a
/// fixed window of 4 bits from the top, each step 4 doublings and the
/// addition of a table entry chosen under a mask from all 16.
fn pt_mul(c: Int, r: Int, p: Int, k: Int) {
  let n = limbs(c)
  let tab = at(c, TABLE)
  pt_identity(c, tab)
  var i = 1
  while i < 16 {
    pt_add(c, at(tab, PS * i), at(tab, PS * (i - 1)), p)
    i += 1
  }
  let acc = at(c, ACC)
  let sel = at(c, SEL)
  pt_identity(c, acc)
  var w = 16 * n - 1
  while w >= 0 {
    if w != 16 * n - 1 {
      pt_double(c, acc, acc)
      pt_double(c, acc, acc)
      pt_double(c, acc, acc)
      pt_double(c, acc, acc)
    }
    let digit = ld(k, 8 * (w / 16)).shr_logical(4 * (w % 16)) & 15
    // the entry of digit under a mask from all 16: each live word (the
    // curve's limbs of each coordinate) the OR of the 16 entries' words
    // under their masks, in registers, one store
    let m0 = ct.mask_eq(0, digit)
    let m1 = ct.mask_eq(1, digit)
    let m2 = ct.mask_eq(2, digit)
    let m3 = ct.mask_eq(3, digit)
    let m4 = ct.mask_eq(4, digit)
    let m5 = ct.mask_eq(5, digit)
    let m6 = ct.mask_eq(6, digit)
    let m7 = ct.mask_eq(7, digit)
    let m8 = ct.mask_eq(8, digit)
    let m9 = ct.mask_eq(9, digit)
    let m10 = ct.mask_eq(10, digit)
    let m11 = ct.mask_eq(11, digit)
    let m12 = ct.mask_eq(12, digit)
    let m13 = ct.mask_eq(13, digit)
    let m14 = ct.mask_eq(14, digit)
    let m15 = ct.mask_eq(15, digit)
    var q = 0
    while q < 3 * ES {
      var l = 0
      while l < 8 * n {
        let e = tab.wrapping_add(q.wrapping_add(l))
        st(sel, q.wrapping_add(l), (ld(e, 0) & m0) | (ld(e, PS * 1) & m1) | (ld(e, PS * 2) & m2) | (ld(e, PS * 3) & m3) | (ld(e, PS * 4) & m4) | (ld(e, PS * 5) & m5) | (ld(e, PS * 6) & m6) | (ld(e, PS * 7) & m7) | (ld(e, PS * 8) & m8) | (ld(e, PS * 9) & m9) | (ld(e, PS * 10) & m10) | (ld(e, PS * 11) & m11) | (ld(e, PS * 12) & m12) | (ld(e, PS * 13) & m13) | (ld(e, PS * 14) & m14) | (ld(e, PS * 15) & m15))
        l = l.wrapping_add(8)
      }
      q = q.wrapping_add(ES)
    }
    pt_add(c, acc, acc, sel)
    w -= 1
  }
  copy_pt(r, acc)
}

fn copy_pt(r: Int, p: Int) { rt.mem_copy(r, p, PS) }

/// r = [k]G, the curve's base point: P-256's from the compiled in fixed
/// base table (pt_mul_g), P-384's and P-521's from a table made on first
/// use (pt_mul_g_n; P-521's would be 35,370 words: compiled in, it costs
/// every TLS build about 27 s and 2.5 MB), P-224's by pt_mul.
fn pt_mul_base(c: Int, r: Int, k: Int) {
  let n = limbs(c)
  if csize(c) == 32 {
    pt_mul_g(c, r, k)
  } else if n == 6 || n == 9 {
    pt_mul_g_n(c, r, k)
  } else {
    pt_mul(c, r, at(c, PG), k)
  }
}

/// r = [k]G on P-256 from nistec_g256.xo's table of j 16^w G: for each 4
/// bit window w of k, the entry of its digit chosen under a mask from
/// all 15 (the identity for 0) and added with the complete formula, 64
/// additions and no doublings; constant time in k as pt_mul.
fn pt_mul_g(c: Int, r: Int, k: Int) {
  let tb = rt.obj_addr(nistec_g256.G256).wrapping_add(rt.layout(2))
  let one = at(at(c, MP), MONE)
  let acc = at(c, ACC)
  let sel = at(c, SEL)
  pt_identity(c, acc)
  var w = 0
  while w < 64 {
    let digit = ld(k, 8 * (w / 16)).shr_logical(4 * (w % 16)) & 15
    var x0 = 0
    var x1 = 0
    var x2 = 0
    var x3 = 0
    var y0 = 0
    var y1 = 0
    var y2 = 0
    var y3 = 0
    var j = 1
    while j < 16 {
      let m = ct.mask_eq(j, digit)
      let e = at(tb, 64 * (15 * w + j - 1))
      x0 = x0 | (ld(e, 0) & m)
      x1 = x1 | (ld(e, 8) & m)
      x2 = x2 | (ld(e, 16) & m)
      x3 = x3 | (ld(e, 24) & m)
      y0 = y0 | (ld(e, 32) & m)
      y1 = y1 | (ld(e, 40) & m)
      y2 = y2 | (ld(e, 48) & m)
      y3 = y3 | (ld(e, 56) & m)
      j += 1
    }
    // digit 0: the identity (0 : 1 : 0); else (x : y : 1)
    let z = ct.mask_eq(0, digit)
    st(sel, 0, x0)
    st(sel, 8, x1)
    st(sel, 16, x2)
    st(sel, 24, x3)
    st(sel, ES, y0 | (ld(one, 0) & z))
    st(sel, ES + 8, y1 | (ld(one, 8) & z))
    st(sel, ES + 16, y2 | (ld(one, 16) & z))
    st(sel, ES + 24, y3 | (ld(one, 24) & z))
    st(sel, 2 * ES, ld(one, 0) & ~z)
    st(sel, 2 * ES + 8, ld(one, 8) & ~z)
    st(sel, 2 * ES + 16, ld(one, 16) & ~z)
    st(sel, 2 * ES + 24, ld(one, 24) & ~z)
    pt_add(c, acc, acc, sel)
    w += 1
  }
  copy_pt(r, acc)
}

/// r = [k]G on P-384 and P-521 from the curve's fixed base table (gtab):
/// as pt_mul_g, for each 4 bit window w of k (2 csize of them; k is
/// below n), the entry j 16^w G of its digit j chosen under a mask from
/// all 15 (the identity for 0) and added with the complete formula, no
/// doublings; constant time in k as pt_mul.
fn pt_mul_g_n(c: Int, r: Int, k: Int) {
  let n = limbs(c)
  let tb = gtab(c)
  let es = 16 * n
  let one = at(at(c, MP), MONE)
  let acc = at(c, ACC)
  let sel = at(c, SEL)
  pt_identity(c, acc)
  let nw = 2 * csize(c)
  var w = 0
  while w < nw {
    let digit = ld(k, 8 * (w / 16)).shr_logical(4 * (w % 16)) & 15
    rt.mem_set(sel, 0, PS)
    var j = 1
    while j < 16 {
      let m = ct.mask_eq(j, digit)
      let e = at(tb, es * (15 * w + j - 1))
      var i = 0
      while i < n {
        st(sel, 8 * i, ld(sel, 8 * i) | (ld(e, 8 * i) & m))
        st(sel, ES + 8 * i, ld(sel, ES + 8 * i) | (ld(e, 8 * (n + i)) & m))
        i += 1
      }
      j += 1
    }
    // digit 0: the identity (0 : 1 : 0); else (x : y : 1)
    let z = ct.mask_eq(0, digit)
    var q = 0
    while q < n {
      st(sel, ES + 8 * q, ld(sel, ES + 8 * q) | (ld(one, 8 * q) & z))
      st(sel, 2 * ES + 8 * q, ld(one, 8 * q) & ~z)
      q += 1
    }
    pt_add(c, acc, acc, sel)
    w += 1
  }
  copy_pt(r, acc)
}

/// The fixed base table of c's curve (P-384 or P-521): for each window w
/// (2 csize of them) and digit j from 1 to 15, entry 15 w + j - 1 is
/// j 16^w G affine, x then y, n limbs each in the Montgomery domain.
/// Made once per process on first use (nistec_gtab.xo), from public
/// values only.
fn gtab(c: Int) -> Int {
  let n = limbs(c)
  let t = nistec_gtab.get(n)
  if t != 0 {
    return t
  }
  nistec_gtab.publish(n, gtab_make(c))
}

/// gtab's table, made: the points in projective form by additions (j G_w
/// = (j - 1) G_w + G_w, G_(w+1) = 15 G_w + G_w), then affine with one
/// inversion for all (Montgomery's trick: the running products of the
/// Z, inverted once, unwound). Its scratch is its own (rt.heap_large):
/// the workspace's points and elements may hold the caller's values
/// (verify's public key in PA); only pt_add's, mul's and inv's own
/// scratch is used.
fn gtab_make(c: Int) -> Int {
  let n = limbs(c)
  let es = 16 * n
  let el = 8 * n
  let cnt = 30 * csize(c)
  let mp = at(c, MP)
  let t = rt.heap_large(es * cnt)
  let pts = rt.heap_large(PS * (cnt + 1))
  let pre = rt.heap_large(el * (cnt + 3))
  // G_w, after the points
  let gw = at(pts, PS * cnt)
  copy_pt(gw, at(c, PG))
  var i = 0
  while i < cnt {
    if i % 15 == 0 {
      copy_pt(at(pts, PS * i), gw)
    } else {
      pt_add(c, at(pts, PS * i), at(pts, PS * (i - 1)), gw)
    }
    if i % 15 == 14 {
      pt_add(c, gw, at(pts, PS * i), gw)
    }
    i += 1
  }
  // pre[i] = Z_0 ... Z_i; then each Z's inverse from the one inversion
  copy(c, pre, at(pts, 2 * ES))
  i = 1
  while i < cnt {
    mul(c, at(pre, el * i), at(pre, el * (i - 1)), at(at(pts, PS * i), 2 * ES), mp)
    i += 1
  }
  let ia = at(pre, el * cnt)
  let zi = at(pre, el * (cnt + 1))
  let tmp = at(pre, el * (cnt + 2))
  inv(c, ia, at(pre, el * (cnt - 1)), mp)
  i = cnt - 1
  while i >= 0 {
    let p = at(pts, PS * i)
    if i > 0 {
      mul(c, zi, ia, at(pre, el * (i - 1)), mp)
      mul(c, tmp, ia, at(p, 2 * ES), mp)
      copy(c, ia, tmp)
    } else {
      copy(c, zi, ia)
    }
    mul(c, at(t, es * i), p, zi, mp)
    mul(c, at(t, es * i + el), at(p, ES), zi, mp)
    i -= 1
  }
  rt.heap_release(pts - 8)
  rt.heap_release(pre - 8)
  t
}

/// x and y (normal) of p; whether p is not the identity (a mask).
fn pt_affine(c: Int, x: Int, y: Int, p: Int) -> Int {
  let mp = at(c, MP)
  let z = sk(c, 7)
  inv(c, z, at(p, 2 * ES), mp)
  mul(c, x, p, z, mp)
  mul(c, y, at(p, ES), z, mp)
  from_mont(c, x, x, mp)
  from_mont(c, y, y, mp)
  ~is_zero(c, at(p, 2 * ES))
}

/// p = the point of the uncompressed encoding (0x04, x, y) of b (public);
/// whether it is one on the curve.
fn pt_decode(c: Int, p: Int, b: Bytes, curve: Int) -> Bool {
  let sz = size(curve)
  if b.len() != 1 + 2 * sz || b[0] != 4 {
    return false
  }
  let mp = at(c, MP)
  load(c, p, b, 1)
  load(c, at(p, ES), b, 1 + sz)
  if below(c, p, mp) == 0 || below(c, at(p, ES), mp) == 0 {
    return false
  }
  to_mont(c, p, p, mp)
  to_mont(c, at(p, ES), at(p, ES), mp)
  copy(c, at(p, 2 * ES), at(mp, MONE))
  // y^2 = x^3 - 3x + b
  let l = sk(c, 6)
  let r = sk(c, 7)
  let t = at(c, PW)
  mul(c, l, at(p, ES), at(p, ES), mp)
  mul(c, r, p, p, mp)
  mul(c, r, r, p, mp)
  add(c, t, p, p, mp)
  add(c, t, t, p, mp)
  sub(c, r, r, t, mp)
  add(c, r, r, at(c, CB), mp)
  same(c, l, r)
}

/// Whether the scalar of b (size(curve) bytes, big endian) is in [1, n)
/// (it is loaded at k).
fn scalar(c: Int, k: Int, b: Bytes, curve: Int) -> Bool {
  if b.len() != size(curve) {
    return false
  }
  load(c, k, b, 0)
  (below(c, k, at(c, MN)) & ~is_zero(c, k)) != 0
}

/// The uncompressed encoding of the point (x, y) (normal).
fn encode(c: Int, x: Int, y: Int) -> Bytes {
  var s = rt.rs_with_cap(1 + 2 * csize(c))
  s = rt.rs_push_byte(s, 4)
  s = put(c, s, x)
  put(c, s, y).bytes()
}

// ---------------------------------------------------------------------------
// ECDH

/// size(curve) random bytes, P-521's top byte masked to its one bit of
/// the order's 521 (Go's randomPoint and ECDSA nonces: excess bits off,
/// so a candidate is below n half the time, not once in 128).
fn random_scalar(curve: Int) -> Bytes {
  let b = rand.next_bytes(size(curve))
  if curve != P521 {
    return b
  }
  var s = rt.rs_with_cap(b.len())
  s = rt.rs_push_byte(s, Int(b[0]) & 1)
  rt.rs_append_bytes(s, b, 1, b.len(), 0).bytes()
}

/// A new private key: a scalar in [1, n) by rejection sampling from the
/// system's generator (Go's randomPoint), size(curve) bytes.
pub fn generate(curve: Int) -> Bytes {
  let w = workspace(curve)
  let c = base(w)
  while true {
    let b = random_scalar(curve)
    if scalar(c, sk(c, 0), b, curve) {
      keep(w)
      return b
    }
  }
  b""
}

/// The public key (uncompressed point) of the private key priv; empty
/// when priv is not a scalar in [1, n).
pub fn public_key(curve: Int, priv: Bytes) -> Bytes {
  let w = workspace(curve)
  let c = base(w)
  if !scalar(c, sk(c, 0), priv, curve) {
    keep(w)
    return b""
  }
  pt_mul_base(c, at(c, PA), sk(c, 0))
  pt_affine(c, sk(c, 1), sk(c, 2), at(c, PA))
  let out = encode(c, sk(c, 1), sk(c, 2))
  keep(w)
  out
}

/// The shared secret (the x coordinate, size(curve) bytes) of the private
/// key priv and the peer's uncompressed point; none when either is
/// invalid or the product is the identity (crypto/ecdh's ECDH).
pub fn ecdh(curve: Int, priv: Bytes, peer: Bytes) -> Bytes? {
  let w = workspace(curve)
  let c = base(w)
  if !scalar(c, sk(c, 0), priv, curve) || !pt_decode(c, at(c, PA), peer, curve) {
    keep(w)
    return None
  }
  pt_mul(c, at(c, PB), at(c, PA), sk(c, 0))
  let ok = pt_affine(c, sk(c, 1), sk(c, 2), at(c, PB))
  var s = rt.rs_with_cap(csize(c))
  s = put(c, s, sk(c, 1))
  keep(w)
  if ok == 0 {
    return None
  }
  Some(s.bytes())
}

// ---------------------------------------------------------------------------
// ECDSA

/// e = the hash as an integer modulo n (SEC 1 4.1.3 step 5, Go's
/// hashToNat: its leftmost size(curve) bytes, shifted right by the bits
/// they have past n's length: 7 for a hash of 66 bytes or more on P-521).
fn hash_int(c: Int, e: Int, hash: Bytes, curve: Int) {
  let sz = size(curve)
  var s = rt.rs_with_cap(sz)
  var i = 0
  while i < sz - hash.len() {
    s = rt.rs_push_byte(s, 0)
    i += 1
  }
  let k = if hash.len() > sz { sz } else { hash.len() }
  s = rt.rs_append_bytes(s, hash, 0, k, 0)
  load(c, e, s.bytes(), 0)
  if curve == P521 && k == sz {
    // e >>= 7 (public: the hash)
    let n = limbs(c)
    var j = 0
    while j < n {
      let hi = if j + 1 < n { ld(e, 8 * (j + 1)).wrapping_shl(57) } else { 0 }
      st(e, 8 * j, ld(e, 8 * j).shr_logical(7) | hi)
      j += 1
    }
  }
  // e < 2^(8 sz) and below 2n
  let mn = at(c, MN)
  let z = sk(c, 7)
  set_zero(c, z)
  add(c, e, e, z, mn)
}

/// The DER signature (r, s) of hash by the private key priv (a scalar in
/// [1, n); empty otherwise), with a fresh nonce from the system's
/// generator for each attempt.
pub fn sign(curve: Int, priv: Bytes, hash: Bytes) -> Bytes {
  let w = workspace(curve)
  let c = base(w)
  let d = sk(c, 0)
  if !scalar(c, d, priv, curve) {
    keep(w)
    return b""
  }
  let mn = at(c, MN)
  let e = sk(c, 1)
  let k = sk(c, 2)
  let r = sk(c, 3)
  let s = sk(c, 4)
  let t = sk(c, 5)
  hash_int(c, e, hash, curve)
  while true {
    if scalar(c, k, random_scalar(curve), curve) {
      // r = x([k]G) mod n
      pt_mul_base(c, at(c, PA), k)
      pt_affine(c, r, t, at(c, PA))
      set_zero(c, t)
      add(c, r, r, t, mn)
      if is_zero(c, r) == 0 {
        // s = (e + r d) / k mod n
        to_mont(c, t, d, mn)
        mul(c, s, r, t, mn)
        add(c, s, s, e, mn)
        to_mont(c, t, k, mn)
        inv(c, t, t, mn)
        mul(c, s, s, t, mn)
        if is_zero(c, s) == 0 {
          var rb = rt.rs_with_cap(csize(c))
          rb = put(c, rb, r)
          var sb = rt.rs_with_cap(csize(c))
          sb = put(c, sb, s)
          keep(w)
          return der_sig(rb.bytes(), sb.bytes())
        }
      }
    }
  }
  b""
}

/// Whether sig (DER) is a signature of hash by the public key pub (an
/// uncompressed point). Every input is public.
pub fn verify(curve: Int, pub_key: Bytes, hash: Bytes, sig: Bytes) -> Bool {
  let rs = parse_sig(sig, size(curve))
  if rs.len() != 2 {
    return false
  }
  let w = workspace(curve)
  let c = base(w)
  let mn = at(c, MN)
  let r = sk(c, 0)
  let s = sk(c, 1)
  let e = sk(c, 2)
  let u1 = sk(c, 3)
  let u2 = sk(c, 4)
  let x = sk(c, 5)
  if !pt_decode(c, at(c, PA), pub_key, curve) || !scalar(c, r, rs[0], curve) || !scalar(c, s, rs[1], curve) {
    keep(w)
    return false
  }
  hash_int(c, e, hash, curve)
  // w = 1/s; u1 = e w, u2 = r w (normal: one factor is Montgomery)
  to_mont(c, s, s, mn)
  inv(c, s, s, mn)
  mul(c, u1, e, s, mn)
  mul(c, u2, r, s, mn)
  pt_mul_base(c, at(c, PB), u1)
  pt_mul(c, at(c, PC), at(c, PA), u2)
  pt_add(c, at(c, PB), at(c, PB), at(c, PC))
  if pt_affine(c, x, u1, at(c, PB)) == 0 {
    keep(w)
    return false
  }
  set_zero(c, u1)
  add(c, x, x, u1, mn)
  let ok = same(c, x, r)
  keep(w)
  ok
}

/// The two integers of a DER ECDSA-Sig-Value (SEQUENCE of r and s), each
/// left padded to n bytes; empty when sig is not one or an integer is
/// longer than n bytes.
fn parse_sig(sig: Bytes, n: Int) -> List[Bytes] {
  if sig.len() < 2 || sig[0] != 0x30 || Int(sig[1]) >= 128 || Int(sig[1]) != sig.len() - 2 {
    if sig.len() < 3 || sig[0] != 0x30 || sig[1] != 0x81 || Int(sig[2]) < 128 || Int(sig[2]) != sig.len() - 3 {
      return []
    }
  }
  var pos = if sig[1] == 0x81 { 3 } else { 2 }
  var out: List[Bytes] = []
  while pos < sig.len() && out.len() < 3 {
    if pos + 2 > sig.len() || sig[pos] != 2 {
      return []
    }
    let len = Int(sig[pos + 1])
    let lo = pos + 2
    if len == 0 || len >= 128 || lo + len > sig.len() {
      return []
    }
    // minimal and positive
    if Int(sig[lo]) >= 128 || (len > 1 && sig[lo] == 0 && Int(sig[lo + 1]) < 128) {
      return []
    }
    var a = lo
    while a < lo + len - 1 && sig[a] == 0 {
      a += 1
    }
    if lo + len - a > n {
      return []
    }
    var s = rt.rs_with_cap(n)
    var i = 0
    while i < n - (lo + len - a) {
      s = rt.rs_push_byte(s, 0)
      i += 1
    }
    out.push(rt.rs_append_bytes(s, sig, a, lo + len, 0).bytes())
    pos = lo + len
  }
  if out.len() != 2 {
    return []
  }
  out
}

/// The DER ECDSA-Sig-Value of r and s (big endian, n bytes each).
fn der_sig(r: Bytes, s: Bytes) -> Bytes {
  let ri = der_uint(r)
  let si = der_uint(s)
  let n = ri.len() + si.len()
  var out = rt.rs_with_cap(n + 3)
  out = rt.rs_push_byte(out, 0x30)
  if n >= 128 {
    out = rt.rs_push_byte(out, 0x81)
  }
  out = rt.rs_push_byte(out, n)
  out = rt.rs_append_bytes(out, ri, 0, ri.len(), 0)
  rt.rs_append_bytes(out, si, 0, si.len(), 0).bytes()
}

/// The DER INTEGER of the unsigned big endian b (below 128 bytes).
fn der_uint(b: Bytes) -> Bytes {
  var a = 0
  while a < b.len() - 1 && b[a] == 0 {
    a += 1
  }
  let pad = if Int(b[a]) >= 128 { 1 } else { 0 }
  var out = rt.rs_with_cap(2 + pad + b.len() - a)
  out = rt.rs_push_byte(out, 2)
  out = rt.rs_push_byte(out, pad + b.len() - a)
  if pad == 1 {
    out = rt.rs_push_byte(out, 0)
  }
  rt.rs_append_bytes(out, b, a, b.len(), 0).bytes()
}

/// internal.crypto_op's ops of the curve (std/internal.xo; P-224 has
/// public, sign and verify only, as Go's crypto/ecdh has no P-224): `public` the
/// public point of the private key a, `ecdh` the shared secret of the
/// private key a and the point b (empty when either is invalid),
/// `generate` a private key, `sign` the DER signature of the hash b by the
/// private key a, `verify` [1] when c is a signature of the hash b by the
/// point a, else [0]; none for another what.
pub fn op(curve: Int, what: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes? {
  if curve == P224 && what != "public" && what != "sign" && what != "verify" {
    return None
  }
  match what {
    "public" => Some(public_key(curve, a))
    "ecdh" => Some(ecdh(curve, a, b) ?? b"")
    "generate" => Some(generate(curve))
    "sign" => Some(sign(curve, a, b))
    "verify" => Some(flag(verify(curve, a, b, c)))
    "fieldmul" => field_mul(curve, a, b)
    _ => None
  }
}

/// The test op "fieldmul" (TestNistecDiff): mul4p(f, g) then sqr4p(f)
/// (Montgomery products, 32 big endian bytes each) for P-256 field
/// elements f and g (32 big endian bytes); empty for f or g at or above
/// p. mul4p and sqr4p take operands below p only, the bound their
/// accumulators' widths rest on (scripts/gen/nistecmul4p), and every
/// P-256 field value is: pt_decode refuses a coordinate at or above p,
/// the constants are reduced, and add4p, sub4p, mul4p and sqr4p return
/// values below p for operands below p.
fn field_mul(curve: Int, a: Bytes, b: Bytes) -> Bytes? {
  if curve != P256 || a.len() != 32 || b.len() != 32 {
    return None
  }
  let w = workspace(curve)
  let c = base(w)
  let mp = at(c, MP)
  let f = sk(c, 1)
  let g = sk(c, 2)
  let h = sk(c, 3)
  load(c, f, a, 0)
  load(c, g, b, 0)
  if below(c, f, mp) == 0 || below(c, g, mp) == 0 {
    keep(w)
    return Some(b"")
  }
  mul4p(h, f, g)
  var s = rt.rs_with_cap(64)
  s = put(c, s, h)
  sqr4p(h, f)
  s = put(c, s, h)
  keep(w)
  Some(s.bytes())
}

/// [1] or [0].
pub fn flag(x: Bool) -> Bytes { rt.rs_push_byte(rt.rs_with_cap(1), if x { 1 } else { 0 }).bytes() }
