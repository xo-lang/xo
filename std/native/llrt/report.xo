// The report text of native test binaries, written in Xo (decision 0193
// step 5): what a property test's case tells the harness before its body
// runs (std/llrt/xo_testing.c's xo_prop_report). A test binary runs one
// case per process (decision 0120); the harness (cmd/xo nativetest.go,
// selfhost/xo) reads its standard output: an `XO-PROP-CHOICES c1,c2,...`
// line with the generator's choices, an `XO-PROP-INPUT name = value` line
// per input, and while shrinking `XO-PROP-NOT-SMALLER` (exit 3) for a
// case whose choices are not shortlex smaller than the best so far
// (XO_PROP_BEST), which std/rt skips. The generator and XO_PROP_BEST are
// testworld.xo's; the C runtime keeps the write on the real standard
// output and the exit (testworld.write_real, quit).
// Decision 0198 deleted the C path (`XO_LLRT_C=report`).
use native/llrt/scan
use native/llrt/show
use native/llrt/testworld
use native/rt

const MIN_INT: Int = -9223372036854775807 - 1

/// Reports the choices of the generator g and the input text (`name =
/// value` lines) of a property test's case to the harness; exits 3 when
/// shrinking and the choices are not smaller than the best so far.
pub fn prop_report(g: Int, input: Str) {
  let rec = testworld.gen_choices(g)
  var o = rt.rs_append(rt.rs_with_cap(32 + 20 * rec.len() + input.len()), "XO-PROP-CHOICES ")
  var i = 0
  while i < rec.len() {
    if i > 0 {
      // ,
      o = rt.rs_push_byte(o, 44)
    }
    o = show.append_u64(o, rec[i])
    i += 1
  }
  o = rt.rs_push_byte(o, 10)
  // a line per input line; a newline at the end starts no line
  let b = input.bytes()
  let n = b.len()
  var start = 0
  while start < n {
    var end = scan.find(input, "\n", start)
    if end < 0 {
      end = n
    }
    o = rt.rs_push_byte(rt.rs_append_bytes(rt.rs_append(o, "XO-PROP-INPUT "), b, start, end, 0), 10)
    start = end + 1
  }
  testworld.write_real(o)
  let best = testworld.prop_best()
  if best.len() > 0 && !shorter(rec, testworld.choices(best[0])) {
    testworld.write_real("XO-PROP-NOT-SMALLER\n")
    testworld.quit(3)
  }
}

/// a < b as UInt64s.
fn ult(a: Int, b: Int) -> Bool { (a ^ MIN_INT) < (b ^ MIN_INT) }

/// std/rt's shortlexLess(a, b): fewer choices, else the first that
/// differs is smaller.
fn shorter(a: List[Int], b: List[Int]) -> Bool {
  if a.len() != b.len() {
    return a.len() < b.len()
  }
  var i = 0
  while i < a.len() {
    if a[i] != b[i] {
      return ult(a[i], b[i])
    }
    i += 1
  }
  false
}
