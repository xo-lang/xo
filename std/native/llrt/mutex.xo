// Mutex[T] (core 5.4, std.md 2.7; the zero-C audit's B19, decision
// 0229's rules): a readers and writer lock with writers preferred,
// holding its value in a shared list of one. The record is the C's
// xo_mutex (asserted, `mutex.xo M_*`), a handle whose free function
// (the C's mutex_free) releases the value. A context's held Mutexes
// (re-entrant use faults, XO-F004) are the context's C_HELD array.
//
// Generated code calls the exports (cabi.xo mutex_*) directly; the C
// entry points forward for older xo's code.
use native/llrt/layout
use native/llrt/budget
use native/llrt/ctx
use native/llrt/fault
use native/llrt/pool
use native/llrt/raw
use native/llrt/rtstats
use native/llrt/tasks
use native/llrt/tracerec
use native/llrt/sanhook
use native/rt

/// xo_mutex (88 bytes): the header, the lock of the fields below, a
/// writer holds it (a C int), the readers holding it, the writers and
/// readers waiting, the value (a list of one; 0 while a writer has it),
/// the value's drop function, the wait list.
const M_MU = 16
const M_WRITER = 24
const M_READERS = 32
const M_WWAIT = 40
const M_RWAIT = 48
const M_SLOT = 56
const M_DROP = 64
const M_WAITERS = 72
/// Whether a with_read ever took m (1; rlock): only then does a release
/// yield to the writer it woke (wake): the convoy it breaks is readers
/// queued behind a woken writer, and a writers only Mutex paid a task
/// switch per release for nothing (bench/perf/conc mutex 3.4x the CPU)
const M_READ = 88
/// M_READ as a word index (the slot atomics).
const M_READ_W = 11
const M_SIZE = 96
/// The most Mutex takes since its last I/O wait a releasing context may
/// have made and still yield to the writer it woke (wake; ctx.xo
/// C_LOCKS): a server handler takes one or two between socket waits, a
/// lock bound loop thousands
const IO_LOCKS = 8

/// A wait list's first entry, an entry's park, next, writer, and granted
/// (tasks.xo E_*).
const WL_FIRST = layout.WL_FIRST
const E_PARK = layout.E_PARK
const E_NEXT = layout.E_NEXT
const E_WRITER = layout.E_WRITER
/// E_WRITER as a word index (the slot atomics).
const E_WRITER_W = layout.E_WRITER_W
const E_GRANTED = layout.E_GRANTED
/// The word at E_WRITER of a granted reader's entry: writer 0, granted 1.
const GRANTED = 4294967296

/// The thread's worker record's flag that puts the fibers it wakes in
/// its ring, not its next (pool.xo W_NONEXT), and its thread local
/// (sched.xo TLS_W).
const W_NONEXT = layout.W_NONEXT
const TLS_W = 2

const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2
const ACQ_REL = 3

/// The readers word (M_READERS) as a word index, and its writer bit: set
/// while a writer holds m or waits for it, kept so under m's lock by the
/// writers (sync_writer). Readers take and give back their share with one
/// atomic add on the word while the bit is clear, without m's lock (Go's
/// RWMutex readerCount); the bit sends them to the locked path, where
/// writers are preferred and waiting is a cancellation point as before.
const R_W = 4
const R_WRITER = 4611686018427387904
const R_COUNT = 4611686018427387903

/// The readers holding m.
fn readers(m: Int) -> Int { rt.slot_load(m, R_W, ACQUIRE) & R_COUNT }

/// Sets m's writer bit to whether a writer holds or waits for m (m's lock
/// held); the bit's clearing releases the writer's stores (the value) to
/// the readers that then take m without the lock.
fn sync_writer(m: Int) {
  let want = if ld4(m, M_WRITER) != 0 || ld(m, M_WWAIT) > 0 { R_WRITER } else { 0 }
  var old = rt.slot_load(m, R_W, ACQUIRE)
  while (old & R_WRITER) != want && !rt.slot_cas(m, R_W, old, (old & R_COUNT) | want, ACQ_REL) {
    old = rt.slot_load(m, R_W, ACQUIRE)
  }
}

/// Gives back one reader's share of m; the last one out while a writer
/// waits wakes it under m's lock.
fn reader_out(m: Int) {
  let old = rt.slot_add(m, R_W, -1, ACQ_REL)
  if (old & R_WRITER) != 0 && (old & R_COUNT) == 1 {
    pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
    let y = wake(m, false)
    pool.unlock(m + M_MU)
    if y {
      pool.yield_now()
    }
  }
}

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

fn ld4(p: Int, off: Int) -> Int { rt.mem_load(p, off, 4) }

fn st4(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 4) }

/// Wakes a waiter of a Mutex into the waking thread's ring, not its next
/// (mutex_signal): the waker still holds the thread for the rest of its
/// request, and a fiber in next waits for that while the lock sits free;
/// in the ring a spinning worker takes it at once (bench/perf/http p99
/// 900 to 800 us, bench/results/perf-throughput-2026-10-08.md). The wake
/// is direct, never deferred (decision 0077's addendum: a deferred grant
/// held the next waiter 1.3 ms behind a holder that kept computing). A
/// woken writer goes to next instead, and its waker yields to it (wake),
/// unless pool.xo mutex_yield says not to.
fn signal(p: Int) {
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    st(w, W_NONEXT, 1)
  }
  rtstats.count(rtstats.SIG_MUTEX)
  tasks.park_signal(p)
  if w != 0 {
    st(w, W_NONEXT, 0)
  }
}

/// Hands m to every waiting reader (m's lock held, no writer holds m;
/// true when the caller should yield to the first reader, which went to
/// this worker's next under wake's rule for a writer):
/// each is counted in the readers, taken off the list, and marked
/// granted before it is woken, so it runs without taking the lock or
/// checking again. Nothing here touches its entry after the wake up.
fn grant_readers(m: Int) -> Bool {
  let l = m + M_WAITERS
  // the readers this wakes run on this worker for a moment unless it
  // keeps computing (pool.xo GRACE_NS): a reader stolen at once moved to
  // a freshly woken worker without the lock's cache lines (decision
  // 0077's addendum, the known RWMutex gap)
  pool.grace_begin()
  // the readers go to this worker's ring without a wake each, and one
  // wake starts the chain after them (pool.xo batch_wake)
  let w = rt.tlocal_get(TLS_W)
  if w != 0 {
    st(w, W_NONEXT, 2)
  }
  var woke = false
  var yes = false
  let first_next = pool.mutex_yield(ctx.pool()) && (ld(ctx.cur(), ctx.C_LOCKS) <= IO_LOCKS || pool.mutex_yield_always(ctx.pool()))
  var e = ld(l, WL_FIRST)
  while e != 0 {
    let next = ld(e, E_NEXT)
    if ld4(e, E_WRITER) == 0 {
      let p = ld(e, E_PARK)
      tasks.wl_del(l, e)
      let _r = rt.slot_add(m, R_W, 1, ACQ_REL)
      st(m, M_RWAIT, ld(m, M_RWAIT) - 1)
      // granted is the high half of the entry's word at E_WRITER (a
      // reader's writer half is 0): one release store of the word, which
      // the waiter's acquire load pairs with (a fence and a plain store
      // were a race to ThreadSanitizer, decision 0241's addendum)
      rt.slot_store(e, E_WRITER_W, GRANTED, RELEASE)
      if w != 0 {
        rtstats.count(rtstats.SIG_MUTEX)
        if !woke && first_next {
          // the first reader runs next on this worker, the rest queue
          st(w, W_NONEXT, 0)
          tasks.park_signal(p)
          st(w, W_NONEXT, 2)
          yes = true
        } else {
          tasks.park_signal(p)
        }
        woke = true
      } else {
        signal(p)
      }
    }
    e = next
  }
  if w != 0 {
    st(w, W_NONEXT, 0)
    if woke {
      pool.batch_wake(ctx.pool())
    }
  }
  yes
}

/// Wakes the waiters that can take m now (m's lock held), phase fair as
/// Go's RWMutex (xo_rt.c mutex_wake, its comment the measurements):
/// after a writer's release (after_writer) the readers waiting then get
/// the lock together, the next writer waits for them; after the last
/// reader's release (or when no reader waits) the oldest waiting writer
/// is woken. True when the caller should yield to the writer it woke (or
/// to the first reader of a grant, grant_readers)
/// (pool.xo mutex_yield): the writer is in this worker's next and runs at
/// once, where in the ring an idle worker was woken (a futex call) to
/// take it and slept again; only for a releaser that took few locks since
/// its last I/O wait (IO_LOCKS), since a lock bound loop paid a switch
/// per write for nothing (decision 0118's 2026-10-22 addendum and its
/// correction: the Mutex parks stay as many). The caller yields after it
/// let go of m's lock.
fn wake(m: Int, after_writer: Bool) -> Bool {
  if ld4(m, M_WRITER) != 0 || ld(m, M_WAITERS + WL_FIRST) == 0 {
    return false
  }
  if ld(m, M_RWAIT) > 0 && (after_writer || ld(m, M_WWAIT) == 0) {
    return grant_readers(m)
  }
  if ld(m, M_WWAIT) > 0 && readers(m) == 0 {
    var e = ld(m, M_WAITERS + WL_FIRST)
    while e != 0 {
      if ld4(e, E_WRITER) != 0 {
        // a writer already signaled that has not run yet is not signaled
        // again: under m's lock it re-checks the Mutex when it runs, and
        // re-arms its park before it waits again (Xo lang 3's execution
        // trace, 2026-10-16: 200 such wakes of main in 0.16 ms, a lock
        // and stores each)
        let p = ld(e, E_PARK)
        if pool.park_signaled(p) {
          return false
        }
        if rt.slot_load(m, M_READ_W, RELAXED) != 0 && pool.mutex_yield(ctx.pool()) && (ld(ctx.cur(), ctx.C_LOCKS) <= IO_LOCKS || pool.mutex_yield_always(ctx.pool())) {
          rtstats.count(rtstats.SIG_MUTEX)
          tasks.park_signal(p)
          return true
        }
        signal(p)
        return false
      }
      e = ld(e, E_NEXT)
    }
  }
  false
}

/// `Mutex.new(v)` (xo_mutex_new): l is the value in a list of one
/// (consumed), drop its drop function.
pub fn new(l: Int, drop: Int) -> Int {
  let m = tasks.new_handle(M_SIZE, rt.fn_addr("mutex_free"))
  st(m, M_SLOT, l)
  st(m, M_DROP, drop)
  st(m, M_READ, 0)
  m
}

/// Records that the context c holds m, taken by the method whose name is
/// the wn bytes at wp (with, with_read) at the ln bytes at lp; a Mutex
/// the context already holds faults there (XO-F004: re-entrant use would
/// deadlock). The entries (24 bytes: the Mutex, the location's address
/// and length) are a malloc'd array the C frees with the context.
fn held_add(c: Int, m: Int, wp: Int, wn: Int, lp: Int, ln: Int) {
  // the usual case, no Mutex held yet and room for one, calls nothing
  if ld4(c, ctx.C_NHELD) == 0 && ld4(c, ctx.C_CAPHELD) != 0 {
    let e = ld(c, ctx.C_HELD)
    st(e, 0, m)
    st(e, 8, lp)
    st(e, 16, ln)
    st4(c, ctx.C_NHELD, 1)
    return
  }
  held_add_slow(c, m, wp, wn, lp, ln)
}

/// held_add when the context already holds a Mutex or has no room.
fn held_add_slow(c: Int, m: Int, wp: Int, wn: Int, lp: Int, ln: Int) {
  let n = ld4(c, ctx.C_NHELD)
  var a = ld(c, ctx.C_HELD)
  for i in 0..n {
    if ld(a + 24 * i, 0) == m {
      held_fault(a + 24 * i, wp, wn, lp, ln)
    }
  }
  if n == ld4(c, ctx.C_CAPHELD) {
    a = held_grow(c, a)
  }
  let e = a + 24 * n
  st(e, 0, m)
  st(e, 8, lp)
  st(e, 16, ln)
  st4(c, ctx.C_NHELD, n + 1)
}

/// The re-entrant use held_add found, the entry e of the Mutex. Kept out
/// of held_add (and held_grow too) so its fast path saves fewer
/// registers (bench/results/zero-c-perf-sweep-2026-10-15.md).
fn held_fault(e: Int, wp: Int, wn: Int, lp: Int, ln: Int) {
  let prev = raw.str_at(ld(e, 8), ld(e, 16))
  let what = raw.str_at(wp, wn)
  fault.raise_str_at("XO-F004: Mutex.${what} called re-entrantly in one task; the mutex is already held from ${prev}", lp, ln)
}

/// Doubles the held entries of the context c (at least 4), whose array
/// is h, and returns the new array.
fn held_grow(c: Int, h: Int) -> Int {
  let cap = ld4(c, ctx.C_CAPHELD)
  let nc = if cap == 0 { 4 } else { 2 * cap }
  // malloc'd at the block's own address, as the C's realloc kept it
  // (gotchas/heap-large-prefix-not-malloc-address.md)
  let a = raw.c_resize(h, 24 * nc)
  st(c, ctx.C_HELD, a)
  st4(c, ctx.C_CAPHELD, nc)
  a
}

/// Removes m from the Mutexes the context c holds. Releases are usually
/// in the reverse order of the takes, so the search starts at the last
/// entry, which needs no move.
fn held_del(c: Int, m: Int) {
  let n = ld4(c, ctx.C_NHELD)
  let h = ld(c, ctx.C_HELD)
  if n == 1 && ld(h, 0) == m {
    st4(c, ctx.C_NHELD, 0)
    return
  }
  var i = n - 1
  while i >= 0 {
    let e = h + 24 * i
    if ld(e, 0) == m {
      if i != n - 1 {
        rt.mem_copy(e, h + 24 * (n - 1), 24)
      }
      st4(c, ctx.C_NHELD, n - 1)
      return
    }
    i -= 1
  }
}

/// Takes m exclusively for `with` (xo_mutex_lock; waiting is a
/// cancellation point that unwinds) and moves its value out to the
/// caller, who gives it back with unlock. The location is the ln bytes at
/// lp.
pub fn lock(m: Int, lp: Int, ln: Int) -> Int {
  let r = lock_body(m, lp, ln)
  // the last unlock happens before the critical section (decision 0273)
  sanhook.acquire(m)
  r
}

fn lock_body(m: Int, lp: Int, ln: Int) -> Int {
  pool.defer_check()
  let c = ctx.cur()
  let w = "with"
  st(c, ctx.C_LOCKS, ld(c, ctx.C_LOCKS) + 1)
  held_add(c, m, raw.data(w), 4, lp, ln)
  pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
  // the writer bit first, in one atomic step with the readers it sees:
  // a reader adding itself after this goes to the locked path
  var old = rt.slot_load(m, R_W, ACQUIRE)
  while (old & R_WRITER) == 0 && !rt.slot_cas(m, R_W, old, old | R_WRITER, ACQ_REL) {
    old = rt.slot_load(m, R_W, ACQUIRE)
  }
  if ld4(m, M_WRITER) != 0 || readers(m) > 0 {
    st(m, M_WWAIT, ld(m, M_WWAIT) + 1)
    while ld4(m, M_WRITER) != 0 || readers(m) > 0 {
      if tracerec.built() {
        rt.mem_store(c, ctx.C_WHY, tracerec.WHY_MUTEX, 8)
      }
      if !tasks.wl_wait_as(c, m + M_MU, m + M_WAITERS, true, 1) {
        st(m, M_WWAIT, ld(m, M_WWAIT) - 1)
        sync_writer(m)
        // readers held back by this writer, or the next writer (no
        // yield: this task unwinds with its own work to do)
        let _y = wake(m, false)
        pool.unlock(m + M_MU)
        held_del(c, m)
        st4(c, ctx.C_UNWINDING, 1)
        return tasks.empty_list()
      }
    }
    st(m, M_WWAIT, ld(m, M_WWAIT) - 1)
  }
  st4(m, M_WRITER, 1)
  let l = ld(m, M_SLOT)
  st(m, M_SLOT, 0)
  pool.unlock(m + M_MU)
  l
}

/// Gives the value l back and releases m (xo_mutex_unlock).
pub fn unlock(m: Int, l: Int) {
  // the critical section happens before the next lock (decision 0273)
  sanhook.release(m)
  unlock_body(m, l)
}

fn unlock_body(m: Int, l: Int) {
  pool.defer_check()
  pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
  st(m, M_SLOT, l)
  st4(m, M_WRITER, 0)
  sync_writer(m)
  let y = wake(m, true)
  pool.unlock(m + M_MU)
  held_del(ctx.cur(), m)
  if y {
    pool.yield_now()
  }
}

/// Takes m shared for `with_read` (xo_mutex_rlock) and returns its value
/// list, not counted (decision 0334): a writer takes or replaces the list
/// only while no share is held, and the compiler gives the list to exactly
/// one rt.mutex_runlock (ssa conc.xo mutex_with), so the share bounds the
/// reference. A reader that waits is handed m by a writer's release
/// (grant_readers); a cancellation unwinds unless m was handed over first.
pub fn rlock(m: Int, lp: Int, ln: Int) -> Int {
  let r = rlock_body(m, lp, ln)
  // the last unlock happens before the critical section (decision 0273)
  sanhook.acquire(m)
  r
}

fn rlock_body(m: Int, lp: Int, ln: Int) -> Int {
  pool.defer_check()
  let c = ctx.cur()
  let w = "with_read"
  st(c, ctx.C_LOCKS, ld(c, ctx.C_LOCKS) + 1)
  held_add(c, m, raw.data(w), 9, lp, ln)
  if rt.slot_load(m, M_READ_W, RELAXED) == 0 {
    rt.slot_store(m, M_READ_W, 1, RELAXED)
  }
  // no writer holds or waits: the share without m's lock (the add's
  // acquire pairs with the last writer's clearing of the bit)
  if (rt.slot_add(m, R_W, 1, ACQ_REL) & R_WRITER) == 0 {
    return ld(m, M_SLOT)
  }
  // a writer holds or waits: give the add back (the last out wakes it)
  // and take the locked path
  reader_out(m)
  pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
  if ld4(m, M_WRITER) != 0 || ld(m, M_WWAIT) > 0 {
    let e = c + ctx.C_WENT
    st(e, E_PARK, c + ctx.C_PARK)
    st4(e, E_WRITER, 0)
    st4(e, E_GRANTED, 0)
    pool.park_reset(c + ctx.C_PARK)
    tasks.wl_add(m + M_WAITERS, e)
    st(m, M_RWAIT, ld(m, M_RWAIT) + 1)
    pool.unlock(m + M_MU)
    while true {
      if tracerec.built() {
        rt.mem_store(c, ctx.C_WHY, tracerec.WHY_MUTEX, 8)
      }
      tasks.park_wait(c, true)
      if rt.slot_load(e, E_WRITER_W, ACQUIRE) == GRANTED {
        // the last writer set the value under m's lock before the grant,
        // and none can change it while this share is held
        return ld(m, M_SLOT)
      }
      pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
      if ld4(e, E_GRANTED) != 0 {
        break
      }
      if budget.canceled(c) {
        tasks.wl_del(m + M_WAITERS, e)
        st(m, M_RWAIT, ld(m, M_RWAIT) - 1)
        pool.unlock(m + M_MU)
        held_del(c, m)
        st4(c, ctx.C_UNWINDING, 1)
        return tasks.empty_list()
      }
      pool.park_reset(c + ctx.C_PARK)
      pool.unlock(m + M_MU)
    }
  } else {
    let _r = rt.slot_add(m, R_W, 1, ACQ_REL)
  }
  let l = ld(m, M_SLOT)
  pool.unlock(m + M_MU)
  l
}

/// Gives back a reader's share of m (xo_mutex_runlock); its list l was
/// not counted (rlock).
pub fn runlock(m: Int, l: Int) {
  // the critical section happens before the next lock (decision 0273)
  sanhook.release(m)
  runlock_body(m, l)
}

fn runlock_body(m: Int, l: Int) {
  pool.defer_check()
  reader_out(m)
  held_del(ctx.cur(), m)
}

/// A Mutex's free function (mutex_free): its value.
pub fn free(m: Int) {
  tasks.list_release(ld(m, M_SLOT), ld(m, M_DROP))
  tasks.free_handle(m)
}

/// The tasks waiting on mutex m to write (writers) or read, under its
/// lock: std/internal rt_probe's "writers" and "readers" (decision 0241,
/// the handoff test).
pub fn queued(m: Int, writers: Bool) -> Int {
  pool.lock_k(m + M_MU, pool.ST_LOCK_MUTEX)
  let n = rt.mem_load(m, if writers { M_WWAIT } else { M_RWAIT }, 8)
  pool.unlock(m + M_MU)
  n
}
