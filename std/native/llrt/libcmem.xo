// The memory functions of the C library of an XO_NOLIBC build (malloc,
// free, calloc, realloc; the zero-C audit's B04, decision 0230):
// std/native/llrt/cabi_libc.xo exports them under the C names. Since
// 2026-10-15 (the zero-C inventory's rank 10) the same allocator holds
// the runtime's records on every build and OS (rt.heap_large, its
// resize, and rt.heap_release: heap_large below, cabi.xo's exports),
// not the C library's malloc; its mappings and lock word are heapos.xo's
// and pool.xo's, so it runs on Linux, macOS, and Windows. None may fault
// or allocate Xo values (rt.int_wrap for the arithmetic).
use native/llrt/heapos
use native/llrt/pool
use native/rt

// ---------------------------------------------------------------------------
// Memory (xo_nolibc.c's nl_malloc): blocks up to 64 KiB come from free
// lists by power of two size class, carved from 1 MiB regions; larger
// ones are mapped one by one, and a given back mapping is kept for reuse
// (16 of them, 64 MiB at most each: the runtime frees and allocates large
// blocks in loops, a file's contents, and a fresh mapping costs page
// faults every time). A block's 16 byte header keeps its class, or minus
// its mapping's size; the address handed out is 16 byte aligned, as C
// requires of malloc.
//
// This is not alloc.xo's heap: that heap's blocks are 8 byte aligned, and
// it counts every block for the leak check and the resource budgets,
// which the C runtime's records (from malloc for the life of the
// program) must not be (decision 0230).

/// rt.static_word: the address of the C library's state (a mapped page,
/// made by the first use; no static word is free, so the other modules
/// of the C library keep their words here too).
const W_STATE = 63

/// The state's words: the lock (at 0), the words of the other modules
/// (S_ERRS to S_STD's records), the free list heads by class (classes 4
/// to 16, at 8 * class), the current region's next and end addresses,
/// then the kept mappings (address, size) in 16 pairs.
/// libcstr.xo: strerror's table of C strings.
pub const S_ERRS = 8
/// libcio.xo: the environment (envp) and the auxiliary vector _start
/// found.
pub const S_ENV = 16
pub const S_AUXV = 24
/// libcio.xo: the FILE records of stdin, stdout, and stderr (16 bytes
/// each, 416 to 463).
pub const S_STD = 416
const S_CUR = 136
const S_END = 144
const S_BIG = 152
const BIG_N = 16
const STATE_SIZE = 4096

const MIN_SHIFT = 4
const MAX_SHIFT = 16
const REGION = 1048576
const BIG_KEEP_MAX = 67108864
const PAGE = 4096

// slot atomics' orders (rt.xo)
const RELAXED = 0
const ACQUIRE = 1
const RELEASE = 2

fn addw(a: Int, b: Int) -> Int { rt.int_wrap(0, a, b) }

fn subw(a: Int, b: Int) -> Int { rt.int_wrap(1, a, b) }

/// n bytes of zeroed memory mapped from the system (heapos.xo map, which
/// ends the program when the system refuses).
fn map(n: Int) -> Int { heapos.map(n) }

/// The state's address, mapped on the first use (0 when the mapping
/// failed): the first of racing threads to store its page keeps it.
pub fn state() -> Int {
  let w = rt.static_word(W_STATE)
  let s = rt.slot_load(w, 0, ACQUIRE)
  if s != 0 {
    return s
  }
  let m = map(STATE_SIZE)
  if m == 0 {
    return 0
  }
  if rt.slot_cas(w, 0, 0, m, RELEASE) {
    return m
  }
  heapos.unmap(m, STATE_SIZE)
  rt.slot_load(w, 0, ACQUIRE)
}

/// The address of the state's word at off (one of the S_ words), or 0
/// when the state could not be mapped.
pub fn word(off: Int) -> Int {
  let s = state()
  if s == 0 { 0 } else { addw(s, off) }
}

/// Takes the state's lock (its first word).
fn lock(s: Int) {
  if !rt.slot_cas(s, 0, 0, 1, ACQUIRE) {
    // 2 tells the holder to wake a waiter (pool.xo's futex on every OS)
    pool.lock_slow(s)
  }
}

fn unlock(s: Int) {
  if rt.slot_swap(s, 0, 0, RELEASE) == 2 {
    pool.futex_wake(s)
  }
}

/// A kept mapping of total bytes to twice that (lock held), or 0.
fn big_take(s: Int, total: Int) -> Int {
  var i = 0
  while i < BIG_N {
    let e = addw(addw(s, S_BIG), rt.int_wrap(3, i, 4))
    let p = rt.mem_load(e, 0, 8)
    let n = rt.mem_load(e, 8, 8)
    if p != 0 && n >= total && n <= addw(total, total) {
      rt.mem_store(e, 0, 0, 8)
      rt.mem_store(p, 0, subw(0, n), 8)
      return p
    }
    i = addw(i, 1)
  }
  0
}

/// Keeps the mapping h of total bytes (lock held): whether it was kept.
fn big_keep(s: Int, h: Int, total: Int) -> Bool {
  if total > BIG_KEEP_MAX {
    return false
  }
  var i = 0
  while i < BIG_N {
    let e = addw(addw(s, S_BIG), rt.int_wrap(3, i, 4))
    if rt.mem_load(e, 0, 8) == 0 {
      rt.mem_store(e, 0, h, 8)
      rt.mem_store(e, 8, total, 8)
      return true
    }
    i = addw(i, 1)
  }
  false
}

/// malloc(n): a 16 byte aligned block of at least n bytes, or 0.
pub fn malloc(n0: Int) -> Int {
  let n = if n0 == 0 { 1 } else { n0 }
  if addw(n, 16) > rt.int_wrap(3, 1, MAX_SHIFT) {
    let total = addw(n, 16 + PAGE - 1) & (0 - PAGE)
    let s = state()
    var p = 0
    if s != 0 {
      lock(s)
      p = big_take(s, total)
      unlock(s)
    }
    if p == 0 {
      p = map(total)
      if p == 0 {
        return 0
      }
      rt.mem_store(p, 0, subw(0, total), 8)
    }
    return addw(p, 16)
  }
  var c = MIN_SHIFT
  while rt.int_wrap(3, 1, c) < addw(n, 16) {
    c = addw(c, 1)
  }
  let s = state()
  if s == 0 {
    return 0
  }
  lock(s)
  let head = addw(s, rt.int_wrap(3, c, 3))
  var b = rt.mem_load(head, 0, 8)
  if b != 0 {
    rt.mem_store(head, 0, rt.mem_load(b, 0, 8), 8)
  } else {
    let size = rt.int_wrap(3, 1, c)
    var cur = rt.mem_load(s, S_CUR, 8)
    if cur == 0 || subw(rt.mem_load(s, S_END, 8), cur) < size {
      cur = map(REGION)
      if cur == 0 {
        unlock(s)
        return 0
      }
      rt.mem_store(s, S_END, addw(cur, REGION), 8)
    }
    b = cur
    rt.mem_store(s, S_CUR, addw(cur, size), 8)
  }
  unlock(s)
  rt.mem_store(b, 0, c, 8)
  addw(b, 16)
}

/// free(p).
pub fn free(p: Int) {
  if p == 0 {
    return
  }
  let h = subw(p, 16)
  let c = rt.mem_load(h, 0, 8)
  if c < 0 {
    let s = state()
    var kept = false
    if s != 0 {
      lock(s)
      kept = big_keep(s, h, subw(0, c))
      unlock(s)
    }
    if !kept {
      heapos.unmap(h, subw(0, c))
    }
    return
  }
  // a small block came from malloc, so the state exists
  let s = state()
  lock(s)
  let head = addw(s, rt.int_wrap(3, c, 3))
  rt.mem_store(h, 0, rt.mem_load(head, 0, 8), 8)
  rt.mem_store(head, 0, h, 8)
  unlock(s)
}

/// calloc(n, m): n * m zeroed bytes, or 0 (also when the product
/// overflows).
pub fn calloc(n: Int, m: Int) -> Int {
  if rt.u64_mul_hi(n, m) != 0 || rt.int_wrap(2, n, m) < 0 {
    return 0
  }
  let t = rt.int_wrap(2, n, m)
  let p = malloc(t)
  if p != 0 {
    rt.mem_set(p, 0, t)
  }
  p
}

/// realloc(p, n): the block of n bytes with p's first bytes (p given
/// back), or p itself when its class has the room; 0 on failure (p kept).
pub fn realloc(p: Int, n: Int) -> Int {
  if p == 0 {
    return malloc(n)
  }
  let c = rt.mem_load(subw(p, 16), 0, 8)
  let have = if c < 0 { subw(subw(0, c), 16) } else { subw(rt.int_wrap(3, 1, c), 16) }
  if n <= have && c >= 0 {
    return p
  }
  let q = malloc(n)
  if q == 0 {
    return 0
  }
  rt.mem_copy(q, p, if have < n { have } else { n })
  free(p)
  q
}

// ---------------------------------------------------------------------------
// The runtime's records (rt.heap_large): small blocks go through a cache
// per thread (thread local word TLS_CACHE), so the tasks' records on
// many workers do not all take the state's lock (bench/perf/conc pmap
// took 1.54 times as long through the lock alone, 2026-10-15). A cache
// keeps up to CACHE_MAX free blocks per class; an empty class takes
// CACHE_BATCH from the shared lists (or the region) under the lock, a
// full one gives CACHE_BATCH back. A block freed on another thread joins
// that thread's cache. The cache record (8 bytes per class) comes from
// the shared lists at the thread's first record and is never freed (the
// runtime's threads live as long as the program). The C library's
// malloc of an XO_NOLIBC build does not use it: it runs before the
// thread pointer is set.

/// rt.tlocal: the thread's cache record (sched.xo lists the table's
/// words), or 0.
const TLS_CACHE = 14
/// A class's free list head at 16 * class, its count at 16 * class + 8.
const CACHE_SIZE = 288
const CACHE_MAX = 64
const CACHE_BATCH = 32

/// The size class of a small block of n bytes (n + 16 at most 2^MAX_SHIFT).
fn class_of(n: Int) -> Int {
  var c = MIN_SHIFT
  while rt.int_wrap(3, 1, c) < addw(n, 16) {
    c = addw(c, 1)
  }
  c
}

/// The calling thread's cache record, made at its first use (0 when the
/// state cannot be mapped).
fn cache() -> Int {
  let t = rt.tlocal_get(TLS_CACHE)
  if t != 0 {
    return t
  }
  let m = malloc(CACHE_SIZE)
  if m == 0 {
    return 0
  }
  rt.mem_set(m, 0, CACHE_SIZE)
  rt.tlocal_set(TLS_CACHE, m)
  m
}

/// Moves up to CACHE_BATCH blocks of class c into the cache t from the
/// shared list, carving the rest from the region (lock taken here): how
/// many it holds now.
fn refill(t: Int, c: Int) -> Int {
  let s = state()
  if s == 0 {
    return 0
  }
  let size = rt.int_wrap(3, 1, c)
  let slot = addw(t, rt.int_wrap(3, c, 4))
  var got = 0
  lock(s)
  let head = addw(s, rt.int_wrap(3, c, 3))
  while got < CACHE_BATCH {
    var b = rt.mem_load(head, 0, 8)
    if b != 0 {
      rt.mem_store(head, 0, rt.mem_load(b, 0, 8), 8)
    } else {
      var cur = rt.mem_load(s, S_CUR, 8)
      if cur == 0 || subw(rt.mem_load(s, S_END, 8), cur) < size {
        if got > 0 {
          break
        }
        cur = map(REGION)
        rt.mem_store(s, S_END, addw(cur, REGION), 8)
      }
      b = cur
      rt.mem_store(s, S_CUR, addw(cur, size), 8)
    }
    rt.mem_store(b, 0, rt.mem_load(slot, 0, 8), 8)
    rt.mem_store(slot, 0, b, 8)
    got = addw(got, 1)
  }
  unlock(s)
  rt.mem_store(slot, 8, got, 8)
  got
}

/// Gives CACHE_BATCH of the cache t's blocks of class c back to the
/// shared list (lock taken here).
fn drain(t: Int, c: Int) {
  let s = state()
  let slot = addw(t, rt.int_wrap(3, c, 4))
  let head = addw(s, rt.int_wrap(3, c, 3))
  lock(s)
  var k = 0
  while k < CACHE_BATCH {
    let b = rt.mem_load(slot, 0, 8)
    rt.mem_store(slot, 0, rt.mem_load(b, 0, 8), 8)
    rt.mem_store(b, 0, rt.mem_load(head, 0, 8), 8)
    rt.mem_store(head, 0, b, 8)
    k = addw(k, 1)
  }
  unlock(s)
  rt.mem_store(slot, 8, subw(rt.mem_load(slot, 8, 8), CACHE_BATCH), 8)
}

/// malloc through the thread's cache: a 16 byte aligned block of at
/// least n bytes, or 0.
fn malloc_tc(n: Int) -> Int {
  if addw(n, 16) > rt.int_wrap(3, 1, MAX_SHIFT) {
    return malloc(n)
  }
  let t = cache()
  if t == 0 {
    return malloc(n)
  }
  let c = class_of(n)
  let slot = addw(t, rt.int_wrap(3, c, 4))
  if rt.mem_load(slot, 0, 8) == 0 && refill(t, c) == 0 {
    return 0
  }
  let b = rt.mem_load(slot, 0, 8)
  rt.mem_store(slot, 0, rt.mem_load(b, 0, 8), 8)
  rt.mem_store(slot, 8, subw(rt.mem_load(slot, 8, 8), 1), 8)
  rt.mem_store(b, 0, c, 8)
  addw(b, 16)
}

/// free through the thread's cache.
fn free_tc(p: Int) {
  let h = subw(p, 16)
  let c = rt.mem_load(h, 0, 8)
  let t = rt.tlocal_get(TLS_CACHE)
  if c < 0 || t == 0 {
    free(p)
    return
  }
  let slot = addw(t, rt.int_wrap(3, c, 4))
  rt.mem_store(h, 0, rt.mem_load(slot, 0, 8), 8)
  rt.mem_store(slot, 0, h, 8)
  let k = addw(rt.mem_load(slot, 8, 8), 1)
  rt.mem_store(slot, 8, k, 8)
  if k > CACHE_MAX {
    drain(t, c)
  }
}

/// rt.heap_large: a block of n bytes for the runtime's records, its
/// 8 byte prefix minus n (the address after the prefix); the program
/// ends when memory is out (was xo_rt.c's xo_heap_large over malloc).
pub fn heap_large(n: Int) -> Int {
  let b = malloc_tc(addw(n, 8))
  if b == 0 {
    heapos.oom()
  }
  rt.mem_store(b, 0, subw(0, n), 8)
  addw(b, 8)
}

/// rt.heap_large_resize: the block whose prefix is at b made n bytes
/// (its first bytes kept), the address after its prefix.
pub fn heap_large_resize(b: Int, n: Int) -> Int {
  let c = rt.mem_load(subw(b, 16), 0, 8)
  let have = if c < 0 { subw(subw(0, c), 16) } else { subw(rt.int_wrap(3, 1, c), 16) }
  var nb = b
  if addw(n, 8) > have || c < 0 {
    nb = malloc_tc(addw(n, 8))
    if nb != 0 {
      rt.mem_copy(nb, b, if have < addw(n, 8) { have } else { addw(n, 8) })
      free_tc(b)
    }
  }
  if nb == 0 {
    heapos.oom()
  }
  rt.mem_store(nb, 0, subw(0, n), 8)
  addw(nb, 8)
}

/// rt.heap_release: gives back the block whose prefix is at b.
pub fn heap_release(b: Int) { free_tc(b) }

/// getauxval(k): the value of k in the auxiliary vector _start found
/// (libcio.xo start), or 0. No thread local is touched: the main
/// thread's TLS setup reads AT_PHDR before its thread pointer is set.
pub fn auxval(k: Int) -> Int {
  let w = word(S_AUXV)
  if w == 0 {
    return 0
  }
  var a = rt.mem_load(w, 0, 8)
  if a == 0 {
    return 0
  }
  while true {
    let t = rt.mem_load(a, 0, 8)
    if t == 0 {
      // AT_NULL
      return 0
    }
    if t == k {
      return rt.mem_load(a, 8, 8)
    }
    a = addw(a, 16)
  }
  0
}
