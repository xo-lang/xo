// The C ABI exports of the poller (decisions 0204, 0206 stage 3), like
// cabi.xo's: the native prelude imports the module, so the SSA builders
// build these in every native program (importer_built). Nothing here may
// fault.
use native/llrt/sock

/// close(2) of a descriptor the poller watched.
fn fd_close(fd: Int) -> Int { sock.close(fd) }

/// O_NONBLOCK and FD_CLOEXEC on fd.
fn fd_nonblock(fd: Int) -> Int { sock.nonblock(fd) }
