// List objects in Xo (zero-C audit item B13, decision 0195; decision
// 0207's raw memory): a new list, the copy of a list that is not unique,
// a full list's growth, the release of a list's elements, and the
// worklist of drops. arm64 generated code calls the `*_n` entries
// directly through cabi.xo's `obj_*_n` exports, with no C level (decision
// 0226): they find the calling thread's heap themselves (heap_word). The
// C runtime's entry points (xo_rl_new_n, xo_rl_copy, xo_rl_grow,
// xo_rl_share, xo_rl_free, xo_rc_defer in std/llrt/xo_rt.c) stay for LLVM
// generated code and the seed compiler, which call them by name; they
// forward to the same exports (LTO folds that level), and C code calls
// xo_rl_new with a heap word. The string objects (below) follow the same
// shape.
//
// The heap word hw is the calling thread's heap record's address
// (alloc.xo), plus 1 when other threads run (the C's alloc_mt, free_mt,
// and xo_resize's mt paths). A list object is its count, its length,
// its capacity, then its elements. Callbacks (an element's dup, drop, or
// share, a drop of the worklist) are C ABI functions of generated code,
// called through rt.call_c2.
//
// The no allocation, no counting rule of rc.xo and alloc.xo is kept by
// hand (decision 0207, design 3): Int words only, rt.int_wrap for the
// arithmetic, no Str, List, closure, or interpolation, nothing that can
// fault. check_no_alloc does not check it: it calls alloc.xo's and
// rc.xo's functions, which that check allows no module.
use native/llrt/alloc
use native/llrt/rc
use native/llrt/rtstats
use native/rt

/// The immortal count of a literal (never written).
const IMMORTAL: Int = -9223372036854775807 - 1

/// The count of the object at p, relaxed: another thread may change a
/// shared count at any time (rc.xo; a plain load is a data race to
/// ThreadSanitizer, decision 0241); a plain load on arm64 either way.
fn count(p: Int) -> Int { rt.slot_load(p, 0, 0) }

/// Words of the heap record (xo_rt.c struct xo_heap, checked by its
/// _Static_assert): the drop worklist (its array, length, capacity, and
/// whether a drain runs).
const DEFER_Q = 1832
const DEFER_N = 1840
const DEFER_CAP = 1848
const DEFER_BUSY = 1856

/// rt.static_word: the heap words (rt.xo's table, set by heap_init):
/// the single threaded heap record (0 once several threads run), then
/// the address of a C function of two Int arguments (called through
/// rt.call_c2): the calling thread's heap record (xo_rt.c heap_slow).
const HEAP = 10
const H_SLOW = 8

/// The heap record's real-time section depth (alloc.xo RT_DEPTH).
const RT_DEPTH = 40

/// The heap record's queue of the frees real-time sections deferred
/// (xo_rt.c xo_heap rt_n and rt_q, checked there): its length, then
/// RTQ entries of 32 bytes: the kind (RT_*, an int), the object, a
/// list's element size, and the list's element drop or the object's
/// drop.
const RT_N = 2144
const RT_Q = 2152

/// The heap record's words of the heap profile (heapprof.xo, decision
/// 0238): the hook's address (0: off, the only word the allocator reads
/// then), the bytes to the record's next sample.
const H_PROF = 1872
const H_PLEFT = 10344
/// A sampled block's mark in its header (heapprof.xo MARK).
const H_MARK = 65536
const RTQ = 256

/// What a deferred free frees (xo_rt.c RT_*): a string object, a list
/// object, an object of the drop worklist, a handle.
pub const RT_STR = 1
pub const RT_LIST = 2
pub const RT_DEFER = 3
pub const RT_HANDLE = 4

/// rt.sched_rt's statistic op and the counters of the frees deferred and
/// of those done at once because the queue was full (xo_rt.c st).
const ST_RT_DEFER = 19
const ST_RT_OVERFLOW = 20

/// The thread local word of the calling thread's heap record (sched.xo
/// TLS_HEAP, xo_rt.c tls_heap).
const TLS_HEAP = 3

/// The offset of a heap record's 256 byte scratch (xo_rt.c xo_heap
/// scratch, checked there).
const H_SCRATCH = 1880

/// The largest block alloc.alloc_fast serves (alloc.xo SMALL_MAX).
const SMALL_MAX = 1024

/// The header bytes of a list object.
const L_HDR = 24

fn addw(a: Int, b: Int) -> Int { rt.int_wrap(0, a, b) }

fn subw(a: Int, b: Int) -> Int { rt.int_wrap(1, a, b) }

fn mulw(a: Int, b: Int) -> Int { rt.int_wrap(2, a, b) }

// ---------------------------------------------------------------------------
// The heap through the heap word

// The heap calls: every allocation and free of this module goes through
// halloc and hfree, so alloc.alloc and alloc.free each have one call site
// here. The arm64 inliner copies a large function only into at most two
// call sites (selfhost/arm64/inline.xo INLINE_FEW_SITES): with more here,
// cabi.heap_alloc and heap_free (xo_alloc and xo_free, every C
// allocation) lost their inlined copies and took about 1.02 times the
// instructions on bench/perf/alloc strings. halloc and hfree stay out of
// line themselves: each calls itself on a path the callers never take,
// and the inliner never copies a function on a call cycle.

/// A block of n bytes from heap word hw (xo_rt.c xo_alloc): with other
/// threads running (alloc_mt) the class is refilled from the central
/// lists first.
fn halloc(hw: Int, n: Int) -> Int {
  if n < 0 {
    return halloc(hw, 0) // not taken: the inliner's cycle
  }
  let mt = hw & 1
  let h = subw(hw, mt)
  if mt != 0 {
    // the heap profile: only on this path (profiling makes every
    // thread's heap word threaded); the record's countdown of bytes to
    // its next sample, which halloc_prof takes
    let hk = rt.mem_load(h, H_PROF, 8)
    if hk != 0 {
      let left = subw(rt.mem_load(h, H_PLEFT, 8), n)
      if left <= 0 {
        return halloc_prof(h, n, hk)
      }
      rt.mem_store(h, H_PLEFT, left, 8)
    }
    alloc.refill(h, n)
  }
  alloc.alloc(h, n)
}

/// halloc of the heap profile's next sample: the allocation (halloc on
/// record h without the thread bit, so alloc.alloc keeps its one call
/// site), then the hook, which samples the block and sets the record's
/// next countdown.
fn halloc_prof(h: Int, n: Int, hk: Int) -> Int {
  alloc.refill(h, n)
  let r = halloc(h, n)
  let _s = rt.call_c2(hk, r, n)
  r
}

/// Frees the block p to heap word hw (xo_rt.c xo_free; free_mt with
/// other threads running).
fn hfree(hw: Int, p: Int) {
  if p == 0 {
    hfree(hw, p) // not taken: the inliner's cycle
    return
  }
  if hw & 1 == 0 {
    free1(hw, p)
    return
  }
  let h = subw(hw, 1)
  // with the heap profile on, only a sampled block (marked) or a big
  // one goes to hfree_prof
  if rt.mem_load(h, H_PROF, 8) == 0 || unmarked(p) {
    alloc.free_mt(h, p)
    return
  }
  // last, so a tail call: a call followed by more code here gave every
  // free a frame (6% more instructions on bench/perf/alloc tasks)
  hfree_prof(h, p)
}

/// Whether block p is of a size class and not sampled (heapprof.xo MARK).
fn unmarked(p: Int) -> Bool {
  let c = rt.mem_load(p, -8, 8)
  c > 0 && c & H_MARK == 0
}

/// hfree with the heap profile on: a sampled block (its header's size
/// class marked, heapprof.xo MARK) has the mark cleared and the hook
/// forget it before it is freed, so its address cannot be handed out
/// again first; a big block (a negative size) always asks the hook.
/// Out of line (it calls itself on a path never taken), so hfree keeps
/// no frame.
fn hfree_prof(h: Int, p: Int) {
  if p == 0 {
    hfree_prof(h, p) // not taken: the inliner's cycle
    return
  }
  let c = rt.mem_load(p, -8, 8)
  if c < 0 {
    let _b = rt.call_c2(rt.mem_load(h, H_PROF, 8), p, -1)
  } else if c & H_MARK != 0 {
    rt.mem_store(p, -8, c ^ H_MARK, 8)
    let _k = rt.call_c2(rt.mem_load(h, H_PROF, 8), p, -1)
  }
  alloc.free_mt(h, p)
}

/// A block of n bytes for a runtime object (xo_alloc): the calling
/// thread's heap, refilled from the central lists with other threads
/// running.
pub fn alloc_obj(n: Int) -> Int { halloc(heap_word(), n) }

/// Frees the runtime object p (xo_free).
pub fn free_obj(p: Int) { hfree(heap_word(), p) }

/// The runtime object p of old bytes as one of n bytes (xo_resize).
pub fn resize_obj(p: Int, old: Int, n: Int) -> Int { hresize(heap_word(), p, old, n) }

/// A new string object with room for at least n bytes (xo_rt.c rs_new).
pub fn rs_new_obj(n: Int) -> Int { rs_new_n(n) }


/// alloc.free on heap h (one thread): the module's one call site of it
/// (see halloc), small enough that the inliner copies it into its two
/// callers (rl_free_n's common case and hfree).
fn free1(h: Int, p: Int) { alloc.free(h, p) }

/// A block of n bytes holding the first old bytes of p, which is freed
/// (xo_resize): in place or moved by the heap (alloc.resize, which makes
/// no call but a tail call), else moved by hmove, a tail call; so a
/// caller's path through it has no frame.
fn hresize(hw: Int, p: Int, old: Int, n: Int) -> Int {
  let mt = hw & 1
  let q = alloc.resize(subw(hw, mt), p, old, n, mt)
  if q != 0 {
    if q != p && mt != 0 {
      return hmoved(hw, p, q)
    }
    return q
  }
  hmove(hw, p, old, n)
}

/// A big block p the heap moved to q (alloc.resize, threaded): with the
/// heap profile on, a sampled p's slot follows it to q. q. Out of line,
/// as hfree_prof, so hresize keeps no frame.
fn hmoved(hw: Int, p: Int, q: Int) -> Int {
  if q == 0 {
    return hmoved(hw, p, q) // not taken: the inliner's cycle
  }
  let h = subw(hw, 1)
  let hk = rt.mem_load(h, H_PROF, 8)
  if hk != 0 {
    let k = rt.call_c2(hk, p, -1)
    if k >= 0 {
      let _m = rt.call_c2(hk, q, subw(-2, k))
    }
  }
  q
}

/// hresize's move: a new block, the copy, the free of p. Out of line
/// (it calls itself on a path never taken, so the inliner keeps it out).
fn hmove(hw: Int, p: Int, old: Int, n: Int) -> Int {
  if n < 0 {
    return hmove(hw, p, old, 0) // not taken: the inliner's cycle
  }
  let r = halloc(hw, n)
  rt.mem_copy(r, p, if old < n { old } else { n })
  hfree(hw, p)
  r
}

// ---------------------------------------------------------------------------
// Lists

/// A new empty list object with room for cap elements of esize bytes
/// (xo_rl_new).
pub fn rl_new(hw: Int, cap: Int, esize: Int) -> Int {
  let n = addw(L_HDR, mulw(cap, esize))
  let l = halloc(hw, n)
  rt.mem_store(l, 0, 1, 8)
  rt.mem_store(l, 8, 0, 8)
  rt.mem_store(l, 16, cap, 8)
  l
}

// The entry points generated code calls (cabi.xo's obj_*_n exports):
// the heap comes from static word HEAP (one thread) or the thread local
// table (heap_word). Their common cases (one thread, no real-time
// section, a small block from its class's free list or the chunk) make
// no call, so they have no frame; the rest are tail calls
// (bench/results/string-list-objects-2026-10-14.md).

/// A new list of cap elements of esize bytes from the free list of heap
/// h (alloc.alloc_fast), else 0.
fn try_new(h: Int, cap: Int, esize: Int) -> Int {
  let b = addw(L_HDR, mulw(cap, esize))
  if b > SMALL_MAX {
    return 0
  }
  let l = alloc.alloc_fast(h, b)
  if l != 0 {
    rt.mem_store(l, 0, 1, 8)
    rt.mem_store(l, 8, 0, 8)
    rt.mem_store(l, 16, cap, 8)
  }
  l
}

/// A new empty list object with room for n elements (at least 4) of esize
/// bytes (xo_rl_new_n).
pub fn rl_new_n(n: Int, esize: Int) -> Int {
  let cap = if n < 4 { 4 } else { n }
  let h = rt.mem_load(rt.static_word(HEAP), 0, 8)
  if h != 0 {
    let l = try_new(h, cap, esize)
    if l != 0 {
      return l
    }
    return rl_new(h, cap, esize)
  }
  rl_new(heap_word(), cap, esize)
}

/// rl_grow for generated code (xo_rl_grow): the first push to an empty
/// literal's list is its common case.
pub fn rl_grow_n(l: Int, esize: Int) -> Int {
  let h = rt.mem_load(rt.static_word(HEAP), 0, 8)
  if h != 0 {
    if count(l) == IMMORTAL {
      let n = try_new(h, 4, esize)
      if n != 0 {
        return n
      }
      return rl_new(h, 4, esize)
    }
    return grow(h, l, esize)
  }
  rl_grow(heap_word(), l, esize)
}

/// rl_free for generated code (xo_rl_free): a list whose count reached
/// zero; a real-time section defers it (the C's queue).
pub fn rl_free_n(l: Int, esize: Int, drop: Int) {
  let h = rt.mem_load(rt.static_word(HEAP), 0, 8)
  if h != 0 && rt.mem_load(h, RT_DEPTH, 8) == 0 {
    if drop == 0 {
      free1(h, l)
      return
    }
    rl_free(h, l, esize, drop)
    return
  }
  rl_free_n_slow(l, esize, drop)
}

fn rl_free_n_slow(l: Int, esize: Int, drop: Int) {
  let hw = heap_word()
  let h = hw & -2
  if rt.mem_load(h, RT_DEPTH, 8) != 0 && rt_defer(h, RT_LIST, l, esize, drop) {
    return
  }
  rl_free(hw, l, esize, drop)
}

/// Frees the string or box object p whose count reached zero, for
/// generated code (xo_rc_free); a real-time section defers it.
pub fn rc_free_n(p: Int) {
  // rl_free_n with no elements to drop: its fast path (the one thread's
  // heap word, free1 inlined) and its real-time deferral; a third call
  // site of free1 would keep the inliner from copying it (see halloc)
  rl_free_n(p, 0, 0)
}

/// Frees the handle p whose count reached zero, for generated code
/// (xo_h_free): its free function (word 1), unless a real-time section
/// defers it.
pub fn h_free_n(p: Int) {
  let h = heap_word() & -2
  if rt.mem_load(h, RT_DEPTH, 8) != 0 && rt_defer(h, RT_HANDLE, p, 0, 0) {
    return
  }
  let _f = rt.call_c2(rt.mem_load(p, 8, 8), p, 0)
}

/// Whether the an bytes at a and the bn bytes at b are equal, 1 or 0,
/// for generated code's string == (xo_str_eq).
pub fn str_eq(a: Int, an: Int, b: Int, bn: Int) -> Int {
  if an != bn {
    return 0
  }
  if a == b || an == 0 {
    return 1
  }
  if rt.mem_cmp(a, b, an) == 0 { 1 } else { 0 }
}

/// The order of the an bytes at a and the bn bytes at b, -1, 0, or 1, as
/// unsigned bytes and then by length (xo_str_cmp).
pub fn str_cmp(a: Int, an: Int, b: Int, bn: Int) -> Int {
  let n = if an < bn { an } else { bn }
  let c = rt.mem_cmp(a, b, n)
  if c != 0 {
    return if c < 0 { -1 } else { 1 }
  }
  if an < bn { -1 } else if an > bn { 1 } else { 0 }
}

/// The bytes of the decimal text of v (and its sign).
fn int_text_len(v: Int) -> Int {
  var n = if v < 0 { 2 } else { 1 }
  var x = v / 10
  while x != 0 {
    n = addw(n, 1)
    x = x / 10
  }
  n
}

/// Writes the n bytes of v's decimal text at p (int_text_len(v) bytes).
fn put_int(p: Int, n: Int, v: Int) {
  var i = n
  var x = v
  while true {
    var d = x % 10
    if d < 0 {
      d = 0 - d
    }
    i = subw(i, 1)
    rt.mem_store(p, i, addw(48, d), 1)
    x = x / 10
    if x == 0 {
      break
    }
  }
  if v < 0 {
    rt.mem_store(p, 0, 45, 1)
  }
}

/// a + "${v}" for generated code (xo_rs_concat_int): the string object,
/// its length (an plus the digits') stored at lenp.
pub fn rs_concat_int(a: Int, an: Int, v: Int, lenp: Int) -> Int {
  let n = int_text_len(v)
  rt.mem_store(lenp, 0, addw(an, n), 8)
  let s = reserve(a, an, n)
  put_int(addw(addw(s, S_HDR), an), n, v)
  s
}

/// "${v}" for generated code (xo_rs_of_int), its length stored at lenp.
pub fn rs_of_int(v: Int, lenp: Int) -> Int {
  let n = int_text_len(v)
  rt.mem_store(lenp, 0, n, 8)
  let s = rs_with_cap(n)
  put_int(addw(s, S_HDR), n, v)
  s
}

/// rl_copy for generated code (xo_rl_copy).
pub fn rl_copy_n(l: Int, esize: Int, dup: Int, drop: Int) -> Int { rl_copy(heap_word(), l, esize, dup, drop) }

/// rc_defer for generated code (xo_rc_defer); a real-time section defers
/// the object (its queue) unless a drain runs.
pub fn rc_defer_n(obj: Int, drop: Int) {
  let h = heap_word() & -2
  if rt.mem_load(h, RT_DEPTH, 8) != 0 && rt.mem_load(h, DEFER_BUSY, 8) == 0 && rt_defer(h, RT_DEFER, obj, 0, drop) {
    return
  }
  rc_defer(h, obj, drop)
}

// ---------------------------------------------------------------------------
// Real-time sections' deferred frees (core 6.5, decision 0133; rtsec.xo
// has the sections; they were xo_rt.c's)

/// Queues a free (kind RT_*, the object o, a list's element size and the
/// drop f) in heap record h's real-time section: false when the queue is
/// full (the caller frees at once, counted).
pub fn rt_defer(h: Int, kind: Int, o: Int, esize: Int, f: Int) -> Bool {
  let n = rt.mem_load(h, RT_N, 8)
  if n == RTQ {
    rtstats.count(ST_RT_OVERFLOW)
    return false
  }
  let e = addw(addw(h, RT_Q), mulw(n, 32))
  rt.mem_store(e, 0, kind, 4)
  rt.mem_store(e, 8, o, 8)
  rt.mem_store(e, 16, esize, 8)
  rt.mem_store(e, 24, f, 8)
  rt.mem_store(h, RT_N, addw(n, 1), 8)
  rtstats.count(ST_RT_DEFER)
  true
}

/// Frees what heap record h's real-time sections deferred; the depth is
/// zero, so what those frees release is freed at once.
pub fn rt_drain(h: Int) {
  var i = 0
  while i < rt.mem_load(h, RT_N, 8) {
    let e = addw(addw(h, RT_Q), mulw(i, 32))
    let kind = rt.mem_load(e, 0, 4)
    let o = rt.mem_load(e, 8, 8)
    if kind == RT_STR {
      free_obj(o)
    } else if kind == RT_LIST {
      rl_free_n(o, rt.mem_load(e, 16, 8), rt.mem_load(e, 24, 8))
    } else if kind == RT_DEFER {
      rc_defer_n(o, rt.mem_load(e, 24, 8))
    } else if kind == RT_HANDLE {
      // the handle's free function (its word 1)
      let _f = rt.call_c2(rt.mem_load(o, 8, 8), o, 0)
    }
    i = addw(i, 1)
  }
  rt.mem_store(h, RT_N, 0, 8)
}

/// The calling thread's 256 byte scratch for the structures of system
/// calls (timespec, statx, sigaction): the scratch of its heap record
/// (xo_rt.c struct xo_heap), valid until its next system call through
/// it. Heap records of exited threads are reused, so it is never freed
/// (work item B02; was the C thread local sys_scratch of xo_sys.c).
pub fn scratch() -> Int { addw(heap_word() & -2, H_SCRATCH) }

/// The calling thread's heap record (xo_rt.c heap).
pub fn heap() -> Int { heap_word() & -2 }

/// The calling thread's heap word (xo_rt.c hw): the single threaded heap
/// record, else the thread's heap record (thread local TLS_HEAP, which the
/// C sets on the thread's first allocation, heap_slow) plus 1.
fn heap_word() -> Int {
  let w = rt.static_word(HEAP)
  let h = rt.mem_load(w, 0, 8)
  if h != 0 {
    return h
  }
  var t = rt.tlocal_get(TLS_HEAP)
  if t == 0 {
    t = rt.call_c2(rt.mem_load(w, H_SLOW, 8), 0, 0)
  }
  t | 1
}

/// The single threaded heap record, 0 once other threads run.
pub fn solo_heap() -> Int { rt.mem_load(rt.static_word(HEAP), 0, 8) }

/// The calling thread's heap record (prof.xo's heap profile).
pub fn heap_now() -> Int { heap_word() & -2 }

/// Sets the heap words (C main, before the program runs, with the main
/// heap record; xo_rt_threads_begin with 0, before a second thread runs).
pub fn heap_init(h: Int, slow: Int) {
  let w = rt.static_word(HEAP)
  rt.mem_store(w, 0, h, 8)
  rt.mem_store(w, H_SLOW, slow, 8)
}

/// Calls f (a C function of generated code) on each element of the list
/// l of esize byte elements.
fn each(l: Int, esize: Int, f: Int) {
  var e = addw(l, L_HDR)
  let end = addw(e, mulw(rt.mem_load(l, 8, 8), esize))
  while e < end {
    let _r = rt.call_c2(f, e, 0)
    e = addw(e, esize)
  }
}

/// The slow path of `reuse` (xo_rl_copy): l's count is not 1. A shared
/// list held only by the caller (rc.claim) is updated in place. Otherwise
/// the update goes to a copy, which holds its own references to the
/// elements (dup, when not 0), and l loses the one the caller gave up
/// (freed with drop when the other references went meanwhile).
pub fn rl_copy(hw: Int, l: Int, esize: Int, dup: Int, drop: Int) -> Int {
  if rc.claim(l) != 0 {
    return l
  }
  let len = rt.mem_load(l, 8, 8)
  let c = rl_new(hw, if len < 4 { 4 } else { len }, esize)
  rt.mem_store(c, 8, len, 8)
  rt.mem_copy(addw(c, L_HDR), addw(l, L_HDR), mulw(len, esize))
  if dup != 0 {
    each(c, esize, dup)
  }
  if rc.dec(l) != 0 {
    rl_free(hw, l, esize, drop)
  }
  c
}

/// Marks the elements of a list that was just marked shared (xo_rl_share;
/// share is the element callback of generated code).
pub fn rl_share(l: Int, esize: Int, share: Int) { each(l, esize, share) }

/// The unique full list l with its capacity doubled (xo_rl_grow); the
/// shared empty list of an empty literal (xo_rl_empty, immortal: the
/// arm64 backend makes `[]` without allocating, and the first push lands
/// here) becomes a new list.
pub fn rl_grow(hw: Int, l: Int, esize: Int) -> Int {
  if count(l) == IMMORTAL {
    return rl_new(hw, 4, esize)
  }
  grow(hw, l, esize)
}

/// rl_grow of a list that is not the empty literal's. Out of line (it
/// calls itself on a path never taken): the resize it inlines saves
/// registers that rl_grow's other path does not need.
fn grow(hw: Int, l: Int, esize: Int) -> Int {
  let cap = rt.mem_load(l, 16, 8)
  if cap < 0 {
    return grow(hw, l, esize) // not taken: the inliner's cycle
  }
  let ncap = if cap < 4 { 4 } else { addw(cap, cap) }
  // the new capacity first: the resize keeps the block or copies its
  // first bytes (the header with them), so nothing is live after the
  // call and it is a tail call
  rt.mem_store(l, 16, ncap, 8)
  hresize(hw, l, addw(L_HDR, mulw(cap, esize)), addw(L_HDR, mulw(ncap, esize)))
}

/// Frees a list whose count reached zero, releasing its elements first
/// (drop, when not 0; xo_rl_free after its real-time check).
pub fn rl_free(hw: Int, l: Int, esize: Int, drop: Int) {
  if drop != 0 {
    each(l, esize, drop)
  }
  hfree(hw, l)
}

// ---------------------------------------------------------------------------
// The drop worklist

/// Runs drop(obj) for an object whose count reached zero, a closure
/// environment or a box (xo_rc_defer after its real-time check; h the
/// thread's heap record). drop releases the object's children and frees
/// it; a child that reaches zero meanwhile is queued instead of dropped
/// recursively, so freeing a long chain (a list built from boxes,
/// closures capturing closures) uses a worklist, not the stack. Marking
/// a value shared uses the same worklist (drop is then the function that
/// marks the children of a box or an environment). The worklist's array
/// is from malloc (rt.heap_large, not counted by the leak check) and
/// stays with the heap record.
pub fn rc_defer(h: Int, obj: Int, drop: Int) {
  if rt.mem_load(h, DEFER_BUSY, 8) != 0 {
    let n = rt.mem_load(h, DEFER_N, 8)
    var q = rt.mem_load(h, DEFER_Q, 8)
    let cap = rt.mem_load(h, DEFER_CAP, 8)
    if n == cap {
      let ncap = if cap < 64 { 64 } else { addw(cap, cap) }
      if q == 0 {
        q = rt.heap_large(mulw(ncap, 16))
      } else {
        q = rt.heap_large_resize(subw(q, 8), mulw(ncap, 16))
      }
      rt.mem_store(h, DEFER_Q, q, 8)
      rt.mem_store(h, DEFER_CAP, ncap, 8)
    }
    let e = addw(q, mulw(n, 16))
    rt.mem_store(e, 0, obj, 8)
    rt.mem_store(e, 8, drop, 8)
    rt.mem_store(h, DEFER_N, addw(n, 1), 8)
    return
  }
  rt.mem_store(h, DEFER_BUSY, 1, 8)
  let _r = rt.call_c2(drop, obj, 0)
  while true {
    let n = rt.mem_load(h, DEFER_N, 8)
    if n == 0 {
      break
    }
    let k = subw(n, 1)
    rt.mem_store(h, DEFER_N, k, 8)
    let e = addw(rt.mem_load(h, DEFER_Q, 8), mulw(k, 16))
    let _d = rt.call_c2(rt.mem_load(e, 8, 8), rt.mem_load(e, 0, 8), 0)
  }
  rt.mem_store(h, DEFER_BUSY, 0, 8)
}

// ---------------------------------------------------------------------------
// Strings (zero-C audit B13: xo_rt.c rs_new and rs_append, the bodies of
// xo_rs_concat, xo_rs_append, and the builders of xo_bytes.c). A string
// object is its count, its capacity (the bytes its block holds past the
// header), then its bytes; a literal's count is IMMORTAL. The first
// string of each entry is consumed (decision 0074): the result is it,
// updated in place when it is unique and has the room, else a grown or
// new object (and a loses the reference the caller gave up). The common
// case (unique, room) makes no call; reserve_slow is out of line.

/// The header bytes of a string object.
const S_HDR = 16

/// The heap record's word with the size class of its last allocation
/// (alloc.xo LAST): a string's capacity is that less the header.
const H_LAST = 72

/// A new string object with room for at least n bytes (xo_rt.c rs_new).
fn rs_new(hw: Int, n: Int) -> Int {
  let s = halloc(hw, addw(S_HDR, n))
  rt.mem_store(s, 0, 1, 8)
  rt.mem_store(s, 8, subw(rt.mem_load(hw & -2, H_LAST, 8), S_HDR), 8)
  s
}

/// rs_new from the calling thread's heap: a small block from its free
/// list or chunk without a call (alloc.alloc_fast) when one thread runs.
fn rs_new_n(n: Int) -> Int {
  let h = rt.mem_load(rt.static_word(HEAP), 0, 8)
  if h != 0 {
    let b = addw(S_HDR, n)
    if b <= SMALL_MAX {
      let s = alloc.alloc_fast(h, b)
      if s != 0 {
        rt.mem_store(s, 0, 1, 8)
        rt.mem_store(s, 8, subw(rt.mem_load(h, H_LAST, 8), S_HDR), 8)
        return s
      }
    }
    return rs_new(h, n)
  }
  rs_new(heap_word(), n)
}

/// The string a (an bytes, consumed) with room for k more bytes, unique:
/// a itself when its count is 1 and it has the room.
fn reserve(a: Int, an: Int, k: Int) -> Int {
  let need = addw(an, k)
  // the count with a relaxed atomic load (no cost on arm64): a shared
  // string's count changes on other threads, and a plain load of it is a
  // data race (ThreadSanitizer, decision 0241)
  if rt.slot_load(a, 0, 0) == 1 && rt.mem_load(a, 8, 8) >= need {
    return a
  }
  reserve_slow(a, an, need)
}

/// reserve's other paths (xo_rt.c rs_append): a unique string (rc.claim:
/// a shared one held only by the caller too) grows in place, doubling
/// (Perceus reuse, so a loop of `s = s + x` is linear); otherwise the
/// bytes go to a new string with room for need (at least 16), and a
/// loses the reference the caller gave up. Out of line (it calls itself
/// on a path never taken).
fn reserve_slow(a: Int, an: Int, need: Int) -> Int {
  if need < 0 {
    return reserve_slow(a, an, 0) // not taken: the inliner's cycle
  }
  let hw = heap_word()
  if rc.claim(a) != 0 {
    let cap = rt.mem_load(a, 8, 8)
    if cap >= need {
      return a
    }
    var want = addw(cap, cap)
    if want < need {
      want = need
    }
    let s = hresize(hw, a, addw(S_HDR, an), addw(S_HDR, want))
    rt.mem_store(s, 8, subw(rt.mem_load(hw & -2, H_LAST, 8), S_HDR), 8)
    return s
  }
  let s = rs_new(hw, if need < 16 { 16 } else { need })
  rt.mem_copy(addw(s, S_HDR), addw(a, S_HDR), an)
  // a literal (common: `"w${i}"` appends to one), or one with other
  // references, or a shared one freed here when the others went
  if count(a) != IMMORTAL && rc.dec(a) != 0 {
    hfree(hw, a)
  }
  s
}

/// a + the n bytes at p (xo_rs_concat's rs_append): p may be inside a
/// string the caller holds, so the bytes are moved after the reserve.
pub fn rs_append(a: Int, an: Int, p: Int, n: Int) -> Int {
  let s = reserve(a, an, n)
  rt.mem_move(addw(addw(s, S_HDR), an), p, n)
  s
}

/// a + the byte x (xo_rs_push_byte).
pub fn rs_push_byte(a: Int, an: Int, x: Int) -> Int {
  let s = reserve(a, an, 1)
  rt.mem_store(addw(s, S_HDR), an, x, 1)
  s
}

/// a + the n (0 to 8) low bytes of w, the lowest first
/// (xo_rs_push_word): whole words are stored, so 8 bytes of room are
/// reserved; text alone (appended to the literal "") gets a new string
/// of 32.
pub fn rs_push_word(a: Int, an: Int, w: Int) -> Int {
  var s = a
  if rt.slot_load(a, 0, 0) != 1 || subw(rt.mem_load(a, 8, 8), an) < 8 {
    s = push_slow(a, an, 8, 32)
  }
  rt.mem_store(addw(s, S_HDR), an, w, 8)
  s
}

/// a + four words of up to 8 bytes, their lengths in the nibbles of lens
/// (xo_rs_push_words): each whole word stored over the slack of the one
/// before, so 32 bytes of room.
pub fn rs_push_words(a: Int, an: Int, w0: Int, w1: Int, w2: Int, w3: Int, lens: Int) -> Int {
  var s = a
  if rt.slot_load(a, 0, 0) != 1 || subw(rt.mem_load(a, 8, 8), an) < 32 {
    s = push_slow(a, an, 32, 64)
  }
  var d = addw(addw(s, S_HDR), an)
  rt.mem_store(d, 0, w0, 8)
  d = addw(d, lens & 15)
  rt.mem_store(d, 0, w1, 8)
  d = addw(d, (lens >> 4) & 15)
  rt.mem_store(d, 0, w2, 8)
  d = addw(d, (lens >> 8) & 15)
  rt.mem_store(d, 0, w3, 8)
  s
}

/// The push paths with no room: the empty literal becomes a new string
/// of fresh bytes, else reserve's slow path.
fn push_slow(a: Int, an: Int, k: Int, fresh: Int) -> Int {
  if an == 0 && count(a) == IMMORTAL {
    return rs_new_n(fresh)
  }
  reserve_slow(a, an, addw(an, k))
}

/// a + the bytes lo..hi of the string or Bytes object b, their ASCII
/// letters lowered (mode 1) or raised (mode 2) (xo_rs_append_bytes).
pub fn rs_append_bytes(a: Int, an: Int, b: Int, lo: Int, hi: Int, mode: Int) -> Int {
  let n = subw(hi, lo)
  let s = reserve(a, an, n)
  let d = addw(addw(s, S_HDR), an)
  rt.mem_move(d, addw(addw(b, S_HDR), lo), n)
  if mode != 0 {
    fold(d, n, mode)
  }
  s
}

/// The n bytes at d with their ASCII letters lowered (mode 1) or raised
/// (mode 2).
fn fold(d: Int, n: Int, mode: Int) {
  // the first letter of the case to change, and the change
  let first = if mode == 1 { 65 } else { 97 }
  let delta = if mode == 1 { 32 } else { -32 }
  var i = 0
  while i < n {
    let c = rt.mem_load(d, i, 1)
    if subw(c, first) < 26 && c >= first {
      rt.mem_store(d, i, addw(c, delta), 1)
    }
    i = addw(i, 1)
  }
}

/// An empty string with room for n bytes, at least 16 (xo_rs_with_cap).
pub fn rs_with_cap(n: Int) -> Int { rs_new_n(if n < 16 { 16 } else { n }) }

/// The frees the calling thread's real-time sections deferred so far (its
/// heap's RT_N): std/internal rt_queued (decision 0241). Real-time: inside
/// a section the thread has its heap record, so only heap_word's fast
/// paths (the single threaded record, the thread local) are taken.
pub fn rt_queued() -> Int uses realtime { rt.mem_load(rt_heap(), RT_N, 8) }

/// The calling thread's heap record in a real-time section (heap without
/// its slow path, which a thread that entered a section has passed).
pub fn rt_heap() -> Int uses realtime {
  let h = rt.mem_load(rt.static_word(HEAP), 0, 8)
  (if h != 0 { h } else { rt.tlocal_get(TLS_HEAP) }) & -2
}
