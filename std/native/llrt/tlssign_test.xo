// TLS's RSA-PSS signatures (tlssign.sign, schemes 0x0804 to 0x0806): the
// salt is the hash's length, as RFC 8446 4.2.3 and Go's crypto/tls
// (PSSSaltLengthEqualsHash), and a fixed salt of another length fails the
// signature as Go's reference does (TestTLSServerReplayDiff, rfc8448
// case 278 after a98eab0e5 let rsa.sign_pss_fn take any salt).
use native/llrt/rsa
use native/llrt/sha256

/// A 2048-bit test key (PKCS #1 DER, generated for this test only).
fn key() -> Bytes {
  Bytes.from_hex(KEY) ?? b""
}

const KEY = "308204a30201000282010100c76256204e69b5e1173daa776e8684d9f7ad74f142b373ddc1226e974bbf3b5271817c8d" +
  "31c97ff34cae75d642194491fe06ee972952d777420fa1d44e4823dd9fdffeeb4e4829cabacf3da216bb4ec60876eb1c" +
  "0d0f1ca2e9f1882da6a753e8b37f5c35c37c011c2f964c0b80a5e6082ace08c3cab7e599322b1755b88ffb8655580d95" +
  "a6896dfd3ac49c2c1f93314d553b67303844734134b67555cc6c37f1637e8d480a3d2090616c19003a4f3de3c69a7d50" +
  "636b1ef1e9621ae2dbc96b3403c4c6fdecfa26cc848dcdd534321ec5ef60fa42d717108b78f300b7f646a8eab511bf45" +
  "bbfe1b9bd117be6c4e72d8905a64a878c42cbaf592c87a5a426cf4e1020301000102820100112e10fbc1a5ec2d140295" +
  "40ab3e5e0e2600453650a803d0d4c671bf09a0d5acb9e90d61612bdaa18d36ef226219a945e71c93cc649c25c2b9e77c" +
  "eb3d3f8c0f99aa045e2425a5ac3942882e02456b7936db8050af7360e54cc12a19bce5681e81f0f47211810adb71e242" +
  "752f459c3791f0a4e2b201fc7fa1ca02bdb92476e8aa45a91584881b353c41133405a72817fc2fd4b62325db99fad238" +
  "80f29dd0a73bd66108d1ca4cf69aec2b9f63945798c908eab0daccc8efa9493d2e1d6911c15d2e35fd088b678fe207aa" +
  "4e85d4c6fa9a252174273d9d8dc66a67759b72f5794bcb5c9715b9924dda5cb9978a7570a7ca2d24075fccb4bad9e661" +
  "cd9fa1d7d102818100f1d1d07ce4809ccda8c7bc750f144ccda6b80efbf6f611cf8d420355bb1c36f22ffcaca8bcef65" +
  "11b3b3895159fb63ad2d7335f03273a2f28b4b820c0f90ec70ebe8b0a96b4501f4d1a33a62148b4c4b075277222b4ec6" +
  "0d553f5a52a15b835912759c4616f4483897d60e8ef9dc5d6798bccd938181d21de6c0f77343eb73bd02818100d3137b" +
  "8f0184d11ffff41a8dd1339ac79181fd387a3ee3498f54045484e10f51f55f4b25d0b88cce2768347dd0e183364095ad" +
  "d72b969e344eade66f3a826d5591d3b15c5344139a4a42d35ca1befe6430491a07eec03b1b5bc584651bf420580c920e" +
  "1ff4121ed960f15b8819bed2b038b495a5c16ad430b97004eb5f2e85f50281810082c4636a26672664509132685aef2f" +
  "59467ee21b7f4132007af2e7bac4a44d524a80e91d968e1ea9a3f3c29e2b7ab63c4007bd7356d51198f79aad88b82236" +
  "ba19d88b3012c20e7cc5a0ef417aba9957396e6ede1b6d4dcc87fcea6b24b6c820b2cac6e7602259abc0f0108f60aeba" +
  "13fb949dd6d681cd8e3deabbe5a924fa410281804007f3fea0de52b65b6608bc26cf79cfbab36d46b9c6e41a47919c32" +
  "ab90be9e054aa0385b85f0a90549564b289790bf5f7e489b328ce1774abaf4619fa53b57af02421698e7d8ee80429f6d" +
  "c55f743a9e6f3ea753651b492460d9d5f651eb91ea5650549f2cf410cb98cc449052d405435e7cdb28bea89a13570917" +
  "01ebd21502818029fac413618e4e3a02986f0860f0beaff1c891c6b9f42a0a4698c710850be58a8abf3b2229c2ee61c9" +
  "5f65f8fb3a7f1a20a7bfd4a8ac08aa4a37f339f4d6e9a017968f7e3da321a954d1229c45e91f1a6c69f97ae34d6d774c" +
  "4a9c82111cf6472767bd89f4d84bc8900134bfb48660eae40a4df2f9722cd98c6a5447f633685a"

fn pub_of(der: Bytes) -> rsa.PublicKey {
  let k = rsa.private_key(der) ?? rsa.PrivateKey{n: b"", e: 0, d: b"", p: b"", q: b"", dp: b"", dq: b"", qinv: b""}
  rsa.PublicKey{n: k.n, e: k.e}
}

test "PSS: a random salt of the hash's length, verified with that length only" {
  let content = "TLS 1.3, server CertificateVerify".bytes()
  for (scheme, hash) in [(0x0804, sha256.HASH_SHA256), (0x0805, sha256.HASH_SHA384), (0x0806, sha256.HASH_SHA512)] {
    let sig = sign(scheme, 0, key(), content, b"")
    expect(sig.len()) == 256
    let hashed = sha256.sum(hash, content)
    let hl = sha256.size(hash)
    expect(rsa.verify_pss(pub_of(key()), hash, hashed, sig, hl)) == true
    expect(rsa.verify_pss(pub_of(key()), hash, hashed, sig, 32 + hl)) == false
  }
}

test "PSS: a fixed salt must be the hash's length" {
  let content = b"content"
  let s32 = Bytes.from_hex("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff") ?? b""
  let s48 = Bytes.from_hex("00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff") ?? b""
  expect(sign(0x0804, 0, key(), content, s32).len()) == 256
  expect(sign(0x0805, 0, key(), content, s32).len()) == 0
  expect(sign(0x0806, 0, key(), content, s32).len()) == 0
  let sig = sign(0x0805, 0, key(), content, s48)
  expect(sig.len()) == 256
  expect(rsa.verify_pss(pub_of(key()), sha256.HASH_SHA384, sha256.sum(sha256.HASH_SHA384, content), sig, 48)) == true
}
