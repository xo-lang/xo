// The C path of the zone rules (decision 0193 step 5): the API of tz.xo
// over the C runtime's zones (std/llrt/xo_time.c, compiled with
// -DXO_TZ_C), which parse the TZif data and look instants up in C as
// before the port. Loaded in place of tz.xo when XO_LLRT_C names `tz`,
// to compare the two and to fall back while the Xo path misses decision
// 0180's bar. The self hosted compiler always uses tz.xo.
use native/rttime

/// The zone of a name: the C runtime's id (0 for UTC and fixed zones).
pub struct Rules {
  id: Int
}

pub fn none() -> Rules { Rules{id: 0} }

pub fn load(name: Str, host: Bool) -> Rules? {
  let id = if host { rttime.tz_load_host(name) } else { rttime.tz_load(name) }
  if id == 0 {
    return None
  }
  Some(Rules{id: id})
}

pub fn local_name() -> Str { rttime.tz_local_name() }

pub fn offset(r: Rules, sec: Int) -> Int {
  if r.id == 0 {
    return 0
  }
  rttime.tz_offset(r.id, sec)
}

pub fn abbr(r: Rules, sec: Int) -> Str {
  if r.id == 0 {
    return "UTC"
  }
  rttime.tz_abbr(r.id, sec)
}
