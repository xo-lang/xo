/// a + b + 2 * lo(a) * lo(b), wrapping (fBlaMka, RFC 9106 3.6).
fn fbm(a: Int, b: Int) -> Int { rt.int_wrap(0, rt.int_wrap(0, a, b), rt.int_wrap(3, rt.int_wrap(2, a & 0xFFFFFFFF, b & 0xFFFFFFFF), 1)) }

/// Argon2's permutation P (RFC 9106 3.6) on the 16 words of t from i.
pub fn blamka_row(var t: List[Int], i: Int) {
  if i < 0 || i + 15 >= t.len() {
    rt.fault_raise("digest: block index out of range", "")
  }
  let x0 = t[i]
  var v0 = x0
  let x1 = t[i + 1]
  var v1 = x1
  let x2 = t[i + 2]
  var v2 = x2
  let x3 = t[i + 3]
  var v3 = x3
  let x4 = t[i + 4]
  var v4 = x4
  let x5 = t[i + 5]
  var v5 = x5
  let x6 = t[i + 6]
  var v6 = x6
  let x7 = t[i + 7]
  var v7 = x7
  let x8 = t[i + 8]
  var v8 = x8
  let x9 = t[i + 9]
  var v9 = x9
  let x10 = t[i + 10]
  var v10 = x10
  let x11 = t[i + 11]
  var v11 = x11
  let x12 = t[i + 12]
  var v12 = x12
  let x13 = t[i + 13]
  var v13 = x13
  let x14 = t[i + 14]
  var v14 = x14
  let x15 = t[i + 15]
  var v15 = x15
  v0 = fbm(v0, v4)
  v12 = rt.int_wrap(5, v12 ^ v0, 32)
  v8 = fbm(v8, v12)
  v4 = rt.int_wrap(5, v4 ^ v8, 24)
  v0 = fbm(v0, v4)
  v12 = rt.int_wrap(5, v12 ^ v0, 16)
  v8 = fbm(v8, v12)
  v4 = rt.int_wrap(5, v4 ^ v8, 63)
  v1 = fbm(v1, v5)
