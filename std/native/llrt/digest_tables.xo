/// a + b + 2 * lo(a) * lo(b), wrapping (fBlaMka, RFC 9106 3.6).
fn fbm(a: Int, b: Int) -> Int { a.wrapping_add(b).wrapping_add(((a & 0xFFFFFFFF).wrapping_mul(b & 0xFFFFFFFF)).wrapping_shl(1)) }

