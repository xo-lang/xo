// Tasks and scopes (core 7.1; the zero-C audit's B18, decision 0212
// stage 3, decision 0229's rules): the task's end, `t.await`, a scope's
// failed task and group handle, a task's fault raised where its scope
// closes, `s.cancel()`, and the program's task group (`os.tasks`). The task and scope records stay the C runtime's
// (xo_rt.c xo_task, xo_scope: allocation, the queue, the run, the
// scope's open and close); this module reads and writes them at the
// offsets below, which xo_rt.c asserts (`tasks.xo T_*`, `tasks.xo S_*`).
// It needs no C services: the empty list a canceled operation returns
// is a `[]` (empty_list; rt.sched_rt went in decision 0233 step 2).
//
// Generated code calls the exports (cabi.xo) directly; the C entry
// points forward for older xo's code.
use native/llrt/layout
use native/llrt/budget
use native/llrt/ctx
use native/llrt/det
use native/llrt/fault
use native/llrt/obj
use native/llrt/poll
use native/llrt/pool
use native/llrt/poolsetup
use native/llrt/raw
use native/llrt/rc
use native/llrt/rtstats
use native/llrt/sanhook
use native/llrt/sched
use native/llrt/tracerec
use native/llrt/stdio
use native/llrt/twflags
use native/rt

/// xo_task (248 bytes): the header (count, free function), the
/// cancellation node (56 bytes), the scope (not counted), the state
/// (atomic: 0 queued, 1 running, 2 done), the entry function, the result
/// list's drop function, the closure's code until it runs, the
/// result (a shared list of one), whether it unwound (a C int), whether
/// it is background and its handle consumed (C ints), the spawn site,
/// the lock of the waiters, the wait list of its awaiters, the scope
/// list's link, the gone count (atomic), the fault that ended it (three
/// malloc'd strings), the budget it was started under, the closure's
/// environment until it runs (shared; 0 for one that captures nothing).
const T_NODE = 16
const T_SCOPE = 72
const T_STATE = 80
const T_RUN = 88
const T_DROP = 96
const T_FL = 104
const T_RESULT = 112
const T_UNWOUND = 120
const T_BACKGROUND = 124
const T_CONSUMED = 128
// 132: free (T_TWO, the list of one form's flag, until seed 0.19.0)
const T_SITE = 136
const T_MU = 144
const T_WAITERS = 152
const T_SNEXT = 168
const T_FAULT_MSG = 184
const T_FAULT_LOC = 192
const T_FAULT_DETAIL = 200
const T_BUD = 208
const T_FENV = 216
/// the context the task runs on while it runs, else 0 (`xo dump`,
/// decision 0251)
pub const T_CTX = 224
/// the spawn's location (`file:line:col`, a static string: its bytes and
/// length; `xo dump`)
pub const T_LOC_P = 232
pub const T_LOC_N = 240
/// A --race build's ThreadSanitizer context of the task (decision 0273,
/// sanhook.xo task_new), made at its spawn, 0 once its run ended
const T_TSAN = 248
/// the spawner's C_TASK_DL (decision 0430), which the task's context
/// takes when it runs
const T_DEADLINE = 256
const T_SIZE = 264
const T_DONE = 2

/// xo_scope (472 bytes): the body's node, the lock of the list and the
/// failure fields, the first failed task and the first faulted task
/// (references).
const S_BODY = 16
const S_TASKS = 72
const S_OLD = 80
const S_NOLD = 88
const S_PARENT_NODE = 96
const S_MU = 104
const S_LIST = 384
const S_FAIL = 392
const S_CLOSED = 400
const S_DEADLINE = 408
const S_TIMED_OUT = 416
const S_FAULT = 424
const S_PRUNE_AT = 440
const S_CLOSING = 448
const S_BUD = 456
/// the context's C_TASK_DL before this scope's deadline lowered it
/// (decision 0430), restored at its close
const S_OLD_DL = 464
const S_SIZE = 472

/// An object's header (xo_hdr): its count and its free function.
const H_RC = 0
const H_FREE = 8

/// The pool record's worker count (pool.xo P_NCPU: 0 until the pool's
/// setup ran) and the thread locals of the fiber and worker record
/// (sched.xo TLS_FIB, TLS_W).
const P_NCPU = layout.P_NCPU
const TLS_FIB = 1
/// The thread local word of the thread's spare context (run_claimed;
/// sched.xo's table of the words).
const TLS_CTX_SPARE = 13
const TLS_W = 2

/// The spawn statistic (pool.xo ST_*).
const ST_SPAWN = 0

/// A cancellation node's canceled word (pool.xo N_CANCELED).
const N_CANCELED = layout.N_CANCELED
/// A wait list (xo_wl): its first and last entry. An entry (xo_went, 32
/// bytes, the context's own: ctx.xo C_WENT, a context waits on one list
/// at a time): the park, the previous and next entry, writer and granted
/// (C ints, the Mutex's).
const WL_FIRST = layout.WL_FIRST
const WL_LAST = layout.WL_LAST
const E_PARK = layout.E_PARK
const E_PREV = layout.E_PREV
const E_NEXT = layout.E_NEXT
const E_WRITER = layout.E_WRITER
/// The C's services (pool.xo RT_*).
/// tsan's ops: a release, an acquire (sanhook.xo, decision 0232).
const RT_TSAN_RELEASE = 22
const RT_TSAN_ACQUIRE = 23
const ACQ_REL = 3

const ACQUIRE = 1

fn ld(p: Int, off: Int) -> Int { rt.mem_load(p, off, 8) }

fn st(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 8) }

fn ld4(p: Int, off: Int) -> Int { rt.mem_load(p, off, 4) }

fn st4(p: Int, off: Int, v: Int) { rt.mem_store(p, off, v, 4) }

fn node_canceled(n: Int) -> Bool { rt.slot_load[Int](n + N_CANCELED, 0, ACQUIRE) != 0 }

/// The list a canceled operation returns while it unwinds: an immortal
/// empty list, as a `[]` is (rt.rl_empty: xo_empty_list, or on arm64 the
/// function's own read only copy, so never compare a list's address
/// with it; obj.is_immortal).
pub fn empty_list() -> Int {
  let e: List[Int] = []
  rt.obj_addr(e)
}

/// Blocks the context c until its park is signaled or, when cancelable,
/// its node is canceled (the C's park_wait: it flushes the pending
/// output, helps on a root thread, tells ThreadSanitizer).
pub fn park_wait(c: Int, cancelable: Bool) { park_wait_n(c, cancelable, true) }

/// park_wait; counted tells that the wait counts as blocked for the
/// deadlock check (a wait that something outside the program's tasks can
/// end does not).
pub fn park_wait_n(c: Int, cancelable: Bool, counted: Bool) {
  stdio.flush()
  // waiting is not running time (decision 0175)
  budget.pause(c)
  // a fiber parks; a root thread helps while it waits once the pool
  // exists (a program that only sleeps stays single threaded)
  let pl = ctx.pool()
  let f = rt.tlocal_get(TLS_FIB)
  var rw = 0
  if f == 0 && rt.slot_load(pl + P_NCPU, 0, ACQUIRE) != 0 {
    rw = poolsetup.root_worker(pl)
  }
  // in the test world nothing outside the program ends a wait (the
  // flags' static words: no C call on the wait's path)
  let counts = counted || twflags.virt()
  // the context's trace word (ctx.xo C_TRACE: a load of a record in
  // hand, not the static switch) for both hooks
  let tr = tracerec.built() && ld(c, ctx.C_TRACE) != 0
  if tracerec.built() && tr {
    // the reason its caller set (ctx.xo C_WHY), for the next park too
    tracerec.ev(tracerec.K_PARK, ld(c, ctx.C_WHY), c, 0)
  }
  // where the wait is, for `xo dump` (decision 0251) when no fiber holds
  // it
  st(c, ctx.C_PARK_FP, rt.frame_addr())
  pool.park_wait(pl, c, if cancelable { 1 } else { 0 }, if counts { 1 } else { 0 }, f, rw)
  // the reason and place hold while parked (`xo dump` reads them)
  st(c, ctx.C_PARK_FP, 0)
  st(c, ctx.C_WHY, 0)
  if tracerec.built() && tr {
    tracerec.ev(tracerec.K_RESUME, 0, c, 0)
  }
  sanhook.acquire(c + ctx.C_PARK)
  budget.resume(c)
}

/// A new object of n bytes, zeroed, with one reference and the C free
/// function in services record word k (ctx.xo SV_*_FREE). A handle a
/// Xo value holds is made with make_handle instead.
pub fn new_handle(n: Int, f: Int) -> Int { new_object(n, f) }

// Counted runtime handles (decision 0295). A handle is a record behind
// the runtime's 16 byte object header (the count at H_RC, the free hook's
// address at H_FREE); its own words start at HANDLE_FIELDS. The rules:
//
// 1. Make it with make_handle[T](n, rt.fn_addr("NAME")): n bytes with the
//    header, zeroed; it returns the Xo value T (an opaque std type), which
//    holds the one reference, and the record's address for writing the
//    fields. Nothing else to release: make_handle drops the count
//    rt.obj_at adds (new_handle then rt.obj_at without h_release leaks the
//    record).
// 2. NAME is a C ABI export (a cabi*.xo function, by that literal name)
//    that forwards to the module's free hook: rt.fn_addr takes only an
//    export's name.
// 3. The free hook releases what the fields own (descriptors, buffers,
//    other handles) and ends with free_handle(p), which frees the record
//    itself; a hook that returns without it leaks the record.
// 4. Read and write the fields with rt.mem_load and rt.mem_store at
//    HANDLE_FIELDS + 8 * i, from the address make_handle returned or
//    rt.obj_addr(value).
// 5. A handle returned as an address through a cabi export (netconn's
//    conn_new, listener_new) keeps new_handle: the export's caller adopts
//    the reference, so there is no T here. Its hook still ends with
//    free_handle.
//
// A golden program that drops the handle without closing it, run with
// XO_LEAKCHECK=1 (every exit 0 golden is), checks rules 1 and 3.

/// The offset of a handle's first field, after the object header.
pub const HANDLE_FIELDS = 16

/// A new handle of n bytes (header included), zeroed, whose last
/// reference calls the export at free: the value T holding its one
/// reference, and the record's address.
pub fn make_handle[T](n: Int, free: Int) -> (T, Int) {
  let p = new_object(n, free)
  let v = rt.obj_at[T](p)
  // obj_at counted it once more: the value holds the one reference
  h_release(p)
  (v, p)
}

/// Frees the record of a handle: the last call of its free hook, after
/// the fields' own resources are released.
pub fn free_handle(p: Int) { obj.free_obj(p) }

/// A cancellation point of the context c (xo_rt.c canceled): whether it
/// reports cancellation, c then unwinding.
pub fn canceled(c: Int) -> Bool {
  if budget.canceled(c) {
    st4(c, ctx.C_UNWINDING, 1)
    return true
  }
  false
}

/// `task.is_canceled()` (xo_rt.c xo_is_canceled): whether the current
/// context's innermost node is canceled, shielded or not.
pub fn is_canceled() -> Bool {
  // a scheduling point of a deterministic run (core 7.4, decision 0350)
  if det.built() {
    pool.det_point()
  }
  node_canceled(ld(ctx.cur(), ctx.C_NODE))
}

/// Adds entry e at the end of wait list l (the oldest waiter is first).
pub fn wl_add(l: Int, e: Int) {
  st(e, E_NEXT, 0)
  let last = ld(l, WL_LAST)
  st(e, E_PREV, last)
  if last != 0 {
    st(last, E_NEXT, e)
  } else {
    st(l, WL_FIRST, e)
  }
  st(l, WL_LAST, e)
}

pub fn wl_del(l: Int, e: Int) {
  let p = ld(e, E_PREV)
  let n = ld(e, E_NEXT)
  if p != 0 {
    st(p, E_NEXT, n)
  } else {
    st(l, WL_FIRST, n)
  }
  if n != 0 {
    st(n, E_PREV, p)
  } else {
    st(l, WL_LAST, p)
  }
}

/// Waits on wait list l of an object whose lock mu is held, mu held
/// again on return (xo_rt.c wl_wait): false when the context c was
/// canceled (and cancelable).
fn wl_wait(c: Int, mu: Int, l: Int, cancelable: Bool) -> Bool { wl_wait_as(c, mu, l, cancelable, 0) }

/// wl_wait with the entry's writer flag (a Mutex waiter that wants the
/// lock exclusively: 1).
pub fn wl_wait_as(c: Int, mu: Int, l: Int, cancelable: Bool, writer: Int) -> Bool {
  let e = c + ctx.C_WENT
  st(e, E_PARK, c + ctx.C_PARK)
  st4(e, E_WRITER, writer)
  st4(e, E_WRITER + 4, 0)
  pool.park_reset(c + ctx.C_PARK)
  wl_add(l, e)
  pool.unlock(mu)
  park_wait(c, cancelable)
  pool.lock_k(mu, pool.ST_LOCK_TASK)
  wl_del(l, e)
  !(cancelable && budget.canceled(c))
}

/// Whether anything but t's scope list and its running entry function
/// holds task t (xo_task_wanted): its handle, an awaiter, a scope's
/// failure slot. With neither the result cannot be read (a handle that
/// is gone does not come back), so an entry function whose closure
/// cannot fail reports the empty list instead of boxing its value (a
/// list, a share walk and a free a spawn whose handle was dropped,
/// 2026-10-17). t's count is shared: minus its references, two of them
/// the list's and the entry function's.
pub fn task_wanted(t: Int) -> Bool { rt.slot_load[Int](t, H_RC, 1) != -2 }

/// Records the result of the current task t (xo_task_done: a shared list
/// of one, consumed); failed tells that it is an error, which fails the
/// scope unless the handle is awaited or the task was canceled.
pub fn task_done(t: Int, rl: Int, failed: Int) {
  st(t, T_RESULT, rl)
  if failed == 0 || ld4(t, T_CONSUMED) != 0 || node_canceled(t + T_NODE) {
    return
  }
  fail_scope(t, S_FAIL)
}

/// Records t as the scope's first failed (off S_FAIL) or faulted
/// (S_FAULT) task, when it is the first, and then cancels the body and
/// every task (core 7.1, child failure).
fn fail_scope(t: Int, off: Int) {
  let s = ld(t, T_SCOPE)
  pool.lock_k(s + S_MU, pool.ST_LOCK_TASK)
  let first = ld(s, off) == 0
  if first {
    rc.inc(t)
    st(s, off, t)
  }
  pool.unlock(s + S_MU)
  if first {
    pool.node_cancel(ctx.pool(), s + S_BODY)
  }
}

/// Ends the current task t that unwound (xo_task_unwound: canceled, or
/// faulted, decision 0085): its scope then treats it like a failed child
/// and raises the fault where it closes. The fault record moves from the
/// context to the task.
pub fn task_unwound(t: Int) {
  let c = rt.tlocal_get(0)
  st4(c, ctx.C_UNWINDING, 0)
  st4(t, T_UNWOUND, 1)
  if ld4(c, ctx.C_FAULTING) == 0 {
    return
  }
  st4(c, ctx.C_FAULTING, 0)
  st(t, T_FAULT_MSG, ld(c, ctx.C_FAULT_MSG))
  st(t, T_FAULT_LOC, ld(c, ctx.C_FAULT_LOC))
  st(t, T_FAULT_DETAIL, ld(c, ctx.C_FAULT_DETAIL))
  st(c, ctx.C_FAULT_MSG, 0)
  st(c, ctx.C_FAULT_LOC, 0)
  st(c, ctx.C_FAULT_DETAIL, 0)
  fail_scope(t, S_FAULT)
}

/// Raises the fault of a task of scope s in the context that closed s
/// (xo_fault_rethrow, status 3 of xo_scope_close).
pub fn fault_rethrow(s: Int) {
  let c = ctx.cur()
  let t = ld(s, S_FAULT)
  fault.clear(c)
  let d = ld(t, T_FAULT_DETAIL)
  if d != 0 {
    fault.detail(c, d, raw.cstr_len(d))
  }
  fault.raise_cstrs(ld(t, T_FAULT_MSG), ld(t, T_FAULT_LOC))
}

/// `t.await` (xo_task_await, core 7.1): waits for t (a cancellation
/// point that unwinds) and returns its result list (a reference). The
/// location is the ln bytes at lp.
pub fn task_await(t: Int, lp: Int, ln: Int) -> Int {
  // a scheduling point of a deterministic run (core 7.4, decision 0350)
  if det.built() {
    pool.det_point()
  }
  let c = ctx.cur()
  if rt.slot_load[Int](t + T_STATE, 0, ACQUIRE) != T_DONE {
    if canceled(c) {
      return empty_list()
    }
    // not started yet: run it here (its spawn released it for
    // ThreadSanitizer: the queues are Xo, not instrumented)
    if sched.task_claim(t) != 0 {
      tsan(RT_TSAN_ACQUIRE, t)
      run_claimed(t, 2)
    }
    pool.lock_k(t + T_MU, pool.ST_LOCK_TASK)
    while rt.slot_load[Int](t + T_STATE, 0, ACQUIRE) != T_DONE {
      if tracerec.built() {
        rt.mem_store(c, ctx.C_WHY, tracerec.WHY_JOIN, 8)
      }
      if !wl_wait(c, t + T_MU, t + T_WAITERS, true) {
        pool.unlock(t + T_MU)
        st4(c, ctx.C_UNWINDING, 1)
        return empty_list()
      }
    }
    pool.unlock(t + T_MU)
  }
  // the task's end happens before what follows its await (finished
  // before, or waited for)
  tsan(RT_TSAN_ACQUIRE, t)
  if ld4(t, T_UNWOUND) != 0 {
    if canceled(c) {
      return empty_list()
    }
    fault.raise_str_at("awaited a task that was canceled before it finished", lp, ln)
  }
  task_result(t)
}

/// The result list of a finished task (xo_task_result, a reference): the
/// error of a failed task, for its scope.
pub fn task_result(t: Int) -> Int {
  let rl = ld(t, T_RESULT)
  rc.inc(rl)
  rl
}

/// The first failed task of scope s (a reference).
pub fn scope_fail_task(s: Int) -> Int {
  let f = ld(s, S_FAIL)
  rc.inc(f)
  f
}

/// The spawn site of scope s's first failed task, or -1.
pub fn scope_fail_site(s: Int) -> Int {
  let f = ld(s, S_FAIL)
  if f == 0 {
    return -1
  }
  ld(f, T_SITE)
}

/// `s.group()`: the same scope behind a Group handle (a reference).
pub fn scope_group(s: Int) -> Int {
  rc.inc(s)
  s
}

/// `s.cancel()` (xo_scope_cancel): cancels the scope's tasks, not the
/// body; tasks spawned later start under a fresh node. The node and the
/// array of the replaced ones are malloc'd at their own address (the C's
/// scope_free frees them).
pub fn scope_cancel(s: Int) {
  let fresh = rt.heap_large(56) - 8
  rt.mem_set(fresh, 0, 56)
  pool.lock_k(s + S_MU, pool.ST_LOCK_TASK)
  let old = ld(s, S_TASKS)
  let n = ld4(s, S_NOLD)
  let a0 = ld(s, S_OLD)
  let a = raw.c_resize(a0, 8 * (n + 1))
  st(a, 8 * n, old)
  st(s, S_OLD, a)
  st4(s, S_NOLD, n + 1)
  pool.node_link(fresh, s + S_BODY)
  st(s, S_TASKS, fresh)
  pool.unlock(s + S_MU)
  pool.node_cancel(ctx.pool(), old)
}

/// Makes scope s (0: none) the group `os.tasks` gives (xo_prog_group_set:
/// the group of the scope generated code opens around main and around
/// each test, core 7.1, decision 0109).
pub fn prog_group_set(s: Int) {
  if s != 0 {
    rc.inc(s)
  }
  let old = rt.slot_swap[Int](ctx.prog_group_word(), 0, s, ACQ_REL)
  if old != 0 {
    h_release(old)
  }
}

/// `os.tasks` (xo_prog_group): a reference to the program's group.
pub fn prog_group() -> Int {
  let s = rt.slot_load[Int](ctx.prog_group_word(), 0, ACQUIRE)
  if s == 0 {
    let q = "?"
    fault.raise_str_at("os.tasks is not available here", raw.data(q), 0)
  }
  rc.inc(s)
  s
}

// ---------------------------------------------------------------------------
// The spawn and the scope's open and close (B18 part 2)

/// The pool, set up at the first spawn (the C's pool_init: the worker
/// count, the spin rounds, the fiber stacks' settings, the statistics).
fn pool_ready() -> Int {
  let pl = ctx.pool()
  poolsetup.ready(pl)
  pl
}

/// A new object of n bytes, zeroed, whose header has one reference and
/// the free function at address f (a C ABI export, rt.fn_addr).
fn new_object(n: Int, f: Int) -> Int {
  let o = obj.alloc_obj(n)
  rt.mem_set(o, 0, n)
  st(o, H_RC, -1)
  st(o, H_FREE, f)
  o
}

/// Drops a reference to the object at p (xo_rt.c h_release): the last
/// one frees it (obj.xo h_free_n: its free function, deferred in a
/// real-time section).
pub fn h_release(p: Int) {
  if rc.dec(p) != 0 {
    obj.h_free_n(p)
  }
}

/// Signals the park p (the C's park_signal: ThreadSanitizer's release,
/// then pool.xo park_signal).
pub fn park_signal(p: Int) {
  tsan(RT_TSAN_RELEASE, p)
  pool.park_signal(ctx.pool(), p)
}

/// park_signal of a channel's hand off (pool.xo pool_push_handoff).
pub fn park_signal_handoff(p: Int) {
  tsan(RT_TSAN_RELEASE, p)
  pool.park_signal_handoff(ctx.pool(), p)
}

/// Tells ThreadSanitizer (when the C runtime is built with it) that a
/// releases (op RT_TSAN_RELEASE) or acquires (RT_TSAN_ACQUIRE).
fn tsan(op: Int, a: Int) {
  if ld(ctx.svc(), ctx.SV_TSAN) != 0 {
    if op == RT_TSAN_RELEASE {
      sanhook.release(a)
    } else {
      sanhook.acquire(a)
    }
  }
}

/// Counts the statistic k when the statistics count (XO_RTSTATS).
fn stat(k: Int) { rtstats.count(k) }

/// Starts a task in scope s (xo_task_spawn, `s.spawn(f)`; flags bit 0:
/// background, bit 1: its handle is bound and awaited, so its error does
/// not fail the scope). code and env are the closure's two words
/// (consumed; env shared, or 0): it crosses as itself, not in a list of
/// one (an allocation, a share walk and a free a spawn, 2026-10-16); run
/// is the entry function that calls it with them and t, drop the one
/// that releases its result list (a spawn on a scope that has ended
/// faults at the ln bytes at lp and gives the closure back, decision
/// 0085, through the environment's own drop; fdrop is unused). site
/// tells the scope which spawn failed.
/// (The list of one form, rt.task_spawn, went with seed 0.19.0, which
/// calls this.)
pub fn task_spawn_fn(s: Int, code: Int, env: Int, run: Int, drop: Int, fdrop: Int, flags: Int, site: Int, lp: Int, ln: Int, pc: Int) -> Int { spawn(s, code, env, run, drop, flags, site, lp, ln, pc) }

fn spawn(s: Int, fl: Int, env: Int, run: Int, drop: Int, flags: Int, site: Int, lp: Int, ln: Int, pc: Int) -> Int {
  let pl = pool_ready()
  stat(ST_SPAWN)
  var w = rt.tlocal_get(TLS_W)
  let own = w != 0
  if w == 0 {
    w = poolsetup.root_worker(pl)
  }
  // new_object's work with the size constant, so the zeroing is stores
  // of xzr (the arm64 backend's inline mem_set), not the runtime's
  // memset loop (162 instructions a spawn, 2026-10-16)
  let t = obj.alloc_obj(T_SIZE)
  rt.mem_set(t, 0, T_SIZE)
  st(t, H_FREE, rt.fn_addr("task_free"))
  // references: the handle returned, and the scope's list (which keeps
  // t alive while a queue holds it)
  st(t, H_RC, -2)
  st(t, T_RUN, run)
  st(t, T_DROP, drop)
  st(t, T_FL, fl)
  st(t, T_FENV, env)
  st4(t, T_BACKGROUND, flags & 1)
  st4(t, T_CONSUMED, (flags / 2) & 1)
  st(t, T_SITE, site)
  st(t, T_LOC_P, lp)
  st(t, T_LOC_N, ln)
  if flags & 4 != 0 {
    pool.site_prior(pl, t)
  }
  let cur = ctx.cur()
  if tracerec.built() && ld(cur, ctx.C_TRACE) != 0 {
    tracerec.ev(tracerec.K_SPAWN, tracerec.site(lp, ln), cur, t)
  }
  // the spawning context's budget (decision 0175)
  let bud = ld(cur, ctx.C_BUD)
  st(t, T_BUD, bud)
  st(t, T_DEADLINE, ld(cur, ctx.C_TASK_DL))
  budget.retain(bud)
  tsan(RT_TSAN_RELEASE, t)
  // its own ThreadSanitizer context (a --race build): made here, so what
  // the spawner did before the spawn happens before the task, and nothing
  // the spawner does after it
  st(t, T_TSAN, sanhook.task_new(pc))
  // linked into s, counted, and queued (pool.xo scope_add): the tasks it
  // pruned from s's list, or -1 when s has ended
  let r = pool.scope_add_at(pl, s, t, w, own)
  if r == -1 {
    budget.release(bud)
    sanhook.task_gone(ld(t, T_TSAN))
    obj.free_obj(t)
    env_release(env)
    fault.raise_str_at("a task was started on a scope that has ended", lp, ln)
  }
  // the pruned tasks: their nodes unlinked, the list's references
  // dropped (without s's lock: a result may run drop code)
  var dead = r
  while dead != 0 {
    let next = ld(dead, T_SNEXT)
    pool.node_unlink(dead + T_NODE)
    h_release(dead)
    dead = next
  }
  // a scheduling point of a deterministic run (core 7.4, decision 0350)
  if det.built() {
    pool.det_point()
  }
  t
}

/// Opens a scope in the current context (xo_scope_open): its body's
/// node below the context's, the node of its tasks below the body's, and
/// the context's node the body's.
pub fn scope_open() -> Int {
  let c = ctx.cur()
  let s = new_object(S_SIZE, rt.fn_addr("scope_free"))
  st(s, S_PRUNE_AT, 64)
  let parent = ld(c, ctx.C_NODE)
  st(s, S_PARENT_NODE, parent)
  pool.node_link(s + S_BODY, parent)
  // malloc'd at its own address: the C's scope_free frees it
  let tn = rt.heap_large(56) - 8
  rt.mem_set(tn, 0, 56)
  st(s, S_TASKS, tn)
  pool.node_link(tn, s + S_BODY)
  st(c, ctx.C_NODE, s + S_BODY)
  s
}

/// A scope of its own for an HTTP server's connection tasks (hserve.xo
/// srv_new; xo_http.c's xo_srv_new until the zero-C audit's B28 part 3):
/// as scope_open's, but its body's node hangs below link (main's root, so
/// canceling the serving task leaves the requests in flight alone) and
/// the context's node stays.
pub fn scope_detached(link: Int) -> Int {
  let c = ctx.cur()
  let s = new_object(S_SIZE, rt.fn_addr("scope_free"))
  st(s, S_PRUNE_AT, 64)
  st(s, S_PARENT_NODE, ld(c, ctx.C_NODE))
  pool.node_link(s + S_BODY, link)
  let tn = rt.heap_large(56) - 8
  rt.mem_set(tn, 0, 56)
  st(s, S_TASKS, tn)
  pool.node_link(tn, s + S_BODY)
  s
}

/// task.with_timeout's deadline (xo_rt.c xo_scope_deadline): scope s's
/// body is canceled d ns from now, and scope_timed_out tells it.
pub fn scope_deadline(s: Int, d: Int) {
  st(s, S_DEADLINE, poll.timer_fn(d, poll.FN_SCOPE, s))
  // what task.deadline reads in the body (decision 0430)
  let c = ctx.cur()
  let old = ld(c, ctx.C_TASK_DL)
  st(s, S_OLD_DL, old)
  let at = poll.deadline(d)
  if old == 0 || at < old {
    st(c, ctx.C_TASK_DL, at)
  }
}

/// The nearest task.with_timeout deadline in force in the current task
/// (decision 0430): the timers' ns, 0 for none.
pub fn cur_deadline() -> Int { ld(ctx.cur(), ctx.C_TASK_DL) }

/// After scope s closed while its body unwound: whether the unwinding
/// came from its deadline (and not from a cancellation of the code
/// around it), when the unwinding then stops (xo_rt.c xo_scope_timed_out).
pub fn scope_timed_out(s: Int) -> Bool {
  let c = ctx.cur()
  if rt.slot_load[Int](s + S_TIMED_OUT, 0, ACQUIRE) & 4294967295 == 0 || budget.canceled(c) {
    return false
  }
  rt.mem_store(c, ctx.C_UNWINDING, 0, 4)
  true
}

/// Ends scope s (xo_scope_close, core 7.1 exit rules). mode 0: the body
/// completed (background tasks are canceled); 1: it exits early (return,
/// break, an error: every task is canceled); 2: it unwinds (canceled).
/// It runs the tasks nobody started, waits for every task, and returns 1
/// when a child failed and its error must propagate out of the scope (an
/// unwinding body then stops unwinding), 3 when a task faulted (the
/// caller raises its fault), else 0.
pub fn scope_close(s: Int, mode: Int) -> Int {
  let c = ctx.cur()
  let pl = ctx.pool()
  if ld(s, S_DEADLINE) != 0 {
    poll.timer_end(ld(s, S_DEADLINE))
    st(s, S_DEADLINE, 0)
    st(c, ctx.C_TASK_DL, ld(s, S_OLD_DL))
  }
  pool.lock_k(s + S_MU, pool.ST_LOCK_TASK)
  // no pruning from here: the helpers below walk the list unlocked
  st4(s, S_CLOSING, 1)
  if mode == 0 {
    var t = ld(s, S_LIST)
    while t != 0 {
      if ld4(t, T_BACKGROUND) != 0 {
        pool.node_cancel(pl, t + T_NODE)
      }
      t = ld(t, T_SNEXT)
    }
  } else {
    pool.node_cancel(pl, ld(s, S_TASKS))
  }
  pool.unlock(s + S_MU)
  // the help, then the wait (not a cancellation point) for every task's
  // end and every queue entry (pool.xo scope_join); output written so far
  // goes out first (decision 0069)
  stdio.flush()
  // helping and waiting are not the closer's running time
  budget.pause(c)
  let f = rt.tlocal_get(TLS_FIB)
  var rw = 0
  if f == 0 && rt.slot_load[Int](pl + P_NCPU, 0, ACQUIRE) != 0 {
    rw = poolsetup.root_worker(pl)
  }
  pool.scope_join(pl, s, c, f, rw)
  tsan(RT_TSAN_ACQUIRE, c + ctx.C_PARK)
  // every task's end (its release of s) happens before the scope's close
  tsan(RT_TSAN_ACQUIRE, s)
  budget.resume(c)
  pool.lock_k(s + S_MU, pool.ST_LOCK_TASK)
  st4(s, S_CLOSED, 1)
  var list = ld(s, S_LIST)
  st(s, S_LIST, 0)
  pool.unlock(s + S_MU)
  // the tasks' nodes hang below the tasks' node (and the nodes s.cancel()
  // replaced): unlink those before the tasks go
  pool.node_unlink(ld(s, S_TASKS))
  let old = ld(s, S_OLD)
  for i in 0..ld4(s, S_NOLD) {
    pool.node_unlink(ld(old, 8 * i))
  }
  pool.node_unlink(s + S_BODY)
  while list != 0 {
    let next = ld(list, T_SNEXT)
    h_release(list)
    list = next
  }
  let parent = ld(s, S_PARENT_NODE)
  st(c, ctx.C_NODE, parent)
  if ld4(c, ctx.C_FAULTING) != 0 {
    // the body's own fault goes on (decision 0085)
    return 0
  }
  if ld(s, S_FAULT) != 0 {
    return 3
  }
  if ld(s, S_FAIL) == 0 {
    return 0
  }
  if mode == 2 {
    if node_canceled(parent) {
      // canceled from outside: keep unwinding
      return 0
    }
    st4(c, ctx.C_UNWINDING, 0)
  }
  1
}

/// `Atomic.new(v)` (xo_atomic_new, B19): the value at byte 128 (slot 13
/// of the slot atomics, decision 0200), on a cache line apart from the
/// count; a handle whose free function is the C's atomic_free.
pub fn atomic_new(v: Int) -> Int {
  let a = new_object(136, rt.fn_addr("atomic_free"))
  st(a, 128, v)
  a
}

// ---------------------------------------------------------------------------
// The handles' free functions (B18): the free function an object's header
// names (xo_h_free calls it with its last reference gone; the C takes
// these exports' addresses for the services record's SV_*_FREE words).

/// Releases the list l (a list of one) with its drop function, unless it
/// is 0 or immortal (an empty list: not one address, obj.is_immortal).
pub fn list_release(l: Int, drop: Int) {
  if l != 0 && !obj.is_immortal(l) {
    let _r = rt.call_c2(drop, l, 0)
  }
}

/// Frees the block at the malloc'd address b, unless it is 0.
fn mfree(b: Int) {
  if b != 0 {
    rt.heap_release(b)
  }
}

/// A task's (task_free): its budget, its result, the fault that ended it.
/// Drops a closure environment's reference (0: none), its drop function
/// (word 1) running when it was the last.
fn env_release(env: Int) {
  if env != 0 && rc.dec(env) == 1 {
    // through the export's address: a third direct call of rc_defer_n
    // made the arm64 inliner keep it out of line where faults drop
    // values (bench/perf/fault defer 1.021, owned 1.018), and this path
    // is rare (a spawn on a scope that has ended)
    let _r = rt.call_c2(rt.fn_addr("obj_rc_defer_n"), env, ld(env, 8))
  }
}

pub fn task_free(t: Int) {
  // a task that never ran (canceled before it started) still has its
  // ThreadSanitizer context
  sanhook.task_gone(ld(t, T_TSAN))
  budget.release(ld(t, T_BUD))
  list_release(ld(t, T_RESULT), ld(t, T_DROP))
  mfree(ld(t, T_FAULT_MSG))
  mfree(ld(t, T_FAULT_LOC))
  mfree(ld(t, T_FAULT_DETAIL))
  obj.free_obj(t)
}

/// A scope's (scope_free): its budget, its failed and faulted tasks, the
/// node of its tasks and the ones s.cancel() replaced.
pub fn scope_free(s: Int) {
  budget.release(ld(s, S_BUD))
  if ld(s, S_FAIL) != 0 {
    h_release(ld(s, S_FAIL))
  }
  if ld(s, S_FAULT) != 0 {
    h_release(ld(s, S_FAULT))
  }
  mfree(ld(s, S_TASKS))
  let old = ld(s, S_OLD)
  for i in 0..ld4(s, S_NOLD) {
    mfree(ld(old, 8 * i))
  }
  mfree(old)
  obj.free_obj(s)
}

/// An Atomic's (atomic_free).
pub fn atomic_free(a: Int) { obj.free_obj(a) }

// ---------------------------------------------------------------------------
// Running a task (run_claimed, B18): a context of its own, from the heap
// (Xo has no stack slots), for the task's run; the entry call's frame is
// the unwinding's boundary (run_entry, decision 0233).

const T_GONE = 176
const S_JOINER = 248
const RELEASE = 2

/// Calls t's entry function (its word T_RUN, a C ABI function of
/// generated code) with its closure fl and t, on the context c that
/// run_claimed made: the entry function catches a fault in the task, and
/// the unwinding never goes past this frame (decision 0085; was xo_rt.c
/// run_entry, rt.sched_rt op 29, until decision 0233's rt.frame_addr).
fn run_entry(c: Int, t: Int, fl: Int, env: Int) {
  st(c, ctx.C_BOUNDARY, rt.frame_addr())
  // the entry function takes the closure's two words and the task
  let _r = rt.call_c4(ld(t, T_RUN), fl, env, t, 0)
}

/// Wakes every context waiting in the list l (its mutex held).
pub fn wl_wake(l: Int) {
  var e = ld(l, 0)
  while e != 0 {
    stat(rtstats.SIG_TASK)
    park_signal(ld(e, E_PARK))
    e = ld(e, E_NEXT)
  }
}

/// Runs task t, which the caller claimed, on this stack (a fiber, or a
/// thread that helps); units (sched.xo scope_units_done) are over after.
pub fn run_claimed(t: Int, units: Int) {
  // the task's own ThreadSanitizer context for the run (a --race build,
  // decision 0273), then what its spawn did happens before it runs (the
  // spawn's release; the runtime is not instrumented)
  let tfib = rt.tlocal_get(TLS_FIB)
  let tw = rt.tlocal_get(TLS_W)
  let tctx = sanhook.task_enter(tfib, tw, ld(t, T_TSAN))
  st(t, T_TSAN, 0)
  tsan(RT_TSAN_ACQUIRE, t)
  // the context: the thread's spare (an earlier run's), else a new one
  // from the runtime's malloc (the C's was on its stack; a heap block
  // and its free per run cost spawn heavy programs, the zero-C perf
  // sweep of 2026-10-15). The thread's table once until the task runs
  // (nothing before parks; on macOS each tlocal_get or set across a call
  // was a _tlv_get_addr: 7 a spawn, 9% of spawn's cycles, 2026-10-17)
  let tb = rt.tlocal_addr()
  var c = ld(tb, 8 * TLS_CTX_SPARE)
  if c != 0 {
    st(tb, 8 * TLS_CTX_SPARE, 0)
  } else {
    c = rt.heap_large(ctx.C_SIZE)
  }
  rt.mem_set(c, 0, ctx.C_SIZE)
  st(c, ctx.C_NODE, t + T_NODE)
  rt.slot_store[Int](t + T_CTX, 0, c, RELEASE)
  let saved = ld(tb, 0)
  // a task started under a budget works under it (decision 0175); the
  // context it runs inline on does not run meanwhile
  budget.pause(saved)
  let b = ld(t, T_BUD)
  st(c, ctx.C_BUD, b)
  st(t, T_BUD, 0)
  st(c, ctx.C_TASK_DL, ld(t, T_DEADLINE))
  if b != 0 {
    st(c, ctx.C_BUD_Q, budget.QUANTUM)
    st(c, ctx.C_BUD_LEFT, budget.QUANTUM)
    budget.mark(c)
  }
  st(tb, 0, c)
  let fl = ld(t, T_FL)
  let env = ld(t, T_FENV)
  st(t, T_FL, 0)
  st(t, T_FENV, 0)
  rc.inc(t) // the entry function's own reference
  let tr = tracerec.built() && tracerec.on()
  if tracerec.built() && tr {
    st(c, ctx.C_TRACE, 1)
    tracerec.ev(tracerec.K_START, 0, c, t)
  }
  let st0 = pool.site_clock()
  run_entry(c, t, fl, env)
  pool.site_note(ctx.pool(), t, st0)
  rt.slot_store[Int](t + T_CTX, 0, 0, RELEASE)
  if tracerec.built() && tr {
    tracerec.ev(tracerec.K_END, 0, c, t)
  }
  if b != 0 {
    budget.charge(c, false)
    budget.release(b)
  }
  // the table of the thread that ends the run (a fiber may have moved)
  let te = rt.tlocal_addr()
  st(te, 0, saved)
  budget.resume(saved)
  mfree(ld(c, ctx.C_HELD))
  mfree(ld(c, ctx.C_NET_MSG))
  fault.clear(c)
  // that thread's spare; a spare is never freed (one per thread, like a
  // root context), so the leak check does not see it
  if ld(te, 8 * TLS_CTX_SPARE) == 0 {
    st(te, 8 * TLS_CTX_SPARE, c)
  } else {
    rt.heap_release(c - 8)
  }
  let s = ld(t, T_SCOPE)
  // what the task did happens before its await and its scope's close
  // (their acquires)
  tsan(RT_TSAN_RELEASE, t)
  tsan(RT_TSAN_RELEASE, s)
  pool.lock_k(t + T_MU, pool.ST_LOCK_TASK)
  rt.slot_store[Int](t + T_STATE, 0, T_DONE, RELEASE)
  wl_wake(t + T_WAITERS)
  pool.unlock(t + T_MU)
  // the last touch of t: a spawn may prune it after (scope_prune)
  rt.slot_add[Int](t + T_GONE, 0, units / 2, RELEASE)
  // the last touch of s: the scope's join may free it after
  if sched.scope_units_done(s, units) != 0 {
    // the joiner waits for this signal, so s is still there
    stat(rtstats.SIG_TASK)
    park_signal(ld(s, S_JOINER))
  }
  sanhook.task_exit(tfib, tw, tctx)
}
