// The C path of the HTTP/1.1 server's request parsing (decision 0193 step
// 6): the API of http1.xo over std/llrt/xo_http.c, which then parses
// request heads and chunked bodies itself (hc_read never returns 3 or 4).
// Loaded in place of http1.xo when XO_LLRT_C names `http1`, to compare
// the two and to fall back while the Xo path misses decision 0180's bar.
// The self hosted compiler always uses http1.xo.
use native/rthttp

/// The HTTP/1.1 requests of a server connection.
pub struct Reader {
  h: rthttp.HConn
}

pub fn reader(h: rthttp.HConn) -> Reader { Reader{h: h} }

/// The request std/rt's serve hands to Xo code (Request's parts).
pub struct Req {
  pub method: Str
  pub path: Str
  pub scheme: Str
  pub host: Str
  pub port: Int
  pub headers: List[Str]
  pub query: List[Str]
}

/// The next request (its body read; rthttp.hc_body), or None when the
/// connection is done.
pub fn (var r: Reader) read() -> Req? {
  if rthttp.hc_read(r.h) != 1 {
    return None
  }
  var headers: List[Str] = []
  for i in 0..rthttp.hc_nheaders(r.h) {
    headers.push(rthttp.hc_hname(r.h, i))
    headers.push(rthttp.hc_hval(r.h, i))
  }
  var query: List[Str] = []
  for i in 0..rthttp.hc_nquery(r.h) {
    query.push(rthttp.hc_qkey(r.h, i))
    query.push(rthttp.hc_qval(r.h, i))
  }
  Some(Req{method: rthttp.hc_method(r.h), path: rthttp.hc_path(r.h), scheme: rthttp.hc_scheme(r.h), host: rthttp.hc_host(r.h), port: rthttp.hc_port(r.h), headers: headers, query: query})
}

pub fn query_parts(q: Str) -> List[Str] { rthttp.query_parts(q) }

pub fn url_parts(s: Str, request: Bool) -> List[Str] { rthttp.url_parts(s, request) }

pub fn url_error(s: Str) -> Str { rthttp.url_error(s) }

pub fn path_unescape(s: Str) -> Str { rthttp.path_unescape(s) }

pub fn query_escape(s: Str) -> Str { rthttp.query_escape(s) }

pub fn go_quote(s: Str) -> Str { rthttp.go_quote(s) }

pub fn canonical_key(s: Str) -> Str { rthttp.canonical_key(s) }

pub fn equal_fold(a: Str, b: Str) -> Bool { rthttp.equal_fold(a, b) }
