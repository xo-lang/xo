// std/log on the native backends (decision 0074): records to standard
// error as std/rt/log.go writes them (text: time, level, message, then
// key=value fields; JSON: an object with sorted keys).
use std/log
use native/llrt/atexit
use native/llrt/cabi_log
use native/llrt/loghand
use native/llrt/logstate
use native/llrt/sysio
use native/llrt/text
use native/llrt/testworld
use native/rt
use native/rtjson

// Each takes the dependency that calls it (decision 0173) at entry: the
// code generator sets it just before a dependency's call.
fn debug(msg: Str, fields: Map[Str, Debug] = {}) { record(1, msg, fields, logstate.take_from()) }

fn info(msg: Str, fields: Map[Str, Debug] = {}) { record(2, msg, fields, logstate.take_from()) }

fn warn(msg: Str, fields: Map[Str, Debug] = {}) { record(3, msg, fields, logstate.take_from()) }

fn error(msg: Str, fields: Map[Str, Debug] = {}) { record(4, msg, fields, logstate.take_from()) }

/// log.Logger: the fields every record gets and the module the logger was
/// made in (decision 0173's attribution, taken when `with` ran).
struct Logger {
  fields: Map[Str, Debug]
  from: Str
  /// with_group's levels, outermost first: each group's name and the
  /// fields `with` gave under it (decision 0678).
  groups: List[(Str, Map[Str, Debug])] = []
}

fn with(fields: Map[Str, Debug]) -> log.Logger {
  rt.cast[Logger, log.Logger](Logger{fields: fields, from: logstate.take_from()})
}

/// a's fields then b's, b's value kept for a name in both.
fn merged(a: Map[Str, Debug], b: Map[Str, Debug]) -> Map[Str, Debug] {
  if b.is_empty() {
    return a
  }
  var m = a
  for (k, v) in b {
    m.put(k, v)
  }
  m
}

fn (l: Logger) with(fields: Map[Str, Debug]) -> log.Logger {
  if l.groups.is_empty() {
    return rt.cast[Logger, log.Logger](l with {fields: merged(l.fields, fields)})
  }
  var gs = l.groups
  let n = gs.len() - 1
  gs.set(n, (gs[n].0, merged(gs[n].1, fields)))
  rt.cast[Logger, log.Logger](l with {groups: gs})
}

fn (l: Logger) with_group(name: Str) -> log.Logger {
  if name.is_empty() {
    return rt.cast[Logger, log.Logger](l)
  }
  var gs = l.groups
  let empty: Map[Str, Debug] = {}
  gs.push((name, empty))
  rt.cast[Logger, log.Logger](l with {groups: gs})
}

/// l's fields with a record's: the record's under the innermost group,
/// each group a log.group field of the level around it (decision 0678).
fn logger_fields(l: Logger, fields: Map[Str, Debug]) -> Map[Str, Debug] {
  if l.groups.is_empty() {
    return merged(l.fields, fields)
  }
  var i = l.groups.len() - 1
  var acc = merged(l.groups[i].1, fields)
  while i >= 0 {
    var parent = if i == 0 { l.fields } else { l.groups[i - 1].1 }
    if !acc.is_empty() {
      var g: Map[Str, Debug] = {}
      g.put(l.groups[i].0, group(acc))
      parent = merged(parent, g)
    }
    acc = parent
    i -= 1
  }
  acc
}

fn (l: Logger) debug(msg: Str, fields: Map[Str, Debug] = {}) { record(1, msg, logger_fields(l, fields), l.from) }

fn (l: Logger) info(msg: Str, fields: Map[Str, Debug] = {}) { record(2, msg, logger_fields(l, fields), l.from) }

fn (l: Logger) warn(msg: Str, fields: Map[Str, Debug] = {}) { record(3, msg, logger_fields(l, fields), l.from) }

fn (l: Logger) error(msg: Str, fields: Map[Str, Debug] = {}) { record(4, msg, logger_fields(l, fields), l.from) }

// Groups (decision 0678). A Debug value reaches std/log as its text
// (the native backends' xo.dyn keeps no value), so a Group's Display text
// is an encoding value_of reads back: GROUP_MARK, then each member's key,
// a kind letter and its payload, the key and payload with their byte
// length first (`6:method` `s` `3:GET`).
const GROUP_MARK = "\u{1e}xo.log.group\u{1e}"

/// log.Group: its members as log.Values, in the order given.
struct Group {
  fields: Map[Str, log.Value]
}

fn group(fields: Map[Str, Debug]) -> log.Group {
  var vs: Map[Str, log.Value] = {}
  for (k, v) in fields {
    vs.put(k, value_of(v))
  }
  rt.cast[Group, log.Group](Group{fields: vs})
}

fn (g: Group) display() -> Str { GROUP_MARK + group_enc(g.fields) }

fn (g: Group) debug() -> Str { dotted(g.fields) }

fn lenp(s: Str) -> Str { "${s.len()}:${s}" }

fn group_enc(fs: Map[Str, log.Value]) -> Str {
  var out = ""
  for (k, v) in fs {
    let (tag, p) = match v {
      log.Value.Str(s) => ("s", s)
      log.Value.Int(n) => ("i", "${n}")
      log.Value.UInt(n) => ("u", "${n.to_bits()}")
      log.Value.Float(f) => ("f", "${f.to_bits()}")
      log.Value.Bool(b) => ("b", if b { "1" } else { "0" })
      log.Value.Group(m) => ("g", group_enc(m))
      _ => ("a", value_text(v))
    }
    out = out + lenp(k) + tag + lenp(p)
  }
  out
}

/// The length-prefixed piece of s at byte i and the index after it.
fn piece_at(s: Str, i: Int) -> (Str, Int)? {
  let rest = s[i..s.len()]
  let c = rest.find(":")?
  let n = Int.parse(rest[0..c])?
  if n < 0 || c + 1 + n > rest.len() {
    return None
  }
  Some((rest[c + 1..c + 1 + n], i + c + 1 + n))
}

fn group_dec(s: Str) -> Map[Str, log.Value]? {
  var m: Map[Str, log.Value] = {}
  var i = 0
  while i < s.len() {
    let (k, a) = piece_at(s, i)?
    if a >= s.len() {
      return None
    }
    // the tag byte compared as a byte: a one-byte Str slice per field
    // was a cost note (XO0913)
    let tag = Int(s.bytes()[a])
    let (p, b) = piece_at(s, a + 1)?
    let v = match tag {
      115 => log.Value.Str(s: p) // s
      105 => log.Value.Int(n: Int.parse(p)?) // i
      117 => log.Value.UInt(n: UInt64.from_bits(Int.parse(p)?)) // u
      102 => log.Value.Float(f: Float.from_bits(Int.parse(p)?)) // f
      98 => log.Value.Bool(b: p == "1") // b
      103 => log.Value.Group(fields: group_dec(p)?) // g
      _ => log.Value.Any(text: p)
    }
    m.put(k, v)
    i = b
  }
  Some(m)
}

/// A value's text as the text format writes it (a group's dotted form).
fn value_text(v: log.Value) -> Str {
  match v {
    log.Value.Str(s) => s
    log.Value.Int(n) => "${n}"
    log.Value.UInt(n) => "${n}"
    log.Value.Float(f) => "${f}"
    log.Value.Bool(b) => "${b}"
    log.Value.Time(t) => "${t}"
    log.Value.Dur(d) => "${d}"
    log.Value.Any(text) => text
    log.Value.Group(fs) => dotted(fs)
  }
}

fn join_key(prefix: Str, k: Str) -> Str { if prefix.is_empty() { k } else { "${prefix}.${k}" } }

/// fs's members under prefix as (dotted key, text): a group's members
/// under its key (beside the others for an empty key).
fn flat(prefix: Str, fs: Map[Str, log.Value]) -> List[(Str, Str)] {
  var out: List[(Str, Str)] = []
  for (k, v) in fs {
    match v {
      log.Value.Group(m) => out = out + flat(if k.is_empty() { prefix } else { join_key(prefix, k) }, m)
      _ => out.push((join_key(prefix, k), value_text(v)))
    }
  }
  out
}

fn dotted(fs: Map[Str, log.Value]) -> Str {
  var parts: List[Str] = []
  for (k, t) in flat("", fs) {
    parts.push("${k}=${t}")
  }
  parts.join(" ")
}

/// fs with Go's rules: a group with an empty key inlined, an empty group
/// left out.
fn norm(fs: Map[Str, log.Value]) -> Map[Str, log.Value] {
  var out: Map[Str, log.Value] = {}
  for (k, v) in fs {
    match v {
      log.Value.Group(m) => {
        let n = norm(m)
        if !n.is_empty() {
          if k.is_empty() {
            for (k2, v2) in n {
              out.put(k2, v2)
            }
          } else {
            out.put(k, log.Value.Group(fields: n))
          }
        }
      }
      _ => out.put(k, v)
    }
  }
  out
}

/// A record's fields: the flat text view (Record.fields, dotted keys)
/// and the values (Record.values, groups nested), by Go's group rules.
/// expand's values alone: a JSON record needs no text view (each field's
/// dyn_text), only the values (task #271: std/log json against
/// log/slog).
fn expand_values(fields: Map[Str, Debug]) -> Map[Str, log.Value] {
  var vs: Map[Str, log.Value] = {}
  for (k, v) in fields {
    let val = value_of(v)
    match val {
      log.Value.Group(_) => {
        var one: Map[Str, log.Value] = {}
        one.put(k, val)
        for (k2, v2) in norm(one) {
          vs.put(k2, v2)
        }
      }
      _ => vs.put(k, val)
    }
  }
  vs
}

fn expand(fields: Map[Str, Debug]) -> (Map[Str, Str], Map[Str, log.Value]) {
  var fs: Map[Str, Str] = {}
  var vs: Map[Str, log.Value] = {}
  for (k, v) in fields {
    let val = value_of(v)
    match val {
      log.Value.Group(_) => {
        var one: Map[Str, log.Value] = {}
        one.put(k, val)
        let n = norm(one)
        for (k2, v2) in n {
          vs.put(k2, v2)
        }
        for (k2, t) in flat("", n) {
          fs.put(k2, t)
        }
      }
      _ => {
        fs.put(k, rt.dyn_text(v))
        vs.put(k, val)
      }
    }
  }
  (fs, vs)
}

/// A value in a JSON record: numbers and booleans bare, a group an
/// object, the others strings.
fn json_value(v: log.Value) -> Str {
  match v {
    log.Value.Int(_) | log.Value.UInt(_) | log.Value.Bool(_) => value_text(v)
    log.Value.Float(f) => rtjson.json_enc("", f)
    log.Value.Group(m) => {
      var es: List[(Str, Str)] = []
      for (k, x) in m {
        es.push((k, json_value(x)))
      }
      json_obj(es)
    }
    _ => rtjson.json_enc("", value_text(v))
  }
}

/// A JSON object of es, keys sorted (encoding/json of a map; a later
/// entry replaces an earlier one of the same key).
fn json_obj(es: List[(Str, Str)]) -> Str {
  var keys: List[Str] = []
  var vals: List[Str] = []
  for (k, j) in es {
    var found = false
    for (i, x) in keys.indexed() {
      if x == k {
        vals.set(i, j)
        found = true
      }
    }
    if !found {
      keys.push(k)
      vals.push(j)
    }
  }
  // the keys in order, by insertion (a record has a handful; no
  // closure or second list for sort_by)
  var order: List[Int] = []
  for i in 0..keys.len() {
    var j = order.len()
    order.push(i)
    while j > 0 && keys[order[j - 1]] > keys[i] {
      order.set(j, order[j - 1])
      j -= 1
    }
    order.set(j, i)
  }
  var line = "{"
  for (n, i) in order.indexed() {
    if n > 0 {
      line = line + ","
    }
    line = rtjson.json_enc(line, keys[i]) + ":" + vals[i]
  }
  line + "}"
}

fn enabled(level: log.Level) -> Bool {
  if logstate.has_handler() {
    if let Some(h) = loghand.current() {
      return h.enabled(level)
    }
  }
  let n = match level {
    log.Level.Debug => 1
    log.Level.Info => 2
    log.Level.Warn => 3
    log.Level.Error => 4
  }
  n >= logstate.level()
}

fn configure(out: Stdio, level: log.Level = log.Level.Info, format: log.Format = log.Format.Text) uses stdio {
  let n = match level {
    log.Level.Debug => 1
    log.Level.Info => 2
    log.Level.Warn => 3
    log.Level.Error => 4
  }
  loghand.release(logstate.clear_handler())
  logstate.configure(n, format is log.Format.Json)
}

fn configure_handler(h: log.Handler) uses stdio {
  let l: List[log.Handler] = [h]
  // Mutex.new shares what it holds, so every thread may read l
  let _m = Mutex.new(l)
  // the call sites' guard (llrt_log_enabled) lets through the lowest
  // level the handler takes; record asks it again for each record
  var min = 5
  for n in [4, 3, 2, 1] {
    if h.enabled(level_of(n)) {
      min = n
    }
  }
  // released at exit (entry.xo, decision 0233); a WASI module has no
  // function addresses: log.configure releases it there
  if target.arch != TargetArch.Wasm32 {
    atexit.set_log(rt.fn_addr("log_free"))
  }
  loghand.release(logstate.set_handler(rt.obj_addr(l), min))
}

/// A field's log.Value from what the call site's interface value keeps:
/// its raw flag (Int, Float, Bool, UInt64, set from the static type) and
/// text, and its Debug text (a Str's is quoted). Time, Duration and
/// other types are Any (their text). rt.dyn_kind and rt.dyn_bits carry
/// the static type's kind and word for every kind; std reads them once a
/// seed knows them (gotchas/seed-older-than-intrinsics.md).
fn value_of(v: Debug) -> log.Value {
  let t = rt.dyn_text(v)
  if t.starts_with(GROUP_MARK) {
    if let Some(m) = group_dec(t[GROUP_MARK.len()..t.len()]) {
      return log.Value.Group(fields: m)
    }
  }
  if rt.dyn_raw(v) {
    if t == "true" || t == "false" {
      return log.Value.Bool(b: t == "true")
    }
    if let Some(n) = Int.parse(t) {
      return log.Value.Int(n: n)
    }
    if t.len() == 20 && !t.starts_with("-") && !t.contains(".") {
      // a UInt64 above Int's range: its 20 digits, wrapping
      var w = 0
      for c in t.bytes() {
        w = w.wrapping_mul(10).wrapping_add(Int(c) - 48)
      }
      return log.Value.UInt(n: UInt64.from_bits(w))
    }
    if let Some(f) = Float.parse(t) {
      return log.Value.Float(f: f)
    }
    return log.Value.Any(text: t)
  }
  let d = v.debug()
  if d.len() >= 2 && d.starts_with("\"") && d != t {
    return log.Value.Str(s: t)
  }
  log.Value.Any(text: t)
}

fn level_of(n: Int) -> log.Level {
  match n {
    1 => log.Level.Debug
    2 => log.Level.Info
    3 => log.Level.Warn
    _ => log.Level.Error
  }
}

fn level_name(level: Int) -> Str {
  match level {
    1 => "DEBUG"
    2 => "INFO"
    3 => "WARN"
    _ => "ERROR"
  }
}

fn record(level: Int, msg: Str, fields: Map[Str, Debug], from: Str) {
  let cur = if logstate.has_handler() { loghand.current() } else { None }
  if let Some(h) = cur {
    let lv = level_of(level)
    if h.enabled(lv) {
      let (fs, vs) = expand(fields)
      if testworld.on() {
        // testing.logs keeps it (decision 0083); the handler writes it
        var keys: List[Str] = []
        var vals: List[Str] = []
        for (k, v) in fs {
          keys.push(k)
          vals.push(v)
        }
        testworld.log(level, msg, from, keys, vals, "")
      }
      h.handle(log.Record{level: lv, msg: msg, fields: fs, module: from, time: Time.from_unix_nanos(sysio.clock_now()), values: vs})
    }
    return
  }
  if level < logstate.level() {
    return
  }
  if logstate.json() && !testworld.on() {
    // a JSON record outside a test: the values only (no text view)
    rt.eprintln(go_html(format_json(level, msg, expand_values(fields), from)))
    return
  }
  let (fs, vs) = expand(fields)
  let line = format(level, msg, fs, vs, from)
  if testworld.on() {
    // a test keeps its records (testing.logs, decision 0083); without a
    // configured output the line goes to the test's buffer (printed when
    // the test fails), with one to the fake standard error (std/rt's
    // logRecord)
    var keys: List[Str] = []
    var vals: List[Str] = []
    for (k, t) in fs {
      keys.push(k)
      vals.push(t)
    }
    if !logstate.configured() {
      testworld.log(level, msg, from, keys, vals, line)
      return
    }
    testworld.log(level, msg, from, keys, vals, "")
  }
  // the native backends' SSA builders call std/native/llrt/stdio.xo for
  // it (the native prelude's llrt_eprintln, work item B03)
  rt.eprintln(line)
}

/// A JSON record as Go's json.Marshal writes it (the Go backend's): <, >
/// and & escaped, which std/json leaves as they are. They occur only
/// inside the record's strings.
fn go_html(line: Str) -> Str {
  if !line.contains("<") && !line.contains(">") && !line.contains("&") {
    return line
  }
  line.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")
}

/// format's JSON record before go_html, appended into one Str: the keys
/// sorted (time, level and msg unless a field replaces them, module for
/// the attribution), with no list of entries or per-value Strs (std/log
/// json against log/slog, task #88).
fn format_json(level: Int, msg: Str, vs: Map[Str, log.Value], from: Str) -> Str {
  var keys: List[Str] = List.with_capacity(vs.len() + 4)
  keys.push("level")
  keys.push("msg")
  keys.push("time")
  for (k, _) in vs {
    if k != "level" && k != "msg" && k != "time" && !(k == "module" && from != "") {
      key_insert(keys, k)
    }
  }
  if from != "" {
    key_insert(keys, "module")
  }
  // one allocation for a usual record (the time, level and keys take
  // about 60 bytes)
  var line = rt.rs_with_cap(128 + msg.len()) + "{"
  for (n, k) in keys.indexed() {
    if n > 0 {
      line = line + ","
    }
    line = rtjson.json_enc(line, k) + ":"
    if from != "" && k == "module" {
      line = rtjson.json_enc(line, from)
    } else if let Some(v) = vs.get(k) {
      line = json_value_to(line, v)
    } else if k == "time" {
      line = rtjson.json_enc(line, logstate.now(true))
    } else if k == "level" {
      line = rtjson.json_enc(line, level_name(level))
    } else {
      line = rtjson.json_enc(line, msg)
    }
  }
  line + "}"
}

/// k into the sorted keys, by insertion (a record has a handful).
fn key_insert(var keys: List[Str], k: Str) {
  var j = keys.len()
  keys.push(k)
  while j > 0 && keys[j - 1] > k {
    keys.set(j, keys[j - 1])
    j -= 1
  }
  keys.set(j, k)
}

/// acc + json_value(v), appended.
fn json_value_to(acc: Str, v: log.Value) -> Str {
  match v {
    log.Value.Int(n) => rtjson.json_enc(acc, n)
    log.Value.UInt(n) => rtjson.json_enc(acc, n)
    log.Value.Bool(b) => rtjson.json_enc(acc, b)
    log.Value.Float(f) => rtjson.json_enc(acc, f)
    log.Value.Group(_) => acc + json_value(v)
    log.Value.Str(s) => rtjson.json_enc(acc, s)
    _ => rtjson.json_enc(acc, value_text(v))
  }
}

/// The text of a record: JSON when configured so, else text. fs is the
/// flat text view (dotted keys), vs the values (groups nested).
fn format(level: Int, msg: Str, fs: Map[Str, Str], vs: Map[Str, log.Value], from: Str) -> Str {
  if logstate.json() {
    // encoding/json of a map: keys sorted; a field replaces time, level
    // or msg, the attribution replaces a field named "module"
    return go_html(format_json(level, msg, vs, from))
  }
  var tag = ""
  if from != "" {
    tag = "[${from}] "
  }
  var line = "${logstate.now(false)} ${level_name(level)} ${tag}${msg}"
  for (k, t) in fs {
    line = line + " ${k}=${t}"
  }
  line
}

// The built-in sinks and handlers (decision 0617 C). Their effects are
// the declarations' (std/log.xo); here they are plain calls.

struct StdSink {
  out: Stdio
  err: Bool
}

fn (s: StdSink) write_line(line: Str) -> () ! Str uses stdio {
  if s.err {
    s.out.eprintln(line)
  } else {
    s.out.println(line)
  }
  Ok(())
}

struct FileSink {
  f: File
}

fn (s: FileSink) write_line(line: Str) -> () ! Str uses fs.write {
  match s.f.write((line + "\n").bytes()) {
    Ok(_) => Ok(())
    Err(e) => Err("${e}")
  }
}

struct ConnSink {
  c: Conn
}

fn (s: ConnSink) write_line(line: Str) -> () ! Str uses net.dial {
  match s.c.write((line + "\n").bytes()) {
    Ok(_) => Ok(())
    Err(e) => Err("${e}")
  }
}

struct FuncSink[fx: Effects] {
  f: fn(Str) uses fx
}

fn (s: FuncSink[fx]) write_line(line: Str) -> () ! Str uses fx {
  s.f(line)
  Ok(())
}

fn stderr_sink(out: Stdio) -> log.Sink[stdio] { StdSink{out: out, err: true} }

fn stdout_sink(out: Stdio) -> log.Sink[stdio] { StdSink{out: out, err: false} }

fn file_sink(f: File) -> log.Sink[fs.write] { FileSink{f: f} }

fn conn_sink(c: Conn) -> log.Sink[net.dial] { ConnSink{c: c} }

fn func_sink[fx: Effects](f: fn(Str) uses fx) -> log.Sink[fx] { FuncSink{f: f} }

fn rank(level: log.Level) -> Int {
  match level {
    log.Level.Debug => 1
    log.Level.Info => 2
    log.Level.Warn => 3
    log.Level.Error => 4
  }
}

/// text_handler and json_handler: configure's lines.
struct LineHandler[fx: Effects] {
  out: log.Sink[fx]
  min: Int
  json: Bool
}

fn (h: LineHandler[fx]) enabled(level: log.Level) -> Bool { rank(level) >= h.min }

fn (h: LineHandler[fx]) handle(r: log.Record) uses fx {
  if let Err(_) = h.out.write_line(render(h.json, r)) {
    logstate.add_dropped()
  }
}

fn text_handler[fx: Effects](out: log.Sink[fx], level: log.Level = log.Level.Info) -> log.Handler[fx] { LineHandler{out: out, min: rank(level), json: false} }

fn json_handler[fx: Effects](out: log.Sink[fx], level: log.Level = log.Level.Info) -> log.Handler[fx] { LineHandler{out: out, min: rank(level), json: true} }

struct MultiHandler[fx: Effects] {
  hs: List[log.Handler[fx]]
}

fn (m: MultiHandler[fx]) enabled(level: log.Level) -> Bool {
  for h in m.hs {
    if h.enabled(level) {
      return true
    }
  }
  false
}

fn (m: MultiHandler[fx]) handle(r: log.Record) uses fx {
  for h in m.hs {
    if h.enabled(r.level) {
      h.handle(r)
    }
  }
}

fn multi[fx: Effects](hs: List[log.Handler[fx]]) -> log.Handler[fx] { MultiHandler{hs: hs} }

struct RangeHandler[fx: Effects] {
  h: log.Handler[fx]
  min: Int
  max: Int
}

fn (g: RangeHandler[fx]) enabled(level: log.Level) -> Bool { rank(level) >= g.min && rank(level) <= g.max && g.h.enabled(level) }

fn (g: RangeHandler[fx]) handle(r: log.Record) uses fx {
  if rank(r.level) >= g.min && rank(r.level) <= g.max {
    g.h.handle(r)
  }
}

fn level_range[fx: Effects](h: log.Handler[fx], min: log.Level, max: log.Level) -> log.Handler[fx] { RangeHandler{h: h, min: rank(min), max: rank(max)} }

fn dropped() -> Int { logstate.dropped() }

/// A record's line as configure writes it (format): text, or a JSON
/// object with sorted keys whose Int, UInt, Float and Bool values are
/// JSON numbers and booleans.
fn render(json: Bool, r: log.Record) -> Str {
  let level = rank(r.level)
  let ns = r.time.unix_nanos()
  if json {
    var es: List[(Str, Str)] = [("time", rtjson.json_enc("", text.append_time("", ns))), ("level", rtjson.json_enc("", level_name(level))), ("msg", rtjson.json_enc("", r.msg))]
    for (k, t) in r.fields {
      if let Some(dot) = k.find(".") {
        // a group's member: the group's value writes it (decision 0678)
        if let Some(log.Value.Group(_)) = r.values.get(k[0..dot]) {
          continue
        }
      }
      let j = match r.values.get(k) {
        Some(log.Value.Int(_)) | Some(log.Value.UInt(_)) | Some(log.Value.Bool(_)) => t
        Some(log.Value.Float(f)) => rtjson.json_enc("", f)
        _ => rtjson.json_enc("", t)
      }
      es.push((k, j))
    }
    for (k, v) in r.values {
      if let log.Value.Group(_) = v {
        es.push((k, json_value(v)))
      }
    }
    if r.module != "" {
      es.push(("module", rtjson.json_enc("", r.module)))
    }
    return go_html(json_obj(es))
  }
  let secs = ns - (ns % 1000000000 + 1000000000) % 1000000000
  var tag = ""
  if r.module != "" {
    tag = "[${r.module}] "
  }
  var line = "${text.append_time("", secs)} ${level_name(level)} ${tag}${r.msg}"
  for (k, t) in r.fields {
    line = line + " ${k}=${t}"
  }
  line
}

