use std/yaml
use std/yamlcodec

struct Mark {
  index: Int
  line: Int
  column: Int
}

// Error kinds (yaml_error_type_t).
const NO_ERROR: Int = 0
const READER_ERROR: Int = 2
const SCANNER_ERROR: Int = 3
const PARSER_ERROR: Int = 4
const COMPOSER_ERROR: Int = 5

// Token types (yaml_token_type_t).
const T_NONE: Int = 0
const T_STREAM_START: Int = 1
const T_STREAM_END: Int = 2
const T_VERSION_DIRECTIVE: Int = 3
const T_TAG_DIRECTIVE: Int = 4
const T_DOCUMENT_START: Int = 5
const T_DOCUMENT_END: Int = 6
const T_BLOCK_SEQUENCE_START: Int = 7
const T_BLOCK_MAPPING_START: Int = 8
const T_BLOCK_END: Int = 9
const T_FLOW_SEQUENCE_START: Int = 10
const T_FLOW_SEQUENCE_END: Int = 11
const T_FLOW_MAPPING_START: Int = 12
const T_FLOW_MAPPING_END: Int = 13
const T_BLOCK_ENTRY: Int = 14
const T_FLOW_ENTRY: Int = 15
const T_KEY: Int = 16
const T_VALUE: Int = 17
const T_ALIAS: Int = 18
const T_ANCHOR: Int = 19
const T_TAG: Int = 20
const T_SCALAR: Int = 21

// Scalar styles (yaml_scalar_style_t).
const S_ANY: Int = 0
const S_PLAIN: Int = 2
const S_SINGLE: Int = 4
const S_DOUBLE: Int = 8
const S_LITERAL: Int = 16
const S_FOLDED: Int = 32

struct Token {
  typ: Int
  start: Mark
  end: Mark
  /// the scalar value, the anchor or alias name, the tag handle of a tag
  /// directive or tag token
  value: Bytes
  /// the tag suffix, or the tag directive's prefix
  suffix: Bytes
  style: Int
  major: Int
  minor: Int
}

struct SimpleKey {
  possible: Bool
  required: Bool
  token_number: Int
  mark: Mark
}

struct TagDirective {
  handle: Bytes
  prefix: Bytes
}

struct Parser {
  // Error handling.
  error: Int
  problem: Str
  problem_offset: Int
  problem_value: Int
  problem_mark: Mark
  context: Str
  context_mark: Mark

  // Reader: the decoded buffer is the input itself (UTF-8), up to dec_end.
  b: Bytes
  /// the position of the next character
  pos: Int
  /// the end of what the reader has decoded and validated
  dec_end: Int
  /// the start of the undecoded raw bytes (Go's raw buffer position)
  raw_pos: Int
  /// the end of the raw bytes read so far
  raw_end: Int
  /// the read handler has returned EOF
  eof: Bool
  /// the byte order mark check has run
  enc_done: Bool
  /// the number of decoded characters not yet consumed
  unread: Int
  newlines: Int
  /// the offset of the next undecoded byte, counting a BOM
  offset: Int
  mark: Mark

  // Scanner.
  stream_start_produced: Bool
  stream_end_produced: Bool
  flow_level: Int
  tokens: List[Token]
  tokens_head: Int
  tokens_parsed: Int
  token_available: Bool
  indent: Int
  indents: List[Int]
  simple_key_allowed: Bool
  simple_keys: List[SimpleKey]
  /// token number to the simple_keys index
  simple_keys_by_tok: Map[Int, Int]

  // Parser.
  state: Int
  states: List[Int]
  marks: List[Mark]
  tag_directives: List[TagDirective]
}

const INPUT_RAW_BUFFER_SIZE: Int = 512

fn new_parser(input: Bytes) -> Parser {
  Parser{
    error: NO_ERROR, problem: "", problem_offset: 0, problem_value: 0,
    problem_mark: Mark{index: 0, line: 0, column: 0},
    context: "", context_mark: Mark{index: 0, line: 0, column: 0},
    b: input, pos: 0, dec_end: 0, raw_pos: 0, raw_end: 0, eof: false, enc_done: false, unread: 0, newlines: 0, offset: 0,
    mark: Mark{index: 0, line: 0, column: 0},
    stream_start_produced: false, stream_end_produced: false, flow_level: 0,
    tokens: [], tokens_head: 0, tokens_parsed: 0, token_available: false,
    indent: -1, indents: [], simple_key_allowed: false, simple_keys: [], simple_keys_by_tok: {},
    state: 0, states: [], marks: [], tag_directives: [],
  }
}

fn mark0() -> Mark { Mark{index: 0, line: 0, column: 0} }

// ---- character classes (yamlprivateh.go): the bytes at pos + k of the buffer, 0 past the end ----

fn (p: Parser) c(k: Int) -> Int {
  let i = p.pos + k
  if i < p.b.len() {
    return Int(p.b[i])
  }
  0
}

fn byte_at(b: Bytes, i: Int) -> Int {
  if i < b.len() {
    return Int(b[i])
  }
  0
}

fn is_alpha(c: Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45
}

fn is_digit(c: Int) -> Bool { c >= 48 && c <= 57 }

fn is_hex(c: Int) -> Bool {
  (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn as_hex(c: Int) -> Int {
  if c >= 65 && c <= 70 {
    return c - 65 + 10
  }
  if c >= 97 && c <= 102 {
    return c - 97 + 10
  }
  c - 48
}

/// Whether the character at k is a line break (CR, LF, NEL, LS or PS).
fn (p: Parser) is_break(k: Int) -> Bool {
  let a = p.c(k)
  if a == 13 || a == 10 {
    return true
  }
  if a == 194 && p.c(k + 1) == 133 {
    return true
  }
  a == 226 && p.c(k + 1) == 128 && (p.c(k + 2) == 168 || p.c(k + 2) == 169)
}

fn (p: Parser) is_breakz(k: Int) -> Bool { p.c(k) == 0 || p.is_break(k) }

fn (p: Parser) is_blank(k: Int) -> Bool {
  let a = p.c(k)
  a == 32 || a == 9
}

fn (p: Parser) is_blankz(k: Int) -> Bool { p.is_blank(k) || p.is_breakz(k) }

fn (p: Parser) is_spacez(k: Int) -> Bool { p.c(k) == 32 || p.is_breakz(k) }

fn (p: Parser) is_crlf(k: Int) -> Bool { p.c(k) == 13 && p.c(k + 1) == 10 }

fn (p: Parser) is_printable(k: Int) -> Bool {
  let a = p.c(k)
  let n1 = p.c(k + 1)
  let n2 = p.c(k + 2)
  a == 10 || (a >= 32 && a <= 126) || (a == 194 && n1 >= 160) || (a > 194 && a < 237) || (a == 237 && n1 < 160) || a == 238 || (a == 239 && !(n1 == 187 && n2 == 191) && !(n1 == 191 && (n2 == 190 || n2 == 191)))
}

fn width(b: Int) -> Int {
  if b & 128 == 0 {
    return 1
  }
  if b & 224 == 192 {
    return 2
  }
  if b & 240 == 224 {
    return 3
  }
  if b & 248 == 240 {
    return 4
  }
  0
}

// ---- reader (readerc.go): UTF-8 input only ----

fn set_reader_error(var p: Parser, problem: Str, offset: Int, value: Int) -> Bool {
  p.error = READER_ERROR
  p.problem = problem
  p.problem_offset = offset
  p.problem_value = value
  false
}


/// Reads the next chunk of raw bytes (yaml_parser_update_raw_buffer): the raw
/// buffer holds at most 512 bytes counted from the first undecoded one.
fn update_raw_buffer(var p: Parser) {
  if p.eof {
    return
  }
  if p.raw_end - p.raw_pos >= INPUT_RAW_BUFFER_SIZE {
    return
  }
  if p.raw_end >= p.b.len() {
    p.eof = true
    return
  }
  var end = p.raw_pos + INPUT_RAW_BUFFER_SIZE
  if end > p.b.len() {
    end = p.b.len()
  }
  p.raw_end = end
}

/// Reads the first chunk and skips a UTF-8 byte order mark
/// (yaml_parser_determine_encoding; UTF-16 input is not supported).
fn determine_encoding(var p: Parser) {
  while !p.eof && p.raw_end - p.raw_pos < 3 {
    update_raw_buffer(p)
  }
  if p.raw_end - p.raw_pos >= 3 && p.b[0] == 239 && p.b[1] == 187 && p.b[2] == 191 {
    p.raw_pos = 3
    p.offset = 3
  }
}

/// Decodes and validates characters until `length` are unread
/// (yaml_parser_update_buffer).
fn update_buffer(var p: Parser, length: Int) -> Bool {
  if p.unread >= length {
    return true
  }
  if !p.enc_done {
    p.enc_done = true
    determine_encoding(p)
  }
  var first = true
  while p.unread < length {
    if !first || p.raw_pos == p.raw_end {
      update_raw_buffer(p)
    }
    first = false
    while p.raw_pos != p.raw_end {
      let raw_unread = p.raw_end - p.raw_pos
      let octet = Int(p.b[p.raw_pos])
      var w = 0
      var value = 0
      if octet & 128 == 0 {
        w = 1
        value = octet & 127
      } else if octet & 224 == 192 {
        w = 2
        value = octet & 31
      } else if octet & 240 == 224 {
        w = 3
        value = octet & 15
      } else if octet & 248 == 240 {
        w = 4
        value = octet & 7
      } else {
        return set_reader_error(p, "invalid leading UTF-8 octet", p.offset, octet)
      }
      if w > raw_unread {
        if p.eof {
          return set_reader_error(p, "incomplete UTF-8 octet sequence", p.offset, -1)
        }
        break
      }
      for k in 1..w {
        let o = Int(p.b[p.raw_pos + k])
        if o & 192 != 128 {
          return set_reader_error(p, "invalid trailing UTF-8 octet", p.offset + k, o)
        }
        value = (value << 6) + (o & 63)
      }
      if !(w == 1 || (w == 2 && value >= 128) || (w == 3 && value >= 2048) || (w == 4 && value >= 65536)) {
        return set_reader_error(p, "invalid length of a UTF-8 sequence", p.offset, -1)
      }
      if (value >= 55296 && value <= 57343) || value > 1114111 {
        return set_reader_error(p, "invalid Unicode character", p.offset, value)
      }
      let ok = value == 9 || value == 10 || value == 13 || (value >= 32 && value <= 126) || value == 133 || (value >= 160 && value <= 55295) || (value >= 57344 && value <= 65533) || (value >= 65536 && value <= 1114111)
      if !ok {
        return set_reader_error(p, "control characters are not allowed", p.offset, value)
      }
      p.raw_pos += w
      p.offset += w
      p.dec_end = p.raw_pos
      p.unread += 1
    }
    if p.eof {
      p.unread += 1
      break
    }
  }
  true
}

/// cache: ensure `length` characters are available (the reader error, if any, is in p).
fn cache(var p: Parser, length: Int) -> Bool {
  p.unread >= length || update_buffer(p, length)
}

// ---- scanner helpers (scannerc.go) ----

/// Advances over one character.
fn skip(var p: Parser) {
  if !p.is_blank(0) {
    p.newlines = 0
  }
  p.mark.index += 1
  p.mark.column += 1
  p.unread -= 1
  p.pos += width(p.c(0))
}

/// Advances over a line break (CR LF counts as one).
fn skip_line(var p: Parser) {
  if p.is_crlf(0) {
    p.mark.index += 2
    p.mark.column = 0
    p.mark.line += 1
    p.unread -= 2
    p.pos += 2
    p.newlines += 1
  } else if p.is_break(0) {
    p.mark.index += 1
    p.mark.column = 0
    p.mark.line += 1
    p.unread -= 1
    p.pos += width(p.c(0))
    p.newlines += 1
  }
}

/// Copies one character to s and advances.
fn read(var p: Parser, var s: BytesBuilder) {
  if !p.is_blank(0) {
    p.newlines = 0
  }
  let w = width(p.c(0))
  if w == 0 {
    fault("invalid character sequence")
  }
  if w == 1 {
    s.write_byte(UInt8(p.c(0)))
  } else {
    s.write(p.b[p.pos..p.pos + w])
  }
  p.pos += w
  p.mark.index += 1
  p.mark.column += 1
  p.unread -= 1
}

/// Copies a line break to s (CR, LF, CR LF and NEL as LF; LS and PS as they are) and advances.
fn read_line(var p: Parser, var s: BytesBuilder) {
  let a = p.c(0)
  let n1 = p.c(1)
  if a == 13 && n1 == 10 {
    s.write_byte(UInt8(10))
    p.pos += 2
    p.mark.index += 1
    p.unread -= 1
  } else if a == 13 || a == 10 {
    s.write_byte(UInt8(10))
    p.pos += 1
  } else if a == 194 && n1 == 133 {
    s.write_byte(UInt8(10))
    p.pos += 2
  } else if a == 226 && n1 == 128 && (p.c(2) == 168 || p.c(2) == 169) {
    s.write(p.b[p.pos..p.pos + 3])
    p.pos += 3
  } else {
    return
  }
  p.mark.index += 1
  p.mark.column = 0
  p.mark.line += 1
  p.unread -= 1
  p.newlines += 1
}

fn set_scanner_error(var p: Parser, context: Str, context_mark: Mark, problem: Str) -> Bool {
  p.error = SCANNER_ERROR
  p.context = context
  p.context_mark = context_mark
  p.problem = problem
  p.problem_mark = p.mark
  false
}

fn set_scanner_tag_error(var p: Parser, directive: Bool, context_mark: Mark, problem: Str) -> Bool {
  let context = if directive { "while parsing a %TAG directive" } else { "while parsing a tag" }
  set_scanner_error(p, context, context_mark, problem)
}

fn tok(typ: Int, start: Mark, end: Mark) -> Token {
  Token{typ: typ, start: start, end: end, value: b"", suffix: b"", style: 0, major: 0, minor: 0}
}

/// Inserts a token into the queue: at the end for pos < 0, else at pos
/// counted from the head (yaml_insert_token).
fn insert_token(var p: Parser, pos: Int, t: Token) {
  if p.tokens_head >= 256 {
    p.tokens = p.tokens[p.tokens_head..p.tokens.len()]
    p.tokens_head = 0
  }
  if pos < 0 {
    p.tokens.push(t)
  } else {
    p.tokens.insert(p.tokens_head + pos, t)
  }
}

/// Gets the next token (yaml_parser_scan); None after STREAM-END or an error.
fn scan(var p: Parser) -> Token? {
  if p.stream_end_produced || p.error != NO_ERROR {
    return None
  }
  if !p.token_available {
    if !fetch_more_tokens(p) {
      return None
    }
  }
  let t = p.tokens[p.tokens_head]
  p.tokens_head += 1
  p.tokens_parsed += 1
  p.token_available = false
  if t.typ == T_STREAM_END {
    p.stream_end_produced = true
  }
  Some(t)
}

/// Ensures that the token queue holds a token the parser may take.
fn fetch_more_tokens(var p: Parser) -> Bool {
  while true {
    // The comment logic of yaml.v3 needs a lookahead of two tokens, kept here
    // so errors surface at the same point.
    if p.tokens_head < p.tokens.len() - 2 {
      match p.simple_keys_by_tok.get(p.tokens_parsed) {
        None => break
        Some(idx) => {
          let r = simple_key_is_valid(p, idx)
          if r == 2 {
            return false
          }
          if r == 0 {
            break
          }
        }
      }
    }
    if !fetch_next_token(p) {
      return false
    }
  }
  p.token_available = true
  true
}

/// Whether the potential simple key at idx is still valid: 1 valid, 0 not
/// (and no longer possible), 2 an error (yaml_simple_key_is_valid).
fn simple_key_is_valid(var p: Parser, idx: Int) -> Int {
  let sk = p.simple_keys[idx]
  if !sk.possible {
    return 0
  }
  if sk.mark.line < p.mark.line || sk.mark.index + 1024 < p.mark.index {
    if sk.required {
      set_scanner_error(p, "while scanning a simple key", sk.mark, "could not find expected ':'")
      return 2
    }
    p.simple_keys[idx].possible = false
    return 0
  }
  1
}

fn save_simple_key(var p: Parser) -> Bool {
  let required = p.flow_level == 0 && p.indent == p.mark.column
  if p.simple_key_allowed {
    let sk = SimpleKey{possible: true, required: required, token_number: p.tokens_parsed + (p.tokens.len() - p.tokens_head), mark: p.mark}
    if !remove_simple_key(p) {
      return false
    }
    let last = p.simple_keys.len() - 1
    p.simple_keys[last] = sk
    p.simple_keys_by_tok[sk.token_number] = last
  }
  true
}

fn remove_simple_key(var p: Parser) -> Bool {
  let i = p.simple_keys.len() - 1
  if p.simple_keys[i].possible {
    if p.simple_keys[i].required {
      return set_scanner_error(p, "while scanning a simple key", p.simple_keys[i].mark, "could not find expected ':'")
    }
    p.simple_keys[i].possible = false
    p.simple_keys_by_tok.remove(p.simple_keys[i].token_number)
  }
  true
}

const MAX_FLOW_LEVEL: Int = 10000
const MAX_INDENTS: Int = 10000

fn increase_flow_level(var p: Parser) -> Bool {
  p.simple_keys.push(SimpleKey{possible: false, required: false, token_number: p.tokens_parsed + (p.tokens.len() - p.tokens_head), mark: p.mark})
  p.flow_level += 1
  if p.flow_level > MAX_FLOW_LEVEL {
    return set_scanner_error(p, "while increasing flow level", p.simple_keys[p.simple_keys.len() - 1].mark, "exceeded max depth of ${MAX_FLOW_LEVEL}")
  }
  true
}

fn decrease_flow_level(var p: Parser) -> Bool {
  if p.flow_level > 0 {
    p.flow_level -= 1
    let last = p.simple_keys.len() - 1
    p.simple_keys_by_tok.remove(p.simple_keys[last].token_number)
    p.simple_keys.pop()
  }
  true
}

fn roll_indent(var p: Parser, column: Int, number: Int, typ: Int, mark: Mark) -> Bool {
  if p.flow_level > 0 {
    return true
  }
  if p.indent < column {
    p.indents.push(p.indent)
    p.indent = column
    if p.indents.len() > MAX_INDENTS {
      return set_scanner_error(p, "while increasing indent level", p.simple_keys[p.simple_keys.len() - 1].mark, "exceeded max depth of ${MAX_INDENTS}")
    }
    var n = number
    if n > -1 {
      n -= p.tokens_parsed
    }
    insert_token(p, n, tok(typ, mark, mark))
  }
  true
}

fn unroll_indent(var p: Parser, column: Int, scan_mark: Mark) -> Bool {
  if p.flow_level > 0 {
    return true
  }
  var block_mark = scan_mark
  block_mark.index -= 1
  while p.indent > column {
    insert_token(p, -1, tok(T_BLOCK_END, block_mark, block_mark))
    p.indent = p.indents.pop() ?? -1
  }
  true
}

// ---- token fetchers ----

fn fetch_stream_start(var p: Parser) -> Bool {
  p.indent = -1
  p.simple_keys.push(SimpleKey{possible: false, required: false, token_number: 0, mark: mark0()})
  p.simple_keys_by_tok = {}
  p.simple_key_allowed = true
  p.stream_start_produced = true
  insert_token(p, -1, tok(T_STREAM_START, p.mark, p.mark))
  true
}

fn fetch_stream_end(var p: Parser) -> Bool {
  if p.mark.column != 0 {
    p.mark.column = 0
    p.mark.line += 1
  }
  if !unroll_indent(p, -1, p.mark) {
    return false
  }
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  insert_token(p, -1, tok(T_STREAM_END, p.mark, p.mark))
  true
}

fn fetch_directive(var p: Parser) -> Bool {
  if !unroll_indent(p, -1, p.mark) {
    return false
  }
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let t = scan_directive(p) ?? return false
  insert_token(p, -1, t)
  true
}

fn fetch_document_indicator(var p: Parser, typ: Int) -> Bool {
  if !unroll_indent(p, -1, p.mark) {
    return false
  }
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let start = p.mark
  skip(p)
  skip(p)
  skip(p)
  insert_token(p, -1, tok(typ, start, p.mark))
  true
}

fn fetch_flow_collection_start(var p: Parser, typ: Int) -> Bool {
  if !save_simple_key(p) {
    return false
  }
  if !increase_flow_level(p) {
    return false
  }
  p.simple_key_allowed = true
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(typ, start, p.mark))
  true
}

fn fetch_flow_collection_end(var p: Parser, typ: Int) -> Bool {
  if !remove_simple_key(p) {
    return false
  }
  if !decrease_flow_level(p) {
    return false
  }
  p.simple_key_allowed = false
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(typ, start, p.mark))
  true
}

fn fetch_flow_entry(var p: Parser) -> Bool {
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = true
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(T_FLOW_ENTRY, start, p.mark))
  true
}

fn fetch_block_entry(var p: Parser) -> Bool {
  if p.flow_level == 0 {
    if !p.simple_key_allowed {
      return set_scanner_error(p, "", p.mark, "block sequence entries are not allowed in this context")
    }
    if !roll_indent(p, p.mark.column, -1, T_BLOCK_SEQUENCE_START, p.mark) {
      return false
    }
  }
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = true
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(T_BLOCK_ENTRY, start, p.mark))
  true
}

fn fetch_key(var p: Parser) -> Bool {
  if p.flow_level == 0 {
    if !p.simple_key_allowed {
      return set_scanner_error(p, "", p.mark, "mapping keys are not allowed in this context")
    }
    if !roll_indent(p, p.mark.column, -1, T_BLOCK_MAPPING_START, p.mark) {
      return false
    }
  }
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = p.flow_level == 0
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(T_KEY, start, p.mark))
  true
}

fn fetch_value(var p: Parser) -> Bool {
  let last = p.simple_keys.len() - 1
  let r = simple_key_is_valid(p, last)
  if r == 2 {
    return false
  }
  if r == 1 {
    let sk = p.simple_keys[last]
    insert_token(p, sk.token_number - p.tokens_parsed, tok(T_KEY, sk.mark, sk.mark))
    if !roll_indent(p, sk.mark.column, sk.token_number, T_BLOCK_MAPPING_START, sk.mark) {
      return false
    }
    p.simple_keys[last].possible = false
    p.simple_keys_by_tok.remove(sk.token_number)
    p.simple_key_allowed = false
  } else {
    if p.flow_level == 0 {
      if !p.simple_key_allowed {
        return set_scanner_error(p, "", p.mark, "mapping values are not allowed in this context")
      }
      if !roll_indent(p, p.mark.column, -1, T_BLOCK_MAPPING_START, p.mark) {
        return false
      }
    }
    p.simple_key_allowed = p.flow_level == 0
  }
  let start = p.mark
  skip(p)
  insert_token(p, -1, tok(T_VALUE, start, p.mark))
  true
}

fn fetch_anchor(var p: Parser, typ: Int) -> Bool {
  if !save_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let t = scan_anchor(p, typ) ?? return false
  insert_token(p, -1, t)
  true
}

fn fetch_tag(var p: Parser) -> Bool {
  if !save_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let t = scan_tag(p) ?? return false
  insert_token(p, -1, t)
  true
}

fn fetch_block_scalar(var p: Parser, literal: Bool) -> Bool {
  if !remove_simple_key(p) {
    return false
  }
  p.simple_key_allowed = true
  let t = scan_block_scalar(p, literal) ?? return false
  insert_token(p, -1, t)
  true
}

fn fetch_flow_scalar(var p: Parser, single: Bool) -> Bool {
  if !save_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let t = scan_flow_scalar(p, single) ?? return false
  insert_token(p, -1, t)
  true
}

fn fetch_plain_scalar(var p: Parser) -> Bool {
  if !save_simple_key(p) {
    return false
  }
  p.simple_key_allowed = false
  let t = scan_plain_scalar(p) ?? return false
  insert_token(p, -1, t)
  true
}

/// The dispatcher for token fetchers (yaml_parser_fetch_next_token); the comment
/// handling of yaml.v3 is not ported (stage 4).
fn fetch_next_token(var p: Parser) -> Bool {
  if p.unread < 1 && !update_buffer(p, 1) {
    return false
  }
  if !p.stream_start_produced {
    return fetch_stream_start(p)
  }
  let scan_mark = p.mark
  if !scan_to_next_token(p) {
    return false
  }
  if !unroll_indent(p, p.mark.column, scan_mark) {
    return false
  }
  if p.unread < 4 && !update_buffer(p, 4) {
    return false
  }
  let a = p.c(0)
  if a == 0 {
    return fetch_stream_end(p)
  }
  if p.mark.column == 0 && a == 37 {
    return fetch_directive(p)
  }
  if p.mark.column == 0 && a == 45 && p.c(1) == 45 && p.c(2) == 45 && p.is_blankz(3) {
    return fetch_document_indicator(p, T_DOCUMENT_START)
  }
  if p.mark.column == 0 && a == 46 && p.c(1) == 46 && p.c(2) == 46 && p.is_blankz(3) {
    return fetch_document_indicator(p, T_DOCUMENT_END)
  }
  if a == 91 {
    return fetch_flow_collection_start(p, T_FLOW_SEQUENCE_START)
  }
  if a == 123 {
    return fetch_flow_collection_start(p, T_FLOW_MAPPING_START)
  }
  if a == 93 {
    return fetch_flow_collection_end(p, T_FLOW_SEQUENCE_END)
  }
  if a == 125 {
    return fetch_flow_collection_end(p, T_FLOW_MAPPING_END)
  }
  if a == 44 {
    return fetch_flow_entry(p)
  }
  if a == 45 && p.is_blankz(1) {
    return fetch_block_entry(p)
  }
  if a == 63 && (p.flow_level > 0 || p.is_blankz(1)) {
    return fetch_key(p)
  }
  if a == 58 && (p.flow_level > 0 || p.is_blankz(1)) {
    return fetch_value(p)
  }
  if a == 42 {
    return fetch_anchor(p, T_ALIAS)
  }
  if a == 38 {
    return fetch_anchor(p, T_ANCHOR)
  }
  if a == 33 {
    return fetch_tag(p)
  }
  if a == 124 && p.flow_level == 0 {
    return fetch_block_scalar(p, true)
  }
  if a == 62 && p.flow_level == 0 {
    return fetch_block_scalar(p, false)
  }
  if a == 39 {
    return fetch_flow_scalar(p, true)
  }
  if a == 34 {
    return fetch_flow_scalar(p, false)
  }
  if !(p.is_blankz(0) || a == 45 || a == 63 || a == 58 || a == 44 || a == 91 || a == 93 || a == 123 || a == 125 || a == 35 || a == 38 || a == 42 || a == 33 || a == 124 || a == 62 || a == 39 || a == 34 || a == 37 || a == 64 || a == 96) || (a == 45 && !p.is_blank(1)) || (p.flow_level == 0 && (a == 63 || a == 58) && !p.is_blankz(1)) {
    return fetch_plain_scalar(p)
  }
  set_scanner_error(p, "while scanning for the next token", p.mark, "found character that cannot start any token")
}

// ---- scanning (scannerc.go) ----

/// Eats whitespace, comments and line breaks up to the next token. Comments are
/// skipped without being kept (yaml.v3's comment association is stage 4).
fn scan_to_next_token(var p: Parser) -> Bool {
  while true {
    if p.unread < 1 && !update_buffer(p, 1) {
      return false
    }
    if p.mark.column == 0 && p.c(0) == 239 && p.c(1) == 187 && p.c(2) == 191 {
      skip(p)
    }
    if p.unread < 1 && !update_buffer(p, 1) {
      return false
    }
    while p.c(0) == 32 || ((p.flow_level > 0 || !p.simple_key_allowed) && p.c(0) == 9) {
      skip(p)
      if p.unread < 1 && !update_buffer(p, 1) {
        return false
      }
    }
    if p.c(0) == 35 {
      while !p.is_breakz(0) {
        skip(p)
        if p.unread < 1 && !update_buffer(p, 1) {
          return false
        }
      }
    }
    if p.is_break(0) {
      if p.unread < 2 && !update_buffer(p, 2) {
        return false
      }
      skip_line(p)
      if p.flow_level == 0 {
        p.simple_key_allowed = true
      }
    } else {
      break
    }
  }
  true
}

/// Scans a directive: `%YAML 1.1` or `%TAG !e! tag:example.com,2000:app/`.
fn scan_directive(var p: Parser) -> Token? {
  let start = p.mark
  skip(p)
  let name = scan_directive_name(p, start) ?? return None
  var t = tok(T_NONE, start, start)
  if name == b"YAML" {
    let ver = scan_version_directive_value(p, start) ?? return None
    t = tok(T_VERSION_DIRECTIVE, start, p.mark)
    t.major = ver.0
    t.minor = ver.1
  } else if name == b"TAG" {
    let hp = scan_tag_directive_value(p, start) ?? return None
    t = tok(T_TAG_DIRECTIVE, start, p.mark)
    t.value = hp.0
    t.suffix = hp.1
  } else {
    set_scanner_error(p, "while scanning a directive", start, "found unknown directive name")
    return None
  }
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while p.is_blank(0) {
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  if p.c(0) == 35 {
    while !p.is_breakz(0) {
      skip(p)
      if p.unread < 1 && !update_buffer(p, 1) {
        return None
      }
    }
  }
  if !p.is_breakz(0) {
    set_scanner_error(p, "while scanning a directive", start, "did not find expected comment or line break")
    return None
  }
  if p.is_break(0) {
    if p.unread < 2 && !update_buffer(p, 2) {
      return None
    }
    skip_line(p)
  }
  Some(t)
}

fn is_alpha_at(p: Parser, k: Int) -> Bool { is_alpha(p.c(k)) }

fn scan_directive_name(var p: Parser, start: Mark) -> Bytes? {
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  var s = BytesBuilder.new()
  while is_alpha_at(p, 0) {
    read(p, s)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  if s.len() == 0 {
    set_scanner_error(p, "while scanning a directive", start, "could not find expected directive name")
    return None
  }
  if !p.is_blankz(0) {
    set_scanner_error(p, "while scanning a directive", start, "found unexpected non-alphabetical character")
    return None
  }
  Some(s.freeze())
}

fn scan_version_directive_value(var p: Parser, start: Mark) -> (Int, Int)? {
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while p.is_blank(0) {
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  let major = scan_version_directive_number(p, start) ?? return None
  if p.c(0) != 46 {
    set_scanner_error(p, "while scanning a %YAML directive", start, "did not find expected digit or '.' character")
    return None
  }
  skip(p)
  let minor = scan_version_directive_number(p, start) ?? return None
  Some((major, minor))
}

const MAX_NUMBER_LENGTH: Int = 2

fn scan_version_directive_number(var p: Parser, start: Mark) -> Int? {
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  var value = 0
  var length = 0
  while is_digit(p.c(0)) {
    length += 1
    if length > MAX_NUMBER_LENGTH {
      set_scanner_error(p, "while scanning a %YAML directive", start, "found extremely long version number")
      return None
    }
    value = value * 10 + (p.c(0) - 48)
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  if length == 0 {
    set_scanner_error(p, "while scanning a %YAML directive", start, "did not find expected version number")
    return None
  }
  Some(value)
}

fn scan_tag_directive_value(var p: Parser, start: Mark) -> (Bytes, Bytes)? {
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while p.is_blank(0) {
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  let handle = scan_tag_handle(p, true, start) ?? return None
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  if !p.is_blank(0) {
    set_scanner_error(p, "while scanning a %TAG directive", start, "did not find expected whitespace")
    return None
  }
  while p.is_blank(0) {
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  let prefix = scan_tag_uri(p, true, b"", start) ?? return None
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  if !p.is_blankz(0) {
    set_scanner_error(p, "while scanning a %TAG directive", start, "did not find expected whitespace or line break")
    return None
  }
  Some((handle, prefix))
}

/// Scans an anchor (`&name`) or alias (`*name`) token.
fn scan_anchor(var p: Parser, typ: Int) -> Token? {
  var s = BytesBuilder.new()
  let start = p.mark
  skip(p)
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while is_alpha_at(p, 0) {
    read(p, s)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  let end = p.mark
  let a = p.c(0)
  if s.len() == 0 || !(p.is_blankz(0) || a == 63 || a == 58 || a == 44 || a == 93 || a == 125 || a == 37 || a == 64 || a == 96) {
    let context = if typ == T_ANCHOR { "while scanning an anchor" } else { "while scanning an alias" }
    set_scanner_error(p, context, start, "did not find expected alphabetic or numeric character")
    return None
  }
  var t = tok(typ, start, end)
  t.value = s.freeze()
  Some(t)
}

/// Scans a tag token: `!<uri>`, `!handle!suffix`, `!suffix` or `!`.
fn scan_tag(var p: Parser) -> Token? {
  var handle = b""
  var suffix = b""
  let start = p.mark
  if p.unread < 2 && !update_buffer(p, 2) {
    return None
  }
  if p.c(1) == 60 {
    skip(p)
    skip(p)
    suffix = scan_tag_uri(p, false, b"", start) ?? return None
    if p.c(0) != 62 {
      set_scanner_error(p, "while scanning a tag", start, "did not find the expected '>'")
      return None
    }
    skip(p)
  } else {
    handle = scan_tag_handle(p, false, start) ?? return None
    if handle[0] == 33 && handle.len() > 1 && handle[handle.len() - 1] == 33 {
      suffix = scan_tag_uri(p, false, b"", start) ?? return None
    } else {
      suffix = scan_tag_uri(p, false, handle, start) ?? return None
      handle = b"!"
      if suffix.len() == 0 {
        let swap = handle
        handle = suffix
        suffix = swap
      }
    }
  }
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  if !p.is_blankz(0) {
    set_scanner_error(p, "while scanning a tag", start, "did not find expected whitespace or line break")
    return None
  }
  var t = tok(T_TAG, start, p.mark)
  t.value = handle
  t.suffix = suffix
  Some(t)
}

fn scan_tag_handle(var p: Parser, directive: Bool, start: Mark) -> Bytes? {
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  if p.c(0) != 33 {
    set_scanner_tag_error(p, directive, start, "did not find expected '!'")
    return None
  }
  var s = BytesBuilder.new()
  read(p, s)
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while is_alpha_at(p, 0) {
    read(p, s)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  if p.c(0) == 33 {
    read(p, s)
  } else if directive && s.len() != 1 {
    set_scanner_tag_error(p, directive, start, "did not find expected '!'")
    return None
  }
  Some(s.freeze())
}

fn is_uri_char(c: Int) -> Bool {
  is_alpha(c) || c == 59 || c == 47 || c == 63 || c == 58 || c == 64 || c == 38 || c == 61 || c == 43 || c == 36 || c == 44 || c == 46 || c == 33 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41 || c == 91 || c == 93 || c == 37
}

fn scan_tag_uri(var p: Parser, directive: Bool, head: Bytes, start: Mark) -> Bytes? {
  var s = BytesBuilder.new()
  var has_tag = head.len() > 0
  if head.len() > 1 {
    s.write(head[1..head.len()])
  }
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while is_uri_char(p.c(0)) {
    if p.c(0) == 37 {
      if !scan_uri_escapes(p, directive, start, s) {
        return None
      }
    } else {
      read(p, s)
    }
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
    has_tag = true
  }
  if !has_tag {
    set_scanner_tag_error(p, directive, start, "did not find expected tag URI")
    return None
  }
  Some(s.freeze())
}

fn scan_uri_escapes(var p: Parser, directive: Bool, start: Mark, var s: BytesBuilder) -> Bool {
  var w = 1024
  while w > 0 {
    if p.unread < 3 && !update_buffer(p, 3) {
      return false
    }
    if !(p.c(0) == 37 && is_hex(p.c(1)) && is_hex(p.c(2))) {
      return set_scanner_tag_error(p, directive, start, "did not find URI escaped octet")
    }
    let octet = (as_hex(p.c(1)) << 4) + as_hex(p.c(2))
    if w == 1024 {
      w = width(octet)
      if w == 0 {
        return set_scanner_tag_error(p, directive, start, "found an incorrect leading UTF-8 octet")
      }
    } else if octet & 192 != 128 {
      return set_scanner_tag_error(p, directive, start, "found an incorrect trailing UTF-8 octet")
    }
    s.write_byte(UInt8(octet))
    skip(p)
    skip(p)
    skip(p)
    w -= 1
  }
  true
}

/// Whether the line break at the current position reads as LF (CR, LF, NEL).
fn (p: Parser) break_is_lf() -> Bool {
  let a = p.c(0)
  a == 13 || a == 10 || (a == 194 && p.c(1) == 133)
}

/// Scans a block scalar (`|` literal or `>` folded).
fn scan_block_scalar(var p: Parser, literal: Bool) -> Token? {
  let start = p.mark
  skip(p)
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  var chomping = 0
  var increment = 0
  if p.c(0) == 43 || p.c(0) == 45 {
    chomping = if p.c(0) == 43 { 1 } else { -1 }
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
    if is_digit(p.c(0)) {
      if p.c(0) == 48 {
        set_scanner_error(p, "while scanning a block scalar", start, "found an indentation indicator equal to 0")
        return None
      }
      increment = p.c(0) - 48
      skip(p)
    }
  } else if is_digit(p.c(0)) {
    if p.c(0) == 48 {
      set_scanner_error(p, "while scanning a block scalar", start, "found an indentation indicator equal to 0")
      return None
    }
    increment = p.c(0) - 48
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
    if p.c(0) == 43 || p.c(0) == 45 {
      chomping = if p.c(0) == 43 { 1 } else { -1 }
      skip(p)
    }
  }
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  while p.is_blank(0) {
    skip(p)
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
  }
  if p.c(0) == 35 {
    while !p.is_breakz(0) {
      skip(p)
      if p.unread < 1 && !update_buffer(p, 1) {
        return None
      }
    }
  }
  if !p.is_breakz(0) {
    set_scanner_error(p, "while scanning a block scalar", start, "did not find expected comment or line break")
    return None
  }
  if p.is_break(0) {
    if p.unread < 2 && !update_buffer(p, 2) {
      return None
    }
    skip_line(p)
  }
  var end = p.mark
  var indent = 0
  if increment > 0 {
    indent = if p.indent >= 0 { p.indent + increment } else { increment }
  }
  var s = BytesBuilder.new()
  var lb = BytesBuilder.new()
  var tb = BytesBuilder.new()
  var lb_lf = false
  let r = scan_block_scalar_breaks(p, indent, tb, start)
  if !r.0 {
    return None
  }
  indent = r.1
  end = r.2
  if p.unread < 1 && !update_buffer(p, 1) {
    return None
  }
  var leading_blank = false
  var trailing_blank = false
  while p.mark.column == indent && p.c(0) != 0 {
    trailing_blank = p.is_blank(0)
    if !literal && !leading_blank && !trailing_blank && lb.len() > 0 && lb_lf {
      if tb.len() == 0 {
        s.write_byte(UInt8(32))
      }
    } else {
      s.write(lb.freeze())
    }
    lb = BytesBuilder.new()
    s.write(tb.freeze())
    tb = BytesBuilder.new()
    leading_blank = p.is_blank(0)
    while !p.is_breakz(0) {
      read(p, s)
      if p.unread < 1 && !update_buffer(p, 1) {
        return None
      }
    }
    if p.unread < 2 && !update_buffer(p, 2) {
      return None
    }
    lb_lf = p.break_is_lf()
    read_line(p, lb)
    let r2 = scan_block_scalar_breaks(p, indent, tb, start)
    if !r2.0 {
      return None
    }
    indent = r2.1
    end = r2.2
  }
  if chomping != -1 {
    s.write(lb.freeze())
  }
  if chomping == 1 {
    s.write(tb.freeze())
  }
  var t = tok(T_SCALAR, start, end)
  t.value = s.freeze()
  t.style = if literal { S_LITERAL } else { S_FOLDED }
  Some(t)
}

/// Eats the indentation and blank lines of a block scalar; the result is
/// (ok, the indent found, the end mark).
fn scan_block_scalar_breaks(var p: Parser, indent_in: Int, var breaks: BytesBuilder, start: Mark) -> (Bool, Int, Mark) {
  var indent = indent_in
  var end = p.mark
  var max_indent = 0
  while true {
    if p.unread < 1 && !update_buffer(p, 1) {
      return (false, indent, end)
    }
    while (indent == 0 || p.mark.column < indent) && p.c(0) == 32 {
      skip(p)
      if p.unread < 1 && !update_buffer(p, 1) {
        return (false, indent, end)
      }
    }
    if p.mark.column > max_indent {
      max_indent = p.mark.column
    }
    if (indent == 0 || p.mark.column < indent) && p.c(0) == 9 {
      set_scanner_error(p, "while scanning a block scalar", start, "found a tab character where an indentation space is expected")
      return (false, indent, end)
    }
    if !p.is_break(0) {
      break
    }
    if p.unread < 2 && !update_buffer(p, 2) {
      return (false, indent, end)
    }
    read_line(p, breaks)
    end = p.mark
  }
  if indent == 0 {
    indent = max_indent
    if indent < p.indent + 1 {
      indent = p.indent + 1
    }
    if indent < 1 {
      indent = 1
    }
  }
  (true, indent, end)
}

fn write_utf8(var s: BytesBuilder, value: Int) {
  if value <= 127 {
    s.write_byte(UInt8(value))
  } else if value <= 2047 {
    s.write_byte(UInt8(192 + (value >> 6)))
    s.write_byte(UInt8(128 + (value & 63)))
  } else if value <= 65535 {
    s.write_byte(UInt8(224 + (value >> 12)))
    s.write_byte(UInt8(128 + ((value >> 6) & 63)))
    s.write_byte(UInt8(128 + (value & 63)))
  } else {
    s.write_byte(UInt8(240 + (value >> 18)))
    s.write_byte(UInt8(128 + ((value >> 12) & 63)))
    s.write_byte(UInt8(128 + ((value >> 6) & 63)))
    s.write_byte(UInt8(128 + (value & 63)))
  }
}

fn is_doc_indicator(p: Parser) -> Bool {
  p.mark.column == 0 && ((p.c(0) == 45 && p.c(1) == 45 && p.c(2) == 45) || (p.c(0) == 46 && p.c(1) == 46 && p.c(2) == 46)) && p.is_blankz(3)
}

/// Scans a quoted scalar ('...' or "...").
fn scan_flow_scalar(var p: Parser, single: Bool) -> Token? {
  let start = p.mark
  skip(p)
  var s = BytesBuilder.new()
  var lb = BytesBuilder.new()
  var tb = BytesBuilder.new()
  var ws = BytesBuilder.new()
  var lb_lf = false
  while true {
    if p.unread < 4 && !update_buffer(p, 4) {
      return None
    }
    if is_doc_indicator(p) {
      set_scanner_error(p, "while scanning a quoted scalar", start, "found unexpected document indicator")
      return None
    }
    if p.c(0) == 0 {
      set_scanner_error(p, "while scanning a quoted scalar", start, "found unexpected end of stream")
      return None
    }
    var leading_blanks = false
    while !p.is_blankz(0) {
      if single && p.c(0) == 39 && p.c(1) == 39 {
        s.write_byte(UInt8(39))
        skip(p)
        skip(p)
      } else if single && p.c(0) == 39 {
        break
      } else if !single && p.c(0) == 34 {
        break
      } else if !single && p.c(0) == 92 && p.is_break(1) {
        if p.unread < 3 && !update_buffer(p, 3) {
          return None
        }
        skip(p)
        skip_line(p)
        leading_blanks = true
        break
      } else if !single && p.c(0) == 92 {
        var code_length = 0
        let e = p.c(1)
        if e == 48 {
          s.write_byte(UInt8(0))
        } else if e == 97 {
          s.write_byte(UInt8(7))
        } else if e == 98 {
          s.write_byte(UInt8(8))
        } else if e == 116 || e == 9 {
          s.write_byte(UInt8(9))
        } else if e == 110 {
          s.write_byte(UInt8(10))
        } else if e == 118 {
          s.write_byte(UInt8(11))
        } else if e == 102 {
          s.write_byte(UInt8(12))
        } else if e == 114 {
          s.write_byte(UInt8(13))
        } else if e == 101 {
          s.write_byte(UInt8(27))
        } else if e == 32 {
          s.write_byte(UInt8(32))
        } else if e == 34 {
          s.write_byte(UInt8(34))
        } else if e == 39 {
          s.write_byte(UInt8(39))
        } else if e == 92 {
          s.write_byte(UInt8(92))
        } else if e == 78 {
          s.write_byte(UInt8(194))
          s.write_byte(UInt8(133))
        } else if e == 95 {
          s.write_byte(UInt8(194))
          s.write_byte(UInt8(160))
        } else if e == 76 {
          s.write_byte(UInt8(226))
          s.write_byte(UInt8(128))
          s.write_byte(UInt8(168))
        } else if e == 80 {
          s.write_byte(UInt8(226))
          s.write_byte(UInt8(128))
          s.write_byte(UInt8(169))
        } else if e == 120 {
          code_length = 2
        } else if e == 117 {
          code_length = 4
        } else if e == 85 {
          code_length = 8
        } else {
          set_scanner_error(p, "while parsing a quoted scalar", start, "found unknown escape character")
          return None
        }
        skip(p)
        skip(p)
        if code_length > 0 {
          var value = 0
          if p.unread < code_length && !update_buffer(p, code_length) {
            return None
          }
          for k in 0..code_length {
            if !is_hex(p.c(k)) {
              set_scanner_error(p, "while parsing a quoted scalar", start, "did not find expected hexdecimal number")
              return None
            }
            value = (value << 4) + as_hex(p.c(k))
          }
          if (value >= 55296 && value <= 57343) || value > 1114111 {
            set_scanner_error(p, "while parsing a quoted scalar", start, "found invalid Unicode character escape code")
            return None
          }
          write_utf8(s, value)
          for _k in 0..code_length {
            skip(p)
          }
        }
      } else {
        read(p, s)
      }
      if p.unread < 2 && !update_buffer(p, 2) {
        return None
      }
    }
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
    if single {
      if p.c(0) == 39 {
        break
      }
    } else if p.c(0) == 34 {
      break
    }
    while p.is_blank(0) || p.is_break(0) {
      if p.is_blank(0) {
        if !leading_blanks {
          read(p, ws)
        } else {
          skip(p)
        }
      } else {
        if p.unread < 2 && !update_buffer(p, 2) {
          return None
        }
        if !leading_blanks {
          ws = BytesBuilder.new()
          lb_lf = p.break_is_lf()
          read_line(p, lb)
          leading_blanks = true
        } else {
          read_line(p, tb)
        }
      }
      if p.unread < 1 && !update_buffer(p, 1) {
        return None
      }
    }
    if leading_blanks {
      if lb_lf {
        if tb.len() == 0 {
          s.write_byte(UInt8(32))
        } else {
          s.write(tb.freeze())
        }
      } else {
        s.write(lb.freeze())
        s.write(tb.freeze())
      }
      tb = BytesBuilder.new()
      lb = BytesBuilder.new()
      lb_lf = false
    } else {
      s.write(ws.freeze())
      ws = BytesBuilder.new()
    }
  }
  skip(p)
  var t = tok(T_SCALAR, start, p.mark)
  t.value = s.freeze()
  t.style = if single { S_SINGLE } else { S_DOUBLE }
  Some(t)
}

/// Scans a plain scalar.
fn scan_plain_scalar(var p: Parser) -> Token? {
  var s = BytesBuilder.new()
  var lb = BytesBuilder.new()
  var tb = BytesBuilder.new()
  var ws = BytesBuilder.new()
  var lb_lf = false
  var leading_blanks = false
  let indent = p.indent + 1
  let start = p.mark
  var end = p.mark
  while true {
    if p.unread < 4 && !update_buffer(p, 4) {
      return None
    }
    if is_doc_indicator(p) {
      break
    }
    if p.c(0) == 35 {
      break
    }
    while !p.is_blankz(0) {
      let a = p.c(0)
      if (a == 58 && p.is_blankz(1)) || (p.flow_level > 0 && (a == 44 || a == 63 || a == 91 || a == 93 || a == 123 || a == 125)) {
        break
      }
      if leading_blanks || ws.len() > 0 {
        if leading_blanks {
          if lb_lf {
            if tb.len() == 0 {
              s.write_byte(UInt8(32))
            } else {
              s.write(tb.freeze())
            }
          } else {
            s.write(lb.freeze())
            s.write(tb.freeze())
          }
          tb = BytesBuilder.new()
          lb = BytesBuilder.new()
          lb_lf = false
          leading_blanks = false
        } else {
          s.write(ws.freeze())
          ws = BytesBuilder.new()
        }
      }
      read(p, s)
      end = p.mark
      if p.unread < 2 && !update_buffer(p, 2) {
        return None
      }
    }
    if !(p.is_blank(0) || p.is_break(0)) {
      break
    }
    if p.unread < 1 && !update_buffer(p, 1) {
      return None
    }
    while p.is_blank(0) || p.is_break(0) {
      if p.is_blank(0) {
        if leading_blanks && p.mark.column < indent && p.c(0) == 9 {
          set_scanner_error(p, "while scanning a plain scalar", start, "found a tab character that violates indentation")
          return None
        }
        if !leading_blanks {
          read(p, ws)
        } else {
          skip(p)
        }
      } else {
        if p.unread < 2 && !update_buffer(p, 2) {
          return None
        }
        if !leading_blanks {
          ws = BytesBuilder.new()
          lb_lf = p.break_is_lf()
          read_line(p, lb)
          leading_blanks = true
        } else {
          read_line(p, tb)
        }
      }
      if p.unread < 1 && !update_buffer(p, 1) {
        return None
      }
    }
    if p.flow_level == 0 && p.mark.column < indent {
      break
    }
  }
  var t = tok(T_SCALAR, start, end)
  t.value = s.freeze()
  t.style = S_PLAIN
  if leading_blanks {
    p.simple_key_allowed = true
  }
  Some(t)
}

// ---- parser (parserc.go): tokens to events; comments are stage 4 ----

// Event types.
const E_NONE: Int = 0
const E_STREAM_START: Int = 1
const E_STREAM_END: Int = 2
const E_DOCUMENT_START: Int = 3
const E_DOCUMENT_END: Int = 4
const E_ALIAS: Int = 5
const E_SCALAR: Int = 6
const E_SEQUENCE_START: Int = 7
const E_SEQUENCE_END: Int = 8
const E_MAPPING_START: Int = 9
const E_MAPPING_END: Int = 10

// Collection styles (yaml_sequence_style_t, yaml_mapping_style_t).
const C_BLOCK: Int = 1
const C_FLOW: Int = 2

// Parser states (yaml_parser_state_t).
const PS_STREAM_START: Int = 0
const PS_IMPLICIT_DOCUMENT_START: Int = 1
const PS_DOCUMENT_START: Int = 2
const PS_DOCUMENT_CONTENT: Int = 3
const PS_DOCUMENT_END: Int = 4
const PS_BLOCK_NODE: Int = 5
const PS_BLOCK_NODE_OR_INDENTLESS_SEQUENCE: Int = 6
const PS_FLOW_NODE: Int = 7
const PS_BLOCK_SEQUENCE_FIRST_ENTRY: Int = 8
const PS_BLOCK_SEQUENCE_ENTRY: Int = 9
const PS_INDENTLESS_SEQUENCE_ENTRY: Int = 10
const PS_BLOCK_MAPPING_FIRST_KEY: Int = 11
const PS_BLOCK_MAPPING_KEY: Int = 12
const PS_BLOCK_MAPPING_VALUE: Int = 13
const PS_FLOW_SEQUENCE_FIRST_ENTRY: Int = 14
const PS_FLOW_SEQUENCE_ENTRY: Int = 15
const PS_FLOW_SEQUENCE_ENTRY_MAPPING_KEY: Int = 16
const PS_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE: Int = 17
const PS_FLOW_SEQUENCE_ENTRY_MAPPING_END: Int = 18
const PS_FLOW_MAPPING_FIRST_KEY: Int = 19
const PS_FLOW_MAPPING_KEY: Int = 20
const PS_FLOW_MAPPING_VALUE: Int = 21
const PS_FLOW_MAPPING_EMPTY_VALUE: Int = 22
const PS_END: Int = 23

struct Event {
  typ: Int
  start: Mark
  end: Mark
  /// the %YAML directive of a document start (has_version tells)
  has_version: Bool
  major: Int
  minor: Int
  tag_directives: List[TagDirective]
  anchor: Bytes
  tag: Bytes
  value: Bytes
  implicit: Bool
  quoted_implicit: Bool
  style: Int
}

fn ev(typ: Int, start: Mark, end: Mark) -> Event {
  Event{typ: typ, start: start, end: end, has_version: false, major: 0, minor: 0, tag_directives: [], anchor: b"", tag: b"", value: b"", implicit: false, quoted_implicit: false, style: 0}
}

/// The next token without consuming it; None when the scanner failed.
fn peek_token(var p: Parser) -> Token? {
  if p.token_available || fetch_more_tokens(p) {
    return Some(p.tokens[p.tokens_head])
  }
  None
}

fn skip_token(var p: Parser) {
  p.token_available = false
  p.tokens_parsed += 1
  p.stream_end_produced = p.tokens[p.tokens_head].typ == T_STREAM_END
  p.tokens_head += 1
}

fn set_parser_error(var p: Parser, problem: Str, problem_mark: Mark) -> Bool {
  p.error = PARSER_ERROR
  p.problem = problem
  p.problem_mark = problem_mark
  false
}

fn set_parser_error_context(var p: Parser, context: Str, context_mark: Mark, problem: Str, problem_mark: Mark) -> Bool {
  p.error = PARSER_ERROR
  p.context = context
  p.context_mark = context_mark
  p.problem = problem
  p.problem_mark = problem_mark
  false
}

fn pop_state(var p: Parser) {
  p.state = p.states.pop() ?? PS_END
}

/// The next event (yaml_parser_parse): None when scanning or parsing failed
/// (p.error is set), an E_NONE event at the end of the stream.
fn parse_event(var p: Parser) -> Event? {
  if p.stream_end_produced || p.error != NO_ERROR || p.state == PS_END {
    return Some(ev(E_NONE, mark0(), mark0()))
  }
  let s = p.state
  if s == PS_STREAM_START {
    return parse_stream_start(p)
  }
  if s == PS_IMPLICIT_DOCUMENT_START {
    return parse_document_start(p, true)
  }
  if s == PS_DOCUMENT_START {
    return parse_document_start(p, false)
  }
  if s == PS_DOCUMENT_CONTENT {
    return parse_document_content(p)
  }
  if s == PS_DOCUMENT_END {
    return parse_document_end(p)
  }
  if s == PS_BLOCK_NODE {
    return parse_node(p, true, false)
  }
  if s == PS_BLOCK_NODE_OR_INDENTLESS_SEQUENCE {
    return parse_node(p, true, true)
  }
  if s == PS_FLOW_NODE {
    return parse_node(p, false, false)
  }
  if s == PS_BLOCK_SEQUENCE_FIRST_ENTRY {
    return parse_block_sequence_entry(p, true)
  }
  if s == PS_BLOCK_SEQUENCE_ENTRY {
    return parse_block_sequence_entry(p, false)
  }
  if s == PS_INDENTLESS_SEQUENCE_ENTRY {
    return parse_indentless_sequence_entry(p)
  }
  if s == PS_BLOCK_MAPPING_FIRST_KEY {
    return parse_block_mapping_key(p, true)
  }
  if s == PS_BLOCK_MAPPING_KEY {
    return parse_block_mapping_key(p, false)
  }
  if s == PS_BLOCK_MAPPING_VALUE {
    return parse_block_mapping_value(p)
  }
  if s == PS_FLOW_SEQUENCE_FIRST_ENTRY {
    return parse_flow_sequence_entry(p, true)
  }
  if s == PS_FLOW_SEQUENCE_ENTRY {
    return parse_flow_sequence_entry(p, false)
  }
  if s == PS_FLOW_SEQUENCE_ENTRY_MAPPING_KEY {
    return parse_flow_sequence_entry_mapping_key(p)
  }
  if s == PS_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE {
    return parse_flow_sequence_entry_mapping_value(p)
  }
  if s == PS_FLOW_SEQUENCE_ENTRY_MAPPING_END {
    return parse_flow_sequence_entry_mapping_end(p)
  }
  if s == PS_FLOW_MAPPING_FIRST_KEY {
    return parse_flow_mapping_key(p, true)
  }
  if s == PS_FLOW_MAPPING_KEY {
    return parse_flow_mapping_key(p, false)
  }
  if s == PS_FLOW_MAPPING_VALUE {
    return parse_flow_mapping_value(p, false)
  }
  parse_flow_mapping_value(p, true)
}

fn parse_stream_start(var p: Parser) -> Event? {
  let t = peek_token(p) ?? return None
  if t.typ != T_STREAM_START {
    set_parser_error(p, "did not find expected <stream-start>", t.start)
    return None
  }
  p.state = PS_IMPLICIT_DOCUMENT_START
  skip_token(p)
  Some(ev(E_STREAM_START, t.start, t.end))
}

fn parse_document_start(var p: Parser, implicit: Bool) -> Event? {
  var t = peek_token(p) ?? return None
  if !implicit {
    while t.typ == T_DOCUMENT_END {
      skip_token(p)
      t = peek_token(p) ?? return None
    }
  }
  if implicit && t.typ != T_VERSION_DIRECTIVE && t.typ != T_TAG_DIRECTIVE && t.typ != T_DOCUMENT_START && t.typ != T_STREAM_END {
    if !process_directives(p) {
      return None
    }
    p.states.push(PS_DOCUMENT_END)
    p.state = PS_BLOCK_NODE
    return Some(ev(E_DOCUMENT_START, t.start, t.end))
  }
  if t.typ != T_STREAM_END {
    let start = t.start
    let dirs = process_directives_out(p) ?? return None
    t = peek_token(p) ?? return None
    if t.typ != T_DOCUMENT_START {
      set_parser_error(p, "did not find expected <document start>", t.start)
      return None
    }
    p.states.push(PS_DOCUMENT_END)
    p.state = PS_DOCUMENT_CONTENT
    var e = ev(E_DOCUMENT_START, start, t.end)
    e.has_version = dirs.0
    e.major = dirs.1
    e.minor = dirs.2
    e.tag_directives = dirs.3
    skip_token(p)
    return Some(e)
  }
  p.state = PS_END
  skip_token(p)
  Some(ev(E_STREAM_END, t.start, t.end))
}

fn parse_document_content(var p: Parser) -> Event? {
  let t = peek_token(p) ?? return None
  if t.typ == T_VERSION_DIRECTIVE || t.typ == T_TAG_DIRECTIVE || t.typ == T_DOCUMENT_START || t.typ == T_DOCUMENT_END || t.typ == T_STREAM_END {
    pop_state(p)
    return Some(empty_scalar(t.start))
  }
  parse_node(p, true, false)
}

fn parse_document_end(var p: Parser) -> Event? {
  let t = peek_token(p) ?? return None
  let start = t.start
  var end = t.start
  var implicit = true
  if t.typ == T_DOCUMENT_END {
    end = t.end
    skip_token(p)
    implicit = false
  }
  p.tag_directives = []
  p.state = PS_DOCUMENT_START
  var e = ev(E_DOCUMENT_END, start, end)
  e.implicit = implicit
  Some(e)
}

fn empty_scalar(mark: Mark) -> Event {
  var e = ev(E_SCALAR, mark, mark)
  e.implicit = true
  e.style = S_PLAIN
  e
}

fn parse_node(var p: Parser, block: Bool, indentless_sequence: Bool) -> Event? {
  var t = peek_token(p) ?? return None
  if t.typ == T_ALIAS {
    pop_state(p)
    var e = ev(E_ALIAS, t.start, t.end)
    e.anchor = t.value
    skip_token(p)
    return Some(e)
  }
  var start = t.start
  var end = t.start
  var tag_token = false
  var tag_handle = b""
  var tag_suffix = b""
  var anchor = b""
  var tag_mark = mark0()
  if t.typ == T_ANCHOR {
    anchor = t.value
    start = t.start
    end = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ == T_TAG {
      tag_token = true
      tag_handle = t.value
      tag_suffix = t.suffix
      tag_mark = t.start
      end = t.end
      skip_token(p)
      t = peek_token(p) ?? return None
    }
  } else if t.typ == T_TAG {
    tag_token = true
    tag_handle = t.value
    tag_suffix = t.suffix
    start = t.start
    tag_mark = t.start
    end = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ == T_ANCHOR {
      anchor = t.value
      end = t.end
      skip_token(p)
      t = peek_token(p) ?? return None
    }
  }
  var tag = b""
  if tag_token {
    if tag_handle.len() == 0 {
      tag = tag_suffix
    } else {
      for d in p.tag_directives {
        if d.handle == tag_handle {
          var tb = BytesBuilder.new()
          tb.write(d.prefix)
          tb.write(tag_suffix)
          tag = tb.freeze()
          break
        }
      }
      if tag.len() == 0 {
        set_parser_error_context(p, "while parsing a node", start, "found undefined tag handle", tag_mark)
        return None
      }
    }
  }
  let implicit = tag.len() == 0
  if indentless_sequence && t.typ == T_BLOCK_ENTRY {
    end = t.end
    p.state = PS_INDENTLESS_SEQUENCE_ENTRY
    var e = ev(E_SEQUENCE_START, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.style = C_BLOCK
    return Some(e)
  }
  if t.typ == T_SCALAR {
    var plain_implicit = false
    var quoted_implicit = false
    end = t.end
    if (tag.len() == 0 && t.style == S_PLAIN) || (tag.len() == 1 && tag[0] == 33) {
      plain_implicit = true
    } else if tag.len() == 0 {
      quoted_implicit = true
    }
    pop_state(p)
    var e = ev(E_SCALAR, start, end)
    e.anchor = anchor
    e.tag = tag
    e.value = t.value
    e.implicit = plain_implicit
    e.quoted_implicit = quoted_implicit
    e.style = t.style
    skip_token(p)
    return Some(e)
  }
  if t.typ == T_FLOW_SEQUENCE_START {
    end = t.end
    p.state = PS_FLOW_SEQUENCE_FIRST_ENTRY
    var e = ev(E_SEQUENCE_START, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.style = C_FLOW
    return Some(e)
  }
  if t.typ == T_FLOW_MAPPING_START {
    end = t.end
    p.state = PS_FLOW_MAPPING_FIRST_KEY
    var e = ev(E_MAPPING_START, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.style = C_FLOW
    return Some(e)
  }
  if block && t.typ == T_BLOCK_SEQUENCE_START {
    end = t.end
    p.state = PS_BLOCK_SEQUENCE_FIRST_ENTRY
    var e = ev(E_SEQUENCE_START, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.style = C_BLOCK
    return Some(e)
  }
  if block && t.typ == T_BLOCK_MAPPING_START {
    end = t.end
    p.state = PS_BLOCK_MAPPING_FIRST_KEY
    var e = ev(E_MAPPING_START, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.style = C_BLOCK
    return Some(e)
  }
  if anchor.len() > 0 || tag.len() > 0 {
    pop_state(p)
    var e = ev(E_SCALAR, start, end)
    e.anchor = anchor
    e.tag = tag
    e.implicit = implicit
    e.quoted_implicit = false
    e.style = S_PLAIN
    return Some(e)
  }
  let context = if block { "while parsing a block node" } else { "while parsing a flow node" }
  set_parser_error_context(p, context, start, "did not find expected node content", t.start)
  None
}

fn parse_block_sequence_entry(var p: Parser, first: Bool) -> Event? {
  if first {
    let t0 = peek_token(p) ?? return None
    p.marks.push(t0.start)
    skip_token(p)
  }
  var t = peek_token(p) ?? return None
  if t.typ == T_BLOCK_ENTRY {
    let mark = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_BLOCK_ENTRY && t.typ != T_BLOCK_END {
      p.states.push(PS_BLOCK_SEQUENCE_ENTRY)
      return parse_node(p, true, false)
    }
    p.state = PS_BLOCK_SEQUENCE_ENTRY
    return Some(empty_scalar(mark))
  }
  if t.typ == T_BLOCK_END {
    pop_state(p)
    p.marks.pop()
    skip_token(p)
    return Some(ev(E_SEQUENCE_END, t.start, t.end))
  }
  let context_mark = p.marks.pop() ?? mark0()
  set_parser_error_context(p, "while parsing a block collection", context_mark, "did not find expected '-' indicator", t.start)
  None
}

fn parse_indentless_sequence_entry(var p: Parser) -> Event? {
  var t = peek_token(p) ?? return None
  if t.typ == T_BLOCK_ENTRY {
    let mark = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_BLOCK_ENTRY && t.typ != T_KEY && t.typ != T_VALUE && t.typ != T_BLOCK_END {
      p.states.push(PS_INDENTLESS_SEQUENCE_ENTRY)
      return parse_node(p, true, false)
    }
    p.state = PS_INDENTLESS_SEQUENCE_ENTRY
    return Some(empty_scalar(mark))
  }
  pop_state(p)
  Some(ev(E_SEQUENCE_END, t.start, t.start))
}

fn parse_block_mapping_key(var p: Parser, first: Bool) -> Event? {
  if first {
    let t0 = peek_token(p) ?? return None
    p.marks.push(t0.start)
    skip_token(p)
  }
  var t = peek_token(p) ?? return None
  if t.typ == T_KEY {
    let mark = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_KEY && t.typ != T_VALUE && t.typ != T_BLOCK_END {
      p.states.push(PS_BLOCK_MAPPING_VALUE)
      return parse_node(p, true, true)
    }
    p.state = PS_BLOCK_MAPPING_VALUE
    return Some(empty_scalar(mark))
  } else if t.typ == T_BLOCK_END {
    pop_state(p)
    p.marks.pop()
    skip_token(p)
    return Some(ev(E_MAPPING_END, t.start, t.end))
  }
  let context_mark = p.marks.pop() ?? mark0()
  set_parser_error_context(p, "while parsing a block mapping", context_mark, "did not find expected key", t.start)
  None
}

fn parse_block_mapping_value(var p: Parser) -> Event? {
  var t = peek_token(p) ?? return None
  if t.typ == T_VALUE {
    let mark = t.end
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_KEY && t.typ != T_VALUE && t.typ != T_BLOCK_END {
      p.states.push(PS_BLOCK_MAPPING_KEY)
      return parse_node(p, true, true)
    }
    p.state = PS_BLOCK_MAPPING_KEY
    return Some(empty_scalar(mark))
  }
  p.state = PS_BLOCK_MAPPING_KEY
  Some(empty_scalar(t.start))
}

fn parse_flow_sequence_entry(var p: Parser, first: Bool) -> Event? {
  if first {
    let t0 = peek_token(p) ?? return None
    p.marks.push(t0.start)
    skip_token(p)
  }
  var t = peek_token(p) ?? return None
  if t.typ != T_FLOW_SEQUENCE_END {
    if !first {
      if t.typ == T_FLOW_ENTRY {
        skip_token(p)
        t = peek_token(p) ?? return None
      } else {
        let context_mark = p.marks.pop() ?? mark0()
        set_parser_error_context(p, "while parsing a flow sequence", context_mark, "did not find expected ',' or ']'", t.start)
        return None
      }
    }
    if t.typ == T_KEY {
      p.state = PS_FLOW_SEQUENCE_ENTRY_MAPPING_KEY
      var e = ev(E_MAPPING_START, t.start, t.end)
      e.implicit = true
      e.style = C_FLOW
      skip_token(p)
      return Some(e)
    } else if t.typ != T_FLOW_SEQUENCE_END {
      p.states.push(PS_FLOW_SEQUENCE_ENTRY)
      return parse_node(p, false, false)
    }
  }
  pop_state(p)
  p.marks.pop()
  skip_token(p)
  Some(ev(E_SEQUENCE_END, t.start, t.end))
}

fn parse_flow_sequence_entry_mapping_key(var p: Parser) -> Event? {
  let t = peek_token(p) ?? return None
  if t.typ != T_VALUE && t.typ != T_FLOW_ENTRY && t.typ != T_FLOW_SEQUENCE_END {
    p.states.push(PS_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE)
    return parse_node(p, false, false)
  }
  let mark = t.end
  skip_token(p)
  p.state = PS_FLOW_SEQUENCE_ENTRY_MAPPING_VALUE
  Some(empty_scalar(mark))
}

fn parse_flow_sequence_entry_mapping_value(var p: Parser) -> Event? {
  var t = peek_token(p) ?? return None
  if t.typ == T_VALUE {
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_FLOW_ENTRY && t.typ != T_FLOW_SEQUENCE_END {
      p.states.push(PS_FLOW_SEQUENCE_ENTRY_MAPPING_END)
      return parse_node(p, false, false)
    }
  }
  p.state = PS_FLOW_SEQUENCE_ENTRY_MAPPING_END
  Some(empty_scalar(t.start))
}

fn parse_flow_sequence_entry_mapping_end(var p: Parser) -> Event? {
  let t = peek_token(p) ?? return None
  p.state = PS_FLOW_SEQUENCE_ENTRY
  Some(ev(E_MAPPING_END, t.start, t.start))
}

fn parse_flow_mapping_key(var p: Parser, first: Bool) -> Event? {
  if first {
    let t0 = peek_token(p) ?? return None
    p.marks.push(t0.start)
    skip_token(p)
  }
  var t = peek_token(p) ?? return None
  if t.typ != T_FLOW_MAPPING_END {
    if !first {
      if t.typ == T_FLOW_ENTRY {
        skip_token(p)
        t = peek_token(p) ?? return None
      } else {
        let context_mark = p.marks.pop() ?? mark0()
        set_parser_error_context(p, "while parsing a flow mapping", context_mark, "did not find expected ',' or '}'", t.start)
        return None
      }
    }
    if t.typ == T_KEY {
      skip_token(p)
      t = peek_token(p) ?? return None
      if t.typ != T_VALUE && t.typ != T_FLOW_ENTRY && t.typ != T_FLOW_MAPPING_END {
        p.states.push(PS_FLOW_MAPPING_VALUE)
        return parse_node(p, false, false)
      }
      p.state = PS_FLOW_MAPPING_VALUE
      return Some(empty_scalar(t.start))
    } else if t.typ != T_FLOW_MAPPING_END {
      p.states.push(PS_FLOW_MAPPING_EMPTY_VALUE)
      return parse_node(p, false, false)
    }
  }
  pop_state(p)
  p.marks.pop()
  skip_token(p)
  Some(ev(E_MAPPING_END, t.start, t.end))
}

fn parse_flow_mapping_value(var p: Parser, empty: Bool) -> Event? {
  var t = peek_token(p) ?? return None
  if empty {
    p.state = PS_FLOW_MAPPING_KEY
    return Some(empty_scalar(t.start))
  }
  if t.typ == T_VALUE {
    skip_token(p)
    t = peek_token(p) ?? return None
    if t.typ != T_FLOW_ENTRY && t.typ != T_FLOW_MAPPING_END {
      p.states.push(PS_FLOW_MAPPING_KEY)
      return parse_node(p, false, false)
    }
  }
  p.state = PS_FLOW_MAPPING_KEY
  Some(empty_scalar(t.start))
}

/// Processes the directives before a document: the (has %YAML, major, minor,
/// %TAG directives of the document) and the default tag directives.
fn process_directives_out(var p: Parser) -> (Bool, Int, Int, List[TagDirective])? {
  var has_version = false
  var major = 0
  var minor = 0
  var dirs: List[TagDirective] = []
  var t = peek_token(p) ?? return None
  while t.typ == T_VERSION_DIRECTIVE || t.typ == T_TAG_DIRECTIVE {
    if t.typ == T_VERSION_DIRECTIVE {
      if has_version {
        set_parser_error(p, "found duplicate %YAML directive", t.start)
        return None
      }
      if t.major != 1 || t.minor != 1 {
        set_parser_error(p, "found incompatible YAML document", t.start)
        return None
      }
      has_version = true
      major = t.major
      minor = t.minor
    } else if t.typ == T_TAG_DIRECTIVE {
      let value = TagDirective{handle: t.value, prefix: t.suffix}
      if !append_tag_directive(p, value, false, t.start) {
        return None
      }
      dirs.push(value)
    }
    skip_token(p)
    t = peek_token(p) ?? return None
  }
  if !append_tag_directive(p, TagDirective{handle: b"!", prefix: b"!"}, true, t.start) {
    return None
  }
  if !append_tag_directive(p, TagDirective{handle: b"!!", prefix: b"tag:yaml.org,2002:"}, true, t.start) {
    return None
  }
  Some((has_version, major, minor, dirs))
}

fn process_directives(var p: Parser) -> Bool {
  match process_directives_out(p) {
    Some(_) => true
    None => false
  }
}

fn append_tag_directive(var p: Parser, value: TagDirective, allow_duplicates: Bool, mark: Mark) -> Bool {
  for d in p.tag_directives {
    if d.handle == value.handle {
      if allow_duplicates {
        return true
      }
      return set_parser_error(p, "found duplicate %TAG directive", mark)
    }
  }
  p.tag_directives.push(value)
  true
}

// ---- Node composer (decode.go's parser type) ----

const K_DOCUMENT: Int = 1
const K_SEQUENCE: Int = 2
const K_MAPPING: Int = 4
const K_SCALAR: Int = 8
const K_ALIAS: Int = 16

/// Node styles (yaml.v3's Style bits).
const NS_TAGGED: Int = 1
const NS_DOUBLE: Int = 2
const NS_SINGLE: Int = 4
const NS_LITERAL: Int = 8
const NS_FOLDED: Int = 16
const NS_FLOW: Int = 32



struct Composer {
  p: Parser
  ev: Event
  has_ev: Bool
  doc: yamlcodec.Doc
  err: Str
  init_done: Bool
}

const TAG_PREFIX: Str = "tag:yaml.org,2002:"

fn short_tag(tag: Str) -> Str {
  if tag.starts_with(TAG_PREFIX) {
    return "!!" + tag[TAG_PREFIX.len()..]
  }
  tag
}

fn bytes_str(b: Bytes) -> Str {
  b.to_str_lossy()
}

fn c_fail(var c: Composer, msg: Str) {
  if c.err == "" {
    c.err = msg
  }
}

/// The p.error text yaml.v3's parser.fail builds ("line N: problem").
fn c_fail_parser(var c: Composer) {
  var line = 0
  if c.p.context_mark.line != 0 {
    line = c.p.context_mark.line
    if c.p.error == SCANNER_ERROR {
      line += 1
    }
  } else if c.p.problem_mark.line != 0 {
    line = c.p.problem_mark.line
    if c.p.error == SCANNER_ERROR {
      line += 1
    }
  }
  let msg = if c.p.problem.len() > 0 { c.p.problem } else { "unknown problem parsing YAML content" }
  c_fail(c, if line != 0 { "line ${line}: ${msg}" } else { msg })
}

fn c_peek(var c: Composer) -> Int {
  if c.has_ev {
    return c.ev.typ
  }
  match parse_event(c.p) {
    Some(e) => {
      c.ev = e
      c.has_ev = true
      return e.typ
    }
    None => {
      c_fail_parser(c)
      return -1
    }
  }
}

fn c_next(var c: Composer) {
  c.has_ev = false
}

fn new_node(var c: Composer, kind: Int, default_tag: Str, tag_in: Str, value: Str) -> Int {
  var tag = tag_in
  var style = 0
  if tag != "" && tag != "!" {
    tag = short_tag(tag)
    style = NS_TAGGED
  } else if default_tag != "" {
    tag = default_tag
  } else if kind == K_SCALAR {
    tag = resolve_tag("", value)
  }
  c.doc.nodes.push(yamlcodec.Node{kind: kind, style: style, tag: tag, value: value, anchor: "", alias: -1, content: [], line: c.ev.start.line + 1, column: c.ev.start.column + 1})
  c.doc.nodes.len() - 1
}

fn c_anchor(var c: Composer, n: Int) {
  if c.ev.anchor.len() > 0 {
    let a = bytes_str(c.ev.anchor)
    c.doc.nodes[n].anchor = a
    c.doc.anchors.put(a, n)
  }
}

/// Composes the next node (parser.parse); -1 at the end of the stream or on error.
fn c_parse(var c: Composer) -> Int {
  if !c.init_done {
    c.init_done = true
    if c_peek(c) != E_STREAM_START {
      c_fail(c, "expected stream start event")
      return -1
    }
    c_next(c)
  }
  let t = c_peek(c)
  if t == E_SCALAR {
    return c_scalar(c)
  }
  if t == E_ALIAS {
    return c_alias(c)
  }
  if t == E_MAPPING_START {
    return c_mapping(c)
  }
  if t == E_SEQUENCE_START {
    return c_sequence(c)
  }
  if t == E_DOCUMENT_START {
    return c_document(c)
  }
  if t == E_STREAM_END {
    return -1
  }
  if t >= 0 {
    c_fail(c, "internal error: attempted to parse unknown event")
  }
  -1
}

fn c_child(var c: Composer, parent: Int) -> Int {
  let ch = c_parse(c)
  if c.err != "" || ch < 0 {
    if c.err == "" {
      c_fail(c, "attempted to go past the end of stream; corrupted value?")
    }
    return -1
  }
  c.doc.nodes[parent].content.push(ch)
  ch
}

fn c_document(var c: Composer) -> Int {
  let n = new_node(c, K_DOCUMENT, "", "", "")
  c.doc.root = n
  c_next(c)
  c_child(c, n)
  if c.err != "" {
    return -1
  }
  if c_peek(c) != E_DOCUMENT_END {
    if c.err == "" {
      c_fail(c, "expected document end event")
    }
    return -1
  }
  c_next(c)
  n
}

fn c_alias(var c: Composer) -> Int {
  let name = bytes_str(c.ev.anchor)
  let n = new_node(c, K_ALIAS, "", "", name)
  match c.doc.anchors.get(name) {
    Some(a) => c.doc.nodes[n].alias = a
    None => {
      c_fail(c, "unknown anchor '${name}' referenced")
      return -1
    }
  }
  c_next(c)
  n
}

fn c_scalar(var c: Composer) -> Int {
  let ps = c.ev.style
  var ns = 0
  if ps == S_DOUBLE {
    ns = NS_DOUBLE
  } else if ps == S_SINGLE {
    ns = NS_SINGLE
  } else if ps == S_LITERAL {
    ns = NS_LITERAL
  } else if ps == S_FOLDED {
    ns = NS_FOLDED
  }
  let value = bytes_str(c.ev.value)
  let tag = bytes_str(c.ev.tag)
  var default_tag = ""
  if ns == 0 {
    if value == "<<" {
      default_tag = "!!merge"
    }
  } else {
    default_tag = "!!str"
  }
  let n = new_node(c, K_SCALAR, default_tag, tag, value)
  c.doc.nodes[n].style = c.doc.nodes[n].style | ns
  c_anchor(c, n)
  c_next(c)
  n
}

fn c_sequence(var c: Composer) -> Int {
  let n = new_node(c, K_SEQUENCE, "!!seq", bytes_str(c.ev.tag), "")
  if c.ev.style == C_FLOW {
    c.doc.nodes[n].style = c.doc.nodes[n].style | NS_FLOW
  }
  c_anchor(c, n)
  c_next(c)
  while c_peek(c) != E_SEQUENCE_END {
    if c.err != "" || c_child(c, n) < 0 {
      return -1
    }
  }
  c_next(c)
  n
}

fn c_mapping(var c: Composer) -> Int {
  let n = new_node(c, K_MAPPING, "!!map", bytes_str(c.ev.tag), "")
  if c.ev.style == C_FLOW {
    c.doc.nodes[n].style = c.doc.nodes[n].style | NS_FLOW
  }
  c_anchor(c, n)
  c_next(c)
  while c_peek(c) != E_MAPPING_END {
    if c.err != "" || c_child(c, n) < 0 || c_child(c, n) < 0 {
      return -1
    }
  }
  c_next(c)
  n
}

/// Every document of text as Node trees in one arena, or the error message.
fn compose_all(text: Bytes) -> Result[List[yamlcodec.Doc], Str] {
  compose_docs(text, -1)
}

/// The first `limit` documents of text (all when limit is negative).
fn compose_docs(text: Bytes, limit: Int) -> Result[List[yamlcodec.Doc], Str] {
  var c = Composer{p: new_parser(if text.len() == 0 { b"\n" } else { text }), ev: ev(E_NONE, mark0(), mark0()), has_ev: false, doc: yamlcodec.Doc{nodes: [], anchors: {}, root: -1}, err: "", init_done: false}
  var docs: List[yamlcodec.Doc] = []
  while true {
    c.doc = yamlcodec.Doc{nodes: [], anchors: {}, root: -1}
    let n = c_parse(c)
    if c.err != "" {
      return Err(c.err)
    }
    if n < 0 {
      break
    }
    docs.push(c.doc)
    if limit >= 0 && docs.len() >= limit {
      break
    }
  }
  Ok(docs)
}

// ---- resolver (resolve.go): the tag of a plain scalar ----

fn resolve_tag(tag: Str, input: Str) -> Str {
  if input == "" || input == "~" || input == "null" || input == "Null" || input == "NULL" {
    return "!!null"
  }
  if input == "true" || input == "True" || input == "TRUE" || input == "false" || input == "False" || input == "FALSE" {
    return "!!bool"
  }
  if input == "<<" {
    return "!!merge"
  }
  let c = input.bytes()[0]
  let digit = c >= 48 && c <= 57
  if c == 46 {
    if input == ".nan" || input == ".NaN" || input == ".NAN" || input == ".inf" || input == ".Inf" || input == ".INF" {
      return "!!float"
    }
    if Float.parse(input) != None {
      return "!!float"
    }
    return "!!str"
  }
  if input == "+.inf" || input == "+.Inf" || input == "+.INF" || input == "-.inf" || input == "-.Inf" || input == "-.INF" {
    return "!!float"
  }
  if digit || c == 43 || c == 45 {
    let plain = input.replace("_", "")
    if Int.parse_base(plain, 0) != None || is_uint64(plain) {
      return "!!int"
    }
    if is_yaml_float(plain) && Float.parse(plain) != None {
      return "!!float"
    }
    if plain.starts_with("0b") && Int.parse_base(plain[2..], 2) != None {
      return "!!int"
    }
    if plain.starts_with("-0b") && Int.parse_base("-" + plain[3..], 2) != None {
      return "!!int"
    }
    if plain.starts_with("0o") && Int.parse_base(plain[2..], 8) != None {
      return "!!int"
    }
    if plain.starts_with("-0o") && Int.parse_base("-" + plain[3..], 8) != None {
      return "!!int"
    }
    if is_timestamp(input) {
      return "!!timestamp"
    }
  }
  "!!str"
}

/// ^[-+]?(\.[0-9]+|[0-9]+(\.[0-9]*)?)([eE][-+]?[0-9]+)?$
fn is_yaml_float(s: Str) -> Bool {
  let b = s.bytes()
  var i = 0
  let n = b.len()
  if i < n && (b[i] == 43 || b[i] == 45) {
    i += 1
  }
  var digits = 0
  if i < n && b[i] == 46 {
    i += 1
    while i < n && b[i] >= 48 && b[i] <= 57 {
      i += 1
      digits += 1
    }
    if digits == 0 {
      return false
    }
  } else {
    while i < n && b[i] >= 48 && b[i] <= 57 {
      i += 1
      digits += 1
    }
    if digits == 0 {
      return false
    }
    if i < n && b[i] == 46 {
      i += 1
      while i < n && b[i] >= 48 && b[i] <= 57 {
        i += 1
      }
    }
  }
  if i < n && (b[i] == 101 || b[i] == 69) {
    i += 1
    if i < n && (b[i] == 43 || b[i] == 45) {
      i += 1
    }
    var ed = 0
    while i < n && b[i] >= 48 && b[i] <= 57 {
      i += 1
      ed += 1
    }
    if ed == 0 {
      return false
    }
  }
  i == n
}

/// Reads 1 or 2 digits at b[i..], returns (value, next index) or (-1, i).
fn ts_num(b: Bytes, i: Int, max_digits: Int) -> (Int, Int) {
  var j = i
  var v = 0
  while j < b.len() && j - i < max_digits && b[j] >= 48 && b[j] <= 57 {
    v = v * 10 + Int(b[j]) - 48
    j += 1
  }
  if j == i {
    return (-1, i)
  }
  (v, j)
}

/// A timestamp in one of yaml.v3's layouts: 2006-1-2, 2006-1-2 15:4:5[.9], and
/// 2006-1-2T15:4:5[.9]Z07:00 (also with t), with Go's range checks.
fn is_timestamp(s: Str) -> Bool {
  let b = s.bytes()
  if b.len() < 8 || !(b[0] >= 48 && b[0] <= 57 && b[1] >= 48 && b[1] <= 57 && b[2] >= 48 && b[2] <= 57 && b[3] >= 48 && b[3] <= 57) || b[4] != 45 {
    return false
  }
  let year = (Int(b[0]) - 48) * 1000 + (Int(b[1]) - 48) * 100 + (Int(b[2]) - 48) * 10 + Int(b[3]) - 48
  let m = ts_num(b, 5, 2)
  if m.0 < 1 || m.0 > 12 || m.1 >= b.len() || b[m.1] != 45 {
    return false
  }
  let d = ts_num(b, m.1 + 1, 2)
  if d.0 < 1 {
    return false
  }
  let leap = (year % 4 == 0 && year % 100 != 0) || year % 400 == 0
  var dim = 31
  if m.0 == 4 || m.0 == 6 || m.0 == 9 || m.0 == 11 {
    dim = 30
  } else if m.0 == 2 {
    dim = if leap { 29 } else { 28 }
  }
  if d.0 > dim {
    return false
  }
  var i = d.1
  if i == b.len() {
    return true
  }
  var tz = false
  if b[i] == 84 || b[i] == 116 {
    tz = true
    i += 1
  } else if b[i] == 32 {
    i += 1
  } else {
    return false
  }
  let h = ts_num(b, i, 2)
  if h.0 < 0 || h.0 > 23 || h.1 >= b.len() || b[h.1] != 58 {
    return false
  }
  let mi = ts_num(b, h.1 + 1, 2)
  if mi.0 < 0 || mi.0 > 59 || mi.1 >= b.len() || b[mi.1] != 58 {
    return false
  }
  let sec = ts_num(b, mi.1 + 1, 2)
  if sec.0 < 0 || sec.0 > 59 {
    return false
  }
  i = sec.1
  if i < b.len() && b[i] == 46 {
    i += 1
    var nd = 0
    while i < b.len() && b[i] >= 48 && b[i] <= 57 {
      i += 1
      nd += 1
    }
    if nd == 0 {
      return false
    }
  }
  if i == b.len() {
    return true
  }
  if !tz {
    return false
  }
  if b[i] == 90 {
    return i + 1 == b.len()
  }
  if b[i] != 43 && b[i] != 45 {
    return false
  }
  let th = ts_num(b, i + 1, 2)
  if th.1 != i + 3 || th.0 > 23 || th.1 >= b.len() || b[th.1] != 58 {
    return false
  }
  let tm = ts_num(b, th.1 + 1, 2)
  tm.1 == th.1 + 3 && tm.0 <= 59 && tm.1 == b.len()
}

fn res(d: yamlcodec.Doc, i: Int) -> Int {
  var j = i
  while d.nodes[j].kind == K_ALIAS {
    j = d.nodes[j].alias
  }
  j
}

/// One entry of yaml.v3's "unmarshal errors:" list.
fn yerr(d: yamlcodec.Doc, i: Int, msg: Str) -> yaml.YamlErr {
  yaml.YamlErr{line: d.nodes[i].line, msg: "line ${d.nodes[i].line}: ${msg}"}
}

fn kind_tag(n: yamlcodec.Node) -> Str {
  if n.kind == K_MAPPING {
    "!!map"
  } else if n.kind == K_SEQUENCE {
    "!!seq"
  } else {
    n.tag
  }
}

fn cannot(d: yamlcodec.Doc, i: Int, into: Str) -> yaml.YamlErr {
  let n = d.nodes[i]
  if n.kind != K_SCALAR && n.style & NS_TAGGED != 0 && n.tag != "!!seq" && n.tag != "!!map" {
    return yerr(d, i, "cannot unmarshal ${n.tag} `` into ${into}")
  }
  if n.kind == K_SCALAR && (n.tag == "!!seq" || n.tag == "!!map") {
    return yerr(d, i, "cannot unmarshal ${n.tag} into ${into}")
  }
  if n.kind == K_SCALAR {
    let v = if n.value.len() > 10 { n.value[0..7] + "..." } else { n.value }
    yerr(d, i, "cannot unmarshal ${n.tag} `${v}` into ${into}")
  } else {
    yerr(d, i, "cannot unmarshal ${kind_tag(n)} into ${into}")
  }
}


/// yaml.v3's accounting of decode work (decode.go unmarshal): every node read counts,
/// and a node read through an alias counts again as alias-driven; a document whose
/// alias-driven share passes the allowed ratio is refused, so that a few aliases
/// cannot expand into a huge value.
fn allowed_alias_ratio(dc: Int) -> Float {
  if dc <= 400000 {
    return 0.99
  }
  if dc >= 4000000 {
    return 0.10
  }
  0.99 - 0.89 * (Float(dc - 400000) / 3600000.0)
}

/// Counts the read of node i0; for an alias, enters it (leave undoes it) and counts
/// its target too. A target already being read is an alias to itself.
fn tick(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> Bool ! yaml.YamlErr {
  st.dc += 1
  if st.ad > 0 {
    st.ac += 1
  }
  if st.ac > 100 && st.dc > 1000 && Float(st.ac) / Float(st.dc) > allowed_alias_ratio(st.dc) {
    return Err(yaml.YamlErr{line: 0, msg: "document contains excessive aliasing"})
  }
  if d.nodes[i0].kind != K_ALIAS {
    return Ok(false)
  }
  let t = d.nodes[i0].alias
  if st.active.contains(t) {
    return Err(yaml.YamlErr{line: 0, msg: "anchor '${d.nodes[i0].value}' value contains itself"})
  }
  st.active.push(t)
  st.ad += 1
  let _ = tick(d, t, st)?
  Ok(true)
}

fn leave(var st: yamlcodec.Dec, entered: Bool) {
  if entered {
    st.ad -= 1
    st.active.pop()
  }
}

fn dec_new(strict: Bool) -> yamlcodec.Dec {
  yamlcodec.Dec{errs: [], dc: 1, ac: 0, ad: 0, active: [], strict: strict}
}

/// The error of a decode that collected errs: yaml.v3's "unmarshal errors:" list.
fn errors(st: yamlcodec.Dec) -> yaml.YamlErr {
  var out = "unmarshal errors:"
  for e in st.errs {
    out += "\n  ${e.msg}"
  }
  yaml.YamlErr{line: st.errs[0].line, msg: out}
}

fn parse(text: Str) -> yamlcodec.Doc ! yaml.YamlErr {
  match compose_docs(text.bytes(), 1) {
    Err(m) => Err(yaml.YamlErr{line: 0, msg: m})
    Ok(docs) => {
      if docs.len() == 0 {
        return Ok(yamlcodec.Doc{nodes: [], anchors: {}, root: -1})
      }
      Ok(docs[0])
    }
  }
}

fn parse_all(text: Str) -> List[yamlcodec.Doc] ! yaml.YamlErr {
  match compose_docs(text.bytes(), -1) {
    Err(m) => Err(yaml.YamlErr{line: 0, msg: m})
    Ok(docs) => Ok(docs)
  }
}

fn root(d: yamlcodec.Doc) -> Int {
  if d.root < 0 || d.nodes.len() == 0 {
    return -1
  }
  d.nodes[d.root].content[0]
}

fn is_null(d: yamlcodec.Doc, i: Int) -> Bool {
  let n = d.nodes[res(d, i)]
  n.kind == K_SCALAR && n.tag == "!!null"
}

/// yaml.v3's resolve with an explicit tag: a scalar tagged !!bool, !!int, !!float,
/// !!null or !!timestamp must resolve to that tag (an int may be a !!float). This
/// error ends the decode.
fn check_tag(d: yamlcodec.Doc, i: Int) -> yaml.YamlErr? {
  let n = d.nodes[i]
  if n.style & NS_TAGGED == 0 || !(n.tag is "!!bool" | "!!int" | "!!float" | "!!null" | "!!timestamp") {
    return None
  }
  let r = resolve_tag("", n.value)
  if r == n.tag || (n.tag == "!!float" && r == "!!int") {
    return None
  }
  Some(yaml.YamlErr{line: 0, msg: "cannot decode ${r} `${n.value}` as a ${n.tag}"})
}

fn to_str(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Str) ! yaml.YamlErr {
  let entered = tick(d, i0, st)?
  let r = to_str_body(d, i0, st)
  leave(st, entered)
  r
}

fn to_str_body(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Str) ! yaml.YamlErr {
  let i = res(d, i0)
  let n = d.nodes[i]
  if n.kind != K_SCALAR {
    st.errs.push(cannot(d, i, "string"))
    return Ok((false, ""))
  }
  if let Some(e) = check_tag(d, i) {
    return Err(e)
  }
  if n.tag == "!!null" {
    return Ok((false, ""))
  }
  if n.tag == "!!binary" {
    let raw = n.value.replace("\n", "").replace("\r", "")
    match Bytes.from_base64(raw) {
      Some(b) => return Ok((true, b.to_str_lossy()))
      None => return Err(yaml.YamlErr{line: 0, msg: "!!binary value contains invalid base64 data"})
    }
  }
  Ok((true, n.value))
}

fn int_of(d: yamlcodec.Doc, n: yamlcodec.Node) -> Int? {
  if n.tag == "!!int" {
    let plain = n.value.replace("_", "")
    if let Some(v) = Int.parse_base(plain, 0) {
      return Some(v)
    }
    if plain.starts_with("0b") {
      if let Some(v) = Int.parse_base(plain[2..], 2) {
        return Some(v)
      }
    }
    if plain.starts_with("-0b") {
      if let Some(v) = Int.parse_base("-" + plain[3..], 2) {
        return Some(v)
      }
    }
    if plain.starts_with("0o") {
      if let Some(v) = Int.parse_base(plain[2..], 8) {
        return Some(v)
      }
    }
    if plain.starts_with("-0o") {
      if let Some(v) = Int.parse_base("-" + plain[3..], 8) {
        return Some(v)
      }
    }
  }
  if n.tag == "!!float" {
    if let Some(f) = Float.parse(n.value.replace("_", "")) {
      if !f.is_nan() && !f.is_inf() && f >= -9223372036854775808.0 && f < 9223372036854775808.0 {
        return Some(Int(f))
      }
    }
  }
  None
}

fn to_int(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Int) ! yaml.YamlErr {
  let entered = tick(d, i0, st)?
  let r = to_int_body(d, i0, st)
  leave(st, entered)
  r
}

fn to_int_body(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Int) ! yaml.YamlErr {
  let i = res(d, i0)
  let n = d.nodes[i]
  if n.kind != K_SCALAR {
    st.errs.push(cannot(d, i, "int"))
    return Ok((false, 0))
  }
  if let Some(e) = check_tag(d, i) {
    return Err(e)
  }
  if n.tag == "!!null" {
    return Ok((false, 0))
  }
  if let Some(v) = int_of(d, n) {
    return Ok((true, v))
  }
  st.errs.push(cannot(d, i, "int"))
  Ok((false, 0))
}

fn to_float(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Float) ! yaml.YamlErr {
  let entered = tick(d, i0, st)?
  let r = to_float_body(d, i0, st)
  leave(st, entered)
  r
}

fn to_float_body(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Float) ! yaml.YamlErr {
  let i = res(d, i0)
  let n = d.nodes[i]
  if n.kind != K_SCALAR {
    st.errs.push(cannot(d, i, "float64"))
    return Ok((false, 0.0))
  }
  if let Some(e) = check_tag(d, i) {
    return Err(e)
  }
  if n.tag == "!!null" {
    return Ok((false, 0.0))
  }
  if n.tag == "!!int" {
    if let Some(v) = int_of(d, n) {
      return Ok((true, Float(v)))
    }
    if let Some(f) = Float.parse(n.value.replace("_", "")) {
      return Ok((true, f))
    }
  }
  if n.tag == "!!float" {
    let v = n.value
    if v == ".nan" || v == ".NaN" || v == ".NAN" {
      return Ok((true, Float.from_bits(9221120237041090560)))
    }
    if v == ".inf" || v == ".Inf" || v == ".INF" || v == "+.inf" || v == "+.Inf" || v == "+.INF" {
      return Ok((true, Float.from_bits(9218868437227405312)))
    }
    if v == "-.inf" || v == "-.Inf" || v == "-.INF" {
      return Ok((true, Float.from_bits(-4503599627370496)))
    }
    if let Some(f) = Float.parse(v.replace("_", "")) {
      return Ok((true, f))
    }
  }
  st.errs.push(cannot(d, i, "float64"))
  Ok((false, 0.0))
}

fn to_bool(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Bool) ! yaml.YamlErr {
  let entered = tick(d, i0, st)?
  let r = to_bool_body(d, i0, st)
  leave(st, entered)
  r
}

fn to_bool_body(d: yamlcodec.Doc, i0: Int, var st: yamlcodec.Dec) -> (Bool, Bool) ! yaml.YamlErr {
  let i = res(d, i0)
  let n = d.nodes[i]
  if n.kind != K_SCALAR {
    st.errs.push(cannot(d, i, "bool"))
    return Ok((false, false))
  }
  if let Some(e) = check_tag(d, i) {
    return Err(e)
  }
  if n.tag == "!!null" {
    return Ok((false, false))
  }
  if n.tag == "!!bool" {
    return Ok((true, n.value == "true" || n.value == "True" || n.value == "TRUE"))
  }
  let v = n.value
  if v == "y" || v == "Y" || v == "yes" || v == "Yes" || v == "YES" || v == "on" || v == "On" || v == "ON" {
    return Ok((true, true))
  }
  if v == "n" || v == "N" || v == "no" || v == "No" || v == "NO" || v == "off" || v == "Off" || v == "OFF" {
    return Ok((true, false))
  }
  st.errs.push(cannot(d, i, "bool"))
  Ok((false, false))
}

fn items(d: yamlcodec.Doc, i0: Int, what: Str, var st: yamlcodec.Dec) -> (Bool, List[Int]) {
  let i = res(d, i0)
  if d.nodes[i].kind != K_SEQUENCE {
    st.errs.push(cannot(d, i, what))
    return (false, [])
  }
  (true, d.nodes[i].content)
}

/// The entries of mapping node i0 as yaml.v3 decodes them: its own, then those of
/// its merge keys (a name already present wins, an earlier merged mapping before a
/// later one). 0 when it is not a mapping, 2 when it repeats a key (put in st.errs:
/// yaml.v3 decodes nothing of it), else 1. A key that is not a scalar is put in st.errs
/// and left out. A merge value that is not a mapping, an alias of one, or a sequence
/// of those ends the decode (yaml.v3's failf).
fn add_pairs(d: yamlcodec.Doc, i0: Int, var out: List[(Str, Int, Int)], var st: yamlcodec.Dec) -> Int ! yaml.YamlErr {
  let i = res(d, i0)
  let n = d.nodes[i]
  if n.kind != K_MAPPING {
    return Ok(0)
  }
  let nerrs = st.errs.len()
  var a = 0
  while a + 1 < n.content.len() {
    let ka = d.nodes[n.content[a]]
    var b = a + 2
    while b + 1 < n.content.len() {
      let kb = d.nodes[n.content[b]]
      if ka.kind == kb.kind && ka.value == kb.value {
        st.errs.push(yaml.YamlErr{line: kb.line, msg: "line ${kb.line}: mapping key ${kb.value.quote()} already defined at line ${ka.line}"})
      }
      b += 2
    }
    a += 2
  }
  if st.errs.len() > nerrs {
    return Ok(2)
  }
  var seen: Map[Str, Bool] = {}
  for p in out {
    seen[p.0] = true
  }
  var merges: List[Int] = []
  var k = 0
  while k + 1 < n.content.len() {
    let ki = res(d, n.content[k])
    let kn = d.nodes[ki]
    let v = n.content[k + 1]
    st.dc += 1
    if kn.kind == K_SCALAR && kn.tag == "!!merge" {
      merges.push(v)
    } else if kn.kind == K_SCALAR {
      // a null key reads as no string: yaml.v3 skips the entry
      if kn.tag != "!!null" && !seen.contains(kn.value) {
        seen[kn.value] = true
        out.push((kn.value, v, kn.line))
      }
    } else {
      // reported when the entry is reached, in document order (bad_key)
      out.push(("", -1 - ki, 0))
    }
    k += 2
  }
  // yaml.v3 reads a mapping's keys before its merges: the last merge key wins
  if merges.len() > 0 {
    let m = merges[merges.len() - 1]
    let mn = d.nodes[m]
    if mn.kind == K_SEQUENCE {
      for it in mn.content {
        if d.nodes[it].kind == K_ALIAS {
          if d.nodes[res(d, it)].kind != K_MAPPING {
            out.push(("", MERGE_FAIL, 0))
            return Ok(1)
          }
        } else if d.nodes[it].kind != K_MAPPING {
          out.push(("", MERGE_FAIL, 0))
          return Ok(1)
        }
        add_pairs(d, it, out, st)?
      }
    } else if mn.kind == K_ALIAS {
      if d.nodes[res(d, m)].kind != K_MAPPING {
        out.push(("", MERGE_FAIL, 0))
        return Ok(1)
      }
      add_pairs(d, m, out, st)?
    } else if mn.kind == K_MAPPING {
      add_pairs(d, m, out, st)?
    } else {
      out.push(("", MERGE_FAIL, 0))
      return Ok(1)
    }
  }
  Ok(1)
}

/// yaml.v3's KnownFields error for a key no field takes (only a strict decode).
fn unknown_field(var st: yamlcodec.Dec, k: Str, line: Int, typ: Str) {
  if st.strict {
    st.errs.push(yaml.YamlErr{line: line, msg: "line ${line}: field ${k} not found in type ${typ}"})
  }
}

/// The value of the entry pairs ends a list with for a bad merge value: reached
/// after the mapping's own entries, as yaml.v3 merges last.
const MERGE_FAIL: Int = -1000000000

/// The error of a pairs entry whose value v is negative: a key that is not a scalar
/// (v is -1 - key node; put in errs), or a bad merge value (ends the decode).
fn bad_key(d: yamlcodec.Doc, v: Int, var st: yamlcodec.Dec) -> Bool ! yaml.YamlErr {
  if v == MERGE_FAIL {
    return Err(merge_err())
  }
  let ki = -1 - v
  st.errs.push(yerr(d, ki, "cannot unmarshal ${kind_tag(d.nodes[ki])} into string"))
  Ok(true)
}

fn merge_err() -> yaml.YamlErr {
  yaml.YamlErr{line: 0, msg: "map merge requires map or sequence of maps as the value"}
}

fn pairs(d: yamlcodec.Doc, i0: Int, what: Str, var st: yamlcodec.Dec) -> (Bool, List[(Str, Int, Int)]) ! yaml.YamlErr {
  let i = res(d, i0)
  var out: List[(Str, Int, Int)] = []
  let kind = add_pairs(d, i, out, st)?
  if kind == 0 {
    st.errs.push(cannot(d, i, what))
    return Ok((false, []))
  }
  if kind == 2 {
    return Ok((false, []))
  }
  Ok((true, out))
}

/// Whether plain is a non-negative integer (base prefix 0x, 0b, 0o, or decimal and
/// leading 0 octal as Go's ParseUint(s, 0, 64) reads) that fits 64 bits unsigned.
fn is_uint64(plain: Str) -> Bool {
  let b = plain.bytes()
  if b.len() > 0 && b[0] == 43 {
    return false
  }
  var base = 10
  var start = 0
  if b.len() > 1 && b[0] == 48 {
    let x = b[1]
    if x == 120 || x == 88 {
      base = 16
      start = 2
    } else if x == 98 || x == 66 {
      base = 2
      start = 2
    } else if x == 111 || x == 79 {
      base = 8
      start = 2
    } else {
      base = 8
      start = 1
    }
  }
  if start >= b.len() {
    return false
  }
  var hi = 0
  var lo = 0
  var i = start
  while i < b.len() {
    let c = Int(b[i])
    var dg = -1
    if c >= 48 && c <= 57 {
      dg = c - 48
    } else if c >= 97 && c <= 102 {
      dg = c - 87
    } else if c >= 65 && c <= 70 {
      dg = c - 55
    }
    if dg < 0 || dg >= base {
      return false
    }
    lo = lo * base + dg
    hi = hi * base + (lo >> 32)
    lo = lo & 4294967295
    if hi > 4294967295 {
      return false
    }
    i += 1
  }
  true
}

// ---- the emitter (emitterc.go, writerc.go) ----

const ES_STREAM_START: Int = 0
const ES_FIRST_DOCUMENT_START: Int = 1
const ES_DOCUMENT_START: Int = 2
const ES_DOCUMENT_CONTENT: Int = 3
const ES_DOCUMENT_END: Int = 4
const ES_FLOW_SEQUENCE_FIRST_ITEM: Int = 5
const ES_FLOW_SEQUENCE_ITEM: Int = 6
const ES_FLOW_MAPPING_FIRST_KEY: Int = 7
const ES_FLOW_MAPPING_KEY: Int = 8
const ES_FLOW_MAPPING_SIMPLE_VALUE: Int = 9
const ES_FLOW_MAPPING_VALUE: Int = 10
const ES_BLOCK_SEQUENCE_FIRST_ITEM: Int = 11
const ES_BLOCK_SEQUENCE_ITEM: Int = 12
const ES_BLOCK_MAPPING_FIRST_KEY: Int = 13
const ES_BLOCK_MAPPING_KEY: Int = 14
const ES_BLOCK_MAPPING_SIMPLE_VALUE: Int = 15
const ES_BLOCK_MAPPING_VALUE: Int = 16
const ES_END: Int = 17

struct Emitter {
  out: BytesBuilder
  err: Str
  state: Int
  states: List[Int]
  events: List[Event]
  events_head: Int
  indents: List[Int]
  tag_directives: List[TagDirective]
  indent: Int
  flow_level: Int
  root_context: Bool
  sequence_context: Bool
  mapping_context: Bool
  simple_key_context: Bool
  line: Int
  column: Int
  whitespace: Bool
  indention: Bool
  open_ended: Bool
  best_indent: Int
  best_width: Int
  canonical: Bool
  unicode: Bool
  anchor: Bytes
  anchor_alias: Bool
  tag_handle: Bytes
  tag_suffix: Bytes
  sv: Bytes
  s_multiline: Bool
  s_flow_plain: Bool
  s_block_plain: Bool
  s_single: Bool
  s_block: Bool
  s_style: Int
}

fn new_emitter(indent: Int) -> Emitter {
  Emitter{out: BytesBuilder.new(), err: "", state: ES_STREAM_START, states: [], events: [], events_head: 0, indents: [], tag_directives: [], indent: -1, flow_level: 0, root_context: false, sequence_context: false, mapping_context: false, simple_key_context: false, line: 0, column: 0, whitespace: false, indention: false, open_ended: false, best_indent: indent, best_width: -1, canonical: false, unicode: true, anchor: b"", anchor_alias: false, tag_handle: b"", tag_suffix: b"", sv: b"", s_multiline: false, s_flow_plain: false, s_block_plain: false, s_single: false, s_block: false, s_style: 0}
}

/// The byte at i, 0 past the end (the C code reads the NUL terminator).
fn at(b: Bytes, i: Int) -> Int {
  if i < b.len() {
    Int(b[i])
  } else {
    0
  }
}

fn width_of(b: Int) -> Int {
  if b & 128 == 0 {
    return 1
  }
  if b & 224 == 192 {
    return 2
  }
  if b & 240 == 224 {
    return 3
  }
  if b & 248 == 240 {
    return 4
  }
  0
}

fn em_is_alpha(b: Bytes, i: Int) -> Bool {
  let c = at(b, i)
  (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45
}

fn is_printable_at(b: Bytes, i: Int) -> Bool {
  let c = at(b, i)
  let c1 = at(b, i + 1)
  let c2 = at(b, i + 2)
  c == 10 || (c >= 32 && c <= 126) || (c == 194 && c1 >= 160) || (c > 194 && c < 237) || (c == 237 && c1 < 160) || c == 238 || (c == 239 && !(c1 == 187 && c2 == 191) && !(c1 == 191 && (c2 == 190 || c2 == 191)))
}

/// yaml.v3's is_bom looks at the start of the buffer, not at i.
fn is_bom_at(b: Bytes, i: Int) -> Bool {
  at(b, 0) == 239 && at(b, 1) == 187 && at(b, 2) == 191
}

fn is_space_at(b: Bytes, i: Int) -> Bool {
  at(b, i) == 32
}

fn is_blank_at(b: Bytes, i: Int) -> Bool {
  at(b, i) == 32 || at(b, i) == 9
}

fn is_break_at(b: Bytes, i: Int) -> Bool {
  let c = at(b, i)
  c == 13 || c == 10 || (c == 194 && at(b, i + 1) == 133) || (c == 226 && at(b, i + 1) == 128 && (at(b, i + 2) == 168 || at(b, i + 2) == 169))
}

fn is_blankz_at(b: Bytes, i: Int) -> Bool {
  is_blank_at(b, i) || is_break_at(b, i) || at(b, i) == 0
}

fn em_error(var e: Emitter, problem: Str) -> Bool {
  if e.err == "" {
    e.err = problem
  }
  false
}

fn put(var e: Emitter, c: Int) {
  e.out.write_byte(UInt8(c))
  e.column += 1
}

fn put_break(var e: Emitter) {
  e.out.write_byte(UInt8(10))
  e.column = 0
  e.line += 1
  e.indention = true
}

/// Writes the character of s at i and returns the index after it.
fn write_char(var e: Emitter, s: Bytes, i: Int) -> Int {
  let w = width_of(at(s, i))
  e.out.write(s[i..i + w])
  e.column += 1
  i + w
}

fn write_all(var e: Emitter, s: Bytes) {
  var i = 0
  while i < s.len() {
    i = write_char(e, s, i)
  }
}

fn write_break(var e: Emitter, s: Bytes, i: Int) -> Int {
  if s[i] == 10 {
    put_break(e)
    return i + 1
  }
  let j = write_char(e, s, i)
  e.column = 0
  e.line += 1
  e.indention = true
  j
}

fn increase_indent(var e: Emitter, flow: Bool, indentless: Bool) {
  e.indents.push(e.indent)
  if e.indent < 0 {
    e.indent = if flow { e.best_indent } else { 0 }
  } else if !indentless {
    if e.states[e.states.len() - 1] == ES_BLOCK_SEQUENCE_ITEM {
      e.indent += 2
    } else {
      e.indent = e.best_indent * ((e.indent + e.best_indent) / e.best_indent)
    }
  }
}

fn pop_indent(var e: Emitter) {
  e.indent = e.indents.pop() ?? -1
}

fn pop_estate(var e: Emitter) {
  e.state = e.states.pop() ?? ES_END
}

/// Queues an event and emits what the lookahead allows; false on error (e.err).
fn emit(var e: Emitter, event: Event) -> Bool {
  e.events.push(event)
  while !need_more_events(e) {
    let ev0 = e.events[e.events_head]
    if !analyze_event(e, ev0) {
      return false
    }
    if !state_machine(e, ev0) {
      return false
    }
    e.events_head += 1
  }
  true
}

fn need_more_events(e: Emitter) -> Bool {
  if e.events_head == e.events.len() {
    return true
  }
  var accumulate = 0
  let t = e.events[e.events_head].typ
  if t == E_DOCUMENT_START {
    accumulate = 1
  } else if t == E_SEQUENCE_START {
    accumulate = 2
  } else if t == E_MAPPING_START {
    accumulate = 3
  } else {
    return false
  }
  if e.events.len() - e.events_head > accumulate {
    return false
  }
  var level = 0
  var i = e.events_head
  while i < e.events.len() {
    let k = e.events[i].typ
    if k == E_STREAM_START || k == E_DOCUMENT_START || k == E_SEQUENCE_START || k == E_MAPPING_START {
      level += 1
    } else if k == E_STREAM_END || k == E_DOCUMENT_END || k == E_SEQUENCE_END || k == E_MAPPING_END {
      level -= 1
    }
    if level == 0 {
      return false
    }
    i += 1
  }
  true
}

fn em_append_tag_directive(var e: Emitter, value: TagDirective, allow_duplicates: Bool) -> Bool {
  for d in e.tag_directives {
    if d.handle == value.handle {
      if allow_duplicates {
        return true
      }
      return em_error(e, "duplicate %TAG directive")
    }
  }
  e.tag_directives.push(value)
  true
}

fn state_machine(var e: Emitter, ev0: Event) -> Bool {
  let s = e.state
  if s == ES_STREAM_START {
    return emit_stream_start(e, ev0)
  }
  if s == ES_FIRST_DOCUMENT_START {
    return emit_document_start(e, ev0, true)
  }
  if s == ES_DOCUMENT_START {
    return emit_document_start(e, ev0, false)
  }
  if s == ES_DOCUMENT_CONTENT {
    return emit_document_content(e, ev0)
  }
  if s == ES_DOCUMENT_END {
    return emit_document_end(e, ev0)
  }
  if s == ES_FLOW_SEQUENCE_FIRST_ITEM {
    return emit_flow_sequence_item(e, ev0, true)
  }
  if s == ES_FLOW_SEQUENCE_ITEM {
    return emit_flow_sequence_item(e, ev0, false)
  }
  if s == ES_FLOW_MAPPING_FIRST_KEY {
    return emit_flow_mapping_key(e, ev0, true)
  }
  if s == ES_FLOW_MAPPING_KEY {
    return emit_flow_mapping_key(e, ev0, false)
  }
  if s == ES_FLOW_MAPPING_SIMPLE_VALUE {
    return emit_flow_mapping_value(e, ev0, true)
  }
  if s == ES_FLOW_MAPPING_VALUE {
    return emit_flow_mapping_value(e, ev0, false)
  }
  if s == ES_BLOCK_SEQUENCE_FIRST_ITEM {
    return emit_block_sequence_item(e, ev0, true)
  }
  if s == ES_BLOCK_SEQUENCE_ITEM {
    return emit_block_sequence_item(e, ev0, false)
  }
  if s == ES_BLOCK_MAPPING_FIRST_KEY {
    return emit_block_mapping_key(e, ev0, true)
  }
  if s == ES_BLOCK_MAPPING_KEY {
    return emit_block_mapping_key(e, ev0, false)
  }
  if s == ES_BLOCK_MAPPING_SIMPLE_VALUE {
    return emit_block_mapping_value(e, ev0, true)
  }
  if s == ES_BLOCK_MAPPING_VALUE {
    return emit_block_mapping_value(e, ev0, false)
  }
  em_error(e, "expected nothing after STREAM-END")
}

fn emit_stream_start(var e: Emitter, ev0: Event) -> Bool {
  if ev0.typ != E_STREAM_START {
    return em_error(e, "expected STREAM-START")
  }
  if e.best_indent < 2 || e.best_indent > 9 {
    e.best_indent = 2
  }
  if e.best_width >= 0 && e.best_width <= e.best_indent * 2 {
    e.best_width = 80
  }
  if e.best_width < 0 {
    e.best_width = 2147483647
  }
  e.indent = -1
  e.line = 0
  e.column = 0
  e.whitespace = true
  e.indention = true
  e.state = ES_FIRST_DOCUMENT_START
  true
}

fn emit_document_start(var e: Emitter, ev0: Event, first: Bool) -> Bool {
  if ev0.typ == E_DOCUMENT_START {
    if ev0.has_version && (ev0.major != 1 || ev0.minor != 1) {
      return em_error(e, "incompatible %YAML directive")
    }
    for d in ev0.tag_directives {
      if !analyze_tag_directive(e, d) {
        return false
      }
      if !em_append_tag_directive(e, d, false) {
        return false
      }
    }
    if !em_append_tag_directive(e, TagDirective{handle: b"!", prefix: b"!"}, true) {
      return false
    }
    if !em_append_tag_directive(e, TagDirective{handle: b"!!", prefix: b"tag:yaml.org,2002:"}, true) {
      return false
    }
    var implicit = ev0.implicit
    if !first || e.canonical {
      implicit = false
    }
    if e.open_ended && (ev0.has_version || ev0.tag_directives.len() > 0) {
      write_indicator(e, b"...", true, false, false)
      write_indent(e)
    }
    if ev0.has_version {
      implicit = false
      write_indicator(e, b"%YAML", true, false, false)
      write_indicator(e, b"1.1", true, false, false)
      write_indent(e)
    }
    if ev0.tag_directives.len() > 0 {
      implicit = false
      for d in ev0.tag_directives {
        write_indicator(e, b"%TAG", true, false, false)
        write_tag_handle(e, d.handle)
        write_tag_content(e, d.prefix, true)
        write_indent(e)
      }
    }
    if !implicit {
      write_indent(e)
      write_indicator(e, b"---", true, false, false)
      write_indent(e)
    }
    e.state = ES_DOCUMENT_CONTENT
    return true
  }
  if ev0.typ == E_STREAM_END {
    if e.open_ended {
      write_indicator(e, b"...", true, false, false)
      write_indent(e)
    }
    e.state = ES_END
    return true
  }
  em_error(e, "expected DOCUMENT-START or STREAM-END")
}

fn emit_document_content(var e: Emitter, ev0: Event) -> Bool {
  e.states.push(ES_DOCUMENT_END)
  emit_node(e, ev0, true, false, false, false)
}

fn emit_document_end(var e: Emitter, ev0: Event) -> Bool {
  if ev0.typ != E_DOCUMENT_END {
    return em_error(e, "expected DOCUMENT-END")
  }
  write_indent(e)
  if !ev0.implicit {
    write_indicator(e, b"...", true, false, false)
    write_indent(e)
  }
  e.state = ES_DOCUMENT_START
  e.tag_directives = []
  true
}

fn emit_flow_sequence_item(var e: Emitter, ev0: Event, first: Bool) -> Bool {
  if first {
    write_indicator(e, b"[", true, true, false)
    increase_indent(e, true, false)
    e.flow_level += 1
  }
  if ev0.typ == E_SEQUENCE_END {
    e.flow_level -= 1
    pop_indent(e)
    if e.column == 0 || (e.canonical && !first) {
      write_indent(e)
    }
    write_indicator(e, b"]", false, false, false)
    pop_estate(e)
    return true
  }
  if !first {
    write_indicator(e, b",", false, false, false)
  }
  if e.column == 0 {
    write_indent(e)
  }
  if e.canonical || e.column > e.best_width {
    write_indent(e)
  }
  e.states.push(ES_FLOW_SEQUENCE_ITEM)
  emit_node(e, ev0, false, true, false, false)
}

fn emit_flow_mapping_key(var e: Emitter, ev0: Event, first: Bool) -> Bool {
  if first {
    write_indicator(e, b"{", true, true, false)
    increase_indent(e, true, false)
    e.flow_level += 1
  }
  if ev0.typ == E_MAPPING_END {
    if e.canonical && !first {
      write_indicator(e, b",", false, false, false)
    }
    e.flow_level -= 1
    pop_indent(e)
    if e.canonical && !first {
      write_indent(e)
    }
    write_indicator(e, b"}", false, false, false)
    pop_estate(e)
    return true
  }
  if !first {
    write_indicator(e, b",", false, false, false)
  }
  if e.column == 0 {
    write_indent(e)
  }
  if e.canonical || e.column > e.best_width {
    write_indent(e)
  }
  if !e.canonical && check_simple_key(e) {
    e.states.push(ES_FLOW_MAPPING_SIMPLE_VALUE)
    return emit_node(e, ev0, false, false, true, true)
  }
  write_indicator(e, b"?", true, false, false)
  e.states.push(ES_FLOW_MAPPING_VALUE)
  emit_node(e, ev0, false, false, true, false)
}

fn emit_flow_mapping_value(var e: Emitter, ev0: Event, simple: Bool) -> Bool {
  if simple {
    write_indicator(e, b":", false, false, false)
  } else {
    if e.canonical || e.column > e.best_width {
      write_indent(e)
    }
    write_indicator(e, b":", true, false, false)
  }
  e.states.push(ES_FLOW_MAPPING_KEY)
  emit_node(e, ev0, false, false, true, false)
}

fn emit_block_sequence_item(var e: Emitter, ev0: Event, first: Bool) -> Bool {
  if first {
    increase_indent(e, false, false)
  }
  if ev0.typ == E_SEQUENCE_END {
    pop_indent(e)
    pop_estate(e)
    return true
  }
  write_indent(e)
  write_indicator(e, b"-", true, false, true)
  e.states.push(ES_BLOCK_SEQUENCE_ITEM)
  emit_node(e, ev0, false, true, false, false)
}

fn emit_block_mapping_key(var e: Emitter, ev0: Event, first: Bool) -> Bool {
  if first {
    increase_indent(e, false, false)
  }
  if ev0.typ == E_MAPPING_END {
    pop_indent(e)
    pop_estate(e)
    return true
  }
  write_indent(e)
  if check_simple_key(e) {
    e.states.push(ES_BLOCK_MAPPING_SIMPLE_VALUE)
    return emit_node(e, ev0, false, false, true, true)
  }
  write_indicator(e, b"?", true, false, true)
  e.states.push(ES_BLOCK_MAPPING_VALUE)
  emit_node(e, ev0, false, false, true, false)
}

fn emit_block_mapping_value(var e: Emitter, ev0: Event, simple: Bool) -> Bool {
  if simple {
    write_indicator(e, b":", false, false, false)
  } else {
    write_indent(e)
    write_indicator(e, b":", true, false, true)
  }
  e.states.push(ES_BLOCK_MAPPING_KEY)
  emit_node(e, ev0, false, false, true, false)
}

fn emit_node(var e: Emitter, ev0: Event, root: Bool, sequence: Bool, mapping: Bool, simple_key: Bool) -> Bool {
  e.root_context = root
  e.sequence_context = sequence
  e.mapping_context = mapping
  e.simple_key_context = simple_key
  let t = ev0.typ
  if t == E_ALIAS {
    process_anchor(e)
    pop_estate(e)
    return true
  }
  if t == E_SCALAR {
    return emit_scalar(e, ev0)
  }
  if t == E_SEQUENCE_START {
    process_anchor(e)
    process_tag(e)
    if e.flow_level > 0 || e.canonical || ev0.style == C_FLOW || check_empty(e, E_SEQUENCE_START, E_SEQUENCE_END) {
      e.state = ES_FLOW_SEQUENCE_FIRST_ITEM
    } else {
      e.state = ES_BLOCK_SEQUENCE_FIRST_ITEM
    }
    return true
  }
  if t == E_MAPPING_START {
    process_anchor(e)
    process_tag(e)
    if e.flow_level > 0 || e.canonical || ev0.style == C_FLOW || check_empty(e, E_MAPPING_START, E_MAPPING_END) {
      e.state = ES_FLOW_MAPPING_FIRST_KEY
    } else {
      e.state = ES_BLOCK_MAPPING_FIRST_KEY
    }
    return true
  }
  em_error(e, "expected SCALAR, SEQUENCE-START, MAPPING-START, or ALIAS, but got ${t}")
}

fn emit_scalar(var e: Emitter, ev0: Event) -> Bool {
  if !select_scalar_style(e, ev0) {
    return false
  }
  process_anchor(e)
  process_tag(e)
  increase_indent(e, true, false)
  process_scalar(e)
  pop_indent(e)
  pop_estate(e)
  true
}

fn check_empty(e: Emitter, start: Int, end: Int) -> Bool {
  if e.events.len() - e.events_head < 2 {
    return false
  }
  e.events[e.events_head].typ == start && e.events[e.events_head + 1].typ == end
}

fn check_simple_key(e: Emitter) -> Bool {
  var length = 0
  let t = e.events[e.events_head].typ
  if t == E_ALIAS {
    length += e.anchor.len()
  } else if t == E_SCALAR {
    if e.s_multiline {
      return false
    }
    length += e.anchor.len() + e.tag_handle.len() + e.tag_suffix.len() + e.sv.len()
  } else if t == E_SEQUENCE_START {
    if !check_empty(e, E_SEQUENCE_START, E_SEQUENCE_END) {
      return false
    }
    length += e.anchor.len() + e.tag_handle.len() + e.tag_suffix.len()
  } else if t == E_MAPPING_START {
    if !check_empty(e, E_MAPPING_START, E_MAPPING_END) {
      return false
    }
    length += e.anchor.len() + e.tag_handle.len() + e.tag_suffix.len()
  } else {
    return false
  }
  length <= 128
}

fn select_scalar_style(var e: Emitter, ev0: Event) -> Bool {
  let no_tag = e.tag_handle.len() == 0 && e.tag_suffix.len() == 0
  if no_tag && !ev0.implicit && !ev0.quoted_implicit {
    return em_error(e, "neither tag nor implicit flags are specified")
  }
  var style = ev0.style
  if style == 0 {
    style = S_PLAIN
  }
  if e.canonical {
    style = S_DOUBLE
  }
  if e.simple_key_context && e.s_multiline {
    style = S_DOUBLE
  }
  if style == S_PLAIN {
    if (e.flow_level > 0 && !e.s_flow_plain) || (e.flow_level == 0 && !e.s_block_plain) {
      style = S_SINGLE
    }
    if e.sv.len() == 0 && (e.flow_level > 0 || e.simple_key_context) {
      style = S_SINGLE
    }
    if no_tag && !ev0.implicit {
      style = S_SINGLE
    }
  }
  if style == S_SINGLE {
    if !e.s_single {
      style = S_DOUBLE
    }
  }
  if style == S_LITERAL || style == S_FOLDED {
    if !e.s_block || e.flow_level > 0 || e.simple_key_context {
      style = S_DOUBLE
    }
  }
  if no_tag && !ev0.quoted_implicit && style != S_PLAIN {
    e.tag_handle = b"!"
  }
  e.s_style = style
  true
}

fn process_anchor(var e: Emitter) {
  if e.anchor.len() == 0 {
    return
  }
  write_indicator(e, if e.anchor_alias { b"*" } else { b"&" }, true, false, false)
  write_all(e, e.anchor)
  e.whitespace = false
  e.indention = false
}

fn process_tag(var e: Emitter) {
  if e.tag_handle.len() == 0 && e.tag_suffix.len() == 0 {
    return
  }
  if e.tag_handle.len() > 0 {
    write_tag_handle(e, e.tag_handle)
    if e.tag_suffix.len() > 0 {
      write_tag_content(e, e.tag_suffix, false)
    }
  } else {
    write_indicator(e, b"!<", true, false, false)
    write_tag_content(e, e.tag_suffix, false)
    write_indicator(e, b">", false, false, false)
  }
}

fn process_scalar(var e: Emitter) {
  let st = e.s_style
  let allow = !e.simple_key_context
  if st == S_PLAIN {
    write_plain_scalar(e, e.sv, allow)
  } else if st == S_SINGLE {
    write_single_quoted_scalar(e, e.sv, allow)
  } else if st == S_DOUBLE {
    write_double_quoted_scalar(e, e.sv, allow)
  } else if st == S_LITERAL {
    write_literal_scalar(e, e.sv)
  } else {
    write_folded_scalar(e, e.sv)
  }
}

fn analyze_tag_directive(var e: Emitter, d: TagDirective) -> Bool {
  let handle = d.handle
  if handle.len() == 0 {
    return em_error(e, "tag handle must not be empty")
  }
  if handle[0] != 33 {
    return em_error(e, "tag handle must start with '!'")
  }
  if handle[handle.len() - 1] != 33 {
    return em_error(e, "tag handle must end with '!'")
  }
  var i = 1
  while i < handle.len() - 1 {
    if !em_is_alpha(handle, i) {
      return em_error(e, "tag handle must contain alphanumerical characters only")
    }
    i += width_of(Int(handle[i]))
  }
  if d.prefix.len() == 0 {
    return em_error(e, "tag prefix must not be empty")
  }
  true
}

fn analyze_anchor(var e: Emitter, anchor: Bytes, alias: Bool) -> Bool {
  if anchor.len() == 0 {
    return em_error(e, if alias { "alias value must not be empty" } else { "anchor value must not be empty" })
  }
  var i = 0
  while i < anchor.len() {
    if !em_is_alpha(anchor, i) {
      return em_error(e, if alias { "alias value must contain alphanumerical characters only" } else { "anchor value must contain alphanumerical characters only" })
    }
    i += width_of(Int(anchor[i]))
  }
  e.anchor = anchor
  e.anchor_alias = alias
  true
}

fn analyze_tag(var e: Emitter, tag: Bytes) -> Bool {
  if tag.len() == 0 {
    return em_error(e, "tag value must not be empty")
  }
  for d in e.tag_directives {
    if tag.starts_with(d.prefix) {
      e.tag_handle = d.handle
      e.tag_suffix = tag[d.prefix.len()..]
      return true
    }
  }
  e.tag_suffix = tag
  true
}

fn analyze_scalar(var e: Emitter, value: Bytes) {
  var block_indicators = false
  var flow_indicators = false
  var line_breaks = false
  var special_characters = false
  var tab_characters = false
  var leading_space = false
  var leading_break = false
  var trailing_space = false
  var trailing_break = false
  var break_space = false
  var space_break = false
  var preceded_by_whitespace = false
  var followed_by_whitespace = false
  var previous_space = false
  var previous_break = false
  e.sv = value
  if value.len() == 0 {
    e.s_multiline = false
    e.s_flow_plain = false
    e.s_block_plain = true
    e.s_single = true
    e.s_block = false
    return
  }
  if value.len() >= 3 && ((value[0] == 45 && value[1] == 45 && value[2] == 45) || (value[0] == 46 && value[1] == 46 && value[2] == 46)) {
    block_indicators = true
    flow_indicators = true
  }
  preceded_by_whitespace = true
  var i = 0
  while i < value.len() {
    let w = width_of(Int(value[i]))
    let c = Int(value[i])
    followed_by_whitespace = i + w >= value.len() || is_blank_at(value, i + w)
    if i == 0 {
      if c == 35 || c == 44 || c == 91 || c == 93 || c == 123 || c == 125 || c == 38 || c == 42 || c == 33 || c == 124 || c == 62 || c == 39 || c == 34 || c == 37 || c == 64 || c == 96 {
        flow_indicators = true
        block_indicators = true
      } else if c == 63 || c == 58 {
        flow_indicators = true
        if followed_by_whitespace {
          block_indicators = true
        }
      } else if c == 45 {
        if followed_by_whitespace {
          flow_indicators = true
          block_indicators = true
        }
      }
    } else {
      if c == 44 || c == 63 || c == 91 || c == 93 || c == 123 || c == 125 {
        flow_indicators = true
      } else if c == 58 {
        flow_indicators = true
        if followed_by_whitespace {
          block_indicators = true
        }
      } else if c == 35 {
        if preceded_by_whitespace {
          flow_indicators = true
          block_indicators = true
        }
      }
    }
    if c == 9 {
      tab_characters = true
    } else if !is_printable_at(value, i) || (c > 127 && !e.unicode) {
      special_characters = true
    }
    if is_space_at(value, i) {
      if i == 0 {
        leading_space = true
      }
      if i + w == value.len() {
        trailing_space = true
      }
      if previous_break {
        break_space = true
      }
      previous_space = true
      previous_break = false
    } else if is_break_at(value, i) {
      line_breaks = true
      if i == 0 {
        leading_break = true
      }
      if i + w == value.len() {
        trailing_break = true
      }
      if previous_space {
        space_break = true
      }
      previous_space = false
      previous_break = true
    } else {
      previous_space = false
      previous_break = false
    }
    preceded_by_whitespace = is_blankz_at(value, i)
    i += w
  }
  e.s_multiline = line_breaks
  e.s_flow_plain = true
  e.s_block_plain = true
  e.s_single = true
  e.s_block = true
  if leading_space || leading_break || trailing_space || trailing_break {
    e.s_flow_plain = false
    e.s_block_plain = false
  }
  if trailing_space {
    e.s_block = false
  }
  if break_space {
    e.s_flow_plain = false
    e.s_block_plain = false
    e.s_single = false
  }
  if space_break || tab_characters || special_characters {
    e.s_flow_plain = false
    e.s_block_plain = false
    e.s_single = false
  }
  if space_break || special_characters {
    e.s_block = false
  }
  if line_breaks {
    e.s_flow_plain = false
    e.s_block_plain = false
  }
  if flow_indicators {
    e.s_flow_plain = false
  }
  if block_indicators {
    e.s_block_plain = false
  }
}

fn analyze_event(var e: Emitter, ev0: Event) -> Bool {
  e.anchor = b""
  e.tag_handle = b""
  e.tag_suffix = b""
  e.sv = b""
  let t = ev0.typ
  if t == E_ALIAS {
    return analyze_anchor(e, ev0.anchor, true)
  }
  if t == E_SCALAR {
    if ev0.anchor.len() > 0 && !analyze_anchor(e, ev0.anchor, false) {
      return false
    }
    if ev0.tag.len() > 0 && (e.canonical || (!ev0.implicit && !ev0.quoted_implicit)) && !analyze_tag(e, ev0.tag) {
      return false
    }
    analyze_scalar(e, ev0.value)
    return true
  }
  if t == E_SEQUENCE_START || t == E_MAPPING_START {
    if ev0.anchor.len() > 0 && !analyze_anchor(e, ev0.anchor, false) {
      return false
    }
    if ev0.tag.len() > 0 && (e.canonical || !ev0.implicit) && !analyze_tag(e, ev0.tag) {
      return false
    }
  }
  true
}

fn write_indent(var e: Emitter) {
  var indent = e.indent
  if indent < 0 {
    indent = 0
  }
  if !e.indention || e.column > indent || (e.column == indent && !e.whitespace) {
    put_break(e)
  }
  while e.column < indent {
    put(e, 32)
  }
  e.whitespace = true
}

fn write_indicator(var e: Emitter, indicator: Bytes, need_whitespace: Bool, is_whitespace: Bool, is_indention: Bool) {
  if need_whitespace && !e.whitespace {
    put(e, 32)
  }
  write_all(e, indicator)
  e.whitespace = is_whitespace
  e.indention = e.indention && is_indention
  e.open_ended = false
}

fn write_tag_handle(var e: Emitter, value: Bytes) {
  if !e.whitespace {
    put(e, 32)
  }
  write_all(e, value)
  e.whitespace = false
  e.indention = false
}

fn hex_digit(v: Int) -> Int {
  if v < 10 {
    v + 48
  } else {
    v + 55
  }
}

fn write_tag_content(var e: Emitter, value: Bytes, need_whitespace: Bool) {
  if need_whitespace && !e.whitespace {
    put(e, 32)
  }
  var i = 0
  while i < value.len() {
    let c = Int(value[i])
    var must_write = false
    if c == 59 || c == 47 || c == 63 || c == 58 || c == 64 || c == 38 || c == 61 || c == 43 || c == 36 || c == 44 || c == 95 || c == 46 || c == 126 || c == 42 || c == 39 || c == 40 || c == 41 || c == 91 || c == 93 {
      must_write = true
    } else {
      must_write = em_is_alpha(value, i)
    }
    if must_write {
      i = write_char(e, value, i)
    } else {
      let w = width_of(c)
      for _k in 0..w {
        let octet = Int(value[i])
        i += 1
        put(e, 37)
        put(e, hex_digit(octet >> 4))
        put(e, hex_digit(octet & 15))
      }
    }
  }
  e.whitespace = false
  e.indention = false
}

fn write_plain_scalar(var e: Emitter, value: Bytes, allow_breaks: Bool) {
  if value.len() > 0 && !e.whitespace {
    put(e, 32)
  }
  var spaces = false
  var breaks = false
  var i = 0
  while i < value.len() {
    if is_space_at(value, i) {
      if allow_breaks && !spaces && e.column > e.best_width && !is_space_at(value, i + 1) {
        write_indent(e)
        i += width_of(Int(value[i]))
      } else {
        i = write_char(e, value, i)
      }
      spaces = true
    } else if is_break_at(value, i) {
      if !breaks && value[i] == 10 {
        put_break(e)
      }
      i = write_break(e, value, i)
      breaks = true
    } else {
      if breaks {
        write_indent(e)
      }
      i = write_char(e, value, i)
      e.indention = false
      spaces = false
      breaks = false
    }
  }
  if value.len() > 0 {
    e.whitespace = false
  }
  e.indention = false
  if e.root_context {
    e.open_ended = true
  }
}

fn write_single_quoted_scalar(var e: Emitter, value: Bytes, allow_breaks: Bool) {
  write_indicator(e, b"'", true, false, false)
  var spaces = false
  var breaks = false
  var i = 0
  while i < value.len() {
    if is_space_at(value, i) {
      if allow_breaks && !spaces && e.column > e.best_width && i > 0 && i < value.len() - 1 && !is_space_at(value, i + 1) {
        write_indent(e)
        i += width_of(Int(value[i]))
      } else {
        i = write_char(e, value, i)
      }
      spaces = true
    } else if is_break_at(value, i) {
      if !breaks && value[i] == 10 {
        put_break(e)
      }
      i = write_break(e, value, i)
      breaks = true
    } else {
      if breaks {
        write_indent(e)
      }
      if value[i] == 39 {
        put(e, 39)
      }
      i = write_char(e, value, i)
      e.indention = false
      spaces = false
      breaks = false
    }
  }
  write_indicator(e, b"'", false, false, false)
  e.whitespace = false
  e.indention = false
}

fn write_double_quoted_scalar(var e: Emitter, value: Bytes, allow_breaks: Bool) {
  var spaces = false
  write_indicator(e, b"\"", true, false, false)
  var i = 0
  while i < value.len() {
    let c = Int(value[i])
    if !is_printable_at(value, i) || (!e.unicode && c > 127) || is_bom_at(value, i) || is_break_at(value, i) || c == 34 || c == 92 {
      var w = 1
      var v = 0
      if c & 128 == 0 {
        w = 1
        v = c & 127
      } else if c & 224 == 192 {
        w = 2
        v = c & 31
      } else if c & 240 == 224 {
        w = 3
        v = c & 15
      } else if c & 248 == 240 {
        w = 4
        v = c & 7
      }
      for k in 1..w {
        v = (v << 6) + (at(value, i + k) & 63)
      }
      i += w
      put(e, 92)
      if v == 0 {
        put(e, 48)
      } else if v == 7 {
        put(e, 97)
      } else if v == 8 {
        put(e, 98)
      } else if v == 9 {
        put(e, 116)
      } else if v == 10 {
        put(e, 110)
      } else if v == 11 {
        put(e, 118)
      } else if v == 12 {
        put(e, 102)
      } else if v == 13 {
        put(e, 114)
      } else if v == 27 {
        put(e, 101)
      } else if v == 34 {
        put(e, 34)
      } else if v == 92 {
        put(e, 92)
      } else if v == 133 {
        put(e, 78)
      } else if v == 160 {
        put(e, 95)
      } else if v == 8232 {
        put(e, 76)
      } else if v == 8233 {
        put(e, 80)
      } else {
        var dw = 0
        if v <= 255 {
          put(e, 120)
          dw = 2
        } else if v <= 65535 {
          put(e, 117)
          dw = 4
        } else {
          put(e, 85)
          dw = 8
        }
        var k = (dw - 1) * 4
        while k >= 0 {
          put(e, hex_digit((v >> k) & 15))
          k -= 4
        }
      }
      spaces = false
    } else if is_space_at(value, i) {
      if allow_breaks && !spaces && e.column > e.best_width && i > 0 && i < value.len() - 1 {
        write_indent(e)
        if is_space_at(value, i + 1) {
          put(e, 92)
        }
        i += width_of(c)
      } else {
        i = write_char(e, value, i)
      }
      spaces = true
    } else {
      i = write_char(e, value, i)
      spaces = false
    }
  }
  write_indicator(e, b"\"", false, false, false)
  e.whitespace = false
  e.indention = false
}

fn write_block_scalar_hints(var e: Emitter, value: Bytes) {
  if is_space_at(value, 0) || is_break_at(value, 0) {
    var hint = BytesBuilder.new()
    hint.write_byte(UInt8(48 + e.best_indent))
    write_indicator(e, hint.freeze(), false, false, false)
  }
  e.open_ended = false
  var chomp = 0
  if value.len() == 0 {
    chomp = 45
  } else {
    var i = value.len() - 1
    while Int(value[i]) & 192 == 128 {
      i -= 1
    }
    if !is_break_at(value, i) {
      chomp = 45
    } else if i == 0 {
      chomp = 43
      e.open_ended = true
    } else {
      i -= 1
      while Int(value[i]) & 192 == 128 {
        i -= 1
      }
      if is_break_at(value, i) {
        chomp = 43
        e.open_ended = true
      }
    }
  }
  if chomp != 0 {
    var h = BytesBuilder.new()
    h.write_byte(UInt8(chomp))
    write_indicator(e, h.freeze(), false, false, false)
  }
}

fn write_literal_scalar(var e: Emitter, value: Bytes) {
  write_indicator(e, b"|", true, false, false)
  write_block_scalar_hints(e, value)
  e.whitespace = true
  var breaks = true
  var i = 0
  while i < value.len() {
    if is_break_at(value, i) {
      i = write_break(e, value, i)
      breaks = true
    } else {
      if breaks {
        write_indent(e)
      }
      i = write_char(e, value, i)
      e.indention = false
      breaks = false
    }
  }
}

fn write_folded_scalar(var e: Emitter, value: Bytes) {
  write_indicator(e, b">", true, false, false)
  write_block_scalar_hints(e, value)
  e.whitespace = true
  var breaks = true
  var leading_spaces = true
  var i = 0
  while i < value.len() {
    if is_break_at(value, i) {
      if !breaks && !leading_spaces && value[i] == 10 {
        var k = 0
        while is_break_at(value, k) {
          k += width_of(at(value, k))
        }
        if !is_blankz_at(value, k) {
          put_break(e)
        }
      }
      i = write_break(e, value, i)
      breaks = true
    } else {
      if breaks {
        write_indent(e)
        leading_spaces = is_blank_at(value, i)
      }
      if !breaks && is_space_at(value, i) && !is_space_at(value, i + 1) && e.column > e.best_width {
        write_indent(e)
        i += width_of(Int(value[i]))
      } else {
        i = write_char(e, value, i)
      }
      e.indention = false
      breaks = false
    }
  }
}


// ---- the encoder API of yamlcodec: events collected by generated code, written by the emitter ----

fn enc_new() -> yamlcodec.Enc {
  yamlcodec.Enc{evs: [], flow: false}
}

/// yaml.v3's e.flow: the next mapping or sequence started is written in flow style.
fn set_flow(var w: yamlcodec.Enc, flow: Bool) {
  w.flow = flow
}

fn map_start(var w: yamlcodec.Enc) {
  let flow = w.flow
  w.flow = false
  w.evs.push(yamlcodec.Ev{kind: 1, text: "", style: if flow { 2 } else { 1 }})
}

fn map_end(var w: yamlcodec.Enc) {
  w.evs.push(yamlcodec.Ev{kind: 2, text: "", style: 0})
}

fn seq_start(var w: yamlcodec.Enc) {
  let flow = w.flow
  w.flow = false
  w.evs.push(yamlcodec.Ev{kind: 3, text: "", style: if flow { 2 } else { 1 }})
}

fn seq_end(var w: yamlcodec.Enc) {
  w.evs.push(yamlcodec.Ev{kind: 4, text: "", style: 0})
}

fn put_raw(var w: yamlcodec.Enc, text: Str, style: Int) {
  w.evs.push(yamlcodec.Ev{kind: 5, text: text, style: style})
}

fn put_null(var w: yamlcodec.Enc) {
  put_raw(w, "null", S_PLAIN)
}

fn put_bool(var w: yamlcodec.Enc, b: Bool) {
  put_raw(w, if b { "true" } else { "false" }, S_PLAIN)
}

fn put_int(var w: yamlcodec.Enc, n: Int) {
  put_raw(w, "${n}", S_PLAIN)
}

fn put_float(var w: yamlcodec.Enc, f: Float) {
  var s = f.to_general(-1)
  if f.is_nan() {
    s = ".nan"
  } else if f.is_inf() {
    s = if f > 0.0 { ".inf" } else { "-.inf" }
  }
  put_raw(w, s, S_PLAIN)
}

fn is_old_bool(s: Str) -> Bool {
  s == "y" || s == "Y" || s == "yes" || s == "Yes" || s == "YES" || s == "n" || s == "N" || s == "no" || s == "No" || s == "NO" || s == "on" || s == "On" || s == "ON" || s == "off" || s == "Off" || s == "OFF"
}

/// ^[-+]?[0-9][0-9_]*(?::[0-5]?[0-9])+(?:\.[0-9_]*)?$ (yaml.v3's base 60 float).
fn is_base60_float(s: Str) -> Bool {
  let b = s.bytes()
  var i = 0
  let n = b.len()
  if i < n && (b[i] == 43 || b[i] == 45) {
    i += 1
  }
  if i >= n || b[i] < 48 || b[i] > 57 {
    return false
  }
  while i < n && ((b[i] >= 48 && b[i] <= 57) || b[i] == 95) {
    i += 1
  }
  var groups = 0
  while i < n && b[i] == 58 {
    i += 1
    if i < n && b[i] >= 48 && b[i] <= 53 && i + 1 < n && b[i + 1] >= 48 && b[i + 1] <= 57 {
      i += 2
    } else if i < n && b[i] >= 48 && b[i] <= 57 {
      i += 1
    } else {
      return false
    }
    groups += 1
  }
  if groups == 0 {
    return false
  }
  if i < n && b[i] == 46 {
    i += 1
    while i < n && ((b[i] >= 48 && b[i] <= 57) || b[i] == 95) {
      i += 1
    }
  }
  i == n
}

/// A string as yaml.v3's stringv writes it: plain unless it would read back as
/// another type, double quoted then; a multi-line one a literal block (double
/// quoted in a flow collection).
fn put_str(var w: yamlcodec.Enc, s: Str) {
  let flow = w.flow
  var style = S_PLAIN
  if s.contains("\n") {
    style = if flow { S_DOUBLE } else { S_LITERAL }
  } else if !(resolve_tag("", s) == "!!str" && !(is_base60_float(s) || is_old_bool(s))) {
    style = S_DOUBLE
  }
  put_raw(w, s, style)
}

/// Go's sort of map[string] keys (yaml.v3 sorter.go keyList.Less): letters by
/// code point, digit runs by value.
fn key_less(a: Str, b: Str) -> Bool {
  let ar = a.runes()
  let br = b.runes()
  var digits = false
  var i = 0
  while i < ar.len() && i < br.len() {
    let x = Int(ar[i])
    let y = Int(br[i])
    if x == y {
      digits = x >= 48 && x <= 57
      i += 1
      continue
    }
    let al = is_letter_rune(ar[i])
    let bl = is_letter_rune(br[i])
    if al && bl {
      return x < y
    }
    if al || bl {
      if digits {
        return al
      } else {
        return bl
      }
    }
    var an = 0
    var bn = 0
    if x == 48 || y == 48 {
      var j = i - 1
      while j >= 0 && Int(ar[j]) >= 48 && Int(ar[j]) <= 57 {
        if Int(ar[j]) != 48 {
          an = 1
          bn = 1
          break
        }
        j -= 1
      }
    }
    var ai = i
    while ai < ar.len() && Int(ar[ai]) >= 48 && Int(ar[ai]) <= 57 {
      an = an * 10 + Int(ar[ai]) - 48
      ai += 1
    }
    var bi = i
    while bi < br.len() && Int(br[bi]) >= 48 && Int(br[bi]) <= 57 {
      bn = bn * 10 + Int(br[bi]) - 48
      bi += 1
    }
    if an != bn {
      return an < bn
    }
    if ai != bi {
      return ai < bi
    }
    return x < y
  }
  ar.len() < br.len()
}

fn is_letter_rune(r: Rune) -> Bool {
  let c = Int(r)
  (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c > 127
}

fn sorted_keys(keys: List[Str]) -> List[Str] {
  var out: List[Str] = []
  for k in keys {
    var at = out.len()
    while at > 0 && key_less(k, out[at - 1]) {
      at -= 1
    }
    out.insert(at, k)
  }
  out
}

fn scalar_ev(text: Str, style: Int) -> Event {
  var s = ev(E_SCALAR, mark0(), mark0())
  s.value = text.bytes()
  s.implicit = true
  s.quoted_implicit = true
  s.style = style
  s
}

/// The YAML text of the events w collected (one document, indent 4 as yaml.v3's Marshal).
fn finish(w: yamlcodec.Enc, indent: Int) -> Str ! yaml.YamlErr {
  finish_all([w], indent)
}

/// The documents the event lists make, one after another (a document after the
/// first starts with `---`, as the emitter writes it).
fn finish_all(ws: List[yamlcodec.Enc], indent: Int) -> Str ! yaml.YamlErr {
  var em = new_emitter(indent)
  var ok = emit(em, ev(E_STREAM_START, mark0(), mark0()))
  for w in ws {
    var ds = ev(E_DOCUMENT_START, mark0(), mark0())
    ds.implicit = true
    ok = ok && emit(em, ds)
    for x in w.evs {
      if !ok {
        break
      }
      if x.kind == 1 || x.kind == 3 {
        var s = ev(if x.kind == 1 { E_MAPPING_START } else { E_SEQUENCE_START }, mark0(), mark0())
        s.implicit = true
        s.style = if x.style == 2 { C_FLOW } else { C_BLOCK }
        ok = emit(em, s)
      } else if x.kind == 2 {
        ok = emit(em, ev(E_MAPPING_END, mark0(), mark0()))
      } else if x.kind == 4 {
        ok = emit(em, ev(E_SEQUENCE_END, mark0(), mark0()))
      } else {
        ok = emit(em, scalar_ev(x.text, x.style))
      }
    }
    var de = ev(E_DOCUMENT_END, mark0(), mark0())
    de.implicit = true
    ok = ok && emit(em, de)
  }
  em.open_ended = false
  ok = ok && emit(em, ev(E_STREAM_END, mark0(), mark0()))
  if !ok {
    return Err(yaml.YamlErr{line: 0, msg: em.err})
  }
  Ok(em.out.freeze().to_str() ?? "")
}
