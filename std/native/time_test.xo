const L1: Str = "{weekday:short} {year}-{month}-{day}T{hour}:{minute}:{second}{frac}{offset} {zone}"
const L2: Str = "{weekday:name}, {month:name} {day:1} {month:1} {hour12}:{minute} {ampm} {offset:compact}{frac:3}"

test "format as Go's Format in fixed zones, every field" {
  var bad: List[(Int, Int, Str, Int, Str, Str)] = []
  for (secs, nanos, name, off, want) in GO_FORMAT {
    let z = if name == "UTC" && off == 0 { time.utc() } else { time.fixed(name, Duration.from_secs_int(off)) }
    let t = Time.from_unix(secs) + Duration.from_nanos(nanos)
    let got = "${time.format(t, z, L1)}|${time.format(t, z, L2)}"
    if got != want {
      bad.push((secs, nanos, name, off, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]) == []
}
