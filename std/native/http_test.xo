use std/http
use std/url

// Request.form and query_all (decision 0279), with the cases of Go's
// net/http request_test.go (go1.26.1) that apply: TestParseFormQuery's
// PostForm, TestParseFormQueryMethods, TestParseFormUnknownContentType,
// and TestParseFormSemicolonSeparator's query.

fn form_of(method: Str, ct: Str?, body: Str) -> url.Values ! url.EscapeErr {
  let headers: Map[Str, Str] = match ct {
    Some(c) => {"Content-Type": c}
    None => {}
  }
  request_form(new_request(method, "http://www.google.com/search?q=foo&q=bar&both=x&prio=1&orphan=nope&empty=not", headers: headers, body: body.bytes()))
}

test "go TestParseFormQuery: the body's values, not the query's" {
  let f = form_of("POST", Some("application/x-www-form-urlencoded; param=value"), "z=post&both=y&prio=2&=nokey&orphan&empty=&").or_fault("parses")
  expect(f.get("z")) == Some("post")
  expect(f.has("q")) == false
  expect(f.all("both")) == ["y"]
  expect(f.get("prio")) == Some("2")
  expect(f.all("orphan")) == [""]
  expect(f.all("empty")) == [""]
  expect(f.all("")) == ["nokey"]
}

test "go TestParseFormQuery: query_all keeps every query value" {
  let r = new_request("POST", "http://www.google.com/search?q=foo&q=bar&both=x&prio=1&orphan=nope&empty=not")
  expect(request_query_all(r, "q")) == ["foo", "bar"]
  expect(request_query_all(r, "both")) == ["x"]
  expect(request_query_all(r, "none")) == []
  expect(request_query(r, "q")) == Some("foo")
}

test "go TestParseFormQueryMethods" {
  for m in ["POST", "PATCH", "PUT", "FOO", "GET"] {
    let f = form_of(m, Some("application/x-www-form-urlencoded; param=value"), "foo=bar").or_fault("parses")
    expect(f.get("foo")) == if m is "POST" | "PATCH" | "PUT" { Some("bar") } else { None }
  }
}

test "go TestParseFormUnknownContentType" {
  // text/plain, no Content-Type (application/octet-stream), and an unknown
  // type are not forms; a malformed media type is mime's error
  for ct in [Some("text/plain"), None, Some("application/unknown")] {
    expect(form_of("POST", ct, "body").map(fn(v) { v.keys() })) == Ok([])
  }
  expect(form_of("POST", Some("text/plain; boundary="), "body").map_err(fn(e) { e.msg })) == Err("mime: invalid media parameter")
  expect(form_of("POST", Some("Application/X-WWW-Form-URLEncoded"), "a=1").map(fn(v) { v.keys() })) == Ok(["a"])
  expect(form_of("POST", Some("application/x-www-form-urlencoded; a"), "a=1").map_err(fn(e) { e.msg })) == Err("mime: invalid media parameter")
  expect(form_of("POST", Some("; a=1"), "a=1").map_err(fn(e) { e.msg })) == Err("mime: no media type")
  // a GET's form is empty whatever its Content-Type (Go parses only POST, PUT, PATCH)
  expect(form_of("GET", Some("text/plain; boundary="), "a=1").map(fn(v) { v.keys() })) == Ok([])
}

test "go TestParseFormSemicolonSeparator: query_all skips a pair with a semicolon" {
  let r = new_request("GET", "http://www.google.com/search?q=foo;q=bar&a=1")
  expect(request_query_all(r, "a")) == ["1"]
  expect(request_query_all(r, "q")) == []
}

test "a semicolon or a bad escape in a form body is an error" {
  expect(form_of("POST", Some("application/x-www-form-urlencoded"), "a=1;b=2").is_err()) == true
  expect(form_of("POST", Some("application/x-www-form-urlencoded"), "a=%zz")) == Err(url.EscapeErr{msg: "invalid URL escape \"%zz\""})
}

test "invalid UTF-8 in a form body stays escaped" {
  let r = new_request("POST", "http://x/", headers: {"Content-Type": "application/x-www-form-urlencoded"}, body: b"a=\xff%41")
  expect(request_form(r).map(fn(v) { v.get("a") })) == Ok(Some("%FFA"))
}

test "a plain query is read in place: first value of a repeated key, empty keys and values, no escape work" {
  let r = new_request("GET", "/p?b=2&a=1&&b=3&c&=x&d=&e=h%C3%A9llo&f=a+b")
  expect(r.url.query) == {"a": "1", "b": "2", "c": "", "d": "", "": "x", "e": "h\u{00e9}llo", "f": "a b"}
  let p = new_request("GET", "/p?k=h\u{00e9}llo&z=1&k=2")
  expect(p.url.query) == {"k": "h\u{00e9}llo", "z": "1"}
}

test "a request built as a struct literal reads url.query" {
  let r = http.Request{method: "GET", path: "/", url: http.Url{scheme: "http", host: "x", port: None, path: "/", query: {"k": "v"}}, headers: {}, body: b"", remote_ip: "1.2.3.4"}
  expect(r.query_all("k")) == ["v"]
}

// Cookies (decision 0288): the cases of Go's cookie_test.go
// (go1.26.1) whose invalid bytes Go drops with a log line, which golden
// http_cookies leaves out (the Go backend logs them).

test "go TestCookieSanitizeValue" {
  let cases: List[(Str, Bool, Str)] = [
    ("foo", false, "foo"),
    ("foo;bar", false, "foobar"),
    ("foo\\bar", false, "foobar"),
    ("foo\"bar", false, "foobar"),
    ("\u{0}\u{7e}\u{7f}\u{80}", false, "\u{7e}"),
    ("withquotes", true, "\"withquotes\""),
    ("\"withquotes\"", true, "\"withquotes\""),
    ("a z", false, "\"a z\""),
    (" z", false, "\" z\""),
    ("a ", false, "\"a \""),
    ("a,z", false, "\"a,z\""),
    (",z", false, "\",z\""),
    ("a,", false, "\"a,\""),
    ("", true, "\"\""),
  ]
  for (input, quoted, want) in cases {
    expect(sanitize_cookie_value(input, quoted)) == want
  }
}

test "go TestCookieSanitizePath" {
  expect(sanitize_bytes("/path", false)) == "/path"
  expect(sanitize_bytes("/path with space/", false)) == "/path with space/"
  expect(sanitize_bytes("/just;no;semicolon\u{0}orstuff/", false)) == "/justnosemicolonorstuff/"
}

test "go writeSetCookiesTests: domains and names" {
  expect(cookie_display(http.Cookie{name: "cookie-5", value: "five", domain: "wrong;bad.abc"})) == "cookie-5=five"
  expect(cookie_display(http.Cookie{name: "cookie-6", value: "six", domain: "bad-.abc"})) == "cookie-6=six"
  expect(cookie_display(http.Cookie{name: "cookie-7", value: "seven", domain: "127.0.0.1"})) == "cookie-7=seven; Domain=127.0.0.1"
  expect(cookie_display(http.Cookie{name: "cookie-8", value: "eight", domain: "::1"})) == "cookie-8=eight"
  expect(cookie_display(http.Cookie{name: "cookie-16", value: "partitioned", same_site: http.SameSite.None, secure: true, path: "/", partitioned: true})) == "cookie-16=partitioned; Path=/; Secure; SameSite=None; Partitioned"
  expect(cookie_display(http.Cookie{name: "\t", value: ""})) == ""
  expect(cookie_display(http.Cookie{name: "a\nb", value: "v"})) == ""
  expect(cookie_display(http.Cookie{name: "a\rb", value: "v"})) == ""
}

