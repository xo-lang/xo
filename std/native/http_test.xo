test "parse_url accepts and rejects as Go's url.Parse, with its error texts" {
  var bad: List[(Str, Str, Str)] = []
  for (text, want) in GO_PARSE_URL {
    let got = http.parse_url(text).debug()
    if got != want {
      bad.push((text, got, want))
    }
  }
  expect(bad[0..(if bad.len() < 20 { bad.len() } else { 20 })]) == []
}
