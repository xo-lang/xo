// std/uuid on the native backends (decision 0282): RFC 9562 version 4 and
// 7 UUIDs and parsing, following github.com/google/uuid v1.6.0 (BSD-3;
// THIRD_PARTY_NOTICES): Parse's accepted forms and error texts, NewRandom
// and NewV7's bit layouts (v7 without google/uuid's process wide counter:
// random bits after the millisecond, no package state).
use std/internal
use std/uuid

fn uuiderr_display(e: uuid.UuidErr) -> Str { e.msg }

fn fail(msg: Str) -> uuid.UuidErr { uuid.UuidErr{msg: msg} }

/// The top bit of a word: flipped in a Uuid's stored words so that their
/// signed order is the bytes' order.
const TOP: Int = -9223372036854775807 - 1

/// The Uuid of the words hi and lo (the bytes, the first highest).
fn of_words(hi: Int, lo: Int) -> uuid.Uuid { uuid.Uuid{hi: hi ^ TOP, lo: lo ^ TOP} }

/// The word of b[i..i + 8], the first byte highest (one load natively).
fn word_of(b: Bytes, i: Int) -> Int { internal.uuid_word(b, i) }

/// The version and the RFC 9562 variant (10xx) set in the words.
fn with_bits(hi: Int, lo: Int, version: Int) -> uuid.Uuid {
  let h = (hi & -61441) | (version << 12)
  let l = (lo & 4611686018427387903) | TOP
  of_words(h, l)
}

fn v4(r: Rand) -> uuid.Uuid uses rand {
  let b = r.bytes(16)
  with_bits(word_of(b, 0), word_of(b, 8), 4)
}

fn v7(r: Rand, c: Clock) -> uuid.Uuid uses (rand, clock) {
  let ms = c.now().unix_millis()
  let b = r.bytes(10)
  let hi = ms.wrapping_shl(16) | (Int(b[0]) << 8) | Int(b[1])
  with_bits(hi, word_of(b, 2), 7)
}

/// Whether s[off..off + 9] is "urn:uuid:" in any case.
fn urn_at(s: Bytes, off: Int) -> Bool {
  let want = "urn:uuid:".bytes()
  for k in 0..9 {
    var c = Int(s[off + k])
    if c >= 65 && c <= 90 {
      c += 32
    }
    if c != Int(want[k]) {
      return false
    }
  }
  true
}

/// The Uuid of the text in s from off (internal.uuid_half), or the error.
fn decode(s: Bytes, off: Int, dashed: Bool) -> uuid.Uuid ! uuid.UuidErr {
  let hi = internal.uuid_half(s, off, dashed, 0) ?? return Err(fail("invalid UUID format"))
  let lo = internal.uuid_half(s, off, dashed, 1) ?? return Err(fail("invalid UUID format"))
  Ok(of_words(hi, lo))
}

/// google/uuid's Parse: the text decoded by position.
fn parse(s0: Str) -> uuid.Uuid ! uuid.UuidErr {
  let s = s0.bytes()
  var off = 0
  match s.len() {
    36 => {}
    45 => {
      if !urn_at(s, 0) {
        return Err(fail("invalid urn prefix: ${s0[0..9].quote()}"))
      }
      off = 9
    }
    // google/uuid takes the 36 characters after the first without
    // checking the braces
    38 => off = 1
    32 => return decode(s, 0, false)
    n => return Err(fail("invalid UUID length: ${n}"))
  }
  decode(s, off, true)
}

fn from_bytes(b: Bytes) -> uuid.Uuid ! uuid.UuidErr {
  if b.len() != 16 {
    return Err(fail("invalid UUID (got ${b.len()} bytes)"))
  }
  of_words(word_of(b, 0), word_of(b, 8))
}

fn nil() -> uuid.Uuid { of_words(0, 0) }

fn uuid_bytes(u: uuid.Uuid) -> Bytes { internal.uuid_bytes_words(u.hi ^ TOP, u.lo ^ TOP) }

fn uuid_version(u: uuid.Uuid) -> Int { ((u.hi ^ TOP) >> 12) & 15 }

fn uuid_display(u: uuid.Uuid) -> Str { internal.uuid_text_words(u.hi ^ TOP, u.lo ^ TOP) }

fn uuid_debug(u: uuid.Uuid) -> Str { "Uuid(${uuid_display(u).quote()})" }
