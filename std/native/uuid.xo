// std/uuid on the native backends (decision 0282): RFC 9562 version 4 and
// 7 UUIDs and parsing, following github.com/google/uuid v1.6.0 (BSD-3;
// THIRD_PARTY_NOTICES): Parse's accepted forms and error texts, NewRandom
// and NewV7's bit layouts (v7 without google/uuid's process wide counter:
// random bits after the millisecond, no package state).
use std/internal
use std/uuid

fn uuiderr_display(e: uuid.UuidErr) -> Str { e.msg }

fn fail(msg: Str) -> uuid.UuidErr { uuid.UuidErr{msg: msg} }

/// The canonical text of 16 bytes: std/internal's uuid_text, stores into
/// one buffer natively (2026-10-26: a builder a character at a time ran
/// from_bytes and bytes() at 7.1x google/uuid's time).
fn text_of(b: Bytes) -> uuid.Uuid { uuid.Uuid(internal.uuid_text(b)) }

fn with_bits(b: Bytes, version: Int) -> Bytes {
  var out = BytesBuilder.with_capacity(16)
  for i in 0..16 {
    var x = Int(b[i])
    if i == 6 {
      x = (x & 0x0f) | (version << 4)
    }
    if i == 8 {
      // the RFC 9562 variant: 10xx
      x = (x & 0x3f) | 0x80
    }
    out.write_byte(UInt8(x))
  }
  out.freeze()
}

fn v4(r: Rand) -> uuid.Uuid uses rand { text_of(with_bits(r.bytes(16), 4)) }

fn v7(r: Rand, c: Clock) -> uuid.Uuid uses (rand, clock) {
  let ms = c.now().unix_millis()
  var b = BytesBuilder.with_capacity(16)
  for k in 0..6 {
    b.write_byte(UInt8((ms >> (40 - 8 * k)) & 255))
  }
  b.write(r.bytes(10))
  text_of(with_bits(b.freeze(), 7))
}

fn hex_val(c: UInt8) -> Int {
  if c >= 48 && c <= 57 { return Int(c) - 48 }
  if c >= 97 && c <= 102 { return Int(c) - 87 }
  if c >= 65 && c <= 70 { return Int(c) - 55 }
  -1
}

/// Whether s[off..off + 9] is "urn:uuid:" in any case.
fn urn_at(s: Bytes, off: Int) -> Bool {
  let want = "urn:uuid:".bytes()
  for k in 0..9 {
    var c = Int(s[off + k])
    if c >= 65 && c <= 90 {
      c += 32
    }
    if c != Int(want[k]) {
      return false
    }
  }
  true
}

/// google/uuid's Parse: the text decoded by position (internal.uuid_decode)
/// and written back canonical.
fn parse(s0: Str) -> uuid.Uuid ! uuid.UuidErr {
  let s = s0.bytes()
  var off = 0
  match s.len() {
    36 => {}
    45 => {
      if !urn_at(s, 0) {
        return Err(fail("invalid urn prefix: ${s0[0..9].quote()}"))
      }
      off = 9
    }
    // google/uuid takes the 36 characters after the first without
    // checking the braces
    38 => off = 1
    32 => {
      let b = internal.uuid_decode(s, 0, false) ?? return Err(fail("invalid UUID format"))
      return Ok(text_of(b))
    }
    n => return Err(fail("invalid UUID length: ${n}"))
  }
  let b = internal.uuid_decode(s, off, true) ?? return Err(fail("invalid UUID format"))
  Ok(text_of(b))
}

fn from_bytes(b: Bytes) -> uuid.Uuid ! uuid.UuidErr {
  if b.len() != 16 {
    return Err(fail("invalid UUID (got ${b.len()} bytes)"))
  }
  text_of(b)
}

fn nil() -> uuid.Uuid { uuid.Uuid("00000000-0000-0000-0000-000000000000") }

/// The 16 bytes of the canonical text (internal.uuid_decode).
fn uuid_bytes(u: uuid.Uuid) -> Bytes { internal.uuid_decode(u.0.bytes(), 0, true) ?? b"" }

fn uuid_version(u: uuid.Uuid) -> Int { hex_val(u.0.bytes()[14]) }

fn uuid_display(u: uuid.Uuid) -> Str { u.0 }
