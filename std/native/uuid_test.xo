test "google/uuid parse" {
  for (input, want, e) in PARSE {
    let got = parse(input).map(fn(u) { u.0 })
    if e.is_empty() {
      expect(got) == Ok(want)
    } else {
      expect(got) == Err(uuid.UuidErr{msg: e})
    }
  }
}

test "v4 and v7 bits" {
  for _ in 0..50 {
    let a = v4(os.rand)
    expect(uuid_version(a)) == 4
    expect("89ab".contains(a.0[19..20])) == true
    expect(parse(a.0)) == Ok(a)
    let b = v7(os.rand, os.clock)
    expect(uuid_version(b)) == 7
    // the first 48 bits are the Unix time in milliseconds
    let tb = uuid_bytes(b)
    var ms = 0
    for k in 0..6 {
      ms = ms * 256 + Int(tb[k])
    }
    expect(ms) == os.clock.now().unix_millis()
  }
}

test "v7 keys sort by time" {
  let first = v7(os.rand, os.clock)
  os.clock.advance(5ms)
  let second = v7(os.rand, os.clock)
  expect(first.0 < second.0) == true
}

test "bytes round trip" {
  let u = parse("6ba7b810-9dad-11d1-80b4-00c04fd430c8").or_fault("parses")
  expect(from_bytes(uuid_bytes(u))) == Ok(u)
  expect(from_bytes(b"\x00").is_err()) == true
  expect(nil().0) == "00000000-0000-0000-0000-000000000000"
}
