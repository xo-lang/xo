use std/compress
use std/crypto
use std/html
use std/http
use std/json
use std/sql
use std/url
use std/websocket

// ---- a small app: a shared todo list with a limited resource ----

struct Todo {
  title: Str
  done: Bool
  stars: Int
} derive Eq, Json, Debug

struct Model {
  todos: Map[Str, Todo]
  seats: Int
  holders: List[Str]
} derive Eq, Json, Debug

enum Msg {
  Add(id: Str, title: Str)
  Rename(id: Str, title: Str)
  Toggle(id: Str)
  Star(id: Str)
  Remove(id: Str)
  Reserve(who: Str)
} derive Eq, Json, Debug

fn update(m: Model, msg: Msg) -> Model {
  var n = m
  match msg {
    Add(id, title) => {
      if !n.todos.contains(id) {
        n.todos.put(id, Todo{title: title, done: false, stars: 0})
      }
    }
    Rename(id, title) => {
      if let Some(t) = n.todos.get(id) {
        n.todos.put(id, Todo{title: title, done: t.done, stars: t.stars})
      }
    }
    Toggle(id) => {
      if let Some(t) = n.todos.get(id) {
        n.todos.put(id, Todo{title: t.title, done: !t.done, stars: t.stars})
      }
    }
    Star(id) => {
      if let Some(t) = n.todos.get(id) {
        n.todos.put(id, Todo{title: t.title, done: t.done, stars: t.stars + 1})
      }
    }
    Remove(id) => {
      n.todos.remove(id)
    }
    Reserve(who) => {
      if n.seats > 0 && !n.holders.contains(who) {
        n.seats = n.seats - 1
        n.holders.push(who)
      }
    }
  }
  n
}

fn view(m: Model) -> Html {
  var items: List[Html] = []
  for (id, t) in m.todos {
    items.push(el("li", [], [text(t.title), el("button", [on("click", Msg.Toggle(id: id))], [text(if t.done { "undo" } else { "done" })])]))
  }
  el("main", [attr("class", "todos")], [el("h1", [], [text("Todos")]), el("ul", [], items), el("p", [], [text("seats left: ${m.seats}")])])
}

fn todo_app() -> App[Model, Msg] {
  app(Model{todos: {}, seats: 3, holders: []}, update, view)
}

// ---- rendering ----

test "render escapes text and attribute values" {
  let h = el("p", [attr("title", "a \"q\" <b>")], [text("1 < 2 & <script>x</script>")])
  expect(render(h)) == "<p title=\"a &#34;q&#34; &lt;b&gt;\">1 &lt; 2 &amp; &lt;script&gt;x&lt;/script&gt;</p>"
}

test "void elements have no closing tag" {
  expect(render(el("div", [], [el("br"), el("input", [attr("name", "q")])]))) == "<div><br><input name=\"q\"></div>"
}

test "unsafe URLs are replaced" {
  expect(render(el("a", [attr("href", " JavaScript:alert(1)")]))) == "<a href=\"about:invalid#xo-unsafe\"></a>"
  expect(render(el("a", [attr("href", "https://xolang.org/a?b=1")]))) == "<a href=\"https://xolang.org/a?b=1\"></a>"
  expect(render(el("a", [attr("href", "/x/y:z")]))) == "<a href=\"/x/y:z\"></a>"
  expect(render(el("a", [attr("href", "mailto:a@b.c")]))) == "<a href=\"mailto:a@b.c\"></a>"
  expect(render(el("img", [attr("src", "data:text/html,x")]))) == "<img src=\"about:invalid#xo-unsafe\">"
}

test "on renders the Msg as JSON in a data attribute" {
  let s = render(el("button", [on("click", Msg.Star(id: "a<b"))], [text("star")]))
  expect(s.starts_with("<button data-xo-click=\"")) == true
  expect(s.contains("a<b")) == false
  let v = s.cut_prefix("<button data-xo-click=\"")?.cut("\">")?.0
  expect(json.decode_str[Msg](html.unescape_string(v))?) == Msg.Star(id: "a<b")
}

test "the page carries the rendered view and the state" {
  let app = todo_app()
  let m = update(app.init, Msg.Add(id: "1", title: "</script><b>"))
  let p = page(app, m, 7, title: "T & T")
  expect(p.contains("<title>T &amp; T</title>")) == true
  expect(p.contains("<li>&lt;/script&gt;&lt;b&gt;")) == true
  // The JSON state cannot close its script element early.
  let state = p.cut("id=\"xo-state\">")?.1.cut("</script>")?.0
  expect(state.contains("<")) == false
  let st = json.decode_str[PageState[Model]](state)?
  expect(st.ver) == 7
  expect(st.model) == m
}

// ---- the protocol ----

test "a replica predicts, then confirms" {
  let app = todo_app()
  var s = server(app)
  var r = replica(app, "a", app.init, 0)
  r.send(Msg.Add(id: "x", title: "milk"))
  expect(r.model().todos.len()) == 1
  expect(r.confirmed().todos.len()) == 0
  r.receive(s.receive(r.outbox()))
  expect(r.pending()) == 0
  expect(r.version()) == 1
  expect(r.model()) == s.model()
}

test "a duplicate or out of order Msg is applied once, in order" {
  let app = todo_app()
  var s = server(app)
  let e1 = Envelope{seq: 1, msg: Msg.Add(id: "x", title: "a")}
  let e2 = Envelope{seq: 2, msg: Msg.Star(id: "x")}
  s.receive(Up{client: "a", ver: 0, msgs: [e2]})
  expect(s.version()) == 0
  s.receive(Up{client: "a", ver: 0, msgs: [e1, e2, e1, e2]})
  expect(s.version()) == 2
  expect(s.model().todos.get("x")?.stars) == 1
}

test "the server overturns a prediction it rejects" {
  let app = todo_app()
  var s = server(app)
  var rs: List[Replica[Model, Msg]] = []
  for c in ["a", "b", "c", "d"] {
    rs.push(replica(app, c, app.init, 0))
  }
  // Four clients reserve offline; three seats.
  for i in 0..4 {
    rs[i].send(Msg.Reserve(who: "c${i}"))
    expect(rs[i].model().seats) == 2
  }
  for i in 0..4 {
    let d = s.receive(rs[i].outbox())
    rs[i].receive(d)
  }
  for i in 0..4 {
    rs[i].receive(s.reply("c${i}", rs[i].version()))
  }
  expect(s.model().holders) == ["c0", "c1", "c2"]
  expect(rs[3].model().holders.contains("c3")) == false
}

test "a confirmed Msg waits for the server instead of showing a guess" {
  let app = todo_app().confirming(fn(m) { m is Msg.Reserve(_) })
  var s = server(app)
  var r = replica(app, "a", app.init, 0)
  r.send(Msg.Add(id: "x", title: "milk"))
  r.send(Msg.Reserve(who: "ann"))
  // The add shows at once; the seat does not, and is listed as awaiting.
  expect(r.model().todos.len()) == 1
  expect(r.model().seats) == 3
  expect(r.awaiting()) == [Msg.Reserve(who: "ann")]
  r.receive(s.receive(r.outbox()))
  expect(r.awaiting()) == []
  expect(r.model().holders) == ["ann"]
  expect(r.model()) == s.model()
}

test "a confirmed Msg the server refuses never showed as done" {
  let app = todo_app().confirming(fn(m) { m is Msg.Reserve(_) })
  var s = server(app)
  var rs: List[Replica[Model, Msg]] = []
  for c in ["a", "b", "c", "d"] {
    rs.push(replica(app, c, app.init, 0))
  }
  for i in 0..4 {
    rs[i].send(Msg.Reserve(who: "c${i}"))
    expect(rs[i].model().holders) == []
  }
  for i in 0..4 {
    rs[i].receive(s.receive(rs[i].outbox()))
  }
  expect(rs[3].awaiting()) == []
  expect(rs[3].model().holders) == ["c0", "c1", "c2"]
}

test "a client behind a compacted log restarts from a snapshot" {
  let app = todo_app()
  var s = server(app, max_batch: 2)
  var a = replica(app, "a", app.init, 0)
  var b = replica(app, "b", app.init, 0)
  for i in 0..5 {
    a.send(Msg.Add(id: "a${i}", title: "t"))
  }
  b.send(Msg.Add(id: "b0", title: "t"))
  s.receive(a.outbox())
  s.receive(b.outbox())
  s.compact(1)
  // b never heard back; it is behind the kept log.
  var n = 0
  while (b.pending() > 0 || b.version() < s.version()) && n < 20 {
    b.receive(s.receive(b.outbox()))
    n = n + 1
  }
  expect(b.model()) == s.model()
  expect(b.pending()) == 0
}

// ---- convergence over a bad network (decision 0659's experiment) ----

struct Rng {
  s: Int
}

fn (var r: Rng) int(n: Int) -> Int {
  r.s = r.s * 48271 % 2147483647
  r.s % n
}

enum Packet {
  ToServer(up: Up[Msg])
  ToClient(to: Int, down: Down[Model, Msg])
}

struct Flight {
  at: Int
  p: Packet
}

fn random_msg(var g: Rng, client: Int, n: Int, m: Model) -> Msg {
  let ids = m.todos.keys()
  let k = g.int(100)
  if ids.is_empty() || k < 25 {
    return Msg.Add(id: "c${client}-${n}", title: "t${g.int(1000)}")
  }
  let id = ids[g.int(ids.len())]
  if k < 40 {
    Msg.Rename(id: id, title: "r${g.int(1000)}")
  } else if k < 60 {
    Msg.Toggle(id: id)
  } else if k < 80 {
    Msg.Star(id: id)
  } else if k < 92 {
    Msg.Remove(id: id)
  } else {
    Msg.Reserve(who: "c${client}")
  }
}

/// clients, ticks of activity; drop and offline in permille; the server
/// compacts its log to `keep` entries every 50 ticks.
fn simulate(seed: Int, clients: Int, ticks: Int, drop: Int, offline: Int, keep: Int, refuse: Bool = false) -> Bool {
  // with refuse, clients alternate between principals p0 and p1, and p1
  // may not remove (decision 0664)
  let allow = fn(m: Model, p: Str, e: Msg) -> Bool { !refuse || p == "p0" || !(e is Msg.Remove(_)) }
  let app = todo_app()
  let r0 = seed % 2147483646
  var g = Rng{s: (if r0 < 0 { -r0 } else { r0 }) + 1}
  var s = server(app, max_batch: 8)
  var rs: List[Replica[Model, Msg]] = []
  var online: List[Int] = []
  var sent: List[Int] = []
  for i in 0..clients {
    rs.push(replica(app, "c${i}", app.init, 0))
    online.push(0)
    sent.push(0)
  }
  var net: List[Flight] = []
  var t = 0
  var heal = false
  while t < ticks + 3000 {
    heal = t >= ticks
    if heal && rs.all(fn(r) { r.pending() == 0 && r.version() == s.version() }) {
      break
    }
    for i in 0..clients {
      if !heal && online[i] <= t && g.int(1000) < offline {
        online[i] = t + 1 + g.int(120)
      }
      if !heal && g.int(1000) < 200 {
        sent[i] = sent[i] + 1
        rs[i].send(random_msg(g, i, sent[i], rs[i].model()))
      }
      let up_now = heal || online[i] <= t
      if up_now && (t % 3 == i % 3 || heal) && (heal || g.int(1000) >= drop) {
        net.push(Flight{at: t + (if heal { 1 } else { 1 + g.int(12) }), p: Packet.ToServer(up: rs[i].outbox())})
      }
    }
    if t % 50 == 49 {
      s.compact(keep)
    }
    let due = net.filter(fn(f) { f.at <= t })
    net = net.filter(fn(f) { f.at > t })
    for f in due {
      match f.p {
        ToServer(up) => {
          let who = Int.parse(up.client[1..]) ?? 0
          let d = s.receive_as(up, "p${who % 2}", allow) ?? s.reply(up.client, up.ver)
          if heal || g.int(1000) >= drop {
            net.push(Flight{at: t + (if heal { 1 } else { 1 + g.int(12) }), p: Packet.ToClient(to: who, down: d)})
          }
        }
        ToClient(to, down) => {
          if heal || online[to] <= t {
            rs[to].receive(down)
          }
        }
      }
    }
    t = t + 1
  }
  let total = sent.fold(0, fn(a, n) { a + n })
  let sm = s.model()
  // every Msg sent is in the log, applied or refused
  total == s.version() && rs.all(fn(r) { r.pending() == 0 && r.model() == sm && r.confirmed() == sm })
}

test "replicas converge over a lossy, reordering network" {
  for seed in 1..=20 {
    expect(simulate(seed * 7919, 5, 300, 300, 30, 1000000)) == true
  }
}

test "replicas converge when the server refuses some Msgs (decision 0664)" {
  for seed in 1..=20 {
    expect(simulate(seed * 15485863, 5, 300, 300, 30, 1000000, refuse: true)) == true
    expect(simulate(seed * 32452843, 5, 300, 300, 30, 10, refuse: true)) == true
  }
}

test "replicas converge while the server compacts its log" {
  for seed in 1..=20 {
    expect(simulate(seed * 104729, 5, 300, 300, 30, 10)) == true
  }
}

/// simulate with `nodes` Scopes on one memory store (decision 0686): each
/// sync goes to a random one, as behind a load balancer. Every Msg is
/// logged once, every replica and every Scope converge.
fn simulate_nodes(seed: Int, nodes: Int, clients: Int, ticks: Int, drop: Int, offline: Int, keep: Int, refuse: Bool = false) -> Bool ! Str {
  let allow = fn(m: Model, p: Str, e: Msg) -> Bool { !refuse || p == "p0" || !(e is Msg.Remove(_)) }
  let app = todo_app()
  let r0 = seed % 2147483646
  var g = Rng{s: (if r0 < 0 { -r0 } else { r0 }) + 1}
  let st = memory_store()
  var ns = [scope(app, st, max_batch: 8)]
  for _ in 1..nodes {
    ns.push(scope(app, st, max_batch: 8))
  }
  var rs: List[Replica[Model, Msg]] = []
  var online: List[Int] = []
  var sent: List[Int] = []
  for i in 0..clients {
    rs.push(replica(app, "c${i}", app.init, 0))
    online.push(0)
    sent.push(0)
  }
  var net: List[Flight] = []
  var t = 0
  var heal = false
  while t < ticks + 3000 {
    heal = t >= ticks
    if heal {
      ns[0].catch_up()?
      let top = ns[0].version()
      if rs.all(fn(r) { r.pending() == 0 && r.version() == top }) {
        break
      }
    }
    for i in 0..clients {
      if !heal && online[i] <= t && g.int(1000) < offline {
        online[i] = t + 1 + g.int(120)
      }
      if !heal && g.int(1000) < 200 {
        sent[i] = sent[i] + 1
        rs[i].send(random_msg(g, i, sent[i], rs[i].model()))
      }
      let up_now = heal || online[i] <= t
      if up_now && (t % 3 == i % 3 || heal) && (heal || g.int(1000) >= drop) {
        net.push(Flight{at: t + (if heal { 1 } else { 1 + g.int(12) }), p: Packet.ToServer(up: rs[i].outbox())})
      }
    }
    if t % 50 == 49 {
      for k in 0..nodes {
        ns[k].compact(keep)?
      }
    }
    let due = net.filter(fn(f) { f.at <= t })
    net = net.filter(fn(f) { f.at > t })
    for f in due {
      match f.p {
        ToServer(up) => {
          let who = Int.parse(up.client[1..]) ?? 0
          let k = g.int(nodes)
          let d = match ns[k].receive_as(up, "p${who % 2}", allow)? {
            Some(x) => x
            None => ns[k].reply(up.client, up.ver)?
          }
          if heal || g.int(1000) >= drop {
            net.push(Flight{at: t + (if heal { 1 } else { 1 + g.int(12) }), p: Packet.ToClient(to: who, down: d)})
          }
        }
        ToClient(to, down) => {
          if heal || online[to] <= t {
            rs[to].receive(down)
          }
        }
      }
    }
    t = t + 1
  }
  let total = sent.fold(0, fn(a, n) { a + n })
  for k in 0..nodes {
    ns[k].catch_up()?
  }
  let sm = ns[0].model()
  Ok(total == ns[0].version() && ns.all(fn(n) { n.model() == sm && n.version() == total }) && rs.all(fn(r) { r.pending() == 0 && r.model() == sm && r.confirmed() == sm }))
}

test "Scopes on one store converge with syncs routed to any of them (decision 0686)" {
  for seed in 1..=10 {
    expect(simulate_nodes(seed * 7919, 3, 5, 300, 300, 30, 1000000)?) == true
    expect(simulate_nodes(seed * 15485863, 2, 5, 300, 300, 30, 10, refuse: true)?) == true
    expect(simulate_nodes(seed * 104729, 4, 6, 300, 300, 30, 10)?) == true
  }
}

test "two Scopes racing for one version: the loser applies again after the winner" {
  let st = memory_store()
  var a = scope(todo_app(), st)
  var b = scope(todo_app(), st)
  a.receive(Up{client: "x", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "1", title: "milk")}]})?
  // b has not read a's batch: its append after version 0 loses, it reads
  // the batch and appends after version 1
  let d = b.receive(Up{client: "y", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "2", title: "eggs")}]})?
  expect(d.acked) == 1
  expect(b.version()) == 2
  a.catch_up()?
  expect(a.model()) == b.model()
  expect(a.model().todos.len()) == 2
  // a retry of x's Msg through b is not applied again
  b.receive(Up{client: "x", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "1", title: "milk")}]})?
  expect(b.version()) == 2
  // a client belongs to the principal of its first logged Msg on every Scope
  let all = fn(m: Model, p: Str, e: Msg) -> Bool { true }
  a.receive_as(Up{client: "z", ver: 2, msgs: [Envelope{seq: 1, msg: Msg.Star(id: "1")}]}, "ann", all)?
  expect(b.receive_as(Up{client: "z", ver: 3, msgs: [Envelope{seq: 2, msg: Msg.Star(id: "1")}]}, "bob", all)?) == None
}

test "two Hosts on one store and bus act as one, behind a load balancer (decision 0686)" {
  let st = memory_store()
  let bus = local_bus()
  let a = host_with(todo_app(), st, bus, auth: Some(auth_hdr))
  let b = host_with(todo_app(), st, bus, auth: Some(auth_hdr))
  let ra = routes_for(a)
  let rb = routes_for(b)
  let (idb, chb) = b.subscribe("bob")
  // ann's Msg through a reaches b's live connection and b's pages
  let s1 = sync_as(ra, "ann", Up{client: "c1", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "ann milk")}]})?
  expect(s1.ver) == 1
  expect(chb.try_recv()) == Some(1)
  expect(rb.call(http.new_request("GET", "/", headers: {"X-User": "bob"})).text()?.contains("ann milk")) == true
  // the retry routed to b is not applied again, and acknowledged
  let s2 = sync_as(rb, "ann", Up{client: "c1", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "ann milk")}]})?
  expect(s2.down.acked) == 1
  expect(s2.ver) == 1
  // the client belongs to ann on b too
  let up = json.encode_str(Up{client: "c1", ver: 1, msgs: [Envelope{seq: 2, msg: Msg.Remove(id: "x")}]})
  expect(rb.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json", "X-User": "bob"}, body: up.bytes())).status) == 403
  // a server Msg on b reaches a, and versions name one history
  b.apply(Msg.Add(id: "y", title: "loaded"))
  expect(a.model().todos.len()) == 2
  let s3 = sync_as(ra, "ann", Up{client: "c1", ver: 1, msgs: []})?
  expect(s3.ver) == 2
  expect(s3.html.contains("loaded")) == true
  b.unsubscribe(idb)
}

test "a Host on a store it shares catches up before it appends" {
  // no bus between them: a never hears of b, and still appends after b
  let st = memory_store()
  let a = host_with(todo_app(), st, local_bus())
  let b = host_with(todo_app(), st, local_bus())
  b.apply(Msg.Add(id: "1", title: "first"))
  a.apply(Msg.Add(id: "2", title: "second"))
  expect(a.model().todos.len()) == 2
  let s = json.decode_str[Sync[Model, Msg]](routes_for(b).call(sync_req(json.encode_str(Up{client: "c", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Star(id: "1")}]}))).text() ?? "")?
  expect(s.ver) == 3
}

test "compaction snapshots the scope, the store drops what it covers, and a new Host starts from it" {
  let st = memory_store()
  let bus = local_bus()
  let h = host_with(todo_app(), st, bus, keep: 5)
  for i in 0..100 {
    h.apply(Msg.Add(id: "t${i}", title: "t"))
  }
  // the store keeps about keep entries' batches, not 100
  expect((st.read)("", 0)?.len() < 12) == true
  let snap = (st.snapshot)("")? ?? return Err("no snapshot")
  expect(snap.after > 80) == true
  // an instance started now loads the snapshot and the batches after it
  let late = host_with(todo_app(), st, bus, keep: 5)
  expect(late.model().todos.len()) == 100
  let s = json.decode_str[Sync[Model, Msg]](routes_for(late).call(sync_req(json.encode_str(Up{client: "c", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Star(id: "t1")}]}))).text() ?? "")?
  expect(s.ver) == 101
  h.apply(Msg.Star(id: "t2"))
  expect(late.model()) == h.model()
}

// a memory Host performs sync only: a store's effects reach only the code
// that uses that store (decision 0686)
fn memory_host_count() -> Int uses sync {
  let h = host(todo_app())
  h.apply(Msg.Add(id: "a", title: "a"))
  let st = memory_store()
  let h2 = host_with(todo_app(), st, local_bus(), scope: "k")
  h2.apply(Msg.Add(id: "b", title: "b"))
  h.model().todos.len() + h2.model().todos.len()
}

test "a memory Host declares only sync" {
  expect(memory_host_count()) == 2
}

test "two Hosts on one directory store act as one, and a third starts from its snapshot" {
  let dir = "/uistore"
  let bus = local_bus()
  let a = host_with(todo_app(), dir_store(os.fs, dir), bus, scope: "room/1", keep: 5)
  let b = host_with(todo_app(), dir_store(os.fs, dir), bus, scope: "room/1", keep: 5)
  for i in 0..30 {
    if i % 2 == 0 { a.apply(Msg.Add(id: "t${i}", title: "t")) } else { b.apply(Msg.Add(id: "t${i}", title: "t")) }
  }
  expect(a.model().todos.len()) == 30
  expect(a.model()) == b.model()
  // compaction left a snapshot and fewer batch files than appends
  let st = dir_store(os.fs, dir)
  expect((st.snapshot)("room/1")?.is_some()) == true
  expect((st.read)("room/1", 0)?.len() < 15) == true
  // a new process: same directory, no bus, reads the store on first use
  let c = host_with(todo_app(), dir_store(os.fs, dir), local_bus(), scope: "room/1", keep: 5)
  expect(c.model()) == a.model()
  // a stale append loses
  expect((st.append)("room/1", Batch{after: 1, count: 1, data: b"[]"})?) == false
}

test "dir store batches round trip and a straddled snapshot keeps its batch" {
  let dir = "/uistore"
  let st = dir_store(os.fs, dir)
  expect((st.read)("", 0)?.len()) == 0
  expect((st.append)("", Batch{after: 0, count: 3, data: b"abc"})?) == true
  expect((st.append)("", Batch{after: 0, count: 1, data: b"x"})?) == false
  expect((st.append)("", Batch{after: 3, count: 2, data: b"de"})?) == true
  (st.put_snapshot)("", Batch{after: 4, count: 0, data: b"snap"})?
  let bs = (st.read)("", 4)?
  expect(bs.len()) == 1
  expect(bs[0].after) == 3
  expect(bs[0].data) == b"de"
  expect((st.read)("", 0)?.len()) == 1
  expect((st.append)("", Batch{after: 5, count: 1, data: b"f"})?) == true
}

// A bucket in memory, counting the calls a store makes.
struct Bucket {
  objs: Mutex[Map[Str, Bytes]]
  calls: Atomic[Int]
}

fn bucket() -> Bucket {
  Bucket{objs: Mutex[Map[Str, Bytes]].new({}), calls: Atomic[Int].new(0)}
}

fn (k: Bucket) objects() -> Objects[sync] {
  let objs = k.objs
  let calls = k.calls
  Objects{
    create: fn(key: Str, v: Bytes) -> Bool ! Str uses sync {
      let _n = calls.add(1)
      Ok(objs.with(fn(var m) {
        if m.contains(key) {
          return false
        }
        m.put(key, v)
        true
      }))
    },
    put: fn(key: Str, v: Bytes) -> () ! Str uses sync {
      let _n = calls.add(1)
      objs.with(fn(var m) { m.put(key, v) })
      Ok(())
    },
    get: fn(key: Str) -> Bytes? ! Str uses sync {
      let _n = calls.add(1)
      Ok(objs.with_read(fn(m) { m.get(key) }))
    },
    list: fn(prefix: Str, start: Str) -> List[Str] ! Str uses sync {
      let _n = calls.add(1)
      let ks = objs.with_read(fn(m) { m.keys() }).filter(fn(k) { k.starts_with(prefix) && k > start })
      Ok(ks.sort())
    },
  }
}

test "two Hosts on one bucket act as one, a third starts from its snapshot, and a stale append loses" {
  let k = bucket()
  let bus = local_bus()
  let a = host_with(todo_app(), object_store(k.objects()), bus, scope: "room/1", keep: 5)
  let b = host_with(todo_app(), object_store(k.objects()), bus, scope: "room/1", keep: 5)
  for i in 0..30 {
    if i % 2 == 0 { a.apply(Msg.Add(id: "t${i}", title: "t")) } else { b.apply(Msg.Add(id: "t${i}", title: "t")) }
  }
  expect(a.model().todos.len()) == 30
  expect(a.model()) == b.model()
  let st = object_store(k.objects())
  expect((st.snapshot)("room/1")?.is_some()) == true
  // a new copy reads from the snapshot's batch, not the 30 before it
  expect((st.read)("room/1", 0)?.len() < 15) == true
  let c = host_with(todo_app(), object_store(k.objects()), local_bus(), scope: "room/1", keep: 5)
  expect(c.model()) == a.model()
  // batches stay, so a writer that has not seen the snapshot loses too
  expect((st.append)("room/1", Batch{after: 1, count: 1, data: b"[]"})?) == false
  expect((st.append)("room/1", Batch{after: 30, count: 1, data: b"[]"})?) == true
}

test "bucket store: a snapshot inside a batch keeps that batch, and a catch-up costs one list and a get per batch" {
  let k = bucket()
  let st = object_store(k.objects(), prefix: "p/")
  expect((st.read)("", 0)?.len()) == 0
  expect((st.append)("", Batch{after: 0, count: 3, data: b"abc"})?) == true
  expect((st.append)("", Batch{after: 0, count: 1, data: b"x"})?) == false
  expect((st.append)("", Batch{after: 3, count: 2, data: b"de"})?) == true
  (st.put_snapshot)("", Batch{after: 4, count: 0, data: b"snap"})?
  // an older snapshot does not replace it
  (st.put_snapshot)("", Batch{after: 2, count: 0, data: b"old"})?
  // another instance (a new process) reads the snapshot, then from inside the batch
  let other = object_store(k.objects(), prefix: "p/")
  expect((other.snapshot)("")?.map(fn(b) { b.data })) == Some(b"snap")
  let bs = (other.read)("", 4)?
  expect(bs.len()) == 1
  expect(bs[0].after) == 3
  // even without loading the snapshot first
  let third = object_store(k.objects(), prefix: "p/")
  expect((third.read)("", 4)?.map(fn(b) { b.after })) == [3]
  expect((third.read)("", 0)?.map(fn(b) { b.after })) == [3]
  // at the log's end: nothing
  expect((st.read)("", 5)?.len()) == 0
  expect((st.append)("", Batch{after: 5, count: 1, data: b"f"})?) == true
  let before = k.calls.get()
  expect((st.read)("", 5)?.map(fn(b) { b.data })) == [b"f"]
  expect(k.calls.get() - before) == 2
  // every object is under the prefix
  expect(k.objs.with_read(fn(m) { m.keys() }).all(fn(key) { key.starts_with("p/s/") })) == true
}

test "a writer alone on a scope appends at once: one request per change, a list only after a lost race" {
  let k = bucket()
  let h = host_with(todo_app(), object_store(k.objects()), local_bus())
  h.apply(Msg.Add(id: "first", title: "t"))
  let before = k.calls.get()
  for i in 0..10 {
    h.apply(Msg.Add(id: "t${i}", title: "t"))
  }
  expect(k.calls.get() - before) == 10
  // another writer's append makes this copy stale: it loses once, reads,
  // and appends after it
  let other = host_with(todo_app(), object_store(k.objects()), local_bus())
  other.apply(Msg.Add(id: "theirs", title: "t"))
  h.apply(Msg.Add(id: "mine", title: "t"))
  expect(h.model().todos.len()) == 13
  expect(other.model().todos.len()) == 12
}

test "two Hosts on one SQL store act as one, and a third starts from its snapshot" {
  let db = sql.memory()?
  let st = sql_store(db)?
  let bus = local_bus()
  let a = host_with(todo_app(), st, bus, scope: "room", keep: 5)
  let b = host_with(todo_app(), sql_store(db)?, bus, scope: "room", keep: 5)
  for i in 0..30 {
    if i % 2 == 0 { a.apply(Msg.Add(id: "t${i}", title: "t")) } else { b.apply(Msg.Add(id: "t${i}", title: "t")) }
  }
  expect(a.model().todos.len()) == 30
  expect(a.model()) == b.model()
  expect((st.snapshot)("room")?.is_some()) == true
  expect((st.read)("room", 0)?.len() < 15) == true
  let c = host_with(todo_app(), sql_store(db)?, local_bus(), scope: "room", keep: 5)
  expect(c.model()) == a.model()
  expect((st.append)("room", Batch{after: 1, count: 1, data: b"[]"})?) == false
  // another scope in the same tables is its own log
  expect((st.append)("other", Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.read)("other", 0)?.len()) == 1
}

// A database whose CREATE TABLE fails as Postgres's does when another
// instance created the table at the same moment: the table is there and
// the statement reports a duplicate key in the catalog.
struct RacyDriver {
  inner: sql.Db[()]
}

fn (d: RacyDriver) connect(net: Net, dsn: Str) -> sql.DriverConn[()] ! sql.SqlErr uses net.dial {
  Ok(RacyConn{inner: d.inner})
}

struct RacyConn {
  inner: sql.Db[()]
}

fn (c: RacyConn) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows[()] ! sql.SqlErr uses net.dial {
  let rows = c.inner.query(q, args)?
  Ok(sql.DriverRows{columns: if rows.is_empty() { [] } else { rows[0].columns() }, rows: rows.map(fn(r) { r.values() })})
}

fn (c: RacyConn) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  let r = c.inner.exec(q, args)?
  if q.starts_with("CREATE TABLE") {
    return Err(sql.SqlErr.Constraint(msg: "duplicate key value violates unique constraint \"pg_type_typname_nsp_index\"", code: "23505", name: "pg_type_typname_nsp_index"))
  }
  Ok(r)
}

fn (c: RacyConn) begin() -> () ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no transactions")) }
fn (c: RacyConn) commit() -> () ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no transactions")) }
fn (c: RacyConn) rollback() -> () ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no transactions")) }
fn (c: RacyConn) ping() -> () ! sql.SqlErr uses net.dial { Ok(()) }
fn (c: RacyConn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no copy")) }
fn (c: RacyConn) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no copy")) }
fn (c: RacyConn) prepare(q: Str) -> sql.DriverStmt[()]? ! sql.SqlErr uses net.dial { Ok(None) }
fn (c: RacyConn) close() uses net.dial {}
fn (c: RacyConn) is_broken() -> Bool { false }
fn (c: RacyConn) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "none")) }
fn (c: RacyConn) notices() -> List[sql.Notice] { [] }
fn (c: RacyConn) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "none")) }

test "sql_store opens when another instance created its tables at the same moment" {
  let db = sql.open_driver(os.net, RacyDriver{inner: sql.memory()?}, "racy")?
  let st = sql_store(db)?
  expect((st.append)("k", Batch{after: 0, count: 1, data: b"[]"})?) == true
  expect((st.read)("k", 0)?.len()) == 1
}

test "a change outlasts a run of lost races (four writers on one Postgres scope lost 16 in a row)" {
  let inner = memory_store()
  let losses = Atomic[Int].new(0)
  let st = Store{
    append: fn(scope: Str, b: Batch) -> Bool ! Str uses sync {
      if losses.add(1) <= 40 {
        return Ok(false)
      }
      (inner.append)(scope, b)
    },
    read: inner.read,
    snapshot: inner.snapshot,
    put_snapshot: inner.put_snapshot,
  }
  var c = scope(todo_app(), st)
  c.apply(Msg.Add(id: "a", title: "a"))?
  expect(c.version()) == 1
}

test "a resync notice makes a Host read the store it shares (a bus reconnect)" {
  let st = memory_store()
  let a = host_with(todo_app(), st, local_bus())
  let bb = local_bus()
  let b = host_with(todo_app(), st, bb)
  expect(b.model().todos.len()) == 0
  a.apply(Msg.Add(id: "x", title: "x"))
  // b heard nothing: its copy is a version behind, as with a lost notice
  expect(b.model().todos.len()) == 0
  (bb.publish)("", -1)
  expect(b.model().todos.len()) == 1
}

test "after a resync a live page is sent the version it must sync to, never -1" {
  let st = memory_store()
  let a = host_with(todo_app(), st, local_bus())
  let bb = local_bus()
  let b = host_with(todo_app(), st, bb)
  expect(b.model().todos.len()) == 0
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let srv = http.server(l, routes_for(b))
  let addr = srv.addr()
  scope s {
    s.spawn_background(fn() { srv.serve().or_fault("serve") })
    let c = websocket.dial(os.net, "ws://${addr}/_xo/live").or_fault("dial")
    // the version on open
    expect(c.read().or_fault("read").data.to_str_lossy()) == "0"
    while b.live() == 0 {
      os.clock.sleep(1ms)
    }
    // a's append never reached b (as a NOTIFY lost while b reconnected)
    a.apply(Msg.Add(id: "x", title: "x"))
    (bb.publish)("", -1)
    // the runtime syncs only for a number above its version
    expect(c.read().or_fault("read").data.to_str_lossy()) == "1"
    c.close().or_fault("close")
  }
}

// LISTEN/NOTIFY in memory: each connection that listened gets every
// notice sent through any connection.
struct Hub {
  ls: Mutex[List[Chan[sql.Notification]]]
}

struct HubDriver {
  hub: Hub
}

fn (d: HubDriver) connect(net: Net, dsn: Str) -> sql.DriverConn[()] ! sql.SqlErr uses net.dial {
  Ok(HubConn{hub: d.hub, mine: Chan[sql.Notification].new(cap: 64)})
}

struct HubConn {
  hub: Hub
  mine: Chan[sql.Notification]
}

fn (c: HubConn) query(q: Str, args: List[sql.SqlValue]) -> sql.DriverRows[()] ! sql.SqlErr uses net.dial {
  if q.starts_with("SELECT pg_notify") {
    let (ch, pl) = match (args[0], args[1]) {
      (sql.SqlValue.Text(a), sql.SqlValue.Text(b)) => (a, b)
      _ => return Err(sql.SqlErr.Param(msg: "text"))
    }
    for l in c.hub.ls.with_read(fn(m) { m }) {
      let _full = l.try_send(sql.Notification{pid: 1, channel: ch, payload: pl})
    }
  }
  Ok(sql.DriverRows{columns: [], rows: []})
}

fn (c: HubConn) exec(q: Str, args: List[sql.SqlValue]) -> sql.ExecResult ! sql.SqlErr uses net.dial {
  if q.starts_with("LISTEN") {
    c.hub.ls.with(fn(var m) { m.push(c.mine) })
  }
  Ok(sql.ExecResult{rows_affected: 0, last_insert_id: 0})
}

fn (c: HubConn) wait_notification() -> sql.Notification ! sql.SqlErr uses net.dial {
  c.mine.recv().or_err(sql.SqlErr.Closed)
}

fn (c: HubConn) begin() -> () ! sql.SqlErr uses net.dial { Ok(()) }
fn (c: HubConn) commit() -> () ! sql.SqlErr uses net.dial { Ok(()) }
fn (c: HubConn) rollback() -> () ! sql.SqlErr uses net.dial { Ok(()) }
fn (c: HubConn) ping() -> () ! sql.SqlErr uses net.dial { Ok(()) }
fn (c: HubConn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[sql.SqlValue]? ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no copy")) }
fn (c: HubConn) copy_to(q: Str, out: fn(Bytes) -> () ! sql.SqlErr uses sync) -> Int ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "no copy")) }
fn (c: HubConn) prepare(q: Str) -> sql.DriverStmt[()]? ! sql.SqlErr uses net.dial { Ok(None) }
fn (c: HubConn) close() uses net.dial {}
fn (c: HubConn) is_broken() -> Bool { false }
fn (c: HubConn) notices() -> List[sql.Notice] { [] }
fn (c: HubConn) pipeline(batches: List[List[sql.BatchQuery]], in_tx: Bool) -> List[Result[List[sql.DriverResult], sql.SqlErr]] ! sql.SqlErr uses net.dial { Err(sql.SqlErr.Driver(msg: "none")) }

test "Hosts on pg_bus hear each other's appends through NOTIFY" {
  let db = sql.open_driver(os.net, HubDriver{hub: Hub{ls: Mutex[List[Chan[sql.Notification]]].new([])}}, "pg")?
  let st = memory_store()
  let ba = pg_bus(db, os.tasks, os.clock)
  let a = host_with(todo_app(), st, ba, scope: "room")
  let bb = pg_bus(db, os.tasks, os.clock)
  let b = host_with(todo_app(), st, bb, scope: "room")
  expect(b.model().todos.len()) == 0
  let heard = Chan[Int].new(cap: 16)
  (bb.subscribe)(fn(s: Str, v: Int) uses sync {
    if s == "room" || v < 0 {
      let _full = heard.try_send(v)
    }
  })
  let (_id, live) = b.subscribe()
  // b's listener has LISTENed once its -1 arrives (a NOTIFY before that
  // is lost, which the -1 makes b read the store for)
  expect(heard.recv()) == Some(-1)
  a.apply(Msg.Add(id: "x", title: "from a"))
  expect(heard.recv()) == Some(1)
  // b's live connections were woken (the channel holds one value and
  // folds the rest: here the -1 of b's LISTEN, then they check what
  // changed and send the version they read)
  expect(live.recv().is_some()) == true
  expect(b.model().todos.len()) == 1
}

// /room/NAME is room NAME's scope; any other path is not a page.
fn room_of(page: Str, p: Str) -> Str? {
  if page.starts_with("/room/") && page.len() > 6 {
    return Some("room:" + page[6..])
  }
  None
}

test "scope_of puts each page in its own scope: own log, own versions, own live pages" {
  let h = host(todo_app(), auth: Some(auth_hdr), scope_of: Some(room_of))
  let r = routes_for(h)
  let get = fn(path: Str) -> http.Response uses sync { r.call(http.new_request("GET", path, headers: {"X-User": "ann"})) }
  let p1 = get("/room/1")
  expect(p1.status) == 200
  // the page names itself to its sync and live requests
  expect((p1.text() ?? "").contains("data-xo-sync=\"/_xo/sync?page=%2Froom%2F1\"")) == true
  expect(get("/elsewhere").status) == 404
  let up = fn(page: Str, seq: Int, id: Str) -> http.Request {
    let body = json.encode_str(Up{client: "c-${page}", ver: 0, msgs: [Envelope{seq: seq, msg: Msg.Add(id: id, title: id)}]})
    http.new_request("POST", "/_xo/sync?page=" + url.query_escape(page), headers: {"Content-Type": "application/json", "X-User": "ann"}, body: body.bytes())
  }
  let (_i1, live1) = h.subscribe("ann", scope: Some("room:1"))
  let (_i2, live2) = h.subscribe("ann", scope: Some("room:2"))
  let s1 = json.decode_str[Sync[Model, Msg]](r.call(up("/room/1", 1, "a")).text() ?? "")?
  expect(s1.ver) == 1
  // room 2 has its own log: its first Msg is its version 1 too
  let s2 = json.decode_str[Sync[Model, Msg]](r.call(up("/room/2", 1, "b")).text() ?? "")?
  expect(s2.ver) == 1
  expect(h.model(scope: Some("room:1")).todos.keys()) == ["a"]
  expect(h.model(scope: Some("room:2")).todos.keys()) == ["b"]
  // each room's live pages hear only that room
  expect(live1.try_recv()) == Some(1)
  expect(live2.try_recv()) == Some(1)
  h.apply(Msg.Add(id: "c", title: "c"), scope: Some("room:2"))
  expect(live1.try_recv()) == None
  expect(live2.try_recv()) == Some(2)
  // a page it cannot have is no scope
  expect(r.call(up("/nope", 1, "z")).status) == 404
  expect((get("/room/2").text() ?? "").contains("<li")) == true
}

test "a scope per principal: a sync naming any page reaches only its sender's scope" {
  let h = host(todo_app(), auth: Some(auth_hdr), scope_of: Some(fn(page: Str, p: Str) -> Str? { Some("user:" + p) }))
  let r = routes_for(h)
  let send = fn(who: Str, page: Str, id: Str) -> Int uses sync {
    let body = json.encode_str(Up{client: "c-" + who, ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: id, title: id)}]})
    r.call(http.new_request("POST", "/_xo/sync?page=" + url.query_escape(page), headers: {"Content-Type": "application/json", "X-User": who}, body: body.bytes())).status
  }
  expect(send("ann", "/", "ann's")) == 200
  // bob names ann's page, or none: still his own scope
  expect(send("bob", "/", "bob's")) == 200
  expect(h.model(scope: Some("user:ann")).todos.keys()) == ["ann's"]
  expect(h.model(scope: Some("user:bob")).todos.keys()) == ["bob's"]
  let page = r.call(http.new_request("GET", "/", headers: {"X-User": "bob"})).text() ?? ""
  expect(page.contains("bob's")) == true
  expect(page.contains("ann's")) == false
}

test "a Host keeps at most max_scopes scopes, dropping the least recently used without a live page" {
  let st = memory_store()
  let h = host_with(todo_app(), st, local_bus(), scope_of: Some(room_of), max_scopes: 2)
  h.apply(Msg.Add(id: "a", title: "a"), scope: Some("room:1"))
  let (_id, _live) = h.subscribe("", scope: Some("room:1"))
  h.apply(Msg.Add(id: "b", title: "b"), scope: Some("room:2"))
  h.apply(Msg.Add(id: "c", title: "c"), scope: Some("room:3"))
  // room 2 went (room 1 has a live page), and nothing was lost: it is read
  // from the store again when used
  expect(h.held()) == 2
  expect(h.slots.with_read(fn(m) { m.contains("room:1") })) == true
  expect(h.slots.with_read(fn(m) { m.contains("room:2") })) == false
  expect(h.model(scope: Some("room:2")).todos.keys()) == ["b"]
  expect(h.model(scope: Some("room:1")).todos.keys()) == ["a"]
}

test "syncs that arrive while an append is in flight share the next append (group commit)" {
  let st = memory_store()
  let appends = Atomic[Int].new(0)
  let gate = Chan[Int].new(cap: 1)
  let held = Atomic[Int].new(1)
  // the first append waits until the test lets it go
  let slow = st with {append: fn(scope: Str, b: Batch) -> Bool ! Str uses sync {
    let _n = appends.add(1)
    if held.swap(0) == 1 {
      let _go = gate.recv()
    }
    (st.append)(scope, b)
  }}
  let h = host_with(todo_app(), slow, local_bus())
  let r = routes_for(h)
  let send = fn(client: Str, id: Str) -> Int uses sync {
    let body = json.encode_str(Up{client: client, ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: id, title: id)}]})
    r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json"}, body: body.bytes())).status
  }
  let _m = h.model()
  let first = os.tasks.spawn(fn() -> Int ! Never { send("c0", "t0") })
  while appends.get() < 1 {
  }
  var rest: List[Task[Int, Never]] = []
  for i in 1..6 {
    rest.push(os.tasks.spawn(fn() -> Int ! Never { send("c${i}", "t${i}") }))
  }
  while h.slot("").queue.with_read(fn(q) { q.len() }) < 5 {
  }
  let _go = gate.send(1)
  expect(first.await) == 200
  for x in rest {
    expect(x.await) == 200
  }
  // six syncs, two appends: the one in flight, then the five behind it
  expect(appends.get()) == 2
  expect(h.model().todos.len()) == 6
}


test "many concurrent syncs to one scope are each applied once" {
  let st = memory_store()
  let appends = Atomic[Int].new(0)
  let counted = st with {append: fn(scope: Str, b: Batch) -> Bool ! Str uses sync {
    let _n = appends.add(1)
    (st.append)(scope, b)
  }}
  let h = host_with(todo_app(), counted, local_bus())
  let r = routes_for(h)
  var ts: List[Task[Int, Never]] = []
  for c in 0..20 {
    ts.push(os.tasks.spawn(fn() -> Int ! Never {
      var bad = 0
      for i in 0..10 {
        let body = json.encode_str(Up{client: "c${c}", ver: 0, msgs: [Envelope{seq: i + 1, msg: Msg.Add(id: "c${c}-${i}", title: "t")}]})
        if r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json"}, body: body.bytes())).status != 200 {
          bad += 1
        }
      }
      bad
    }))
  }
  for x in ts {
    expect(x.await) == 0
  }
  expect(h.model().todos.len()) == 200
}

test "convergence holds for any seed" for seed: Int {
  expect(simulate(seed, 4, 120, 400, 50, 20)) == true
}

// ---- serving over HTTP ----

fn routes_for(h: Host[Model, Msg]) -> http.Router {
  var r = http.router()
  h.mount(r)
  r
}

fn sync_req(body: Str, ct: Str = "application/json", query: Str = "") -> http.Request {
  http.new_request("POST", "/_xo/sync${query}", headers: {"Content-Type": ct}, body: body.bytes())
}

test "the host serves the page, the runtime and sync" {
  let h = host(todo_app(), title: "Todos")
  let r = routes_for(h)
  let p = r.call(http.new_request("GET", "/"))
  expect(p.status) == 200
  let body = p.text()?
  expect(body.contains("<div id=\"xo-ui\" data-xo-sync=\"/_xo/sync\" data-xo-live=\"/_xo/live\" data-xo-build=\"${runtime_stamp()}\">")) == true
  expect(body.contains("<script src=\"/_xo/ui.js?v=${runtime_stamp()}\" defer></script>")) == true
  let js = r.call(http.new_request("GET", "/_xo/ui.js"))
  expect(js.status) == 200
  expect(js.text()?.contains("data-xo-")) == true
  let up = Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}
  let resp = r.call(sync_req(json.encode_str(up)))
  expect(resp.status) == 200
  let s = json.decode_str[Sync[Model, Msg]](resp.text()?)?
  expect(s.down.acked) == 1
  expect(s.ver) == 1
  expect(s.down.entries.len()) == 1
  expect(s.html.contains("<li>milk")) == true
  expect(h.model().todos.len()) == 1
}

test "a thin sync leaves out the log entries" {
  let h = host(todo_app())
  let r = routes_for(h)
  let up = Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}
  let s = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(up), query: "?thin=1")).text()?)?
  expect(s.down.entries.len()) == 0
  expect(s.ver) == 1
}

test "sync refuses other content types and bad bodies" {
  let r = routes_for(host(todo_app()))
  expect(r.call(sync_req("{}", ct: "application/x-www-form-urlencoded")).status) == 415
  expect(r.call(sync_req("not json")).status) == 400
  expect(r.call(sync_req("{\"client\":\"a\",\"ver\":0,\"msgs\":[{\"seq\":1,\"msg\":{\"Nope\":{}}}]}")).status) == 400
}

test "the host mounts under a prefix" {
  var r = http.router()
  host(todo_app()).mount(r, prefix: "/app")
  let body = r.call(http.new_request("GET", "/app/")).text()?
  expect(body.contains("data-xo-sync=\"/app/_xo/sync\"")) == true
  expect(body.contains("src=\"/app/_xo/ui.js?v=${runtime_stamp()}\"")) == true
  expect(r.call(http.new_request("GET", "/app/_xo/ui.js")).status) == 200
}

test "field marks a form value in the event's JSON" {
  let s = render(el("form", [on("submit", Msg.Add(id: "n", title: field("title")))], [el("input", [attr("name", "title")])]))
  // The private use mark survives escaping; the runtime fills it in.
  expect(s.contains("\u{E000}title")) == true
}

test "a sync that changes the model tells the live connections" {
  let h = host(todo_app())
  var r = http.router()
  h.mount(r)
  let (id, ch) = h.subscribe()
  expect(h.live()) == 1
  let up = Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}
  r.call(sync_req(json.encode_str(up)))
  expect(ch.try_recv()) == Some(1)
  // A sync with nothing new tells no one.
  r.call(sync_req(json.encode_str(Up{client: "a", ver: 1, msgs: []})))
  expect(ch.try_recv()) == None
  h.unsubscribe(id)
  expect(h.live()) == 0
}

test "the page names the live endpoint" {
  let r = routes_for(host(todo_app()))
  expect(r.call(http.new_request("GET", "/")).text()?.contains("data-xo-live=\"/_xo/live\"")) == true
}

// ---- the predicting client (stage 3) ----

test "predict folds pending Msgs over the confirmed model and renders it" {
  let a = todo_app()
  let out = predict(a, ClientIn{model: a.init, pending: [Msg.Add(id: "x", title: "milk"), Msg.Toggle(id: "x")]})
  var s = server(a)
  s.receive(Up{client: "c", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}, Envelope{seq: 2, msg: Msg.Toggle(id: "x")}]})
  // the prediction is the view the server renders once it has the Msgs
  expect(out.html) == render(view(s.model()))
  expect(out.awaiting) == 0
}

test "predict leaves confirmed Msgs out and counts them" {
  let a = todo_app().confirming(fn(m) { m is Msg.Reserve(_) })
  let out = predict(a, ClientIn{model: a.init, pending: [Msg.Reserve(who: "ann"), Msg.Add(id: "x", title: "milk")]})
  expect(out.awaiting) == 1
  expect(out.html) == render(view(update(a.init, Msg.Add(id: "x", title: "milk"))))
}

test "a host with a client serves its wasm and names it in the page" {
  let r = routes_for(host(todo_app(), client: b"\x00asm\x01\x00\x00\x00"))
  let p = r.call(http.new_request("GET", "/")).text()?
  expect(p.contains("data-xo-wasm=\"/_xo/app.wasm?v=")) == true
  let w = r.call(http.new_request("GET", "/_xo/app.wasm"))
  expect(w.status) == 200
  expect(w.header("Content-Type")) == Some("application/wasm")
  expect(w.body) == b"\x00asm\x01\x00\x00\x00"
}

test "a host without a client is a thin one" {
  let r = routes_for(host(todo_app()))
  expect(r.call(http.new_request("GET", "/")).text()?.contains("data-xo-wasm")) == false
  expect(r.call(http.new_request("GET", "/_xo/app.wasm")).status) == 404
}

test "sync returns the confirmed model when asked" {
  let r = routes_for(host(todo_app()))
  let up = Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}
  let with = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(up), query: "?thin=1&model=1")).text()?)?
  expect(with.model?.todos.len()) == 1
  let without = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(Up{client: "a", ver: 1, msgs: []}), query: "?thin=1")).text()?)?
  expect(without.model) == None
}

test "the client module is served gzipped when accepted, with an ETag" {
  var bb = BytesBuilder.new()
  bb.write(b"\x00asm\x01\x00\x00\x00")
  for _ in 0..4096 {
    bb.write(b"\x00")
  }
  let wasm = bb.freeze()
  let r = routes_for(host(todo_app(), client: wasm))
  let plain = r.call(http.new_request("GET", "/_xo/app.wasm"))
  expect(plain.body) == wasm
  expect(plain.header("Content-Encoding")) == None
  let tag = plain.header("ETag") ?? ""
  expect(tag.starts_with("\"")) == true
  let gz = r.call(http.new_request("GET", "/_xo/app.wasm", headers: {"Accept-Encoding": "br, gzip;q=0.8"}))
  expect(gz.header("Content-Encoding")) == Some("gzip")
  expect(gz.body.len() < wasm.len()) == true
  expect(compress.gunzip(gz.body)?) == wasm
  expect(gz.header("Vary")) == Some("Accept-Encoding")
  let again = r.call(http.new_request("GET", "/_xo/app.wasm", headers: {"If-None-Match": tag}))
  expect(again.status) == 304
  expect(again.body.len()) == 0
}

test "accepts_gzip reads tokens and q=0" {
  expect(accepts_gzip("gzip")) == true
  expect(accepts_gzip("br, GZIP")) == true
  expect(accepts_gzip("*")) == true
  expect(accepts_gzip("gzip;q=0")) == false
  expect(accepts_gzip("gzip; q=0.0, br")) == false
  expect(accepts_gzip("deflate, br")) == false
  expect(accepts_gzip("")) == false
}

test "a page with a client preloads its module in the head" {
  let p = page(todo_app(), todo_app().init, 0, wasm_url: "/_xo/app.wasm")
  let head = p.split("</head>")[0]
  expect(head.contains("<link rel=\"preload\" href=\"/_xo/app.wasm\" as=\"fetch\" type=\"application/wasm\" crossorigin=\"anonymous\">")) == true
  expect(page(todo_app(), todo_app().init, 0).contains("rel=\"preload\"")) == false
}

// ---- decision 0664: principals, allow, redact ----

test "receive_as binds a client to its principal and refuses others" {
  var s = server(todo_app())
  let all = fn(m: Model, p: Str, e: Msg) -> Bool { true }
  let up = Up{client: "c1", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}
  expect(s.receive_as(up, "ann", all).is_some()) == true
  let stolen = Up{client: "c1", ver: 1, msgs: [Envelope{seq: 2, msg: Msg.Remove(id: "x")}]}
  expect(s.receive_as(stolen, "bob", all)) == None
  expect(s.model().todos.len()) == 1
}

test "a refused Msg is acknowledged, counted and not applied" {
  var s = server(todo_app())
  // only ann may remove
  let allow = fn(m: Model, p: Str, e: Msg) -> Bool { p == "ann" || !(e is Msg.Remove(_)) }
  s.receive_as(Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]}, "ann", allow)
  let d = s.receive_as(Up{client: "b", ver: 1, msgs: [Envelope{seq: 1, msg: Msg.Remove(id: "x")}, Envelope{seq: 2, msg: Msg.Star(id: "x")}]}, "bob", allow)?
  expect(d.refused) == 1
  expect(d.acked) == 2
  expect(s.model().todos.len()) == 1
  expect(s.model().todos.get_or_fault("x", "added by ann").stars) == 1
  // the refused Remove is logged as refused, before the star (b synced after the add)
  expect(s.version()) == 3
  expect(d.entries.map(fn(e) { e.refused })) == [true, false]
}

fn auth_hdr(req: http.Request) -> Str? uses sync {
  req.header("X-User")
}

test "a host with auth answers 401 without a principal and 403 for another's client" {
  let r = routes_for(host(todo_app(), auth: Some(auth_hdr)))
  expect(r.call(http.new_request("GET", "/")).status) == 401
  expect(r.call(http.new_request("GET", "/", headers: {"X-User": "ann"})).status) == 200
  let up = json.encode_str(Up{client: "c1", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "x", title: "milk")}]})
  expect(r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json"}, body: up.bytes())).status) == 401
  expect(r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json", "X-User": "ann"}, body: up.bytes())).status) == 200
  expect(r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json", "X-User": "bob"}, body: up.bytes())).status) == 403
}

test "redact shapes the page and every sync, and no log entries are sent" {
  let r = routes_for(host(todo_app(), auth: Some(auth_hdr), redact: Some(mine)))
  let add = fn(user: Str, seq: Int, id: Str) -> http.Response {
    let up = json.encode_str(Up{client: user, ver: 0, msgs: [Envelope{seq: seq, msg: Msg.Add(id: id, title: "${user} item")}]})
    r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json", "X-User": user}, body: up.bytes()))
  }
  add("ann", 1, "a")
  let resp = add("bob", 1, "b")
  let s = json.decode_str[Sync[Model, Msg]](resp.text()?)?
  expect(s.down.entries.len()) == 0
  expect(s.html.contains("bob item")) == true
  expect(s.html.contains("ann item")) == false
  let page_ann = r.call(http.new_request("GET", "/", headers: {"X-User": "ann"})).text()?
  expect(page_ann.contains("ann item")) == true
  expect(page_ann.contains("bob item")) == false
}

// each principal sees only the todos whose title starts with its name
fn mine(m: Model, p: Str) -> Model {
  var n = m
  n.todos = {}
  for (id, t) in m.todos.entries() {
    if t.title.starts_with(p) {
      n.todos.put(id, t)
    }
  }
  n
}

fn sync_as(r: http.Router, user: Str, up: Up[Msg]) -> Sync[Model, Msg] ! Str {
  let resp = r.call(http.new_request("POST", "/_xo/sync?thin=1", headers: {"Content-Type": "application/json", "X-User": user}, body: json.encode_str(up).bytes()))
  json.decode_str[Sync[Model, Msg]](resp.text() ?? "").map_err(fn(e) { "${e}" })
}

test "with redact, a sync answers same while the principal's view did not change" {
  let r = routes_for(host(todo_app(), auth: Some(auth_hdr), redact: Some(mine)))
  let a1 = sync_as(r, "ann", Up{client: "a", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "a", title: "ann item")}]})?
  expect(a1.seen.len()) == 16
  // bob's change moves the version but not ann's view
  sync_as(r, "bob", Up{client: "b", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "b", title: "bob item")}]})?
  let a2 = sync_as(r, "ann", Up{client: "a", ver: a1.ver, msgs: [], seen: a1.seen})?
  expect(a2.same) == true
  expect(a2.ver) == 2
  expect(a2.html) == ""
  // without the digest the version alone cannot tell
  expect(sync_as(r, "ann", Up{client: "a", ver: a1.ver, msgs: []})?.same) == false
  // a change ann sees is sent
  sync_as(r, "bob", Up{client: "b", ver: 2, msgs: [Envelope{seq: 2, msg: Msg.Add(id: "c", title: "ann gift")}]})?
  let a3 = sync_as(r, "ann", Up{client: "a", ver: a2.ver, msgs: [], seen: a2.seen})?
  expect(a3.same) == false
  expect(a3.html.contains("ann gift")) == true
  // the page carries the digest the first sync sends back
  let page = r.call(http.new_request("GET", "/", headers: {"X-User": "ann"})).text() ?? ""
  expect(page.contains("data-xo-seen=\"${a3.seen}\"")) == true
}

test "with redact, a live connection hears only of changes to its own view" {
  let h = host(todo_app(), auth: Some(auth_hdr), redact: Some(mine))
  let r = routes_for(h)
  var ann = h.digest(h.model(), "ann")
  var bob = h.digest(h.model(), "bob")
  // a change costs the request one send per connection...
  let (ida, cha) = h.subscribe("ann")
  let (idb, chb) = h.subscribe("bob")
  sync_as(r, "bob", Up{client: "b", ver: 0, msgs: [Envelope{seq: 1, msg: Msg.Add(id: "b", title: "bob item")}]})?
  expect(cha.try_recv()) == Some(1)
  expect(chb.try_recv()) == Some(1)
  // ...and each connection's task keeps only news to its principal's view
  expect(h.news("ann", ann)) == None
  bob = h.news("bob", bob) ?? return Err("bob's view changed")
  h.apply(Msg.Add(id: "x", title: "ann news"))
  ann = h.news("ann", ann) ?? return Err("ann's view changed")
  expect(h.news("bob", bob)) == None
  // told once per change of the view, not again for the same view
  h.apply(Msg.Star(id: "b"))
  expect(h.news("ann", ann)) == None
  expect(h.news("bob", bob).is_some()) == true
  // versions that come while a connection is busy fold into one
  expect(cha.try_recv()) == Some(2)
  expect(cha.try_recv()) == None
  h.unsubscribe(ida)
  h.unsubscribe(idb)
  // without redact every version is news
  expect(host(todo_app()).news("x", "")) == Some("")
}

// tab state: the view reads the page's query (decision 0672)
fn filtered(m: Model, q: url.Values) -> Html {
  let only = q.get("only") ?? ""
  var items: List[Html] = []
  for (_, t) in m.todos {
    if only == "" || (only == "done") == t.done {
      items.push(el("li", [], [text(t.title)]))
    }
  }
  el("ul", [], items)
}

test "with_url_view renders the page's query on the page, a sync and a prediction" {
  let app = todo_app().with_url_view(filtered)
  let h = host(app)
  let r = routes_for(h)
  h.apply(Msg.Add(id: "a", title: "milk"))
  h.apply(Msg.Add(id: "b", title: "eggs"))
  h.apply(Msg.Toggle(id: "b"))
  let all = r.call(http.new_request("GET", "/")).text() ?? ""
  expect(all.contains("<li>milk") && all.contains("<li>eggs")) == true
  let done = r.call(http.new_request("GET", "/?only=done")).text() ?? ""
  expect(done.contains("<li>eggs")) == true
  // the page state holds the model; the view leaves milk out
  expect(done.contains("<li>milk")) == false
  let s = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(Up{client: "a", ver: 0, msgs: [], query: "only=todo"}), query: "?thin=1")).text() ?? "")?
  expect(s.html.contains("milk")) == true
  expect(s.html.contains("eggs")) == false
  let out = predict(app, ClientIn{model: h.model(), pending: [Msg.Toggle(id: "a")], query: "only=done"})
  expect(out.html.contains("milk") && out.html.contains("eggs")) == true
  // a query that does not parse reads as empty; an App without it ignores it
  expect(predict(app, ClientIn{model: h.model(), pending: [], query: "%zz"}).html.contains("milk")) == true
  expect(predict(todo_app(), ClientIn{model: h.model(), pending: [], query: "only=done"}).html.contains("milk")) == true
}

// ---- server Msgs, compaction, sign-in redirect ----

test "a server Msg reaches every replica in order" {
  let app = todo_app()
  var s = server(app)
  var r = replica(app, "c1", app.init, 0)
  r.send(Msg.Add(id: "a", title: "mine"))
  s.apply(Msg.Add(id: "s", title: "from the server"))
  r.receive(s.receive(r.outbox()))
  expect(r.pending()) == 0
  expect(r.model()) == s.model()
  expect(s.model().todos.len()) == 2
  expect(s.applied(SERVER_CLIENT)) == 1
}

test "Host.apply changes the page, and a sync may not use the server's id" {
  let h = host(todo_app())
  h.apply(Msg.Add(id: "s", title: "loaded"))
  let r = routes_for(h)
  expect(r.call(http.new_request("GET", "/")).text()?.contains("loaded")) == true
  let up = json.encode_str(Up{client: SERVER_CLIENT, ver: 0, msgs: [Envelope{seq: 2, msg: Msg.Remove(id: "s")}]})
  expect(r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json"}, body: up.bytes())).status) == 400
  expect(h.model().todos.len()) == 1
}

test "a host keeps at most twice keep log entries" {
  let h = host(todo_app(), keep: 5)
  for i in 0..100 {
    h.apply(Msg.Add(id: "t${i}", title: "t"))
  }
  let n = h.slot("").state.with_read(fn(c) { c.s.log.len() })
  expect(n < 10) == true
  expect(h.model().todos.len()) == 100
  // a page from before the compaction catches up through a snapshot
  let d = h.slot("").state.with_read(fn(c) { c.s.reply("late", 0) })
  expect(d.reset.is_some()) == true
}

test "signin_url sends a page request without a principal there" {
  let r = routes_for(host(todo_app(), auth: Some(auth_hdr), signin_url: "/login"))
  let resp = r.call(http.new_request("GET", "/"))
  expect(resp.status) == 303
  expect(resp.header("Location")) == Some("/login")
  // a sync still answers 401: the runtime marks the page signed out
  let up = json.encode_str(Up[Msg]{client: "c1", ver: 0, msgs: []})
  expect(r.call(http.new_request("POST", "/_xo/sync", headers: {"Content-Type": "application/json"}, body: up.bytes())).status) == 401
}

test "an idle sync at the current version answers same, without the page" {
  let h = host(todo_app())
  h.apply(Msg.Add(id: "s", title: "loaded"))
  let r = routes_for(h)
  let post = fn(ver: Int) -> Sync[Model, Msg] {
    let up = json.encode_str(Up[Msg]{client: "c1", ver: ver, msgs: []})
    let resp = r.call(http.new_request("POST", "/_xo/sync?thin=1&model=1", headers: {"Content-Type": "application/json"}, body: up.bytes()))
    json.decode_str[Sync[Model, Msg]](resp.text() ?? "").ok() ?? fault("bad sync reply")
  }
  let behind = post(0)
  expect(behind.same) == false
  expect(behind.html.contains("loaded")) == true
  expect(behind.model.is_some()) == true
  let idle = post(1)
  expect(idle.same) == true
  expect(idle.html) == ""
  expect(idle.model) == None
  expect(idle.ver) == 1
}

test "the runtime and client are served at stamped URLs, cached for good" {
  let wasm = b"\x00asm\x01\x00\x00\x00"
  let h = host(todo_app(), client: wasm)
  let r = routes_for(h)
  let wv = crypto.sha256(wasm).to_hex()[..16]
  let jv = runtime_stamp()
  let page = r.call(http.new_request("GET", "/")).text()?
  expect(page.contains("src=\"/_xo/ui.js?v=${jv}\"")) == true
  expect(page.contains("data-xo-wasm=\"/_xo/app.wasm?v=${wv}\"")) == true
  expect(page.contains("data-xo-build=\"${jv}.${wv}\"")) == true
  // the current stamp is cached for good; no stamp or an old one revalidates
  let js = r.call(http.new_request("GET", "/_xo/ui.js?v=${jv}", headers: {"Accept-Encoding": "gzip"}))
  expect(js.header("Cache-Control")) == Some("public, max-age=31536000, immutable")
  expect(js.header("Content-Encoding")) == Some("gzip")
  expect(compress.gunzip(js.body)?) == RUNTIME_JS.bytes()
  expect(r.call(http.new_request("GET", "/_xo/ui.js")).header("Cache-Control")) == Some("no-cache")
  expect(r.call(http.new_request("GET", "/_xo/ui.js?v=old")).header("Cache-Control")) == Some("no-cache")
  let tag = js.header("ETag") ?? ""
  expect(r.call(http.new_request("GET", "/_xo/ui.js", headers: {"If-None-Match": tag})).status) == 304
  expect(r.call(http.new_request("GET", "/_xo/app.wasm?v=${wv}")).header("Cache-Control")) == Some("public, max-age=31536000, immutable")
  expect(r.call(http.new_request("GET", "/_xo/app.wasm?v=old")).header("Cache-Control")) == Some("no-cache")
  // sync replies name the build, idle or not
  let s = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(Up[Msg]{client: "a", ver: 0, msgs: []}), query: "?thin=1")).text()?)?
  expect(s.build) == "${jv}.${wv}"
  let idle = json.decode_str[Sync[Model, Msg]](r.call(sync_req(json.encode_str(Up[Msg]{client: "a", ver: 0, msgs: []}), query: "?thin=1")).text()?)?
  expect(idle.same) == true
  expect(idle.build) == "${jv}.${wv}"
}

test "plain renders a server page the runtime takes over" {
  let s = plain("Search <x>", el("form", [attr("method", "get"), attr("data-xo-submit-on-input", "250")], [el("input", [attr("name", "q")])]), css: "b{x:1}</style>", prefix: "/app")
  expect(s.contains("<title>Search &lt;x&gt;</title>")) == true
  expect(s.contains("<body data-xo-page><form method=\"get\" data-xo-submit-on-input=\"250\">")) == true
  expect(s.contains("<script src=\"/app/_xo/ui.js?v=${runtime_stamp()}\" defer></script></body></html>")) == true
  // the style text cannot end its element
  expect(s.contains("<style>b{x:1}\\3c /style></style>")) == true
  expect(runtime_url()) == "/_xo/ui.js?v=${runtime_stamp()}"
}

test "serve_runtime serves the runtime without an App" {
  var r = http.router()
  serve_runtime(r, prefix: "/s")
  let js = r.call(http.new_request("GET", runtime_url("/s")))
  expect(js.status) == 200
  expect(js.header("Cache-Control")) == Some("public, max-age=31536000, immutable")
  expect(js.text()?.contains("data-xo-page")) == true
}
