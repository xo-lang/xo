// std/crypto (spec/std.md 11). Hashes, HMAC, password hashing, AEAD
// encryption, HKDF, and keys, signatures and PEM for Ed25519, ECDSA and RSA
// (Go's crypto packages). Declaration file; encoding rules are listed at the
// top of std/prelude.xo. Hashing and comparison are pure; anything random
// takes the `Rand` capability (std.md 3.4), so tests are seeded and
// deterministic.

fn sha256(data: Bytes) -> Bytes
fn hmac_sha256(key: Bytes, msg: Bytes) -> Bytes
/// Constant time in the contents (not the lengths) of `a` and `b`.
fn equal(a: Bytes, b: Bytes) -> Bool
/// a[i] ^ b[i] for each i below the shorter length (Go's
/// subtle.XORBytes, into a new Bytes).
fn xor(a: Bytes, b: Bytes) -> Bytes
fn random_bytes(r: Rand, n: Int) -> Bytes uses rand
/// `n` random bytes as unpadded URL safe base64.
fn token(r: Rand, n: Int = 32) -> Str uses rand
/// 26 characters of the standard base32 alphabet, at least 128 random
/// bits (Go's crypto/rand.Text): each of 26 bytes of r, mod 32.
fn random_text(r: Rand) -> Str uses rand
/// Argon2id (RFC 9106) with a 16 byte random salt and a 32 byte key, in the
/// PHC format `$argon2id$v=19$m=<memory_kib>,t=<iterations>,p=<parallelism>$<salt>$<key>`.
/// The defaults are the OWASP minimum (19 MiB, 2 passes, 1 lane). The
/// recommended password hash (std.md 11).
fn hash_password_argon2id(r: Rand, password: Str, memory_kib: Int = 19456, iterations: Int = 2, parallelism: Int = 1) -> Str uses rand
/// PBKDF2-HMAC-SHA256 with a 16 byte random salt; the result is
/// `pbkdf2-sha256$<iterations>$<salt>$<key>` (std.md 11).
fn hash_password(r: Rand, password: Str, iterations: Int = 600000) -> Str uses rand
/// Checks a result of `hash_password_argon2id` or `hash_password`, told apart
/// by the prefix.
fn verify_password(password: Str, hash: Str) -> Bool
/// Ed25519 (RFC 8032, decision 0189): the 32 byte public key of the
/// private key `seed` (32 bytes; faults otherwise).
fn ed25519_public_key(seed: Bytes) -> Bytes
/// The 64 byte Ed25519 signature of msg by the private key `seed`: the
/// 32 byte seed, or Go's 64 byte private key (the seed, then its public
/// key, which signing then uses as stored and need not compute); faults
/// on any other length. Deterministic: the same seed and message give the
/// same signature.
fn ed25519_sign(seed: Bytes, msg: Bytes) -> Bytes
/// Whether sig is a valid Ed25519 signature of msg by public_key; false
/// for a key that is not 32 bytes or a signature that is not 64.
fn ed25519_verify(public_key: Bytes, msg: Bytes, sig: Bytes) -> Bool
/// Ed25519ph and Ed25519ctx (RFC 8032 5.1, Go's PrivateKey.Sign with
/// ed25519.Options): with `prehashed`, msg is the 64 byte SHA-512 of the
/// message (Ed25519ph, Go's Hash: crypto.SHA512); a `context` of 1 to 255
/// bytes selects Ed25519ctx, or is Ed25519ph's context; with neither it is
/// ed25519_sign. The key is ed25519_sign's (faults on another length).
/// Err with Go's texts: `ed25519: bad Ed25519ph message hash length: N`,
/// `ed25519: bad Ed25519ph context length: N`, `ed25519: bad Ed25519ctx
/// context length: N`.
fn ed25519_sign_with(seed: Bytes, msg: Bytes, prehashed: Bool = false, context: Bytes = b"") -> Bytes ! KeyErr
/// Go's VerifyWithOptions: whether sig is a valid signature of msg by
/// public_key under the same `prehashed` and `context` (false, as
/// ed25519_verify, for a key or signature of the wrong length); Err with
/// ed25519_sign_with's texts for a hash or context of the wrong length,
/// checked before the key.
fn ed25519_verify_with(public_key: Bytes, msg: Bytes, sig: Bytes, prehashed: Bool = false, context: Bytes = b"") -> Bool ! KeyErr

/// The hashes of `digest`, `hmac`, and `Hasher` (decision 0279). Md5 and
/// Sha1 are broken for collision resistance; they are here for protocols
/// that require them (HMAC-SHA1 signatures, TOTP, Postgres MD5
/// authentication, Content-MD5).
enum Hash {
  Md5
  Sha1
  Sha224
  Sha256
  Sha384
  Sha512
  Sha3_256
  Sha3_512
  Sha3_224
  Sha3_384
  /// SHA-512/224 (FIPS 180-4 5.3.6): SHA-512's compression from its own
  /// initial value, cut to 28 bytes.
  Sha512_224
  /// SHA-512/256: the same, cut to 32 bytes.
  Sha512_256
}

/// The digest's size in bytes: 16, 20, 28, 32, 48, 64, 32, 64, 28, 48, 28, 32.
fn (h: Hash) size() -> Int
/// The digest of data with h (Go's md5.Sum, sha1.Sum, sha256.Sum224, ...).
fn digest(h: Hash, data: Bytes) -> Bytes
/// HMAC (RFC 2104) of msg keyed with key, over h (Go's crypto/hmac).
fn hmac(h: Hash, key: Bytes, msg: Bytes) -> Bytes

/// A hash being computed a piece at a time: a value, so copies are
/// independent (`var x = crypto.hasher(Sha256)`, then `x.write(chunk)`).
struct Hasher {}

fn hasher(h: Hash) -> Hasher
/// A Hasher computing HMAC over h keyed with key.
fn hmac_hasher(h: Hash, key: Bytes) -> Hasher
fn (var x: Hasher) write(data: Bytes)
/// The digest (or MAC) of what was written so far; writing may continue.
fn (x: Hasher) sum() -> Bytes
/// The bytes written so far.
fn (x: Hasher) written() -> Int
/// The hash's block size in bytes (Go's BlockSize): 64 for MD5, SHA-1,
/// SHA-224 and SHA-256, 128 for SHA-384, SHA-512 and SHA-512/t, the rate
/// for SHA-3 (144, 136, 104, 72).
fn (x: Hasher) block_size() -> Int
/// The digest's size in bytes (Go's Size).
fn (x: Hasher) size() -> Int
/// Back to the state hasher or hmac_hasher made, the HMAC key kept (Go's
/// Reset).
fn (var x: Hasher) reset()
/// Go's MarshalBinary (and AppendBinary): the state in Go's format, which
/// Go's UnmarshalBinary resumes and unmarshal_binary reads back. Err for
/// an HMAC: Go's HMAC has no MarshalBinary.
fn (x: Hasher) marshal_binary() -> Bytes ! HashErr
/// Go's UnmarshalBinary: a Hasher of x's hash at that state. Err with Go's
/// texts (`crypto/sha256: invalid hash state identifier`, `crypto/sha256:
/// invalid hash state size`, `sha3: invalid hash state`, `sha3: invalid
/// hash state identifier`, `sha3: invalid hash state function`, and
/// md5's, sha1's and sha512's), and for an HMAC. Its written() is the
/// state's message length; SHA-3's state keeps none, so it counts from 0.
fn (x: Hasher) unmarshal_binary(state: Bytes) -> Hasher ! HashErr

/// Go's error texts for a hash state.
struct HashErr {
  msg: Str
}

fn (e: HashErr) display() -> Str

/// An extendable output function (Go's sha3.SHAKE): SHAKE128 or SHAKE256
/// (FIPS 202), or cSHAKE128 or cSHAKE256 (NIST SP 800-185). Write the
/// input, then read as many bytes as needed, in as many reads as wanted:
/// the reads continue one output stream. A value, so copies are
/// independent.
struct Shake {}

/// A new SHAKE128 (Go's sha3.NewSHAKE128).
fn shake128() -> Shake
/// A new SHAKE256.
fn shake256() -> Shake
/// A new cSHAKE128 with function name n and customization s (Go's
/// sha3.NewCSHAKE128); plain SHAKE128 when both are empty.
fn cshake128(n: Bytes, s: Bytes) -> Shake
/// A new cSHAKE256; plain SHAKE256 when n and s are empty.
fn cshake256(n: Bytes, s: Bytes) -> Shake
/// Absorbs data. A fault ("sha3: Write after Read") once output was read,
/// as Go panics.
fn (var x: Shake) write(data: Bytes)
/// The next n bytes of output.
fn (var x: Shake) read(n: Int) -> Bytes
/// Back to the state before any write (cSHAKE keeps its n and s).
fn (var x: Shake) reset()
/// The rate in bytes: 168 for the 128 bit functions, 136 for the 256 bit.
fn (x: Shake) block_size() -> Int
/// Go's SHAKE.MarshalBinary: the sponge in Go's format, then cSHAKE's
/// init block.
fn (x: Shake) marshal_binary() -> Bytes
/// Go's SHAKE.UnmarshalBinary: x's function at that state, its reset going
/// back to the state's init block. Err with Go's texts, as Hasher's.
fn (x: Shake) unmarshal_binary(state: Bytes) -> Shake ! HashErr
/// The first n bytes of SHAKE128 of data (Go's sha3.SumSHAKE128).
fn sum_shake128(data: Bytes, n: Int) -> Bytes
/// The first n bytes of SHAKE256 of data.
fn sum_shake256(data: Bytes, n: Int) -> Bytes

// ---- authenticated encryption and key derivation (0.35, Go's cipher.AEAD and crypto/hkdf) ----

/// An authenticated cipher with associated data (Go's cipher.AEAD): it
/// encrypts and authenticates a message, and authenticates `aad` alongside
/// it without encrypting it.
enum Aead {
  /// AES-GCM (NIST SP 800-38D): a 16, 24 or 32 byte key (AES-128, 192, 256).
  AesGcm
  /// ChaCha20-Poly1305 (RFC 8439): a 32 byte key.
  ChaCha20Poly1305
  /// AES-CBC with HMAC-SHA-256 (RFC 7518 5.2.3, JWE A128CBC-HS256): a 32
  /// byte key, its first half the MAC key and its second the AES-128 key;
  /// a 16 byte nonce (the IV); PKCS#7 padding; the tag is
  /// HMAC-SHA-256(aad || iv || ciphertext || AL) cut to 16 bytes, AL the
  /// aad's length in bits as a big endian 64 bit integer. A sealed message
  /// is `ciphertext || tag`. Every failure to open (tag, padding, length) is
  /// the same error, after the tag is checked in constant time.
  Aes128CbcHmacSha256
}

/// The nonce's size in bytes: 12 for AesGcm and ChaCha20Poly1305, 16 for
/// Aes128CbcHmacSha256.
fn (a: Aead) nonce_size() -> Int
/// The bytes a sealed message is longer than its plaintext: 16 (the tag);
/// for Aes128CbcHmacSha256 at most 32 (1 to 16 bytes of padding, then the
/// tag).
fn (a: Aead) overhead() -> Int

/// A key ready to seal and open messages: its key schedule is made once,
/// so keep one for many messages. It never displays, prints, or encodes its
/// key (no Display, no derive Json), as a `Secret[T]`.
struct AeadKey {}

/// An AEAD error: `cipher: message authentication failed` for every
/// sealed message that does not open (whatever check failed), or a key
/// size error from aead_key.
struct AeadErr {
  msg: Str
}

fn (e: AeadErr) display() -> Str

/// alg's key; Err when `key` is not a length alg takes.
fn aead_key(alg: Aead, key: Bytes) -> AeadKey ! AeadErr
/// An AES-GCM key for nonces of `size` bytes (Go's
/// cipher.NewGCMWithNonceSize; RFC 5288 and most protocols use 12, the
/// size aead_key's keys take). Err with Go's texts: `crypto/aes: invalid
/// key size N`, `cipher: the nonce can't have zero length`.
fn aes_gcm_key_with_nonce_size(key: Bytes, size: Int) -> AeadKey ! AeadErr
/// An AES-GCM key whose tags are cut to `size` bytes, 12 to 16 (Go's
/// cipher.NewGCMWithTagSize); `cipher: incorrect tag size given to GCM`
/// for another size.
fn aes_gcm_key_with_tag_size(key: Bytes, size: Int) -> AeadKey ! AeadErr
/// The key's nonce size (Go's AEAD.NonceSize): its algorithm's, or the
/// size aes_gcm_key_with_nonce_size was given.
fn (k: AeadKey) nonce_size() -> Int
/// The key's overhead (Go's AEAD.Overhead): its algorithm's, or the tag
/// size aes_gcm_key_with_tag_size was given.
fn (k: AeadKey) overhead() -> Int
fn (k: AeadKey) alg() -> Aead
/// plaintext sealed under a random nonce from `r`, the nonce first: the
/// way to seal unless a protocol counts nonces (Go's
/// cipher.NewGCMWithRandomNonce). Open it with open_random.
fn (k: AeadKey) seal_random(r: Rand, plaintext: Bytes, aad: Bytes = b"") -> Bytes uses rand
/// A message from seal_random, checked and decrypted.
fn (k: AeadKey) open_random(sealed: Bytes, aad: Bytes = b"") -> Bytes ! AeadErr
/// plaintext encrypted and authenticated with aad under `nonce` (exactly
/// nonce_size() bytes, else a fault): the ciphertext, then the 16 byte tag.
/// A nonce must never be used twice with one key: a repeat breaks both the
/// confidentiality and the authenticity of every message under the key.
fn (k: AeadKey) seal(nonce: Bytes, plaintext: Bytes, aad: Bytes = b"") -> Bytes
/// sealed checked and decrypted; Err (and no plaintext) when it was
/// changed, the nonce or aad differ, or it is shorter than the tag.
fn (k: AeadKey) open(nonce: Bytes, sealed: Bytes, aad: Bytes = b"") -> Bytes ! AeadErr

/// HKDF-Extract (RFC 5869, Go's hkdf.Extract): the pseudorandom key,
/// h.size() bytes, from `secret` and `salt` (empty: h.size() zero bytes).
fn hkdf_extract(h: Hash, secret: Bytes, salt: Bytes = b"") -> Bytes
/// HKDF-Expand (Go's hkdf.Expand): n bytes of keying material from a
/// pseudorandom key and `info`. Faults when n is negative or over 255
/// times h.size().
fn hkdf_expand(h: Hash, prk: Bytes, info: Bytes, n: Int) -> Bytes
/// HKDF, extract then expand (Go's hkdf.Key).
fn hkdf(h: Hash, secret: Bytes, salt: Bytes, info: Bytes, n: Int) -> Bytes
/// PBKDF2 (RFC 8018 5.2, Go's pbkdf2.Key) with HMAC over h: key_len bytes
/// of key from password and salt after `iterations` rounds (fewer than 1
/// count as 1, as Go). Err with Go's texts: `pkbdf2: keyLength must be
/// larger than 0` (Go's spelling) and `pbkdf2: keyLength too long` (more
/// than 2^32 - 1 blocks).
fn pbkdf2(h: Hash, password: Bytes, salt: Bytes, iterations: Int, key_len: Int) -> Bytes ! KeyErr

// ---- public key signatures, keys, and PEM (decision 0285) ----

/// A PEM block (encoding/pem): its type (`PUBLIC KEY`), headers, and
/// decoded bytes.
struct PemBlock {
  kind: Str
  headers: Map[Str, Str]
  bytes: Bytes
}

/// Go's error texts (`x509: failed to parse public key`, ...).
struct KeyErr {
  msg: Str
}

fn (e: KeyErr) display() -> Str

enum KeyAlg {
  Rsa
  EcdsaP224
  EcdsaP256
  EcdsaP384
  EcdsaP521
  Ed25519
}

/// A public key: ==; Debug text `<publickey>`.
struct PublicKey {}

/// PKIX SubjectPublicKeyInfo (x509.ParsePKIXPublicKey) or PKCS #1
/// RSAPublicKey DER.
fn parse_public_key(der: Bytes) -> PublicKey ! KeyErr
/// PKIX DER (x509.MarshalPKIXPublicKey).
fn marshal_public_key(k: PublicKey) -> Bytes
fn (k: PublicKey) alg() -> KeyAlg
/// A JWK's public key (RFC 7517; kty RSA, EC with crv P-256, P-384, or
/// P-521, OKP with crv Ed25519; private members ignored).
fn jwk_public_key(jwk: Str) -> PublicKey ! KeyErr

/// A private key: Debug text `<privatekey>`, never key material.
struct PrivateKey {}

/// PKCS #8, PKCS #1, or SEC 1 EC DER, as Go's parsers tell them apart.
fn parse_private_key(der: Bytes) -> PrivateKey ! KeyErr
/// k as PKCS #8 DER (Go's MarshalPKCS8PrivateKey), which parse_private_key
/// reads back; pem_encode it as a "PRIVATE KEY" block to save it.
fn marshal_private_key(k: PrivateKey) -> Bytes
fn (k: PrivateKey) alg() -> KeyAlg
fn (k: PrivateKey) public_key() -> PublicKey
/// An ECDSA key from its private scalar d, big endian and as long as the
/// curve's order (32 bytes for EcdsaP256; 66 for EcdsaP521), as Go's
/// ecdsa.ParseRawPrivateKey: 0 and d at or above the order are KeyErr
/// (`ecdsa: invalid public key encoding`, Go's text), a wrong length is
/// `invalid scalar length`, and any other alg is KeyErr. `public_key()` of
/// the result is the public point (AWS SigV4a derives its key this way).
fn ecdsa_private_key(alg: KeyAlg, d: Bytes) -> PrivateKey ! KeyErr
/// An ECDSA public key from its uncompressed point 0x04 || X || Y (SEC 1
/// 2.3.3, Go's ecdsa.ParseUncompressedPublicKey). Err with Go's texts:
/// `ecdsa: invalid uncompressed public key` (no leading 0x04), then
/// `invalid P256 point encoding`, `invalid P256 element encoding`, `P256
/// point not on curve` (each curve's), and `ecdsa: curve not supported by
/// ParseUncompressedPublicKey` for an alg that is not ECDSA.
fn ecdsa_public_key(alg: KeyAlg, point: Bytes) -> PublicKey ! KeyErr
/// The key's raw encoding: an ECDSA key's uncompressed point (Go's
/// ecdsa.PublicKey.Bytes, which ecdsa_public_key reads), an Ed25519 key's
/// 32 bytes; Err for an RSA key, which has none (marshal_public_key gives
/// its DER).
fn (k: PublicKey) bytes() -> Bytes ! KeyErr
/// The key's raw encoding: an ECDSA key's scalar d as long as the order
/// (Go's ecdsa.PrivateKey.Bytes, which ecdsa_private_key reads), an
/// Ed25519 key's 32 byte seed (Go's Seed, which ed25519_sign takes); Err
/// for an RSA key.
fn (k: PrivateKey) bytes() -> Bytes ! KeyErr
/// An RSA key's numbers, each big endian without leading zeros (Go's
/// big.Int.Bytes): the modulus n, the public exponent e, the modulus's
/// size in bytes (Go's PublicKey.Size), and for a private key d, the
/// primes p and q, and the CRT values dp, dq and qinv (Go's
/// PrecomputedValues); a public key's are empty.
struct RsaParts {
  n: Bytes
  e: Int
  size: Int
  d: Bytes
  primes: List[Bytes]
  dp: Bytes
  dq: Bytes
  qinv: Bytes
}
/// The key's RSA numbers (Go's rsa.PublicKey N, E and Size); Err for a key
/// that is not RSA.
fn (k: PublicKey) rsa_parts() -> RsaParts ! KeyErr
/// The key's RSA numbers (Go's rsa.PrivateKey D, Primes and Precomputed);
/// Err for a key that is not RSA.
fn (k: PrivateKey) rsa_parts() -> RsaParts ! KeyErr
/// An RSA public key of modulus n and exponent e, big endian (Go's
/// rsa.PublicKey{N, E}); Err `crypto/rsa: missing public modulus` for a
/// zero n and `crypto/rsa: public exponent too small or negative` for e
/// below 1. Other checks (size, an even modulus or exponent) come where
/// the key is used, as Go's.
fn rsa_public_key(n: Bytes, e: Int) -> PublicKey ! KeyErr
/// An RSA private key from its numbers (Go's rsa.PrivateKey{N, E, D,
/// Primes} after Validate and Precompute): the CRT values are computed and
/// the key checked, with Go's errors (`crypto/rsa: missing primes`,
/// `crypto/rsa: invalid prime`, `crypto/rsa: p * q != n`, ...). Two
/// primes only: `crypto/rsa: multi-prime keys are not supported`, as
/// parse_private_key.
fn rsa_private_key(n: Bytes, e: Int, d: Bytes, primes: List[Bytes]) -> PrivateKey ! KeyErr
/// The key as an ECDH key of its curve (Go's ecdsa.PublicKey.ECDH): P-256,
/// P-384 and P-521; Err `ecdsa: unsupported curve by crypto/ecdh` for
/// P-224 and for keys that are not ECDSA.
fn (k: PublicKey) ecdh() -> EcdhPublicKey ! KeyErr
/// Go's ecdsa.PrivateKey.ECDH, as PublicKey.ecdh.
fn (k: PrivateKey) ecdh() -> EcdhPrivateKey ! KeyErr

/// Every PEM block in text, in order (pem.Decode repeated on the rest);
/// text outside blocks and malformed blocks are skipped.
fn pem_decode(text: Str) -> List[PemBlock]
/// pem.EncodeToMemory: KeyErr for a header key holding a colon.
fn pem_encode(b: PemBlock) -> Str ! KeyErr

/// RSA PKCS #1 v1.5 or ECDSA (ASN.1 DER) over msg hashed with h, or
/// Ed25519 over msg itself; false for a key, hash, or signature that does
/// not fit.
fn verify(k: PublicKey, h: Hash, msg: Bytes, sig: Bytes) -> Bool
/// RSA PSS, any salt length (PSSSaltLengthAuto).
fn verify_pss(k: PublicKey, h: Hash, msg: Bytes, sig: Bytes) -> Bool
/// ECDSA with the fixed size r || s of JWS (RFC 7518 3.4).
fn verify_raw_ecdsa(k: PublicKey, h: Hash, msg: Bytes, sig: Bytes) -> Bool
/// RSA PKCS #1 v1.5, ECDSA (ASN.1 DER, a hedged nonce from r), or Ed25519.
fn sign(r: Rand, k: PrivateKey, h: Hash, msg: Bytes) -> Bytes ! KeyErr uses rand
/// RSA PSS with a salt as long as the hash, from r.
fn sign_pss(r: Rand, k: PrivateKey, h: Hash, msg: Bytes) -> Bytes ! KeyErr uses rand
/// RSA-OAEP encryption (RFC 8017, Go's EncryptOAEP), the recommended RSA
/// encryption scheme: msg under the RSA key k, with h for the label hash
/// and MGF1 and a seed of h.size() bytes from r. KeyErr for a key that is
/// not RSA or a msg longer than the key's size - 2 * h.size() - 2.
/// mgf_hash, when given, is MGF1's hash apart from h (Go's
/// EncryptOAEPWithOptions with OAEPOptions.MGFHash).
fn encrypt_oaep(r: Rand, k: PublicKey, h: Hash, msg: Bytes, label: Bytes = b"", mgf_hash: Hash? = None) -> Bytes ! KeyErr uses rand
/// RSA-OAEP decryption (Go's DecryptOAEP). The padding is checked in
/// constant time, and every failure (a bad ciphertext, padding or label)
/// is the one KeyErr `crypto/rsa: decryption error`, so a caller cannot
/// tell causes apart.
/// mgf_hash as encrypt_oaep's (Go's PrivateKey.Decrypt with OAEPOptions).
fn decrypt_oaep(k: PrivateKey, h: Hash, ciphertext: Bytes, label: Bytes = b"", mgf_hash: Hash? = None) -> Bytes ! KeyErr
/// Legacy: RSA PKCS #1 v1.5 encryption (Go's EncryptPKCS1v15), only for
/// interoperating with existing systems that require it; new protocols use
/// encrypt_oaep. As Go's crypto/rsa says, PKCS #1 v1.5 encryption is
/// dangerous: a decrypter that reveals whether padding was valid is open to
/// Bleichenbacher's attack. Padding is nonzero bytes from r.
fn encrypt_pkcs1v15(r: Rand, k: PublicKey, msg: Bytes) -> Bytes ! KeyErr uses rand
/// Legacy: RSA PKCS #1 v1.5 decryption (Go's DecryptPKCS1v15), for
/// interoperating with existing systems only; decrypt_oaep otherwise.
/// Constant-time padding checks and the one KeyErr `crypto/rsa: decryption
/// error`, but the scheme stays unsafe wherever an attacker can learn
/// whether a ciphertext decrypted.
fn decrypt_pkcs1v15(k: PrivateKey, ciphertext: Bytes) -> Bytes ! KeyErr
/// ECDSA as the fixed size r || s of JWS.
fn sign_raw_ecdsa(r: Rand, k: PrivateKey, h: Hash, msg: Bytes) -> Bytes ! KeyErr uses rand
/// ECDSA over a digest the caller computed (Go's ecdsa.SignASN1): ASN.1
/// DER, a hedged nonce from r, as sign's; a digest longer than the order
/// counts by its leftmost bits, as Go's. Err for a key that is not ECDSA.
/// RSA PSS over a digest the caller computed with h (Go's SignPSS with
/// PSSOptions): salt_len -1 is the hash's size (PSSSaltLengthEqualsHash,
/// sign_pss's), 0 the largest the key takes (PSSSaltLengthAuto), above 0
/// that many bytes, from r. Err with Go's texts: `crypto/rsa: invalid PSS
/// salt length`, `crypto/rsa: input must be hashed with given hash`,
/// `crypto/rsa: message too long for RSA key size`, and for a key that is
/// not RSA.
fn sign_pss_digest(r: Rand, k: PrivateKey, h: Hash, digest: Bytes, salt_len: Int = -1) -> Bytes ! KeyErr uses rand
/// Go's VerifyPSS with PSSOptions: salt_len 0 takes any salt
/// (PSSSaltLengthAuto, verify_pss's), -1 the hash's size, above 0 exactly
/// that many bytes; false for a key that is not RSA or a digest of the
/// wrong length.
fn verify_pss_digest(k: PublicKey, h: Hash, digest: Bytes, sig: Bytes, salt_len: Int = 0) -> Bool
/// RSA PKCS #1 v1.5 over a digest the caller computed (Go's SignPKCS1v15):
/// with h, the digest must be h's size (`crypto/rsa: input must be hashed
/// message`) and goes in h's DigestInfo; with None, the bytes are signed
/// as they are (Go's crypto.Hash(0): a TLS 1.1 MD5+SHA1 or a caller's own
/// DigestInfo).
fn sign_pkcs1v15_digest(k: PrivateKey, h: Hash?, digest: Bytes) -> Bytes ! KeyErr
/// Go's VerifyPKCS1v15 over a digest, h as sign_pkcs1v15_digest's.
fn verify_pkcs1v15_digest(k: PublicKey, h: Hash?, digest: Bytes, sig: Bytes) -> Bool
fn ecdsa_sign_digest(r: Rand, k: PrivateKey, digest: Bytes) -> Bytes ! KeyErr uses rand
/// Go's ecdsa.VerifyASN1: whether sig (ASN.1 DER) signs digest under k;
/// false for a key that is not ECDSA.
fn ecdsa_verify_digest(k: PublicKey, digest: Bytes, sig: Bytes) -> Bool
/// A new key from r (Go's GenerateKey): an ECDSA or Ed25519 key, or an RSA
/// key of `bits` (1024 to 8192, exponent 65537; other algorithms ignore
/// it). The same r gives the same key on every backend.
fn generate_key(r: Rand, alg: KeyAlg, bits: Int = 2048) -> PrivateKey ! KeyErr uses rand

// ---- ECDH key agreement (crypto/ecdh, decision 0599) ----

/// crypto/ecdh's curves.
enum EcdhCurve {
  X25519
  P256
  P384
  P521
}

/// An ECDH private key: Debug text `<ecdhprivatekey>`, never key material.
struct EcdhPrivateKey {}

/// An ECDH public key: ==.
struct EcdhPublicKey {}

/// A new key from r (Curve.GenerateKey): X25519 reads 32 bytes; a NIST
/// curve samples its scalar as generate_key's ECDSA path, so the same r
/// gives the same key on every backend.
fn ecdh_generate_key(r: Rand, c: EcdhCurve) -> EcdhPrivateKey uses rand
/// Curve.NewPrivateKey: X25519's 32 bytes, or a NIST scalar (big endian,
/// the order's length) in [1, n); Go's texts (`crypto/ecdh: invalid
/// private key size`, X25519; `crypto/ecdh: invalid private key`).
fn ecdh_private_key(c: EcdhCurve, key: Bytes) -> EcdhPrivateKey ! KeyErr
/// Curve.NewPublicKey: X25519's 32 bytes, or a NIST uncompressed point on
/// the curve; Go's texts: `crypto/ecdh: invalid public key` (a wrong
/// X25519 length, the identity, a compressed point), then nistec's
/// (`invalid P256 point encoding`, `invalid P256 element encoding`, `invalid P384Element encoding`,
/// `P256 point not on curve`).
fn ecdh_public_key(c: EcdhCurve, key: Bytes) -> EcdhPublicKey ! KeyErr
fn (k: EcdhPrivateKey) curve() -> EcdhCurve
/// The key's encoding (PrivateKey.Bytes), which ecdh_private_key reads.
fn (k: EcdhPrivateKey) bytes() -> Bytes
fn (k: EcdhPrivateKey) public_key() -> EcdhPublicKey
/// The shared secret (PrivateKey.ECDH): X25519's 32 bytes, or a NIST
/// curve's x coordinate; KeyErr for keys of different curves or an
/// X25519 result of zero (a low order point), with Go's texts.
fn (k: EcdhPrivateKey) ecdh(peer: EcdhPublicKey) -> Bytes ! KeyErr
fn (k: EcdhPublicKey) curve() -> EcdhCurve
/// The key's encoding (PublicKey.Bytes), which ecdh_public_key reads.
fn (k: EcdhPublicKey) bytes() -> Bytes

// ---- ML-KEM key encapsulation (crypto/mlkem, decision 0604) ----

/// crypto/mlkem's parameter sets (FIPS 203).
enum MlkemParams {
  Mlkem768
  Mlkem1024
}

/// An ML-KEM decapsulation key: Debug text `<mlkemdecapsulationkey>`,
/// never key material.
struct MlkemDecapsulationKey {}

/// An ML-KEM encapsulation key: ==.
struct MlkemEncapsulationKey {}

/// The size of an ML-KEM shared key (mlkem.SharedKeySize).
const MLKEM_SHARED_KEY_SIZE: Int = 32
/// The size of a decapsulation key's seed (mlkem.SeedSize).
const MLKEM_SEED_SIZE: Int = 64

/// The size of an encapsulation key: 1184, or 1568 for ML-KEM-1024.
fn (p: MlkemParams) encapsulation_key_size() -> Int
/// The size of a ciphertext: 1088, or 1568 for ML-KEM-1024.
fn (p: MlkemParams) ciphertext_size() -> Int

/// A new decapsulation key (GenerateKey768, GenerateKey1024): reads its
/// 64 byte seed (d, then z) from r, so one seeded r gives one key on every
/// backend.
fn mlkem_generate_key(r: Rand, p: MlkemParams) -> MlkemDecapsulationKey uses rand
/// The decapsulation key of a 64 byte seed (NewDecapsulationKey768);
/// Go's text `mlkem: invalid seed length`.
fn mlkem_decapsulation_key(p: MlkemParams, seed: Bytes) -> MlkemDecapsulationKey ! KeyErr
/// An encapsulation key from its encoding (NewEncapsulationKey768);
/// Go's texts: `mlkem: invalid encapsulation key length`, `mlkem: invalid
/// polynomial encoding` (a coefficient not below q).
fn mlkem_encapsulation_key(p: MlkemParams, key: Bytes) -> MlkemEncapsulationKey ! KeyErr
fn (k: MlkemDecapsulationKey) params() -> MlkemParams
/// The 64 byte seed (d || z), which mlkem_decapsulation_key reads.
fn (k: MlkemDecapsulationKey) bytes() -> Bytes
fn (k: MlkemDecapsulationKey) encapsulation_key() -> MlkemEncapsulationKey
/// The shared key of a ciphertext; `mlkem: invalid ciphertext length`
/// for another length. Any ciphertext of the right length gives a key:
/// one that was not made for this key gives a pseudorandom key (FIPS
/// 203's implicit rejection).
fn (k: MlkemDecapsulationKey) decapsulate(ciphertext: Bytes) -> Bytes ! KeyErr
fn (k: MlkemEncapsulationKey) params() -> MlkemParams
/// The key's encoding, which mlkem_encapsulation_key reads.
fn (k: MlkemEncapsulationKey) bytes() -> Bytes
/// (shared key, ciphertext) for a 32 byte message read from r (Go's
/// mlkemtest.Encapsulate768 with that message).
fn (k: MlkemEncapsulationKey) encapsulate(r: Rand) -> (Bytes, Bytes) uses rand
// ---- AES block and the CBC and CTR modes (crypto/aes, crypto/cipher, decision 0605) ----

/// An AES key schedule (Go's aes.NewCipher Block): Debug text `<aesblock>`.
/// CBC and CTR are not authenticated: new designs use an Aead.
struct AesBlock {}

/// The schedule of a 16, 24 or 32 byte key; else KeyErr `crypto/aes:
/// invalid key size N`.
fn aes_block(key: Bytes) -> AesBlock ! KeyErr
/// One 16 byte block encrypted (Block.Encrypt); another length faults
/// with `crypto/aes: input not full block`.
fn (b: AesBlock) encrypt_block(src: Bytes) -> Bytes
/// One 16 byte block decrypted (Block.Decrypt).
fn (b: AesBlock) decrypt_block(src: Bytes) -> Bytes
/// CBC encryption (NewCBCEncrypter, CryptBlocks) of whole blocks, no
/// padding; faults: `cipher.NewCBCEncrypter: IV length must equal block
/// size`, `crypto/cipher: input not full blocks`.
fn cbc_encrypt(b: AesBlock, iv: Bytes, plaintext: Bytes) -> Bytes
/// CBC decryption (NewCBCDecrypter, CryptBlocks); faults as cbc_encrypt
/// with `cipher.NewCBCDecrypter: ...`.
fn cbc_decrypt(b: AesBlock, iv: Bytes, ciphertext: Bytes) -> Bytes

/// A CTR keystream (NewCTR): the counter is the IV as a 128 bit big
/// endian number, wrapping at 2^128. Debug text `<ctr>`.
struct Ctr {}

/// A keystream from iv (16 bytes, else a fault: `cipher.NewCTR: IV
/// length must equal block size`).
fn ctr(b: AesBlock, iv: Bytes) -> Ctr
/// data xored with the next len(data) bytes of the keystream
/// (XORKeyStream); the next call continues where this one ended.
fn (var c: Ctr) xor(data: Bytes) -> Bytes
