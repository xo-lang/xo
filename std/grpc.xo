// std/grpc (decision 0535): gRPC over std/http's HTTP/2. This file is the pure layer: the message frame, the
// grpc-timeout header, the status codes and the grpc-message percent encoding, as grpc-go does them.
// The pure layer is pure; the server and the client use std/http.
//
// std/grpc: the pure layer (decision 0535), after grpc-go's rpc_util.go (frame, timeout) and status (message encoding).

use std/base64
use std/compress
use std/http
use std/task

/// The 17 canonical status codes (their numbers are the wire values of `grpc-status`).
pub enum Code {
  Ok
  Canceled
  Unknown
  InvalidArgument
  DeadlineExceeded
  NotFound
  AlreadyExists
  PermissionDenied
  ResourceExhausted
  FailedPrecondition
  Aborted
  OutOfRange
  Unimplemented
  Internal
  Unavailable
  DataLoss
  Unauthenticated
} derive Display

/// The wire number of a code (OK is 0, UNAUTHENTICATED is 16).
pub fn (c: Code) number() -> Int {
  match c {
    Ok => 0
    Canceled => 1
    Unknown => 2
    InvalidArgument => 3
    DeadlineExceeded => 4
    NotFound => 5
    AlreadyExists => 6
    PermissionDenied => 7
    ResourceExhausted => 8
    FailedPrecondition => 9
    Aborted => 10
    OutOfRange => 11
    Unimplemented => 12
    Internal => 13
    Unavailable => 14
    DataLoss => 15
    Unauthenticated => 16
  }
}

/// The code of a `grpc-status` number; None above 16.
pub fn code_from(n: Int) -> Code? {
  let all = [Code.Ok, Code.Canceled, Code.Unknown, Code.InvalidArgument, Code.DeadlineExceeded,
    Code.NotFound, Code.AlreadyExists, Code.PermissionDenied, Code.ResourceExhausted,
    Code.FailedPrecondition, Code.Aborted, Code.OutOfRange, Code.Unimplemented, Code.Internal,
    Code.Unavailable, Code.DataLoss, Code.Unauthenticated]
  if n < 0 || n > 16 { None } else { Some(all[n]) }
}

/// Why a frame was refused.
pub enum FrameErr {
  Truncated
  BadFlag(flag: Int)
  TooLarge(len: Int)
} derive Display

/// One message frame: a flag byte (1 for a compressed payload), a 4 byte big endian length, the payload.
pub fn frame(payload: Bytes, compressed: Bool = false) -> Bytes {
  var b = BytesBuilder.with_capacity(5 + payload.len())
  b.write_byte(UInt8.wrapping_from(if compressed { 1 } else { 0 }))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 24) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 16) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 8) & 255))
  b.write_byte(UInt8.wrapping_from(payload.len() & 255))
  b.write(payload)
  b.freeze()
}

/// Reads the frame at `at`: (compressed, payload, next offset). A length above `max_len` is `TooLarge` (grpc-go's
/// default receive limit is 4 MiB).
pub fn unframe(data: Bytes, at: Int, max_len: Int = 4194304) -> (Bool, Bytes, Int) ! FrameErr {
  if at + 5 > data.len() {
    return Err(FrameErr.Truncated)
  }
  let flag = Int(data[at])
  if flag > 1 {
    return Err(FrameErr.BadFlag(flag: flag))
  }
  let n = (Int(data[at + 1]) << 24) | (Int(data[at + 2]) << 16) | (Int(data[at + 3]) << 8) | Int(data[at + 4])
  if n > max_len {
    return Err(FrameErr.TooLarge(len: n))
  }
  if at + 5 + n > data.len() {
    return Err(FrameErr.Truncated)
  }
  (flag == 1, data[at + 5..at + 5 + n], at + 5 + n)
}

/// The `grpc-timeout` header value for a duration in nanoseconds: at most 8 digits and the largest unit that keeps
/// it (`n`, `u`, `m`, `S`, `M`, `H`), as grpc-go's encodeTimeout.
pub fn encode_timeout(ns: Int) -> Str {
  if ns <= 0 {
    return "0n"
  }
  let units = [(1, "n"), (1000, "u"), (1000000, "m"), (1000000000, "S"), (60000000000, "M"), (3600000000000, "H")]
  var best = "0n"
  for (div, letter) in units {
    let v = (ns + div / 2) / div
    if v <= 99999999 {
      return "${v}${letter}"
    }
    best = "${v}${letter}"
  }
  best
}

/// The nanoseconds of a `grpc-timeout` value; None for a value that is not 1 to 8 digits and one unit letter.
pub fn decode_timeout(s: Str) -> Int? {
  let b = s.bytes()
  if b.len() < 2 || b.len() > 9 {
    return None
  }
  var v = 0
  var i = 0
  while i < b.len() - 1 {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + c - 48
    i += 1
  }
  match Int(b[b.len() - 1]) {
    110 => Some(v)
    117 => Some(v * 1000)
    109 => Some(v * 1000000)
    83 => Some(v * 1000000000)
    77 => Some(v * 60000000000)
    72 => Some(v * 3600000000000)
    _ => None
  }
}

/// `grpc-message` encoding: bytes outside 0x20 to 0x7e and `%` are written as `%XX` (upper case hex).
pub fn encode_message(s: Str) -> Str {
  encode_message_bytes(s.bytes())
}

/// `encode_message` of arbitrary bytes (a status message from another language need not be UTF-8).
pub fn encode_message_bytes(b: Bytes) -> Str {
  var out = BytesBuilder.with_capacity(b.len())
  let hex = "0123456789ABCDEF".bytes()
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c >= 32 && c <= 126 && c != 37 {
      out.write_byte(UInt8.wrapping_from(c))
    } else {
      out.write_byte(UInt8(37))
      out.write_byte(hex[c >> 4])
      out.write_byte(hex[c & 15])
    }
    i += 1
  }
  out.freeze().to_str_lossy()
}

/// The inverse; a malformed escape is kept as written (grpc-go), and bytes that are not UTF-8 become U+FFFD.
pub fn decode_message(s: Str) -> Str {
  decode_message_bytes(s).to_str_lossy()
}

/// The inverse as raw bytes, exactly what grpc-go's client reports.
pub fn decode_message_bytes(s: Str) -> Bytes {
  let bs = s.bytes()
  var out = BytesBuilder.with_capacity(bs.len())
  var i = 0
  while i < bs.len() {
    if bs[i] == UInt8(37) && i + 2 < bs.len() {
      let hi = hex_val(Int(bs[i + 1]))
      let lo = hex_val(Int(bs[i + 2]))
      if hi >= 0 && lo >= 0 {
        out.write_byte(UInt8.wrapping_from(hi * 16 + lo))
        i += 3
        continue
      }
    }
    out.write_byte(bs[i])
    i += 1
  }
  out.freeze()
}

/// A binary metadata value as grpc-go sends it: unpadded standard base64, for a name that ends in `-bin`.
pub fn bin_encode(data: Bytes) -> Str { base64.encode(data, base64.Base64.RawStd) }

/// The bytes of a `-bin` metadata value, padded or not (grpc-go accepts both); None when it is not base64.
pub fn bin_decode(value: Str) -> Bytes? {
  var v = value
  while v.ends_with("=") {
    v = v[0..v.len() - 1]
  }
  match base64.decode(v, base64.Base64.RawStd) {
    Ok(b) => Some(b)
    Err(_) => None
  }
}

/// A call's outcome that is not OK, the error of every call: the code, the status message and the raw
/// `grpc-status-details-bin` payload when the peer sent one.
pub struct Status {
  pub code: Code
  pub message: Str = ""
  pub details: Bytes = b""
}

/// Displays as `rpc error: code = NotFound desc = no such user` (grpc-go's text).
pub fn (s: Status) display() -> Str {
  "rpc error: code = ${s.code} desc = ${s.message}"
}

/// The call a handler is serving.
pub struct Call {
  /// the full method, `/package.Service/Method`
  pub method: Str
  /// the request metadata: lower case names, the pseudo and reserved names (`grpc-*`, `content-type`, `te`) left out
  pub metadata: Map[Str, Str]
  /// the deadline the client sent (`grpc-timeout`), None for no deadline
  pub timeout: Duration?
}

pub struct RecvState {
  pub buf: Bytes = b""
  pub at: Int = 0
  pub done: Bool = false
  /// the peer sends `grpc-encoding: gzip`: a message with the compressed flag is inflated
  pub gzip: Bool = false
}

/// The messages of a call's request stream, as a handler reads them.
pub struct Recv {
  pub body: http.BodyReader
  pub st: Mutex[RecvState]
  pub max: Int
}

/// The next message; None when the client has finished sending. A message above the receive limit is
/// `ResourceExhausted`, a cut stream or a bad frame `Internal`, a compressed message `Unimplemented`.
pub fn (r: Recv) next() -> Bytes? ! Status {
  let out = r.st.with(fn(var s) -> Result[Bytes?, Status] {
    match pull(s, r.max, fn() -> Bytes? ! Status {
      match r.body.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(status_new(Code.Canceled, "${e}"))
      }
    }) {
      Ok((msg, ns)) => {
        s = ns
        Ok(msg)
      }
      Err(e) => Err(e)
    }
  })
  out
}

/// The messages a handler sends back.
pub struct Send {
  pub w: http.BodyWriter
  /// the request came compressed with gzip: responses are too (grpc-go's rule)
  pub gzip: Bool = false
}

/// Sends one message (a frame is flushed at once).
pub fn (s: Send) send(msg: Bytes) -> () ! Status {
  match s.w.write(frame_msg(msg, s.gzip)) {
    Ok(_) => ()
    Err(e) => return Err(status_new(Code.Unavailable, "${e}"))
  }
  match s.w.flush() {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// A trailer sent after the last message, next to `grpc-status` and `grpc-message`.
pub fn (s: Send) set_trailer(name: Str, value: Str) {
  s.w.set_trailer(name, value)
}

/// A gRPC server: methods registered on it are served through `router()` by an HTTP/2 `http.Server`.
pub struct Server {
  pub routes: http.Router
  pub max_recv: Int
  pub methods: List[Str]
  pub clock: Clock
}

/// A server with grpc-go's 4 MiB receive limit. `clock` times the deadlines clients send: a handler still running at
/// its `grpc-timeout` is cancelled and the call ends with `DeadlineExceeded`.
pub fn server(clock: Clock) -> Server {
  Server{routes: http.router(), max_recv: 4194304, methods: [], clock: clock}
}

/// The server with another receive limit in bytes.
pub fn (s: Server) with_max_recv(n: Int) -> Server {
  Server{routes: s.routes, max_recv: n, methods: s.methods, clock: s.clock}
}

/// Registers a unary method (`/package.Service/Method`).
pub fn (var s: Server) unary[fx: Effects](method: Str, f: fn(Call, Bytes) -> Bytes ! Status uses fx) uses (fx, clock) {
  s.stream(method, fn(call, recv, send) -> () ! Status {
    let req = match recv.next()? {
      Some(m) => m
      None => return Err(status_new(Code.Internal, "grpc: client sent no request message"))
    }
    let resp = f(call, req)?
    send.send(resp)?
  })
}

/// Registers a method of any kind: a handler reads the request messages from `Recv` and writes the responses to
/// `Send`; returning Ok ends the call with OK, an error with its status.
pub fn (var s: Server) stream[fx: Effects](method: Str, f: fn(Call, Recv, Send) -> () ! Status uses fx) uses (fx, clock) {
  let max = s.max_recv
  let clock = s.clock
  s.methods.push(method)
  s.routes.handle_stream("POST ${method}", fn(req, body) -> http.Response {
    serve_call(f, clock, max, method, req, body)
  })
}

/// The routes to give `http.server`, with `http.Protocol.UnencryptedHttp2` (or TLS and ALPN h2) in its protocols.
pub fn (s: Server) router() -> http.Router {
  var r = s.routes
  let methods = s.methods
  r.not_found(fn(req) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") {
      return http.not_found()
    }
    let parts = req.path.split("/")
    let svc = if parts.len() > 1 { parts[1] } else { "" }
    var known = false
    for m in methods {
      if m.starts_with("/${svc}/") {
        known = true
      }
    }
    let name = if parts.len() > 2 { parts[2] } else { "" }
    trailers_only(status_new(Code.Unimplemented, if known { "unknown method ${name} for service ${svc}" } else { "unknown service ${svc}" }))
  })
  r
}

/// A gRPC client over an `http.Client`.
pub struct Client {
  pub http: http.Client
  pub base: Str
  /// requests are sent gzip compressed
  pub gzip: Bool = false
}

/// A client of `base` (`http://host:port`, plain HTTP/2 with prior knowledge, or `https://host:port`).
pub fn client(c: http.Client, base: Str) -> Client {
  let h = if base.starts_with("http://") { c.with_protocols(#{http.Protocol.UnencryptedHttp2}) } else { c }
  Client{http: h, base: base, gzip: false}
}

/// The client sending its messages gzip compressed (`grpc-encoding: gzip`); responses are read compressed or not.
pub fn (c: Client) with_gzip() -> Client {
  Client{http: c.http, base: c.base, gzip: true}
}

/// One unary call: the request message, the response message, or the call's status. `timeout` is sent as
/// `grpc-timeout` and bounds the call (DeadlineExceeded).
pub fn (c: Client) unary(method: Str, req: Bytes, metadata: Map[Str, Str] = {}, timeout: Duration? = None) -> Bytes ! Status uses net.dial {
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip), frame_msg(req, c.gzip))
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let st = match c.http.open(r) {
    Ok(s) => s
    Err(e) => return Err(from_client_err(e))
  }
  let data = match st.read_all() {
    Ok(b) => b
    Err(e) => {
      st.close()
      return Err(from_client_err(e))
    }
  }
  let fin = final_status(st)
  let enc = st.head().headers.get("Grpc-Encoding") ?? ""
  st.close()
  if fin.code != Code.Ok {
    return Err(fin)
  }
  match unframe(data, 0) {
    Ok((compressed, msg, _)) => {
      if compressed {
        if enc != "gzip" {
          return Err(status_new(Code.Internal, "grpc: compressed message received without a grpc-encoding"))
        }
        match compress.gunzip(msg, 4194305) {
          Ok(plain) => return Ok(plain)
          Err(_) => return Err(status_new(Code.Internal, "grpc: failed to decompress the received message"))
        }
      }
      Ok(msg)
    }
    Err(_) => Err(status_new(Code.Internal, "grpc: no response message"))
  }
}

/// The client side of a streaming call, valid inside `Client.call`.
pub struct ClientCall {
  pub w: http.PipeWriter
  pub head: Chan[(http.ClientStream?, Status?)]
  pub st: Mutex[CallState]
  pub max: Int
  /// messages are sent gzip compressed (Client.with_gzip)
  pub gzip: Bool = false
}

pub struct CallState {
  pub stream: http.ClientStream? = None
  pub failed: Status? = None
  pub recv: RecvState = RecvState{}
  pub final: Status? = None
}

/// Runs `f` on a streaming call: `f` sends with `send`, ends the request with `close_send` and reads with `recv`.
/// The call's status is the result of `recv` after the last message (an error when it is not OK).
pub fn (c: Client) call[R, fx: Effects](method: Str, metadata: Map[Str, Str], timeout: Duration?, f: fn(ClientCall) -> R ! Status uses fx) -> R ! Status uses (fx, net.dial) {
  let (pw, pr) = http.pipe()
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip)).with_body_reader(pr)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let head = Chan[(http.ClientStream?, Status?)].new(1)
  let cc = ClientCall{w: pw, head: head, st: Mutex[CallState].new(CallState{stream: None, failed: None, recv: RecvState{buf: b"", at: 0, done: false}, final: None}), max: 4194304, gzip: c.gzip}
  var result: R? = None
  var failure: Status? = None
  scope s {
    s.spawn(fn() {
      match c.http.open(r) {
        Ok(st) => head.send((Some(st), None))
        Err(e) => head.send((None, Some(from_client_err(e))))
      }
    })
    match f(cc) {
      Ok(v) => {
        result = Some(v)
      }
      Err(e) => {
        failure = Some(e)
      }
    }
    pw.close()
    // release the stream, also when f never read the call to its end
    var open_stream = cc.st.with(fn(var s) { s.stream })
    let consumed = cc.st.with(fn(var s) { s.failed.is_some() })
    if open_stream.is_none() && !consumed {
      match head.recv() {
        Some((Some(x), _)) => {
          open_stream = Some(x)
        }
        _ => {}
      }
    }
    if let Some(x) = open_stream {
      x.close()
    }
  }
  if let Some(e) = failure {
    return Err(e)
  }
  Ok(result ?? fault("grpc call produced no result"))
}

/// Sends one message.
pub fn (c: ClientCall) send(msg: Bytes) -> () ! Status {
  match c.w.write(frame_msg(msg, c.gzip)) {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// Ends the request stream.
pub fn (c: ClientCall) close_send() {
  c.w.close()
}

/// The next response message; None at the end of an OK call, the status as an error otherwise.
pub fn (c: ClientCall) recv() -> Bytes? ! Status uses net.dial {
  let out = c.st.with(fn(var s) -> Result[Bytes?, Status] uses net.dial {
    if let Some(e) = s.failed {
      return Err(e)
    }
    if let Some(fin) = s.final {
      return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
    }
    if s.stream.is_none() {
      match c.head.recv() {
        Some((Some(st), _)) => {
          s.stream = Some(st)
          s.recv = s.recv with {gzip: (st.head().headers.get("Grpc-Encoding") ?? "") == "gzip"}
        }
        Some((None, Some(e))) => {
          s.failed = Some(e)
          return Err(e)
        }
        _ => return Err(status_new(Code.Internal, "grpc: no response"))
      }
    }
    let stream = s.stream ?? fault("stream")
    let res = pull(s.recv, c.max, fn() -> Bytes? ! Status uses net.dial {
      match stream.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(from_client_err(e))
      }
    })
    match res {
      Ok((msg, ns)) => {
        s.recv = ns
        if msg.is_none() {
          let fin = final_status(stream)
          stream.close()
          s.final = Some(fin)
          return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
        }
        Ok(msg)
      }
      Err(e) => {
        s.failed = Some(e)
        Err(e)
      }
    }
  })
  out
}

/// The frame of msg, gzip compressed when gzip.
fn frame_msg(msg: Bytes, gzip: Bool) -> Bytes {
  if gzip {
    return frame(compress.gzip(msg), true)
  }
  frame(msg)
}

fn hex_val(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn status_new(code: Code, message: Str) -> Status {
  Status{code: code, message: message, details: b""}
}

fn reserved(name: Str) -> Bool {
  name.starts_with("grpc-") || name == "content-type" || name == "te"
}

fn finish(w: http.BodyWriter, st: Status) {
  w.set_trailer("grpc-status", "${st.code.number()}")
  if st.message != "" {
    w.set_trailer("grpc-message", encode_message(st.message))
  }
}

/// The next message of the stream whose buffered state is `st`, reading more with `more` (None at its end).
fn pull[fx: Effects](st: RecvState, max: Int, more: fn() -> Bytes? ! Status uses fx) -> (Bytes?, RecvState) ! Status uses fx {
  var s = st
  while true {
    match unframe(s.buf, s.at, max) {
      Ok((compressed, msg, next)) => {
        s.at = next
        if compressed {
          if !s.gzip {
            return Err(status_new(Code.Internal, "grpc: compressed message received without a grpc-encoding"))
          }
          match compress.gunzip(msg, max + 1) {
            Ok(plain) => {
              if plain.len() > max {
                return Err(status_new(Code.ResourceExhausted, "grpc: received message after decompression larger than max (${max})"))
              }
              return Ok((Some(plain), s))
            }
            Err(_) => return Err(status_new(Code.Internal, "grpc: failed to decompress the received message"))
          }
        }
        return Ok((Some(msg), s))
      }
      Err(FrameErr.TooLarge(len)) => {
        return Err(status_new(Code.ResourceExhausted, "grpc: received message larger than max (${len} vs. ${max})"))
      }
      Err(FrameErr.BadFlag(flag)) => {
        return Err(status_new(Code.Internal, "grpc: received message with invalid compression flag ${flag}"))
      }
      Err(FrameErr.Truncated) => {
        if s.done {
          if s.at == s.buf.len() {
            return Ok((None, s))
          }
          return Err(status_new(Code.Internal, "unexpected EOF"))
        }
        match more()? {
          Some(d) => {
            var b = BytesBuilder.with_capacity(s.buf.len() - s.at + d.len())
            b.write(s.buf[s.at..])
            b.write(d)
            s.buf = b.freeze()
            s.at = 0
          }
          None => {
            s.done = true
          }
        }
      }
    }
  }
  Ok((None, s))
}

fn trailers_only(st: Status) -> http.Response {
  http.stream(200, fn(w) -> () ! IoErr {
    finish(w, st)
  }).with_header("content-type", "application/grpc")
}

fn serve_call[fx: Effects](f: fn(Call, Recv, Send) -> () ! Status uses fx, clock: Clock, max: Int, method: Str, req: http.Request, body: http.BodyReader) -> http.Response uses (fx, clock) {
  let ct = req.header("content-type") ?? ""
  if !ct.starts_with("application/grpc") {
    return http.empty(415)
  }
  let gz = (req.header("grpc-encoding") ?? "") == "gzip"
  var timeout: Duration? = None
  if let Some(t) = req.header("grpc-timeout") {
    match decode_timeout(t) {
      Some(ns) => {
        timeout = Some(Duration.from_nanos(ns))
      }
      None => return trailers_only(status_new(Code.Internal, "malformed grpc-timeout"))
    }
  }
  var md: Map[Str, Str] = {}
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if !reserved(lk) {
      md[lk] = v
    }
  }
  let call = Call{method: method, metadata: md, timeout: timeout}
  let recv = Recv{body: body, st: Mutex[RecvState].new(RecvState{buf: b"", at: 0, done: false, gzip: (req.header("grpc-encoding") ?? "") == "gzip"}), max: max}
  http.stream(200, fn(w) -> () ! IoErr {
    let send = Send{w: w, gzip: gz}
    let st = match timeout {
      Some(d) => match task.with_timeout(clock, d, fn() -> () ! Status { f(call, recv, send) }) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(task.Timed.TimedOut) => status_new(Code.DeadlineExceeded, "context deadline exceeded")
        Err(task.Timed.Failed(e)) => e
      }
      None => match f(call, recv, send) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(e) => e
      }
    }
    finish(w, st)
  }).with_header("content-type", "application/grpc").with_header("grpc-accept-encoding", "gzip,identity").with_header("grpc-encoding", if gz { "gzip" } else { "identity" }).with_full_duplex()
}

fn from_client_err(e: http.ClientErr) -> Status {
  match e {
    Timeout => status_new(Code.DeadlineExceeded, "context deadline exceeded")
    Canceled => status_new(Code.Canceled, "context canceled")
    Connect(msg) => status_new(Code.Unavailable, "connection error: ${msg}")
    Protocol(msg) => status_new(Code.Internal, msg)
    InvalidUrl(msg) => status_new(Code.Internal, "invalid URL: ${msg}")
  }
}

fn call_headers(metadata: Map[Str, Str], timeout: Duration?, gzip: Bool) -> Map[Str, Str] {
  var h: Map[Str, Str] = {}
  for (k, v) in metadata {
    h[k.to_lower()] = v
  }
  h["content-type"] = "application/grpc"
  h["te"] = "trailers"
  h["grpc-accept-encoding"] = "gzip,identity"
  if gzip {
    h["grpc-encoding"] = "gzip"
  }
  h["user-agent"] = "grpc-xo/0.1"
  if let Some(d) = timeout {
    h["grpc-timeout"] = encode_timeout(d.nanos())
  }
  h
}

fn http_to_code(status: Int) -> Code {
  if status == 400 {
    Code.Internal
  } else if status == 401 {
    Code.Unauthenticated
  } else if status == 403 {
    Code.PermissionDenied
  } else if status == 404 {
    Code.Unimplemented
  } else if status == 429 || status == 502 || status == 503 || status == 504 {
    Code.Unavailable
  } else {
    Code.Unknown
  }
}

/// The call's status from a finished stream: its trailers, or the head of a trailers only response.
fn final_status(st: http.ClientStream) -> Status {
  let head = st.head()
  if head.status != 200 {
    return status_new(http_to_code(head.status), "unexpected HTTP status code received from server: ${head.status}")
  }
  let tr = st.trailers()
  let gs = tr.get("Grpc-Status") ?? (head.headers.get("Grpc-Status") ?? "")
  if gs == "" {
    return status_new(Code.Internal, "server closed the stream without sending trailers")
  }
  let n = Int.parse(gs) ?? -1
  let code = code_from(n) ?? Code.Unknown
  let msg = tr.get("Grpc-Message") ?? (head.headers.get("Grpc-Message") ?? "")
  Status{code: code, message: decode_message(msg), details: b""}
}
