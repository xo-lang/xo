// std/grpc (decision 0535): gRPC over std/http's HTTP/2. This file is the pure layer: the message frame, the
// grpc-timeout header, the status codes and the grpc-message percent encoding, as grpc-go does them.
// The pure layer is pure; the server and the client use std/http.
//
// std/grpc: the pure layer (decision 0535), after grpc-go's rpc_util.go (frame, timeout) and status (message encoding).

use std/base64
use std/compress
use std/http
use std/task
use std/json
use std/x509

/// The 17 canonical status codes (their numbers are the wire values of `grpc-status`).
pub enum Code {
  Ok
  Canceled
  Unknown
  InvalidArgument
  DeadlineExceeded
  NotFound
  AlreadyExists
  PermissionDenied
  ResourceExhausted
  FailedPrecondition
  Aborted
  OutOfRange
  Unimplemented
  Internal
  Unavailable
  DataLoss
  Unauthenticated
} derive Display

/// The wire number of a code (OK is 0, UNAUTHENTICATED is 16).
pub fn (c: Code) number() -> Int {
  match c {
    Ok => 0
    Canceled => 1
    Unknown => 2
    InvalidArgument => 3
    DeadlineExceeded => 4
    NotFound => 5
    AlreadyExists => 6
    PermissionDenied => 7
    ResourceExhausted => 8
    FailedPrecondition => 9
    Aborted => 10
    OutOfRange => 11
    Unimplemented => 12
    Internal => 13
    Unavailable => 14
    DataLoss => 15
    Unauthenticated => 16
  }
}

/// The code of a `grpc-status` number; None above 16.
pub fn code_from(n: Int) -> Code? {
  let all = [Code.Ok, Code.Canceled, Code.Unknown, Code.InvalidArgument, Code.DeadlineExceeded,
    Code.NotFound, Code.AlreadyExists, Code.PermissionDenied, Code.ResourceExhausted,
    Code.FailedPrecondition, Code.Aborted, Code.OutOfRange, Code.Unimplemented, Code.Internal,
    Code.Unavailable, Code.DataLoss, Code.Unauthenticated]
  if n < 0 || n > 16 { None } else { Some(all[n]) }
}

/// Why a frame was refused.
pub open enum FrameErr {
  Truncated
  BadFlag(flag: Int)
  TooLarge(len: Int)
} derive Display

/// One message frame: a flag byte (1 for a compressed payload), a 4 byte big endian length, the payload.
pub fn frame(payload: Bytes, compressed: Bool = false) -> Bytes {
  var b = BytesBuilder.with_capacity(5 + payload.len())
  b.write_byte(UInt8.wrapping_from(if compressed { 1 } else { 0 }))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 24) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 16) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 8) & 255))
  b.write_byte(UInt8.wrapping_from(payload.len() & 255))
  b.write(payload)
  b.freeze()
}

/// Reads the frame at `at`: (compressed, payload, next offset). A length above `max_len` is `TooLarge` (grpc-go's
/// default receive limit is 4 MiB).
pub fn unframe(data: Bytes, at: Int, max_len: Int = 4194304) -> (Bool, Bytes, Int) ! FrameErr {
  if at + 5 > data.len() {
    return Err(FrameErr.Truncated)
  }
  let flag = Int(data[at])
  let n = (Int(data[at + 1]) << 24) | (Int(data[at + 2]) << 16) | (Int(data[at + 3]) << 8) | Int(data[at + 4])
  // the length, then the whole payload, then the flag, as grpc-go's recvMsg and checkRecvPayload (TestGrpcFuzz,
  // task #115)
  if n > max_len {
    return Err(FrameErr.TooLarge(len: n))
  }
  if at + 5 + n > data.len() {
    return Err(FrameErr.Truncated)
  }
  if flag > 1 {
    return Err(FrameErr.BadFlag(flag: flag))
  }
  (flag == 1, data[at + 5..at + 5 + n], at + 5 + n)
}

/// The `grpc-timeout` header value for a duration in nanoseconds: at most 8 digits and the largest unit that keeps
/// it (`n`, `u`, `m`, `S`, `M`, `H`), as grpc-go's encodeTimeout.
pub fn encode_timeout(ns: Int) -> Str {
  if ns <= 0 {
    return "0n"
  }
  let units = [(1, "n"), (1000, "u"), (1000000, "m"), (1000000000, "S"), (60000000000, "M"), (3600000000000, "H")]
  var best = "0n"
  for (div, letter) in units {
    let v = (ns + div / 2) / div
    if v <= 99999999 {
      return "${v}${letter}"
    }
    best = "${v}${letter}"
  }
  best
}

/// The nanoseconds of a `grpc-timeout` value; None for a value that is not 1 to 8 digits and one unit letter.
pub fn decode_timeout(s: Str) -> Int? {
  let b = s.bytes()
  if b.len() < 2 || b.len() > 9 {
    return None
  }
  var v = 0
  var i = 0
  while i < b.len() - 1 {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + c - 48
    i += 1
  }
  match Int(b[b.len() - 1]) {
    110 => Some(v)
    117 => Some(v * 1000)
    109 => Some(v * 1000000)
    83 => Some(v * 1000000000)
    77 => Some(v * 60000000000)
    72 => Some(v * 3600000000000)
    _ => None
  }
}

/// `grpc-message` encoding: bytes outside 0x20 to 0x7e and `%` are written as `%XX` (upper case hex).
pub fn encode_message(s: Str) -> Str {
  encode_message_bytes(s.bytes())
}

/// `encode_message` of arbitrary bytes (a status message from another language need not be UTF-8).
pub fn encode_message_bytes(b: Bytes) -> Str {
  var out = BytesBuilder.with_capacity(b.len())
  let hex = "0123456789ABCDEF".bytes()
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c >= 32 && c <= 126 && c != 37 {
      out.write_byte(UInt8.wrapping_from(c))
    } else {
      out.write_byte(UInt8(37))
      out.write_byte(hex[c >> 4])
      out.write_byte(hex[c & 15])
    }
    i += 1
  }
  out.freeze().to_str_lossy()
}

/// The inverse; a malformed escape is kept as written (grpc-go), and bytes that are not UTF-8 become U+FFFD.
pub fn decode_message(s: Str) -> Str {
  decode_message_bytes(s).to_str_lossy()
}

/// The inverse as raw bytes, exactly what grpc-go's client reports.
pub fn decode_message_bytes(s: Str) -> Bytes {
  let bs = s.bytes()
  var out = BytesBuilder.with_capacity(bs.len())
  var i = 0
  while i < bs.len() {
    if bs[i] == UInt8(37) && i + 2 < bs.len() {
      let hi = hex_val(Int(bs[i + 1]))
      let lo = hex_val(Int(bs[i + 2]))
      if hi >= 0 && lo >= 0 {
        out.write_byte(UInt8.wrapping_from(hi * 16 + lo))
        i += 3
        continue
      }
    }
    out.write_byte(bs[i])
    i += 1
  }
  out.freeze()
}

/// A binary metadata value as grpc-go sends it: unpadded standard base64, for a name that ends in `-bin`.
pub fn bin_encode(data: Bytes) -> Str { base64.encode(data, base64.Base64.RawStd) }

/// The bytes of a `-bin` metadata value, padded or not (grpc-go accepts both); None when it is not base64.
pub fn bin_decode(value: Str) -> Bytes? {
  var v = value
  while v.ends_with("=") {
    v = v[0..v.len() - 1]
  }
  match base64.decode(v, base64.Base64.RawStd) {
    Ok(b) => Some(b)
    Err(_) => None
  }
}

/// A call's outcome that is not OK, the error of every call: the code, the status message and the raw
/// `grpc-status-details-bin` payload when the peer sent one.
pub struct Status {
  pub code: Code
  pub message: Str = ""
  pub details: Bytes = b""
}

/// Displays as `rpc error: code = NotFound desc = no such user` (grpc-go's text).
pub fn (s: Status) display() -> Str {
  "rpc error: code = ${s.code} desc = ${s.message}"
}

/// The call a handler is serving.
pub struct Call {
  /// the full method, `/package.Service/Method`
  pub method: Str
  /// the request metadata: lower case names, the pseudo and reserved names (`grpc-*`, `content-type`, `te`) left out
  pub metadata: Map[Str, Str]
  /// the deadline the client sent (`grpc-timeout`), None for no deadline
  pub timeout: Duration?
  /// the method's kind as registered (grpc-go's StreamServerInfo): a unary method has neither
  pub client_stream: Bool = true
  pub server_stream: Bool = true
  /// the client's IP address (grpc-go's peer.Peer Addr, which also has the port; std/http's Request keeps none)
  pub peer: Str = ""
  /// the compressors the client accepts (grpc-go's ClientSupportedCompressors: its grpc-accept-encoding)
  pub accept_encodings: List[Str] = []
  /// the connection's security (grpc-go's peer AuthInfo): "tls" with the TLS state, or "insecure"
  pub auth_info: AuthInfo = insecure_info()
  /// the request's `:authority` (the Host header over HTTP/1.1; grpc-go's ":authority" metadata)
  pub authority: Str = ""
}

/// A connection's protection (grpc-go's credentials.SecurityLevel), ordered: a level below another is weaker.
pub enum SecurityLevel {
  /// no level known: check_security_level accepts it (grpc-go keeps it for old credentials)
  InvalidSecurityLevel
  NoSecurity
  IntegrityOnly
  PrivacyAndIntegrity
}

/// The level's number (0 to 3), its order.
pub fn (l: SecurityLevel) number() -> Int {
  match l {
    InvalidSecurityLevel => 0
    NoSecurity => 1
    IntegrityOnly => 2
    PrivacyAndIntegrity => 3
  }
}

/// grpc-go's String: `NoSecurity`, `IntegrityOnly`, `PrivacyAndIntegrity`, `invalid SecurityLevel: 0`.
pub fn (l: SecurityLevel) display() -> Str {
  match l {
    InvalidSecurityLevel => "invalid SecurityLevel: 0"
    NoSecurity => "NoSecurity"
    IntegrityOnly => "IntegrityOnly"
    PrivacyAndIntegrity => "PrivacyAndIntegrity"
  }
}

/// A connection's security as grpc-go's credentials.AuthInfo: `auth_type` "tls" (credentials.TLSInfo, its state
/// in `tls`) or "insecure"; `level` is its CommonAuthInfo.SecurityLevel.
pub struct AuthInfo {
  pub auth_type: Str
  pub level: SecurityLevel
  /// the TLS connection's state; None over cleartext, and on the client (std/http keeps it)
  pub tls: http.TlsState? = None
}

/// The AuthInfo of a cleartext connection (grpc-go's insecure credentials).
pub fn insecure_info() -> AuthInfo {
  AuthInfo{auth_type: "insecure", level: SecurityLevel.NoSecurity, tls: None}
}

/// The AuthInfo of a TLS connection (grpc-go's TLSInfo: PrivacyAndIntegrity).
pub fn tls_info(state: http.TlsState?) -> AuthInfo {
  AuthInfo{auth_type: "tls", level: SecurityLevel.PrivacyAndIntegrity, tls: state}
}

/// Whether the connection may carry a call whose `:authority` is authority (grpc-go's AuthorityValidator, TLSInfo's
/// and insecure's ValidateAuthority): over TLS one of the server's certificates must cover its host (x509's
/// VerifyHostname, the port left out), else Err "credentials: invalid authority \"A\": " and the certificates'
/// errors (`<nil>` for a "tls" AuthInfo without certificates); without TLS any authority is valid.
pub fn (a: AuthInfo) validate_authority(authority: Str) -> () ! Str {
  if a.auth_type != "tls" {
    return Ok(())
  }
  validate_certs(match a.tls {
    Some(t) => t.peer_certificates
    None => []
  }, authority)
}

fn validate_certs(certs: List[x509.Certificate], authority: Str) -> () ! Str {
  let host = authority_host(authority)
  var errs: List[Str] = []
  for cert in certs {
    match cert.verify_hostname(host) {
      Ok(_) => return Ok(())
      Err(e) => errs.push("${e}")
    }
  }
  // errors.Join of none is nil, printed "<nil>"
  Err("credentials: invalid authority ${go_quote(authority)}: ${if errs.is_empty() { "<nil>" } else { errs.join("\n") }}")
}

/// authority's host: net.SplitHostPort's, the whole authority when it has no port (or is not host:port).
fn authority_host(authority: Str) -> Str {
  if authority.starts_with("[") {
    if let Some((h, rest)) = authority[1..].cut("]") {
      if rest.starts_with(":") && !rest[1..].contains(":") {
        return h
      }
    }
    return authority
  }
  match authority.cut(":") {
    Some((h, port)) => if port.contains(":") { authority } else { h }
    None => authority
  }
}

/// Whether ai meets level (grpc-go's credentials.CheckSecurityLevel): Err "AuthInfo is nil" for None, Ok for an
/// InvalidSecurityLevel connection, else Err "requires SecurityLevel L; connection has M" when weaker.
pub fn check_security_level(ai: AuthInfo?, level: SecurityLevel) -> () ! Str {
  let a = match ai {
    Some(a) => a
    None => return Err("AuthInfo is nil")
  }
  if a.level == SecurityLevel.InvalidSecurityLevel || a.level.number() >= level.number() {
    return Ok(())
  }
  Err("requires SecurityLevel ${level.display()}; connection has ${a.level.display()}")
}

/// What per-RPC credentials see of a call (grpc-go's credentials.RequestInfo and GetRequestMetadata's uri).
pub struct RequestInfo {
  /// the full method, `/package.Service/Method`
  pub method: Str
  /// `https://host/package.Service`, the port left out when it is 443 (grpc-go's audience)
  pub audience: Str
  /// the connection's security
  pub auth_info: AuthInfo
}

/// Per-RPC credentials (grpc-go's credentials.PerRPCCredentials): `metadata` gives the metadata each call
/// carries (GetRequestMetadata; names made lower case), and `require_tls` refuses a cleartext connection
/// (RequireTransportSecurity). The function may read shared state (`sync`: a token in a Mutex that another
/// task refreshes) but performs no other effect.
pub struct PerRpcCreds {
  pub metadata: fn(RequestInfo) -> Map[Str, Str] ! Status uses sync
  pub require_tls: Bool = true
}

/// f with its effects counted at this call, as a function whose type has none: interceptors and handlers are stored
/// that way (decision 0703, as http's middleware). std/native/grpc_native.xo on the native backends, std/rt/grpc.go on
/// the Go backend.
fn pure1[A, R, fx: Effects](f: fn(A) -> R uses fx) -> (fn(A) -> R) uses fx

/// The rest of a stream interceptor's chain: the next interceptor or the method's handler (decision 0703). Like
/// `http.Next`, it has no effects in its type: they were counted where the interceptors and handlers were registered.
pub type StreamNext = fn(Call, Recv, Send) -> () ! Status

/// The rest of a unary interceptor's chain: the next unary interceptor or the method's handler.
pub type UnaryNext = fn(Call, Bytes) -> Bytes ! Status

/// A server's interceptors, shared by every copy of the Server so that they reach methods registered before them.
pub struct Interceptors {
  pub stream: List[fn(Call, Recv, Send, StreamNext) -> () ! Status] = []
  pub unary: List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status] = []
}

/// The stream interceptors from the i-th on, around h.
fn run_stream(ics: List[fn(Call, Recv, Send, StreamNext) -> () ! Status], i: Int, call: Call, recv: Recv, send: Send, h: StreamNext) -> () ! Status {
  if i == ics.len() {
    return h(call, recv, send)
  }
  ics[i](call, recv, send, fn(c, r, sd) -> () ! Status { run_stream(ics, i + 1, c, r, sd, h) })
}

/// The unary interceptors from the i-th on, around h.
fn run_unary(ics: List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status], i: Int, call: Call, req: Bytes, h: UnaryNext) -> Bytes ! Status {
  if i == ics.len() {
    return h(call, req)
  }
  ics[i](call, req, fn(c, m) -> Bytes ! Status { run_unary(ics, i + 1, c, m, h) })
}

pub struct RecvState {
  pub buf: Bytes = b""
  pub at: Int = 0
  pub done: Bool = false
  /// the peer sends `grpc-encoding: gzip`: a message with the compressed flag is inflated
  pub gzip: Bool = false
}

/// The messages of a call's request stream, as a handler reads them.
pub struct Recv {
  pub body: http.BodyReader
  pub st: Mutex[RecvState]
  pub max: Int
}

/// The next message; None when the client has finished sending. A message above the receive limit is
/// `ResourceExhausted`, a cut stream or a bad frame `Internal`, a compressed message `Unimplemented`.
pub fn (r: Recv) next() -> Bytes? ! Status {
  let out = r.st.with(fn(var s) -> Result[Bytes?, Status] {
    match pull(s, r.max, fn() -> Bytes? ! Status {
      match r.body.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(status_new(Code.Canceled, "${e}"))
      }
    }) {
      Ok((msg, ns)) => {
        s = ns
        Ok(msg)
      }
      Err(e) => Err(e)
    }
  })
  out
}

/// The messages a handler sends back.
pub struct Send {
  pub w: http.BodyWriter
  /// the request came compressed with gzip: responses are too (grpc-go's rule)
  pub gzip: Bool = false
  /// the server's send limit (Server.with_max_send)
  pub max_send: Int = 2147483647
  /// whether the response head went out (grpc-go's isHeaderSent): send_header, or the first message
  pub head_sent: Mutex[Bool] = Mutex.new(false)
  /// set_compressor's choice ("" for none: the request's encoding)
  pub enc: Mutex[Str] = Mutex.new("")
  /// the client's grpc-accept-encoding
  pub accept: List[Str] = []
}

/// Whether this call's responses go gzip compressed: set_compressor's choice, else the request's encoding.
fn (s: Send) compressing() -> Bool {
  let e = s.enc.with(fn(var x) -> Str { x })
  if e.is_empty() { s.gzip } else { e == "gzip" }
}

/// grpc-go's SetSendCompressor: the responses go compressed with name ("gzip", or "identity" for none) instead of
/// the request's encoding. Before the head goes out only; a name std/grpc has no compressor for, or one the
/// client did not list in grpc-accept-encoding (Call.accept_encodings), is refused with grpc-go's texts.
pub fn (s: Send) set_compressor(name: Str) -> () ! Status {
  if name != "identity" {
    if name != "gzip" {
      return Err(status_new(Code.Internal, "compressor not registered \"${name}\""))
    }
    if !s.accept.contains(name) {
      return Err(status_new(Code.Internal, "client does not support compressor \"${name}\""))
    }
  }
  let ok = s.head_sent.with(fn(var sent) -> Bool {
    !sent && s.w.set_header("grpc-encoding", name)
  })
  if !ok {
    return Err(status_new(Code.Internal, "transport: set send compressor called after headers sent or stream done"))
  }
  s.enc.with(fn(var x) { x = name })
  Ok(())
}

/// grpc-go's ErrIllegalHeaderWrite: header metadata after the head went out.
fn illegal_header() -> Status { status_new(Code.Internal, "transport: SendHeader called multiple times") }

/// Adds header metadata to the response head (grpc-go's grpc.SetHeader): sent with the first message, at
/// `send_header`, or with the status; Internal "transport: SendHeader called multiple times" once the head went out.
/// The name is made lower case; a `-bin` value is sent as given (encode it with `bin_encode`).
pub fn (s: Send) set_header(name: Str, value: Str) -> () ! Status {
  let ok = s.head_sent.with(fn(var sent) -> Bool {
    !sent && s.w.set_header(name.to_lower(), value)
  })
  if !ok {
    return Err(illegal_header())
  }
}

/// Sends the response head now with md added (grpc-go's grpc.SendHeader); a second call, or one after a message,
/// is Internal "transport: SendHeader called multiple times".
pub fn (s: Send) send_header(md: Map[Str, Str] = {}) -> () ! Status {
  let ok = s.head_sent.with(fn(var sent) -> Bool {
    if sent {
      return false
    }
    for (k, v) in md {
      if !s.w.set_header(k.to_lower(), v) {
        return false
      }
    }
    sent = true
    true
  })
  if !ok {
    return Err(illegal_header())
  }
  match s.w.flush() {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// Sends one message (a frame is flushed at once).
pub fn (s: Send) send(msg: Bytes) -> () ! Status {
  send_framed(s, frame_msg(msg, s.compressing()), "")
}

/// Writes frame f; one above the send limit is ResourceExhausted with grpc-go's text, which a unary method's
/// response prefixes with "grpc: " (server.go sendResponse) and a stream's does not (serverStream.SendMsg).
fn send_framed(s: Send, f: Bytes, prefix: Str) -> () ! Status {
  if f.len() - 5 > s.max_send {
    return Err(status_new(Code.ResourceExhausted, "${prefix}trying to send message larger than max (${f.len() - 5} vs. ${s.max_send})"))
  }
  s.head_sent.with(fn(var sent) { sent = true })
  match s.w.write(f) {
    Ok(_) => ()
    Err(e) => return Err(status_new(Code.Unavailable, "${e}"))
  }
  match s.w.flush() {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// A trailer sent after the last message, next to `grpc-status` and `grpc-message`.
pub fn (s: Send) set_trailer(name: Str, value: Str) {
  s.w.set_trailer(name, value)
}

/// A gRPC server: methods registered on it are served through `router()` by an HTTP/2 `http.Server`.
pub struct Server {
  pub routes: http.Router
  pub max_recv: Int
  pub methods: List[Str]
  pub clock: Clock[clock]
  /// the largest message a handler may send (grpc-go's MaxSendMsgSize; math.MaxInt32 by default)
  pub max_send: Int = 2147483647
  /// each registered method's kind, in registration order (services)
  pub infos: List[MethodInfo] = []
  /// unknown registered a handler for methods no route has (router keeps it)
  pub has_unknown: Bool = false
  /// intercept's and intercept_unary's functions, in registration order
  pub icpt: Mutex[Interceptors] = Mutex[Interceptors].new(Interceptors{})
}

/// grpc-go's StreamInterceptor and ChainStreamInterceptor (decision 0703): f runs around every method's handler,
/// unary methods and `unknown`'s included, registered before or after it; it calls `next` to go on, with the call,
/// Recv and Send as they came or replaced, or returns without it. Several run in registration order, the first
/// outermost. f's effects are counted here, as `http.Router.wrap`'s.
pub fn (var s: Server) intercept[fx: Effects](f: fn(Call, Recv, Send, StreamNext) -> () ! Status uses fx) uses fx {
  let g = pure1(fn(a: (Call, Recv, Send, StreamNext)) -> Result[(), Status] { f(a.0, a.1, a.2, a.3) })
  s.icpt.with(fn(var ic: Interceptors) {
    ic.stream.push(fn(c, r, sd, n) -> () ! Status { g((c, r, sd, n)) })
  })
}

/// grpc-go's UnaryInterceptor and ChainUnaryInterceptor: f runs around every unary method's handler with its request
/// message, inside the stream interceptors (grpc-go runs one kind or the other for a method; here a stream
/// interceptor sees unary calls too). Several run in registration order, the first outermost.
pub fn (var s: Server) intercept_unary[fx: Effects](f: fn(Call, Bytes, UnaryNext) -> Bytes ! Status uses fx) uses fx {
  let g = pure1(fn(a: (Call, Bytes, UnaryNext)) -> Result[Bytes, Status] { f(a.0, a.1, a.2) })
  s.icpt.with(fn(var ic: Interceptors) {
    ic.unary.push(fn(c, m, n) -> Bytes ! Status { g((c, m, n)) })
  })
}

/// A registered method as grpc-go's MethodInfo: its name within the service (`Method` of
/// `/package.Service/Method`) and whether the client and the server send streams.
pub struct MethodInfo {
  pub name: Str
  pub client_stream: Bool
  pub server_stream: Bool
}

/// A registered service as grpc-go's ServiceInfo: its full name (`package.Service`) and its methods in
/// registration order.
pub struct ServiceInfo {
  pub name: Str
  pub methods: List[MethodInfo]
}

/// grpc-go's Server.GetServiceInfo: every service with a registered method, by name.
pub fn (s: Server) services() -> List[ServiceInfo] {
  var names: List[Str] = []
  var by: Map[Str, List[MethodInfo]] = {}
  for i in 0..s.methods.len() {
    let full = s.methods[i]
    let at = full[1..].find("/") ?? (full.len() - 1)
    let svc = full[1..at + 1]
    if !by.contains(svc) {
      names.push(svc)
      by[svc] = []
    }
    var ms = by.get(svc) ?? []
    ms.push(s.infos[i] with {name: full[at + 2..]})
    by[svc] = ms
  }
  names = names.sort()
  var out: List[ServiceInfo] = []
  for n in names {
    out.push(ServiceInfo{name: n, methods: by.get(n) ?? []})
  }
  out
}

/// A server with grpc-go's 4 MiB receive limit. `clock` times the deadlines clients send: a handler still running at
/// its `grpc-timeout` is cancelled and the call ends with `DeadlineExceeded`.
pub fn server(clock: Clock[clock]) -> Server {
  Server{routes: http.router(), max_recv: 4194304, methods: [], clock: clock}
}

/// The server with another receive limit in bytes.
pub fn (s: Server) with_max_recv(n: Int) -> Server {
  s with {max_recv: n}
}

/// The server with a send limit in bytes: a larger message is `ResourceExhausted` from `Send.send` (grpc-go's
/// MaxSendMsgSize, "grpc: trying to send message larger than max"). Set it before registering methods.
pub fn (s: Server) with_max_send(n: Int) -> Server {
  s with {max_send: n}
}

/// Registers a unary method (`/package.Service/Method`).
pub fn (var s: Server) unary[fx: Effects](method: Str, f: fn(Call, Bytes) -> Bytes ! Status uses fx) uses (fx, clock) {
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Bytes)) -> Result[Bytes, Status] { f(a.0, a.1) })
  let h: UnaryNext = fn(c, m) -> Bytes ! Status { g((c, m)) }
  s.stream(method, fn(call, recv, send) -> () ! Status {
    let req = match recv.next()? {
      Some(m) => m
      None => return Err(status_new(Code.Internal, "grpc: client sent no request message"))
    }
    let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status] { ic.unary })
    let resp = if ics.is_empty() { f(call, req)? } else { run_unary(ics, 0, call, req, h)? }
    send_framed(send, frame_msg(resp, send.compressing()), "grpc: ")?
  }, client_stream: false, server_stream: false)
}

/// Registers a method of any kind: a handler reads the request messages from `Recv` and writes the responses to
/// `Send`; returning Ok ends the call with OK, an error with its status. client_stream and server_stream are the
/// method's kind as `services` lists it (grpc-go's StreamDesc), a bidirectional stream by default.
pub fn (var s: Server) stream[fx: Effects](method: Str, f: fn(Call, Recv, Send) -> () ! Status uses fx, client_stream: Bool = true, server_stream: Bool = true) uses (fx, clock) {
  let max = s.max_recv
  let max_send = s.max_send
  let clock = s.clock
  s.methods.push(method)
  s.infos.push(MethodInfo{name: method, client_stream: client_stream, server_stream: server_stream})
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Recv, Send)) -> Result[(), Status] { f(a.0, a.1, a.2) })
  let h: StreamNext = fn(c, r, sd) -> () ! Status { g((c, r, sd)) }
  s.routes.handle_stream("POST ${method}", fn(req, body) -> http.Response {
    serve_call(fn(call, recv, send) -> () ! Status {
      let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Recv, Send, StreamNext) -> () ! Status] { ic.stream })
      run_stream(ics, 0, call with {client_stream: client_stream, server_stream: server_stream}, recv, send, h)
    }, clock, max, max_send, method, req, body)
  })
}

/// grpc-go's UnknownServiceHandler: f serves every call to a method no service registered (an unknown service, or
/// an unknown method of a known one), as a stream method; `Call.method` is the method the client asked for. Without
/// it such a call is `Unimplemented`.
pub fn (var s: Server) unknown[fx: Effects](f: fn(Call, Recv, Send) -> () ! Status uses fx) uses (fx, clock) {
  let max = s.max_recv
  let max_send = s.max_send
  let clock = s.clock
  s.has_unknown = true
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Recv, Send)) -> Result[(), Status] { f(a.0, a.1, a.2) })
  let h: StreamNext = fn(c, r, sd) -> () ! Status { g((c, r, sd)) }
  // a route for every path, so the request body streams as a registered method's does; the methods'
  // own routes are more specific and win
  s.routes.handle_stream("/{path...}", fn(req, body) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") || req.method != "POST" {
      return http.not_found()
    }
    serve_call(fn(call, recv, send) -> () ! Status {
      let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Recv, Send, StreamNext) -> () ! Status] { ic.stream })
      run_stream(ics, 0, call, recv, send, h)
    }, clock, max, max_send, req.path, req, body)
  })
}

/// The routes to give `http.server`, with `http.Protocol.UnencryptedHttp2` (or TLS and ALPN h2) in its protocols.
pub fn (s: Server) router() -> http.Router {
  var r = s.routes
  if s.has_unknown {
    return r
  }
  let methods = s.methods
  r.not_found(fn(req) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") {
      return http.not_found()
    }
    let parts = req.path.split("/")
    let svc = if parts.len() > 1 { parts[1] } else { "" }
    var known = false
    for m in methods {
      if m.starts_with("/${svc}/") {
        known = true
      }
    }
    let name = if parts.len() > 2 { parts[2] } else { "" }
    trailers_only(status_new(Code.Unimplemented, if known { "unknown method ${name} for service ${svc}" } else { "unknown service ${svc}" }))
  })
  r
}

/// A gRPC client over an `http.Client`.
pub struct Client {
  pub http: http.Client
  pub base: Str
  /// requests are sent gzip compressed
  pub gzip: Bool = false
  /// the largest response message (grpc-go's MaxCallRecvMsgSize, 4 MiB by default)
  pub max_recv: Int = 4194304
  /// the largest request message (grpc-go's MaxCallSendMsgSize, math.MaxInt32 by default)
  pub max_send: Int = 2147483647
  /// with_unary_interceptor's and with_stream_interceptor's functions, in registration order
  pub unary_icpt: List[fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status] = []
  pub stream_icpt: List[fn(Str, CallOpts) -> CallOpts ! Status] = []
  /// with_default_metadata and with_default_timeout (grpc-go's WithDefaultCallOptions)
  pub default_md: Map[Str, Str] = {}
  pub default_timeout: Duration? = None
  /// with_on_finish's functions
  pub on_finish: List[fn(Str, Status?) -> ()] = []
  /// the target as given to client (Client.target)
  pub target: Str = ""
  /// decision 0707: with_balancer's policy, and the addresses calls are spread over (with_addrs, with_dns,
  /// with_resolver; none: the base URL's host is dialed as before). The state is shared by copies of the client.
  pub balancer: Balancer = Balancer.PickFirst
  pub lb: Mutex[LbState]? = None
  /// credentials every call carries (grpc-go's WithPerRPCCredentials)
  pub creds: List[PerRpcCreds] = []
  /// credentials of this client's calls (grpc-go's PerRPCCredsCallOption)
  pub call_creds: PerRpcCreds? = None
  /// with_service_config (decision 0705): the config, and the clock's sleep and the rand's draw captured with it
  pub svc: ServiceConfig? = None
  pub sleep: List[fn(Duration)] = []
  pub draw: List[fn(Int) -> Int] = []
  /// retry throttling's tokens (grpc-go's retryThrottler), shared by copies of the client
  pub tokens: Mutex[Float] = Mutex[Float].new(0.0)
  /// with_disable_retry, with_max_call_attempts (5 by default) and with_max_retry_buffer (256 KiB by default)
  pub retry_off: Bool = false
  pub max_attempts: Int = 5
  pub retry_buffer: Int = 262144
  /// every call's `:authority` (grpc-go's WithAuthority), "" for the base URL's host
  pub authority: Str = ""
  /// this client's calls' `:authority` (grpc-go's CallAuthority), checked against the server's certificate
  pub call_authority: Str = ""
  /// the connections that check a call authority, one client per authority, shared by the copies of the client
  checked: Mutex[Map[Str, http.Client]] = Mutex.new({})
}

/// The client sending md with every call (grpc-go's WithDefaultCallOptions with metadata): a call's own metadata
/// adds to it, and its value wins for a name in both.
pub fn (c: Client) with_default_metadata(md: Map[Str, Str]) -> Client {
  c with {default_md: md}
}

/// The client giving every call without a timeout of its own this one (WithDefaultCallOptions for a deadline).
pub fn (c: Client) with_default_timeout(d: Duration) -> Client {
  c with {default_timeout: Some(d)}
}

/// The client running f when each call ends (grpc-go's OnFinish), with the method and the call's status: None for
/// OK. A streaming call ends when `call`'s function returns. f's effects are counted here.
pub fn (c: Client) with_on_finish[fx: Effects](f: fn(Str, Status?) -> () uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, Status?)) { f(a.0, a.1) })
  var fs = c.on_finish
  fs.push(fn(m, st) { g((m, st)) })
  c with {on_finish: fs}
}

/// A call's metadata and timeout after the client's defaults.
fn (c: Client) opts(metadata: Map[Str, Str], timeout: Duration?) -> CallOpts {
  var md = c.default_md
  for (k, v) in metadata {
    md[k] = v
  }
  CallOpts{metadata: md, timeout: timeout ?? c.default_timeout}
}

/// Runs the on_finish functions for a call that ended with r.
fn (c: Client) finished[T](method: Str, r: Result[T, Status]) {
  let st = match r {
    Ok(_) => None
    Err(e) => Some(e)
  }
  for f in c.on_finish {
    f(method, st)
  }
}

/// A call's options as a client interceptor sees them: the request metadata and the timeout.
pub struct CallOpts {
  pub metadata: Map[Str, Str] = {}
  pub timeout: Duration? = None
}

/// The rest of a client unary interceptor's chain (grpc-go's UnaryInvoker): the next interceptor or the call itself,
/// with the method, request and options to send. No effects in its type (decision 0703).
pub type Invoker = fn(Str, Bytes, CallOpts) -> Bytes ! Status

/// The client with f around each `unary` call (grpc-go's WithUnaryInterceptor and WithChainUnaryInterceptor): f
/// gets the method, the request and the options, and calls `invoker` to send it (as it came or changed) or returns
/// without it. Several run in the order added, the first outermost. f's effects are counted here.
pub fn (c: Client) with_unary_interceptor[fx: Effects](f: fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, Bytes, CallOpts, Invoker)) -> Result[Bytes, Status] { f(a.0, a.1, a.2, a.3) })
  var ics = c.unary_icpt
  ics.push(fn(m, r, o, inv) -> Bytes ! Status { g((m, r, o, inv)) })
  c with {unary_icpt: ics}
}

/// The client with f before each streaming `call` opens (grpc-go's WithStreamInterceptor, in part): f gets the
/// method and the options and returns the options to open with, or an error that ends the call before it starts.
/// Several run in the order added. Unlike grpc-go's, f does not wrap the call's send and recv.
pub fn (c: Client) with_stream_interceptor[fx: Effects](f: fn(Str, CallOpts) -> CallOpts ! Status uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, CallOpts)) -> Result[CallOpts, Status] { f(a.0, a.1) })
  var ics = c.stream_icpt
  ics.push(fn(m, o) -> CallOpts ! Status { g((m, o)) })
  c with {stream_icpt: ics}
}

fn run_invoke(ics: List[fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status], i: Int, method: Str, req: Bytes, o: CallOpts, last: Invoker) -> Bytes ! Status {
  if i == ics.len() {
    return last(method, req, o)
  }
  ics[i](method, req, o, fn(m, r, oo) -> Bytes ! Status { run_invoke(ics, i + 1, m, r, oo, last) })
}

/// grpc-go's keepalive.ClientParameters: after `time` with nothing read on the connection the client sends an HTTP/2
/// PING, and closes the connection when no ack comes within `timeout` (its calls fail `Unavailable`). A time of 0
/// sends none; below 10 s it is 10 s, as grpc-go's (keepalive.go's minimum). std/http's client pings an idle
/// connection too (grpc-go's PermitWithoutStream true).
pub struct ClientKeepalive {
  pub time: Duration = 0s
  pub timeout: Duration = 20s
}

/// The client with keepalive pings (grpc-go's WithKeepaliveParams): `send_ping_timeout` and `ping_timeout` of its
/// http.Client's HTTP/2 settings, which this replaces.
pub fn (c: Client) with_keepalive(p: ClientKeepalive) -> Client {
  let t = if p.time == 0s { 0s } else if p.time < 10s { 10s } else { p.time }
  c with {http: c.http.with_h2_config(http.H2Config{send_ping_timeout: t, ping_timeout: p.timeout})}
}

/// grpc-go's keepalive.ServerParameters: a connection with no call for `max_connection_idle` is closed (0 never),
/// and after `time` with nothing read the server sends a PING and closes the connection when no ack comes within
/// `timeout`. Times below 1 s are 1 s, as grpc-go's. MaxConnectionAge and MaxConnectionAgeGrace are not supported.
/// `min_time` and `permit_without_stream` are grpc-go's keepalive.EnforcementPolicy: a client PING sooner than
/// `min_time` after its last (2 hours while no call is open, unless `permit_without_stream`), with no response
/// sent between them, is a strike, and the third closes the connection with GOAWAY ENHANCE_YOUR_CALM
/// "too_many_pings" (http.H2Config `min_ping_interval`; the native backends only).
pub struct ServerKeepalive {
  pub max_connection_idle: Duration = 0s
  pub time: Duration = 7200s
  pub timeout: Duration = 20s
  pub min_time: Duration = 300s
  pub permit_without_stream: Bool = false
  /// grpc-go's MaxConnectionAge (0: none) and MaxConnectionAgeGrace (0: until the streams end): a connection that
  /// old gets GOAWAY "max_age" (with +-10% jitter) and is closed after the grace (H2Config max_connection_age)
  pub max_connection_age: Duration = 0s
  pub max_connection_age_grace: Duration = 0s
}

/// h with grpc-go's server keepalive (KeepaliveParams and KeepaliveEnforcementPolicy): its HTTP/2 settings'
/// `send_ping_timeout`, `ping_timeout`, `min_ping_interval` and `ping_without_stream`, which this replaces, and
/// `with_idle_timeout` for `max_connection_idle`.
pub fn keepalive_server(h: http.Server, p: ServerKeepalive) -> http.Server {
  let t = if p.time < 1s { 1s } else { p.time }
  let out = h.with_h2_config(http.H2Config{send_ping_timeout: t, ping_timeout: p.timeout, min_ping_interval: p.min_time, ping_without_stream: p.permit_without_stream, max_connection_age: p.max_connection_age, max_connection_age_grace: p.max_connection_age_grace})
  if p.max_connection_idle > 0s { out.with_idle_timeout(p.max_connection_idle) } else { out }
}

/// A method name in a service config (grpc-go's name entry): `service` and `method` both, the service's every method
/// with an empty method, or every method with both empty.
pub struct MethodName {
  pub service: Str = ""
  pub method: Str = ""
} derive Eq

/// grpc-go's retryPolicy (decision 0705).
pub struct RetryPolicy {
  pub max_attempts: Int
  pub initial_backoff: Duration
  pub max_backoff: Duration
  pub backoff_multiplier: Float
  pub retryable_codes: List[Code]
} derive Eq

/// grpc-go's retryThrottling: a retry is allowed while the tokens are above half of max_tokens; a failed attempt
/// takes one, a successful call adds token_ratio.
pub struct RetryThrottling {
  pub max_tokens: Float
  pub token_ratio: Float
} derive Eq

/// grpc-go's MethodConfig: the timeout, retry policy and message limits of the methods named.
pub struct MethodConfig {
  pub names: List[MethodName] = []
  pub timeout: Duration? = None
  pub retry: RetryPolicy? = None
  pub max_request_bytes: Int? = None
  pub max_response_bytes: Int? = None
} derive Eq

/// grpc-go's ServiceConfig, the parts std/grpc uses (decision 0705).
pub struct ServiceConfig {
  pub methods: List[MethodConfig] = []
  pub retry_throttling: RetryThrottling? = None
  /// loadBalancingConfig's first policy std/grpc knows, else loadBalancingPolicy's (decision 0707); None leaves
  /// the client's (with_balancer, PickFirst by default)
  pub balancer: Balancer? = None
} derive Eq

/// How a client with several addresses (with_addrs, with_dns, with_resolver) spreads its calls, as grpc-go's
/// built-in balancers (decision 0707): PickFirst sends every call to the first address that connects and moves on
/// when it fails; RoundRobin turns per call over the addresses whose last connect did not fail.
pub enum Balancer {
  PickFirst
  RoundRobin
} derive Eq, Debug

/// grpc-go's registered name of a balancer policy ("pick_first", "round_robin"), None for one std/grpc lacks.
fn balancer_named(n: Str) -> Balancer? {
  match n.to_lower() {
    "pick_first" => Some(Balancer.PickFirst)
    "round_robin" => Some(Balancer.RoundRobin)
    _ => None
  }
}

const CODE_NAMES: List[Str] = ["OK", "CANCELLED", "UNKNOWN", "INVALID_ARGUMENT", "DEADLINE_EXCEEDED", "NOT_FOUND", "ALREADY_EXISTS", "PERMISSION_DENIED", "RESOURCE_EXHAUSTED", "FAILED_PRECONDITION", "ABORTED", "OUT_OF_RANGE", "UNIMPLEMENTED", "INTERNAL", "UNAVAILABLE", "DATA_LOSS", "UNAUTHENTICATED"]

/// A protobuf JSON Duration ("1.5s", "0.000000001s").
fn json_duration(v: json.Value) -> Duration ! Str {
  let t = match v {
    Str(x) => x
    _ => return Err("a duration is a string")
  }
  if !t.ends_with("s") {
    return Err("malformed duration ${go_quote(t)}")
  }
  let body = t[0..t.len() - 1]
  let (whole, frac) = match body.find(".") {
    Some(i) => (body[0..i], body[i + 1..])
    None => (body, "")
  }
  let secs = match Int.parse(whole) {
    Some(n) => n
    None => return Err("malformed duration ${go_quote(t)}")
  }
  if frac.len() > 9 {
    return Err("malformed duration ${go_quote(t)}")
  }
  let nanos = if frac.is_empty() { 0 } else { Int.parse(frac + "0".repeat(9 - frac.len())) ?? -1 }
  if nanos < 0 || secs < 0 {
    return Err("malformed duration ${go_quote(t)}")
  }
  Ok(Duration.from_nanos(secs * 1000000000 + nanos))
}

fn json_num(v: json.Value) -> Float? {
  match v {
    Int(n) => Some(Float(n))
    Num(n) => Some(n)
    _ => None
  }
}

fn json_int(v: json.Value) -> Int? {
  match v {
    Int(n) => Some(n)
    Num(n) => if n == Float(Int(n)) { Some(Int(n)) } else { None }
    Str(x) => Int.parse(x)
    _ => None
  }
}

fn json_code(v: json.Value) -> Code ! Str {
  match v {
    Str(x) => {
      for (i, n) in CODE_NAMES.indexed() {
        if n == x.to_upper() {
          return Ok(code_from(i) ?? Code.Unknown)
        }
      }
      Err("unknown code ${go_quote(x)}")
    }
    Int(n) => code_from(n).or_err("unknown code ${n}")
    _ => Err("a code is a name or a number")
  }
}

/// grpc-go's service config JSON (WithDefaultServiceConfig): `methodConfig` (`name`, `timeout`, `retryPolicy`,
/// `maxRequestMessageBytes`, `maxResponseMessageBytes`) and `retryThrottling`; other fields (load balancing, health
/// checking, hedging) are read past. A retry policy needs maxAttempts above 1, both backoffs and the multiplier
/// above 0 and a retryable code, as grpc-go's; a name with a method needs its service, and a name may appear once.
pub fn service_config_json(text: Str) -> ServiceConfig ! Str {
  let root = match json.parse_value(text) {
    Ok(v) => v
    Err(e) => return Err("service config: ${e}")
  }
  var out = ServiceConfig{}
  var seen: Set[Str] = #{}
  if let Some(List(mcs)) = root.get("methodConfig") {
    for mc in mcs {
      var m = MethodConfig{}
      if let Some(List(names)) = mc.get("name") {
        for n in names {
          let svc = match n.get("service") {
            Some(Str(x)) => x
            _ => ""
          }
          let meth = match n.get("method") {
            Some(Str(x)) => x
            _ => ""
          }
          if svc.is_empty() && !meth.is_empty() {
            return Err("service config: invalid method name {service: \"\", method: ${go_quote(meth)}}")
          }
          let key = "${svc}/${meth}"
          if seen.contains(key) {
            return Err("service config: duplicate method name ${go_quote(key)}")
          }
          seen.add(key)
          m.names.push(MethodName{service: svc, method: meth})
        }
      }
      if let Some(t) = mc.get("timeout") {
        m.timeout = Some(json_duration(t).map_err(fn(e) -> Str { "service config: timeout: ${e}" })?)
      }
      if let Some(n) = mc.get("maxRequestMessageBytes") {
        m.max_request_bytes = json_int(n)
      }
      if let Some(n) = mc.get("maxResponseMessageBytes") {
        m.max_response_bytes = json_int(n)
      }
      if let Some(rp) = mc.get("retryPolicy") {
        let att = rp.get("maxAttempts").and_then(json_int) ?? 0
        let ib = match rp.get("initialBackoff") {
          Some(v) => json_duration(v).map_err(fn(e) -> Str { "service config: retryPolicy: ${e}" })?
          None => 0s
        }
        let mb = match rp.get("maxBackoff") {
          Some(v) => json_duration(v).map_err(fn(e) -> Str { "service config: retryPolicy: ${e}" })?
          None => 0s
        }
        let mult = rp.get("backoffMultiplier").and_then(json_num) ?? 0.0
        var codes: List[Code] = []
        if let Some(List(cs)) = rp.get("retryableStatusCodes") {
          for c in cs {
            codes.push(json_code(c).map_err(fn(e) -> Str { "service config: retryPolicy: ${e}" })?)
          }
        }
        if att <= 1 || ib <= 0s || mb <= 0s || mult <= 0.0 || codes.is_empty() {
          return Err("service config: invalid retry policy")
        }
        m.retry = Some(RetryPolicy{max_attempts: att, initial_backoff: ib, max_backoff: mb, backoff_multiplier: mult, retryable_codes: codes})
      }
      out.methods.push(m)
    }
  }
  if let Some(thr) = root.get("retryThrottling") {
    let mt = thr.get("maxTokens").and_then(json_num) ?? 0.0
    let tr = thr.get("tokenRatio").and_then(json_num) ?? 0.0
    if mt <= 0.0 || mt > 1000.0 || tr <= 0.0 {
      return Err("service config: invalid retry throttling config")
    }
    out.retry_throttling = Some(RetryThrottling{max_tokens: mt, token_ratio: tr})
  }
  // grpc-go's serviceconfig: loadBalancingConfig is a list of one-key objects, the first known policy chosen (none
  // known is an error); loadBalancingPolicy, a name, is read only without it and an unknown name is ignored
  if let Some(lbc) = root.get("loadBalancingConfig") {
    let items = match lbc {
      List(xs) => xs
      _ => return Err("service config: invalid loadBalancingConfig: not a list")
    }
    for it in items {
      let name = match it {
        Object(m) => if m.len() == 1 { m[0].0 } else { return Err("service config: invalid loadBalancingConfig: an entry has ${m.len()} policies, want 1") }
        _ => return Err("service config: invalid loadBalancingConfig: an entry is not an object")
      }
      if let Some(b) = balancer_named(name) {
        out.balancer = Some(b)
        break
      }
    }
    if out.balancer is None {
      return Err("service config: invalid loadBalancingConfig: no supported policies found")
    }
  } else if let Some(Str(n)) = root.get("loadBalancingPolicy") {
    out.balancer = balancer_named(n)
  }
  Ok(out)
}

/// The client with a service config (grpc-go's WithDefaultServiceConfig, decision 0705): per-method timeouts, message
/// limits and retries. clock times the backoff and rand draws its jitter; their effects are counted here.
pub fn (c: Client) with_service_config(cfg: ServiceConfig, clock: Clock, rand: Rand) -> Client uses (clock, rand) {
  let sl = pure1(fn(d: Duration) { clock.sleep(d) })
  let dr = pure1(fn(n: Int) -> Int { if n <= 0 { 0 } else { rand.int(0, n) } })
  let toks = match cfg.retry_throttling {
    Some(t) => t.max_tokens
    None => 0.0
  }
  c with {svc: Some(cfg), sleep: [fn(d) { sl(d) }], draw: [fn(n) -> Int { dr(n) }], tokens: Mutex[Float].new(toks)}
}

/// The client without retries (grpc-go's WithDisableRetry); timeouts and limits of its service config still apply.
pub fn (c: Client) with_disable_retry() -> Client {
  c with {retry_off: true}
}

/// The most attempts a retry policy may ask (grpc-go's WithMaxCallAttempts; 5 by default, below 2 is 5).
pub fn (c: Client) with_max_call_attempts(n: Int) -> Client {
  c with {max_attempts: if n < 2 { 5 } else { n }}
}

/// The largest request a call keeps to send again (grpc-go's MaxRetryRPCBufferSize; 256 KiB): a larger one is
/// not retried.
pub fn (c: Client) with_max_retry_buffer(n: Int) -> Client {
  c with {retry_buffer: n}
}

/// grpc-go's ClientConn.GetMethodConfig: the config of method (`/service/method`): its own entry, else its service's,
/// else the default one (both names empty).
pub fn (c: Client) method_config(method: Str) -> MethodConfig? {
  let cfg = match c.svc {
    Some(x) => x
    None => return None
  }
  let full = if method.starts_with("/") { method[1..] } else { method }
  let (svc, meth) = match full.find("/") {
    Some(i) => (full[0..i], full[i + 1..])
    None => (full, "")
  }
  for want in [MethodName{service: svc, method: meth}, MethodName{service: svc, method: ""}, MethodName{}] {
    for m in cfg.methods {
      if m.names.contains(want) {
        return Some(m)
      }
    }
  }
  None
}

/// The wait before retry n since the last pushback (grpc-go's withRetry): a uniform draw below
/// initial_backoff x multiplier^n, capped at max_backoff.
fn (c: Client) backoff(p: RetryPolicy, n: Int) -> Duration {
  var cur = Float(p.initial_backoff.nanos())
  for _i in 0..n {
    cur = cur * p.backoff_multiplier
  }
  let cap = Float(p.max_backoff.nanos())
  let ns = if cur > cap { Int(cap) } else { Int(cur) }
  Duration.from_nanos(if c.draw.is_empty() { 0 } else { c.draw[0](ns) })
}

/// A retry throttle step: a failed attempt takes a token and says whether retries may go on; None without
/// throttling.
fn (c: Client) throttle_fail(t: RetryThrottling?) -> Bool {
  match t {
    None => true
    Some(thr) => c.tokens.with(fn(var k: Float) -> Bool {
      k = if k - 1.0 < 0.0 { 0.0 } else { k - 1.0 }
      k > thr.max_tokens / 2.0
    })
  }
}

fn (c: Client) throttle_ok(t: RetryThrottling?) {
  if let Some(thr) = t {
    c.tokens.with(fn(var k: Float) {
      k = if k + thr.token_ratio > thr.max_tokens { thr.max_tokens } else { k + thr.token_ratio }
    })
  }
}

/// The shorter of a call's own timeout and its method's.
fn min_timeout(a: Duration?, b: Duration?) -> Duration? {
  match (a, b) {
    (Some(x), Some(y)) => Some(if x < y { x } else { y })
    (Some(x), None) => Some(x)
    (None, y) => y
  }
}

/// A client of `base`: an `http://host:port` URL (plain HTTP/2 with prior knowledge), an `https://host:port` one, or a
/// grpc-go target name (grpc.NewClient's): `dns:///host:port` (an authority, `dns://server/host:port`, is the DNS
/// server grpc-go asks; std/http's resolver is used), `passthrough:///host:port`, `unix:///abs/path` or `unix:path`
/// (a Unix domain socket, the authority localhost), or `host:port` with no scheme, which grpc-go reads as
/// `dns:///host:port`. A target name is called over plain HTTP/2; TLS takes an https URL.
pub fn client(c: http.Client, base: Str) -> Client {
  let url = target_url(base)
  var h = if url.starts_with("http://") { c.with_protocols(#{http.Protocol.UnencryptedHttp2}) } else { c }
  if let Some(path) = unix_path(base) {
    // grpc-go's unix resolver: the socket is dialed and the authority is localhost
    h = h.with_dial_addr("unix:${path}")
  }
  Client{http: h, base: url, gzip: false, target: base}
}

/// A balancing client's shared state (decision 0707).
pub struct LbState {
  /// the addresses, "host:port" or "unix:PATH", and the http.Client dialing each (with_dial_addr)
  addrs: List[Str] = []
  conns: Map[Str, http.Client] = {}
  /// the addresses whose last connect failed
  down: Set[Str] = #{}
  /// PickFirst's address and RoundRobin's next turn
  cur: Int = 0
  next: Int = 0
  /// the resolver (with_dns, with_resolver; none for with_addrs) and the time since the client was made (its clock)
  resolve: List[fn() -> List[Str] ! Status] = []
  elapsed: List[fn() -> Duration] = []
  /// when it last resolved (elapsed's value); None before the first call
  at: Duration? = None
}

/// grpc-go's min resolution interval: a resolver runs again after every address failed, at most this often.
const RESOLVE_EVERY: Duration = 30s

/// The client spreading its calls with b (grpc-go's loadBalancingConfig through WithDefaultServiceConfig; a service
/// config's balancer wins). Only a client with several addresses (with_addrs, with_dns, with_resolver) balances.
pub fn (c: Client) with_balancer(b: Balancer) -> Client {
  c with {balancer: b}
}

/// The client calling addrs, each "host:port" or "unix:PATH" (grpc-go's manual resolver): the target stays the
/// :authority and the TLS server name. An empty list fails each call Unavailable.
pub fn (c: Client) with_addrs(addrs: List[Str]) -> Client {
  c with {lb: Some(Mutex[LbState].new(LbState{addrs: addrs, at: Some(0s)}))}
}

/// The client resolving its target's host with n.lookup_host (grpc-go's dns resolver; port 443 when the target
/// has none) on its first call, and again after every address failed, at most every 30 s (clock's time).
pub fn (c: Client) with_dns(n: Net, clock: Clock) -> Client uses (net.dial, clock) {
  let (host, port) = target_host_port(c.base)
  let look = pure1(fn(_u: Int) -> Result[List[Str], Status] {
    match n.lookup_host(host) {
      Ok(ips) => Ok(ips.map(fn(ip) -> Str { if ip.contains(":") { "[${ip}]:${port}" } else { "${ip}:${port}" } }))
      Err(e) => Err(status_new(Code.Unavailable, "name resolver error: ${e}"))
    }
  })
  c.with_lb_resolver(fn() -> List[Str] ! Status { look(0) }, clock)
}

/// The client asking f for its addresses (grpc-go's resolver.Builder and WithResolvers), when with_dns would
/// resolve: on its first call, and after every address failed at most every 30 s. f's error fails the call.
pub fn (c: Client) with_resolver[fx: Effects](f: fn() -> List[Str] ! Status uses fx, clock: Clock) -> Client uses (fx, clock) {
  let g = pure1(fn(_u: Int) -> Result[List[Str], Status] { f() })
  c.with_lb_resolver(fn() -> List[Str] ! Status { g(0) }, clock)
}

fn (c: Client) with_lb_resolver(f: fn() -> List[Str] ! Status, clock: Clock) -> Client uses clock {
  let t0 = clock.now()
  let el = pure1(fn(_u: Int) -> Duration { clock.since(t0) })
  c with {lb: Some(Mutex[LbState].new(LbState{resolve: [f], elapsed: [fn() -> Duration { el(0) }]}))}
}

/// The host and port of a base URL (`http://host:port`, `https://[::1]:port`); port 443 when it has none, as
/// grpc-go's dns resolver.
fn target_host_port(base: Str) -> (Str, Str) {
  var rest = base
  if let Some(i) = rest.find("://") {
    rest = rest[i + 3..]
  }
  if let Some(i) = rest.find("/") {
    rest = rest[0..i]
  }
  if rest.starts_with("[") {
    if let Some(j) = rest.find("]") {
      let h = rest[1..j]
      let after = rest[j + 1..]
      return (h, if after.starts_with(":") { after[1..] } else { "443" })
    }
  }
  match rest.rfind(":") {
    Some(i) => (rest[0..i], rest[i + 1..])
    None => (rest, "443")
  }
}

/// grpc-go's ClientConn.Target: the target as given to `client`.
pub fn (c: Client) target() -> Str {
  if c.target.is_empty() { c.base } else { c.target }
}

/// grpc-go's ClientConn.CanonicalTarget: a target name without a scheme gets grpc-go's default, `dns:///`; a URL or a
/// target with a scheme is as given.
pub fn (c: Client) canonical_target() -> Str {
  let t = c.target()
  if has_scheme(t) { t } else { "dns:///${t}" }
}

/// The socket path of a `unix:` target (grpc-go's unix resolver): `unix:///abs/path` or `unix:path`; None for
/// another target or `unix://authority/...`, which grpc-go refuses.
fn unix_path(t: Str) -> Str? {
  if !t.starts_with("unix:") {
    return None
  }
  let rest = t[5..]
  if rest.starts_with("///") {
    return Some(rest[2..])
  }
  if rest.starts_with("//") || rest.is_empty() {
    return None
  }
  Some(rest)
}

/// Whether t starts with a target or URL scheme (`dns:`, `passthrough:`, `unix:`, `http:`, ...): letters, digits,
/// `+`, `-` or `.` after a letter, then `:` and not a port's digits (`host:443` has none).
fn has_scheme(t: Str) -> Bool {
  let i = match t.find(":") {
    Some(i) => i
    None => return false
  }
  if i == 0 {
    return false
  }
  let rest = t[i + 1..].bytes()
  var digits = !rest.is_empty()
  for b in rest {
    if b < 48 || b > 57 {
      digits = false
    }
  }
  if digits {
    return false
  }
  let head = t[0..i].bytes()
  for (k, b) in head.indexed() {
    let letter = (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
    if !letter && (k == 0 || !((b >= 48 && b <= 57) || b == 43 || b == 45 || b == 46)) {
      return false
    }
  }
  true
}

/// The URL a target is called at: http and https URLs as they are; `dns:` and `passthrough:` names and a bare
/// `host:port` as `http://host:port`; any other scheme as given (the call then fails as an invalid URL).
fn target_url(t: Str) -> Str {
  if t.starts_with("http://") || t.starts_with("https://") {
    return t
  }
  if unix_path(t) is Some(_) {
    return "http://localhost"
  }
  for scheme in ["dns:", "passthrough:"] {
    if t.starts_with(scheme) {
      var rest = t[scheme.len()..]
      if rest.starts_with("//") {
        // //authority/endpoint: the endpoint after the authority
        let r = rest[2..]
        rest = match r.find("/") {
          Some(i) => r[i + 1..]
          None => r
        }
      }
      return "http://${rest}"
    }
  }
  if has_scheme(t) { t } else { "http://${t}" }
}

/// The client sending its messages gzip compressed (`grpc-encoding: gzip`); responses are read compressed or not.
pub fn (c: Client) with_gzip() -> Client {
  c with {gzip: true}
}

/// The client with a receive limit in bytes: a larger response message is `ResourceExhausted` (grpc-go's
/// MaxCallRecvMsgSize).
pub fn (c: Client) with_max_recv(n: Int) -> Client {
  c with {max_recv: n}
}

/// The client with a send limit in bytes: a larger request message is `ResourceExhausted` and is not sent
/// (grpc-go's MaxCallSendMsgSize).
pub fn (c: Client) with_max_send(n: Int) -> Client {
  c with {max_send: n}
}

/// Every call carries cr's metadata (grpc-go's WithPerRPCCredentials; several add up, later names win). With
/// `require_tls` over `http://`, each call fails with Unauthenticated (grpc-go refuses the dial).
pub fn (c: Client) with_per_rpc_creds(cr: PerRpcCreds) -> Client {
  var l = c.creds
  l.push(cr)
  c with {creds: l}
}

/// Every call's `:authority` is a (grpc-go's WithAuthority, in place of the base URL's host), and over https a is the
/// server name the handshake checks the certificate against (unless the http.Client has its own,
/// `with_server_name`); per-RPC credentials see it in their audience.
pub fn (c: Client) with_authority(a: Str) -> Client {
  var h = c.http
  if c.base.starts_with("https://") && h.tls_options().server_name == "" {
    h = h.with_server_name(authority_host(a))
  }
  c with {authority: a, http: h}
}

/// The calls of the returned client carry `:authority` a (grpc-go's CallAuthority, the AuthorityOverrideCallOption),
/// over the client's own. Over https a must be valid for the server's certificate (`AuthInfo.validate_authority`),
/// checked on the connection before any request byte is sent; else the call fails Unavailable "failed to validate
/// authority" and the server never sees it. Over http:// any authority goes.
pub fn (c: Client) with_call_authority(a: Str) -> Client {
  c with {call_authority: a}
}

/// The `:authority` of c's calls, "" for the base URL's host.
fn call_authority_of(c: Client) -> Str {
  if c.call_authority != "" { c.call_authority } else { c.authority }
}

/// The http.Client a call goes on: with a call authority over https, one whose new connections check it.
fn conn_of(c: Client) -> http.Client {
  conn_on(c, c.http, "")
}

/// conn_of over base, the http.Client of the balanced address addr ("" for the client's own).
fn conn_on(c: Client, base: http.Client, addr: Str) -> http.Client {
  if c.call_authority == "" || !c.base.starts_with("https://") {
    return base
  }
  let a = c.call_authority
  let key = if addr == "" { a } else { "${a} ${addr}" }
  c.checked.with(fn(var m) -> http.Client {
    match m.get(key) {
      Some(h) => h
      None => {
        let h = base.with_verify_conn(fn(certs) -> () ! Str { validate_certs(certs, a) })
        m[key] = h
        h
      }
    }
  })
}

/// Opens r for a call: on the client's connection, or with addresses (decision 0707) on the balancer's choice,
/// moving on to the next address when one fails to connect (no byte of the call went out), and resolving again
/// once (at most every 30 s) when every address failed.
fn open_call(c: Client, r: http.Request) -> http.ClientStream ! Status uses net.dial {
  let m = match c.lb {
    Some(x) => x
    None => return conn_of(c).open(r).map_err(fn(e) -> Status { open_err(c, e) })
  }
  let bal = match c.svc {
    Some(cfg) => cfg.balancer ?? c.balancer
    None => c.balancer
  }
  var tried: Set[Str] = #{}
  var again = true
  var last: Status? = None
  while true {
    for a in lb_order(m, bal, tried)? {
      tried.add(a)
      match lb_conn(c, m, a).open(r) {
        Ok(st) => {
          lb_up(m, bal, a)
          return Ok(st)
        }
        Err(e) => {
          if !(e is http.ClientErr.Connect(_)) {
            return Err(open_err(c, e))
          }
          m.with(fn(var st: LbState) { st.down.add(a) })
          last = Some(open_err(c, e))
        }
      }
    }
    if !again || !lb_reresolve(m) {
      break
    }
    again = false
  }
  Err(last ?? status_new(Code.Unavailable, "name resolver error: produced zero addresses"))
}

/// The http.Client dialing a (made once, kept in the shared state), with conn_of's authority check.
fn lb_conn(c: Client, m: Mutex[LbState], a: Str) -> http.Client {
  let base = c.http
  let h = m.with(fn(var st: LbState) -> http.Client {
    match st.conns.get(a) {
      Some(x) => x
      None => {
        let x = base.with_dial_addr(a)
        st.conns[a] = x
        x
      }
    }
  })
  conn_on(c, h, a)
}

/// The addresses a call tries, in turn, leaving out those it tried: PickFirst from its address on; RoundRobin from
/// its next turn over the addresses whose last connect did not fail (all when every one failed), then those. The
/// first call resolves.
fn lb_order(m: Mutex[LbState], bal: Balancer, tried: Set[Str]) -> List[Str] ! Status {
  m.with(fn(var st: LbState) -> List[Str] ! Status {
    if st.at is None {
      st = lb_resolved(st)?
    }
    let n = st.addrs.len()
    var out: List[Str] = []
    if n == 0 {
      return Ok(out)
    }
    if bal == Balancer.PickFirst {
      for k in 0..n {
        out.push(st.addrs[(st.cur + k) % n])
      }
    } else {
      let ready = st.addrs.filter(fn(a) -> Bool { !st.down.contains(a) })
      let turn = if ready.is_empty() { st.addrs } else { ready }
      let start = st.next % turn.len()
      st.next = st.next + 1
      for k in 0..turn.len() {
        out.push(turn[(start + k) % turn.len()])
      }
      for a in st.addrs {
        if !out.contains(a) {
          out.push(a)
        }
      }
    }
    Ok(out.filter(fn(a) -> Bool { !tried.contains(a) }))
  })
}

/// st after its resolver ran (none: as it is), the time noted; a resolver's error or no address fails the call.
fn lb_resolved(st0: LbState) -> LbState ! Status {
  var st = st0
  st.at = Some(if st.elapsed.is_empty() { 0s } else { st.elapsed[0]() })
  if st.resolve.is_empty() {
    return Ok(st)
  }
  let got = st.resolve[0]()?
  if got.is_empty() {
    return Err(status_new(Code.Unavailable, "name resolver error: produced zero addresses"))
  }
  if got != st.addrs {
    st.addrs = got
    st.down = #{}
    st.cur = 0
  }
  Ok(st)
}

/// Resolves again after every address failed, when the resolver last ran at least 30 s ago; whether it did.
fn lb_reresolve(m: Mutex[LbState]) -> Bool {
  m.with(fn(var st: LbState) -> Bool {
    if st.resolve.is_empty() || st.elapsed.is_empty() {
      return false
    }
    if let Some(t) = st.at {
      if st.elapsed[0]() - t < RESOLVE_EVERY {
        return false
      }
    }
    match lb_resolved(st) {
      Ok(x) => {
        st = x
        true
      }
      Err(_) => false
    }
  })
}

/// a connected: it is up again, and PickFirst's address.
fn lb_up(m: Mutex[LbState], bal: Balancer, a: Str) {
  m.with(fn(var st: LbState) {
    st.down.remove(a)
    if bal == Balancer.PickFirst {
      for (i, x) in st.addrs.indexed() {
        if x == a {
          st.cur = i
        }
      }
    }
  })
}

/// A failed open as the call's status: a call authority the connection refused is grpc-go's Unavailable
/// "failed to validate authority".
fn open_err(c: Client, e: http.ClientErr) -> Status {
  if c.call_authority != "" {
    let t = "${e}"
    if let Some(i) = t.find("credentials: invalid authority ") {
      return status_new(Code.Unavailable, "failed to validate authority ${go_quote(c.call_authority)} : ${t[i..]}")
    }
  }
  from_client_err(e)
}

/// The calls of the returned client carry cr's metadata (grpc-go's PerRPCCredsCallOption, the grpc.PerRPCCredentials
/// call option), after the client's own credentials. With `require_tls` over `http://` a call is Unauthenticated.
pub fn (c: Client) with_call_creds(cr: PerRpcCreds) -> Client {
  c with {call_creds: Some(cr)}
}

/// A status a per-RPC credentials function returned, as grpc-go passes it on: the codes the control plane may not
/// send (gRFC A54) become Internal.
fn creds_status(e: Status) -> Status {
  match e.code {
    Code.InvalidArgument | Code.NotFound | Code.AlreadyExists | Code.FailedPrecondition | Code.Aborted | Code.OutOfRange | Code.DataLoss => status_new(Code.Internal, "transport: received per-RPC creds error with illegal status: ${e.display()}")
    _ => e
  }
}

/// The call's metadata with the credentials' added (grpc-go's getTrAuthData and getCallAuthData): the client's,
/// then the call's, then md (md wins on a shared name).
fn creds_metadata(c: Client, method: Str, md: Map[Str, Str]) -> Map[Str, Str] ! Status {
  if c.creds.is_empty() && c.call_creds.is_none() {
    return Ok(md)
  }
  let secure = c.base.starts_with("https://")
  var host = call_authority_of(c)
  if host == "" {
    host = c.base.trim_prefix("https://").trim_prefix("http://")
    if let Some((h, _)) = host.cut("/") {
      host = h
    }
  }
  host = host.trim_suffix(":443")
  let pos = method.rfind("/") ?? method.len()
  let ri = RequestInfo{method: method, audience: "https://${host}${method[..pos]}", auth_info: if secure { tls_info(None) } else { insecure_info() }}
  var out: Map[Str, Str] = {}
  var all = c.creds
  if let Some(cc) = c.call_creds {
    all.push(cc)
  }
  for cr in all {
    if cr.require_tls && !secure {
      return Err(status_new(Code.Unauthenticated, "transport: cannot send secure credentials on an insecure connection"))
    }
    let data = match (cr.metadata)(ri) {
      Ok(d) => d
      Err(e) => return Err(creds_status(e))
    }
    for (k, v) in data {
      out[k.to_lower()] = v
    }
  }
  for (k, v) in md {
    out[k] = v
  }
  Ok(out)
}

fn send_too_large(n: Int, max: Int) -> Status {
  status_new(Code.ResourceExhausted, "trying to send message larger than max (${n} vs. ${max})")
}

/// One unary call: the request message, the response message, or the call's status. `timeout` is sent as
/// `grpc-timeout` and bounds the call (DeadlineExceeded).
pub fn (c: Client) unary(method: Str, req: Bytes, metadata: Map[Str, Str] = {}, timeout: Duration? = None) -> Bytes ! Status uses net.dial {
  let o = c.opts(metadata, timeout)
  let out = if c.unary_icpt.is_empty() {
    c.unary_call(method, req, o.metadata, o.timeout)
  } else {
    let me = c
    let g = pure1(fn(a: (Str, Bytes, CallOpts)) -> Result[Bytes, Status] { me.unary_call(a.0, a.1, a.2.metadata, a.2.timeout) })
    run_invoke(c.unary_icpt, 0, method, req, o, fn(m, r, oo) -> Bytes ! Status { g((m, r, oo)) })
  }
  c.finished(method, out)
  out
}

/// One unary call, after the interceptors: its method config's timeout and limits, and its retries (decision 0705).
fn (c: Client) unary_call(method: Str, req: Bytes, metadata: Map[Str, Str], timeout0: Duration?) -> Bytes ! Status uses net.dial {
  let mc = c.method_config(method)
  var cc = c
  var timeout = timeout0
  var policy: RetryPolicy? = None
  if let Some(m) = mc {
    timeout = min_timeout(timeout0, m.timeout)
    if let Some(n) = m.max_request_bytes {
      cc = cc with {max_send: if n < cc.max_send { n } else { cc.max_send }}
    }
    if let Some(n) = m.max_response_bytes {
      cc = cc with {max_recv: if n < cc.max_recv { n } else { cc.max_recv }}
    }
    if !c.retry_off {
      policy = m.retry
    }
  }
  let thr = match c.svc {
    Some(s) => s.retry_throttling
    None => None
  }
  var attempt = 1
  var since_pushback = 0
  while true {
    let (out, committed, pushback) = cc.unary_attempt(method, req, metadata, timeout)
    let p = match (out, policy) {
      (Ok(_), _) => {
        c.throttle_ok(thr)
        return out
      }
      (Err(_), None) => return out
      (Err(st), Some(rp)) => {
        if committed || !rp.retryable_codes.contains(st.code) || req.len() > c.retry_buffer {
          return out
        }
        rp
      }
    }
    let cap = if p.max_attempts < c.max_attempts { p.max_attempts } else { c.max_attempts }
    if !c.throttle_fail(thr) || attempt >= cap {
      return out
    }
    let wait = match pushback {
      Some(v) => {
        let ms = Int.parse(v) ?? -1
        if ms < 0 {
          return out
        }
        since_pushback = 0
        Duration.from_millis(ms)
      }
      None => {
        let d = c.backoff(p, since_pushback)
        since_pushback += 1
        d
      }
    }
    if !c.sleep.is_empty() {
      c.sleep[0](wait)
    }
    attempt += 1
  }
  Err(status_new(Code.Internal, "unreachable"))
}

/// One attempt of a unary call: its outcome, whether a response head came (the call is then committed, grpc-go's
/// rule, and not retried), and the server's grpc-retry-pushback-ms.
fn (c: Client) unary_attempt(method: Str, req: Bytes, metadata0: Map[Str, Str], timeout: Duration?) -> (Result[Bytes, Status], Bool, Str?) uses net.dial {
  // per-RPC credentials on each attempt, as grpc-go asks them per attempt; a failure ends the call
  let metadata = match creds_metadata(c, method, metadata0) {
    Ok(m) => m
    Err(e) => return (Err(e), true, None)
  }
  let body = frame_msg(req, c.gzip)
  if body.len() - 5 > c.max_send {
    return (Err(send_too_large(body.len() - 5, c.max_send)), true, None)
  }
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip), body)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let auth = call_authority_of(c)
  if auth != "" {
    r = r.with_host(auth)
  }
  let st = match open_call(c, r) {
    Ok(s) => s
    Err(e) => return (Err(e), false, None)
  }
  let head = st.head()
  if let Some(e) = head_status(head) {
    st.close()
    return (Err(e), false, head.headers.get("Grpc-Retry-Pushback-Ms"))
  }
  // a trailers-only response (grpc-status in the head) leaves the call uncommitted, as grpc-go's
  let committed = head.headers.get("Grpc-Status") is None
  let data = match st.read_all() {
    Ok(b) => b
    Err(e) => {
      st.close()
      return (Err(from_client_err(e)), committed, None)
    }
  }
  let fin = final_status(st)
  let pushback = st.trailers().get("Grpc-Retry-Pushback-Ms") ?? head.headers.get("Grpc-Retry-Pushback-Ms")
  let enc = head.headers.get("Grpc-Encoding") ?? ""
  st.close()
  if fin.code != Code.Ok {
    return (Err(fin), committed, pushback)
  }
  match pull(RecvState{buf: data, at: 0, done: true, gzip: enc == "gzip"}, c.max_recv, fn() -> Bytes? ! Status { Ok(None) }) {
    Ok((Some(msg), _)) => (Ok(msg), committed, None)
    Ok((None, _)) => (Err(status_new(Code.Internal, "grpc: no response message")), committed, None)
    Err(e) => (Err(e), committed, None)
  }
}

/// The client side of a streaming call, valid inside `Client.call`.
pub struct ClientCall {
  pub w: http.PipeWriter
  pub head: Chan[(http.ClientStream?, Status?)]
  pub st: Mutex[CallState]
  pub max: Int
  /// messages are sent gzip compressed (Client.with_gzip)
  pub gzip: Bool = false
  /// the client's send limit (Client.with_max_send)
  pub max_send: Int = 2147483647
}

pub struct CallState {
  pub stream: http.ClientStream? = None
  pub failed: Status? = None
  pub recv: RecvState = RecvState{}
  pub final: Status? = None
  /// the response's header and trailer metadata (ClientCall.header, ClientCall.trailer)
  pub header: Map[Str, Str] = {}
  pub trailer: Map[Str, Str] = {}
}

/// Runs `f` on a streaming call: `f` sends with `send`, ends the request with `close_send` and reads with `recv`.
/// The call's status is the result of `recv` after the last message (an error when it is not OK).
pub fn (c: Client) call[R, fx: Effects](method: Str, metadata: Map[Str, Str], timeout: Duration?, f: fn(ClientCall) -> R ! Status uses fx) -> R ! Status uses (fx, net.dial) {
  var o = c.opts(metadata, timeout)
  for ic in c.stream_icpt {
    match ic(method, o) {
      Ok(x) => o = x
      Err(e) => {
        c.finished(method, Err[(), Status](e))
        return Err(e)
      }
    }
  }
  let out = c.call_opened(method, o.metadata, o.timeout, f)
  c.finished(method, out)
  out
}

/// One streaming call, after the interceptors.
fn (c: Client) call_opened[R, fx: Effects](method: Str, metadata0: Map[Str, Str], timeout: Duration?, f: fn(ClientCall) -> R ! Status uses fx) -> R ! Status uses (fx, net.dial) {
  let metadata = creds_metadata(c, method, metadata0)?
  let (pw, pr) = http.pipe()
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip)).with_body_reader(pr)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let auth = call_authority_of(c)
  if auth != "" {
    r = r.with_host(auth)
  }
  let head = Chan[(http.ClientStream?, Status?)].new(1)
  let cc = ClientCall{w: pw, head: head, st: Mutex[CallState].new(CallState{stream: None, failed: None, recv: RecvState{buf: b"", at: 0, done: false}, final: None}), max: c.max_recv, gzip: c.gzip, max_send: c.max_send}
  var result: R? = None
  var failure: Status? = None
  scope s {
    s.spawn(fn() {
      match open_call(c, r) {
        Ok(st) => head.send((Some(st), None))
        Err(e) => head.send((None, Some(e)))
      }
    })
    match f(cc) {
      Ok(v) => {
        result = Some(v)
      }
      Err(e) => {
        failure = Some(e)
      }
    }
    pw.close()
    // release the stream, also when f never read the call to its end
    var open_stream = cc.st.with(fn(var s) { s.stream })
    let consumed = cc.st.with(fn(var s) { s.failed.is_some() })
    if open_stream.is_none() && !consumed {
      match head.recv() {
        Some((Some(x), _)) => {
          open_stream = Some(x)
        }
        _ => {}
      }
    }
    if let Some(x) = open_stream {
      x.close()
    }
  }
  if let Some(e) = failure {
    return Err(e)
  }
  Ok(result ?? fault("grpc call produced no result"))
}

/// Sends one message.
pub fn (c: ClientCall) send(msg: Bytes) -> () ! Status {
  let f = frame_msg(msg, c.gzip)
  if f.len() - 5 > c.max_send {
    return Err(send_too_large(f.len() - 5, c.max_send))
  }
  match c.w.write(f) {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// Ends the request stream.
pub fn (c: ClientCall) close_send() {
  c.w.close()
}

/// The next response message; None at the end of an OK call, the status as an error otherwise.
/// Waits for the response's head when it has not come yet: the stream, or the call's failure.
fn await_head(c: ClientCall, var s: CallState) -> () ! Status uses sync {
  if s.stream.is_some() {
    return Ok(())
  }
  match c.head.recv() {
    Some((Some(st), _)) => {
      // a response that is not gRPC ends the call at its head (grpc-go's operateHeaders, task #115)
      if let Some(e) = head_status(st.head()) {
        st.close()
        s.failed = Some(e)
        return Err(e)
      }
      s.stream = Some(st)
      s.header = metadata_of(st.head().headers)
      s.recv = s.recv with {gzip: (st.head().headers.get("Grpc-Encoding") ?? "") == "gzip"}
      if st.head().headers.get("Grpc-Status").is_some() {
        // trailers only: what it carries is the trailer metadata (grpc-go)
        s.trailer = s.header
        s.header = {}
      }
      Ok(())
    }
    Some((None, Some(e))) => {
      s.failed = Some(e)
      Err(e)
    }
    _ => Err(status_new(Code.Internal, "grpc: no response"))
  }
}

/// The metadata of a response's head or trailers as grpc-go's client gives it: lower case names, without the
/// reserved ones (`grpc-status`, `grpc-message`, `grpc-encoding`, `grpc-timeout`, `te`; `content-type` kept).
/// `-bin` values stay base64 (`bin_decode`).
fn metadata_of(h: Map[Str, Str]) -> Map[Str, Str] {
  var md: Map[Str, Str] = {}
  for (k, v) in h {
    let lk = k.to_lower()
    if lk.starts_with(":") || lk == "grpc-message-type" || lk == "grpc-encoding" || lk == "grpc-message" || lk == "grpc-status" || lk == "grpc-timeout" || lk == "te" {
      continue
    }
    md[lk] = v
  }
  md
}

/// The response's header metadata, waiting for the head: grpc-go's `grpc.Header` call option and
/// `ClientStream.Header`. Empty for a trailers only response (its metadata is the trailer's).
pub fn (c: ClientCall) header() -> Map[Str, Str] ! Status {
  let out = c.st.with(fn(var s) -> Result[Map[Str, Str], Status] uses sync {
    if s.stream.is_none() {
      if let Some(e) = s.failed {
        return Err(e)
      }
    }
    if let Err(e) = await_head(c, s) {
      return Err(e)
    }
    Ok(s.header)
  })
  out
}

/// The response's trailer metadata (grpc-go's `grpc.Trailer` call option and `ClientStream.Trailer`): complete once
/// `recv` returned None or the call's status; empty before.
pub fn (c: ClientCall) trailer() -> Map[Str, Str] {
  c.st.with_read(fn(s) { s.trailer })
}

pub fn (c: ClientCall) recv() -> Bytes? ! Status uses net.dial {
  let out = c.st.with(fn(var s) -> Result[Bytes?, Status] uses (net.dial, sync) {
    if let Some(e) = s.failed {
      return Err(e)
    }
    if let Some(fin) = s.final {
      return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
    }
    if let Err(e) = await_head(c, s) {
      return Err(e)
    }
    let stream = s.stream ?? fault("stream")
    let res = pull(s.recv, c.max, fn() -> Bytes? ! Status uses net.dial {
      match stream.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(from_client_err(e))
      }
    })
    match res {
      Ok((msg, ns)) => {
        s.recv = ns
        if msg.is_none() {
          let fin = final_status(stream)
          if !stream.trailers().is_empty() {
            s.trailer = metadata_of(stream.trailers())
          }
          stream.close()
          s.final = Some(fin)
          return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
        }
        Ok(msg)
      }
      Err(e) => {
        // a stream cut short whose trailers carry a grpc-status that does not parse: that error, as grpc-go,
        // whose transport queues it after the data (TestGrpcFuzz, task #115)
        let err = if e.message == "unexpected EOF" {
          let fin = final_status(stream)
          if fin.message.starts_with("transport: malformed grpc-status") { fin } else { e }
        } else {
          e
        }
        stream.close()
        s.failed = Some(err)
        Err(err)
      }
    }
  })
  out
}

/// The frame of msg, gzip compressed when gzip.
fn frame_msg(msg: Bytes, gzip: Bool) -> Bytes {
  if gzip {
    return frame(compress.gzip(msg), true)
  }
  frame(msg)
}

fn hex_val(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn status_new(code: Code, message: Str) -> Status {
  Status{code: code, message: message, details: b""}
}

fn reserved(name: Str) -> Bool {
  name.starts_with("grpc-") || name == "content-type" || name == "te"
}

/// The status as head fields of a response whose head has not gone out (a trailers-only response); false when the
/// head was already sent.
fn head_status_fields(w: http.BodyWriter, st: Status) -> Bool {
  if !w.set_header("grpc-status", "${st.code.number()}") {
    return false
  }
  if st.message != "" {
    let _m = w.set_header("grpc-message", encode_message(st.message))
  }
  if !st.details.is_empty() {
    let _d = w.set_header("grpc-status-details-bin", bin_encode(st.details))
  }
  true
}

fn finish(w: http.BodyWriter, st: Status) {
  w.set_trailer("grpc-status", "${st.code.number()}")
  if st.message != "" {
    w.set_trailer("grpc-message", encode_message(st.message))
  }
  if !st.details.is_empty() {
    w.set_trailer("grpc-status-details-bin", bin_encode(st.details))
  }
}

/// The next message of the stream whose buffered state is `st`, reading more with `more` (None at its end).
fn pull[fx: Effects](st: RecvState, max: Int, more: fn() -> Bytes? ! Status uses fx) -> (Bytes?, RecvState) ! Status uses fx {
  var s = st
  while true {
    match unframe(s.buf, s.at, max) {
      Ok((compressed, msg, next)) => {
        s.at = next
        if compressed {
          if !s.gzip {
            return Err(status_new(Code.Internal, "grpc: compressed message received without a grpc-encoding"))
          }
          // grpc-go's decompress for a registered compressor (rpc_util.go): the limit and its text
          match compress.gunzip(msg, max) {
            Ok(plain) => return Ok((Some(plain), s))
            Err(e) => {
              if e.msg.contains("exceeds max_size") {
                return Err(status_new(Code.ResourceExhausted, "grpc: received message after decompression larger than max ${max}"))
              }
              return Err(status_new(Code.Internal, "grpc: failed to decompress the received message"))
            }
          }
        }
        return Ok((Some(msg), s))
      }
      Err(FrameErr.TooLarge(len)) => {
        return Err(status_new(Code.ResourceExhausted, "grpc: received message larger than max (${len} vs. ${max})"))
      }
      Err(FrameErr.BadFlag(flag)) => {
        return Err(status_new(Code.Internal, "grpc: received message with invalid compression flag ${flag}"))
      }
      Err(FrameErr.Truncated) => {
        if s.done {
          if s.at == s.buf.len() {
            return Ok((None, s))
          }
          return Err(status_new(Code.Internal, "unexpected EOF"))
        }
        match more()? {
          Some(d) => {
            var b = BytesBuilder.with_capacity(s.buf.len() - s.at + d.len())
            b.write(s.buf[s.at..])
            b.write(d)
            s.buf = b.freeze()
            s.at = 0
          }
          None => {
            s.done = true
          }
        }
      }
    }
  }
  Ok((None, s))
}

fn trailers_only(st: Status) -> http.Response {
  http.stream(200, fn(w) -> () ! IoErr {
    finish(w, st)
  }).with_header("content-type", "application/grpc").with_header("date", "")
}

fn serve_call[fx: Effects](f: fn(Call, Recv, Send) -> () ! Status uses fx, clock: Clock, max: Int, max_send: Int, method: Str, req: http.Request, body: http.BodyReader) -> http.Response uses (fx, clock) {
  let ct = req.header("content-type") ?? ""
  if !ct.starts_with("application/grpc") {
    return http.empty(415)
  }
  let gz = (req.header("grpc-encoding") ?? "") == "gzip"
  var timeout: Duration? = None
  if let Some(t) = req.header("grpc-timeout") {
    match decode_timeout(t) {
      Some(ns) => {
        timeout = Some(Duration.from_nanos(ns))
      }
      None => return trailers_only(status_new(Code.Internal, "malformed grpc-timeout"))
    }
  }
  var md: Map[Str, Str] = {}
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if !reserved(lk) {
      md[lk] = v
    }
  }
  var accept: List[Str] = []
  for e in (req.header("grpc-accept-encoding") ?? "").split(",") {
    if !e.trim().is_empty() {
      accept.push(e.trim())
    }
  }
  let call = Call{method: method, metadata: md, timeout: timeout, peer: req.remote_ip, accept_encodings: accept, auth_info: if req.tls() { tls_info(req.tls_state()) } else { insecure_info() }, authority: req.host()}
  let recv = Recv{body: body, st: Mutex[RecvState].new(RecvState{buf: b"", at: 0, done: false, gzip: (req.header("grpc-encoding") ?? "") == "gzip"}), max: max}
  // the head grpc-go's server writes: content-type, and grpc-encoding only when the responses are compressed
  var resp = http.stream(200, fn(w) -> () ! IoErr {
    let send = Send{w: w, gzip: gz, max_send: max_send, accept: accept}
    let st = match timeout {
      Some(d) => match task.with_timeout(clock, d, fn() -> () ! Status { f(call, recv, send) }) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(task.Timed.TimedOut) => status_new(Code.DeadlineExceeded, "context deadline exceeded")
        Err(task.Timed.Failed(e)) => e
      }
      None => match f(call, recv, send) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(e) => e
      }
    }
    // nothing sent: the status goes in the head, a trailers-only response as grpc-go's WriteStatus sends, which a
    // client reads as not committed (decision 0705's retries)
    let early = send.head_sent.with(fn(var sent) -> Bool {
      let e = !sent
      sent = true
      e
    })
    if !early || !head_status_fields(w, st) {
      finish(w, st)
    }
  }).with_header("content-type", "application/grpc").with_header("date", "").with_late_head()
  if gz {
    resp = resp.with_header("grpc-encoding", "gzip")
  }
  resp
}

fn from_client_err(e: http.ClientErr) -> Status {
  match e {
    Timeout => status_new(Code.DeadlineExceeded, "context deadline exceeded")
    Canceled => status_new(Code.Canceled, "context canceled")
    Connect(msg) => status_new(Code.Unavailable, "connection error: ${msg}")
    // the connection lost under the call (a keepalive ping not acked, the server gone): grpc-go's transport
    // closing is Unavailable; x/net's errClientConnLost text, the same on the native backends
    // so is a connection the server closed after its GOAWAY (a max_connection_age's grace ran out): grpc-go's
    // ErrConnClosing, Unavailable
    Protocol(msg) => if msg.ends_with("http2: client connection lost") || msg.starts_with("http2: server sent GOAWAY and closed the connection") { status_new(Code.Unavailable, msg) } else { status_new(Code.Internal, msg) }
    InvalidUrl(msg) => status_new(Code.Internal, "invalid URL: ${msg}")
    // a TLS failure was Protocol before ClientErr.Tls (decision 0644):
    // the same status and text (grpc-go says Unavailable for a failed
    // handshake, a follow-up)
    Tls(err) => status_new(Code.Internal, err.msg)
  }
}

fn call_headers(metadata: Map[Str, Str], timeout: Duration?, gzip: Bool) -> Map[Str, Str] {
  var h: Map[Str, Str] = {}
  for (k, v) in metadata {
    h[k.to_lower()] = v
  }
  h["content-type"] = "application/grpc"
  h["te"] = "trailers"
  h["grpc-accept-encoding"] = "gzip,identity"
  if gzip {
    h["grpc-encoding"] = "gzip"
  }
  h["user-agent"] = "grpc-xo/0.1"
  if let Some(d) = timeout {
    h["grpc-timeout"] = encode_timeout(d.nanos())
  }
  h
}

fn http_to_code(status: Int) -> Code {
  if status == 400 {
    Code.Internal
  } else if status == 401 {
    Code.Unauthenticated
  } else if status == 403 {
    Code.PermissionDenied
  } else if status == 404 {
    Code.Unimplemented
  } else if status == 429 || status == 502 || status == 503 || status == 504 {
    Code.Unavailable
  } else {
    Code.Unknown
  }
}

/// Whether ct is a gRPC content-type (grpc-go's grpcutil.ContentSubtype): `application/grpc`, alone or followed
/// by `+` or `;`, compared as written (case and all).
fn grpc_content_type(ct: Str) -> Bool {
  if !ct.starts_with("application/grpc") {
    return false
  }
  if ct.len() == 16 {
    return true
  }
  let c = ct.bytes()[16]
  c == 43 || c == 59
}

/// s as Go's %q writes an ASCII string.
fn go_quote(s: Str) -> Str {
  let hex = "0123456789abcdef"
  var b = BytesBuilder.new()
  b.write_byte(34)
  for c in s.bytes() {
    let n = Int(c)
    if n == 34 || n == 92 {
      b.write_byte(92)
      b.write_byte(c)
    } else if n < 32 || n == 127 {
      b.write("\\x".bytes())
      b.write(hex.bytes()[n / 16..n / 16 + 1])
      b.write(hex.bytes()[n % 16..n % 16 + 1])
    } else {
      b.write_byte(c)
    }
  }
  b.write_byte(34)
  b.freeze().to_str() ?? s
}

/// The status of a response that is not gRPC, None for one that is (grpc-go's operateHeaders): a response whose
/// content-type is not gRPC's ends the call with the code of its HTTP status (Unknown for one with none, 200
/// among them) and grpc-go's text, whatever its grpc-status says, and with no message read; a gRPC response's
/// HTTP status is not looked at.
fn head_status(head: http.ResponseHead) -> Status? {
  // a grpc-status that does not parse ends the call first, whatever else the head says
  if let Some(gs) = head.headers.get("Grpc-Status") {
    if let Err(e) = parse_int32(gs) {
      return Some(malformed_status(gs, e))
    }
  }
  let ct_err = match head.headers.get("Content-Type") {
    Some(ct) => {
      if grpc_content_type(ct) {
        return None
      }
      "transport: received unexpected content-type ${go_quote(ct)}"
    }
    None => "malformed header: missing HTTP content-type"
  }
  Some(status_new(http_to_code(head.status), "unexpected HTTP status code received from server: ${head.status} (${http.status_text(head.status)}); ${ct_err}"))
}

/// Go's strconv.ParseInt(s, 10, 32): the value, or the error's text after `parsing "S": `.
fn parse_int32(s: Str) -> Int ! Str {
  let b = s.bytes()
  var i = 0
  var neg = false
  if b.len() > 0 && (b[0] == 43 || b[0] == 45) {
    neg = b[0] == 45
    i = 1
  }
  if i == b.len() {
    return Err("invalid syntax")
  }
  var n = 0
  var big = false
  while i < b.len() {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return Err("invalid syntax")
    }
    if !big {
      n = n * 10 + (c - 48)
      if n > 2147483648 {
        big = true
      }
    }
    i += 1
  }
  if big || (!neg && n > 2147483647) {
    return Err("value out of range")
  }
  Ok(if neg { -n } else { n })
}

/// The call's status from a finished stream (its head already found to be gRPC's): its trailers, or the head of
/// a trailers only response, as grpc-go reads them: no grpc-status is Unknown with the grpc-message, one that
/// ParseInt refuses is Unknown with its error, and a number past the 17 codes is Unknown (grpc-go keeps the
/// number as its code; Code has no case for it).
fn final_status(st: http.ClientStream) -> Status {
  let head = st.head()
  if let Some(e) = head_status(head) {
    return e
  }
  let tr = st.trailers()
  let msg = decode_message(tr.get("Grpc-Message") ?? (head.headers.get("Grpc-Message") ?? ""))
  let gs = match tr.get("Grpc-Status") ?? head.headers.get("Grpc-Status") {
    Some(v) => v
    None => return status_new(Code.Unknown, msg)
  }
  match parse_int32(gs) {
    Ok(n) => {
      let raw = tr.get("Grpc-Status-Details-Bin") ?? (head.headers.get("Grpc-Status-Details-Bin") ?? "")
      Status{code: code_from(n) ?? Code.Unknown, message: msg, details: if raw == "" { b"" } else { bin_decode(raw) ?? b"" }}
    }
    Err(e) => malformed_status(gs, e)
  }
}

fn malformed_status(gs: Str, e: Str) -> Status {
  status_new(Code.Unknown, "transport: malformed grpc-status: strconv.ParseInt: parsing ${go_quote(gs)}: ${e}")
}
