// std/grpc (decision 0535): gRPC over std/http's HTTP/2. This file is the pure layer: the message frame, the
// grpc-timeout header, the status codes and the grpc-message percent encoding, as grpc-go does them.
// The pure layer is pure; the server and the client use std/http.
//
// std/grpc: the pure layer (decision 0535), after grpc-go's rpc_util.go (frame, timeout) and status (message encoding).

use std/base64
use std/compress
use std/http
use std/task

/// The 17 canonical status codes (their numbers are the wire values of `grpc-status`).
pub enum Code {
  Ok
  Canceled
  Unknown
  InvalidArgument
  DeadlineExceeded
  NotFound
  AlreadyExists
  PermissionDenied
  ResourceExhausted
  FailedPrecondition
  Aborted
  OutOfRange
  Unimplemented
  Internal
  Unavailable
  DataLoss
  Unauthenticated
} derive Display

/// The wire number of a code (OK is 0, UNAUTHENTICATED is 16).
pub fn (c: Code) number() -> Int {
  match c {
    Ok => 0
    Canceled => 1
    Unknown => 2
    InvalidArgument => 3
    DeadlineExceeded => 4
    NotFound => 5
    AlreadyExists => 6
    PermissionDenied => 7
    ResourceExhausted => 8
    FailedPrecondition => 9
    Aborted => 10
    OutOfRange => 11
    Unimplemented => 12
    Internal => 13
    Unavailable => 14
    DataLoss => 15
    Unauthenticated => 16
  }
}

/// The code of a `grpc-status` number; None above 16.
pub fn code_from(n: Int) -> Code? {
  let all = [Code.Ok, Code.Canceled, Code.Unknown, Code.InvalidArgument, Code.DeadlineExceeded,
    Code.NotFound, Code.AlreadyExists, Code.PermissionDenied, Code.ResourceExhausted,
    Code.FailedPrecondition, Code.Aborted, Code.OutOfRange, Code.Unimplemented, Code.Internal,
    Code.Unavailable, Code.DataLoss, Code.Unauthenticated]
  if n < 0 || n > 16 { None } else { Some(all[n]) }
}

/// Why a frame was refused.
pub open enum FrameErr {
  Truncated
  BadFlag(flag: Int)
  TooLarge(len: Int)
} derive Display

/// One message frame: a flag byte (1 for a compressed payload), a 4 byte big endian length, the payload.
pub fn frame(payload: Bytes, compressed: Bool = false) -> Bytes {
  var b = BytesBuilder.with_capacity(5 + payload.len())
  b.write_byte(UInt8.wrapping_from(if compressed { 1 } else { 0 }))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 24) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 16) & 255))
  b.write_byte(UInt8.wrapping_from((payload.len() >> 8) & 255))
  b.write_byte(UInt8.wrapping_from(payload.len() & 255))
  b.write(payload)
  b.freeze()
}

/// Reads the frame at `at`: (compressed, payload, next offset). A length above `max_len` is `TooLarge` (grpc-go's
/// default receive limit is 4 MiB).
pub fn unframe(data: Bytes, at: Int, max_len: Int = 4194304) -> (Bool, Bytes, Int) ! FrameErr {
  if at + 5 > data.len() {
    return Err(FrameErr.Truncated)
  }
  let flag = Int(data[at])
  let n = (Int(data[at + 1]) << 24) | (Int(data[at + 2]) << 16) | (Int(data[at + 3]) << 8) | Int(data[at + 4])
  // the length, then the whole payload, then the flag, as grpc-go's recvMsg and checkRecvPayload (TestGrpcFuzz,
  // task #115)
  if n > max_len {
    return Err(FrameErr.TooLarge(len: n))
  }
  if at + 5 + n > data.len() {
    return Err(FrameErr.Truncated)
  }
  if flag > 1 {
    return Err(FrameErr.BadFlag(flag: flag))
  }
  (flag == 1, data[at + 5..at + 5 + n], at + 5 + n)
}

/// The `grpc-timeout` header value for a duration in nanoseconds: at most 8 digits and the largest unit that keeps
/// it (`n`, `u`, `m`, `S`, `M`, `H`), as grpc-go's encodeTimeout.
pub fn encode_timeout(ns: Int) -> Str {
  if ns <= 0 {
    return "0n"
  }
  let units = [(1, "n"), (1000, "u"), (1000000, "m"), (1000000000, "S"), (60000000000, "M"), (3600000000000, "H")]
  var best = "0n"
  for (div, letter) in units {
    let v = (ns + div / 2) / div
    if v <= 99999999 {
      return "${v}${letter}"
    }
    best = "${v}${letter}"
  }
  best
}

/// The nanoseconds of a `grpc-timeout` value; None for a value that is not 1 to 8 digits and one unit letter.
pub fn decode_timeout(s: Str) -> Int? {
  let b = s.bytes()
  if b.len() < 2 || b.len() > 9 {
    return None
  }
  var v = 0
  var i = 0
  while i < b.len() - 1 {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return None
    }
    v = v * 10 + c - 48
    i += 1
  }
  match Int(b[b.len() - 1]) {
    110 => Some(v)
    117 => Some(v * 1000)
    109 => Some(v * 1000000)
    83 => Some(v * 1000000000)
    77 => Some(v * 60000000000)
    72 => Some(v * 3600000000000)
    _ => None
  }
}

/// `grpc-message` encoding: bytes outside 0x20 to 0x7e and `%` are written as `%XX` (upper case hex).
pub fn encode_message(s: Str) -> Str {
  encode_message_bytes(s.bytes())
}

/// `encode_message` of arbitrary bytes (a status message from another language need not be UTF-8).
pub fn encode_message_bytes(b: Bytes) -> Str {
  var out = BytesBuilder.with_capacity(b.len())
  let hex = "0123456789ABCDEF".bytes()
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c >= 32 && c <= 126 && c != 37 {
      out.write_byte(UInt8.wrapping_from(c))
    } else {
      out.write_byte(UInt8(37))
      out.write_byte(hex[c >> 4])
      out.write_byte(hex[c & 15])
    }
    i += 1
  }
  out.freeze().to_str_lossy()
}

/// The inverse; a malformed escape is kept as written (grpc-go), and bytes that are not UTF-8 become U+FFFD.
pub fn decode_message(s: Str) -> Str {
  decode_message_bytes(s).to_str_lossy()
}

/// The inverse as raw bytes, exactly what grpc-go's client reports.
pub fn decode_message_bytes(s: Str) -> Bytes {
  let bs = s.bytes()
  var out = BytesBuilder.with_capacity(bs.len())
  var i = 0
  while i < bs.len() {
    if bs[i] == UInt8(37) && i + 2 < bs.len() {
      let hi = hex_val(Int(bs[i + 1]))
      let lo = hex_val(Int(bs[i + 2]))
      if hi >= 0 && lo >= 0 {
        out.write_byte(UInt8.wrapping_from(hi * 16 + lo))
        i += 3
        continue
      }
    }
    out.write_byte(bs[i])
    i += 1
  }
  out.freeze()
}

/// A binary metadata value as grpc-go sends it: unpadded standard base64, for a name that ends in `-bin`.
pub fn bin_encode(data: Bytes) -> Str { base64.encode(data, base64.Base64.RawStd) }

/// The bytes of a `-bin` metadata value, padded or not (grpc-go accepts both); None when it is not base64.
pub fn bin_decode(value: Str) -> Bytes? {
  var v = value
  while v.ends_with("=") {
    v = v[0..v.len() - 1]
  }
  match base64.decode(v, base64.Base64.RawStd) {
    Ok(b) => Some(b)
    Err(_) => None
  }
}

/// A call's outcome that is not OK, the error of every call: the code, the status message and the raw
/// `grpc-status-details-bin` payload when the peer sent one.
pub struct Status {
  pub code: Code
  pub message: Str = ""
  pub details: Bytes = b""
}

/// Displays as `rpc error: code = NotFound desc = no such user` (grpc-go's text).
pub fn (s: Status) display() -> Str {
  "rpc error: code = ${s.code} desc = ${s.message}"
}

/// The call a handler is serving.
pub struct Call {
  /// the full method, `/package.Service/Method`
  pub method: Str
  /// the request metadata: lower case names, the pseudo and reserved names (`grpc-*`, `content-type`, `te`) left out
  pub metadata: Map[Str, Str]
  /// the deadline the client sent (`grpc-timeout`), None for no deadline
  pub timeout: Duration?
  /// the method's kind as registered (grpc-go's StreamServerInfo): a unary method has neither
  pub client_stream: Bool = true
  pub server_stream: Bool = true
  /// the client's IP address (grpc-go's peer.Peer Addr, which also has the port; std/http's Request keeps none)
  pub peer: Str = ""
}

/// f with its effects counted at this call, as a function whose type has none: interceptors and handlers are stored
/// that way (decision 0703, as http's middleware). std/native/grpc_native.xo on the native backends, std/rt/grpc.go on
/// the Go backend.
fn pure1[A, R, fx: Effects](f: fn(A) -> R uses fx) -> (fn(A) -> R) uses fx

/// The rest of a stream interceptor's chain: the next interceptor or the method's handler (decision 0703). Like
/// `http.Next`, it has no effects in its type: they were counted where the interceptors and handlers were registered.
pub type StreamNext = fn(Call, Recv, Send) -> () ! Status

/// The rest of a unary interceptor's chain: the next unary interceptor or the method's handler.
pub type UnaryNext = fn(Call, Bytes) -> Bytes ! Status

/// A server's interceptors, shared by every copy of the Server so that they reach methods registered before them.
pub struct Interceptors {
  pub stream: List[fn(Call, Recv, Send, StreamNext) -> () ! Status] = []
  pub unary: List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status] = []
}

/// The stream interceptors from the i-th on, around h.
fn run_stream(ics: List[fn(Call, Recv, Send, StreamNext) -> () ! Status], i: Int, call: Call, recv: Recv, send: Send, h: StreamNext) -> () ! Status {
  if i == ics.len() {
    return h(call, recv, send)
  }
  ics[i](call, recv, send, fn(c, r, sd) -> () ! Status { run_stream(ics, i + 1, c, r, sd, h) })
}

/// The unary interceptors from the i-th on, around h.
fn run_unary(ics: List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status], i: Int, call: Call, req: Bytes, h: UnaryNext) -> Bytes ! Status {
  if i == ics.len() {
    return h(call, req)
  }
  ics[i](call, req, fn(c, m) -> Bytes ! Status { run_unary(ics, i + 1, c, m, h) })
}

pub struct RecvState {
  pub buf: Bytes = b""
  pub at: Int = 0
  pub done: Bool = false
  /// the peer sends `grpc-encoding: gzip`: a message with the compressed flag is inflated
  pub gzip: Bool = false
}

/// The messages of a call's request stream, as a handler reads them.
pub struct Recv {
  pub body: http.BodyReader
  pub st: Mutex[RecvState]
  pub max: Int
}

/// The next message; None when the client has finished sending. A message above the receive limit is
/// `ResourceExhausted`, a cut stream or a bad frame `Internal`, a compressed message `Unimplemented`.
pub fn (r: Recv) next() -> Bytes? ! Status {
  let out = r.st.with(fn(var s) -> Result[Bytes?, Status] {
    match pull(s, r.max, fn() -> Bytes? ! Status {
      match r.body.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(status_new(Code.Canceled, "${e}"))
      }
    }) {
      Ok((msg, ns)) => {
        s = ns
        Ok(msg)
      }
      Err(e) => Err(e)
    }
  })
  out
}

/// The messages a handler sends back.
pub struct Send {
  pub w: http.BodyWriter
  /// the request came compressed with gzip: responses are too (grpc-go's rule)
  pub gzip: Bool = false
  /// the server's send limit (Server.with_max_send)
  pub max_send: Int = 2147483647
}

/// Sends one message (a frame is flushed at once).
pub fn (s: Send) send(msg: Bytes) -> () ! Status {
  send_framed(s, frame_msg(msg, s.gzip), "")
}

/// Writes frame f; one above the send limit is ResourceExhausted with grpc-go's text, which a unary method's
/// response prefixes with "grpc: " (server.go sendResponse) and a stream's does not (serverStream.SendMsg).
fn send_framed(s: Send, f: Bytes, prefix: Str) -> () ! Status {
  if f.len() - 5 > s.max_send {
    return Err(status_new(Code.ResourceExhausted, "${prefix}trying to send message larger than max (${f.len() - 5} vs. ${s.max_send})"))
  }
  match s.w.write(f) {
    Ok(_) => ()
    Err(e) => return Err(status_new(Code.Unavailable, "${e}"))
  }
  match s.w.flush() {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// A trailer sent after the last message, next to `grpc-status` and `grpc-message`.
pub fn (s: Send) set_trailer(name: Str, value: Str) {
  s.w.set_trailer(name, value)
}

/// A gRPC server: methods registered on it are served through `router()` by an HTTP/2 `http.Server`.
pub struct Server {
  pub routes: http.Router
  pub max_recv: Int
  pub methods: List[Str]
  pub clock: Clock[clock]
  /// the largest message a handler may send (grpc-go's MaxSendMsgSize; math.MaxInt32 by default)
  pub max_send: Int = 2147483647
  /// each registered method's kind, in registration order (services)
  pub infos: List[MethodInfo] = []
  /// unknown registered a handler for methods no route has (router keeps it)
  pub has_unknown: Bool = false
  /// intercept's and intercept_unary's functions, in registration order
  pub icpt: Mutex[Interceptors] = Mutex[Interceptors].new(Interceptors{})
}

/// grpc-go's StreamInterceptor and ChainStreamInterceptor (decision 0703): f runs around every method's handler,
/// unary methods and `unknown`'s included, registered before or after it; it calls `next` to go on, with the call,
/// Recv and Send as they came or replaced, or returns without it. Several run in registration order, the first
/// outermost. f's effects are counted here, as `http.Router.wrap`'s.
pub fn (var s: Server) intercept[fx: Effects](f: fn(Call, Recv, Send, StreamNext) -> () ! Status uses fx) uses fx {
  let g = pure1(fn(a: (Call, Recv, Send, StreamNext)) -> Result[(), Status] { f(a.0, a.1, a.2, a.3) })
  s.icpt.with(fn(var ic: Interceptors) {
    ic.stream.push(fn(c, r, sd, n) -> () ! Status { g((c, r, sd, n)) })
  })
}

/// grpc-go's UnaryInterceptor and ChainUnaryInterceptor: f runs around every unary method's handler with its request
/// message, inside the stream interceptors (grpc-go runs one kind or the other for a method; here a stream
/// interceptor sees unary calls too). Several run in registration order, the first outermost.
pub fn (var s: Server) intercept_unary[fx: Effects](f: fn(Call, Bytes, UnaryNext) -> Bytes ! Status uses fx) uses fx {
  let g = pure1(fn(a: (Call, Bytes, UnaryNext)) -> Result[Bytes, Status] { f(a.0, a.1, a.2) })
  s.icpt.with(fn(var ic: Interceptors) {
    ic.unary.push(fn(c, m, n) -> Bytes ! Status { g((c, m, n)) })
  })
}

/// A registered method as grpc-go's MethodInfo: its name within the service (`Method` of
/// `/package.Service/Method`) and whether the client and the server send streams.
pub struct MethodInfo {
  pub name: Str
  pub client_stream: Bool
  pub server_stream: Bool
}

/// A registered service as grpc-go's ServiceInfo: its full name (`package.Service`) and its methods in
/// registration order.
pub struct ServiceInfo {
  pub name: Str
  pub methods: List[MethodInfo]
}

/// grpc-go's Server.GetServiceInfo: every service with a registered method, by name.
pub fn (s: Server) services() -> List[ServiceInfo] {
  var names: List[Str] = []
  var by: Map[Str, List[MethodInfo]] = {}
  for i in 0..s.methods.len() {
    let full = s.methods[i]
    let at = full[1..].find("/") ?? (full.len() - 1)
    let svc = full[1..at + 1]
    if !by.contains(svc) {
      names.push(svc)
      by[svc] = []
    }
    var ms = by.get(svc) ?? []
    ms.push(s.infos[i] with {name: full[at + 2..]})
    by[svc] = ms
  }
  names = names.sort()
  var out: List[ServiceInfo] = []
  for n in names {
    out.push(ServiceInfo{name: n, methods: by.get(n) ?? []})
  }
  out
}

/// A server with grpc-go's 4 MiB receive limit. `clock` times the deadlines clients send: a handler still running at
/// its `grpc-timeout` is cancelled and the call ends with `DeadlineExceeded`.
pub fn server(clock: Clock[clock]) -> Server {
  Server{routes: http.router(), max_recv: 4194304, methods: [], clock: clock}
}

/// The server with another receive limit in bytes.
pub fn (s: Server) with_max_recv(n: Int) -> Server {
  s with {max_recv: n}
}

/// The server with a send limit in bytes: a larger message is `ResourceExhausted` from `Send.send` (grpc-go's
/// MaxSendMsgSize, "grpc: trying to send message larger than max"). Set it before registering methods.
pub fn (s: Server) with_max_send(n: Int) -> Server {
  s with {max_send: n}
}

/// Registers a unary method (`/package.Service/Method`).
pub fn (var s: Server) unary[fx: Effects](method: Str, f: fn(Call, Bytes) -> Bytes ! Status uses fx) uses (fx, clock) {
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Bytes)) -> Result[Bytes, Status] { f(a.0, a.1) })
  let h: UnaryNext = fn(c, m) -> Bytes ! Status { g((c, m)) }
  s.stream(method, fn(call, recv, send) -> () ! Status {
    let req = match recv.next()? {
      Some(m) => m
      None => return Err(status_new(Code.Internal, "grpc: client sent no request message"))
    }
    let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Bytes, UnaryNext) -> Bytes ! Status] { ic.unary })
    let resp = if ics.is_empty() { f(call, req)? } else { run_unary(ics, 0, call, req, h)? }
    send_framed(send, frame_msg(resp, send.gzip), "grpc: ")?
  }, client_stream: false, server_stream: false)
}

/// Registers a method of any kind: a handler reads the request messages from `Recv` and writes the responses to
/// `Send`; returning Ok ends the call with OK, an error with its status. client_stream and server_stream are the
/// method's kind as `services` lists it (grpc-go's StreamDesc), a bidirectional stream by default.
pub fn (var s: Server) stream[fx: Effects](method: Str, f: fn(Call, Recv, Send) -> () ! Status uses fx, client_stream: Bool = true, server_stream: Bool = true) uses (fx, clock) {
  let max = s.max_recv
  let max_send = s.max_send
  let clock = s.clock
  s.methods.push(method)
  s.infos.push(MethodInfo{name: method, client_stream: client_stream, server_stream: server_stream})
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Recv, Send)) -> Result[(), Status] { f(a.0, a.1, a.2) })
  let h: StreamNext = fn(c, r, sd) -> () ! Status { g((c, r, sd)) }
  s.routes.handle_stream("POST ${method}", fn(req, body) -> http.Response {
    serve_call(fn(call, recv, send) -> () ! Status {
      let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Recv, Send, StreamNext) -> () ! Status] { ic.stream })
      run_stream(ics, 0, call with {client_stream: client_stream, server_stream: server_stream}, recv, send, h)
    }, clock, max, max_send, method, req, body)
  })
}

/// grpc-go's UnknownServiceHandler: f serves every call to a method no service registered (an unknown service, or
/// an unknown method of a known one), as a stream method; `Call.method` is the method the client asked for. Without
/// it such a call is `Unimplemented`.
pub fn (var s: Server) unknown[fx: Effects](f: fn(Call, Recv, Send) -> () ! Status uses fx) uses (fx, clock) {
  let max = s.max_recv
  let max_send = s.max_send
  let clock = s.clock
  s.has_unknown = true
  let icpt = s.icpt
  let g = pure1(fn(a: (Call, Recv, Send)) -> Result[(), Status] { f(a.0, a.1, a.2) })
  let h: StreamNext = fn(c, r, sd) -> () ! Status { g((c, r, sd)) }
  // a route for every path, so the request body streams as a registered method's does; the methods'
  // own routes are more specific and win
  s.routes.handle_stream("/{path...}", fn(req, body) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") || req.method != "POST" {
      return http.not_found()
    }
    serve_call(fn(call, recv, send) -> () ! Status {
      let ics = icpt.with(fn(var ic: Interceptors) -> List[fn(Call, Recv, Send, StreamNext) -> () ! Status] { ic.stream })
      run_stream(ics, 0, call, recv, send, h)
    }, clock, max, max_send, req.path, req, body)
  })
}

/// The routes to give `http.server`, with `http.Protocol.UnencryptedHttp2` (or TLS and ALPN h2) in its protocols.
pub fn (s: Server) router() -> http.Router {
  var r = s.routes
  if s.has_unknown {
    return r
  }
  let methods = s.methods
  r.not_found(fn(req) -> http.Response {
    let ct = req.header("content-type") ?? ""
    if !ct.starts_with("application/grpc") {
      return http.not_found()
    }
    let parts = req.path.split("/")
    let svc = if parts.len() > 1 { parts[1] } else { "" }
    var known = false
    for m in methods {
      if m.starts_with("/${svc}/") {
        known = true
      }
    }
    let name = if parts.len() > 2 { parts[2] } else { "" }
    trailers_only(status_new(Code.Unimplemented, if known { "unknown method ${name} for service ${svc}" } else { "unknown service ${svc}" }))
  })
  r
}

/// A gRPC client over an `http.Client`.
pub struct Client {
  pub http: http.Client
  pub base: Str
  /// requests are sent gzip compressed
  pub gzip: Bool = false
  /// the largest response message (grpc-go's MaxCallRecvMsgSize, 4 MiB by default)
  pub max_recv: Int = 4194304
  /// the largest request message (grpc-go's MaxCallSendMsgSize, math.MaxInt32 by default)
  pub max_send: Int = 2147483647
  /// with_unary_interceptor's and with_stream_interceptor's functions, in registration order
  pub unary_icpt: List[fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status] = []
  pub stream_icpt: List[fn(Str, CallOpts) -> CallOpts ! Status] = []
  /// with_default_metadata and with_default_timeout (grpc-go's WithDefaultCallOptions)
  pub default_md: Map[Str, Str] = {}
  pub default_timeout: Duration? = None
  /// with_on_finish's functions
  pub on_finish: List[fn(Str, Status?) -> ()] = []
  /// the target as given to client (Client.target)
  pub target: Str = ""
}

/// The client sending md with every call (grpc-go's WithDefaultCallOptions with metadata): a call's own metadata
/// adds to it, and its value wins for a name in both.
pub fn (c: Client) with_default_metadata(md: Map[Str, Str]) -> Client {
  c with {default_md: md}
}

/// The client giving every call without a timeout of its own this one (WithDefaultCallOptions for a deadline).
pub fn (c: Client) with_default_timeout(d: Duration) -> Client {
  c with {default_timeout: Some(d)}
}

/// The client running f when each call ends (grpc-go's OnFinish), with the method and the call's status: None for
/// OK. A streaming call ends when `call`'s function returns. f's effects are counted here.
pub fn (c: Client) with_on_finish[fx: Effects](f: fn(Str, Status?) -> () uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, Status?)) { f(a.0, a.1) })
  var fs = c.on_finish
  fs.push(fn(m, st) { g((m, st)) })
  c with {on_finish: fs}
}

/// A call's metadata and timeout after the client's defaults.
fn (c: Client) opts(metadata: Map[Str, Str], timeout: Duration?) -> CallOpts {
  var md = c.default_md
  for (k, v) in metadata {
    md[k] = v
  }
  CallOpts{metadata: md, timeout: timeout ?? c.default_timeout}
}

/// Runs the on_finish functions for a call that ended with r.
fn (c: Client) finished[T](method: Str, r: Result[T, Status]) {
  let st = match r {
    Ok(_) => None
    Err(e) => Some(e)
  }
  for f in c.on_finish {
    f(method, st)
  }
}

/// A call's options as a client interceptor sees them: the request metadata and the timeout.
pub struct CallOpts {
  pub metadata: Map[Str, Str] = {}
  pub timeout: Duration? = None
}

/// The rest of a client unary interceptor's chain (grpc-go's UnaryInvoker): the next interceptor or the call itself,
/// with the method, request and options to send. No effects in its type (decision 0703).
pub type Invoker = fn(Str, Bytes, CallOpts) -> Bytes ! Status

/// The client with f around each `unary` call (grpc-go's WithUnaryInterceptor and WithChainUnaryInterceptor): f
/// gets the method, the request and the options, and calls `invoker` to send it (as it came or changed) or returns
/// without it. Several run in the order added, the first outermost. f's effects are counted here.
pub fn (c: Client) with_unary_interceptor[fx: Effects](f: fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, Bytes, CallOpts, Invoker)) -> Result[Bytes, Status] { f(a.0, a.1, a.2, a.3) })
  var ics = c.unary_icpt
  ics.push(fn(m, r, o, inv) -> Bytes ! Status { g((m, r, o, inv)) })
  c with {unary_icpt: ics}
}

/// The client with f before each streaming `call` opens (grpc-go's WithStreamInterceptor, in part): f gets the
/// method and the options and returns the options to open with, or an error that ends the call before it starts.
/// Several run in the order added. Unlike grpc-go's, f does not wrap the call's send and recv.
pub fn (c: Client) with_stream_interceptor[fx: Effects](f: fn(Str, CallOpts) -> CallOpts ! Status uses fx) -> Client uses fx {
  let g = pure1(fn(a: (Str, CallOpts)) -> Result[CallOpts, Status] { f(a.0, a.1) })
  var ics = c.stream_icpt
  ics.push(fn(m, o) -> CallOpts ! Status { g((m, o)) })
  c with {stream_icpt: ics}
}

fn run_invoke(ics: List[fn(Str, Bytes, CallOpts, Invoker) -> Bytes ! Status], i: Int, method: Str, req: Bytes, o: CallOpts, last: Invoker) -> Bytes ! Status {
  if i == ics.len() {
    return last(method, req, o)
  }
  ics[i](method, req, o, fn(m, r, oo) -> Bytes ! Status { run_invoke(ics, i + 1, m, r, oo, last) })
}

/// grpc-go's keepalive.ClientParameters: after `time` with nothing read on the connection the client sends an HTTP/2
/// PING, and closes the connection when no ack comes within `timeout` (its calls fail `Unavailable`). A time of 0
/// sends none; below 10 s it is 10 s, as grpc-go's (keepalive.go's minimum). std/http's client pings an idle
/// connection too (grpc-go's PermitWithoutStream true).
pub struct ClientKeepalive {
  pub time: Duration = 0s
  pub timeout: Duration = 20s
}

/// The client with keepalive pings (grpc-go's WithKeepaliveParams): `send_ping_timeout` and `ping_timeout` of its
/// http.Client's HTTP/2 settings, which this replaces.
pub fn (c: Client) with_keepalive(p: ClientKeepalive) -> Client {
  let t = if p.time == 0s { 0s } else if p.time < 10s { 10s } else { p.time }
  c with {http: c.http.with_h2_config(http.H2Config{send_ping_timeout: t, ping_timeout: p.timeout})}
}

/// grpc-go's keepalive.ServerParameters: a connection with no call for `max_connection_idle` is closed (0 never),
/// and after `time` with nothing read the server sends a PING and closes the connection when no ack comes within
/// `timeout`. Times below 1 s are 1 s, as grpc-go's. MaxConnectionAge and MaxConnectionAgeGrace are not supported.
pub struct ServerKeepalive {
  pub max_connection_idle: Duration = 0s
  pub time: Duration = 7200s
  pub timeout: Duration = 20s
}

/// h with grpc-go's server keepalive (KeepaliveParams): its HTTP/2 settings' `send_ping_timeout` and
/// `ping_timeout`, which this replaces, and `with_idle_timeout` for `max_connection_idle`.
pub fn keepalive_server(h: http.Server, p: ServerKeepalive) -> http.Server {
  let t = if p.time < 1s { 1s } else { p.time }
  let out = h.with_h2_config(http.H2Config{send_ping_timeout: t, ping_timeout: p.timeout})
  if p.max_connection_idle > 0s { out.with_idle_timeout(p.max_connection_idle) } else { out }
}

/// A client of `base`: an `http://host:port` URL (plain HTTP/2 with prior knowledge), an `https://host:port` one, or a
/// grpc-go target name (grpc.NewClient's): `dns:///host:port` (an authority, `dns://server/host:port`, is the DNS
/// server grpc-go asks; std/http's resolver is used), `passthrough:///host:port`, or `host:port` with no scheme,
/// which grpc-go reads as `dns:///host:port`. A target name is called over plain HTTP/2; TLS takes an https URL.
pub fn client(c: http.Client, base: Str) -> Client {
  let url = target_url(base)
  let h = if url.starts_with("http://") { c.with_protocols(#{http.Protocol.UnencryptedHttp2}) } else { c }
  Client{http: h, base: url, gzip: false, target: base}
}

/// grpc-go's ClientConn.Target: the target as given to `client`.
pub fn (c: Client) target() -> Str {
  if c.target.is_empty() { c.base } else { c.target }
}

/// grpc-go's ClientConn.CanonicalTarget: a target name without a scheme gets grpc-go's default, `dns:///`; a URL or a
/// target with a scheme is as given.
pub fn (c: Client) canonical_target() -> Str {
  let t = c.target()
  if has_scheme(t) { t } else { "dns:///${t}" }
}

/// Whether t starts with a target or URL scheme (`dns:`, `passthrough:`, `unix:`, `http:`, ...): letters, digits,
/// `+`, `-` or `.` after a letter, then `:` and not a port's digits (`host:443` has none).
fn has_scheme(t: Str) -> Bool {
  let i = match t.find(":") {
    Some(i) => i
    None => return false
  }
  if i == 0 {
    return false
  }
  let rest = t[i + 1..].bytes()
  var digits = !rest.is_empty()
  for b in rest {
    if b < 48 || b > 57 {
      digits = false
    }
  }
  if digits {
    return false
  }
  let head = t[0..i].bytes()
  for (k, b) in head.indexed() {
    let letter = (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
    if !letter && (k == 0 || !((b >= 48 && b <= 57) || b == 43 || b == 45 || b == 46)) {
      return false
    }
  }
  true
}

/// The URL a target is called at: http and https URLs as they are; `dns:` and `passthrough:` names and a bare
/// `host:port` as `http://host:port`; any other scheme as given (the call then fails as an invalid URL).
fn target_url(t: Str) -> Str {
  if t.starts_with("http://") || t.starts_with("https://") {
    return t
  }
  for scheme in ["dns:", "passthrough:"] {
    if t.starts_with(scheme) {
      var rest = t[scheme.len()..]
      if rest.starts_with("//") {
        // //authority/endpoint: the endpoint after the authority
        let r = rest[2..]
        rest = match r.find("/") {
          Some(i) => r[i + 1..]
          None => r
        }
      }
      return "http://${rest}"
    }
  }
  if has_scheme(t) { t } else { "http://${t}" }
}

/// The client sending its messages gzip compressed (`grpc-encoding: gzip`); responses are read compressed or not.
pub fn (c: Client) with_gzip() -> Client {
  c with {gzip: true}
}

/// The client with a receive limit in bytes: a larger response message is `ResourceExhausted` (grpc-go's
/// MaxCallRecvMsgSize).
pub fn (c: Client) with_max_recv(n: Int) -> Client {
  c with {max_recv: n}
}

/// The client with a send limit in bytes: a larger request message is `ResourceExhausted` and is not sent
/// (grpc-go's MaxCallSendMsgSize).
pub fn (c: Client) with_max_send(n: Int) -> Client {
  c with {max_send: n}
}

fn send_too_large(n: Int, max: Int) -> Status {
  status_new(Code.ResourceExhausted, "trying to send message larger than max (${n} vs. ${max})")
}

/// One unary call: the request message, the response message, or the call's status. `timeout` is sent as
/// `grpc-timeout` and bounds the call (DeadlineExceeded).
pub fn (c: Client) unary(method: Str, req: Bytes, metadata: Map[Str, Str] = {}, timeout: Duration? = None) -> Bytes ! Status uses net.dial {
  let o = c.opts(metadata, timeout)
  let out = if c.unary_icpt.is_empty() {
    c.unary_call(method, req, o.metadata, o.timeout)
  } else {
    let me = c
    let g = pure1(fn(a: (Str, Bytes, CallOpts)) -> Result[Bytes, Status] { me.unary_call(a.0, a.1, a.2.metadata, a.2.timeout) })
    run_invoke(c.unary_icpt, 0, method, req, o, fn(m, r, oo) -> Bytes ! Status { g((m, r, oo)) })
  }
  c.finished(method, out)
  out
}

/// One unary call, after the interceptors.
fn (c: Client) unary_call(method: Str, req: Bytes, metadata: Map[Str, Str], timeout: Duration?) -> Bytes ! Status uses net.dial {
  let body = frame_msg(req, c.gzip)
  if body.len() - 5 > c.max_send {
    return Err(send_too_large(body.len() - 5, c.max_send))
  }
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip), body)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let st = match c.http.open(r) {
    Ok(s) => s
    Err(e) => return Err(from_client_err(e))
  }
  if let Some(e) = head_status(st.head()) {
    st.close()
    return Err(e)
  }
  let data = match st.read_all() {
    Ok(b) => b
    Err(e) => {
      st.close()
      return Err(from_client_err(e))
    }
  }
  let fin = final_status(st)
  let enc = st.head().headers.get("Grpc-Encoding") ?? ""
  st.close()
  if fin.code != Code.Ok {
    return Err(fin)
  }
  match pull(RecvState{buf: data, at: 0, done: true, gzip: enc == "gzip"}, c.max_recv, fn() -> Bytes? ! Status { Ok(None) }) {
    Ok((Some(msg), _)) => Ok(msg)
    Ok((None, _)) => Err(status_new(Code.Internal, "grpc: no response message"))
    Err(e) => Err(e)
  }
}

/// The client side of a streaming call, valid inside `Client.call`.
pub struct ClientCall {
  pub w: http.PipeWriter
  pub head: Chan[(http.ClientStream?, Status?)]
  pub st: Mutex[CallState]
  pub max: Int
  /// messages are sent gzip compressed (Client.with_gzip)
  pub gzip: Bool = false
  /// the client's send limit (Client.with_max_send)
  pub max_send: Int = 2147483647
}

pub struct CallState {
  pub stream: http.ClientStream? = None
  pub failed: Status? = None
  pub recv: RecvState = RecvState{}
  pub final: Status? = None
  /// the response's header and trailer metadata (ClientCall.header, ClientCall.trailer)
  pub header: Map[Str, Str] = {}
  pub trailer: Map[Str, Str] = {}
}

/// Runs `f` on a streaming call: `f` sends with `send`, ends the request with `close_send` and reads with `recv`.
/// The call's status is the result of `recv` after the last message (an error when it is not OK).
pub fn (c: Client) call[R, fx: Effects](method: Str, metadata: Map[Str, Str], timeout: Duration?, f: fn(ClientCall) -> R ! Status uses fx) -> R ! Status uses (fx, net.dial) {
  var o = c.opts(metadata, timeout)
  for ic in c.stream_icpt {
    match ic(method, o) {
      Ok(x) => o = x
      Err(e) => {
        c.finished(method, Err[(), Status](e))
        return Err(e)
      }
    }
  }
  let out = c.call_opened(method, o.metadata, o.timeout, f)
  c.finished(method, out)
  out
}

/// One streaming call, after the interceptors.
fn (c: Client) call_opened[R, fx: Effects](method: Str, metadata: Map[Str, Str], timeout: Duration?, f: fn(ClientCall) -> R ! Status uses fx) -> R ! Status uses (fx, net.dial) {
  let (pw, pr) = http.pipe()
  var r = http.new_request("POST", "${c.base}${method}", call_headers(metadata, timeout, c.gzip)).with_body_reader(pr)
  if let Some(d) = timeout {
    r = r.with_timeout(d)
  }
  let head = Chan[(http.ClientStream?, Status?)].new(1)
  let cc = ClientCall{w: pw, head: head, st: Mutex[CallState].new(CallState{stream: None, failed: None, recv: RecvState{buf: b"", at: 0, done: false}, final: None}), max: c.max_recv, gzip: c.gzip, max_send: c.max_send}
  var result: R? = None
  var failure: Status? = None
  scope s {
    s.spawn(fn() {
      match c.http.open(r) {
        Ok(st) => head.send((Some(st), None))
        Err(e) => head.send((None, Some(from_client_err(e))))
      }
    })
    match f(cc) {
      Ok(v) => {
        result = Some(v)
      }
      Err(e) => {
        failure = Some(e)
      }
    }
    pw.close()
    // release the stream, also when f never read the call to its end
    var open_stream = cc.st.with(fn(var s) { s.stream })
    let consumed = cc.st.with(fn(var s) { s.failed.is_some() })
    if open_stream.is_none() && !consumed {
      match head.recv() {
        Some((Some(x), _)) => {
          open_stream = Some(x)
        }
        _ => {}
      }
    }
    if let Some(x) = open_stream {
      x.close()
    }
  }
  if let Some(e) = failure {
    return Err(e)
  }
  Ok(result ?? fault("grpc call produced no result"))
}

/// Sends one message.
pub fn (c: ClientCall) send(msg: Bytes) -> () ! Status {
  let f = frame_msg(msg, c.gzip)
  if f.len() - 5 > c.max_send {
    return Err(send_too_large(f.len() - 5, c.max_send))
  }
  match c.w.write(f) {
    Ok(_) => Ok(())
    Err(e) => Err(status_new(Code.Unavailable, "${e}"))
  }
}

/// Ends the request stream.
pub fn (c: ClientCall) close_send() {
  c.w.close()
}

/// The next response message; None at the end of an OK call, the status as an error otherwise.
/// Waits for the response's head when it has not come yet: the stream, or the call's failure.
fn await_head(c: ClientCall, var s: CallState) -> () ! Status uses sync {
  if s.stream.is_some() {
    return Ok(())
  }
  match c.head.recv() {
    Some((Some(st), _)) => {
      // a response that is not gRPC ends the call at its head (grpc-go's operateHeaders, task #115)
      if let Some(e) = head_status(st.head()) {
        st.close()
        s.failed = Some(e)
        return Err(e)
      }
      s.stream = Some(st)
      s.header = metadata_of(st.head().headers)
      s.recv = s.recv with {gzip: (st.head().headers.get("Grpc-Encoding") ?? "") == "gzip"}
      if st.head().headers.get("Grpc-Status").is_some() {
        // trailers only: what it carries is the trailer metadata (grpc-go)
        s.trailer = s.header
        s.header = {}
      }
      Ok(())
    }
    Some((None, Some(e))) => {
      s.failed = Some(e)
      Err(e)
    }
    _ => Err(status_new(Code.Internal, "grpc: no response"))
  }
}

/// The metadata of a response's head or trailers as grpc-go's client gives it: lower case names, without the
/// reserved ones (`grpc-status`, `grpc-message`, `grpc-encoding`, `grpc-timeout`, `te`; `content-type` kept).
/// `-bin` values stay base64 (`bin_decode`).
fn metadata_of(h: Map[Str, Str]) -> Map[Str, Str] {
  var md: Map[Str, Str] = {}
  for (k, v) in h {
    let lk = k.to_lower()
    if lk.starts_with(":") || lk == "grpc-message-type" || lk == "grpc-encoding" || lk == "grpc-message" || lk == "grpc-status" || lk == "grpc-timeout" || lk == "te" {
      continue
    }
    md[lk] = v
  }
  md
}

/// The response's header metadata, waiting for the head: grpc-go's `grpc.Header` call option and
/// `ClientStream.Header`. Empty for a trailers only response (its metadata is the trailer's).
pub fn (c: ClientCall) header() -> Map[Str, Str] ! Status {
  let out = c.st.with(fn(var s) -> Result[Map[Str, Str], Status] uses sync {
    if s.stream.is_none() {
      if let Some(e) = s.failed {
        return Err(e)
      }
    }
    if let Err(e) = await_head(c, s) {
      return Err(e)
    }
    Ok(s.header)
  })
  out
}

/// The response's trailer metadata (grpc-go's `grpc.Trailer` call option and `ClientStream.Trailer`): complete once
/// `recv` returned None or the call's status; empty before.
pub fn (c: ClientCall) trailer() -> Map[Str, Str] {
  c.st.with_read(fn(s) { s.trailer })
}

pub fn (c: ClientCall) recv() -> Bytes? ! Status uses net.dial {
  let out = c.st.with(fn(var s) -> Result[Bytes?, Status] uses (net.dial, sync) {
    if let Some(e) = s.failed {
      return Err(e)
    }
    if let Some(fin) = s.final {
      return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
    }
    if let Err(e) = await_head(c, s) {
      return Err(e)
    }
    let stream = s.stream ?? fault("stream")
    let res = pull(s.recv, c.max, fn() -> Bytes? ! Status uses net.dial {
      match stream.read() {
        Ok(d) => Ok(d)
        Err(e) => Err(from_client_err(e))
      }
    })
    match res {
      Ok((msg, ns)) => {
        s.recv = ns
        if msg.is_none() {
          let fin = final_status(stream)
          if !stream.trailers().is_empty() {
            s.trailer = metadata_of(stream.trailers())
          }
          stream.close()
          s.final = Some(fin)
          return if fin.code == Code.Ok { Ok(None) } else { Err(fin) }
        }
        Ok(msg)
      }
      Err(e) => {
        // a stream cut short whose trailers carry a grpc-status that does not parse: that error, as grpc-go,
        // whose transport queues it after the data (TestGrpcFuzz, task #115)
        let err = if e.message == "unexpected EOF" {
          let fin = final_status(stream)
          if fin.message.starts_with("transport: malformed grpc-status") { fin } else { e }
        } else {
          e
        }
        stream.close()
        s.failed = Some(err)
        Err(err)
      }
    }
  })
  out
}

/// The frame of msg, gzip compressed when gzip.
fn frame_msg(msg: Bytes, gzip: Bool) -> Bytes {
  if gzip {
    return frame(compress.gzip(msg), true)
  }
  frame(msg)
}

fn hex_val(c: Int) -> Int {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 65 && c <= 70 {
    c - 55
  } else if c >= 97 && c <= 102 {
    c - 87
  } else {
    -1
  }
}

fn status_new(code: Code, message: Str) -> Status {
  Status{code: code, message: message, details: b""}
}

fn reserved(name: Str) -> Bool {
  name.starts_with("grpc-") || name == "content-type" || name == "te"
}

fn finish(w: http.BodyWriter, st: Status) {
  w.set_trailer("grpc-status", "${st.code.number()}")
  if st.message != "" {
    w.set_trailer("grpc-message", encode_message(st.message))
  }
  if !st.details.is_empty() {
    w.set_trailer("grpc-status-details-bin", bin_encode(st.details))
  }
}

/// The next message of the stream whose buffered state is `st`, reading more with `more` (None at its end).
fn pull[fx: Effects](st: RecvState, max: Int, more: fn() -> Bytes? ! Status uses fx) -> (Bytes?, RecvState) ! Status uses fx {
  var s = st
  while true {
    match unframe(s.buf, s.at, max) {
      Ok((compressed, msg, next)) => {
        s.at = next
        if compressed {
          if !s.gzip {
            return Err(status_new(Code.Internal, "grpc: compressed message received without a grpc-encoding"))
          }
          // grpc-go's decompress for a registered compressor (rpc_util.go): the limit and its text
          match compress.gunzip(msg, max) {
            Ok(plain) => return Ok((Some(plain), s))
            Err(e) => {
              if e.msg.contains("exceeds max_size") {
                return Err(status_new(Code.ResourceExhausted, "grpc: received message after decompression larger than max ${max}"))
              }
              return Err(status_new(Code.Internal, "grpc: failed to decompress the received message"))
            }
          }
        }
        return Ok((Some(msg), s))
      }
      Err(FrameErr.TooLarge(len)) => {
        return Err(status_new(Code.ResourceExhausted, "grpc: received message larger than max (${len} vs. ${max})"))
      }
      Err(FrameErr.BadFlag(flag)) => {
        return Err(status_new(Code.Internal, "grpc: received message with invalid compression flag ${flag}"))
      }
      Err(FrameErr.Truncated) => {
        if s.done {
          if s.at == s.buf.len() {
            return Ok((None, s))
          }
          return Err(status_new(Code.Internal, "unexpected EOF"))
        }
        match more()? {
          Some(d) => {
            var b = BytesBuilder.with_capacity(s.buf.len() - s.at + d.len())
            b.write(s.buf[s.at..])
            b.write(d)
            s.buf = b.freeze()
            s.at = 0
          }
          None => {
            s.done = true
          }
        }
      }
    }
  }
  Ok((None, s))
}

fn trailers_only(st: Status) -> http.Response {
  http.stream(200, fn(w) -> () ! IoErr {
    finish(w, st)
  }).with_header("content-type", "application/grpc").with_header("date", "")
}

fn serve_call[fx: Effects](f: fn(Call, Recv, Send) -> () ! Status uses fx, clock: Clock, max: Int, max_send: Int, method: Str, req: http.Request, body: http.BodyReader) -> http.Response uses (fx, clock) {
  let ct = req.header("content-type") ?? ""
  if !ct.starts_with("application/grpc") {
    return http.empty(415)
  }
  let gz = (req.header("grpc-encoding") ?? "") == "gzip"
  var timeout: Duration? = None
  if let Some(t) = req.header("grpc-timeout") {
    match decode_timeout(t) {
      Some(ns) => {
        timeout = Some(Duration.from_nanos(ns))
      }
      None => return trailers_only(status_new(Code.Internal, "malformed grpc-timeout"))
    }
  }
  var md: Map[Str, Str] = {}
  for (k, v) in req.headers {
    let lk = k.to_lower()
    if !reserved(lk) {
      md[lk] = v
    }
  }
  let call = Call{method: method, metadata: md, timeout: timeout, peer: req.remote_ip}
  let recv = Recv{body: body, st: Mutex[RecvState].new(RecvState{buf: b"", at: 0, done: false, gzip: (req.header("grpc-encoding") ?? "") == "gzip"}), max: max}
  // the head grpc-go's server writes: content-type, and grpc-encoding only when the responses are compressed
  var resp = http.stream(200, fn(w) -> () ! IoErr {
    let send = Send{w: w, gzip: gz, max_send: max_send}
    let st = match timeout {
      Some(d) => match task.with_timeout(clock, d, fn() -> () ! Status { f(call, recv, send) }) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(task.Timed.TimedOut) => status_new(Code.DeadlineExceeded, "context deadline exceeded")
        Err(task.Timed.Failed(e)) => e
      }
      None => match f(call, recv, send) {
        Ok(_) => Status{code: Code.Ok, message: "", details: b""}
        Err(e) => e
      }
    }
    finish(w, st)
  }).with_header("content-type", "application/grpc").with_header("date", "").with_full_duplex()
  if gz {
    resp = resp.with_header("grpc-encoding", "gzip")
  }
  resp
}

fn from_client_err(e: http.ClientErr) -> Status {
  match e {
    Timeout => status_new(Code.DeadlineExceeded, "context deadline exceeded")
    Canceled => status_new(Code.Canceled, "context canceled")
    Connect(msg) => status_new(Code.Unavailable, "connection error: ${msg}")
    // the connection lost under the call (a keepalive ping not acked, the server gone): grpc-go's transport
    // closing is Unavailable; x/net's errClientConnLost text, the same on the native backends
    Protocol(msg) => if msg.ends_with("http2: client connection lost") { status_new(Code.Unavailable, msg) } else { status_new(Code.Internal, msg) }
    InvalidUrl(msg) => status_new(Code.Internal, "invalid URL: ${msg}")
    // a TLS failure was Protocol before ClientErr.Tls (decision 0644):
    // the same status and text (grpc-go says Unavailable for a failed
    // handshake, a follow-up)
    Tls(err) => status_new(Code.Internal, err.msg)
  }
}

fn call_headers(metadata: Map[Str, Str], timeout: Duration?, gzip: Bool) -> Map[Str, Str] {
  var h: Map[Str, Str] = {}
  for (k, v) in metadata {
    h[k.to_lower()] = v
  }
  h["content-type"] = "application/grpc"
  h["te"] = "trailers"
  h["grpc-accept-encoding"] = "gzip,identity"
  if gzip {
    h["grpc-encoding"] = "gzip"
  }
  h["user-agent"] = "grpc-xo/0.1"
  if let Some(d) = timeout {
    h["grpc-timeout"] = encode_timeout(d.nanos())
  }
  h
}

fn http_to_code(status: Int) -> Code {
  if status == 400 {
    Code.Internal
  } else if status == 401 {
    Code.Unauthenticated
  } else if status == 403 {
    Code.PermissionDenied
  } else if status == 404 {
    Code.Unimplemented
  } else if status == 429 || status == 502 || status == 503 || status == 504 {
    Code.Unavailable
  } else {
    Code.Unknown
  }
}

/// Whether ct is a gRPC content-type (grpc-go's grpcutil.ContentSubtype): `application/grpc`, alone or followed
/// by `+` or `;`, compared as written (case and all).
fn grpc_content_type(ct: Str) -> Bool {
  if !ct.starts_with("application/grpc") {
    return false
  }
  if ct.len() == 16 {
    return true
  }
  let c = ct.bytes()[16]
  c == 43 || c == 59
}

/// s as Go's %q writes an ASCII string.
fn go_quote(s: Str) -> Str {
  let hex = "0123456789abcdef"
  var b = BytesBuilder.new()
  b.write_byte(34)
  for c in s.bytes() {
    let n = Int(c)
    if n == 34 || n == 92 {
      b.write_byte(92)
      b.write_byte(c)
    } else if n < 32 || n == 127 {
      b.write("\\x".bytes())
      b.write(hex.bytes()[n / 16..n / 16 + 1])
      b.write(hex.bytes()[n % 16..n % 16 + 1])
    } else {
      b.write_byte(c)
    }
  }
  b.write_byte(34)
  b.freeze().to_str() ?? s
}

/// The status of a response that is not gRPC, None for one that is (grpc-go's operateHeaders): a response whose
/// content-type is not gRPC's ends the call with the code of its HTTP status (Unknown for one with none, 200
/// among them) and grpc-go's text, whatever its grpc-status says, and with no message read; a gRPC response's
/// HTTP status is not looked at.
fn head_status(head: http.ResponseHead) -> Status? {
  // a grpc-status that does not parse ends the call first, whatever else the head says
  if let Some(gs) = head.headers.get("Grpc-Status") {
    if let Err(e) = parse_int32(gs) {
      return Some(malformed_status(gs, e))
    }
  }
  let ct_err = match head.headers.get("Content-Type") {
    Some(ct) => {
      if grpc_content_type(ct) {
        return None
      }
      "transport: received unexpected content-type ${go_quote(ct)}"
    }
    None => "malformed header: missing HTTP content-type"
  }
  Some(status_new(http_to_code(head.status), "unexpected HTTP status code received from server: ${head.status} (${http.status_text(head.status)}); ${ct_err}"))
}

/// Go's strconv.ParseInt(s, 10, 32): the value, or the error's text after `parsing "S": `.
fn parse_int32(s: Str) -> Int ! Str {
  let b = s.bytes()
  var i = 0
  var neg = false
  if b.len() > 0 && (b[0] == 43 || b[0] == 45) {
    neg = b[0] == 45
    i = 1
  }
  if i == b.len() {
    return Err("invalid syntax")
  }
  var n = 0
  var big = false
  while i < b.len() {
    let c = Int(b[i])
    if c < 48 || c > 57 {
      return Err("invalid syntax")
    }
    if !big {
      n = n * 10 + (c - 48)
      if n > 2147483648 {
        big = true
      }
    }
    i += 1
  }
  if big || (!neg && n > 2147483647) {
    return Err("value out of range")
  }
  Ok(if neg { -n } else { n })
}

/// The call's status from a finished stream (its head already found to be gRPC's): its trailers, or the head of
/// a trailers only response, as grpc-go reads them: no grpc-status is Unknown with the grpc-message, one that
/// ParseInt refuses is Unknown with its error, and a number past the 17 codes is Unknown (grpc-go keeps the
/// number as its code; Code has no case for it).
fn final_status(st: http.ClientStream) -> Status {
  let head = st.head()
  if let Some(e) = head_status(head) {
    return e
  }
  let tr = st.trailers()
  let msg = decode_message(tr.get("Grpc-Message") ?? (head.headers.get("Grpc-Message") ?? ""))
  let gs = match tr.get("Grpc-Status") ?? head.headers.get("Grpc-Status") {
    Some(v) => v
    None => return status_new(Code.Unknown, msg)
  }
  match parse_int32(gs) {
    Ok(n) => {
      let raw = tr.get("Grpc-Status-Details-Bin") ?? (head.headers.get("Grpc-Status-Details-Bin") ?? "")
      Status{code: code_from(n) ?? Code.Unknown, message: msg, details: if raw == "" { b"" } else { bin_decode(raw) ?? b"" }}
    }
    Err(e) => malformed_status(gs, e)
  }
}

fn malformed_status(gs: Str, e: Str) -> Status {
  status_new(Code.Unknown, "transport: malformed grpc-status: strconv.ParseInt: parsing ${go_quote(gs)}: ${e}")
}
