// std/backoff (spec/std.md 43, std survey gap 15).
// Encoding rules are listed at the top of std/prelude.xo. Exponential
// backoff with jitter, a retry loop and a ticker, cenkalti/backoff v4's
// ExponentialBackOff, Retry and Ticker. The Clock and Rand are given per call,
// so a test's virtual clock and seeded Rand make it deterministic.
//
// std/backoff on the native backends and the Go backend (spec/std.md
// 43): cenkalti/backoff v4's ExponentialBackOff (NextBackOff,
// incrementCurrentInterval, getRandomValueFromInterval; Copyright (c)
// 2014 Cenk Altı, MIT license) and Retry, over the Clock and Rand the
// caller gives.

/// The schedule (cenkalti/backoff v4's defaults): the first delay is
/// `initial`, each next one `multiplier` times the last up to
/// `max_interval`, each randomized within `randomization` of itself.
pub struct Backoff {
  pub initial: Duration = 500ms
  pub multiplier: Float = 1.5
  /// A delay d is drawn from [d - r d, d + r d]; 0 is no jitter.
  pub randomization: Float = 0.5
  pub max_interval: Duration = 60s
  /// retry stops when the next sleep would pass this since the first
  /// try; 0s is no limit.
  pub max_elapsed: Duration = 15m
  /// The most calls of op; 0 is no limit.
  pub max_tries: Int = 0
}

/// The delay before retry number attempt (0 for the first retry):
/// `initial` times `multiplier` attempt times, capped at `max_interval`,
/// randomized with one `rand.float()`.
pub fn (b: Backoff) delay(attempt: Int, rand: Rand) -> Duration uses rand {
  randomized(b.randomization, rand.float(), interval(b, attempt))
}

/// Calls op until it succeeds, `retryable(e)` is false, or a limit of b
/// runs out, and then answers op's last result; sleeps on clock between
/// tries (a cancellation point: a cancelled task unwinds there).
pub fn retry[T, E, fx: Effects](b: Backoff, clock: Clock, rand: Rand, op: fn() -> T ! E uses fx, retryable: fn(E) -> Bool) -> T ! E uses (clock, rand, fx) {
  let start = clock.now()
  var tries = 0
  while {
    tries += 1
    match op() {
      Ok(v) => return Ok(v)
      Err(e) => {
        if !retryable(e) || (b.max_tries > 0 && tries >= b.max_tries) {
          return Err(e)
        }
        let d = b.delay(tries - 1, rand)
        // Go's NextBackOff: Stop once elapsed + next passes MaxElapsedTime
        if b.max_elapsed > 0s && clock.since(start) + d > b.max_elapsed {
          return Err(e)
        }
        clock.sleep(d)
      }
    }
  }
}

/// retry, calling notify(e, d) with each error before sleeping d
/// (cenkalti/backoff v4's RetryNotify): to log or count the retries.
/// retryable and notify may have effects of their own (each its own
/// effect variable: op's need not include a log's).
pub fn retry_notify[T, E, fx: Effects, rx: Effects, nx: Effects](b: Backoff, clock: Clock, rand: Rand, op: fn() -> T ! E uses fx, retryable: fn(E) -> Bool uses rx, notify: fn(E, Duration) -> () uses nx) -> T ! E uses (clock, rand, fx, rx, nx) {
  let start = clock.now()
  var tries = 0
  while {
    tries += 1
    match op() {
      Ok(v) => return Ok(v)
      Err(e) => {
        if !retryable(e) || (b.max_tries > 0 && tries >= b.max_tries) {
          return Err(e)
        }
        let d = b.delay(tries - 1, rand)
        if b.max_elapsed > 0s && clock.since(start) + d > b.max_elapsed {
          return Err(e)
        }
        notify(e, d)
        clock.sleep(d)
      }
    }
  }
}

/// A retryable that retries every error.
pub fn always[E]() -> fn(E) -> Bool {
  fn(_e: E) { true }
}

/// A ticker's state. Internal: use `next` and `stop`.
pub struct TickState {
  pub ticks: Int
  /// when the next tick is due; None once the schedule ended or stop ran
  pub due: Time?
  pub start: Time
}

/// Ticks at the backoff's delays (cenkalti/backoff v4's Ticker): the
/// first at once, each next one the next delay after the last, until
/// `max_tries` ticks, `max_elapsed`, or `stop`. Go sends on a channel
/// from a goroutine; here the caller pulls: `next` sleeps on the clock
/// until the tick is due. A handle: copies share the schedule; one task
/// reads the ticks (two would each get the same tick).
pub struct Ticker {
  pub b: Backoff
  pub clock: Clock[clock]
  pub rand: Rand[rand]
  pub st: Mutex[TickState]
}

/// A ticker of b on clock, drawing its jitter from rand (NewTicker; the
/// clock is NewTickerWithTimer's Timer). Its schedule starts now.
pub fn ticker(b: Backoff, clock: Clock[clock], rand: Rand[rand]) -> Ticker uses clock {
  let now = clock.now()
  Ticker{b: b, clock: clock, rand: rand, st: Mutex[TickState].new(TickState{ticks: 0, due: Some(now), start: now})}
}

/// The next tick's time, after sleeping until it is due (a cancellation
/// point), or None once the schedule has ended or `stop` ran. As Go's
/// run does after each tick is taken, the delay to the next tick is drawn
/// when this one is given, and the schedule ends when the time since the
/// start plus that delay passes `max_elapsed` (NextBackOff's Stop).
pub fn (t: Ticker) next() -> Time? uses (clock, rand) {
  let due = match t.st.with_read(fn(s: TickState) -> Time? { s.due }) {
    Some(x) => x
    None => return None
  }
  let now = t.clock.now()
  if due > now {
    t.clock.sleep(due - now)
  }
  let tick = t.clock.now()
  let gave = t.st.with(fn(var s: TickState) -> Bool uses (rand, sync) {
    if s.due is None {
      // stopped while this call slept
      return false
    }
    s.ticks += 1
    if t.b.max_tries > 0 && s.ticks >= t.b.max_tries {
      s.due = None
      return true
    }
    let d = t.b.delay(s.ticks - 1, t.rand)
    if t.b.max_elapsed > 0s && tick - s.start + d > t.b.max_elapsed {
      s.due = None
    } else {
      s.due = Some(tick + d)
    }
    true
  })
  if gave { Some(tick) } else { None }
}

/// Ends the ticks (Ticker.Stop): `next` answers None from now on, also a
/// call sleeping toward its tick. Stopping twice is fine.
pub fn (t: Ticker) stop() {
  t.st.with(fn(var s: TickState) { s.due = None })
}

/// The interval before randomizing for retry number attempt: Go's
/// currentInterval after attempt calls of incrementCurrentInterval.
fn interval(b: Backoff, attempt: Int) -> Duration {
  var ci = b.initial
  var k = 0
  while k < attempt {
    // Go: float64(ci) >= float64(MaxInterval)/Multiplier caps it; a
    // multiplier below 1 then shrinks it again, so the walk ends only at a
    // fixed point (max_interval when the multiplier is at least 1, or 0)
    let next = if Float(ci.nanos()) >= Float(b.max_interval.nanos()) / b.multiplier {
      b.max_interval
    } else {
      Duration.from_nanos(Int(Float(ci.nanos()) * b.multiplier))
    }
    if next == ci {
      break
    }
    ci = next
    k += 1
  }
  ci
}

/// Go's getRandomValueFromInterval: min + r (max - min + 1) nanoseconds.
fn randomized(factor: Float, r: Float, ci: Duration) -> Duration {
  if factor == 0.0 {
    return ci
  }
  let c = Float(ci.nanos())
  let delta = factor * c
  let lo = c - delta
  let hi = c + delta
  Duration.from_nanos(Int(lo + r * (hi - lo + 1.0)))
}
