test "long labels encode as x/net's" {
  for (s, want, fails) in LONG {
    match to_ascii(s) {
      Ok(a) => {
        expect(fails) == false
        expect(a) == want
        // and back
        expect(to_unicode(a) ?? e => "error ${e.display()}") == s
      }
      Err(_) => expect(fails) == true
    }
  }
}

test "a label of 64,000 distinct runes encodes in n log n" {
  var b = StrBuilder.new()
  for i in 0..64000 {
    b.write("${Rune.try(0x4E00 + i % 20000).or_fault("rune")}")
  }
  let a = to_ascii(b.freeze()) ?? e => "error ${e.display()}"
  expect(a.len()) == 188462
}

test "a punycode label that decodes to ASCII only is an invalid label (GO-2026-5026)" {
  // x/net's fix (CL 767220): ToUnicode("xn--example-.com") gave
  // "example.com" with no error before it
  for p in [Profile.Lookup, Profile.Display, Profile.Registration] {
    expect(to_unicode("xn--example-.com", p) ?? e => "error ${e.display()}") == "error idna: invalid label \"example-\""
    expect(to_ascii("xn--example-.com", p) ?? e => "error ${e.display()}") == "error idna: invalid label \"example-\""
  }
  // a label with a non-ASCII rune still decodes
  expect(to_unicode("xn--caf-dma.com") ?? e => "error ${e.display()}") == "café.com"
}

test "a punycode label decodes to at most 1024 runes, as x/net's" {
  // x/net v0.60.0: 1024 runes round trip, 1025 are an invalid label
  let at = "é".repeat(1024)
  let a = to_ascii(at) ?? e => "error ${e.display()}"
  expect(a.len()) == 1030
  expect(to_unicode(a) ?? e => "error ${e.display()}") == at
  let past = to_ascii("é".repeat(1025)) ?? e => "error ${e.display()}"
  expect(past.len()) == 1031
  match to_unicode(past) {
    Ok(_) => expect("decoded") == "an error"
    Err(e) => expect(e.display().starts_with("idna: invalid label \"9caaaa")) == true
  }
}
