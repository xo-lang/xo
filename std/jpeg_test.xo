// Go's image/jpeg (go1.26.11) on frame headers that ask for a large image
// whose scan data runs out: Go's errors. Go's make returns pages the system
// zeroes on first touch, so such a file costs Go almost nothing; std/jpeg
// grows its planes and coefficients only as far as the scans reach, so it
// fails as early (a 20 KB progressive file asking for 10000x10000 touched
// 1.5 GB and took 1.1 s before; 4 MB and under 1 ms after, on a Mac).

/// Go's encoding of a 16x16 gray image at quality 75 with its SOF0 frame
/// header changed to 10000x10000.
const BASELINE_BIG: Str = ""

/// Go's video-001.progressive.jpeg (image/testdata) cut 64 bytes into its
/// first scan, with its SOF2 frame header changed to 10000x10000.
const PROGRESSIVE_BIG: Str = ""

fn hb(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

test "a large frame whose scan data runs out fails as Go's decoder does" {
  match decode(hb(BASELINE_BIG)) {
    Ok(_) => expect("decoded") == "an error"
    Err(e) => expect(e.display()) == "invalid JPEG format: missing 0xff00 sequence"
  }
  match decode(hb(PROGRESSIVE_BIG)) {
    Ok(_) => expect("decoded") == "an error"
    Err(e) => expect(e.display()) == "invalid JPEG format: short Huffman data"
  }
  let c = decode_config(hb(PROGRESSIVE_BIG)) ?? e => return expect(e.display()) == "a config"
  expect((c.width, c.height)) == (10000, 10000)
}

test "max_pixels refuses a frame one pixel past it" {
  match decode(hb(PROGRESSIVE_BIG), 99999999) {
    Ok(_) => expect("decoded") == "an error"
    Err(e) => expect(e.display()) == "invalid JPEG format: image too large"
  }
  match decode(hb(BASELINE_BIG), 99999999) {
    Ok(_) => expect("decoded") == "an error"
    Err(e) => expect(e.display()) == "invalid JPEG format: image too large"
  }
}

