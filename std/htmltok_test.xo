// Hand written cases for std/htmltok (decision 0548); the differential against Go's Tokenizer is
// internal/stdtest/testdata/corpus/htmltok.
fn types(src: Str) -> List[TokenType] {
  var z = tokenizer(src)
  var out: List[TokenType] = []
  while true {
    let t = z.next()
    if t == TokenType.Error {
      break
    }
    out.push(t)
  }
  out
}

test "tags, text and the end" {
  var z = tokenizer("<a href=\"x&amp;y\" B=1>t&lt;</a><br/>")
  expect(z.next() == TokenType.StartTag) == true
  let a = z.token()
  expect(a.data) == "a"
  expect(a.attrs.len()) == 2
  expect(a.attrs[0].key) == "href"
  expect(a.attrs[0].val) == "x&y"
  expect(a.attrs[1].key) == "b"
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "t<"
  expect(z.next() == TokenType.EndTag) == true
  expect(z.raw()) == "</a>"
  expect(z.next() == TokenType.SelfClosingTag) == true
  expect(z.next() == TokenType.Error) == true
  expect(z.err()) == Some("EOF")
}

test "script and textarea are raw text" {
  var z = tokenizer("<script>a<b>&amp;</script><textarea>x<b>&amp;</textarea>")
  expect(z.next() == TokenType.StartTag) == true
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "a<b>&amp;"
  expect(z.next() == TokenType.EndTag) == true
  expect(z.next() == TokenType.StartTag) == true
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "x<b>&"
}

test "comments, doctypes and CDATA" {
  expect(types("<!--c--><!DOCTYPE html><?pi?>").len()) == 3
  var z = tokenizer("<![CDATA[x]]>")
  expect(z.next() == TokenType.Comment) == true
  var w = tokenizer("<![CDATA[x]]>")
  w.allow_cdata(true)
  expect(w.next() == TokenType.Text) == true
  expect(w.token().data) == "x"
}

test "the buffer limit" {
  var z = tokenizer("<a b=cccccccccc>")
  z.set_max_buf(5)
  expect(z.next() == TokenType.Error) == true
  expect(z.err()) == Some("max buffer exceeded")
}

test "attribute entities keep a legacy name before an equals sign" {
  var z = tokenizer("<a b=\"?x=1&copy=2&copy;\">")
  expect(z.next() == TokenType.StartTag) == true
  expect(z.token().attrs[0].val) == "?x=1&copy=2\u{00A9}"
}

test "fragment contexts" {
  var z = tokenizer_fragment("a<b>&amp;", "title")
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "a<b>&"
  var p = tokenizer_fragment("<b>x", "plaintext")
  expect(p.next() == TokenType.Text) == true
  expect(p.token().data) == "<b>x"
}

test "numeric references below 128 are their ASCII character" {
  var z = tokenizer("&#65;&#x7a;&#1;&#127;&#0;&#9;b&#128;")
  expect(z.next()) == TokenType.Text
  expect(z.token().data) == "Az\u{1}\u{7F}\u{FFFD}\u{9}b\u{20AC}"
}

test "token takes the token's data, as Go's Token: a second call is empty" {
  // outputs of x/net v0.62.0 (Token twice, then TagAttr and TagName)
  for (input, want) in [("<a b=c d=e>x", "<a b=\"c\" d=\"e\">|<> 2|0 = false  false"), ("</p q=r>", "</p>|</> 0|0 = false  false"), ("<!--c-->", "<!--c-->|<!----> 0|0 = false  false")] {
    var z = tokenizer(input)
    let _ = z.next()
    let t1 = z.token()
    let t2 = z.token()
    let (k, v, m) = z.tag_attr()
    let (n, h) = z.tag_name()
    expect("${t1.display()}|${t2.display()} ${t1.attrs.len()}|${t2.attrs.len()} ${k}=${v} ${m} ${n} ${h}") == want
  }
}

test "nLt; and nGt; are x/net's two code point references (escape_test.go)" {
  expect(unescape_string("&nLt;hello")) == "\u{226A}\u{20D2}hello"
  expect(unescape_string("a&nGt;b")) == "a\u{226B}\u{20D2}b"
  expect(unescape_string("&nLt;&lt;")) == "\u{226A}\u{20D2}<"
  var z = tokenizer("<a title=\"&nGt;\">&nLt;</a>")
  expect(z.next()) == TokenType.StartTag
  expect(z.token().display()) == "<a title=\"\u{226B}\u{20D2}\">"
  expect(z.next()) == TokenType.Text
  expect(z.token().display()) == "\u{226A}\u{20D2}"
}

// b51 (the owner's v0.51.1 evaluation, task #240): each attribute key was
// compared with every key before it, so 40,000 attributes took 13 s. Past 16
// keys a tag keeps them in a map, as Go's attrNames; the budget is 2 s (a
// time-budget guard), and the first of each key still wins, case folded.
test "a tag with 40,000 attributes drops its duplicates in linear time" uses clock {
  var s = "<p"
  for i in 0..40000 {
    s += " a${i}=${i}"
  }
  s += " A7=x a39999=y b=1 a0=z>"
  var z = tokenizer(s)
  let t0 = os.clock.now()
  expect(z.next() == TokenType.StartTag) == true
  let t = z.token()
  let took = os.clock.now() - t0
  expect(t.attrs.len()) == 40001
  expect(t.attrs[7].val) == "7"
  expect(t.attrs[39999].val) == "39999"
  expect(t.attrs[40000].key) == "b"
  expect(took < 2000ms) == true
}

test "the first of each attribute key wins, case folded, below and past 16 keys" {
  var small = tokenizer("<p a=1 B=2 A=3 b=4 c=5>")
  let _ = small.next()
  let st = small.token()
  expect(st.attrs.len()) == 3
  expect(st.attrs[1].key) == "b"
  expect(st.attrs[1].val) == "2"
  var s = "<p"
  for i in 0..20 {
    s += " k${i}=${i}"
  }
  s += " K3=x k19=y K20=z k20=w>"
  var big = tokenizer(s)
  let _ = big.next()
  let bt = big.token()
  expect(bt.attrs.len()) == 21
  expect(bt.attrs[3].val) == "3"
  expect(bt.attrs[19].val) == "19"
  expect(bt.attrs[20].key) == "k20"
  expect(bt.attrs[20].val) == "z"
}
