// Hand written cases for std/htmltok (decision 0548); the differential against Go's Tokenizer is
// internal/stdtest/testdata/corpus/htmltok.
fn types(src: Str) -> List[TokenType] {
  var z = tokenizer(src)
  var out: List[TokenType] = []
  while true {
    let t = z.next()
    if t == TokenType.Error {
      break
    }
    out.push(t)
  }
  out
}

test "tags, text and the end" {
  var z = tokenizer("<a href=\"x&amp;y\" B=1>t&lt;</a><br/>")
  expect(z.next() == TokenType.StartTag) == true
  let a = z.token()
  expect(a.data) == "a"
  expect(a.attrs.len()) == 2
  expect(a.attrs[0].key) == "href"
  expect(a.attrs[0].val) == "x&y"
  expect(a.attrs[1].key) == "b"
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "t<"
  expect(z.next() == TokenType.EndTag) == true
  expect(z.raw()) == "</a>"
  expect(z.next() == TokenType.SelfClosingTag) == true
  expect(z.next() == TokenType.Error) == true
  expect(z.err()) == Some("EOF")
}

test "script and textarea are raw text" {
  var z = tokenizer("<script>a<b>&amp;</script><textarea>x<b>&amp;</textarea>")
  expect(z.next() == TokenType.StartTag) == true
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "a<b>&amp;"
  expect(z.next() == TokenType.EndTag) == true
  expect(z.next() == TokenType.StartTag) == true
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "x<b>&"
}

test "comments, doctypes and CDATA" {
  expect(types("<!--c--><!DOCTYPE html><?pi?>").len()) == 3
  var z = tokenizer("<![CDATA[x]]>")
  expect(z.next() == TokenType.Comment) == true
  var w = tokenizer("<![CDATA[x]]>")
  w.allow_cdata(true)
  expect(w.next() == TokenType.Text) == true
  expect(w.token().data) == "x"
}

test "the buffer limit" {
  var z = tokenizer("<a b=cccccccccc>")
  z.set_max_buf(5)
  expect(z.next() == TokenType.Error) == true
  expect(z.err()) == Some("max buffer exceeded")
}

test "attribute entities keep a legacy name before an equals sign" {
  var z = tokenizer("<a b=\"?x=1&copy=2&copy;\">")
  expect(z.next() == TokenType.StartTag) == true
  expect(z.token().attrs[0].val) == "?x=1&copy=2\u{00A9}"
}

test "fragment contexts" {
  var z = tokenizer_fragment("a<b>&amp;", "title")
  expect(z.next() == TokenType.Text) == true
  expect(z.token().data) == "a<b>&"
  var p = tokenizer_fragment("<b>x", "plaintext")
  expect(p.next() == TokenType.Text) == true
  expect(p.token().data) == "<b>x"
}
