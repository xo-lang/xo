// std/cron (spec/std.md 58, decision 0474). A crontab
// schedule and its next fire time, a port of robfig/cron v3's standard
// parser (parser.go) and SpecSchedule.Next (spec.go). Pure: running jobs
// stays with the caller (sleep until `next`, run, ask again).
//
// Origin: cron
// std/cron: one pure source for the native backends and, through
// std/go_compiled.txt, the Go backend (decision 0312). A port of
// github.com/robfig/cron/v3 v3.0.1 (parser.go, spec.go, constantdelay.go;
// Copyright (C) 2012 Rob Figueiredo, MIT license; THIRD_PARTY_NOTICES).

use std/time

/// Why a spec did not parse; `msg` is robfig/cron's text, for example
/// `expected exactly 5 fields, found 3: [* * *]`.
pub struct CronErr {
  pub msg: Str
}

pub fn (e: CronErr) display() -> Str { e.msg }

/// A parsed schedule: a value, never changes.
pub struct Schedule {
  /// @every: the delay in seconds, else 0
  _every: Int
  _second: Int
  _minute: Int
  _hour: Int
  _dom: Int
  _month: Int
  _dow: Int
  _dom_star: Bool
  _dow_star: Bool
  _loc: time.Zone
}

/// robfig's ParseStandard: five fields (minute 0-59, hour 0-23, day of month
/// 1-31, month 1-12 or jan-dec, day of week 0-6 or sun-sat), each a comma
/// list of `*`, `?`, a number or name, a range `a-b` and a step `a-b/n`,
/// `*/n` or `a/n`; or `@yearly`, `@annually`, `@monthly`, `@weekly`,
/// `@daily`, `@midnight`, `@hourly`, `@every DURATION`; optionally led by
/// `TZ=Name ` or `CRON_TZ=Name ` (the zone of the schedule; `zone` is the
/// default). Day of month and day of week both restricted: either matches;
/// either starred: both must.
pub fn parse(spec: Str, zone: time.Zone = time.utc()) -> Schedule ! CronErr {
  if spec.len() == 0 {
    return Err(err_of("empty spec string"))
  }
  var spec1 = spec
  var z = zone
  if spec1.starts_with("TZ=") || spec1.starts_with("CRON_TZ=") {
    let i = spec1.find(" ") ?? -1
    let eq = spec1.find("=") ?? 0
    if i < 0 {
      return Err(err_of("provided bad location ${spec1[eq + 1..]}: missing space after the time zone"))
    }
    let name = spec1[eq + 1..i]
    z = match time.zone(name) {
      Ok(x) => x
      Err(e) => return Err(err_of("provided bad location ${name}: ${e.display()}"))
    }
    spec1 = spec1[i..].trim()
  }
  if spec1.starts_with("@") {
    return descriptor(spec1, z)
  }
  fields_of(spec1.fields(), STANDARD, z)
}

/// The parts of a spec a Parser reads (robfig's ParseOption), or'ed together.
pub const SECOND: Int = 1
/// A seconds field that may be left out (then 0); not with DOW_OPTIONAL.
pub const SECOND_OPTIONAL: Int = 2
pub const MINUTE: Int = 4
pub const HOUR: Int = 8
pub const DOM: Int = 16
pub const MONTH: Int = 32
pub const DOW: Int = 64
/// A day of week field that may be left out (then `*`).
pub const DOW_OPTIONAL: Int = 128
/// `@yearly` and the other descriptors, and `@every`.
pub const DESCRIPTOR: Int = 256

/// `parse`'s fields: MINUTE, HOUR, DOM, MONTH, DOW and DESCRIPTOR.
const STANDARD: Int = 380

/// A spec parser for a chosen set of fields (robfig's Parser): a field not
/// in the set takes its default (0 for second, minute and hour, `*` for the
/// others).
pub struct Parser {
  _options: Int
}

/// A parser of `options` (robfig's NewParser), for example
/// `SECOND | MINUTE | HOUR | DOM | MONTH | DOW | DESCRIPTOR` for robfig's
/// WithSeconds. SECOND_OPTIONAL with DOW_OPTIONAL faults, as NewParser
/// panics.
pub fn parser(options: Int) -> Parser {
  if (options & SECOND_OPTIONAL) != 0 && (options & DOW_OPTIONAL) != 0 {
    fault("multiple optionals may not be configured")
  }
  Parser{_options: options}
}

/// The schedule of spec under the parser's fields (robfig's Parser.Parse),
/// with `parse`'s `TZ=` prefix, descriptors (when DESCRIPTOR is set) and
/// error texts.
pub fn (p: Parser) parse(spec: Str, zone: time.Zone = time.utc()) -> Schedule ! CronErr {
  if spec.len() == 0 {
    return Err(err_of("empty spec string"))
  }
  var spec1 = spec
  var z = zone
  if spec1.starts_with("TZ=") || spec1.starts_with("CRON_TZ=") {
    let i = spec1.find(" ") ?? -1
    let eq = spec1.find("=") ?? 0
    if i < 0 {
      return Err(err_of("provided bad location ${spec1[eq + 1..]}: missing space after the time zone"))
    }
    let name = spec1[eq + 1..i]
    z = match time.zone(name) {
      Ok(x) => x
      Err(e) => return Err(err_of("provided bad location ${name}: ${e.display()}"))
    }
    spec1 = spec1[i..].trim()
  }
  if spec1.starts_with("@") {
    if (p._options & DESCRIPTOR) == 0 {
      return Err(err_of("parser does not accept descriptors: ${spec1}"))
    }
    return descriptor(spec1, z)
  }
  fields_of(spec1.fields(), p._options, z)
}

/// normalizeFields then the six getField calls of Parser.Parse.
fn fields_of(given: List[Str], options0: Int, z: time.Zone) -> Schedule ! CronErr {
  var options = options0
  var optionals = 0
  if (options & SECOND_OPTIONAL) != 0 {
    options = options | SECOND
    optionals += 1
  }
  if (options & DOW_OPTIONAL) != 0 {
    options = options | DOW
    optionals += 1
  }
  if optionals > 1 {
    return Err(err_of("multiple optionals may not be configured"))
  }
  let places = [SECOND, MINUTE, HOUR, DOM, MONTH, DOW]
  var max = 0
  for pl in places {
    if (options & pl) != 0 {
      max += 1
    }
  }
  let min = max - optionals
  let count = given.len()
  if count < min || count > max {
    if min == max {
      return Err(err_of("expected exactly ${min} fields, found ${count}: [${given.join(" ")}]"))
    }
    return Err(err_of("expected ${min} to ${max} fields, found ${count}: [${given.join(" ")}]"))
  }
  var fields = given
  if min < max && count == min {
    if (options & DOW_OPTIONAL) != 0 {
      fields = fields + ["*"]
    } else {
      fields = ["0"] + fields
    }
  }
  var all = ["0", "0", "0", "*", "*", "*"]
  var n = 0
  for (i, pl) in places.indexed() {
    if (options & pl) != 0 {
      all[i] = fields[n]
      n += 1
    }
  }
  let (second, _) = get_field(all[0], 0, 59, NONAMES)?
  let (minute, _) = get_field(all[1], 0, 59, NONAMES)?
  let (hour, _) = get_field(all[2], 0, 23, NONAMES)?
  let (dom, dom_star) = get_field(all[3], 1, 31, NONAMES)?
  let (month, _) = get_field(all[4], 1, 12, MONTHS)?
  let (dow, dow_star) = get_field(all[5], 0, 6, DOWS)?
  Ok(sched(second, minute, hour, dom, month, dow, dom_star, dow_star, z))
}

/// The first fire time strictly after `after` (robfig's Next, whole
/// seconds); None when none is found within 5 years. `@every` is
/// `after` plus the delay, rounded down to the second.
pub fn (s: Schedule) next(after: Time) -> Time? {
  if s._every > 0 {
    return Some(Time.from_unix(after.unix() + s._every))
  }
  let z = s._loc
  var t = after.unix() + 1
  var c = civ(t, z)
  let year_limit = c.date.year + 5
  var added = false
  while true {
    c = civ(t, z)
    if c.date.year > year_limit {
      return None
    }
    var wrap = false
    while ((s._month >> c.date.month) & 1) == 0 {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, 1, 0, 0, 0)
        c = civ(t, z)
      }
      t = date_go(z, c.date.year, c.date.month + 1, c.date.day, c.time.hour, c.time.minute, c.time.second)
      c = civ(t, z)
      if c.date.month == 1 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while !s.day_matches(c) {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, c.date.day, 0, 0, 0)
        c = civ(t, z)
      }
      // date_go of the next day at the same clock, done in place: that
      // civil time read as UTC is this one's plus a day, and when the
      // zone's offset there is the one the lookup returns, the civil time
      // is that day and clock with no conversion back (the zone label is
      // not read here); another offset converts as date_go and civ do
      let l = t + c.offset.nanos() / 1000000000 + 86400
      let off_a = z.offset_at(Time.from_unix(l)).nanos() / 1000000000
      let utc_a = l - off_a
      let off_b = z.offset_at(Time.from_unix(utc_a)).nanos() / 1000000000
      if off_b == off_a {
        t = utc_a
        c = time.Civil{date: c.date.add_days(1), time: c.time, offset: Duration.from_nanos(off_a * 1000000000), zone: c.zone}
      } else {
        t = l - off_b
        c = civ(t, z)
      }
      if c.time.hour != 0 {
        if c.time.hour > 12 {
          t += (24 - c.time.hour) * 3600
        } else {
          t += -c.time.hour * 3600
        }
        c = civ(t, z)
      }
      if c.date.day == 1 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while ((s._hour >> c.time.hour) & 1) == 0 {
      if !added {
        added = true
        t = date_go(z, c.date.year, c.date.month, c.date.day, c.time.hour, 0, 0)
      }
      t += 3600
      c = civ(t, z)
      if c.time.hour == 0 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while ((s._minute >> c.time.minute) & 1) == 0 {
      if !added {
        added = true
        t = t - ((t % 60) + 60) % 60
      }
      t += 60
      c = civ(t, z)
      if c.time.minute == 0 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    while ((s._second >> c.time.second) & 1) == 0 {
      added = true
      t += 1
      c = civ(t, z)
      if c.time.second == 0 {
        wrap = true
        break
      }
    }
    if wrap {
      continue
    }
    return Some(Time.from_unix(t))
  }
  None
}

/// The zone the fields are read in.
pub fn (s: Schedule) zone() -> time.Zone { s._loc }

fn err_of(msg: Str) -> CronErr { CronErr{msg: msg} }

/// The bits min..max stepping by step (getBits).
fn bits(lo: Int, hi: Int, step: Int) -> Int {
  var b = 0
  var i = lo
  while i <= hi {
    b = b | (1 << i)
    i += step
  }
  b
}

/// The decimal digits d (no leading zeros) above the decimal digits m.
fn dec_above(d: Str, m: Str) -> Bool { d.len() > m.len() || (d.len() == m.len() && d > m) }

/// strconv.Atoi's value or its error text, for mustParseInt. Go's
/// ParseUint scans the digits as a uint64 and stops at the first error: a
/// range error once the digits so far pass 2^64 - 1, a syntax error at a
/// byte that is not a digit; ParseInt then checks the int64 range.
fn atoi(s: Str) -> Int ! CronErr {
  let raw = s
  let b = s.bytes()
  var neg = false
  var i = 0
  if b.len() > 0 && (b[0] == '+' || b[0] == '-') {
    neg = b[0] == '-'
    i = 1
  }
  let range = err_of("failed to parse int from ${raw}: strconv.Atoi: parsing ${raw.quote()}: value out of range")
  let syntax = err_of("failed to parse int from ${raw}: strconv.Atoi: parsing ${raw.quote()}: invalid syntax")
  var j = i
  while j < b.len() && b[j] >= '0' && b[j] <= '9' {
    j += 1
  }
  var k = i
  while k < j - 1 && b[k] == '0' {
    k += 1
  }
  let digits = s[k..j]
  if j > i && dec_above(digits, "18446744073709551615") {
    return Err(range)
  }
  if j == i || j < b.len() {
    return Err(syntax)
  }
  if dec_above(digits, if neg { "9223372036854775808" } else { "9223372036854775807" }) {
    return Err(range)
  }
  let v = if neg && digits == "9223372036854775808" { Int.min } else {
    let u = Int.parse(digits) ?? 0
    if neg { -u } else { u }
  }
  if v < 0 {
    return Err(err_of("negative number (${v}) not allowed: ${raw}"))
  }
  Ok(v)
}

fn lower_names(expr: Str, names: List[(Str, Int)]) -> Int? {
  let l = expr.to_lower()
  for (n, v) in names {
    if n == l {
      return Some(v)
    }
  }
  None
}

fn int_or_name(expr: Str, names: List[(Str, Int)]) -> Int ! CronErr {
  match lower_names(expr, names) {
    Some(v) => Ok(v)
    None => atoi(expr)
  }
}

const MONTHS: List[(Str, Int)] = [("jan", 1), ("feb", 2), ("mar", 3), ("apr", 4), ("may", 5), ("jun", 6), ("jul", 7), ("aug", 8), ("sep", 9), ("oct", 10), ("nov", 11), ("dec", 12)]

const DOWS: List[(Str, Int)] = [("sun", 0), ("mon", 1), ("tue", 2), ("wed", 3), ("thu", 4), ("fri", 5), ("sat", 6)]

const NONAMES: List[(Str, Int)] = []

/// getRange: the bits of one expression and whether it started with * or ?
/// (robfig's starBit).
fn get_range(expr: Str, lo: Int, hi: Int, names: List[(Str, Int)]) -> (Int, Bool) ! CronErr {
  let range_and_step = expr.split("/")
  let low_and_high = range_and_step[0].split("-")
  let single = low_and_high.len() == 1
  var start = 0
  var end = 0
  var star = false
  if low_and_high[0] == "*" || low_and_high[0] == "?" {
    start = lo
    end = hi
    star = true
  } else {
    start = int_or_name(low_and_high[0], names)?
    if low_and_high.len() == 1 {
      end = start
    } else if low_and_high.len() == 2 {
      end = int_or_name(low_and_high[1], names)?
    } else {
      return Err(err_of("too many hyphens: ${expr}"))
    }
  }
  var step = 1
  if range_and_step.len() == 2 {
    step = atoi(range_and_step[1])?
    if single {
      end = hi
    }
    if step > 1 {
      star = false
    }
  } else if range_and_step.len() > 2 {
    return Err(err_of("too many slashes: ${expr}"))
  }
  if start < lo {
    return Err(err_of("beginning of range (${start}) below minimum (${lo}): ${expr}"))
  }
  if end > hi {
    return Err(err_of("end of range (${end}) above maximum (${hi}): ${expr}"))
  }
  if start > end {
    return Err(err_of("beginning of range (${start}) beyond end of range (${end}): ${expr}"))
  }
  if step == 0 {
    return Err(err_of("step of range should be a positive number: ${expr}"))
  }
  Ok((bits(start, end, step), star))
}

/// getField: the comma separated ranges, empty ones dropped (FieldsFunc).
fn get_field(field: Str, lo: Int, hi: Int, names: List[(Str, Int)]) -> (Int, Bool) ! CronErr {
  var b = 0
  var star = false
  for expr in field.split(",") {
    if expr.len() == 0 {
      continue
    }
    let (rb, rs) = get_range(expr, lo, hi, names)?
    b = b | rb
    if rs {
      star = true
    }
  }
  Ok((b, star))
}

fn sched(second: Int, minute: Int, hour: Int, dom: Int, month: Int, dow: Int, dom_star: Bool, dow_star: Bool, z: time.Zone) -> Schedule {
  Schedule{_every: 0, _second: second, _minute: minute, _hour: hour, _dom: dom, _month: month, _dow: dow, _dom_star: dom_star, _dow_star: dow_star, _loc: z}
}

fn descriptor(d: Str, z: time.Zone) -> Schedule ! CronErr {
  let all_hours = bits(0, 23, 1)
  let all_dom = bits(1, 31, 1)
  let all_months = bits(1, 12, 1)
  let all_dow = bits(0, 6, 1)
  match d {
    "@yearly" | "@annually" => Ok(sched(1, 1, 1, 1 << 1, 1 << 1, all_dow, false, true, z))
    "@monthly" => Ok(sched(1, 1, 1, 1 << 1, all_months, all_dow, false, true, z))
    "@weekly" => Ok(sched(1, 1, 1, all_dom, all_months, 1, true, false, z))
    "@daily" | "@midnight" => Ok(sched(1, 1, 1, all_dom, all_months, all_dow, true, true, z))
    "@hourly" => Ok(sched(1, 1, all_hours, all_dom, all_months, all_dow, true, true, z))
    _ => {
      if d.starts_with("@every ") {
        let text = d[7..]
        if let Some(m) = go_duration_err(text) {
          return Err(err_of("failed to parse duration ${d}: ${m}"))
        }
        let dur = match Duration.parse(text) {
          Ok(x) => x
          Err(_) => return Err(err_of("failed to parse duration ${d}: time: invalid duration ${go_quote(text)}"))
        }
        var secs = dur.nanos() / 1000000000
        if secs < 1 {
          secs = 1
        }
        let s = sched(1, 0, 0, 0, 0, 0, false, false, z)
        return Ok(Schedule{_every: secs, _second: s._second, _minute: s._minute, _hour: s._hour, _dom: s._dom, _month: s._month, _dow: s._dow, _dom_star: false, _dow_star: false, _loc: z})
      }
      Err(err_of("unrecognized descriptor: ${d}"))
    }
  }
}

fn civ(t: Int, z: time.Zone) -> time.Civil { time.civil(Time.from_unix(t), z) }

/// Go's time.Date (time.go): the civil time read as if UTC, then the offset
/// of the zone at that instant, checked once at the result (a time in a gap
/// or an overlap thus takes whichever offset Go's lookup meets first).
fn date_go(z: time.Zone, y: Int, mo: Int, d: Int, h: Int, mi: Int, sec: Int) -> Int {
  var yy = y
  var mm = mo
  while mm > 12 {
    mm -= 12
    yy += 1
  }
  var dt = time.date(yy, mm, 1).ok() ?? fault("cron: date")
  dt = dt.add_days(d - 1)
  let ct = time.ClockTime{hour: h, minute: mi, second: sec, nanos: 0}
  let l = (time.instant(dt, ct, time.utc()).ok() ?? fault("cron: instant")).unix()
  let off_a = z.offset_at(Time.from_unix(l)).nanos() / 1000000000
  let utc_a = l - off_a
  let off_b = z.offset_at(Time.from_unix(utc_a)).nanos() / 1000000000
  if off_b == off_a {
    utc_a
  } else {
    l - off_b
  }
}

fn (s: Schedule) day_matches(c: time.Civil) -> Bool {
  let dom_match = ((s._dom >> c.date.day) & 1) == 1
  let dow_match = ((s._dow >> (c.date.weekday().number() % 7)) & 1) == 1
  if s._dom_star || s._dow_star {
    dom_match && dow_match
  } else {
    dom_match || dow_match
  }
}

/// Go's time.ParseDuration error for text, or None where Go's syntax
/// accepts it (an overflow is left to Duration.parse): robfig's @every
/// error carries Go's text ("time: unknown unit ..."), and Go does not trim
/// white space (Duration.parse does). 2026-11-16, found by
/// internal/stdtest/cronfuzz_test.go.
fn go_duration_err(text: Str) -> Str? {
  let b = text.bytes()
  let n = b.len()
  let invalid = "time: invalid duration ${go_quote(text)}"
  var i = 0
  if n > 0 && (b[0] == 45 || b[0] == 43) {
    i = 1
  }
  if n - i == 1 && b[i] == 48 {
    return None
  }
  if i == n {
    return Some(invalid)
  }
  while i < n {
    let c = b[i]
    if !(c == 46 || (c >= 48 && c <= 57)) {
      return Some(invalid)
    }
    let p0 = i
    while i < n && b[i] >= 48 && b[i] <= 57 {
      i += 1
    }
    let pre = i > p0
    var post = false
    if i < n && b[i] == 46 {
      i += 1
      let f0 = i
      while i < n && b[i] >= 48 && b[i] <= 57 {
        i += 1
      }
      post = i > f0
    }
    if !pre && !post {
      return Some(invalid)
    }
    let u0 = i
    while i < n && !(b[i] == 46 || (b[i] >= 48 && b[i] <= 57)) {
      i += 1
    }
    if i == u0 {
      return Some("time: missing unit in duration ${go_quote(text)}")
    }
    let u = b[u0..i].to_str() ?? ""
    match u {
      "ns" | "us" | "\u{b5}s" | "\u{3bc}s" | "ms" | "s" | "m" | "h" => ()
      _ => return Some("time: unknown unit ${go_quote_bytes(b[u0..i])} in duration ${go_quote(text)}")
    }
  }
  None
}

/// Go's time package quote: `"`, a byte below 0x20 or from 0x80 as \xHH,
/// `"` and `\` escaped.
fn go_quote(s: Str) -> Str { go_quote_bytes(s.bytes()) }

fn go_quote_bytes(b: Bytes) -> Str {
  let hex = "0123456789abcdef".bytes()
  var out = BytesBuilder.with_capacity(b.len() + 2)
  out.write_byte(34)
  for c in b {
    if c < 32 || c >= 128 {
      out.write_byte(92)
      out.write_byte(120)
      out.write_byte(hex[Int(c) >> 4])
      out.write_byte(hex[Int(c) & 15])
    } else {
      if c == 34 || c == 92 {
        out.write_byte(92)
      }
      out.write_byte(c)
    }
  }
  out.write_byte(34)
  out.freeze().to_str() ?? ""
}
