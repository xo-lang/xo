// std/multipart (spec/std.md 26, decision 0282). Encoding
// rules are listed at the top of std/prelude.xo. Go's mime/multipart: a
// body in memory (parse, parse_form), or streamed (Reader, decision
// 0597). Pure except random_boundary.
//
// std/multipart on the native backends (decision 0282): Go's mime/multipart
// reader (multipart.go, formdata.go of go1.26: NextPart, the part reader's
// scanUntilBoundary, ReadForm's limits), net/textproto's readMIMEHeader,
// and mime/quotedprintable's Reader, ported with the
// same results and error texts. Go reads through 4096 byte bufio buffers;
// the two places where that shows (a boundary search line, and a
// quoted-printable line, longer than the buffer: `bufio: buffer full`) are
// kept.

use std/mime
use std/textproto
use std/url

/// One part. `name` is the form field (Content-Disposition `form-data`'s
/// `name`, else ""); `filename` its file name, the last path element as
/// Go's FileName; `headers` the first value of each header, keys in
/// canonical form (Content-Type).
pub struct Part {
  pub name: Str
  pub filename: Str?
  pub headers: Map[Str, Str]
  pub data: Bytes
}

/// A form: the fields without a file name, and the file parts by field.
pub struct Form {
  pub values: url.Values
  pub files: Map[Str, List[Part]]
}

/// Go's error texts: `multipart: NextPart: EOF`, `multipart: message too
/// large`, `unexpected EOF`, `malformed MIME header line: ...`.
pub struct MultipartErr {
  pub msg: Str
}

pub fn (e: MultipartErr) display() -> Str { e.msg }

/// Every part (Reader.NextPart, each part read whole; a
/// quoted-printable part decoded).
pub fn parse(body: Bytes, boundary: Str) -> List[Part] ! MultipartErr {
  var r = new_reader(body, boundary)
  var parts: List[Part] = []
  while {
    let n = match r.next_part(MAX_HEADER_SIZE, MAX_HEADERS) {
      Ok(Some(n)) => n
      Ok(None) => break
      Err(m) => return Err(fail(m))
    }
    let (data, e) = r.part_data(n)
    if !e.is_empty() {
      return Err(fail(e))
    }
    parts.push(to_part(n.header, data))
  }
  parts
}

/// Reader.ReadForm with Go's limits (the 32 MB of http's
/// ParseMultipartForm, `max_parts`, 10,000 headers).
pub fn parse_form(body: Bytes, boundary: Str, max_parts: Int = 1000) -> Form ! MultipartErr {
  var r = new_reader(body, boundary)
  var values = url.values()
  var files: Map[Str, List[Part]] = {}
  var parts_left = max_parts
  var max_headers = MAX_HEADERS
  var max_file_memory = MAX_MEMORY
  var max_memory = MAX_MEMORY + 10485760
  while {
    let n = match r.next_part(max_memory, max_headers) {
      Ok(Some(n)) => n
      Ok(None) => break
      Err(m) => return Err(fail(m))
    }
    if parts_left <= 0 {
      return Err(fail(TOO_LARGE))
    }
    parts_left -= 1
    let (name, file) = names(n.header)
    if name.is_empty() {
      r.skip_part(n)
      continue
    }
    max_memory -= name.len() + 200
    if max_memory < 0 {
      return Err(fail(TOO_LARGE))
    }
    let (data, e) = r.part_data(n)
    if file.is_empty() {
      if data.len() > max_memory {
        return Err(fail(TOO_LARGE))
      }
      if !e.is_empty() {
        return Err(fail(e))
      }
      max_memory -= data.len()
      values.add(name, text_of(data))
      continue
    }
    var hsize = 400
    for i in 0..n.header.keys.len() {
      hsize += n.header.keys[i].len() + 200
      for v in n.header.values[i] {
        hsize += v.len()
      }
    }
    max_memory -= hsize + 300
    if max_memory < 0 {
      return Err(fail(TOO_LARGE))
    }
    max_headers -= n.header.count()
    if !e.is_empty() {
      return Err(fail(e))
    }
    if data.len() <= max_file_memory {
      max_file_memory -= data.len()
      max_memory -= data.len()
    }
    var fs = files.get(name) ?? []
    fs.push(to_part(n.header, data))
    files.put(name, fs)
  }
  Form{values: values, files: files}
}

/// A body of the parts (Writer): each part's headers sorted, a
/// Content-Disposition from `name` and `filename` when the part has none.
pub fn write(parts: List[Part], boundary: Str) -> Bytes {
  var out = BytesBuilder.new()
  var first = true
  for p in parts {
    out.write(if first { "--${boundary}\r\n" } else { "\r\n--${boundary}\r\n" }.bytes())
    first = false
    var h = p.headers
    if !h.contains("Content-Disposition") {
      let d = match p.filename {
        Some(f) => "form-data; name=\"${escape_quotes(p.name)}\"; filename=\"${escape_quotes(f)}\""
        None => "form-data; name=\"${escape_quotes(p.name)}\""
      }
      h.put("Content-Disposition", d)
      if p.filename != None && !h.contains("Content-Type") {
        h.put("Content-Type", "application/octet-stream")
      }
    }
    for k in h.keys().sort() {
      out.write("${k}: ${h.get(k) ?? ""}\r\n".bytes())
    }
    out.write(b"\r\n")
    out.write(p.data)
  }
  out.write("\r\n--${boundary}--\r\n".bytes())
  out.freeze()
}

/// `multipart/form-data; boundary=...` (Writer.FormDataContentType).
pub fn form_data_content_type(boundary: Str) -> Str {
  var b = boundary
  for c in "()<>@,;:\\\"/[]?= ".runes() {
    if boundary.runes().contains(c) {
      b = "\"${boundary}\""
      break
    }
  }
  "multipart/form-data; boundary=${b}"
}

/// 60 hex digits from 30 random bytes (Writer's boundary).
pub fn random_boundary(r: Rand) -> Str uses rand { r.bytes(30).to_hex() }

fn fail(msg: Str) -> MultipartErr { MultipartErr{msg: msg} }

const BUF: Int = 4096

const MAX_HEADER_SIZE: Int = 10485760

const MAX_HEADERS: Int = 10000

/// http's defaultMaxMemory, the ReadForm limit of ParseMultipartForm.
const MAX_MEMORY: Int = 33554432

const TOO_LARGE: Str = "multipart: message too large"

const UNEXPECTED_EOF: Str = "unexpected EOF"

/// Outside bytes as Str: U+FFFD for each byte of an invalid sequence
/// (decision 0259).
fn text_of(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

fn has_prefix(b: Bytes, at: Int, p: Bytes) -> Bool {
  if b.len() - at < p.len() {
    return false
  }
  for i in 0..p.len() {
    if b[at + i] != p[i] {
      return false
    }
  }
  true
}

fn index_of(b: Bytes, from: Int, p: Bytes) -> Int {
  match b[from..].find(p) {
    Some(i) => from + i
    None => -1
  }
}

/// Go's %q of bytes (strconv.Quote of a string holding them).
fn go_q(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s.quote()
  }
  var out = StrBuilder.new()
  out.write("\"")
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      let h = "0123456789abcdef"
      let v = Int(b[i])
      out.write("\\x" + h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1])
    } else {
      let q = b[i..i + n].to_str().or_fault("rune").quote()
      out.write(q[1..q.len() - 1])
    }
    i += n
  }
  out.write("\"")
  out.freeze()
}

struct R[fx: Effects] {
  buf: Bytes
  pos: Int
  nl: Bytes
  nl_dash_boundary: Bytes
  dash_boundary_dash: Bytes
  dash_boundary: Bytes
  parts_read: Int
  /// a streamed body's source (decision 0310 phase 3: http's
  /// BodyReader; Reader), [] for a body in memory; whether it ended, and
  /// its error
  src: List[fn() -> Bytes? ! Str uses fx] = []
  done: Bool = false
  src_err: Str = ""
}

/// More input from the source, the unread rest kept at the start of the
/// buffer: false at its end (or for a body in memory).
fn (var r: R) more() -> Bool {
  if r.src.is_empty() || r.done {
    return false
  }
  while true {
    let d = match r.src[0]() {
      Ok(Some(d)) => d
      Ok(None) => {
        r.done = true
        return false
      }
      Err(e) => {
        r.done = true
        r.src_err = e
        return false
      }
    }
    if !d.is_empty() {
      r.buf = if r.pos >= r.buf.len() { d } else { r.buf[r.pos..] + d }
      r.pos = 0
      return true
    }
  }
  false
}

/// Whether the byte at the read position is a space or a tab (the
/// buffer filled first when it is used up).
fn (var r: R) at_lwsp() -> Bool {
  if r.pos >= r.buf.len() && !r.more() {
    return false
  }
  r.buf[r.pos] == 32 || r.buf[r.pos] == 9
}

fn new_reader(body: Bytes, boundary: Str) -> R[()] { reader_over(body, boundary, []) }

/// A reader of body and then of what src gives (none when it is empty).
fn reader_over[fx: Effects](body: Bytes, boundary: Str, src: List[fn() -> Bytes? ! Str uses fx]) -> R[fx] {
  let b = "\r\n--${boundary}--".bytes()
  R{buf: body, pos: 0, nl: b[0..2], nl_dash_boundary: b[0..b.len() - 2], dash_boundary_dash: b[2..], dash_boundary: b[2..b.len() - 2], parts_read: 0, src: src}
}

/// bufio.Reader.ReadSlice('\n') with a 4096 byte buffer: the line and
/// "" , "EOF" (no newline before the end), or "bufio: buffer full".
fn (var r: R) read_slice() -> (Bytes, Str) {
  var off = 0
  while true {
    let end = if r.buf.len() - r.pos > BUF { r.pos + BUF } else { r.buf.len() }
    var i = r.pos + off
    while i < end {
      if r.buf[i] == 10 {
        let line = r.buf[r.pos..i + 1]
        r.pos = i + 1
        return (line, "")
      }
      i += 1
    }
    if end - r.pos >= BUF {
      let line = r.buf[r.pos..end]
      r.pos = end
      return (line, "bufio: buffer full")
    }
    off = end - r.pos
    if !r.more() {
      let line = r.buf[r.pos..]
      r.pos = r.buf.len()
      return (line, if r.src_err.is_empty() { "EOF" } else { r.src_err })
    }
  }
  (b"", "EOF")
}

fn skip_lwsp(b: Bytes) -> Bytes {
  var i = 0
  while i < b.len() && (b[i] == 32 || b[i] == 9) {
    i += 1
  }
  b[i..]
}

fn (r: R) is_final_boundary(line: Bytes) -> Bool {
  if !has_prefix(line, 0, r.dash_boundary_dash) {
    return false
  }
  let rest = skip_lwsp(line[r.dash_boundary_dash.len()..])
  rest.is_empty() || rest == r.nl
}

fn (var r: R) is_boundary_delimiter_line(line: Bytes) -> Bool {
  if !has_prefix(line, 0, r.dash_boundary) {
    return false
  }
  let rest = skip_lwsp(line[r.dash_boundary.len()..])
  if r.parts_read == 0 && rest.len() == 1 && rest[0] == 10 {
    r.nl = r.nl[1..]
    r.nl_dash_boundary = r.nl_dash_boundary[1..]
  }
  rest == r.nl
}

/// matchAfterPrefix: -1 not a boundary, 0 need more, +1 a boundary.
fn match_after_prefix(b: Bytes, at: Int, prefix: Bytes, eof: Bool) -> Int {
  if b.len() - at == prefix.len() {
    return if eof { 1 } else { 0 }
  }
  let c = b[at + prefix.len()]
  if c == 32 || c == 9 || c == 13 || c == 10 {
    return 1
  }
  if c == 45 {
    if b.len() - at == prefix.len() + 1 {
      return if eof { -1 } else { 0 }
    }
    if b[at + prefix.len() + 1] == 45 {
      return 1
    }
  }
  -1
}

/// scanUntilBoundary over the rest of the body: the bytes of data before
/// the boundary and how the part goes on: "" (more data), "EOF" (the part
/// ends), or the read error; `eof` once the body is known to end there.
fn (r: R) scan(total: Int, eof: Bool) -> (Int, Str) {
  let b = r.buf[r.pos..]
  let read_err = if eof { UNEXPECTED_EOF } else { "" }
  if total == 0 {
    if has_prefix(b, 0, r.dash_boundary) {
      match match_after_prefix(b, 0, r.dash_boundary, eof) {
        -1 => return (r.dash_boundary.len(), "")
        0 => return (0, "")
        _ => return (0, "EOF")
      }
    }
    if has_prefix(r.dash_boundary, 0, b) {
      return (0, read_err)
    }
  }
  let i = index_of(b, 0, r.nl_dash_boundary)
  if i >= 0 {
    match match_after_prefix(b, i, r.nl_dash_boundary, eof) {
      -1 => return (i + r.nl_dash_boundary.len(), "")
      0 => return (i, "")
      _ => return (i, "EOF")
    }
  }
  if has_prefix(r.nl_dash_boundary, 0, b) {
    return (0, read_err)
  }
  var j = b.len() - 1
  while j >= 0 && b[j] != r.nl_dash_boundary[0] {
    j -= 1
  }
  if j >= 0 && has_prefix(r.nl_dash_boundary, 0, b[j..]) {
    return (j, "")
  }
  (b.len(), read_err)
}

/// A part's raw data (partReader read to its end): the bytes and ""
/// (ended at its boundary) or the read error.
fn (var r: R) read_part() -> (Bytes, Str) {
  var out = BytesBuilder.new()
  var total = 0
  var eof = false
  while {
    let (n, e) = r.scan(total, eof)
    if n == 0 && e.is_empty() {
      // Go peeks one byte more: the body has ended here (or, streamed,
      // more comes)
      if !r.more() {
        if !r.src_err.is_empty() {
          return (out.freeze(), r.src_err)
        }
        eof = true
      }
      continue
    }
    out.write(r.buf[r.pos..r.pos + n])
    r.pos += n
    total += n
    if !e.is_empty() {
      return (out.freeze(), if e == "EOF" { "" } else { e })
    }
  }
}

/// bufio ReadLine for textproto: the line without its `\n` or `\r\n`;
/// None at the end of the body.
fn (var r: R) read_line() -> Bytes? {
  if r.pos >= r.buf.len() && !r.more() {
    return None
  }
  var i = r.pos
  while true {
    while i < r.buf.len() && r.buf[i] != 10 {
      i += 1
    }
    if i < r.buf.len() {
      break
    }
    let off = i - r.pos
    if !r.more() {
      break
    }
    i = r.pos + off
  }
  if i == r.buf.len() {
    let line = r.buf[r.pos..]
    r.pos = i
    return Some(line)
  }
  var e = i
  if e > r.pos && r.buf[e - 1] == 13 {
    e -= 1
  }
  let line = r.buf[r.pos..e]
  r.pos = i + 1
  Some(line)
}

fn trim_lwsp(b: Bytes) -> Bytes {
  var s = 0
  while s < b.len() && (b[s] == 32 || b[s] == 9) {
    s += 1
  }
  var e = b.len()
  while e > s && (b[e - 1] == 32 || b[e - 1] == 9) {
    e -= 1
  }
  b[s..e]
}

fn valid_field_byte(c: UInt8) -> Bool {
  (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46 || c == 94 || c == 95 || c == 96 || c == 124 || c == 126
}

fn valid_value_byte(c: UInt8) -> Bool { c >= 32 && c != 127 || c == 9 }

/// canonicalMIMEHeaderKey: None when a byte is not allowed.
fn canonical_key(k: Bytes) -> Str? {
  if k.is_empty() {
    return None
  }
  var spaces = false
  for c in k {
    if c == 32 {
      spaces = true
    } else if !valid_field_byte(c) {
      return None
    }
  }
  if spaces {
    return k.to_str()
  }
  var out = BytesBuilder.with_capacity(k.len())
  var upper = true
  for c0 in k {
    var c = c0
    if upper && c >= 97 && c <= 122 {
      c -= 32
    } else if !upper && c >= 65 && c <= 90 {
      c += 32
    }
    out.write_byte(c)
    upper = c == 45
  }
  out.freeze().to_str()
}

/// A header block's result: the headers (every value, in order), or the
/// end of the body ("EOF") or an error text.
struct Header {
  keys: List[Str]
  values: List[List[Str]]
}

fn (var h: Header) add(k: Str, v: Str) {
  match h.keys.index_of(k) {
    Some(i) => {
      var vs = h.values[i]
      vs.push(v)
      h.values.set(i, vs)
    }
    None => {
      h.keys.push(k)
      h.values.push([v])
    }
  }
}

fn (h: Header) get(k: Str) -> Str {
  match h.keys.index_of(k) {
    Some(i) => h.values[i][0]
    None => ""
  }
}

fn (h: Header) count() -> Int {
  var n = 0
  for vs in h.values {
    n += vs.len()
  }
  n
}

/// readContinuedLineSlice: the logical line (continuations joined by one
/// space), or the error ("EOF" at the end of the body).
fn (var r: R) read_continued(lim0: Int) -> Bytes ! Str {
  let line = match r.read_line() {
    Some(l) => l
    None => return Err("EOF")
  }
  if lim0 >= 0 && line.len() > lim0 {
    return Err("message too large")
  }
  if line.is_empty() {
    return line
  }
  if index_of(line, 0, b":") < 0 {
    return Err("malformed MIME header: missing colon: ${go_q(line)}")
  }
  var out = BytesBuilder.new()
  out.write(trim_lwsp(line))
  var n = trim_lwsp(line).len()
  let lim = if lim0 < 0 { Int.max } else { lim0 } - n
  while r.at_lwsp() {
    while r.at_lwsp() {
      r.pos += 1
    }
    out.write_byte(32)
    n += 1
    if n >= lim {
      return Err("message too large")
    }
    match r.read_line() {
      Some(l) => {
        if l.len() > lim - n {
          return Err("message too large")
        }
        let t = trim_lwsp(l)
        out.write(t)
        n += t.len()
      }
      None => break
    }
  }
  out.freeze()
}

fn (var r: R) read_header(max_memory0: Int, max_headers0: Int) -> Header ! Str {
  var h = Header{keys: [], values: []}
  var max_memory = max_memory0 - 400
  var max_headers = max_headers0
  if r.at_lwsp() {
    let line = r.read_line() ?? b""
    if line.len() > 80 {
      return Err("message too large")
    }
    return Err("malformed MIME header initial line: ${text_of(line)}")
  }
  while {
    let kv = r.read_continued(max_memory)?
    if kv.is_empty() {
      return h
    }
    let c = index_of(kv, 0, b":")
    if c < 0 {
      return Err("malformed MIME header line: ${text_of(kv)}")
    }
    let key = match canonical_key(kv[0..c]) {
      Some(k) => k
      None => return Err("malformed MIME header line: ${text_of(kv)}")
    }
    let v = kv[c + 1..]
    for b in v {
      if !valid_value_byte(b) {
        // Go canonicalizes the key in place first, so its text shows
        // the key canonical
        return Err("malformed MIME header line: ${key}:${text_of(v)}")
      }
    }
    max_headers -= 1
    if max_headers < 0 {
      return Err("message too large")
    }
    let value = skip_lwsp(v)
    if !h.keys.contains(key) {
      max_memory -= key.len() + 200
    }
    max_memory -= value.len()
    if max_memory < 0 {
      return Err("message too large")
    }
    h.add(key, text_of(value))
  }
  h
}

fn qp_hex(c: UInt8) -> Int {
  if c >= 48 && c <= 57 { return Int(c) - 48 }
  if c >= 65 && c <= 70 { return Int(c) - 55 }
  if c >= 97 && c <= 102 { return Int(c) - 87 }
  -1
}

fn hex2(c: UInt8) -> Str {
  let h = "0123456789abcdef"
  let v = Int(c)
  h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1]
}

fn is_qp_ws(c: UInt8) -> Bool { c == 10 || c == 13 || c == 32 || c == 9 }

/// The decoded data and its error ("" when none): `end` is how the raw data
/// ended ("" at its boundary, else the part's read error), which the
/// decoder reports after the data, as Go's bufio passes it on.
fn qp_decode(raw: Bytes, end: Str) -> (Bytes, Str) {
  let (out, e, _used) = qp_decode_at(raw, end)
  (out, e)
}

/// qp_decode, and how much of raw the decoder read: the end of the line
/// it stopped on (all of raw when it did not stop early).
fn qp_decode_at(raw: Bytes, end: Str) -> (Bytes, Str, Int) {
  var out = BytesBuilder.with_capacity(raw.len())
  var pos = 0
  while {
    if pos >= raw.len() {
      return (out.freeze(), end, pos)
    }
    // ReadSlice('\n') on a 4096 byte buffer
    var stop = if raw.len() - pos > BUF { pos + BUF } else { raw.len() }
    var nl = -1
    for i in pos..stop {
      if raw[i] == 10 {
        nl = i
        break
      }
    }
    var rerr = ""
    var whole = b""
    if nl >= 0 {
      whole = raw[pos..nl + 1]
      pos = nl + 1
    } else {
      whole = raw[pos..stop]
      pos = stop
      rerr = if stop == raw.len() { if end.is_empty() { "EOF" } else { end } } else { "bufio: buffer full" }
    }
    let has_lf = whole.len() > 0 && whole[whole.len() - 1] == 10
    let has_cr = whole.len() > 1 && whole[whole.len() - 2] == 13 && has_lf
    var e = whole.len()
    while e > 0 && is_qp_ws(whole[e - 1]) {
      e -= 1
    }
    var line = BytesBuilder.new()
    var bad = ""
    if e > 0 && whole[e - 1] == 61 {
      let right = skip_lwsp(whole[e..])
      line.write(whole[0..e - 1])
      let rs_lf = right.len() > 0 && right[0] == 10
      let rs_crlf = right.len() > 1 && right[0] == 13 && right[1] == 10
      if !rs_lf && !rs_crlf && !(right.is_empty() && e - 1 > 0 && rerr == "EOF") {
        bad = "quotedprintable: invalid bytes after =: ${go_q(right)}"
      }
    } else {
      line.write(whole[0..e])
      if has_lf {
        line.write(if has_cr { b"\r\n" } else { b"\n" })
      }
    }
    let l = line.freeze()
    var i = 0
    while i < l.len() {
      var c = l[i]
      if c == 61 {
        if l.len() - i - 1 < 2 {
          if l.len() - i >= 2 && l[i + 1] != 13 && l[i + 1] != 10 {
            c = 61
          } else {
            return (out.freeze(), UNEXPECTED_EOF, pos)
          }
        } else if qp_hex(l[i + 1]) < 0 || qp_hex(l[i + 2]) < 0 {
          if l[i + 1] != 13 && l[i + 1] != 10 {
            c = 61
          } else {
            let x = if qp_hex(l[i + 1]) < 0 { l[i + 1] } else { l[i + 2] }
            return (out.freeze(), "quotedprintable: invalid hex byte 0x${hex2(x)}", pos)
          }
        } else {
          c = UInt8(qp_hex(l[i + 1]) * 16 + qp_hex(l[i + 2]))
          i += 2
        }
      } else if c == 9 || c == 13 || c == 10 || c >= 128 {
        // as it is
      } else if c < 32 || c > 126 {
        return (out.freeze(), "quotedprintable: invalid unescaped byte 0x${hex2(c)} in body", pos)
      }
      out.write_byte(c)
      i += 1
    }
    if !bad.is_empty() {
      return (out.freeze(), bad, pos)
    }
    if !rerr.is_empty() {
      return (out.freeze(), if rerr == "EOF" { "" } else { rerr }, pos)
    }
  }
}

/// A part as NextPart returns it: its headers, and whether its body is
/// quoted-printable (the Content-Transfer-Encoding header removed).
struct Next {
  header: Header
  qp: Bool
}

/// nextPart: Some(part) at a part's headers, None at the end of the parts,
/// or the error.
fn (var r: R) next_part(max_header_size: Int, max_headers: Int) -> Next? ! Str {
  if r.dash_boundary == b"--" {
    return Err("multipart: boundary is empty")
  }
  var expect_new = false
  while {
    let (line, e) = r.read_slice()
    if e == "EOF" && r.is_final_boundary(line) {
      return None
    }
    if !e.is_empty() {
      return Err("multipart: NextPart: ${e}")
    }
    if r.is_boundary_delimiter_line(line) {
      r.parts_read += 1
      let h = match r.read_header(max_header_size, max_headers) {
        Ok(h) => h
        Err(m) => {
          if m == "EOF" {
            // a streamed body's read error is the source's, as Go's
            // textproto returns its reader's error (a body ending in the
            // headers is io.EOF, the end, as in Go)
            if !r.src_err.is_empty() {
              return Err(r.src_err)
            }
            return None
          }
          return Err(if m == "message too large" { TOO_LARGE } else { m })
        }
      }
      var qp = false
      var hd = h
      if h.get("Content-Transfer-Encoding").to_lower() == "quoted-printable" {
        qp = true
        let i = hd.keys.index_of("Content-Transfer-Encoding") ?? 0
        let _k = hd.keys.remove_at(i)
        let _v = hd.values.remove_at(i)
      }
      return Some(Next{header: hd, qp: qp})
    }
    if r.is_final_boundary(line) {
      return None
    }
    if expect_new {
      return Err("multipart: expecting a new Part; got line ${go_q(line)}")
    }
    if r.parts_read == 0 {
      continue
    }
    if line == r.nl {
      expect_new = true
      continue
    }
    return Err("multipart: unexpected line in Next(): ${go_q(line)}")
  }
  None
}

/// The part's data and its read error ("" when none), decoded when
/// quoted-printable.
fn (var r: R) part_data(n: Next) -> (Bytes, Str) {
  let (raw, e) = r.read_part()
  if n.qp {
    return qp_decode(raw, e)
  }
  (raw, e)
}

/// Part.Close for a part ReadForm skips: Go drains it through its
/// decoder and drops the errors. A quoted-printable decoder reads the part
/// through a bufio.Reader, one partReader read (one scan) at a time, and
/// stops at a bad line: the reader goes on from the end of the read that
/// held it, inside the part (so its next line is NextPart's).
fn (var r: R) skip_part(n: Next) {
  if !n.qp {
    let _d = r.read_part()
    return
  }
  // the part's raw bytes and the end of each read (a streamed body's
  // buffer moves as it refills)
  var raw = BytesBuilder.new()
  var ends: List[Int] = []
  var total = 0
  var eof = false
  var e = ""
  while {
    let (k, se) = r.scan(total, eof)
    if k == 0 && se.is_empty() {
      if !r.more() {
        if !r.src_err.is_empty() {
          e = r.src_err
          break
        }
        eof = true
      }
      continue
    }
    raw.write(r.buf[r.pos..r.pos + k])
    r.pos += k
    total += k
    ends.push(total)
    if !se.is_empty() {
      e = if se == "EOF" { "" } else { se }
      break
    }
  }
  let rb = raw.freeze()
  let (_out, qe, used) = qp_decode_at(rb, e)
  if qe.is_empty() || qe == e {
    return
  }
  // the reader goes on from the end of the read that held the bad line:
  // the rest of the part is unread again
  for c in ends {
    if c >= used {
      r.buf = rb[c..] + r.buf[r.pos..]
      r.pos = 0
      return
    }
  }
}

/// filepath.Base on a Unix path.
fn base(p: Str) -> Str {
  if p.is_empty() {
    return "."
  }
  var s = p
  while s.len() > 1 && s.ends_with("/") {
    s = s[0..s.len() - 1]
  }
  if s == "/" {
    return "/"
  }
  let b = s.bytes()
  var i = b.len() - 1
  while i >= 0 && b[i] != 47 {
    i -= 1
  }
  s[i + 1..]
}

/// FormName and FileName from Content-Disposition.
fn names(h: Header) -> (Str, Str) {
  match mime.parse_media_type(h.get("Content-Disposition")) {
    Ok(m) => {
      let name = if m.kind == "form-data" { m.params.get("name") ?? "" } else { "" }
      let f = m.params.get("filename") ?? ""
      (name, if f.is_empty() { "" } else { base(f) })
    }
    Err(_) => ("", "")
  }
}

fn first_values(h: Header) -> Map[Str, Str] {
  var m: Map[Str, Str] = {}
  for i in 0..h.keys.len() {
    m.put(h.keys[i], h.values[i][0])
  }
  m
}

fn to_part(h: Header, data: Bytes) -> Part {
  let (name, file) = names(h)
  Part{name: name, filename: if file.is_empty() { None } else { Some(file) }, headers: first_values(h), data: data}
}

/// A part's head as Reader.next_part reads it (Go's Part without its
/// data): `name` is the form field (FormName), `filename` its file name
/// (FileName), `headers` the first value of each header, keys in
/// canonical form; a quoted-printable part's Content-Transfer-Encoding
/// is removed, as Go's NextPart does.
pub struct PartHead {
  pub name: Str
  pub filename: Str?
  pub headers: Map[Str, Str]
  /// every header as [name, value, ...] in order (MIMEHeader's values)
  fields: List[Str]
}

/// Every value of the part's header name, in order (MIMEHeader's
/// values); [] when it has none.
pub fn (h: PartHead) header_values(name: Str) -> List[Str] {
  let k = textproto.canonical_key(name)
  var vs: List[Str] = []
  var i = 0
  while i + 1 < h.fields.len() {
    if h.fields[i] == k {
      vs.push(h.fields[i + 1])
    }
    i += 2
  }
  vs
}

/// Parts read one at a time from a streamed body (Go's multipart.Reader
/// and its open Part): a body larger than memory, or one read as it
/// arrives. Holds, past the API, the open part's head (for a
/// quoted-printable part's skip), whether one is open, how much of its
/// data was read and whether the body ends there (scan's total and eof),
/// its end and error; a quoted-printable part's decoded data, read at
/// pos (decoded whole at its first read); the end of the parts; an error
/// that sticks.
pub struct Reader[fx: Effects] {
  r: R[fx]
  cur: Next
  open: Bool
  total: Int
  eof: Bool
  end: Bool
  err: Str
  pend: Bytes
  ppos: Int
  qp_read: Bool
  last: Bool
  failed: Str
}

/// A reader of the body `src` gives, whose parts are separated by
/// `boundary` (Go's NewReader): each call of src gives the body's next
/// bytes, None at its end, or its read error's text, which next_part
/// and read return.
pub fn reader[fx: Effects](src: fn() -> Bytes? ! Str uses fx, boundary: Str) -> Reader[fx] {
  Reader{r: reader_over(b"", boundary, [src]), cur: Next{header: Header{keys: [], values: []}, qp: false}, open: false, total: 0, eof: false, end: false, err: "", pend: b"", ppos: 0, qp_read: false, last: false, failed: ""}
}

/// The next part's head, None after the last part (NextPart's io.EOF),
/// or the error, which sticks: the open part's rest is read and dropped
/// first (Part.Close).
pub fn (var r: Reader[fx]) next_part() -> PartHead? ! MultipartErr uses fx {
  match r.head_next() {
    Ok(h) => Ok(h)
    Err(m) => Err(MultipartErr{msg: m})
  }
}

/// At most max bytes of the open part's data (decoded when
/// quoted-printable), None at its end or with no part open, or the read
/// error (Part.Read).
pub fn (var r: Reader[fx]) read(max: Int = 32768) -> Bytes? ! MultipartErr uses fx {
  if max < 1 {
    fault("multipart.Reader.read: max must be at least 1, got ${max}")
  }
  match r.data_next(max) {
    Ok(d) => Ok(d)
    Err(m) => Err(MultipartErr{msg: m})
  }
}

fn (var s: Reader) head_next() -> PartHead? ! Str {
  if !s.failed.is_empty() {
    return Err(s.failed)
  }
  if s.last {
    return None
  }
  if s.open {
    if s.cur.qp && !s.qp_read {
      s.r.skip_part(s.cur)
    } else if !s.cur.qp {
      while !s.end {
        let (_d, e) = s.chunk(1048576)
        if !e.is_empty() {
          break
        }
      }
    }
    s.open = false
  }
  let n = match s.r.next_part(MAX_HEADER_SIZE, MAX_HEADERS) {
    Ok(Some(n)) => n
    Ok(None) => {
      s.last = true
      return None
    }
    Err(m) => {
      s.failed = if m == "message too large" { TOO_LARGE } else { m }
      return Err(s.failed)
    }
  }
  s.cur = n
  s.open = true
  s.total = 0
  s.eof = false
  s.end = false
  s.err = ""
  s.pend = b""
  s.ppos = 0
  s.qp_read = false
  let (name, file) = names(n.header)
  var fields: List[Str] = []
  for i in 0..n.header.keys.len() {
    for v in n.header.values[i] {
      fields.push(n.header.keys[i])
      fields.push(v)
    }
  }
  Some(PartHead{name: name, filename: if file.is_empty() { None } else { Some(file) }, headers: first_values(n.header), fields: fields})
}

/// At most max bytes of the open part's raw data and "", or no bytes and
/// "" at its end (s.end) or the read error.
fn (var s: Reader) chunk(max: Int) -> (Bytes, Str) {
  while true {
    if s.end {
      return (b"", s.err)
    }
    let (n, e) = s.r.scan(s.total, s.eof)
    if n == 0 && e.is_empty() {
      if !s.r.more() {
        if !s.r.src_err.is_empty() {
          s.end = true
          s.err = s.r.src_err
          return (b"", s.err)
        }
        s.eof = true
      }
      continue
    }
    let k = if n < max { n } else { max }
    let data = s.r.buf[s.r.pos..s.r.pos + k]
    s.r.pos += k
    s.total += k
    if k == n && !e.is_empty() {
      s.end = true
      s.err = if e == "EOF" { "" } else { e }
    }
    if k > 0 {
      return (data, "")
    }
  }
  (b"", "")
}

fn (var s: Reader) data_next(max: Int) -> Bytes? ! Str {
  if !s.failed.is_empty() {
    return Err(s.failed)
  }
  if !s.open {
    return None
  }
  if s.cur.qp {
    if !s.qp_read {
      s.qp_read = true
      let (raw, e) = s.r.read_part()
      let (d, de) = qp_decode(raw, e)
      s.pend = d
      s.err = de
    }
    let left = s.pend.len() - s.ppos
    if left == 0 {
      if !s.err.is_empty() {
        return Err(s.err)
      }
      return None
    }
    let k = if left < max { left } else { max }
    let out = s.pend[s.ppos..s.ppos + k]
    s.ppos += k
    return Some(out)
  }
  let (d, e) = s.chunk(max)
  if !d.is_empty() {
    return Some(d)
  }
  if !e.is_empty() {
    return Err(e)
  }
  None
}

fn escape_quotes(s: Str) -> Str { s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\r", "%0D").replace("\n", "%0A") }
