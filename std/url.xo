// std/url (spec/std.md 20, decision 0279). Encoding
// rules are listed at the top of std/prelude.xo. Go's net/url query and
// path escaping and url.Values. Pure.
//
// std/url on the native backends (decision 0279): Go's net/url escaping
// and Values, ported from url.go of go1.26 (QueryEscape, PathEscape,
// QueryUnescape, PathUnescape: escape and unescape with the
// encodeQueryComponent and encodePathSegment modes; ParseQuery and
// Values.Encode), with the same results and error texts. One difference,
// spec/std.md 0: a decoded byte sequence that is not UTF-8 keeps each
// invalid byte as its `%XX` escape, so Str stays valid UTF-8 (Go returns
// the raw bytes).


/// A malformed escape or query; displays as Go's text, for example
/// `invalid URL escape "%zz"`.
pub struct EscapeErr {
  pub msg: Str
}

pub fn (e: EscapeErr) display() -> Str { e.msg }

/// s escaped for a query key or value: space as `+`, every byte but
/// letters, digits, `-`, `.`, `_`, and `~` as `%XX` (url.QueryEscape).
pub fn query_escape(s: Str) -> Str { escape(s, false) }

/// The inverse of query_escape: `+` is a space, `%XX` a byte.
pub fn query_unescape(s: Str) -> Str ! EscapeErr { unescape(s, true) }

/// s escaped for one path segment: space as `%20`, `/` escaped
/// (url.PathEscape).
pub fn path_escape(s: Str) -> Str { escape(s, true) }

/// The inverse of path_escape: `%XX` a byte, `+` stays `+`.
pub fn path_unescape(s: Str) -> Str ! EscapeErr { unescape(s, false) }

/// Query keys with their values in order (url.Values): keys in the order
/// they first appeared, each with every value given for it. A value, not
/// a handle.
pub struct Values {
  ks: List[Str]
  vs: List[List[Str]]
}

pub fn values() -> Values { Values{ks: [], vs: []} }

/// `a=1&b=2&a=3` into Values; a `;` separator, a bad escape, or more than
/// 10000 parameters is an error, as url.ParseQuery.
pub fn parse_query(s: Str) -> Values ! EscapeErr {
  let parts = s.split("&")
  if parts.len() > MAX_PARAMS {
    return Err(EscapeErr{msg: "number of URL query parameters exceeded limit"})
  }
  let big = s.len() > OWN_MIN
  // the keys' positions in a Map, so many distinct keys stay linear
  var at: Map[Str, Int] = {}
  var ks: List[Str] = []
  var vs: List[List[Str]] = []
  // Go's parseQuery: a pair with a semicolon sets its error whatever came
  // before, so it wins over an earlier escape error
  if s.contains(";") {
    return Err(EscapeErr{msg: "invalid semicolon separator in query"})
  }
  for pair in parts {
    if pair.is_empty() {
      continue
    }
    let (k0, x0) = match pair.find("=") {
      Some(i) => (pair[0..i], pair[i + 1..])
      None => (pair, "")
    }
    // stored in the result: copies for a long s (decision 0330, Str.clone)
    var k = query_unescape(k0)?
    var x = query_unescape(x0)?
    if big {
      k = k.clone()
      x = x.clone()
    }
    match at.get(k) {
      Some(i) => {
        var xs = vs[i]
        xs.push(x)
        vs.set(i, xs)
      }
      None => {
        at.put(k, ks.len())
        ks.push(k)
        vs.push([x])
      }
    }
  }
  Values{ks: ks, vs: vs}
}

/// The first value of key.
pub fn (v: Values) get(key: Str) -> Str? {
  let i = v.ks.index_of(key)?
  v.vs[i].first()
}

/// Every value of key, [] when missing.
pub fn (v: Values) all(key: Str) -> List[Str] {
  match v.ks.index_of(key) {
    Some(i) => v.vs[i]
    None => []
  }
}

pub fn (v: Values) has(key: Str) -> Bool { v.ks.contains(key) }

/// The keys in the order they first appeared.
pub fn (v: Values) keys() -> List[Str] { v.ks }

/// `a=1&b=2`, sorted by key, each value escaped with query_escape
/// (Values.Encode).
pub fn (v: Values) encode() -> Str {
  var out = StrBuilder.new()
  // the keys sorted as indexes: a key's values are read at its index, no
  // lookup of the key by name for each
  var order: List[Int] = []
  for i in 0..v.ks.len() {
    order.push(i)
  }
  let ks = v.ks
  order = order.sort_by(fn(i) { ks[i] })
  for i in order {
    let ek = query_escape(ks[i])
    for x in v.vs[i] {
      if out.len() > 0 {
        out.write("&")
      }
      out.write(ek)
      out.write("=")
      out.write(query_escape(x))
    }
  }
  out.freeze()
}

/// Adds a value after the key's others.
pub fn (var v: Values) add(key: Str, value: Str) {
  match v.ks.index_of(key) {
    Some(i) => {
      var xs = v.vs[i]
      xs.push(value)
      v.vs.set(i, xs)
    }
    None => {
      v.ks.push(key)
      v.vs.push([value])
    }
  }
}

/// Replaces every value of key with value.
pub fn (var v: Values) set(key: Str, value: Str) {
  match v.ks.index_of(key) {
    Some(i) => v.vs.set(i, [value])
    None => {
      v.ks.push(key)
      v.vs.push([value])
    }
  }
}

/// Removes key and its values.
pub fn (var v: Values) remove(key: Str) {
  if let Some(i) = v.ks.index_of(key) {
    let _k = v.ks.remove_at(i)
    let _v = v.vs.remove_at(i)
  }
}

/// url.go defaultMaxParams: ParseQuery's limit on parameters.
const MAX_PARAMS: Int = 10000

const UPPER_HEX: Str = "0123456789ABCDEF"

/// Go's EscapeError: strconv.Quote of the escape's three bytes, which may
/// cut a rune (`"%#\xc3"`).
fn escape_error(b: Bytes) -> EscapeErr { EscapeErr{msg: "invalid URL escape ${go_q(b)}"} }

/// strconv.Quote of bytes: \xNN for each byte of an invalid sequence.
fn go_q(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s.quote()
  }
  var out = StrBuilder.new()
  out.write("\"")
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      let h = "0123456789abcdef"
      let v = Int(b[i])
      out.write("\\x" + h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1])
    } else {
      let q = b[i..i + n].to_str().or_fault("rune").quote()
      out.write(q[1..q.len() - 1])
    }
    i += n
  }
  out.write("\"")
  out.freeze()
}

fn is_unreserved(c: UInt8) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126
}

/// encoding_table.go: the bytes a mode leaves as they are. A query
/// component keeps the unreserved bytes; a path segment also keeps
/// `$ & + : = @` (RFC 3986 section 3.3 less `/`, `;`, `,`).
fn keeps(c: UInt8, path: Bool) -> Bool {
  if is_unreserved(c) {
    return true
  }
  path && (c == 36 || c == 38 || c == 43 || c == 58 || c == 61 || c == 64)
}

/// s with every byte outside the query (path false) or path segment
/// (path true) set escaped as `%XX`, and in a query a space as `+` (Go's
/// escape with encodeQueryComponent or encodePathSegment). Native only:
/// std/native/url_native.xo writes the output through its address,
/// measured faster than BytesBuilder (decision 0597: 1.041 to 1.075 of
/// it on bench/perf/url escape); std/rt/url.go's Url_escape on the Go
/// backend.
fn escape(s: Str, path: Bool) -> Str

fn is_hex(c: UInt8) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn unhex(c: UInt8) -> Int {
  let v = Int(c)
  if v <= 57 { v - 48 } else if v <= 70 { v - 55 } else { v - 87 }
}

fn unescape(s: Str, query: Bool) -> Str ! EscapeErr {
  let b = s.bytes()
  var i = 0
  var escapes = 0
  var plus = false
  while i < b.len() {
    if b[i] == 37 {
      escapes += 1
      if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
        let end = if i + 3 < b.len() { i + 3 } else { b.len() }
        return Err(escape_error(b[i..end]))
      }
      i += 3
    } else {
      if b[i] == 43 && query {
        plus = true
      }
      i += 1
    }
  }
  if escapes == 0 && !plus {
    return s
  }
  var out = BytesBuilder.with_capacity(b.len())
  i = 0
  while i < b.len() {
    if b[i] == 37 {
      out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
      i += 3
    } else {
      out.write_byte(if b[i] == 43 && query { 32 } else { b[i] })
      i += 1
    }
  }
  text_of(out.freeze())
}

/// The bytes as Str, each byte of an invalid UTF-8 sequence as its `%XX`
/// escape (decision 0259's rule for URL parts).
fn text_of(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  let hex = UPPER_HEX.bytes()
  var out = BytesBuilder.with_capacity(b.len() + 8)
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      out.write_byte(37)
      out.write_byte(hex[Int(b[i]) >> 4])
      out.write_byte(hex[Int(b[i]) & 15])
    } else {
      out.write(b[i..i + n])
    }
    i += n
  }
  out.freeze().to_str() ?? ""
}

/// A query longer than this has its keys and values copied (Str.clone): a
/// token kept from a large query does not keep all of it alive. A shorter
/// query keeps its slices (a copy per token is +14% on a 30 byte query). The
/// rule depends on the query being a small object of its own: the server's
/// raw query is a slice of the request target, itself a copy of the head's
/// bytes (http1 parse_head, url_text_at), never of the read buffer.
const OWN_MIN = 4096
