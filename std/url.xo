// std/url (spec/std.md 20, decision 0279). Encoding
// rules are listed at the top of std/prelude.xo. Go's net/url query and
// path escaping and url.Values. Pure.
//
// std/url on the native backends (decision 0279): Go's net/url escaping
// and Values, ported from url.go of go1.26 (QueryEscape, PathEscape,
// QueryUnescape, PathUnescape: escape and unescape with the
// encodeQueryComponent and encodePathSegment modes; ParseQuery and
// Values.Encode), with the same results and error texts. One difference,
// spec/std.md 0: a decoded byte sequence that is not UTF-8 keeps each
// invalid byte as its `%XX` escape, so Str stays valid UTF-8 (Go returns
// the raw bytes).

use std/netip

/// A malformed escape or query; displays as Go's text, for example
/// `invalid URL escape "%zz"`.
pub struct EscapeErr {
  pub msg: Str
}

pub fn (e: EscapeErr) display() -> Str { e.msg }

/// s escaped for a query key or value: space as `+`, every byte but
/// letters, digits, `-`, `.`, `_`, and `~` as `%XX` (url.QueryEscape).
pub fn query_escape(s: Str) -> Str { escape(s, false) }

/// The inverse of query_escape: `+` is a space, `%XX` a byte.
pub fn query_unescape(s: Str) -> Str ! EscapeErr { unescape(s, true) }

/// s escaped for one path segment: space as `%20`, `/` escaped
/// (url.PathEscape).
pub fn path_escape(s: Str) -> Str { escape(s, true) }

/// The inverse of path_escape: `%XX` a byte, `+` stays `+`.
pub fn path_unescape(s: Str) -> Str ! EscapeErr { unescape(s, false) }

/// Query keys with their values in order (url.Values): keys in the order
/// they first appeared, each with every value given for it. A value, not
/// a handle.
pub struct Values {
  // up to SMALL keys: the keys in first-appearance order and each key's
  // values, found by a scan (the common query, no Map); past SMALL, m
  // holds them all, insertion ordered (decision 0091), and ks and vs
  // are empty, so a key is found in constant time, as in Go's map, where
  // a scan made reading every key of a query a peer fills with 10000
  // quadratic (65 ms against Go's 0.2). The form depends only on the
  // number of keys, so == compares contents.
  ks: List[Str]
  vs: List[List[Str]]
  m: Map[Str, List[Str]]
}

pub fn values() -> Values { Values{ks: [], vs: [], m: {}} }

/// Keys a Values keeps in its lists before it moves them into its Map
/// (bench/perf/url encode: a Map for a few keys was 1.083 of the lists).
const SMALL = 16

/// The Values of these keys and values (first-appearance order), in the
/// form their number calls for.
fn values_of(m: Map[Str, List[Str]]) -> Values {
  if m.len() > SMALL { Values{ks: [], vs: [], m: m} } else { Values{ks: m.keys(), vs: m.values(), m: {}} }
}

/// Moves the lists into the Map once they pass SMALL keys.
fn (var v: Values) grown() {
  if v.ks.len() > SMALL {
    for i in 0..v.ks.len() {
      v.m.put(v.ks[i], v.vs[i])
    }
    v.ks = []
    v.vs = []
  }
}

/// `a=1&b=2&a=3` into Values; a `;` separator, a bad escape, or more than
/// 10000 parameters is an error, as url.ParseQuery.
pub fn parse_query(s: Str) -> Values ! EscapeErr {
  // one pass counts the separators before any pair is made (GO-2026-4341,
  // Go's fix: a long run of `&` costs nothing) and finds a semicolon,
  // which wins over an escape error as in Go's parseQuery
  let b = s.bytes()
  var seps = 0
  var semi = false
  for c in b {
    if c == 38 {
      seps += 1
      if seps + 1 > MAX_PARAMS {
        return Err(EscapeErr{msg: "number of URL query parameters exceeded limit"})
      }
    } else if c == 59 {
      semi = true
    }
  }
  if semi {
    return Err(EscapeErr{msg: "invalid semicolon separator in query"})
  }
  let big = s.len() > OWN_MIN
  var v = values()
  // each pair from start to the next `&`, its first `=` found on the way
  // (Go's strings.Cut loop; no list of the parts)
  // (kesc, xesc: a `%` or `+` in the key or the value, so unescape runs
  // only on the parts that have one, not a second pass over every part)
  var start = 0
  var eq = -1
  var kesc = false
  var xesc = false
  for i in 0..b.len() + 1 {
    if i < b.len() && b[i] != 38 {
      let c = b[i]
      if c == 37 || c == 43 {
        if eq < 0 { kesc = true } else { xesc = true }
      } else if c == 61 && eq < 0 {
        eq = i
      }
      continue
    }
    if i > start {
      let (k0, x0) = if eq >= 0 { (s[start..eq], s[eq + 1..i]) } else { (s[start..i], "") }
      // stored in the result: copies for a long s (decision 0330, Str.clone)
      var k = if kesc { query_unescape(k0)? } else { k0 }
      var x = if xesc { query_unescape(x0)? } else { x0 }
      if big {
        k = k.clone()
        x = x.clone()
      }
      // lists up to SMALL keys (no Map for a small query), the Map past
      // them; a value pushed in place either way
      v.add(k, x)
    }
    start = i + 1
    eq = -1
    kesc = false
    xesc = false
  }
  v
}

/// The first value of key.
pub fn (v: Values) get(key: Str) -> Str? {
  if !v.m.is_empty() {
    return v.m.get(key)?.first()
  }
  let i = v.ks.index_of(key)?
  v.vs[i].first()
}

/// Every value of key, [] when missing.
pub fn (v: Values) all(key: Str) -> List[Str] {
  if !v.m.is_empty() {
    return v.m.get(key) ?? []
  }
  match v.ks.index_of(key) {
    Some(i) => v.vs[i]
    None => []
  }
}

pub fn (v: Values) has(key: Str) -> Bool {
  if v.m.is_empty() { v.ks.contains(key) } else { v.m.contains(key) }
}

/// The keys in the order they first appeared.
pub fn (v: Values) keys() -> List[Str] { if v.m.is_empty() { v.ks } else { v.m.keys() } }

/// `a=1&b=2`, sorted by key, each value escaped with query_escape
/// (Values.Encode).
pub fn (v: Values) encode() -> Str {
  var out = StrBuilder.new()
  if !v.m.is_empty() {
    for (k, xs) in v.m.entries().sort_by(fn(e) { e.0 }) {
      write_pairs(out, k, xs)
    }
    return out.freeze()
  }
  // the keys sorted as indexes: a key's values are read at its index, no
  // lookup of the key by name for each
  // (at most SMALL of them: an insertion sort, no key function)
  let ks = v.ks
  var order: List[Int] = []
  for i in 0..ks.len() {
    var j = order.len()
    order.push(i)
    while j > 0 && ks[order[j - 1]] > ks[i] {
      order.set(j, order[j - 1])
      j -= 1
    }
    order.set(j, i)
  }
  for i in order {
    write_pairs(out, ks[i], v.vs[i])
  }
  out.freeze()
}

/// `k=x` for each of xs, escaped, `&` between pairs.
fn write_pairs(var out: StrBuilder, k: Str, xs: List[Str]) {
  let ek = query_escape(k)
  for x in xs {
    if out.len() > 0 {
      out.write("&")
    }
    out.write(ek)
    out.write("=")
    out.write(query_escape(x))
  }
}

/// Adds a value after the key's others.
pub fn (var v: Values) add(key: Str, value: Str) {
  if !v.m.is_empty() {
    v.m.update(key, [], fn(var xs) { xs.push(value) })
    return
  }
  match v.ks.index_of(key) {
    // in place: a copy of the key's values, changed and set back, copied
    // them per value
    Some(i) => v.vs[i].push(value)
    None => {
      v.ks.push(key)
      v.vs.push([value])
      v.grown()
    }
  }
}

/// Replaces every value of key with value.
pub fn (var v: Values) set(key: Str, value: Str) {
  if !v.m.is_empty() {
    v.m.put(key, [value])
    return
  }
  match v.ks.index_of(key) {
    Some(i) => v.vs.set(i, [value])
    None => {
      v.ks.push(key)
      v.vs.push([value])
      v.grown()
    }
  }
}

/// Removes key and its values.
pub fn (var v: Values) remove(key: Str) {
  if !v.m.is_empty() {
    if v.m.remove(key) != None && v.m.len() <= SMALL {
      v = values_of(v.m)
    }
    return
  }
  if let Some(i) = v.ks.index_of(key) {
    let _k = v.ks.remove_at(i)
    let _v = v.vs.remove_at(i)
  }
}

/// url.go defaultMaxParams: ParseQuery's limit on parameters.
const MAX_PARAMS: Int = 10000

const UPPER_HEX: Str = "0123456789ABCDEF"

/// Go's EscapeError: strconv.Quote of the escape's three bytes, which may
/// cut a rune (`"%#\xc3"`).
fn escape_error(b: Bytes) -> EscapeErr { EscapeErr{msg: "invalid URL escape ${go_q(b)}"} }

/// strconv.Quote of bytes: \xNN for each byte of an invalid sequence.
fn go_q(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s.quote()
  }
  var out = StrBuilder.new()
  out.write("\"")
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      let h = "0123456789abcdef"
      let v = Int(b[i])
      out.write("\\x" + h[v >> 4..(v >> 4) + 1] + h[v & 15..(v & 15) + 1])
    } else {
      let q = b[i..i + n].to_str().or_fault("rune").quote()
      out.write(q[1..q.len() - 1])
    }
    i += n
  }
  out.write("\"")
  out.freeze()
}

fn is_unreserved(c: UInt8) -> Bool {
  (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 46 || c == 95 || c == 126
}

/// encoding_table.go: the bytes a mode leaves as they are. A query
/// component keeps the unreserved bytes; a path segment also keeps
/// `$ & + : = @` (RFC 3986 section 3.3 less `/`, `;`, `,`).
fn keeps(c: UInt8, path: Bool) -> Bool {
  if is_unreserved(c) {
    return true
  }
  path && (c == 36 || c == 38 || c == 43 || c == 58 || c == 61 || c == 64)
}

/// s with every byte outside the query (path false) or path segment
/// (path true) set escaped as `%XX`, and in a query a space as `+` (Go's
/// escape with encodeQueryComponent or encodePathSegment). Native only:
/// std/native/url_native.xo writes the output through its address,
/// measured faster than BytesBuilder (decision 0597: 1.041 to 1.075 of
/// it on bench/perf/url escape); std/rt/url.go's Url_escape on the Go
/// backend.
fn escape(s: Str, path: Bool) -> Str

/// Whether s holds a control byte (below 0x20, or 0x7F), Go's
/// stringContainsCTLByte: eight bytes a step on the native backends
/// (std/native/url_native.xo, scan.ctl_at; a byte loop here was 10% of
/// bench/perf/urltype parse), std/rt/url.go's Url_has_ctl on the Go
/// backend.
fn has_ctl(s: Str) -> Bool

fn is_hex(c: UInt8) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn unhex(c: UInt8) -> Int {
  let v = Int(c)
  if v <= 57 { v - 48 } else if v <= 70 { v - 55 } else { v - 87 }
}

fn unescape(s: Str, query: Bool) -> Str ! EscapeErr {
  let b = s.bytes()
  var i = 0
  var escapes = 0
  var plus = false
  while i < b.len() {
    if b[i] == 37 {
      escapes += 1
      if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
        let end = if i + 3 < b.len() { i + 3 } else { b.len() }
        return Err(escape_error(b[i..end]))
      }
      i += 3
    } else {
      if b[i] == 43 && query {
        plus = true
      }
      i += 1
    }
  }
  if escapes == 0 && !plus {
    return s
  }
  var out = BytesBuilder.with_capacity(b.len())
  i = 0
  while i < b.len() {
    if b[i] == 37 {
      out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
      i += 3
    } else {
      out.write_byte(if b[i] == 43 && query { 32 } else { b[i] })
      i += 1
    }
  }
  text_of(out.freeze())
}

/// The bytes as Str, each byte of an invalid UTF-8 sequence as its `%XX`
/// escape (decision 0259's rule for URL parts).
fn text_of(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  let hex = UPPER_HEX.bytes()
  var out = BytesBuilder.with_capacity(b.len() + 8)
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    if r == '\u{FFFD}' && n == 1 {
      out.write_byte(37)
      out.write_byte(hex[Int(b[i]) >> 4])
      out.write_byte(hex[Int(b[i]) & 15])
    } else {
      out.write(b[i..i + n])
    }
    i += n
  }
  out.freeze().to_str() ?? ""
}

/// A query longer than this has its keys and values copied (Str.clone): a
/// token kept from a large query does not keep all of it alive. A shorter
/// query keeps its slices (a copy per token is +14% on a 30 byte query). The
/// rule depends on the query being a small object of its own: the server's
/// raw query is a slice of the request target, itself a copy of the head's
/// bytes (http1 parse_head, url_text_at), never of the read buffer.
const OWN_MIN = 4096

// The URL type (decision 0642): Go's url.URL, Parse, ParseRequestURI,
// String, Redacted, ResolveReference, Query, RequestURI, Hostname, Port
// and JoinPath, from url.go and encoding_table.go of go1.26, with the
// same results and error texts (urlstrictcolons at its 1.26 default: an
// http or https host has at most one colon outside brackets). Decoded
// parts follow this file's rule for bytes that are not UTF-8: each such
// byte stays as its `%XX` escape.

/// A URL that did not parse: displays as Go's *url.Error,
/// `parse "URL": reason`; op is empty for join_path's path errors, which
/// Go returns bare.
pub struct UrlErr {
  pub op: Str
  pub url: Str
  pub msg: Str
}

pub fn (e: UrlErr) display() -> Str {
  if e.op == "" { e.msg } else { "${e.op} ${go_q(e.url.bytes())}: ${e.msg}" }
}

/// A user name and an optional password (url.Userinfo; None is Go's
/// password not set, Some("") an empty one).
pub struct Userinfo {
  pub username: Str
  pub password: Str? = None
}

/// `user` or `user:password`, each escaped (Userinfo.String).
pub fn (u: Userinfo) display() -> Str {
  let s = escape_in(u.username, M_USER)
  match u.password {
    Some(p) => s + ":" + escape_in(p, M_USER)
    None => s
  }
}

/// A parsed URL, `[scheme:][//[userinfo@]host][/]path[?query][#fragment]`
/// or `scheme:opaque[?query][#fragment]` (url.URL). path and fragment are
/// decoded; raw_path and raw_fragment keep their text as written when
/// escaping the decoded form gives something else (escaped_path and
/// escaped_fragment read them). host is `host` or `host:port`, an IPv6
/// address in brackets.
pub struct Url {
  pub scheme: Str = ""
  /// encoded opaque data
  pub opaque: Str = ""
  pub user: Userinfo? = None
  pub host: Str = ""
  pub path: Str = ""
  pub raw_path: Str = ""
  /// a scheme followed by a path with no `//` (`file:/x`)
  pub omit_host: Bool = false
  /// a `?` with nothing after it
  pub force_query: Bool = false
  /// the query as written, without the `?` (query decodes it)
  pub raw_query: Str = ""
  pub fragment: Str = ""
  pub raw_fragment: Str = ""
}

/// raw as a URL, absolute or relative, a fragment after the first `#`
/// (url.Parse).
pub fn parse(raw: Str) -> Url ! UrlErr {
  let (u0, frag) = match raw.cut("#") {
    Some((a, f)) => (a, f)
    None => (raw, "")
  }
  var u = match parse_in(u0, false) {
    Ok(x) => x
    Err(e) => return Err(UrlErr{op: "parse", url: u0, msg: e.msg})
  }
  if frag == "" {
    return Ok(u)
  }
  if let Some(e) = u.set_fragment(frag) {
    return Err(UrlErr{op: "parse", url: raw, msg: e.msg})
  }
  Ok(u)
}

/// raw as an HTTP request target: absolute, or an absolute path, with no
/// fragment (`#` is part of the path or query) (url.ParseRequestURI).
pub fn parse_request_uri(raw: Str) -> Url ! UrlErr {
  match parse_in(raw, true) {
    Ok(u) => Ok(u)
    Err(e) => Err(UrlErr{op: "parse", url: raw, msg: e.msg})
  }
}

/// base parsed, the elements joined onto its path and cleaned, as text
/// (url.JoinPath).
pub fn join_path(base: Str, elems: List[Str]) -> Str ! UrlErr {
  let u = parse(base)?
  let (r, err) = u.joined(elems)
  if let Some(e) = err {
    return Err(UrlErr{op: "", url: "", msg: e.msg})
  }
  Ok(r.display())
}

/// Whether the URL has a scheme (URL.IsAbs).
pub fn (u: Url) is_abs() -> Bool { u.scheme != "" }

/// The URL's text (URL.String).
pub fn (u: Url) display() -> Str {
  // the parts as Strs, empty when absent, joined by one interpolation
  // (no validation of bytes; List.join of them was slower, 1.49 to 1.32
  // of Go on the Mac); the scheme's colon and the slashes are one piece,
  // and a URL without a user has no userinfo pieces (each piece is a copy
  // call)
  let (qm, frag) = if u.force_query || u.raw_query != "" { ("?", u.raw_query) } else { ("", "") }
  let (hash, efrag) = if u.fragment != "" { ("#", u.escaped_fragment()) } else { ("", "") }
  if u.opaque != "" {
    let colon = if u.scheme != "" { ":" } else { "" }
    return "${u.scheme}${colon}${u.opaque}${qm}${frag}${hash}${efrag}"
  }
  var sep = if u.scheme != "" { ":" } else { "" }
  var slashes = false
  var host = ""
  let has_user = has(u.user)
  if u.scheme != "" || u.host != "" || has_user {
    if !(u.omit_host && u.host == "" && !has_user) {
      if u.host != "" || u.path != "" || has_user {
        slashes = true
        sep = if u.scheme != "" { "://" } else { "//" }
      }
      host = escape_in(u.host, M_HOST)
    }
  }
  let path = u.escaped_path()
  var lead = ""
  if path != "" && !path.starts_with("/") && u.host != "" {
    lead = "/"
  } else if u.scheme == "" && !slashes {
    // nothing before the path: a first segment with a colon would read
    // as a scheme, so `./` keeps it a path
    let seg = match path.cut("/") {
      Some((x, _)) => x
      None => path
    }
    if seg.contains(":") {
      lead = "./"
    }
  }
  if slashes || host != "" {
    if let Some(ui) = u.user {
      let name = escape_in(ui.username, M_USER)
      if let Some(p) = ui.password {
        let pw = escape_in(p, M_USER)
        return "${u.scheme}${sep}${name}:${pw}@${host}${lead}${path}${qm}${frag}${hash}${efrag}"
      }
      return "${u.scheme}${sep}${name}@${host}${lead}${path}${qm}${frag}${hash}${efrag}"
    }
  }
  "${u.scheme}${sep}${host}${lead}${path}${qm}${frag}${hash}${efrag}"
}

/// display with a set password as `xxxxx` (URL.Redacted).
pub fn (u: Url) redacted() -> Str {
  var r = u
  if let Some(ui) = u.user {
    if has(ui.password) {
      r.user = Some(Userinfo{username: ui.username, password: Some("xxxxx")})
    }
  }
  r.display()
}

/// The path, escaped: raw_path when it is a valid encoding of path, else
/// path escaped (URL.EscapedPath).
pub fn (u: Url) escaped_path() -> Str {
  if u.raw_path != "" && valid_encoded(u.raw_path, M_PATH) {
    // the common answer without decoding into a new Str
    let d = decodes_to(u.raw_path, u.path)
    if d == 1 {
      return u.raw_path
    }
    if d == 2 {
      match unescape_in(u.raw_path, M_PATH) {
        Ok(p) => if p == u.path {
          return u.raw_path
        }
        Err(_) => {}
      }
    }
  }
  if u.path == "*" {
    return "*"
  }
  escape_in(u.path, M_PATH)
}

/// The fragment, escaped, as escaped_path (URL.EscapedFragment).
pub fn (u: Url) escaped_fragment() -> Str {
  if u.raw_fragment != "" && valid_encoded(u.raw_fragment, M_FRAG) {
    // the common answer without decoding into a new Str
    let d = decodes_to(u.raw_fragment, u.fragment)
    if d == 1 {
      return u.raw_fragment
    }
    if d == 2 {
      match unescape_in(u.raw_fragment, M_FRAG) {
        Ok(f) => if f == u.fragment {
          return u.raw_fragment
        }
        Err(_) => {}
      }
    }
  }
  escape_in(u.fragment, M_FRAG)
}

/// ref parsed and resolved against u (URL.Parse).
pub fn (u: Url) parse_ref(r: Str) -> Url ! UrlErr { Ok(u.resolve_reference(parse(r)?)) }

/// r resolved against u as a base, RFC 3986 section 5.2 (dot segments
/// removed; URL.ResolveReference).
pub fn (u: Url) resolve_reference(r: Url) -> Url {
  // each case builds its result from the fields it keeps, where Go copies
  // ref and overwrites (a copy here is a reference count per Str)
  let scheme = if r.scheme == "" { u.scheme } else { r.scheme }
  if r.scheme != "" || r.host != "" || has(r.user) {
    var url = Url{scheme: scheme, opaque: r.opaque, user: r.user, host: r.host, omit_host: r.omit_host, force_query: r.force_query, raw_query: r.raw_query, fragment: r.fragment, raw_fragment: r.raw_fragment}
    let _e = url.set_path(resolve_path(r.escaped_path(), ""))
    return url
  }
  if r.opaque != "" {
    return Url{scheme: scheme, opaque: r.opaque, raw_path: r.raw_path, omit_host: r.omit_host, force_query: r.force_query, raw_query: r.raw_query, fragment: r.fragment, raw_fragment: r.raw_fragment}
  }
  // an empty ref keeps the base's query, and its fragment too when ref
  // has none
  let keep_q = r.path == "" && !r.force_query && r.raw_query == ""
  let raw_query = if keep_q { u.raw_query } else { r.raw_query }
  let (fragment, raw_fragment) = if keep_q && r.fragment == "" { (u.fragment, u.raw_fragment) } else { (r.fragment, r.raw_fragment) }
  if r.path == "" && u.opaque != "" {
    return Url{scheme: scheme, opaque: u.opaque, raw_path: r.raw_path, omit_host: r.omit_host, force_query: r.force_query, raw_query: raw_query, fragment: fragment, raw_fragment: raw_fragment}
  }
  var url = Url{scheme: scheme, user: u.user, host: u.host, omit_host: r.omit_host, force_query: r.force_query, raw_query: raw_query, fragment: fragment, raw_fragment: raw_fragment}
  let _e = url.set_path(resolve_path(u.escaped_path(), r.escaped_path()))
  url
}

/// raw_query decoded; a pair that does not decode is left out, as
/// URL.Query drops ParseQuery's error.
pub fn (u: Url) query() -> Values {
  var v = values()
  let q = u.raw_query
  if q.count("&") + 1 > MAX_PARAMS {
    return v
  }
  for pair in q.split("&") {
    if pair == "" || pair.contains(";") {
      continue
    }
    let (k0, x0) = match pair.cut("=") {
      Some((a, x)) => (a, x)
      None => (pair, "")
    }
    match query_unescape(k0) {
      Ok(k) => match query_unescape(x0) {
        Ok(x) => v.add(k, x)
        Err(_) => {}
      }
      Err(_) => {}
    }
  }
  v
}

/// The path and query an HTTP request line carries (URL.RequestURI).
pub fn (u: Url) request_uri() -> Str {
  var r = u.opaque
  if r == "" {
    r = u.escaped_path()
    if r == "" {
      r = "/"
    }
  } else if r.starts_with("//") {
    r = u.scheme + ":" + r
  }
  if u.force_query || u.raw_query != "" {
    r = r + "?" + u.raw_query
  }
  r
}

/// host without its port, an IPv6 address without brackets
/// (URL.Hostname).
pub fn (u: Url) hostname() -> Str { split_host_port(u.host).0 }

/// The port after host's last colon, "" when none (URL.Port).
pub fn (u: Url) port() -> Str { split_host_port(u.host).1 }

/// u with the elements joined onto its path and the result cleaned, a
/// trailing `/` kept from the last (URL.JoinPath; a path that does not
/// decode leaves the path as it was).
pub fn (u: Url) join_path(elems: List[Str]) -> Url { u.joined(elems).0 }

/// Escape modes: Go's encoding values (encoding_table.go).
const M_PATH = 1
const M_SEG = 2
const M_HOST = 4
const M_ZONE = 8
const M_USER = 16
const M_QUERY = 32
const M_FRAG = 64
/// MODES's bit for the reserved bytes validEncoded lets stand as they are
/// (`! $ & ' ( ) * + , ; = : @ [ ] %`), whatever the mode
const M_VALID = 128

fn has[T](o: T?) -> Bool {
  match o {
    Some(_) => true
    None => false
  }
}

/// Per byte, the escape modes that keep it as it is (Go's
/// encoding_table.go table, without its hexChar bit; checked against it
/// when this was written), and M_VALID on the reserved bytes
/// valid_encoded lets stand (every entry from 0x80 is 0).
const MODES: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xcc\x0c\x00\xdf\x80\xdf\x8c\xcc\xcc\xcc\xdf\xdd\x7f\x7f\x41\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\xcf\xdd\x0c\xdf\x0c\x40\xc3\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x8c\x00\x8c\x00\x7f\x00\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x7f\x00\x00\x00\x7f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

/// Whether mode leaves c as it is (Go's table[c]&mode != 0).
fn keeps_in(c: Int, mode: Int) -> Bool { (Int(MODES[c]) & mode) != 0 }

/// s with every byte mode does not keep as `%XX` (escape for the modes
/// but the query component).
fn escape_in(s: Str, mode: Int) -> Str {
  let first = escape_at(s.bytes(), mode)
  if first < 0 {
    return s
  }
  escape_from(s, first, mode, MODES)
}

/// The index of the first byte of b that mode escapes, or -1, by modes
/// (MODES), and s escaped from first (its first such byte) by them: on
/// the native backends std/native/url_native.xo's, which load the table
/// with no bounds test and write the output through its address (the
/// scan a byte at a time here, and the output appended to a Str, were
/// 16% of bench/perf/urltype string, 2026-11-14); std/rt/url.go's
/// Url_first_escape and Url_escape_from on the Go backend.
fn first_escape(b: Bytes, mode: Int, modes: Bytes) -> Int

fn escape_from(s: Str, first: Int, mode: Int, modes: Bytes) -> Str

/// The bytes with every one mode does not keep as `%XX`, as text (Go's
/// escape of a string holding them, which may not be UTF-8).
fn escape_bytes(b: Bytes, mode: Int) -> Str {
  let hex = UPPER_HEX.bytes()
  var out = BytesBuilder.with_capacity(b.len() * 3)
  for c in b {
    let v = Int(c)
    if (Int(MODES[v]) & mode) != 0 {
      out.write_byte(c)
    } else {
      out.write_byte(37)
      out.write_byte(hex[v >> 4])
      out.write_byte(hex[v & 15])
    }
  }
  out.freeze().to_str() ?? ""
}

/// The index of the first byte of b that mode escapes, or -1.
fn escape_at(b: Bytes, mode: Int) -> Int { first_escape(b, mode, MODES) }

/// unescape for the modes but the query component: a host's escapes may
/// only stand for bytes from 0x80 (or `%25`), a zone's for bytes a host
/// keeps, a space, or `%25`, and a host or zone byte below 0x80 that the
/// mode does not keep is an error.
fn unescape_in(s: Str, mode: Int) -> Str ! EscapeErr {
  let hostish = mode == M_HOST || mode == M_ZONE
  if !hostish && s.find("%") == None {
    return Ok(s)
  }
  let raw = unescape_bytes(s, mode)?
  if raw.len() == s.len() {
    // no escape decoded (a host checked byte by byte)
    return Ok(s)
  }
  Ok(text_of(raw))
}

/// unescape_in's bytes as decoded, before section 0's rule for bytes
/// that are not UTF-8.
fn unescape_bytes(s: Str, mode: Int) -> Bytes ! EscapeErr {
  let hostish = mode == M_HOST || mode == M_ZONE
  let b = s.bytes()
  var n = 0
  var i = 0
  while i < b.len() {
    let c = Int(b[i])
    if c == 37 {
      n += 1
      if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
        let end = if i + 3 < b.len() { i + 3 } else { b.len() }
        return Err(escape_error(b[i..end]))
      }
      let pct = b[i + 1] == 50 && b[i + 2] == 53
      if mode == M_HOST && unhex(b[i + 1]) < 8 && !pct {
        return Err(escape_error(b[i..i + 3]))
      }
      if mode == M_ZONE {
        let v = unhex(b[i + 1]) * 16 + unhex(b[i + 2])
        if !pct && v != 32 && !keeps_in(v, M_HOST) {
          return Err(escape_error(b[i..i + 3]))
        }
      }
      i += 3
    } else {
      if hostish && c < 128 && !keeps_in(c, mode) {
        return Err(EscapeErr{msg: "invalid character ${go_q(b[i..i + 1])} in host name"})
      }
      i += 1
    }
  }
  if n == 0 {
    return Ok(b)
  }
  var out = BytesBuilder.with_capacity(b.len())
  i = 0
  while i < b.len() {
    if b[i] == 37 {
      out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
      i += 3
    } else {
      out.write_byte(b[i])
      i += 1
    }
  }
  Ok(out.freeze())
}

/// Whether raw decodes to want: 1 yes, 0 no, 2 unknown (an escape gives
/// a byte from 0x80, whose decoded form depends on the UTF-8 around it,
/// or an escape is malformed), so the caller decodes. No Str is made.
fn decodes_to(raw: Str, want: Str) -> Int {
  let b = raw.bytes()
  let w = want.bytes()
  var i = 0
  var j = 0
  while i < b.len() {
    var c = b[i]
    if c == 37 {
      if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
        return 2
      }
      let v = unhex(b[i + 1]) * 16 + unhex(b[i + 2])
      if v >= 128 {
        return 2
      }
      c = UInt8(v)
      i += 3
    } else {
      i += 1
    }
    if j >= w.len() || w[j] != c {
      return 0
    }
    j += 1
  }
  if j == w.len() { 1 } else { 0 }
}

/// Whether s, as written, needs no escaping in mode beyond the reserved
/// bytes it may hold as they are (url.go validEncoded).
fn valid_encoded(s: Str, mode: Int) -> Bool { first_escape(s.bytes(), mode | M_VALID, MODES) < 0 }

/// "" or `:` and digits (validOptionalPort).
fn valid_port(p: Str) -> Bool {
  if p == "" {
    return true
  }
  let b = p.bytes()
  if b[0] != 58 {
    return false
  }
  for i in 1..b.len() {
    if b[i] < 48 || b[i] > 57 {
      return false
    }
  }
  true
}

/// The path set from its text as written: decoded, with raw_path kept
/// when escaping gives something else (setPath); the error leaves the
/// URL as it was.
fn (var u: Url) set_path(p: Str) -> EscapeErr? {
  // the common path: no escape and nothing to escape, so it is its own
  // decoded and escaped form
  if escape_at(p.bytes(), M_PATH) < 0 {
    u.path = p
    u.raw_path = ""
    return None
  }
  match unescape_bytes(p, M_PATH) {
    Ok(bytes) => {
      match bytes.to_str() {
        Some(d) => {
          u.raw_path = if escape_in(d, M_PATH) == p { "" } else { p }
          u.path = d
        }
        None => {
          // bytes that are not UTF-8: the path keeps them as escapes
          // (section 0's rule), and raw_path is the text Go's escaped form
          // gives (the written text when it is a valid encoding, else
          // Go's escape of the bytes), so display writes what Go writes
          u.path = text_of(bytes)
          u.raw_path = if valid_encoded(p, M_PATH) { p } else { escape_bytes(bytes, M_PATH) }
        }
      }
      None
    }
    Err(e) => Some(e)
  }
}

/// The fragment set as set_path sets the path (setFragment).
fn (var u: Url) set_fragment(f: Str) -> EscapeErr? {
  if escape_at(f.bytes(), M_FRAG) < 0 {
    u.fragment = f
    u.raw_fragment = ""
    return None
  }
  match unescape_bytes(f, M_FRAG) {
    Ok(bytes) => {
      match bytes.to_str() {
        Some(d) => {
          u.raw_fragment = if escape_in(d, M_FRAG) == f { "" } else { f }
          u.fragment = d
        }
        None => {
          // bytes that are not UTF-8: the fragment keeps them as escapes
          // (section 0's rule), and raw_fragment is the text Go's escaped form
          // gives (the written text when it is a valid encoding, else
          // Go's escape of the bytes), so display writes what Go writes
          u.fragment = text_of(bytes)
          u.raw_fragment = if valid_encoded(f, M_FRAG) { f } else { escape_bytes(bytes, M_FRAG) }
        }
      }
      None
    }
    Err(e) => Some(e)
  }
}

/// url.go parse: rawURL without its fragment; via_request is
/// ParseRequestURI's form.
fn parse_in(raw: Str, via_request: Bool) -> Url ! EscapeErr {
  if has_ctl(raw) {
    return Err(EscapeErr{msg: "net/url: invalid control character in URL"})
  }
  if raw == "" && via_request {
    return Err(EscapeErr{msg: "empty url"})
  }
  var u = Url{}
  if raw == "*" {
    u.path = "*"
    return Ok(u)
  }
  // getScheme: letters, then letters, digits, `+`, `-`, `.`, up to `:`
  let b = raw.bytes()
  var rest = raw
  for i in 0..b.len() {
    let c = Int(b[i])
    if (c >= 97 && c <= 122) || (c >= 65 && c <= 90) {
      continue
    }
    if (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46 {
      if i == 0 {
        break
      }
      continue
    }
    if c == 58 {
      if i == 0 {
        return Err(EscapeErr{msg: "missing protocol scheme"})
      }
      u.scheme = raw[0..i].to_lower()
      rest = raw[i + 1..raw.len()]
    }
    break
  }
  if rest.ends_with("?") && rest.count("?") == 1 {
    u.force_query = true
    rest = rest[0..rest.len() - 1]
  } else if let Some((a, q)) = rest.cut("?") {
    rest = a
    u.raw_query = q
  }
  if !rest.starts_with("/") {
    if u.scheme != "" {
      // a scheme and no slash: the rest is opaque
      u.opaque = rest
      return Ok(u)
    }
    if via_request {
      return Err(EscapeErr{msg: "invalid URI for request"})
    }
    let seg = match rest.cut("/") {
      Some((a, _)) => a
      None => rest
    }
    if seg.contains(":") {
      return Err(EscapeErr{msg: "first path segment in URL cannot contain colon"})
    }
  }
  if (u.scheme != "" || (!via_request && !rest.starts_with("///"))) && rest.starts_with("//") {
    var authority = rest[2..rest.len()]
    rest = ""
    if let Some(i) = authority.find("/") {
      rest = authority[i..authority.len()]
      authority = authority[0..i]
    }
    let (user, host) = parse_authority(u.scheme, authority)?
    u.user = user
    u.host = host
  } else if u.scheme != "" && rest.starts_with("/") {
    u.omit_host = true
  }
  if let Some(e) = u.set_path(rest) {
    return Err(e)
  }
  Ok(u)
}

/// `[userinfo@]host` (parseAuthority): the host after the last `@`.
fn parse_authority(scheme: Str, authority: Str) -> (Userinfo?, Str) ! EscapeErr {
  let at = authority.rfind("@")
  let host = match at {
    Some(i) => parse_host(scheme, authority[i + 1..authority.len()])?
    None => parse_host(scheme, authority)?
  }
  let i = match at {
    Some(i) => i
    None => return Ok((None, host))
  }
  let ui = authority[0..i]
  if !valid_userinfo(ui) {
    return Err(EscapeErr{msg: "net/url: invalid userinfo"})
  }
  match ui.cut(":") {
    Some((name, pw)) => Ok((Some(Userinfo{username: unescape_in(name, M_USER)?, password: Some(unescape_in(pw, M_USER)?)}), host))
    None => Ok((Some(Userinfo{username: unescape_in(ui, M_USER)?}), host))
  }
}

/// The host, decoded, an IPv6 literal checked (parseHost).
fn parse_host(scheme: Str, host: Str) -> Str ! EscapeErr {
  if let Some(o) = host.rfind("[") {
    if o > 0 {
      return Err(EscapeErr{msg: "invalid IP-literal"})
    }
    let cb = match host.rfind("]") {
      Some(c) => c
      None => return Err(EscapeErr{msg: "missing ']' in host"})
    }
    let colon_port = host[cb + 1..host.len()]
    if !valid_port(colon_port) {
      return Err(EscapeErr{msg: "invalid port ${go_q(colon_port.bytes())} after host"})
    }
    let ucp = unescape_in(colon_port, M_HOST)?
    let name = host[1..cb]
    // RFC 6874: a zone after `%25`, with its own escapes
    let (hpart, zpart) = match name.find("%25") {
      Some(z) => (name[0..z], name[z..name.len()])
      None => (name, "")
    }
    let hb = unescape_bytes(hpart, M_HOST)?
    let zb = if zpart == "" { b"" } else { unescape_bytes(zpart, M_ZONE)? }
    if hb.to_str() is None {
      // no address has a byte from 0x80: refused with Go's text, where
      // the host as text (each such byte `%XX`) would read as a zone to
      // netip and could parse (`[::1%80]` as ::1 in zone 80)
      return Err(EscapeErr{msg: "invalid host: " + bracket_addr_err(hb, zb)})
    }
    let uh = (hb.to_str() ?? "") + text_of(zb)
    match netip.parse_addr(uh) {
      Ok(a) => if a.is_4() {
        return Err(EscapeErr{msg: "invalid IP-literal"})
      }
      Err(e) => return Err(EscapeErr{msg: "invalid host: " + e.display()})
    }
    return Ok("[" + uh + "]" + ucp)
  }
  if let Some(first) = host.find(":") {
    // urlstrictcolons (Go 1.26's default): an http or https host keeps
    // its first colon, so a second makes the port invalid
    var i = first
    let last = host.rfind(":") ?? first
    if last != first && scheme != "http" && scheme != "https" {
      i = last
    }
    let colon_port = host[i..host.len()]
    if !valid_port(colon_port) {
      return Err(EscapeErr{msg: "invalid port ${go_q(colon_port.bytes())} after host"})
    }
  }
  unescape_in(host, M_HOST)
}

/// Go's ParseAddr error for an address of hb's bytes (some from 0x80,
/// not UTF-8) and the zone zb: netip parses a stand in with each such
/// byte as `g` (no address character, so the same error at the same
/// offset, as Go's parser treats every byte that is not a digit, `.`,
/// `:` or `%` alike), and the input and the rest it names are quoted
/// from the bytes, as Go quotes them.
fn bracket_addr_err(hb: Bytes, zb: Bytes) -> Str {
  var sub = BytesBuilder.with_capacity(hb.len())
  for c in hb {
    sub.write_byte(if c >= 128 { 103 } else { c })
  }
  let st = (sub.freeze().to_str() ?? "") + text_of(zb)
  let m = match netip.parse_addr(st) {
    Ok(_) => return "ParseAddr(${go_q(hb)}): unable to parse IP"
    Err(e) => e.display()
  }
  let head = "ParseAddr(${st.quote()}): "
  if !m.starts_with(head) {
    return m
  }
  let rest = m[head.len()..m.len()]
  var reason = rest
  var at = ""
  if rest.ends_with("\")") {
    if let Some(k) = rest.rfind(" (at \"") {
      // the rest is the host part's tail: ASCII host bytes and `g`,
      // which quote as themselves
      let l = rest.len() - 1 - (k + 5) - 2
      if l >= 0 && l <= hb.len() {
        reason = rest[0..k]
        at = " (at ${go_q(hb[hb.len() - l..hb.len()])})"
      }
    }
  }
  var all = BytesBuilder.with_capacity(hb.len() + zb.len())
  all.write(hb)
  all.write(zb)
  "ParseAddr(${go_q(all.freeze())}): ${reason}${at}"
}

/// Letters, digits, and `-._:~!$&'()*+,;=%@` (validUserinfo).
fn valid_userinfo(s: Str) -> Bool {
  for c in s.bytes() {
    let v = Int(c)
    if (v >= 97 && v <= 122) || (v >= 65 && v <= 90) || (v >= 48 && v <= 57) {
      continue
    }
    let ok = match v {
      45 | 46 | 95 | 58 | 126 | 33 | 36 | 38 | 39 | 40 | 41 | 42 | 43 | 44 | 59 | 61 | 37 | 64 => true
      _ => false
    }
    if !ok {
      return false
    }
  }
  true
}

/// base and ref merged and their dot segments removed (resolvePath).
/// Go's buffer is `/` and the elements, each written with a `/` before
/// it but one written right after that first `/`, and `..` cuts back to
/// the last `/` after the first: that is the last element. So the
/// elements are kept in a list, `..` pops one, and the text is written
/// once at the end. Only the first element can lack its `/` (it is the
/// only one written while the buffer is `/` alone). The merged path
/// (base up to its last `/`, then ref) is walked as its two parts, whose
/// elements are those of base before that `/` and then ref's.
fn resolve_path(base: Str, r: Str) -> Str {
  // Go's full: the reference, or base up to its last `/` and the
  // reference
  var full = r
  if r == "" {
    if base == "" {
      return ""
    }
    full = base
  } else if !r.starts_with("/") {
    if let Some(i) = base.rfind("/") {
      full = base[0..i + 1] + r
    }
  }
  let b = full.bytes()
  let n = b.len()
  // Backward, each element's fate as one byte (1 kept): a `..` cancels
  // the nearest name before it that no later `..` cancelled, as Go's
  // forward truncation pops it; `.` and `..` themselves are dropped. So
  // the memory is a byte an element, not a stack of offsets
  // (GO-2026-6218's class: Go writes into one buffer and truncates).
  var fate = BytesBuilder.with_capacity(n + 1)
  var skip = 0
  var size = 2
  var end = n
  while true {
    var i = end - 1
    while i >= 0 && b[i] != 47 {
      i -= 1
    }
    let len = end - (i + 1)
    let k = elem_kind(b, i + 1, len)
    if k == 1 {
      fate.write_byte(0)
    } else if k == 2 {
      skip += 1
      fate.write_byte(0)
    } else if skip > 0 {
      skip -= 1
      fate.write_byte(0)
    } else {
      fate.write_byte(1)
      size += len + 1
    }
    if i < 0 {
      break
    }
    end = i
  }
  let fl = fate.freeze()
  let cnt = fl.len()
  // Forward, the kept names written: a `/` before each but the first
  // when it is bare (the path's first element, or one right after a
  // `..`: Go's `first`), and a `/` after a last `.` or `..`
  var out = BytesBuilder.with_capacity(size)
  out.write_byte(47)
  var any = false
  var prev = 0
  var e = 0
  var from = 0
  while true {
    var i = from
    while i < n && b[i] != 47 {
      i += 1
    }
    let k = elem_kind(b, from, i - from)
    if fl[cnt - 1 - e] == 1 {
      if any || !(e == 0 || prev == 2) {
        out.write_byte(47)
      }
      out.write(b[from..i])
      any = true
    }
    prev = k
    e += 1
    if i >= n {
      break
    }
    from = i + 1
  }
  if prev != 0 {
    out.write_byte(47)
  }
  let t = out.freeze().to_str() ?? ""
  // Go's dst[1:] when its second byte is `/`
  if t.len() > 1 && t.bytes()[1] == 47 {
    return t[1..t.len()]
  }
  t
}

/// The kind of the len bytes of b at at as a path element: 1 `.`, 2
/// `..`, 0 a name (the empty one too).
fn elem_kind(b: Bytes, at: Int, len: Int) -> Int {
  if len == 1 && b[at] == 46 {
    return 1
  }
  if len == 2 && b[at] == 46 && b[at + 1] == 46 {
    return 2
  }
  0
}

/// host and port of `host:port`; a port that is not digits stays in the
/// host, brackets come off an IPv6 host (splitHostPort).
fn split_host_port(hp: Str) -> (Str, Str) {
  var host = hp
  var port = ""
  if let Some(c) = hp.rfind(":") {
    if valid_port(hp[c..hp.len()]) {
      host = hp[0..c]
      port = hp[c + 1..hp.len()]
    }
  }
  if host.starts_with("[") && host.ends_with("]") {
    host = host[1..host.len() - 1]
  }
  (host, port)
}

/// joinPath: u with the elements joined and the error setPath gave.
fn (u: Url) joined(elems: List[Str]) -> (Url, EscapeErr?) {
  var all = [u.escaped_path()]
  for e in elems {
    all.push(e)
  }
  var p = ""
  if !all[0].starts_with("/") {
    all.set(0, "/" + all[0])
    let j = go_join(all)
    p = j[1..j.len()]
  } else {
    p = go_join(all)
  }
  if all[all.len() - 1].ends_with("/") && !p.ends_with("/") {
    p = p + "/"
  }
  var url = u
  let err = url.set_path(p)
  (url, err)
}

/// path.Join of the elements: the non-empty ones joined with `/` and
/// cleaned, "" when all are empty.
fn go_join(elems: List[Str]) -> Str {
  var parts: List[Str] = []
  for e in elems {
    if e != "" {
      parts.push(e)
    }
  }
  if parts.is_empty() {
    return ""
  }
  clean_path(parts.join("/"))
}

/// Go's path.Clean: repeated slashes and `.` elements dropped, each `..`
/// with the element before it, a `..` at the start of a rooted path
/// dropped, "." for nothing. (std/path's clean is not callable from here:
/// the Go backend builds std/url into its runtime, where std/path is a
/// program package.)
fn clean_path(p: Str) -> Str {
  if p == "" {
    return "."
  }
  let rooted = p.starts_with("/")
  let b = p.bytes()
  let n = b.len()
  // as resolve_path: each element's fate as one byte, found backward
  // (an empty element and `.` dropped, each `..` cancelling the nearest
  // name before it); the `..`s nothing cancels lead a relative path
  var fate = BytesBuilder.with_capacity(n + 1)
  var skip = 0
  var end = n
  while true {
    var i = end - 1
    while i >= 0 && b[i] != 47 {
      i -= 1
    }
    let len = end - (i + 1)
    let k = elem_kind(b, i + 1, len)
    if len == 0 || k == 1 {
      fate.write_byte(0)
    } else if k == 2 {
      skip += 1
      fate.write_byte(0)
    } else if skip > 0 {
      skip -= 1
      fate.write_byte(0)
    } else {
      fate.write_byte(1)
    }
    if i < 0 {
      break
    }
    end = i
  }
  let fl = fate.freeze()
  let cnt = fl.len()
  var out = BytesBuilder.with_capacity(n + 1)
  if rooted {
    out.write_byte(47)
  }
  var any = false
  if !rooted {
    for _ in 0..skip {
      if any {
        out.write_byte(47)
      }
      out.write_byte(46)
      out.write_byte(46)
      any = true
    }
  }
  var e = 0
  var from = 0
  while true {
    var i = from
    while i < n && b[i] != 47 {
      i += 1
    }
    if fl[cnt - 1 - e] == 1 {
      if any {
        out.write_byte(47)
      }
      out.write(b[from..i])
      any = true
    }
    e += 1
    if i >= n {
      break
    }
    from = i + 1
  }
  if !rooted && !any {
    return "."
  }
  out.freeze().to_str() ?? ""
}
