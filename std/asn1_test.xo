// std/asn1's API beyond the Go corpus (internal/stdtest/testdata/corpus/asn1).
use std/big
use std/time

test "oid parses, displays and encodes dotted" {
  let o = oid("1.2.840.113549.1.1.11") ?? e => fault("${e}")
  expect("${o}") == "1.2.840.113549.1.1.11"
  expect((Value.Oid(v: o).der() ?? e => fault("${e}")).to_hex()) == "06092a864886f70d01010b"
  expect(oid("2.999.3").is_ok()) == true
  for bad in ["", "1", "3.1", "1.40", "1.2.-3", "1.02", "1..2", "1.2.2147483648", "a.b"] {
    expect(oid(bad).is_ok()) == false
  }
}

test "bit_at and right_align are Go's BitString.At and RightAlign" {
  let v = Value.BitString(bytes: b"\xff\xc0", bit_len: 10)
  expect([0, 1, 7, 8, 9, 10, -1].map(fn(i: Int) -> Int { v.bit_at(i) })) == [1, 1, 1, 1, 1, 0, 0]
  expect(Value.Null.bit_at(0)) == 0
  expect(right_align(b"\xff\xc0", 10).to_hex()) == "03ff"
  expect(right_align(b"\xab", 8).to_hex()) == "ab"
  expect(right_align(b"", 0).to_hex()) == ""
}

test "tagged_as reads a context specific value as the schema says" {
  let raw = parse(b"\xa0\x03\x02\x01\x07") ?? e => fault("${e}")
  let ex = raw.tagged_as(true) ?? e => fault("${e}")
  expect(ex) == Value.Tagged(class: Class.ContextSpecific, tag: 0, explicit: true, v: Value.Int(v: big.from_int(7)))
  expect((ex.der() ?? e => fault("${e}")).to_hex()) == "a003020107"
  let imp = parse(b"\x81\x01\x05") ?? e => fault("${e}")
  let iv = imp.tagged_as(false, tag: TAG_INT) ?? e => fault("${e}")
  expect(iv) == Value.Tagged(class: Class.ContextSpecific, tag: 1, explicit: false, v: Value.Int(v: big.from_int(5)))
  expect((iv.der() ?? e => fault("${e}")).to_hex()) == "810105"
  expect(parse(b"\x80\x01\x05").ok().map(fn(v: Value) -> Bool { v.tagged_as(true).is_ok() })) == Some(false)
  expect(Value.Null.tagged_as(true).is_ok()) == false
}

test "an implicit tag keeps the constructed bit of what it tags" {
  let seq = Value.Sequence(items: [Value.Int(v: big.from_int(1))])
  let t = Value.Tagged(class: Class.ContextSpecific, tag: 1, explicit: false, v: seq)
  expect((t.der() ?? e => fault("${e}")).to_hex()) == "a103020101"
  let hi = Value.Tagged(class: Class.Application, tag: 200, explicit: true, v: Value.Null)
  expect((hi.der() ?? e => fault("${e}")).to_hex()) == "7f81480205 00".replace(" ", "")
}

test "a time outside a Time is WideTime; outside UTCTime an error" {
  // decision 0614: the wall clock and offset as written, der in UTC
  match parse(b"\x18\x1316001231235959+0530") ?? e => fault("${e}") {
    Value.WideTime(c, g) => {
      expect(g) == true
      expect(c.format(time.RFC3339)) == "1600-12-31T23:59:59+05:30"
      expect(c.unix()) == -11644493401
      expect((Value.WideTime(c: c, generalized: true).der() ?? e => fault("${e}")).to_hex()) == "180f31363030313233313138323935395a"
    }
    _ => fault("want WideTime")
  }
  let t = Time.from_unix(-1000000000 * 2)
  expect("${Value.UtcTime(t: t).der().err() ?? Asn1Err.Syntax(msg: "")}") == "asn1: structure error: cannot represent time as UTCTime"
  expect((Value.GeneralizedTime(t: t).der() ?? e => fault("${e}")).to_hex()) == "180f31393036303831363230323634305a"
}

test "der refuses what Marshal refuses" {
  expect(Value.Printable(s: "a*&b").der().is_ok()) == false
  expect(Value.Ia5(s: "é").der().is_ok()) == false
  expect(Value.Numeric(s: "1a").der().is_ok()) == false
  expect(Value.Oid(v: Oid{arcs: [1]}).der().is_ok()) == false
  expect(Value.Sequence(items: [Value.Oid(v: Oid{arcs: [3, 1]})]).der().is_ok()) == false
}

test "parse_prefix returns the rest" {
  let (v, rest) = parse_prefix(b"\x05\x00\x01\x02") ?? e => fault("${e}")
  expect(v) == Value.Null
  expect(rest.to_hex()) == "0102"
  expect("${parse(b"\x05\x00\x01").err() ?? Asn1Err.Syntax(msg: "")}") == "asn1: syntax error: trailing data"
}

/// n SEQUENCEs nested around a NULL, in DER (headers outer to inner).
fn nested(n: Int) -> Bytes {
  var lens: List[Int] = []
  var inner = 2
  for _ in 0..n {
    lens.push(inner)
    inner += 1 + head_len(inner)
  }
  var out = BytesBuilder.new()
  var i = n - 1
  while i >= 0 {
    out.write_byte(0x30)
    let l = lens[i]
    if l < 128 {
      out.write_byte(UInt8(l))
    } else {
      let k = head_len(l) - 1
      out.write_byte(UInt8(0x80 | k))
      var j = k - 1
      while j >= 0 {
        out.write_byte(UInt8((l >> (8 * j)) & 0xff))
        j -= 1
      }
    }
    i -= 1
  }
  out.write_byte(5)
  out.write_byte(0)
  out.freeze()
}

fn head_len(l: Int) -> Int {
  if l < 128 { 1 } else if l < 256 { 2 } else if l < 65536 { 3 } else { 4 }
}

test "nesting deeper than Go's 10000 levels is a structure error (GO-2026-5972)" {
  expect(parse(nested(9999)).is_ok()) == true
  expect(parse(nested(10000)).err().map(fn(e) { e.display() })) == Some("asn1: structure error: nesting depth exceeded")
  expect(parse(nested(200000)).err().map(fn(e) { e.display() })) == Some("asn1: structure error: nesting depth exceeded")
}

test "field reads Go's tag options" {
  let f = field("optional,explicit,tag:3,default:7,utf8", KIND_STR)
  expect(f.optional && f.explicit && f.tag == 3 && f.default_value == Some(7) && f.string_type == TAG_UTF8) == true
  expect(field("application", KIND_INT).tag) == 0
  expect(field("tag:x,bogus", KIND_INT).tag) == -1
  expect(field("set,omitempty,generalized", KIND_SEQUENCE).set) == true
}

/// A SEQUENCE { INTEGER, [0] EXPLICIT UTF8String OPTIONAL, [1] IMPLICIT INTEGER OPTIONAL, SEQUENCE OF PrintableString }
/// read and written field by field, as derive Asn1 does.
struct Rec {
  n: Int
  name: Str?
  k: Int
  tags: List[Str]
}

fn rec_fields() -> List[Field] {
  [field("", KIND_INT), field("optional,explicit,tag:0", KIND_STR), field("optional,tag:1", KIND_INT), field("", KIND_SEQUENCE)]
}

fn read_rec(der: Bytes) -> Rec ! Asn1Err {
  let fs = rec_fields()
  var top = field_reader(der)
  let v = top.need(field("", KIND_SEQUENCE))?
  var r = top.open(v)
  let n = r.need(fs[0])?.to_int()?
  let name = r.next(fs[1])?.map(fn(x: Value) -> Str { x.to_str() })
  let k = match r.next(fs[2])? {
    Some(x) => x.to_int()?
    None => 0
  }
  var lr = r.open_list(r.need(fs[3])?, KIND_STR)?
  var tags: List[Str] = []
  while !lr.done() {
    tags.push(lr.need(Field{kind: KIND_STR})?.to_str())
  }
  if !top.done() {
    return Err(Asn1Err.Syntax(msg: "trailing data"))
  }
  Rec{n: n, name: name, k: k, tags: tags}
}

fn write_rec(x: Rec) -> Bytes ! Asn1Err {
  let fs = rec_fields()
  var items: List[Value] = [int_value(x.n).with_field(fs[0])?]
  match x.name {
    Some(s) => items.push(str_value(s).with_field(fs[1])?)
    None => {}
  }
  if x.k != 0 {
    items.push(int_value(x.k).with_field(fs[2])?)
  }
  items.push(Value.Sequence(items: x.tags.map(fn(s: Str) -> Value { str_value(s) })).with_field(fs[3])?)
  Value.Sequence(items: items).der()
}

fn rec_err(r: Result[Rec, Asn1Err]) -> Str {
  match r {
    Ok(_) => "ok"
    Err(e) => "${e}"
  }
}

test "a struct reads and writes field by field" {
  let x = Rec{n: 5, name: Some("é"), k: 9, tags: ["a", "b*"]}
  let der = write_rec(x) ?? e => fault("${e}")
  expect(der.to_hex()) == "3015020105a0040c02c3a981010930071301610c02622a"
  let back = read_rec(der) ?? e => fault("${e}")
  expect(back.n == 5 && back.name == Some("é") && back.k == 9 && back.tags == ["a", "b*"]) == true
  let y = read_rec(b"\x30\x08\x02\x01\x01\x30\x03\x13\x01a") ?? e => fault("${e}")
  expect(y.name == None && y.k == 0 && y.tags == ["a"]) == true
  // Go's quirk: an explicit field's header is read before its tag is
  // compared, so an empty last element ends an optional explicit field
  expect(rec_err(read_rec(b"\x30\x05\x02\x01\x01\x30\x00"))) == "asn1: structure error: explicit tag has no child"
  expect(rec_err(read_rec(b"\x30\x03\x02\x01\x01"))) == "asn1: syntax error: sequence truncated"
  expect(rec_err(read_rec(b"\x30\x06\x02\x01\x01\x30\x01\x02"))) == "asn1: syntax error: truncated tag or length"
  expect(rec_err(read_rec(b"\x30\x07\x02\x01\x01\x30\x02\x02\x00"))) == "asn1: structure error: sequence tag mismatch"
}

test "printable allows * when asked, as Go's makePrintableString" {
  expect((Value.Printable(s: "*.example").der() ?? e => fault("${e}")).to_hex()) == "13092a2e6578616d706c65"
  expect(Value.Printable(s: "a&b").der().is_ok()) == false
  expect(str_value("*")) == Value.Utf8(s: "*")
}
