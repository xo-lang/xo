fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

test "go writes" {
  for (v, b16, b32, b64, l16, l32, l64, uv, sv) in WRITES {
    expect(u16_be(v).to_hex()) == b16
    expect(u32_be(v).to_hex()) == b32
    expect(u64_be(v).to_hex()) == b64
    expect(u16_le(v).to_hex()) == l16
    expect(u32_le(v).to_hex()) == l32
    expect(u64_le(v).to_hex()) == l64
    expect(uvarint(v).to_hex()) == uv
    expect(varint(v).to_hex()) == sv
    expect(get_uvarint(uvarint(v), 0)) == Some((v, uvarint(v).len()))
    expect(get_varint(varint(v), 0)) == Some((v, varint(v).len()))
  }
}

test "go reads" {
  for (h, at, b16, b32, b64, l16, l32, l64, i16b, i32b, i16l, i32l) in READS {
    let b = unhex(h)
    expect(get_u16_be(b, at)) == b16
    expect(get_u32_be(b, at)) == b32
    expect(get_u64_be(b, at)) == b64
    expect(get_u16_le(b, at)) == l16
    expect(get_u32_le(b, at)) == l32
    expect(get_u64_le(b, at)) == l64
    expect(get_i16_be(b, at)) == i16b
    expect(get_i32_be(b, at)) == i32b
    expect(get_i16_le(b, at)) == i16l
    expect(get_i32_le(b, at)) == i32l
  }
}

test "go varints" {
  for (h, uv, un, sv, sn) in VARINTS {
    let b = unhex(h)
    expect(get_uvarint(b, 0)) == if un > 0 { Some((uv, un)) } else { None }
    expect(get_varint(b, 0)) == if sn > 0 { Some((sv, sn)) } else { None }
  }
}

test "reads at an offset past a prefix" {
  let b = b"xx" + u32_be(0x01020304) + uvarint(300)
  expect(get_u32_be(b, 2)) == 0x01020304
  expect(get_uvarint(b, 6)) == Some((300, 2))
  expect(get_uvarint(b, 8)) == None
}
