// Go's reference layouts (time/format.go constants) against the Go output for 2026-11-06 14:05:09.123456789 UTC.
use std/time
fn sample() -> Time {
  let d = time.date(2026, 11, 6).or_fault("date")
  time.instant(d, time.ClockTime{hour: 14, minute: 5, second: 9, nanos: 123456789}, time.utc()).or_fault("instant")
}

test "format matches Go" {
  let t = sample()
  let z = time.utc()
  expect(format(t, z, "2006-01-02")) == "2026-11-06"
  expect(format(t, z, "2006-01-02T15:04:05Z07:00")) == "2026-11-06T14:05:09Z"
  expect(format(t, z, "2006-01-02T15:04:05-07:00")) == "2026-11-06T14:05:09+00:00"
  expect(format(t, z, "Mon Jan 2 15:04:05 MST 2006")) == "Fri Nov 6 14:05:09 UTC 2026"
  expect(format(t, z, "03:04PM")) == "02:05PM"
  expect(format(t, z, "3:04pm")) == "2:05pm"
  expect(format(t, z, "15:04:05.000")) == "14:05:09.123"
  expect(format(t, z, "15:04:05.999999999")) == "14:05:09.123456789"
  expect(format(t, z, "Jan _2 06 002")) == "Nov  6 26 310"
  expect(format(t, z, "{x}")) == "{x}"
}

test "layout is scanned once" {
  let l = layout("2006-01-02T15:04:05Z07:00")
  let t = sample()
  expect(l.format(t, time.utc())) == "2026-11-06T14:05:09Z"
  expect(l.parse("2026-11-06T14:05:09Z", time.utc()).or_fault("p")) == t - Duration.from_nanos(123456789)
  expect(l.parse("2026-11-06T15:05:09+01:00", time.utc()).or_fault("p")) == t - Duration.from_nanos(123456789)
}

test "parse matches Go" {
  let z = time.utc()
  let t = parse("2026-11-06T14:05:09Z", "2006-01-02T15:04:05Z07:00", z).or_fault("p1")
  let u = parse("Fri Nov 6 14:05:09 UTC 2026", "Mon Jan 2 15:04:05 MST 2006", z).or_fault("p2")
  expect(u) == t
  expect(parse("2026-13-06", "2006-01-02", z).is_err()) == true
  expect(parse("2026-11-06", "2006-01-02 3", z).is_err()) == true
  // one digit hour, a weekday that is not checked
  let nine = time.instant(time.date(2026, 11, 6).or_fault("d"), time.ClockTime{hour: 9, minute: 5, second: 0, nanos: 0}, z).or_fault("i")
  expect(parse("2026-11-06 9:05", "2006-01-02 15:04", z).or_fault("p3")) == nine
  expect(parse("Mon Nov 6 14:05:09 UTC 2026", "Mon Jan 2 15:04:05 MST 2006", z).or_fault("p4")) == t
  // an offset and an unknown zone name: the offset wins, as in Go (#116, timego fuzz seed 8)
  let off = parse("2017-02-01T16:26:03-09:30 ZZZ", "2006-01-02T15:04:05Z07:00 MST", z).or_fault("p5")
  expect(off.unix()) == 1486000563
  // a signed fraction: negative is out of range, a plus sign is read (Go's atoi; timego fuzz seed 10)
  match parse("11:41:44.-567712250", "15:04:05.000000000", z) {
    Ok(_) => fault("a negative fraction parsed")
    Err(e) => expect(e.go_msg) == "fractional second out of range"
  }
  let plus = parse("2026-11-06 11:41:44.+56771225", "2006-01-02 15:04:05.000000000", z).or_fault("p6")
  expect(plus) == parse("2026-11-06 11:41:44", "2006-01-02 15:04:05", z).or_fault("p7") + Duration.from_nanos(56771225)
  // a signed two digit year (Go's atoi; timego fuzz seed 20): "-3" is 1997, "+3" is 2003
  expect(parse("-3-4-6", "06-1-2", z).or_fault("p8")) == parse("1997-04-06", "2006-01-02", z).or_fault("p9")
  expect(parse("+3-4-6", "06-1-2", z).or_fault("p10")) == parse("2003-04-06", "2006-01-02", z).or_fault("p11")
  // the day of year's range is checked after the text: extra text first (timego fuzz seed 27)
  match parse("2023 4345", "2006 002", z) {
    Ok(_) => fault("p12 parsed")
    Err(e) => expect(e.go_kind) == 2
  }
  match parse("2023 434", "2006 002", z) {
    Ok(_) => fault("p13 parsed")
    Err(e) => expect(e.go_msg) == "day-of-year out of range"
  }
}

test "the layout constants are Go's" {
  let t = sample()
  let z = time.utc()
  expect(format(t, z, ANSIC)) == "Fri Nov  6 14:05:09 2026"
  expect(format(t, z, UNIX_DATE)) == "Fri Nov  6 14:05:09 UTC 2026"
  expect(format(t, z, RFC822)) == "06 Nov 26 14:05 UTC"
  expect(format(t, z, RFC850)) == "Friday, 06-Nov-26 14:05:09 UTC"
  expect(format(t, z, RFC1123Z)) == "Fri, 06 Nov 2026 14:05:09 +0000"
  expect(format(t, z, RFC3339_NANO)) == "2026-11-06T14:05:09.123456789Z"
  expect(format(t, z, KITCHEN)) == "2:05PM"
  expect(format(t, z, STAMP_MILLI)) == "Nov  6 14:05:09.123"
  expect(format(t, z, DATE_TIME)) == "2026-11-06 14:05:09"
  expect(format(t, z, TIME_ONLY)) == "14:05:09"
}

test "Civil.format years -1 to -999 and offsets under a minute match Go (b45 of the owner's v0.51.1 evaluation)" {
  let at = fn(y: Int, off: Int) -> time.Civil {
    time.Civil{date: time.Date{year: y, month: 3, day: 4}, time: time.ClockTime{hour: 5, minute: 6, second: 7, nanos: 0}, offset: Duration.from_nanos(off * 1000000000), zone: ""}
  }
  // Go's time.Format "2006-01-02" for each year
  expect(at(-1, 0).format("{year}-{month}-{day}")) == "-0001-03-04"
  expect(at(-99, 0).format("{year}")) == "-0099"
  expect(at(-999, 0).format("{year}")) == "-0999"
  expect(at(-1000, 0).format("{year}")) == "-1000"
  expect(at(-12345, 0).format("{year}")) == "-12345"
  expect(at(7, 0).format("{year}")) == "0007"
  // Go's "-0700" for each offset in seconds
  expect(at(2026, -59).format("{zone}")) == "+0000"
  expect(at(2026, -1).format("{zone}")) == "+0000"
  expect(at(2026, -60).format("{zone}")) == "-0001"
  expect(at(2026, -3600).format("{zone}")) == "-0100"
  expect(at(2026, 59).format("{zone}")) == "+0000"
  expect(at(2026, 60).format("{zone}")) == "+0001"
}
