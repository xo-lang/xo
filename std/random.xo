// std/random: random values of the normal and exponential distributions
// and random permutations, over any Rand (decision 0606). Ported from Go's
// math/rand/v2 (go1.26.1 normal.go, exp.go, Shuffle and Perm in rand.go):
// Marsaglia and Tsang's ziggurat with Go's tables. They draw through
// `r.int` and `r.float` alone, so they work on a test's seeded Rand and on
// a program's own Rand; a value equals Go's for the same draws. Pure.

/// A normally distributed Float, mean 0 and standard deviation 1 (Go's
/// NormFloat64): `mean + sd * random.normal(r)` for another distribution.
/// Each try draws `r.int(-2^31, 2^31)` and `r.int(0, 128)` where Go splits
/// one Uint64, then `r.float()` where Go calls Float64.
pub fn normal(r: Rand) -> Float uses rand {
  while true {
    let j = r.int(-2147483648, 2147483648)
    let i = r.int(0, 128)
    let x = Float(j) * WN[i]
    let aj = if j < 0 { -j } else { j }
    if aj < KN[i] {
      return x
    }
    if i == 0 {
      // the base strip's tail
      var tx = 0.0
      while true {
        tx = -r.float().log() * (1.0 / RN)
        let y = -r.float().log()
        if y + y >= tx * tx {
          break
        }
      }
      return if j > 0 { RN + tx } else { -RN - tx }
    }
    // float32 arithmetic, as Go's
    if Float32(FN[i]) + Float32(r.float()) * (Float32(FN[i - 1]) - Float32(FN[i])) < Float32((-0.5 * x * x).exp()) {
      return x
    }
  }
  0.0
}

/// An exponentially distributed Float, rate 1 (Go's ExpFloat64):
/// `random.exp(r) / rate` for another rate. Each try draws `r.int(0, 2^32)`
/// and `r.int(0, 256)` where Go splits one Uint64.
pub fn exp(r: Rand) -> Float uses rand {
  while true {
    let j = r.int(0, 4294967296)
    let i = r.int(0, 256)
    let x = Float(j) * WE[i]
    if j < KE[i] {
      return x
    }
    if i == 0 {
      return RE - r.float().log()
    }
    if Float32(FE[i]) + Float32(r.float()) * (Float32(FE[i - 1]) - Float32(FE[i])) < Float32((-x).exp()) {
      return x
    }
  }
  0.0
}

/// A random permutation of 0..n (Go's Perm): Fisher-Yates from the end,
/// `r.int(0, i + 1)` for each i from n - 1 down to 1, as Go's Shuffle.
/// A negative n faults (`invalid argument to Shuffle`).
pub fn perm(r: Rand, n: Int) -> List[Int] uses rand {
  if n < 0 {
    fault("invalid argument to Shuffle")
  }
  var p = List[Int].with_capacity(n)
  for i in 0..n {
    p.push(i)
  }
  var i = n - 1
  while i > 0 {
    let j = r.int(0, i + 1)
    let t = p[i]
    p[i] = p[j]
    p[j] = t
    i -= 1
  }
  p
}

