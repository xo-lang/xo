// std/toml module tests (decision 0616 section 2: the race evidence runs
// these under --race). After the TOML 1.1 spec's examples and
// pelletier/go-toml/v2's marshaler_test.go and unmarshaler_test.go: keys
// (bare, quoted, dotted), strings (basic, literal, multi-line), numbers,
// dates, arrays, tables and arrays of tables, the errors a bad document
// gives, encode's layout and options, and many tasks decoding at once.
use std/json

struct Server {
  host: Str
  port: Int
  tags: List[Str]
} derive Json

struct Config {
  title: Str
  debug: Bool = false
  ratio: Float
  server: Server
  owners: List[Owner]
} derive Json

struct Owner {
  name: Str
  admin: Bool = false
} derive Json

const DOC: Str = """
# a comment
title = "demo"
ratio = 0.5

[server]
host = 'localhost'
port = 8080
tags = ["a", "b"]

[[owners]]
name = "ann"
admin = true

[[owners]]
name = "bo"
"""

test "a document decodes into a record" {
  let c: Config = decode(DOC).or_fault("decode")
  expect(c.title) == "demo"
  expect(c.debug) == false
  expect(c.ratio) == 0.5
  expect(c.server.host) == "localhost"
  expect(c.server.port) == 8080
  expect(c.server.tags) == ["a", "b"]
  expect(c.owners.len()) == 2
  expect(c.owners[0].name) == "ann"
  expect(c.owners[0].admin) == true
  expect(c.owners[1].name) == "bo"
  expect(c.owners[1].admin) == false
}

test "keys: bare, quoted and dotted name the same tables" {
  let j = to_json("a.b = 1\n\"a\".'c' = 2\n[x . y]\nz = 3\n").or_fault("to_json")
  expect(j) == "{\"a\":{\"b\":1,\"c\":2},\"x\":{\"y\":{\"z\":3}}}"
}

test "strings: escapes, literal strings and multi-line strings" {
  let j = to_json("a = \"tab\\there \\u00e9\"\nb = 'C:\\path'\nc = \"\"\"\none \\\n  two\"\"\"\nd = '''\nraw\\n'''\n").or_fault("to_json")
  expect(j) == "{\"a\":\"tab\\there é\",\"b\":\"C:\\\\path\",\"c\":\"one two\",\"d\":\"raw\\\\n\"}"
}

test "numbers: underscores, hex, octal, binary, signs and special floats" {
  let j = to_json("a = 1_000\nb = 0xff\nc = 0o17\nd = 0b101\ne = -7\nf = +3\ng = 6.02e23\nh = -0.25\n").or_fault("to_json")
  expect(j) == "{\"a\":1000,\"b\":255,\"c\":15,\"d\":5,\"e\":-7,\"f\":3,\"g\":6.02e23,\"h\":-0.25}"
}

test "dates and times are their RFC 3339 text" {
  let j = to_json("a = 1979-05-27T07:32:00Z\nb = 1979-05-27\nc = 07:32:00\n").or_fault("to_json")
  expect(j.contains("\"a\":\"1979-05-27T07:32:00Z\"")) == true
  expect(j.contains("\"b\":\"1979-05-27\"")) == true
  expect(j.contains("\"c\":\"07:32:00\"")) == true
}

test "inline tables and nested arrays" {
  let j = to_json("p = { x = 1, y = { z = [1, [2, 3]] } }\n").or_fault("to_json")
  expect(j) == "{\"p\":{\"x\":1,\"y\":{\"z\":[1,[2,3]]}}}"
}

test "keys keep document order" {
  let j = to_json("z = 1\na = 2\nm = 3\n").or_fault("to_json")
  expect(j) == "{\"z\":1,\"a\":2,\"m\":3}"
}

test "a bad document is a TomlErr with its line" {
  for (doc, line) in [("a = ", 1), ("a = 1\nb = = 2\n", 2), ("a = 1\na = 2\n", 2), ("[t]\nx = 1\n[t]\n", 3), ("a = \"open\n", 1), ("a = 1\n\n\nb = [1,\n", 5)] {
    match to_json(doc) {
      Ok(j) => fault("${doc.quote()}: decoded as ${j}")
      Err(e) => {
        expect(e.line) == line
        expect(e.display().starts_with("toml: line ${line}: ")) == true
      }
    }
  }
}

test "decode tells a syntax error from a value that does not fit" {
  match decode[Server]("host = \n") {
    Err(DecodeErr.Syntax(e)) => expect(e.line) == 1
    Ok(_) => fault("want Syntax, decoded")
    Err(e) => fault("want Syntax, got ${e}")
  }
  match decode[Server]("host = 1\nport = 2\ntags = []\n") {
    Err(DecodeErr.Value(_)) => {}
    Ok(_) => fault("want Value, decoded")
    Err(e) => fault("want Value, got ${e}")
  }
}

test "encode lays out plain keys, then tables, then arrays of tables" {
  let c = Config{title: "demo", ratio: 0.5, server: Server{host: "h", port: 1, tags: ["x"]}, owners: [Owner{name: "ann", admin: true}]}
  let text = encode(c).or_fault("encode")
  expect(text) == "title = 'demo'\ndebug = false\nratio = 0.5\n\n[server]\nhost = 'h'\nport = 1\ntags = ['x']\n\n[[owners]]\nname = 'ann'\nadmin = true\n"
  let back: Config = decode(text).or_fault("decode")
  expect(back.server.tags) == ["x"]
  expect(back.owners[0].admin) == true
}

test "encode writes a basic string when a literal one cannot hold it" {
  let text = encode(Owner{name: "it's\n", admin: false}).or_fault("encode")
  expect(text) == "name = \"it's\\n\"\nadmin = false\n"
  let back: Owner = decode(text).or_fault("decode")
  expect(back.name) == "it's\n"
}

test "encode_with: inline tables, multi-line arrays and indented tables" {
  let c = Config{title: "t", ratio: 1.5, server: Server{host: "h", port: 2, tags: ["a", "b"]}, owners: []}
  let inline = encode_with(c, EncodeOptions{tables_inline: true}).or_fault("inline")
  expect(inline.contains("server = {host = 'h', port = 2, tags = ['a', 'b']}")) == true
  let multi = encode_with(c, EncodeOptions{arrays_multiline: true}).or_fault("multi")
  expect(multi.contains("tags = [\n  'a',\n  'b'\n]")) == true
  let ind = encode_with(c, EncodeOptions{indent_tables: true}).or_fault("indent")
  expect(ind.contains("[server]\n  host = 'h'")) == true
  for t in [inline, multi, ind] {
    let back: Config = decode(t).or_fault("decode ${t}")
    expect(back.server.tags) == ["a", "b"]
  }
}

test "encode refuses a value that is not a table" {
  match encode(3) {
    Ok(t) => fault("encoded ${t}")
    Err(e) => expect(e.line) == 0
  }
}

test "many tasks decode, convert and encode at once" {
  let docs = [DOC, "a.b = 1\n", "p = { x = [1, 2] }\n", "[[t]]\nx = 1\n[[t]]\nx = 2\n"]
  let bad = scope sc {
    var hs: List[Task[Int, Str]] = []
    for t in 0..8 {
      hs.push(sc.spawn(fn() -> Int ! Str {
        var n = 0
        for i in 0..200 {
          let d = docs[(t + i) % docs.len()]
          let j = to_json(d).map_err(fn(e) { "task ${t}: ${e}" })?
          let v: json.Value = json.decode_str(j).map_err(fn(e) { "task ${t}: ${e}" })?
          let again = encode(v).map_err(fn(e) { "task ${t}: ${e}" })?
          let j2 = to_json(again).map_err(fn(e) { "task ${t}: ${e}" })?
          if j2 != j { return Err("task ${t}: ${j} became ${j2}") }
          n += 1
        }
        Ok(n)
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.or_fault("task")
    }
    total
  }
  expect(bad) == 1600
}

test "a missing key takes the field's default, in json and in toml" {
  // a std module's own records read their defaults as a program's do:
  // before, the module under test read every defaulted field as required
  let j: Owner = json.decode_str("{\"name\":\"x\"}").or_fault("json")
  expect(j.admin) == false
  let t: Owner = decode("name = \"x\"\n").or_fault("toml")
  expect(t.admin) == false
}

// strict decode: go-toml's Decoder.DisallowUnknownFields
// (unmarshaler_test.go ExampleDecoder_DisallowUnknownFields,
// TestDecoderStrict, TestIssue866), plus fields Xo writes differently.

struct S13 {
  key1: Str
  key3: Str
} derive Json

struct S14 {
  key1: Str
  key4: Str
} derive Json

struct Bare {
  z: Int = 0
} derive Json

struct Inst {
  req: List[List[Str]]
  res: List[List[Str]]
} derive Json

struct Pipeline {
  mapping: Map[Str, Inst]
} derive Json

struct Pipelines {
  pipelines: Map[Str, Pipeline]
} derive Json

struct Omit {
  n as "n,omitempty": Int = 0
  s as "s,omitempty": Str = ""
  o: Int? = None
} derive Json

fn strict_errs[T: Json](doc: Str) -> List[StrictErr] {
  match decode[T](doc, strict: true) {
    Ok(_) => []
    Err(DecodeErr.Strict(errs)) => errs
    Err(e) => fault("not a strict error: ${e}")
  }
}

fn strict_text(errs: List[StrictErr]) -> Str { errs.map(fn(e: StrictErr) -> Str { e.context }).join("\n---\n") }

test "strict: an unknown key is an error with its line and context (go-toml's example)" {
  let doc = "\nkey1 = \"value1\"\nkey2 = \"value2\"\nkey3 = \"value3\"\n"
  let r = decode[S13](doc, strict: true)
  expect(r.is_err()) == true
  let e = match r {
    Err(e) => e
    Ok(_) => fault("decoded")
  }
  expect("${e}") == "strict mode: fields in the document are missing in the target struct"
  let errs = strict_errs[S13](doc)
  expect(errs.len()) == 1
  expect(errs[0].line) == 3
  expect(errs[0].column) == 1
  expect(errs[0].key) == ["key2"]
  expect(errs[0].msg) == "unknown field"
  expect("${errs[0]}") == "toml: line 3: unknown field key2"
  expect(strict_text(errs)) == "2| key1 = \"value1\"\n3| key2 = \"value2\"\n | ~~~~ unknown field\n4| key3 = \"value3\""
  // without strict the key is ignored
  let s = decode[S13](doc).or_fault("decode")
  expect(s.key3) == "value3"
}

test "strict: go-toml's TestDecoderStrict cases" {
  let many = "\nkey1 = \"value1\"\nkey2 = \"missing2\"\nkey3 = \"missing3\"\nkey4 = \"value4\"\n"
  expect(strict_text(strict_errs[S14](many))) == "2| key1 = \"value1\"\n3| key2 = \"missing2\"\n | ~~~~ unknown field\n4| key3 = \"missing3\"\n5| key4 = \"value4\"\n---\n2| key1 = \"value1\"\n3| key2 = \"missing2\"\n4| key3 = \"missing3\"\n | ~~~~ unknown field\n5| key4 = \"value4\""
  let dotted = strict_errs[Bare]("a.short.key=\"foo\"")
  expect(strict_text(dotted)) == "1| a.short.key=\"foo\"\n | ~~~~~~~~~~~ unknown field"
  expect(dotted[0].key) == ["a", "short", "key"]
  let table = strict_errs[Bare]("\n[foo]\nbar = 42\n")
  expect(strict_text(table)) == "2| [foo]\n |  ~~~ missing table\n3| bar = 42"
  expect(table[0].key) == ["foo"]
  expect(strict_text(strict_errs[Bare]("\n[[foo]]\nbar = 42"))) == "2| [[foo]]\n |   ~~~ missing table\n3| bar = 42"
  // each decodes without strict
  expect(decode[S14](many).is_ok()) == true
  expect(decode[Bare]("a.short.key=\"foo\"").is_ok()) == true
  expect(decode[Bare]("\n[foo]\nbar = 42\n").is_ok()) == true
  expect(decode[Bare]("\n[[foo]]\nbar = 42").is_ok()) == true
}

test "strict: a map takes every key (go-toml's TestIssue866)" {
  let doc = "\n[pipelines.register]\nmapping.inst.req = [\n    [\"param1\", \"value1\"],\n]\nmapping.inst.res = [\n    [\"param2\", \"value2\"],\n]\n"
  let p = decode[Pipelines](doc, strict: true).or_fault("strict")
  expect(p.pipelines.get_or_fault("register", "decoded").mapping.get_or_fault("inst", "decoded").req[0][0]) == "param1"
}

test "strict: keys in tables and arrays of tables, with their full key" {
  let doc = "title = \"t\"\nratio = 1.5\nextra = 1\n[server]\nhost = \"h\"\nport = 1\ntags = []\nnope.deep = 2\n[[owners]]\nname = \"a\"\n[[owners]]\nname = \"b\"\nrole = \"x\"\n[gone]\n[gone.sub]\n"
  let errs = strict_errs[Config](doc)
  expect(errs.map(fn(e: StrictErr) -> Str { "${e}" })) == [
    "toml: line 3: unknown field extra",
    "toml: line 8: unknown field server.nope.deep",
    "toml: line 13: unknown field owners.role",
    "toml: line 14: missing table gone",
    "toml: line 15: missing table gone.sub",
  ]
  expect(errs[3].column) == 2
  // an inline table is one unknown field; one inside a known table reports its key
  let inl = strict_errs[Config]("title = \"t\"\nratio = 1.0\nowners = []\nx = {a = 1, b = 2}\nserver = {host = \"h\", port = 1, tags = [], y = 3}\n")
  expect(inl.map(fn(e: StrictErr) -> Str { "${e}" })) == ["toml: line 4: unknown field x", "toml: line 5: unknown field server.y"]
}

test "strict: a field omitempty leaves out, or a None, is still known" {
  // to_value leaves these keys out of the decoded value; strict finds
  // T reads them
  let o = decode[Omit]("n = 0\ns = \"\"\no = 0\n", strict: true).or_fault("strict")
  expect(o.n) == 0
  expect(strict_errs[Omit]("n = 0\nq = 0\n").map(fn(e: StrictErr) -> Str { "${e}" })) == ["toml: line 2: unknown field q"]
}

/// decode's value or error, as decoding the document's JSON text gives it.
fn via_json[T: Json](d: Str) -> Str {
  match to_json(d) {
    Ok(j) => match json.decode[T](j.bytes()) {
      Ok(v) => json.encode(v).to_str() ?? ""
      Err(e) => "value error: ${e}"
    }
    Err(e) => "syntax: ${e}"
  }
}

fn direct[T: Json](d: Str) -> Str {
  match decode[T](d) {
    Ok(v) => json.encode(v).to_str() ?? ""
    Err(DecodeErr.Value(e)) => "value error: ${e}"
    Err(e) => "syntax: ${e}"
  }
}

test "decode gives what decoding its JSON text gives: escapes, non-ASCII, errors, deep nesting" {
  // decode hands the JSON codec its tape without the text (2026-11-18)
  expect(direct[Config](DOC)) == via_json[Config](DOC)
  let docs = [
    "host = \"h\\u00e9 \\\"q\\\" \\\\ \\n\\t\"\nport = 1\ntags = [\"\u{e9}t\u{e9}\", 'x\\y', \"\\u0001\"]\n",
    "\"h\u{e9}\" = 1\nhost = \"a\"\nport = -0\ntags = []\n",
    "host = 1\nport = 2\ntags = []\n",
    "host = \"h\"\nport = 2.5\ntags = []\n",
    "host = \"h\"\nport = 9223372036854775807\ntags = [1]\n",
    "host = \"h\"\nport = 1\ntags = [\"a\", [\"b\"]]\n",
    "host = \"h\"\nport = 1\ntags = []\nx = ${"[".repeat(10001)}${"]".repeat(10001)}\n",
    "host = \"h\"\nport = 1\ntags = []\nx = ${"[".repeat(9999)}${"]".repeat(9999)}\n",
  ]
  for d in docs {
    expect(direct[Server](d)) == via_json[Server](d)
  }
  expect(direct[Server](docs[0]).contains("h\u{e9} \\\"q\\\"")) == true
  expect(direct[Server](docs[6]).starts_with("value error:")) == true
}

fn tj(doc: Str) -> Str {
  match to_json(doc) {
    Ok(s) => s
    Err(e) => "err: ${e}"
  }
}

test "TOML 1.1: optional seconds, \\e and \\xHH escapes, inline tables over lines (go-toml v2.4.3)" {
  expect(tj("t = 13:37\nd = 1979-05-27T07:32Z\nl = 1979-05-27 07:32")) == "{\"t\":\"13:37:00\",\"d\":\"1979-05-27T07:32:00Z\",\"l\":\"1979-05-27T07:32:00\"}"
  expect(tj("s = \"\\e[0m\\x41\\xe9\"")) == "{\"s\":\"\\u001b[0mA\u{e9}\"}"
  expect(tj("a = {\n  x = 1, # one\n  y = 2,\n}")) == "{\"a\":{\"x\":1,\"y\":2}}"
  expect(tj("a = \"\\x4\"")) == "err: toml: line 1: bad unicode escape \\x4\""
  expect(tj("a = 07:32.5")) == "err: toml: line 1: bad value \"07:32.5\""
  expect(tj("a = {, x = 1}")) == "err: toml: line 1: expected a key, found ','"
  expect(tj("a = {x = 1,,}")) == "err: toml: line 1: expected a key, found ','"
  expect(tj("\u{3bc} = 1").starts_with("err: ")) == true
}
