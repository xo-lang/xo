// std/metrics (spec/std.md 37, decision 0325). Encoding
// rules are listed at the top of std/prelude.xo. Counters, gauges and
// histograms with label values, and their Prometheus text exposition
// (format version 0.0.4), with no dependency. A registry is a value
// that main makes and passes on.
//
// std/metrics on the native backends and, through std/go_compiled.txt, on
// the Go backend (decisions 0312 and 0325): one source. The instruments
// are Atomic cells in a per-instrument Mutex[Map] keyed by the label
// values; a series is made on its first use (the write lock) and found
// afterwards under the read lock.

use std/http

/// One series of an instrument: its label values and its cells (atomic
/// integers in one list, so reading a series out of the registry shares
/// one object, not one per field): cell 0 a counter's or gauge's float (its
/// bits), 1 the observation count, 2 the sum (bits), 3 and on a
/// histogram's bucket counts, one bucket each. Internal: use the
/// instruments.
pub struct Series {
  pub values: List[Str]
  pub cells: List[Atomic[Int]]
  /// a summary's quantile streams (one Mutex, none for another kind)
  pub q: List[Mutex[QState]]
}

/// A CKMS targeted quantile stream (beorn7/perks, which Prometheus'
/// client uses): samples (value, width, delta), the unsorted buffer, and
/// the count. Internal.
pub struct QSample {
  pub v: Float
  pub w: Float
  pub d: Float
}

pub struct QStream {
  pub l: List[QSample]
  pub b: List[Float]
  pub n: Float
}

/// A summary series' age buckets (client_golang's streams): every
/// observation goes into each; the head one answers; at a scrape with a
/// time, the head is reset and the next becomes head once its time ran
/// out. Internal.
pub struct QState {
  pub streams: List[QStream]
  pub head: Int
  pub exp_ms: Int
  /// observations not yet in the streams, as Float bits (client_golang's
  /// hot buffer), and how many: Atomics, so an observation writes no
  /// collection under the Mutex (a with body's first write to one copies it)
  pub hot: List[Atomic[Int]]
  pub hot_n: Atomic[Int]
}

/// A value read at scrape time from a collector: its label values and
/// value (decision 0411).
pub struct Sample {
  pub values: List[Str]
  pub value: Float
}

/// The kind of a collector's series.
pub enum Kind { Counter, Gauge }

/// One instrument: kind 0 counter, 1 gauge, 2 histogram, 3 summary;
/// reads: a scrape time reader (gauge_func, counter_func, collector);
/// objectives, max_age_ms and age_buckets: a summary's. Internal.
pub struct Family {
  pub name: Str
  pub help: Str
  pub kind: Int
  pub labels: List[Str]
  pub bounds: List[Float]
  pub series: Mutex[Map[Str, Series]]
  pub dropped: Atomic[Int]
  pub reads: List[fn() -> List[Sample]]
  pub objectives: List[(Float, Float)]
  pub max_age_ms: Int
  pub age_buckets: Int
}

/// A set of instruments. Cloning shares it. Its fields are internal.
pub struct Registry {
  pub families: Mutex[List[Family]]
  pub dropped: Atomic[Int]
}

/// A new empty registry. Xo has no program wide state: main makes one and
/// passes it to what registers or reads instruments.
pub fn registry() -> Registry {
  Registry{families: Mutex[List[Family]].new([]), dropped: Atomic[Int].new(0)}
}

/// A value that only goes up.
pub struct Counter {
  pub f: Family
}

/// A value that goes up and down.
pub struct Gauge {
  pub f: Family
}

/// Observations counted in buckets, with their count and sum.
pub struct Histogram {
  pub f: Family
}

/// Observations summarized as quantiles (within each objective's error),
/// with their count and sum.
pub struct Summary {
  pub f: Family
}

/// A held series (decision 0501, client_golang's WithLabelValues): made
/// once with `child(values)` and used in a hot loop with no label list,
/// key or lookup. A child shares the series' cells; cloning one shares them
/// again; it is safe from any task. `remove` and `reset` detach the series
/// from the exposition: a child made before keeps counting into the
/// detached series (take a new one after a remove), as in client_golang.
pub struct CounterChild {
  pub s: Series
}

pub struct GaugeChild {
  pub s: Series
}

pub struct HistogramChild {
  pub s: Series
  pub bounds: List[Float]
}

pub struct SummaryChild {
  pub s: Series
  pub objectives: List[(Float, Float)]
}

/// The buckets of request latencies in seconds: 0.005 to 10.
pub fn latency_buckets() -> List[Float] {
  [0.005, 0.01, 0.025, 0.05, 0.1, 0.25, 0.5, 1.0, 2.5, 5.0, 10.0]
}

/// Makes a counter named `name` (a Prometheus name: letters, digits, `_`
/// and `:`, not starting with a digit) with the label names `labels`. A
/// second instrument with the same name, an invalid name or label, or
/// buckets that do not increase is a fault: they are programmer errors,
/// found at start.
pub fn (r: Registry) counter(name: Str, help: Str, labels: List[Str] = []) -> Counter {
  Counter{f: make(r, 0, name, help, labels, [])}
}

pub fn (r: Registry) gauge(name: Str, help: Str, labels: List[Str] = []) -> Gauge {
  Gauge{f: make(r, 1, name, help, labels, [])}
}

pub fn (r: Registry) histogram(name: Str, help: Str, labels: List[Str] = [], buckets: List[Float] = latency_buckets()) -> Histogram {
  Histogram{f: make(r, 2, name, help, labels, buckets)}
}

/// Adds 1 to (or n >= 0 to) the series of the label `values` (one per
/// label name, in order; a wrong count is a fault). Safe from any task.
/// A registry holds at most `max_series` (10,000) series per instrument:
/// a new series past it is dropped and counted in
/// `xo_metrics_dropped_total`.
pub fn (c: Counter) inc(values: List[Str] = []) {
  c.add(1.0, values)
}

pub fn (c: Counter) add(n: Float, values: List[Str] = []) {
  if n < 0.0 {
    fault("metrics: a counter cannot decrease")
  }
  if hit_add(c.f, values, true, n) {
    return
  }
  if let Some(cells) = cells_of(c.f, values) {
    counter_cells_add(cells, n)
  }
}

pub fn (g: Gauge) set(v: Float, values: List[Str] = []) {
  if let Some(cells) = cells_of(g.f, values) {
    cells[0].set(v.to_bits())
  }
}

pub fn (g: Gauge) add(v: Float, values: List[Str] = []) {
  if hit_add(g.f, values, false, v) {
    return
  }
  if let Some(cells) = cells_of(g.f, values) {
    add_float(cells[0], v)
  }
}

pub fn (h: Histogram) observe(v: Float, values: List[Str] = []) {
  // a hit observes under the share, as hit_add adds
  if values.len() == h.f.labels.len() {
    let key = if values.len() == 1 { values[0] } else { values.join(SEP) }
    // the bucket found before the share, so the closure captures no list
    // of h.f (a captured heap field makes the Family owned: every call
    // retained and released its fields, histogram 1.76x, 2026-11-08)
    let nb = h.f.bounds.len()
    let b = bucket_of(h.f.bounds, v)
    let done = h.f.series.with_read(fn(m: Map[Str, Series]) -> Bool {
      match m.get(key) {
        Some(s) => {
          histogram_cell_add(s.cells, b, nb, v)
          true
        }
        None => false
      }
    })
    if done {
      return
    }
  }
  if let Some(cells) = cells_of(h.f, values) {
    histogram_add(cells, h.f.bounds, v)
  }
}

/// The child of the series of the label `values` (one per label name; a
/// wrong count is a fault): the series is made if it is new. Past
/// `max_series` the child counts into a series nothing exposes, and the drop
/// is counted in `xo_metrics_dropped_total` as `inc` counts it.
pub fn (c: Counter) child(values: List[Str] = []) -> CounterChild {
  CounterChild{s: child_series(c.f, values)}
}

pub fn (g: Gauge) child(values: List[Str] = []) -> GaugeChild {
  GaugeChild{s: child_series(g.f, values)}
}

pub fn (h: Histogram) child(values: List[Str] = []) -> HistogramChild {
  HistogramChild{s: child_series(h.f, values), bounds: h.f.bounds}
}

pub fn (s: Summary) child(values: List[Str] = []) -> SummaryChild {
  SummaryChild{s: child_series(s.f, values), objectives: s.f.objectives}
}

/// Adds 1 to (or n >= 0 to) the child's series.
pub fn (c: CounterChild) inc() {
  let _n = c.s.cells[1].add(1)
}

pub fn (c: CounterChild) add(n: Float) {
  if n < 0.0 {
    fault("metrics: a counter cannot decrease")
  }
  counter_cells_add(c.s.cells, n)
}

pub fn (g: GaugeChild) set(v: Float) {
  g.s.cells[0].set(v.to_bits())
}

pub fn (g: GaugeChild) add(v: Float) {
  add_float(g.s.cells[0], v)
}

pub fn (h: HistogramChild) observe(v: Float) {
  histogram_add(h.s.cells, h.bounds, v)
}

pub fn (s: SummaryChild) observe(v: Float) {
  summary_add(s.s, s.objectives, v)
}

/// A summary (Prometheus client_golang's Summary, decision 0411): each
/// objective (quantile, allowed error) is reported as a `quantile` series
/// (CKMS targeted quantiles, beorn7/perks), with `_sum` and `_count`. The
/// quantiles cover the last `max_age` in `age_buckets` steps, aged when a
/// scrape passes the time (`text(now)`, `handler_at(clock)`): a summary
/// never scraped with a time keeps every observation.
pub fn (r: Registry) summary(name: Str, help: Str, labels: List[Str] = [], objectives: List[(Float, Float)] = [], max_age: Duration = 10m, age_buckets: Int = 5) -> Summary {
  for (q, e) in objectives {
    if q < 0.0 || q > 1.0 || e < 0.0 || e > 1.0 {
      fault("metrics: summary objective ${q} with error ${e} is out of [0, 1]")
    }
  }
  if age_buckets < 1 {
    fault("metrics: a summary needs at least 1 age bucket")
  }
  let sorted = objectives.sort_by(fn(o: (Float, Float)) -> Float { o.0 })
  Summary{f: make(r, 3, name, help, labels, [], [], sorted, max_age.nanos() / 1000000, age_buckets)}
}

pub fn (s: Summary) observe(v: Float, values: List[Str] = []) {
  if let Some(x) = series_of(s.f, values) {
    summary_add(x, s.f.objectives, v)
  }
}

/// A gauge (counter) whose value f returns at each scrape (GaugeFunc,
/// CounterFunc).
pub fn (r: Registry) gauge_func(name: Str, help: Str, f: fn() -> Float) {
  let _f = make(r, 1, name, help, [], [], [fn() -> List[Sample] { [Sample{values: [], value: f()}] }])
}

pub fn (r: Registry) counter_func(name: Str, help: Str, f: fn() -> Float) {
  let _f = make(r, 0, name, help, [], [], [fn() -> List[Sample] { [Sample{values: [], value: f()}] }])
}

/// An instrument whose series f returns at each scrape (a Collector):
/// one Sample per series, its values one per label.
pub fn (r: Registry) collector(name: Str, help: Str, kind: Kind, labels: List[Str], f: fn() -> List[Sample]) {
  let _f = make(r, if kind is Kind.Counter { 0 } else { 1 }, name, help, labels, [], [f])
}

/// Removes the series of the label values (DeleteLabelValues): whether
/// there was one.
pub fn (c: Counter) remove(values: List[Str]) -> Bool { remove_series(c.f, values) }

pub fn (g: Gauge) remove(values: List[Str]) -> Bool { remove_series(g.f, values) }

pub fn (h: Histogram) remove(values: List[Str]) -> Bool { remove_series(h.f, values) }

pub fn (s: Summary) remove(values: List[Str]) -> Bool { remove_series(s.f, values) }

/// Removes every series (Reset).
pub fn (c: Counter) reset() { reset_series(c.f) }

pub fn (g: Gauge) reset() { reset_series(g.f) }

pub fn (h: Histogram) reset() { reset_series(h.f) }

pub fn (s: Summary) reset() { reset_series(s.f) }

/// The text exposition: `# HELP` and `# TYPE` lines and the series,
/// instruments in the order they were made, series sorted by label
/// values, histograms as cumulative `_bucket{le=...}`, `_sum` and
/// `_count`, and `xo_metrics_dropped_total`.
pub fn (r: Registry) text(now: Time? = None) -> Str {
  let fs = r.families.with_read(fn(l: List[Family]) -> List[Family] { l })
  let now_ms = match now {
    Some(t) => t.unix_millis()
    None => 0
  }
  var out: List[Str] = []
  for f in fs {
    out = out + expose(f, now_ms)
  }
  out.push("# HELP xo_metrics_dropped_total Series dropped past the per instrument limit.")
  out.push("# TYPE xo_metrics_dropped_total counter")
  out.push("xo_metrics_dropped_total ${r.dropped.get()}")
  "${out.join("\n")}\n"
}

/// A handler answering `text()` as `text/plain; version=0.0.4`:
/// `router.handle("GET /metrics", reg.handler())`.
pub fn (r: Registry) handler() -> fn(http.Request) -> http.Response {
  fn(_req) -> http.Response {
    http.Response{status: 200, headers: {"Content-Type": "text/plain; version=0.0.4; charset=utf-8"}, body: r.text().bytes()}
  }
}

/// handler, each scrape passing the clock's time to text (summaries age).
pub fn (r: Registry) handler_at(clock: Clock) -> fn(http.Request) -> http.Response uses clock {
  fn(_req) -> http.Response {
    http.Response{status: 200, headers: {"Content-Type": "text/plain; version=0.0.4; charset=utf-8"}, body: r.text(Some(clock.now())).bytes()}
  }
}

/// A middleware (`router.wrap(reg.middleware(clock, label))`) that counts
/// every request in `http_requests_total{method,route,status}`, times it
/// in `http_request_seconds{route}` (the default buckets) and tracks
/// `http_in_flight`. `label` names the route of a request for the `route`
/// label: pass a function that returns a bounded set (the matched pattern,
/// or the path with ids cut), never the raw path of an API with ids.
pub fn (r: Registry) middleware(clock: Clock, label: fn(http.Request) -> Str) -> fn(http.Request, http.Next) -> http.Response uses clock {
  let reqs = r.counter("http_requests_total", "Requests by method, route and status.", ["method", "route", "status"])
  let lat = r.histogram("http_request_seconds", "Request latency in seconds.", ["route"], latency_buckets())
  let inflight = r.gauge("http_in_flight", "Requests being served.")
  fn(req, next) -> http.Response {
    let route = label(req)
    inflight.add(1.0)
    let t0 = clock.now()
    let resp = next(req)
    let secs = clock.since(t0).seconds()
    inflight.add(-1.0)
    reqs.inc([req.method, route, "${resp.status}"])
    lat.observe(secs, [route])
    resp
  }
}

const SEP = "\x1f"

const MAX_SERIES = 10000

fn valid_name(s: Str, colon: Bool) -> Bool {
  if s.is_empty() {
    return false
  }
  for (i, c) in s.bytes().indexed() {
    let x = Int(c)
    let letter = (x >= 65 && x <= 90) || (x >= 97 && x <= 122) || x == 95 || (colon && x == 58)
    let digit = x >= 48 && x <= 57
    if !(letter || (digit && i > 0)) {
      return false
    }
  }
  true
}

fn make(r: Registry, kind: Int, name: Str, help: Str, labels: List[Str], bounds: List[Float], reads: List[fn() -> List[Sample]] = [], objectives: List[(Float, Float)] = [], max_age_ms: Int = 0, age_buckets: Int = 0) -> Family {
  if !valid_name(name, true) {
    fault("metrics: invalid metric name ${name.quote()}")
  }
  for l in labels {
    if !valid_name(l, false) || l.starts_with("__") || l == "le" || (kind == 3 && l == "quantile") {
      fault("metrics: invalid label name ${l.quote()}")
    }
  }
  for k in 1..bounds.len() {
    if bounds[k] <= bounds[k - 1] {
      fault("metrics: histogram buckets must increase")
    }
  }
  let f = Family{name: name, help: help, kind: kind, labels: labels, bounds: bounds, series: Mutex[Map[Str, Series]].new({}), dropped: r.dropped, reads: reads, objectives: objectives, max_age_ms: max_age_ms, age_buckets: age_buckets}
  let dup = r.families.with(fn(var fs: List[Family]) -> Bool {
    for g in fs {
      if g.name == name {
        return true
      }
    }
    fs.push(f)
    false
  })
  if dup {
    fault("metrics: ${name} is registered already")
  }
  f
}

/// One observation into the quantile buffer, the count and the sum of x.
fn summary_add(x: Series, objs: List[(Float, Float)], v: Float) {
  if !objs.is_empty() {
    x.q[0].with(fn(var st: QState) {
      var i = st.hot_n.get()
      if i == QBUF {
        qdrain(st, objs)
        i = 0
      }
      st.hot[i].set(v.to_bits())
      st.hot_n.set(i + 1)
    })
  }
  let _c = x.cells[1].add(1)
  add_float(x.cells[2], v)
}

/// Removes the series of values from f: whether there was one.
fn remove_series(f: Family, values: List[Str]) -> Bool {
  if values.len() != f.labels.len() {
    fault("metrics: ${f.name} has ${f.labels.len()} labels, got ${values.len()} values")
  }
  let key = values.join(SEP)
  f.series.with(fn(var m: Map[Str, Series]) -> Bool { m.remove(key) is Some(_) })
}

fn reset_series(f: Family) {
  f.series.with(fn(var m: Map[Str, Series]) { m = {} })
}

/// perks' buffer size: a stream merges its buffer when it holds this many.
const QBUF = 500

fn qstream_new() -> QStream { QStream{l: [], b: [], n: 0.0} }

fn qstate_new(k: Int) -> QState {
  var ss: List[QStream] = []
  for _ in 0..k {
    ss.push(qstream_new())
  }
  var hot: List[Atomic[Int]] = List.with_capacity(QBUF)
  for _ in 0..QBUF {
    hot.push(Atomic[Int].new(0))
  }
  QState{streams: ss, head: 0, exp_ms: 0, hot: hot, hot_n: Atomic[Int].new(0)}
}

/// Moves st's hot buffer into every stream, in the order observed (each
/// stream gets the qinsert calls an observation used to make at once);
/// the count is cleared last, so a fault leaves the buffer to drain again.
fn qdrain(var st: QState, objs: List[(Float, Float)]) {
  let n = st.hot_n.get()
  if n == 0 {
    return
  }
  var vs: List[Float] = List.with_capacity(n)
  for j in 0..n {
    vs.push(Float.from_bits(st.hot[j].get()))
  }
  for i in 0..st.streams.len() {
    for v in vs {
      qinsert(st.streams[i], v, objs)
    }
  }
  st.hot_n.set(0)
}

/// NewTargeted's invariant: the allowed rank error at rank r.
fn qf(objs: List[(Float, Float)], n: Float, r: Float) -> Float {
  var m = 1.7976931348623157e308
  for (q, e) in objs {
    let f = if q * n <= r { (2.0 * e * r) / q } else { (2.0 * e * (n - r)) / (1.0 - q) }
    if f < m {
      m = f
    }
  }
  m
}

fn qinsert(var s: QStream, v: Float, objs: List[(Float, Float)]) {
  s.b.push(v)
  if s.b.len() >= QBUF {
    qflush(s, objs)
  }
}

fn qflush(var s: QStream, objs: List[(Float, Float)]) {
  // both lists taken out of s, so each is the only holder and nothing
  // copies them (gotchas/element-copy-store-back-quadratic.md)
  var buf = s.b
  s.b = List.with_capacity(QBUF)
  let b = buf.sort()
  var old = s.l
  s.l = []
  // perks' merge, in one pass: each sorted value goes before the first
  // kept sample greater than it (perks shifts the tail per insert; the
  // samples and their order are the same)
  var l: List[QSample] = List.with_capacity(old.len() + b.len())
  var r = 0.0
  var i = 0
  for v in b {
    while i < old.len() && old[i].v <= v {
      r += old[i].w
      l.push(old[i])
      i += 1
    }
    let d = if i < old.len() { qf(objs, s.n, r).floor() - 1.0 } else { 0.0 }
    l.push(QSample{v: v, w: 1.0, d: if d > 0.0 { d } else { 0.0 }})
    s.n += 1.0
    r += 1.0
  }
  while i < old.len() {
    l.push(old[i])
    i += 1
  }
  s.l = qcompress(l, s.n, objs)
}

fn qcompress(l: List[QSample], n: Float, objs: List[(Float, Float)]) -> List[QSample] {
  if l.len() < 2 {
    return l
  }
  // perks' compress walks from the end, folding a sample into the kept
  // one after it while the invariant allows; its slice removal per fold
  // is a copy of the tail, so the kept samples are written once here,
  // from the end of a list of the same length, and the unused front cut
  var out: List[QSample] = List.with_capacity(l.len())
  for _ in 0..l.len() {
    out.push(QSample{v: 0.0, w: 0.0, d: 0.0})
  }
  var at = l.len() - 1
  var x = l[l.len() - 1]
  var r = n - 1.0 - x.w
  var i = l.len() - 2
  while i >= 0 {
    let c = l[i]
    if c.w + x.w + x.d <= qf(objs, n, r) {
      x = x with {w: x.w + c.w}
    } else {
      out[at] = x
      at -= 1
      x = c
    }
    r -= c.w
    i -= 1
  }
  out[at] = x
  out[at..out.len()]
}

/// The q quantile of s (NaN when it holds nothing): perks' Query.
fn qquery(var s: QStream, q: Float, objs: List[(Float, Float)]) -> Float {
  if s.l.is_empty() {
    // the fast path over the buffer alone
    let k = s.b.len()
    if k == 0 {
      return 0.0 / 0.0
    }
    var i = Int((Float(k) * q).ceil())
    if i > 0 {
      i -= 1
    }
    return s.b.sort()[i]
  }
  qflush(s, objs)
  var t = (q * s.n).ceil()
  t += (qf(objs, s.n, t) / 2.0).ceil()
  var p = s.l[0]
  var r = 0.0
  for c in s.l[1..s.l.len()] {
    r += p.w
    if r + c.w + c.d > t {
      return p.v
    }
    p = c
  }
  p.v
}

/// Rotates st's streams whose time ran out by now_ms (client_golang's
/// maybeRotateStreams), each step max_age / age_buckets.
fn qrotate(var st: QState, now_ms: Int, max_age_ms: Int) {
  let k = st.streams.len()
  let step = if k > 0 { max_age_ms / k } else { 0 }
  if step <= 0 {
    return
  }
  if st.exp_ms == 0 {
    st.exp_ms = now_ms + step
    return
  }
  var n = 0
  while now_ms >= st.exp_ms && n <= k {
    st.streams[st.head] = qstream_new()
    st.head = (st.head + 1) % k
    st.exp_ms += step
    n += 1
  }
  if now_ms >= st.exp_ms {
    // idle past every bucket: start over from now
    st.exp_ms = now_ms + step
  }
}

/// A series of the label values with nb buckets (kind 3 gets its quantile
/// streams).
fn new_series(values: List[Str], nb: Int, kind: Int, age_buckets: Int) -> Series {
  var cells: List[Atomic[Int]] = [Atomic[Int].new(0), Atomic[Int].new(0), Atomic[Int].new(0)]
  for _ in 0..nb {
    cells.push(Atomic[Int].new(0))
  }
  let q = if kind == 3 { [Mutex[QState].new(qstate_new(age_buckets))] } else { [] }
  Series{values: values, cells: cells, q: q}
}

/// The series of a child: the registered one, or, past the limit, one
/// nothing exposes (the drop is counted).
fn child_series(f: Family, values: List[Str]) -> Series {
  match series_of(f, values) {
    Some(s) => s
    None => new_series(values, f.bounds.len(), f.kind, f.age_buckets)
  }
}

/// The series of the label values, made on first use; None when the
/// instrument holds MAX_SERIES already (counted as dropped).
fn series_of(f: Family, values: List[Str]) -> Series? {
  if values.len() != f.labels.len() {
    fault("metrics: ${f.name} has ${f.labels.len()} labels, got ${values.len()} values")
  }
  // one label: its value is the key (what join gives), without the copy
  let key = if values.len() == 1 { values[0] } else { values.join(SEP) }
  if let Some(s) = f.series.with_read(fn(m: Map[Str, Series]) -> Series? { m.get(key) }) {
    return Some(s)
  }
  // the fields the closure reads, bound first: capturing f would copy
  // its 13 words and share each heap field on every call (XO0910); the
  // bounds' count, not the List: a captured heap field consumes a leaf of
  // f, which makes f an owned parameter, so every call (a hit too)
  // retained and released each heap field of the Family (2026-11-07)
  let nb = f.bounds.len()
  let kind = f.kind
  let age_buckets = f.age_buckets
  let made = f.series.with(fn(var m: Map[Str, Series]) -> Series? {
    if let Some(s) = m.get(key) {
      return Some(s)
    }
    if m.len() >= MAX_SERIES {
      return None
    }
    let s = new_series(values, nb, kind, age_buckets)
    m.put(key, s)
    Some(s)
  })
  if made is None {
    let _n = f.dropped.add(1)
  }
  made
}

/// The cells of the label values' series (series_of): a hit takes only
/// the cells from the map, so it shares and releases one list where the
/// whole Series was three, each an atomic count of a shared list
/// (2026-11-07: the Series' drop was 16% of bench/perf/metrics counter).
fn cells_of(f: Family, values: List[Str]) -> List[Atomic[Int]]? {
  if values.len() == f.labels.len() {
    // the key series_of makes
    let key = if values.len() == 1 { values[0] } else { values.join(SEP) }
    let hit = f.series.with_read(fn(m: Map[Str, Series]) -> List[Atomic[Int]]? {
      match m.get(key) {
        Some(s) => Some(s.cells)
        None => None
      }
    })
    if hit is Some(_) {
      return hit
    }
  }
  match series_of(f, values) {
    Some(s) => Some(s.cells)
    None => None
  }
}

/// Adds n >= 0 to a counter's cells: a whole n below 2^53 to cell 1 (an
/// integer, unused by a counter otherwise) with one atomic add, else to
/// cell 0's float with a compare and swap loop (client_golang's valInt
/// and valBits); the value is their sum.
fn counter_cells_add(cells: List[Atomic[Int]], n: Float) {
  if n < 9007199254740992.0 && n == Float(Int(n)) {
    let _n = cells[1].add(Int(n))
    return
  }
  add_float(cells[0], n)
}

/// A counter's value: cell 0's float plus cell 1's whole part.
fn counter_value(cells: List[Atomic[Int]]) -> Float {
  load(cells[0]) + Float(cells[1].get())
}

/// Adds d to the label values' series (a counter's cells, else cell 0) when it exists, under
/// the share of with_read: the cells are read in place, so a hit shares
/// and releases no list (an atomic count each on a shared map: two of the
/// five atomic updates of a Counter.inc, 2026-11-08). False when there is
/// no such series yet or the label count is wrong (series_of then makes
/// the series or faults).
fn hit_add(f: Family, values: List[Str], counter: Bool, d: Float) -> Bool {
  if values.len() != f.labels.len() {
    return false
  }
  let key = if values.len() == 1 { values[0] } else { values.join(SEP) }
  f.series.with_read(fn(m: Map[Str, Series]) -> Bool {
    match m.get(key) {
      Some(s) => {
        if counter {
          counter_cells_add(s.cells, d)
        } else {
          add_float(s.cells[0], d)
        }
        true
      }
      None => false
    }
  })
}

/// The float whose bits a holds (the cells hold bits: the native
/// backends' atomics are integers).
fn load(a: Atomic[Int]) -> Float {
  Float.from_bits(a.get())
}

/// a.set(a.get() + d), atomically.
fn add_float(a: Atomic[Int], d: Float) {
  while true {
    let old = a.get()
    if a.compare_and_swap(old, (Float.from_bits(old) + d).to_bits()) {
      return
    }
  }
}

/// One observation into the first bucket that holds v (client_golang's
/// findBucket: the cells count one bucket each and a scrape adds them up),
/// the count and the sum.
fn histogram_add(cells: List[Atomic[Int]], bounds: List[Float], v: Float) {
  histogram_cell_add(cells, bucket_of(bounds, v), bounds.len(), v)
}

/// The first bucket of bounds that holds v (bounds.len() when none does).
fn bucket_of(bounds: List[Float], v: Float) -> Int {
  var i = 0
  while i < bounds.len() && !(v <= bounds[i]) {
    i += 1
  }
  i
}

/// histogram_add with its bucket i of nb found.
fn histogram_cell_add(cells: List[Atomic[Int]], i: Int, nb: Int, v: Float) {
  if i < nb {
    let _n = cells[3 + i].add(1)
  }
  let _c = cells[1].add(1)
  add_float(cells[2], v)
}

/// A number as Prometheus text: an integral value without a fraction.
fn num(v: Float) -> Str {
  if v != v {
    return "NaN"
  }
  if v > 1.0e300 {
    return "+Inf"
  }
  if v < -1.0e300 {
    return "-Inf"
  }
  if v > -1.0e15 && v < 1.0e15 && v == Float(Int(v)) {
    return "${Int(v)}"
  }
  "${v}"
}

fn escape_label(s: Str) -> Str {
  s.replace("\\", "\\\\").replace("\n", "\\n").replace("\"", "\\\"")
}

fn escape_help(s: Str) -> Str {
  s.replace("\\", "\\\\").replace("\n", "\\n")
}

/// name{l1="v1",l2="v2"} with extra (already formatted pairs) appended.
fn head(name: Str, labels: List[Str], values: List[Str], extra: Str) -> Str {
  var parts: List[Str] = []
  for (i, l) in labels.indexed() {
    parts.push("${l}=\"${escape_label(values[i])}\"")
  }
  if !extra.is_empty() {
    parts.push(extra)
  }
  if parts.is_empty() { name } else { "${name}{${parts.join(",")}}" }
}

fn expose(f: Family, now_ms: Int) -> List[Str] {
  var out: List[Str] = []
  out.push("# HELP ${f.name} ${escape_help(f.help)}")
  out.push("# TYPE ${f.name} ${if f.kind == 0 { "counter" } else if f.kind == 1 { "gauge" } else if f.kind == 2 { "histogram" } else { "summary" }}")
  if let Some(read) = f.reads.get(0) {
    // read at scrape time (GaugeFunc, CounterFunc, a Collector), sorted
    // by label values as the instruments' series are
    var ss = read()
    for x in ss {
      if x.values.len() != f.labels.len() {
        fault("metrics: ${f.name} has ${f.labels.len()} labels, a sample has ${x.values.len()} values")
      }
    }
    ss = ss.sort_by(fn(x: Sample) -> Str { x.values.join(SEP) })
    for x in ss {
      out.push("${head(f.name, f.labels, x.values, "")} ${num(x.value)}")
    }
    return out
  }
  let m = f.series.with_read(fn(m: Map[Str, Series]) -> Map[Str, Series] { m })
  let keys = m.keys().sort()
  for k in keys {
    // k is one of m's keys (a `?? continue` here generates Go that go vet
    // reports as unreachable code)
    let s = m.get(k) ?? fault("metrics: series ${k} not in its own map")
    if f.kind < 2 {
      let v = if f.kind == 0 { counter_value(s.cells) } else { load(s.cells[0]) }
      out.push("${head(f.name, f.labels, s.values, "")} ${num(v)}")
    } else if f.kind == 3 {
      let objs = f.objectives
      if !objs.is_empty() {
        let qs = s.q[0].with(fn(var st: QState) -> List[Float] {
          qdrain(st, objs)
          if now_ms > 0 {
            qrotate(st, now_ms, f.max_age_ms)
          }
          var vs: List[Float] = []
          for (q, _) in objs {
            vs.push(qquery(st.streams[st.head], q, objs))
          }
          vs
        })
        for (i, (q, _)) in objs.indexed() {
          out.push("${head(f.name, f.labels, s.values, "quantile=\"${num(q)}\"")} ${num(qs[i])}")
        }
      }
      out.push("${head("${f.name}_sum", f.labels, s.values, "")} ${num(load(s.cells[2]))}")
      out.push("${head("${f.name}_count", f.labels, s.values, "")} ${s.cells[1].get()}")
    } else {
      var upto = 0
      for (i, b) in f.bounds.indexed() {
        upto += s.cells[3 + i].get()
        out.push("${head("${f.name}_bucket", f.labels, s.values, "le=\"${num(b)}\"")} ${upto}")
      }
      let n = s.cells[1].get()
      out.push("${head("${f.name}_bucket", f.labels, s.values, "le=\"+Inf\"")} ${n}")
      out.push("${head("${f.name}_sum", f.labels, s.values, "")} ${num(load(s.cells[2]))}")
      out.push("${head("${f.name}_count", f.labels, s.values, "")} ${n}")
    }
  }
  out
}
