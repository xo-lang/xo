// std/x509 (spec/std.md 41). Declaration file; encoding rules are listed
// at the top of std/prelude.xo. Go's crypto/x509: parsing X.509
// certificates (RFC 5280) and verifying chains, as std/tls does for every
// server it connects to. Pure, except system_roots, which reads the
// platform's roots.
use std/crypto
use std/netip

/// A distinguished name (Go's pkix.Name): the common attributes, each
/// list in the order the name has them, and its DER. A Name to build
/// (Template.subject) leaves raw empty and sets the fields it needs.
struct Name {
  country: List[Str] = []
  organization: List[Str] = []
  organizational_unit: List[Str] = []
  locality: List[Str] = []
  province: List[Str] = []
  street_address: List[Str] = []
  postal_code: List[Str] = []
  serial_number: Str = ""
  common_name: Str = ""
  raw: Bytes = b""
}

/// RFC 2253 text, as Go's Name.String() (`CN=example.com,O=Example`).
fn (n: Name) display() -> Str
/// Every attribute in the order the name has them: (OID, value).
fn (n: Name) attributes() -> List[(Str, Str)]

/// A certificate extension: its OID (dotted), whether it is critical, and
/// its value (the DER inside the OCTET STRING).
struct Extension {
  oid: Str
  critical: Bool
  value: Bytes
}

/// The key usages a certificate allows (RFC 5280 4.2.1.3).
enum KeyUsage {
  DigitalSignature
  ContentCommitment
  KeyEncipherment
  DataEncipherment
  KeyAgreement
  CertSign
  CrlSign
  EncipherOnly
  DecipherOnly
}

/// The extended key usages (RFC 5280 4.2.1.12); Other keeps an OID Go has
/// no name for.
enum ExtKeyUsage {
  Any
  ServerAuth
  ClientAuth
  CodeSigning
  EmailProtection
  TimeStamping
  OcspSigning
  Other(oid: Str)
}

/// A parsed certificate (Go's x509.Certificate).
struct Certificate {
  /// The whole certificate's DER.
  raw: Bytes
  /// 1 to 3.
  version: Int
  /// The serial number's magnitude, big endian (Go's SerialNumber.Bytes()).
  serial: Bytes
  /// Go's SignatureAlgorithm.String(): "SHA256-RSA", "ECDSA-SHA256",
  /// "SHA256-RSAPSS", "Ed25519", ...; "0" when unknown.
  signature_algorithm: Str
  issuer: Name
  subject: Name
  not_before: Time
  not_after: Time
  /// The subject's key; None for an algorithm std/crypto has no key for
  /// (DSA, X25519, an unknown OID), whose SubjectPublicKeyInfo is in raw.
  public_key: crypto.PublicKey?
  dns_names: List[Str]
  ip_addresses: List[netip.Addr]
  email_addresses: List[Str]
  uris: List[Str]
  /// The basic constraints: a CA, and its path length (None: no limit).
  is_ca: Bool
  max_path_len: Int?
  key_usage: List[KeyUsage]
  ext_key_usage: List[ExtKeyUsage]
  subject_key_id: Bytes
  authority_key_id: Bytes
  /// Every extension, in order.
  extensions: List[Extension]
  /// The signed part's DER (Go's RawTBSCertificate), the subject's
  /// SubjectPublicKeyInfo (RawSubjectPublicKeyInfo) and the signature
  /// (Signature).
  raw_tbs_certificate: Bytes = b""
  raw_subject_public_key_info: Bytes = b""
  signature: Bytes = b""
  /// Go's PublicKeyAlgorithm.String(): "RSA", "DSA", "ECDSA", "Ed25519",
  /// "0" when unknown.
  public_key_algorithm: Str = "0"
  /// Whether the basic constraints extension is there (Go's
  /// BasicConstraintsValid); max_path_len tells 0 from no limit, as Go's
  /// MaxPathLen and MaxPathLenZero do.
  basic_constraints_valid: Bool = false
  /// The authority information access URIs: OCSP responders (Go's
  /// OCSPServer) and issuer certificates (IssuingCertificateURL).
  ocsp_servers: List[Str] = []
  issuing_certificate_urls: List[Str] = []
  /// The CRL distribution points' full name URIs (Go's
  /// CRLDistributionPoints).
  crl_distribution_points: List[Str] = []
  /// The name constraints (RFC 5280 4.2.1.10, Go's Permitted* and
  /// Excluded* fields): whether the extension is critical, DNS domains,
  /// IP ranges, e-mail addresses and URI domains.
  permitted_dns_domains_critical: Bool = false
  permitted_dns_domains: List[Str] = []
  excluded_dns_domains: List[Str] = []
  permitted_ip_ranges: List[netip.Prefix] = []
  excluded_ip_ranges: List[netip.Prefix] = []
  permitted_email_addresses: List[Str] = []
  excluded_email_addresses: List[Str] = []
  permitted_uri_domains: List[Str] = []
  excluded_uri_domains: List[Str] = []
  /// The certificate policies' OIDs, dotted (Go's Policies), and the
  /// policy mappings (PolicyMappings).
  policies: List[Str] = []
  policy_mappings: List[PolicyMapping] = []
  /// The policy constraints and inhibitAnyPolicy (Go's
  /// InhibitAnyPolicy, InhibitPolicyMapping, RequireExplicitPolicy and
  /// their *Zero flags): None when absent.
  inhibit_any_policy: Int? = None
  inhibit_policy_mapping: Int? = None
  require_explicit_policy: Int? = None
  /// The OIDs of the critical extensions std/x509 does not act on (Go's
  /// UnhandledCriticalExtensions); verify fails while there is one.
  unhandled_critical_extensions: List[Str] = []
}

/// A certificate policy mapping (RFC 5280 4.2.1.5, Go's PolicyMapping):
/// the issuer's policy and the subject's policy it maps to, dotted OIDs.
struct PolicyMapping {
  issuer_domain_policy: Str
  subject_domain_policy: Str
}

/// Go's OID: an ASN.1 object identifier whose arcs may be any size, held
/// as its DER contents (Go's MarshalBinary). The empty Oid is Go's zero
/// OID{}. == is Go's Equal. An Oid is made by parse_oid, oid_from_ints,
/// oid_from_asn1_oid or oid_from_binary; one built from other contents
/// displays as "".
struct Oid {
  der: Bytes = b""
}

/// Go's ParseOID (and UnmarshalText): dotted decimal arcs of any size, at
/// least two, the first 0 to 2 and the second under 40 when the first is
/// 0 or 1. Err "invalid oid" (Go's errInvalidOID) otherwise.
fn parse_oid(s: Str) -> Oid ! CertErr

/// Go's OIDFromInts: Err "invalid oid" for fewer than two arcs or a first
/// two Go refuses. As Go, the first value (40 times the first arc plus
/// the second) is a UInt64 that wraps: [2, 2^64 - 1] is the Oid 1.39.
fn oid_from_ints(arcs: List[UInt64]) -> Oid ! CertErr

/// Go's OIDFromASN1OID: Err "x509: OID components must be non-negative"
/// for a negative arc, "invalid oid" as oid_from_ints.
fn oid_from_asn1_oid(arcs: List[Int]) -> Oid ! CertErr

/// Go's UnmarshalBinary (newOIDFromDER): Err "invalid oid" for empty
/// contents, an arc that starts with 0x80, or a last byte with its high
/// bit set.
fn oid_from_binary(der: Bytes) -> Oid ! CertErr

/// Go's String (and MarshalText): the dotted arcs.
fn (o: Oid) display() -> Str

/// Go's EqualASN1OID: whether o has exactly these arcs (false for the
/// empty Oid).
fn (o: Oid) equal_asn1_oid(arcs: List[Int]) -> Bool

/// The arcs when each fits an Int as Go's toASN1OID does (at most 31
/// bits each), else None.
fn (o: Oid) to_asn1_oid() -> List[Int]?

/// An x509 error, with Go's text (`x509: malformed certificate`,
/// `x509: certificate signed by unknown authority`, ...).
struct CertErr {
  msg: Str
  /// Which of Go's error types this is (decision 0643); Other for an
  /// error Go returns untyped (a parse error, errors.New). The text is msg
  /// either way.
  kind: CertErrKind = CertErrKind.Other
}

/// Go's x509 error types, for errors.As: CertificateInvalidError (the
/// reason and Detail), HostnameError (the host it was asked for),
/// UnknownAuthorityError, InsecureAlgorithmError (Go's name of the
/// algorithm), ConstraintViolationError and UnhandledCriticalExtension.
enum CertErrKind {
  Other
  CertificateInvalid(reason: InvalidReason, detail: Str)
  Hostname(host: Str)
  UnknownAuthority
  InsecureAlgorithm(algorithm: Str)
  ConstraintViolation
  UnhandledCriticalExtension
}

/// Go's InvalidReason, in Go's order.
enum InvalidReason {
  NotAuthorizedToSign
  Expired
  CaNotAuthorizedForThisName
  TooManyIntermediates
  IncompatibleUsage
  NameMismatch
  NameConstraintsWithoutSans
  UnconstrainedName
  TooManyConstraints
  CaNotAuthorizedForExtKeyUsage
  NoValidChains
}

fn (e: CertErr) display() -> Str

/// The certificate of a DER (Go's ParseCertificate).
fn parse(der: Bytes) -> Certificate ! CertErr

/// Go's ParseCertificates: the certificates of DERs concatenated with
/// nothing between them; empty for empty der. The first that does not
/// parse is the Err, with Go's text.
fn parse_certificates(der: Bytes) -> List[Certificate] ! CertErr
/// What a PKCS #12 file holds (std.md 18.x, golang.org/x/crypto/pkcs12).
struct Pkcs12 {
  key: crypto.PrivateKey
  /// the leaf: the certificate whose localKeyID names the key, else the first
  certificate: Certificate
  /// the other certificates, in file order
  ca: List[Certificate]
}

/// The key and certificates of a .pfx or .p12 (Go's pkcs12.Decode, which needs exactly one of each: this reads
/// chains too). password is the text the file was made with; "" also opens a file made with no
/// password. 3DES and 40 bit RC2 with SHA-1 are the encryptions read, as Go's. Err is
/// CertErr with Go's text (`pkcs12: decryption password incorrect`).
fn parse_pkcs12(data: Bytes, password: Str) -> Pkcs12 ! CertErr
/// The certificates of a PEM text's CERTIFICATE blocks, in order; Err at the
/// first that does not parse.
fn parse_pem(pem: Bytes) -> List[Certificate] ! CertErr

/// Certificates parsed once for verify (Go's CertPool): a pool keeps each
/// certificate's checked form, so verify does not parse it again on every
/// call (decision 0626). A certificate already in the pool (the same DER)
/// is added once.
struct CertPool {}

/// A pool of certs; Err when one's DER does not parse (a Certificate
/// built by hand rather than by parse).
fn cert_pool(certs: List[Certificate]) -> CertPool ! CertErr
/// Adds c (Go's AddCert); a certificate with the same DER is kept once.
fn (var p: CertPool) add(c: Certificate) -> () ! CertErr
/// Go's AddCertWithConstraint: adds c (kept once, as add), and when c
/// is a candidate parent in verify, calls constraint with the chain built
/// so far (the leaf first, without c); an Err refuses that chain through
/// c, and its text is the unknown authority error's hint, as in Go. A
/// certificate already in the pool keeps its first constraint (or none).
fn (var p: CertPool) add_cert_with_constraint(c: Certificate, constraint: fn(List[Certificate]) -> () ! CertErr) -> () ! CertErr
/// Go's AppendCertsFromPEM: adds the certificate of each CERTIFICATE
/// block without headers that parses, skipping the others; true when one
/// was (a duplicate counts).
fn (var p: CertPool) append_certs_from_pem(pem: Bytes) -> Bool
/// Go's Equal: the same certificates (by DER), in any order; constraints
/// are not compared.
fn (p: CertPool) equal(other: CertPool) -> Bool
/// The pool's certificates, in the order added.
fn (p: CertPool) certificates() -> List[Certificate]
fn (p: CertPool) len() -> Int

/// What verify checks a chain against (Go's VerifyOptions).
struct VerifyOptions {
  /// The trusted roots: these and root_pool's.
  roots: List[Certificate] = []
  /// Trusted roots parsed once (decision 0626).
  root_pool: CertPool? = None
  /// Certificates a chain may pass through.
  intermediates: List[Certificate] = []
  /// Intermediates parsed once (decision 0626).
  intermediate_pool: CertPool? = None
  /// The host name the leaf must be valid for; "" checks none.
  dns_name: Str = ""
  /// When every certificate must be valid.
  at: Time
  /// The extended key usages the chain must allow one of (Any: no
  /// check); empty is [ServerAuth], as Go's nil.
  key_usages: List[ExtKeyUsage] = []
  /// The policies a chain must be valid for (Go's CertificatePolicies,
  /// RFC 9618's user-initial-policy-set); empty: any. With Go's default
  /// options a chain is refused for its policies only when a certificate
  /// requires an explicit policy.
  certificate_policies: List[Oid] = []
}

/// Every chain from c to one of the roots, leaf first (Go's
/// Certificate.Verify), or Err with Go's text.
fn (c: Certificate) verify(opts: VerifyOptions) -> List[List[Certificate]] ! CertErr
/// Whether c is valid for host (a name or an IP address; Go's VerifyHostname).
fn (c: Certificate) verify_hostname(host: Str) -> () ! CertErr
/// Whether parent's key signed c (Go's CheckSignatureFrom).
fn (c: Certificate) check_signature_from(parent: Certificate) -> () ! CertErr

/// What create_certificate puts in a certificate (the fields Go's
/// CreateCertificate reads from its template).
struct Template {
  /// The serial number's magnitude, big endian; empty: 20 random bytes
  /// (159 bits), as Go makes one.
  serial: Bytes = b""
  /// The subject: its raw DER when set (a parsed certificate's subject),
  /// else made from its fields in Go's order (C, ST, L, STREET,
  /// POSTALCODE, O, OU, CN, SERIALNUMBER).
  subject: Name
  not_before: Time
  not_after: Time
  dns_names: List[Str] = []
  ip_addresses: List[netip.Addr] = []
  email_addresses: List[Str] = []
  uris: List[Str] = []
  /// A CA certificate (the basic constraints extension, made when is_ca
  /// or max_path_len is set); max_path_len only on a CA.
  is_ca: Bool = false
  max_path_len: Int? = None
  /// Makes the basic constraints extension on a certificate that is not a
  /// CA and has no max_path_len (Go's BasicConstraintsValid with IsCA
  /// false).
  basic_constraints_valid: Bool = false
  key_usage: List[KeyUsage] = []
  ext_key_usage: List[ExtKeyUsage] = []
  /// Empty on a CA: the first 20 bytes of the SHA-256 of its public key.
  subject_key_id: Bytes = b""
  /// The authority information access URLs (Go's OCSPServer and
  /// IssuingCertificateURL) and the CRL distribution points' URIs.
  ocsp_servers: List[Str] = []
  issuing_certificate_urls: List[Str] = []
  crl_distribution_points: List[Str] = []
  /// The name constraints extension, made when any list is not empty;
  /// critical when permitted_dns_domains_critical (Go's name).
  permitted_dns_domains_critical: Bool = false
  permitted_dns_domains: List[Str] = []
  excluded_dns_domains: List[Str] = []
  permitted_ip_ranges: List[netip.Prefix] = []
  excluded_ip_ranges: List[netip.Prefix] = []
  permitted_email_addresses: List[Str] = []
  excluded_email_addresses: List[Str] = []
  permitted_uri_domains: List[Str] = []
  excluded_uri_domains: List[Str] = []
  /// The certificate policies' OIDs, dotted (Go's Policies).
  policies: List[Str] = []
  /// Go's name for the signature algorithm (as Certificate's
  /// signature_algorithm shows it, such as "SHA384-RSA" or
  /// "SHA256-RSAPSS"); empty: the key's default.
  signature_algorithm: Str = ""
  /// Extensions added as given, after the ones made from the fields; one
  /// with the OID of a made one replaces it.
  extra_extensions: List[Extension] = []
}

/// Go's CreateCertificate: a certificate of t for public_key, issued by
/// parent and signed with parent's private key, key; self-signed when
/// parent is None (the issuer is t's subject and key the matching private
/// key). The signature algorithm is t's signature_algorithm, else Go's for
/// the key: SHA256-RSA, ECDSA-SHA256, -SHA384 or -SHA512 by curve, or
/// Ed25519. The extensions are made in Go's order: key usage, extended key
/// usage, basic constraints, subject and authority key IDs, authority
/// information access, subject alternative names, certificate policies,
/// name constraints, CRL distribution points, then extra_extensions. Err
/// with Go's text for a name that is not IA5, a max_path_len on a non-CA,
/// a key that is not parent's, a signature algorithm that is not the
/// key's, or a P-224 key (Go cannot sign with one).
fn create_certificate(r: Rand, t: Template, public_key: crypto.PublicKey, parent: Certificate?, key: crypto.PrivateKey) -> Certificate ! CertErr uses rand

/// A certificate for development and tests, never for production: a new
/// ECDSA P-256 key and a self-signed certificate for hosts (DNS names or
/// IP addresses), organization "Xo Development", valid from now for days
/// (Go's generate_cert.go). Returns the certificate's PEM and the key's
/// PEM (PKCS #8), ready for http.tls_cert.
fn self_signed(r: Rand, hosts: List[Str], now: Time, days: Int = 30) -> (Bytes, Bytes) ! CertErr uses rand

/// The certificate as a PEM CERTIFICATE block.
fn (c: Certificate) pem() -> Bytes

/// A certificate signing request (PKCS #10, Go's CertificateRequest).
struct CertificateRequest {
  raw: Bytes
  /// 0 (PKCS #10's v1).
  version: Int
  signature_algorithm: Str
  subject: Name
  public_key: crypto.PublicKey?
  dns_names: List[Str]
  ip_addresses: List[netip.Addr]
  email_addresses: List[Str]
  uris: List[Str]
  /// The requested extensions, in order.
  extensions: List[Extension]
}

/// What create_request puts in a request.
struct RequestTemplate {
  subject: Name
  dns_names: List[Str] = []
  ip_addresses: List[netip.Addr] = []
  email_addresses: List[Str] = []
  uris: List[Str] = []
  /// Requested as given, after the SAN made from the names; one with the
  /// SAN's OID replaces it.
  extra_extensions: List[Extension] = []
}

/// Go's CreateCertificateRequest: t's request for key's public key, signed
/// with key (the algorithm as create_certificate's).
fn create_request(r: Rand, t: RequestTemplate, key: crypto.PrivateKey) -> CertificateRequest ! CertErr uses rand
/// Go's ParseCertificateRequest of a DER request. Malformed DER is
/// `CertErr("x509: malformed certificate request")` where Go reports
/// encoding/asn1's text.
fn parse_request(der: Bytes) -> CertificateRequest ! CertErr
/// Whether the request's own key signed it (Go's CheckSignature).
fn (q: CertificateRequest) check_signature() -> () ! CertErr
/// The request as a PEM CERTIFICATE REQUEST block.
fn (q: CertificateRequest) pem() -> Bytes

/// A certificate a CRL revokes (Go's RevocationListEntry).
struct RevokedCertificate {
  /// The serial number's magnitude, big endian.
  serial: Bytes
  revoked_at: Time
  /// The reasonCode extension's value (RFC 5280 5.3.1), 0 without one.
  reason: Int
  extensions: List[Extension]
}

/// A parsed certificate revocation list (Go's RevocationList).
struct RevocationList {
  raw: Bytes
  /// As Certificate.signature_algorithm.
  signature_algorithm: Str
  issuer: Name
  /// The CRL number extension's magnitude; empty without one.
  number: Bytes
  this_update: Time
  next_update: Time?
  revoked: List[RevokedCertificate]
  authority_key_id: Bytes
  extensions: List[Extension]
}

/// Go's ParseRevocationList of a DER CRL.
fn parse_revocation_list(der: Bytes) -> RevocationList ! CertErr
/// Whether issuer may sign CRLs and signed l (Go's
/// RevocationList.CheckSignatureFrom).
fn (l: RevocationList) check_signature_from(issuer: Certificate) -> () ! CertErr

/// What create_revocation_list puts in a CRL (the fields Go's
/// CreateRevocationList reads from its RevocationList template).
struct RevocationListTemplate {
  /// The CRL number's magnitude, big endian (empty: 0); at most 20
  /// octets, as Go allows.
  number: Bytes
  this_update: Time
  next_update: Time
  /// The revoked certificates: each one's serial, revoked_at, reason (0:
  /// no reasonCode extension, RFC 5280 5.3.1) and extensions, added as
  /// given before the reasonCode one (Go's ExtraExtensions; a reasonCode
  /// extension among them is an error).
  revoked: List[RevokedCertificate] = []
  /// Added after the authority key identifier and the CRL number.
  extra_extensions: List[Extension] = []
  /// Go's SignatureAlgorithm.String() of the algorithm to sign with
  /// ("ECDSA-SHA512", "SHA256-RSAPSS", ...); "" is the key's default, as
  /// create_certificate's.
  signature_algorithm: Str = ""
}

/// Go's CreateRevocationList: a v2 CRL of t issued by issuer and signed
/// with issuer's private key, key. The issuer's subject is the CRL's
/// issuer and its subject key identifier the authority key identifier;
/// times are written as UTC. Err with Go's text for an issuer without the
/// CrlSign key usage or a subject key identifier, next_update before
/// this_update, a number longer than 20 octets, a signature algorithm
/// that is not the key's, or a reasonCode extension in an entry's
/// extensions.
fn create_revocation_list(r: Rand, t: RevocationListTemplate, issuer: Certificate, key: crypto.PrivateKey) -> RevocationList ! CertErr uses rand

/// The roots std/tls verifies servers against on this platform when a
/// client gives none: the system's root certificates.
fn system_roots(fs: Fs) -> List[Certificate] ! CertErr uses fs
