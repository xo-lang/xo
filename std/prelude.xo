// The prelude: builtin types, prelude interfaces, capability interfaces, and
// methods on builtin types (spec/std.md sections 1 to 3, core 2.1, 5.4, 7.1).
// Available in every module without `use`.
//
// This is a declaration file. It is parsed in signature mode (function
// declarations have no bodies) and read by internal/check. It is never
// compiled. Encoding rules shared by every file under std/:
//
//  1. Everything declared in a std file is public; `pub` is not written.
//     Fields of std structs are public (std.md 0).
//  2. A struct with no fields is an opaque handle: it cannot be built with a
//     struct literal (Int, List, Router, Task, ...). Builtin types are such
//     structs; the checker knows their literals and operators by name.
//  3. `[var] xs` receivers in std.md are written `var xs`.
//  4. A receiver named `static` declares an associated function, called on
//     the type rather than on a value: `Int.parse(s)`, `Chan[Job].new(cap: 8)`,
//     `Duration.from_secs(1.5)`. A static with an UPPER_SNAKE name and no
//     parameters is an associated constant, read without a call:
//     `Time.UNIX_EPOCH`.
//  5. In a receiver type, a type argument that is a bare name not declared
//     as a type (T, K, V, E) is an implicit type parameter of the method. A
//     declared type there restricts the method: `fn (xs: List[Str]) join`
//     exists only on `List[Str]`.
//  6. `T?` receivers are written `Option[T]`.
//  7. "also x, y" comments in std.md are expanded into one declaration each.
//  8. A doc comment line `@moves` marks a method that moves its receiver
//     (core 5.3: `freeze`).
//  9. Things the checker builds in rather than reads from here: numeric
//     conversions `Int(x)`, `Float(x)`, `Int32(x)` and the other sized types
//     (any numeric type to any numeric type); operators (core 2.1, 15);
//     `min`, `max`, `clamp` on every `Ord` type; `t.await` on a Task without
//     parentheses; `expect(a) <op> b` in tests; the predeclared `target`.
//     Eq, Hash, Ord, Json, OpenApi, Proto, SqlRow, and Debug are marker interfaces
//     whose satisfaction rules are builtin (std.md 1).
// 10a. A doc comment line `@move_only` on a std struct makes its values move
//     only like the builders (core 5.3; std/compress's Compressor).
// 10. The prelude imports std/task for `task.Group` (the type of `os.tasks`
//     and of `s.group()`, core 7.1). The import is not visible to user code:
//     a module still needs `use std/task` to name `task.Group`.
use std/task

// ---------------------------------------------------------------------------
// Builtin types (core 2.1)

struct Bool {}
struct Int {}
struct Int8 {}
struct Int16 {}
struct Int32 {}
struct Int64 {}
struct UInt8 {}
struct UInt16 {}
struct UInt32 {}
struct UInt64 {}
struct Float {}
struct Float32 {}
struct Rune {}
struct Str {}
struct Bytes {}
struct Duration {}
struct Time {}
struct List[T] {}
struct Map[K, V] {}
struct Set[T] {}
struct Buf[T] {}
struct StrBuilder {}
struct BytesBuilder {}
struct Chan[T] {}
struct Mutex[T] {}
struct Atomic[T] {}
struct Secret[T] {}

/// The type of a range expression `a..b` or `a..=b` (core 3.5, 3.6). Not
/// named by the spec; it exists so ranges can be stored and iterated.
struct Range[T] {}
fn (r: Range[Int]) to_list() -> List[Int]

/// The type with no values (core 2.1). An enum with no variants, so a match
/// on it needs no arms. Converts to every type.
enum Never {}

/// `T?` (core 2.5).
enum Option[T] {
  None
  Some(v: T)
}

/// Success or failure (core 2.6).
enum Result[T, E] {
  Ok(v: T)
  Err(e: E)
}

// ---------------------------------------------------------------------------
// Prelude interfaces (std.md 1)

interface Display {
  fn display(self) -> Str
}

/// The open error interface: any Display type is an Error.
interface Error {
  fn display(self) -> Str
}

/// Implemented by every type.
interface Debug {
  fn debug(self) -> Str
}

// Marker interfaces with builtin satisfaction rules.
interface Eq {}
interface Hash {}
interface Ord {}
interface Json {}
interface OpenApi {}
interface Proto {}
/// Decodable from a std/sql row by column name (`derive SqlRow`, std.md 10.4).
interface SqlRow {}
/// Reads and writes XML as Go's encoding/xml does (`derive Xml`, std.md 34).
interface Xml {}

// ---------------------------------------------------------------------------
// Predeclared functions (core 1.4, 8, 11.4)

fn fault(msg: Str) -> Never
fn dbg[T](x: T) -> T

// ---------------------------------------------------------------------------
// Targets (core 12.2). `target` is a predeclared value of type Target.

enum TargetOs {
  Linux
  Darwin
  Windows
  Wasi
}

enum TargetArch {
  Amd64
  Arm64
  Wasm32
}

struct Target {
  os: TargetOs
  arch: TargetArch
}

// ---------------------------------------------------------------------------
// Numbers (std.md 2.1)

fn (static: Int) parse(s: Str) -> Int?
/// Go's ParseInt(s, base, 64): base 2 to 36, or 0 for the 0b, 0o, 0x, and
/// 0 prefixes and _ separators; None for text that is not a number in
/// base or overflows Int; faults on another base (decision 0287).
fn (static: Int) parse_base(s: Str, base: Int) -> Int?
/// Go's FormatInt(n, base): base 2 to 36, lower case digits; faults on
/// another base (decision 0287).
fn (n: Int) to_str_base(base: Int) -> Str
/// n as text in base (2 to 36, lower case) in at least `width` characters:
/// padded on the left with spaces, or after the sign with zeros when `zero`
/// is set (`%08d`), or on the right with spaces when width is negative
/// (`%-8d`, zero ignored); `plus` writes a `+` before a positive n (`%+d`),
/// as Go's fmt (decision 0410).
fn (n: Int) to_str_width(width: Int, base: Int = 10, zero: Bool = false, plus: Bool = false) -> Str
/// Go's ParseBool: 1, t, T, TRUE, true, True; 0, f, F, FALSE, false,
/// False (decision 0287).
fn (static: Bool) parse(s: Str) -> Bool?
fn (static: Float) parse(s: Str) -> Float?
fn (static: Int8) try(x: Int) -> Int8?
fn (static: Int16) try(x: Int) -> Int16?
fn (static: Int32) try(x: Int) -> Int32?
fn (static: Int64) try(x: Int) -> Int64?
fn (static: UInt8) try(x: Int) -> UInt8?
fn (static: UInt16) try(x: Int) -> UInt16?
fn (static: UInt32) try(x: Int) -> UInt32?
fn (static: UInt64) try(x: Int) -> UInt64?
/// The character with code point x, or None when x is not a Unicode
/// scalar value (a surrogate, negative, or above U+10FFFF).
fn (static: Rune) try(x: Int) -> Rune?

fn (n: Int) abs() -> Int
fn (n: Int) pow(e: Int) -> Int
fn (n: Int) wrapping_add(m: Int) -> Int
fn (n: Int) wrapping_sub(m: Int) -> Int
fn (n: Int) wrapping_mul(m: Int) -> Int
/// n shifted left by k mod 64 (the bits shifted out dropped; decision
/// 0260: Int's word methods, inline on every native backend).
fn (n: Int) wrapping_shl(k: Int) -> Int
/// n's 64 bits shifted right by k mod 64 with zeros in at the top (a
/// logical shift: `>>` keeps the sign).
fn (n: Int) shr_logical(k: Int) -> Int
/// n's 64 bits rotated right by k mod 64.
fn (n: Int) rotate_right(k: Int) -> Int
/// n's low 32 bits rotated right by k mod 32, zero extended.
fn (n: Int) rotate_right32(k: Int) -> Int
/// n's 8 bytes in the reverse order.
fn (n: Int) swap_bytes() -> Int
/// The high 64 bits of the 128 bit product of n and m as unsigned words.
fn (n: Int) mul_hi_unsigned(m: Int) -> Int
/// Whether n < m as unsigned 64 bit words.
fn (n: Int) lt_unsigned(m: Int) -> Bool
/// Whether n <= m as unsigned 64 bit words.
fn (n: Int) le_unsigned(m: Int) -> Bool
/// math/bits on the 64 bit word (decision 0287).
fn (n: Int) leading_zeros() -> Int
fn (n: Int) trailing_zeros() -> Int
fn (n: Int) ones_count() -> Int
fn (n: Int) saturating_add(m: Int) -> Int
fn (n: Int) saturating_sub(m: Int) -> Int
fn (n: Int) saturating_mul(m: Int) -> Int
fn (n: Int) checked_add(m: Int) -> Int?
fn (n: Int) checked_sub(m: Int) -> Int?
fn (n: Int) checked_mul(m: Int) -> Int?
fn (n: Int) checked_div(m: Int) -> Int?

fn (f: Float) floor() -> Float
/// f as strconv.FormatFloat's 'f', 'e' and 'g' text with prec digits
/// (`%.3f`, `%e`, `%g`; prec below 0 is the shortest digits that round
/// trip), padded as Int.to_str_width does: `width` columns, zeros after the
/// sign with `zero`, left justified for a negative width, `+` before a
/// positive number with `plus`. NaN and the infinities are never zero
/// padded (decision 0410).
fn (f: Float) to_fixed(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
fn (f: Float) to_exp(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
fn (f: Float) to_general(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
fn (f: Float) ceil() -> Float
fn (f: Float) round() -> Float
fn (f: Float) trunc() -> Float
fn (f: Float) abs() -> Float
fn (f: Float) sqrt() -> Float
fn (f: Float) is_nan() -> Bool
/// Go's math, its portable algorithms with every operation rounded, so
/// the results are the same bits on every backend and architecture
/// (decision 0287).
fn (f: Float) pow(y: Float) -> Float
fn (f: Float) exp() -> Float
fn (f: Float) exp2() -> Float
fn (f: Float) expm1() -> Float
fn (f: Float) log() -> Float
fn (f: Float) log2() -> Float
fn (f: Float) log10() -> Float
fn (f: Float) log1p() -> Float
fn (f: Float) sin() -> Float
fn (f: Float) cos() -> Float
fn (f: Float) tan() -> Float
fn (f: Float) asin() -> Float
fn (f: Float) acos() -> Float
fn (f: Float) atan() -> Float
fn (f: Float) sinh() -> Float
fn (f: Float) cosh() -> Float
fn (f: Float) tanh() -> Float
fn (f: Float) cbrt() -> Float
/// atan(f / x) in the quadrant of (x, f), as Go's Atan2(f, x).
fn (f: Float) atan2(x: Float) -> Float
fn (f: Float) hypot(y: Float) -> Float
/// f * y + z computed exactly and rounded once (IEEE 754
/// fusedMultiplyAdd; Go's math.FMA), the same bits on every backend
/// (decision 0385). `f * y + z` written out rounds twice and is never
/// fused.
fn (f: Float) fma(y: Float, z: Float) -> Float
/// Go's Mod: the remainder of f / y with the sign of f.
fn (f: Float) mod(y: Float) -> Float
fn (f: Float) is_inf() -> Bool
/// The IEEE 754 bits of f, and the Float of bits b (Go's Float64bits,
/// Float64frombits).
fn (f: Float) to_bits() -> Int
fn (static: Float) from_bits(b: Int) -> Float

// ---------------------------------------------------------------------------
// Str, Rune, Bytes (std.md 2.2)

fn (s: Str) len() -> Int
fn (s: Str) rune_count() -> Int
fn (s: Str) is_empty() -> Bool
fn (s: Str) contains(sub: Str) -> Bool
fn (s: Str) starts_with(p: Str) -> Bool
fn (s: Str) ends_with(p: Str) -> Bool
/// Whether s and other are equal under Unicode simple case folding
/// (strings.EqualFold), not only ASCII case.
fn (s: Str) equal_fold(other: Str) -> Bool
fn (s: Str) find(sub: Str) -> Int?
/// The byte offset of the last sub (strings.LastIndex); Some(s.len()) for "".
fn (s: Str) rfind(sub: Str) -> Int?
/// The number of non-overlapping copies of sub (strings.Count); the count
/// of s's runes plus one for "".
fn (s: Str) count(sub: Str) -> Int
/// The byte offset of the first rune for which f is true (strings.IndexFunc),
/// None when there is none; an invalid byte of s is U+FFFD, as in find.
fn (s: Str) find_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// The byte offset of the last rune for which f is true
/// (strings.LastIndexFunc), None when there is none.
fn (s: Str) rfind_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// Whether s holds a rune for which f is true (strings.ContainsFunc).
fn (s: Str) contains_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx
/// The byte offset of the first rune of chars in s (strings.IndexAny),
/// None for no rune of chars and for "".
fn (s: Str) find_any(chars: Str) -> Int?
/// The byte offset of the last rune of chars in s (strings.LastIndexAny).
fn (s: Str) rfind_any(chars: Str) -> Int?
/// Whether s holds a rune of chars (strings.ContainsAny).
fn (s: Str) contains_any(chars: Str) -> Bool
/// Whether s holds r (strings.ContainsRune); an invalid byte of s reads as
/// U+FFFD, so a U+FFFD r finds it.
fn (s: Str) contains_rune(r: Rune) -> Bool
/// s cut at each sep, at most n pieces with the unsplit rest in the last;
/// n below 0 for every piece and 0 for none (strings.SplitN). Pieces are
/// views of s like split's.
fn (s: Str) split_n(sep: Str, n: Int) -> List[Str]
/// Like split, each piece keeping its separator (strings.SplitAfter).
fn (s: Str) split_after(sep: Str) -> List[Str]
/// At most n pieces, each keeping its separator (strings.SplitAfterN).
fn (s: Str) split_after_n(sep: Str, n: Int) -> List[Str]
/// The text before and after the first sep (strings.Cut), as views of s;
/// None when sep does not occur, and sep "" cuts at the start.
fn (s: Str) cut(sep: Str) -> (Str, Str)?
/// The rest of s after prefix (strings.CutPrefix), a view of s; None when
/// s does not start with prefix, and prefix "" gives s.
fn (s: Str) cut_prefix(prefix: Str) -> Str?
/// s up to its suffix (strings.CutSuffix), a view of s; None when s does
/// not end with suffix, and suffix "" gives s.
fn (s: Str) cut_suffix(suffix: Str) -> Str?
fn (s: Str) split(sep: Str) -> List[Str]
/// The runs of non-white-space text, split around runs of white space
/// (strings.Fields, unicode.IsSpace); pieces are views of s like split's.
fn (s: Str) fields() -> List[Str]
/// The runs of runes between runs of runes for which f is true
/// (strings.FieldsFunc); pieces are views of s like split's.
fn (s: Str) split_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> List[Str] ! E uses fx
fn (s: Str) lines() -> List[Str]
fn (s: Str) trim() -> Str
fn (s: Str) trim_start() -> Str
fn (s: Str) trim_end() -> Str
fn (s: Str) trim_prefix(p: Str) -> Str
fn (s: Str) trim_suffix(p: Str) -> Str
/// s without its leading and trailing runes in chars, a view of s like
/// trim (strings.Trim); an empty s or chars gives s.
fn (s: Str) trim_chars(chars: Str) -> Str
/// s without its leading runes in chars, a view of s (strings.TrimLeft).
fn (s: Str) trim_start_chars(chars: Str) -> Str
/// s without its trailing runes in chars, a view of s (strings.TrimRight).
fn (s: Str) trim_end_chars(chars: Str) -> Str
/// s without its leading and trailing runes for which f is true, a view of
/// s like trim (strings.TrimFunc).
fn (s: Str) trim_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
/// s without its leading runes for which f is true, a view of s
/// (strings.TrimLeftFunc).
fn (s: Str) trim_start_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
/// s without its trailing runes for which f is true, a view of s
/// (strings.TrimRightFunc).
fn (s: Str) trim_end_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
fn (s: Str) to_lower() -> Str
fn (s: Str) to_upper() -> Str
/// f applied to every rune of s (strings.Map); None (Go's negative
/// mapping) drops the rune, and s itself, not a copy, when nothing changes.
fn (s: Str) map_runes[E, fx: Effects](f: fn(Rune) -> Rune? ! E uses fx) -> Str ! E uses fx
fn (s: Str) replace(old: Str, new: Str) -> Str
/// s with the first n copies of old replaced by new; n below 0 for every
/// copy and 0 for none (strings.Replace). s itself, not a copy, when
/// nothing changes.
fn (s: Str) replace_n(old: Str, new: Str, n: Int) -> Str
fn (s: Str) repeat(n: Int) -> Str
/// s with `fill` (one rune) added on the left (pad_left), on the right
/// (pad_right) or on both sides (center, the extra one on the right) until
/// it is `width` runes; s itself when it is that long already (Go's fmt
/// width, `%*s` and `%-*s`, is a minimum; decision 0410).
fn (s: Str) pad_left(width: Int, fill: Str = " ") -> Str
fn (s: Str) pad_right(width: Int, fill: Str = " ") -> Str
fn (s: Str) center(width: Int, fill: Str = " ") -> Str
/// An explicit copy of s in a buffer of its own: a slice, a `split` piece or
/// a `trim` result shares its source's buffer on native targets (core 3.6),
/// so a small piece to keep for long copies it to let a large source go.
fn (s: Str) clone() -> Str
fn (s: Str) runes() -> List[Rune]
fn (s: Str) bytes() -> Bytes

fn (b: Bytes) len() -> Int
fn (b: Bytes) is_empty() -> Bool
fn (b: Bytes) to_str() -> Str?
fn (b: Bytes) to_hex() -> Str
/// An explicit copy of b in a buffer of its own (see Str.clone).
fn (b: Bytes) clone() -> Bytes
fn (b: Bytes) to_base64() -> Str
fn (static: Bytes) from_hex(s: Str) -> Bytes?
fn (static: Bytes) from_base64(s: Str) -> Bytes?
fn (b: Bytes) rune_count() -> Int
fn (b: Bytes) decode_rune(i: Int) -> (Rune, Int)
fn (b: Bytes) quote() -> Str
/// The offset of the first sub (bytes.Index); Some(0) for an empty sub.
fn (b: Bytes) find(sub: Bytes) -> Int?
/// The offset of the last sub (bytes.LastIndex); Some(b.len()) for an empty sub.
fn (b: Bytes) rfind(sub: Bytes) -> Int?
/// Whether sub is in b (bytes.Contains); true for an empty sub. The bytes
/// need not be UTF-8: compare bytes, not text.
fn (b: Bytes) contains(sub: Bytes) -> Bool
/// Whether b starts with p (bytes.HasPrefix); true for an empty p.
fn (b: Bytes) starts_with(p: Bytes) -> Bool
/// Whether b ends with p (bytes.HasSuffix); true for an empty p.
fn (b: Bytes) ends_with(p: Bytes) -> Bool
/// The number of non-overlapping copies of sub in b (bytes.Count); for an
/// empty sub the rune count plus one, an invalid byte counting as one rune.
fn (b: Bytes) count(sub: Bytes) -> Int
/// The byte offset of the first rune of chars in b (bytes.IndexAny), None
/// for no rune of chars and for ""; an invalid byte of b reads as U+FFFD.
fn (b: Bytes) find_any(chars: Str) -> Int?
/// The byte offset of the last rune of chars in b (bytes.LastIndexAny).
fn (b: Bytes) rfind_any(chars: Str) -> Int?
/// Whether b holds a rune of chars (bytes.ContainsAny); false for "".
fn (b: Bytes) contains_any(chars: Str) -> Bool
/// Whether b holds r (bytes.ContainsRune); an invalid byte of b reads as
/// U+FFFD, so a U+FFFD r finds it.
fn (b: Bytes) contains_rune(r: Rune) -> Bool
/// The byte offset of the first rune for which f is true (bytes.IndexFunc),
/// None when there is none; an invalid byte of b is U+FFFD, as in find.
fn (b: Bytes) find_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// The byte offset of the last rune for which f is true
/// (bytes.LastIndexFunc), None when there is none.
fn (b: Bytes) rfind_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// Whether b holds a rune for which f is true (bytes.ContainsFunc).
fn (b: Bytes) contains_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx
/// b cut at each sep, the pieces views of b (bytes.Split); an empty sep
/// splits after each UTF-8 sequence, an invalid byte alone.
fn (b: Bytes) split(sep: Bytes) -> List[Bytes]
/// b cut at each sep, at most n pieces with the unsplit rest in the last;
/// n below 0 means every piece and n 0 an empty list (bytes.SplitN).
fn (b: Bytes) split_n(sep: Bytes, n: Int) -> List[Bytes]
/// Like split, each piece keeping its separator (bytes.SplitAfter).
fn (b: Bytes) split_after(sep: Bytes) -> List[Bytes]
/// At most n pieces, each keeping its separator (bytes.SplitAfterN).
fn (b: Bytes) split_after_n(sep: Bytes, n: Int) -> List[Bytes]
/// The bytes before and after the first sep (bytes.Cut), as views of b;
/// None when sep does not occur, and sep "" cuts at the start.
fn (b: Bytes) cut(sep: Bytes) -> (Bytes, Bytes)?
/// The rest of b after prefix (bytes.CutPrefix), a view of b; None when b
/// does not start with prefix, and prefix "" gives b.
fn (b: Bytes) cut_prefix(prefix: Bytes) -> Bytes?
/// b up to its suffix (bytes.CutSuffix), a view of b; None when b does not
/// end with suffix, and suffix "" gives b.
fn (b: Bytes) cut_suffix(suffix: Bytes) -> Bytes?
/// The runs of non-white-space bytes, split around runs of white space
/// (bytes.Fields, unicode.IsSpace); pieces are views of b.
fn (b: Bytes) fields() -> List[Bytes]
/// The runs of runes between runs of runes for which f is true
/// (bytes.FieldsFunc); pieces are views of b.
fn (b: Bytes) split_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> List[Bytes] ! E uses fx
/// b without its leading and trailing white space (bytes.TrimSpace,
/// unicode.IsSpace), a view of b; b itself when there is none.
fn (b: Bytes) trim() -> Bytes
/// b without the prefix p (bytes.TrimPrefix), a view of b; b itself when p
/// is not a prefix.
fn (b: Bytes) trim_prefix(p: Bytes) -> Bytes
/// b without the suffix p (bytes.TrimSuffix), a view of b; b itself when p
/// is not a suffix.
fn (b: Bytes) trim_suffix(p: Bytes) -> Bytes
/// b without its leading and trailing runes for which f is true, a view of
/// b like trim (bytes.TrimFunc).
fn (b: Bytes) trim_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b without its leading runes for which f is true, a view of b
/// (bytes.TrimLeftFunc).
fn (b: Bytes) trim_start_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b without its trailing runes for which f is true, a view of b
/// (bytes.TrimRightFunc).
fn (b: Bytes) trim_end_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b with every copy of old replaced by new (bytes.ReplaceAll); b itself,
/// not a copy, when nothing changes, since a Bytes is immutable.
fn (b: Bytes) replace(old: Bytes, new: Bytes) -> Bytes
/// b with the first n copies of old replaced by new; n below 0 for every
/// copy and 0 for none (bytes.Replace). b itself, not a copy, when
/// nothing changes.
fn (b: Bytes) replace_n(old: Bytes, new: Bytes, n: Int) -> Bytes
/// b lowered (bytes.ToLower): ASCII bytes the fast way, a rune outside
/// ASCII by Go's Unicode mapping, and each byte of an invalid sequence as
/// U+FFFD, as Go maps it; b itself when it is already in the case.
fn (b: Bytes) to_lower() -> Bytes
/// b raised (bytes.ToUpper), as to_lower.
fn (b: Bytes) to_upper() -> Bytes
/// f applied to every rune of b (bytes.Map); None (Go's negative mapping)
/// drops the rune, and b itself, not a copy, when nothing changes.
fn (b: Bytes) map_runes[E, fx: Effects](f: fn(Rune) -> Rune? ! E uses fx) -> Bytes ! E uses fx
/// Whether b and other are equal under Unicode simple case folding
/// (bytes.EqualFold, not only ASCII case); two bytes of invalid sequences
/// compare equal, as both decode to U+FFFD.
fn (b: Bytes) equal_fold(other: Bytes) -> Bool
/// n copies of b (bytes.Repeat); empty for n 0, and a fault for n below 0
/// as Go's bytes.Repeat, and past 4 GiB a fault.
fn (b: Bytes) repeat(n: Int) -> Bytes
fn (b: Bytes) indexed() -> List[(Int, UInt8)]
/// n zero bytes (Go's make([]byte, n)); a fault for n < 0.
fn (static: Bytes) zeroed(n: Int) -> Bytes
fn (s: Str) quote() -> Str
/// Go's Unquote: a "..." or '...' literal with Go's escapes, or a `...`
/// one; None when s is not one or the result is not UTF-8 (decision 0287).
fn (s: Str) unquote() -> Str?

fn (r: Rune) is_digit() -> Bool
fn (r: Rune) is_letter() -> Bool
fn (r: Rune) is_space() -> Bool
fn (r: Rune) is_upper() -> Bool
fn (r: Rune) is_lower() -> Bool
fn (r: Rune) is_title() -> Bool
fn (r: Rune) is_punct() -> Bool
fn (r: Rune) is_control() -> Bool
fn (r: Rune) is_graphic() -> Bool
fn (r: Rune) is_mark() -> Bool
fn (r: Rune) is_symbol() -> Bool
fn (r: Rune) is_number() -> Bool
fn (r: Rune) to_lower() -> Rune
fn (r: Rune) to_upper() -> Rune
fn (r: Rune) to_title() -> Rune
/// The 1, 2, 3 or 4 bytes the rune takes in UTF-8 (utf8.RuneLen; a Rune
/// is a scalar value, so Go's -1 cannot happen, and Rune.try(n) is the
/// check on an Int).
fn (r: Rune) utf8_len() -> Int
fn (r: Rune) is_print() -> Bool
fn (r: Rune) quote() -> Str

// ---------------------------------------------------------------------------
// List[T] (std.md 2.3). Higher order methods pass through the callback's
// effects and errors (std.md 2.3, core 6.2).

/// An empty list with room for n elements before it grows (decision
/// 0170): `[]` that pushes up to n without copying. n below 0 counts as 0.
fn (static: List[T]) with_capacity(n: Int) -> List[T]
fn (xs: List[T]) len() -> Int
fn (xs: List[T]) is_empty() -> Bool
fn (xs: List[T]) get(i: Int) -> T?
fn (xs: List[T]) first() -> T?
fn (xs: List[T]) last() -> T?
fn (xs: List[T]) contains(x: T) -> Bool
fn (xs: List[T]) index_of(x: T) -> Int?
fn (xs: List[T]) indexed() -> List[(Int, T)]
fn (xs: List[T]) map[U, E, fx: Effects](f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx
fn (xs: List[T]) filter[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> List[T] ! E uses fx
fn (xs: List[T]) fold[A, E, fx: Effects](init: A, f: fn(A, T) -> A ! E uses fx) -> A ! E uses fx
fn (xs: List[T]) find[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> T? ! E uses fx
fn (xs: List[T]) any[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
fn (xs: List[T]) all[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
fn (xs: List[T]) sort() -> List[T]
fn (xs: List[T]) sort_by[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx
/// A stable sort of the receiver itself (decision 0374): it returns
/// nothing, and a list another binding shares is copied first the way
/// `push` and `set` copy one, so the other holder keeps its order. A
/// uniquely owned list is sorted in its own array with a scratch under one
/// list, where `sort` builds a whole second list.
fn (var xs: List[T]) sort_in_place()
fn (var xs: List[T]) sort_in_place_by[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> () ! E uses fx
fn (xs: List[T]) group_by[K: Hash, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> List[(K, List[T])] ! E uses fx
fn (xs: List[T]) reverse() -> List[T]
fn (xs: List[T]) to_set() -> Set[T]
fn (xs: List[Str]) join(sep: Str) -> Str

fn (var xs: List[T]) push(x: T)
fn (var xs: List[T]) pop() -> T?
fn (var xs: List[T]) insert(i: Int, x: T)
fn (var xs: List[T]) remove_at(i: Int) -> T
fn (var xs: List[T]) set(i: Int, x: T)
/// A binary min heap in the list, as Go's container/heap keeps one in a
/// slice by the Ord of T (decision 0410): `heap_push` adds x and restores
/// the order, `heap_pop` removes and returns the least element (the first
/// of the list, None for an empty list), `heap_remove(i)` removes and
/// returns the element at index i (a fault outside the list), `heap_fix(i)`
/// restores the order after the element at i changed (set, then fix), and
/// `heapify` makes any list a heap. Each is O(log n), heapify O(n). A
/// priority queue by a key is a heap of (key, value) pairs.
fn (var xs: List[T]) heap_push(x: T)
fn (var xs: List[T]) heap_pop() -> T?
fn (var xs: List[T]) heap_remove(i: Int) -> T
fn (var xs: List[T]) heap_fix(i: Int)
fn (var xs: List[T]) heapify()

// ---------------------------------------------------------------------------
// Map[K, V] and Set[T] (std.md 2.4)

fn (m: Map[K, V]) len() -> Int
fn (m: Map[K, V]) is_empty() -> Bool
fn (m: Map[K, V]) get(k: K) -> V?
fn (m: Map[K, V]) get_or_fault(k: K, reason: Str) -> V
fn (m: Map[K, V]) contains(k: K) -> Bool
fn (m: Map[K, V]) keys() -> List[K]
fn (m: Map[K, V]) values() -> List[V]
fn (m: Map[K, V]) entries() -> List[(K, V)]
fn (m: Map[K, V]) filter[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Map[K, V] ! E uses fx
/// Every key with f's value, in the map's insertion order.
fn (m: Map[K, V]) map[U, E, fx: Effects](f: fn(K, V) -> U ! E uses fx) -> Map[K, U] ! E uses fx
/// Whether f holds for some entry, in insertion order, stopping at the first.
fn (m: Map[K, V]) any[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx
/// Whether f holds for every entry, in insertion order, stopping at the first that fails.
fn (m: Map[K, V]) all[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx

fn (var m: Map[K, V]) put(k: K, v: V)
fn (var m: Map[K, V]) remove(k: K) -> V?
fn (var m: Map[K, V]) update[R, E, fx: Effects](k: K, init: V, f: fn(var V) -> R ! E uses fx) -> R ! E uses fx

fn (s: Set[T]) len() -> Int
fn (s: Set[T]) is_empty() -> Bool
fn (s: Set[T]) contains(x: T) -> Bool
fn (s: Set[T]) union(o: Set[T]) -> Set[T]
fn (s: Set[T]) intersect(o: Set[T]) -> Set[T]
fn (s: Set[T]) difference(o: Set[T]) -> Set[T]
fn (s: Set[T]) to_list() -> List[T]
fn (s: Set[T]) any[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
fn (s: Set[T]) all[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
fn (s: Set[T]) filter[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Set[T] ! E uses fx
fn (s: Set[T]) map[U, E, fx: Effects](f: fn(T) -> U ! E uses fx) -> Set[U] ! E uses fx
fn (var s: Set[T]) add(x: T)
fn (var s: Set[T]) remove(x: T) -> Bool

// ---------------------------------------------------------------------------
// Option[T] and Result[T, E] (std.md 2.5)

fn (o: Option[T]) is_some() -> Bool
fn (o: Option[T]) is_none() -> Bool
fn (o: Option[T]) or_err[E](e: E) -> Result[T, E]
fn (o: Option[T]) map[U, fx: Effects](f: fn(T) -> U uses fx) -> U? uses fx
fn (o: Option[T]) and_then[U, fx: Effects](f: fn(T) -> U? uses fx) -> U? uses fx
fn (o: Option[T]) or_fault(msg: Str) -> T

fn (r: Result[T, E]) is_ok() -> Bool
fn (r: Result[T, E]) is_err() -> Bool
fn (r: Result[T, E]) map[U, fx: Effects](f: fn(T) -> U uses fx) -> Result[U, E] uses fx
fn (r: Result[T, E]) map_err[F, fx: Effects](f: fn(E) -> F uses fx) -> Result[T, F] uses fx
fn (r: Result[T, E]) ok() -> T?
fn (r: Result[T, E]) err() -> E?
fn (r: Result[T, E]) or_fault(msg: Str) -> T
/// The only way to discard an error (core 2.6): yields the success value or
/// None, and logs the error with the reason at debug level.
fn (r: Result[T, E]) ignore_err(reason: Str) -> T?

// ---------------------------------------------------------------------------
// Duration and Time (std.md 2.6). Operators are builtin (core 2.1).

fn (static: Duration) from_secs(s: Float) -> Duration
/// Whole seconds; the same as `1s * s` (std.md 2.6).
fn (static: Duration) from_secs_int(s: Int) -> Duration
fn (static: Duration) from_millis(ms: Int) -> Duration
fn (static: Duration) from_nanos(ns: Int) -> Duration
/// Go's time.ParseDuration syntax after trimming white space: a signed
/// sequence of decimal numbers with units ns, us (or µs), ms, s, m, h,
/// such as "1.5s", "-2h45m", "300ms"; "0" alone is zero (std.md 2.6).
fn (static: Duration) parse(s: Str) -> Duration ! DurationErr
fn (d: Duration) seconds() -> Float
fn (d: Duration) millis() -> Int
fn (d: Duration) nanos() -> Int
fn (d: Duration) scale(f: Float) -> Duration
fn (d: Duration) ceil_seconds() -> Int
fn (d: Duration) abs() -> Duration

/// The error of `Duration.parse`: the text that is not a duration.
struct DurationErr {
  input: Str
}
fn (e: DurationErr) display() -> Str

fn (static: Time) UNIX_EPOCH() -> Time
fn (static: Time) from_unix(secs: Int) -> Time
fn (static: Time) from_unix_millis(ms: Int) -> Time
fn (static: Time) parse_rfc3339(s: Str) -> Time?
fn (t: Time) unix() -> Int
fn (t: Time) unix_millis() -> Int
fn (t: Time) format_rfc3339() -> Str

// ---------------------------------------------------------------------------
// Concurrency and state types (std.md 2.7, core 5.4, 7)

fn (static: Chan[T]) new(cap: Int = 0) -> Chan[T]
fn (c: Chan[T]) send(x: T)
fn (c: Chan[T]) recv() -> T?
fn (c: Chan[T]) try_send(x: T) -> Bool
fn (c: Chan[T]) try_recv() -> T?
fn (c: Chan[T]) close()
fn (c: Chan[T]) len() -> Int

fn (static: Mutex[T]) new(v: T) -> Mutex[T]
fn (m: Mutex[T]) with[R, E, fx: Effects](f: fn(var T) -> R ! E uses fx) -> R ! E uses fx
/// Shared read only access (decision 0063): many readers or one writer.
fn (m: Mutex[T]) with_read[R, E, fx: Effects](f: fn(T) -> R ! E uses fx) -> R ! E uses fx

fn (static: Atomic[T]) new(v: T) -> Atomic[T]
fn (a: Atomic[T]) get() -> T
fn (a: Atomic[T]) set(v: T)
fn (a: Atomic[Int]) add(n: Int) -> Int
fn (a: Atomic[Int]) max(n: Int) -> Int
fn (a: Atomic[T]) swap(v: T) -> T
fn (a: Atomic[T]) compare_and_swap(old: T, new: T) -> Bool

/// The handle bound by `scope s { ... }` (core 7.1). The only way to start a
/// task.
struct Scope {}
fn (s: Scope) spawn[T, E, fx: Effects](f: fn() -> T ! E uses fx) -> Task[T, E] uses fx
fn (s: Scope) spawn_background[T, E, fx: Effects](f: fn() -> T ! E uses fx) -> Task[T, E] uses fx
fn (s: Scope) cancel()
/// A storable handle whose tasks belong to this scope (core 7.1).
fn (s: Scope) group() -> task.Group

struct Task[T, E] {}
/// Written `t.await`, without parentheses.
fn (t: Task[T, E]) await() -> T ! E

fn (static: Buf[T]) new() -> Buf[T]
fn (static: Buf[T]) with_capacity(n: Int) -> Buf[T]
fn (var b: Buf[T]) push(x: T)
fn (b: Buf[T]) len() -> Int
/// @moves
fn (b: Buf[T]) freeze() -> List[T]

fn (static: StrBuilder) new() -> StrBuilder
fn (var b: StrBuilder) write(s: Str)
fn (b: StrBuilder) len() -> Int
/// @moves
fn (b: StrBuilder) freeze() -> Str

fn (static: BytesBuilder) new() -> BytesBuilder
fn (static: BytesBuilder) with_capacity(n: Int) -> BytesBuilder
fn (var b: BytesBuilder) write(data: Bytes)
fn (var b: BytesBuilder) write_byte(x: UInt8)
fn (var b: BytesBuilder) write_str(s: Str)
fn (var b: BytesBuilder) write_rune(r: Rune)
fn (var b: BytesBuilder) put_le(at: Int, v: Int, n: Int)
fn (var b: BytesBuilder) put_be(at: Int, v: Int, n: Int)
fn (b: BytesBuilder) len() -> Int
/// @moves
fn (b: BytesBuilder) freeze() -> Bytes

fn (static: Secret[T]) new(v: T) -> Secret[T]
fn (s: Secret[T]) reveal() -> T

// ---------------------------------------------------------------------------
// Capabilities (std.md 3, core 6.3)

struct Os {
  net: Net
  fs: Fs
  clock: Clock
  rand: Rand
  env: Env
  proc: Proc
  stdio: Stdio
  /// Program lifetime task group (core 6.3, 7.1).
  tasks: task.Group
}

enum FsErr {
  NotFound(path: Str)
  Exists(path: Str)
  NotEmpty(path: Str)
  NotDir(path: Str)
  IsDir(path: Str)
  Denied(path: Str)
  Io(path: Str, msg: Str)
  Canceled
}

/// Plain text (decision 0358): `PATH: no such file or directory`.
fn (e: FsErr) display() -> Str

struct FileInfo {
  name: Str
  path: Str
  is_dir: Bool
  size: Int
  modified: Time
  /// The entry is a symbolic link itself (std.md 3.1): read_dir and
  /// walk report a link (Go's os.Lstat, DirEntry.Type), stat follows
  /// it and reports the target, so is false there.
  is_symlink: Bool = false
}

interface Fs {
  fn sub(self, dir: Str) -> Fs
  fn cwd(self) -> Fs
  /// The working directory as an absolute path with / separators, from
  /// the OS (getcwd), not $PWD (std.md 3.1, decision 0218).
  fn cwd_path(self) -> Str ! FsErr
  fn read_only(self) -> Fs
  fn write_only(self) -> Fs
  fn case_sensitive(self) -> Bool
  fn stat(self, path: Str) -> FileInfo? ! FsErr uses fs.read
  fn exists(self, path: Str) -> Bool ! FsErr uses fs.read
  fn read(self, path: Str) -> Bytes ! FsErr uses fs.read
  fn read_text(self, path: Str) -> Str ! FsErr uses fs.read
  fn read_dir(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn walk(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn write(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  fn create_temp(self, dir: Str, prefix: Str) -> Str ! FsErr uses fs.write
  fn rename(self, from: Str, to: Str) -> () ! FsErr uses fs.write
  fn remove(self, path: Str) -> () ! FsErr uses fs.write
  fn remove_all(self, path: Str) -> () ! FsErr uses fs.write
  fn create_dir_all(self, dir: Str) -> () ! FsErr uses fs.write
  fn set_modified(self, path: Str, t: Time) -> () ! FsErr uses fs.write
  /// A handle that reads the file as a stream (std.md 3.1, decision 0163).
  fn open(self, path: Str) -> File ! FsErr uses fs.read
  /// A handle that writes the file, created or truncated.
  fn create(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes at the end of the file, created if missing.
  fn open_append(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes a new file: Exists(path) when something is
  /// already at path (O_EXCL; a symbolic link counts, dangling or not).
  fn create_new(self, path: Str) -> File ! FsErr uses fs.write
  /// Adds data at the end of the file, created if missing.
  fn append(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  /// Copies the contents and permission bits of a file.
  fn copy(self, from: Str, to: Str) -> () ! FsErr uses fs
  /// The permission bits, 0o644 style.
  fn mode(self, path: Str) -> Int ! FsErr uses fs.read
  fn set_mode(self, path: Str, mode: Int) -> () ! FsErr uses fs.write
  /// Creates a symbolic link at `link` that points to `target`.
  fn symlink(self, target: Str, link: Str) -> () ! FsErr uses fs.write
  /// The target of a symbolic link; None when path is not one.
  fn read_link(self, path: Str) -> Str? ! FsErr uses fs.read
  /// The paths that match pattern (`*`, `?`, `[a-z]`, `**`), sorted.
  fn glob(self, pattern: Str) -> List[Str] ! FsErr uses fs.read
  /// An advisory lock on the file (created if missing); waits for it.
  fn lock(self, path: Str) -> FileLock ! FsErr uses fs.write
  /// The lock if no one holds it, else None at once.
  fn try_lock(self, path: Str) -> FileLock? ! FsErr uses fs.write
}

/// Creates dir and every missing parent as create_dir_all does, then
/// gives each directory it created the permission bits mode exactly
/// (no umask), deepest first so a mode without write or search still
/// applies; directories already there keep theirs, as Go's MkdirAll
/// (std.md 3.1). A free function, not a method of Fs.
fn create_dir_all_mode(fs: Fs, dir: Str, mode: Int) -> () ! FsErr uses fs

/// What walk_dir's visit asks for next (Go's fs.WalkDirFunc results:
/// nil, fs.SkipDir, fs.SkipAll).
enum WalkStep {
  /// Go on: into a directory, else to the next entry.
  Continue
  /// On a directory, skip its contents; on a file, the rest of the
  /// files in its directory.
  SkipDir
  /// End the walk; walk_dir returns Ok.
  Stop
}

/// Calls visit for each entry under dir, parents before children and
/// siblings by name, without following symbolic links (Go's
/// filepath.WalkDir), and lets visit skip a directory or stop the walk;
/// the result is every entry visit was called on, in order (a closure
/// cannot add to a captured list, core 3.7), so the list holds every
/// visited entry: on a huge tree, return SkipDir or Stop, or do the work
/// in visit, and drop the result (std.md 3.1). Two differences
/// from Go: dir itself is not visited (as walk), and the first error
/// (reading a directory) ends the walk with that error, where Go hands it
/// to the function. A free function, not a method of Fs, so every type
/// that satisfies Fs still does.
fn walk_dir[fx: Effects](fs: Fs, dir: Str, visit: fn(FileInfo) -> WalkStep uses fx) -> List[FileInfo] ! FsErr uses (fs.read, fx)

/// The text of the file at path, or default when it does not exist
/// (FsErr.NotFound); any other error is the result (std.md 3.1). A free
/// function, not a method of Fs, so every type that satisfies Fs still does.
fn read_text_or(fs: Fs, path: Str, default: Str) -> Str ! FsErr uses fs.read
/// The bytes of the file at path, or default when it does not exist.
fn read_or(fs: Fs, path: Str, default: Bytes) -> Bytes ! FsErr uses fs.read
/// The bytes of the file at path, as fs.read(path) gives them, with the
/// same errors (decision 0402). On the native linux and darwin backends
/// it may share the file's pages instead of copying them: the program
/// must not truncate the file or change it in place while the Bytes (or
/// a slice of it) is alive; replacing it by rename is safe. Where mapping
/// is not possible it is read. Use read for a file other processes may
/// change in place. A free function, not a method of Fs, so every type
/// that satisfies Fs still does.
fn read_mapped(fs: Fs, path: Str) -> Bytes ! FsErr uses fs.read
/// Replaces the file at path with data so that a reader, or the file after
/// a crash, holds the old contents or the new, never a part: written to a
/// temporary file in path's directory, synced, given path's permission
/// bits (0o644 for a new file), renamed over path, and the directory
/// synced where the OS allows it (std.md 3.1). Atomic only within one
/// file system, which the temporary file beside path ensures.
fn write_atomic(fs: Fs, path: Str, data: Bytes) -> () ! FsErr uses fs

/// An open file (std.md 3.1, decision 0163). A handle; close it.
struct File {}
/// At most max bytes; None at the end.
fn (f: File) read(max: Int) -> Bytes? ! FsErr uses fs.read
/// One line without `\n` or `\r\n`; None at the end.
fn (f: File) read_line() -> Str? ! FsErr uses fs.read
fn (f: File) write(data: Bytes) -> () ! FsErr uses fs.write
/// Commits what was written to stable storage (Go's File.Sync: fsync,
/// F_FULLFSYNC on macOS, FlushFileBuffers on Windows).
fn (f: File) sync() -> () ! FsErr uses fs.write
/// Closes the file; closing it again does nothing.
fn (f: File) close() -> () ! FsErr

/// A held advisory file lock (std.md 3.1). A handle.
struct FileLock {}
/// Releases the lock; unlocking again does nothing.
fn (l: FileLock) unlock()

enum NetErr {
  InvalidAddr(msg: Str)
  Refused
  Timeout
  Io(msg: Str)
  Canceled
  /// The address is outside an attenuated Net (`Net.only`, decision 0156).
  Denied(addr: Str)
}

/// Plain text (decision 0358): `connection refused`, `i/o timeout`, the
/// message of an Io, `denied by Net.only: ADDR`.
fn (e: NetErr) display() -> Str

struct Listener {}
/// The bound address, `host:port`, with the port the system chose for
/// `:0` (std.md 3.2).
fn (l: Listener) addr() -> Str
/// Waits for the next connection (std.md 3.2, decision 0071).
fn (l: Listener) accept() -> ServerConn ! NetErr uses net.listen
/// Stops listening; a waiting `accept` fails with `Io`.
fn (l: Listener) close()
/// A connection made by `Net.dial`: its reads and writes are `net.dial`
/// (decision 0280).
struct Conn {}
/// At most max bytes (at most 1 MiB); None at the end of the stream.
fn (c: Conn) read(max: Int) -> Bytes? ! NetErr uses net.dial
/// Writes every byte of data.
fn (c: Conn) write(data: Bytes) -> () ! NetErr uses net.dial
/// Closes the connection; waiting reads and writes fail with `Io`.
fn (c: Conn) close()
/// A connection taken by `Listener.accept`: its reads and writes are
/// `net.listen` (decision 0280).
struct ServerConn {}
/// At most max bytes (at most 1 MiB); None at the end of the stream.
fn (c: ServerConn) read(max: Int) -> Bytes? ! NetErr uses net.listen
/// Writes every byte of data.
fn (c: ServerConn) write(data: Bytes) -> () ! NetErr uses net.listen
/// Closes the connection; waiting reads and writes fail with `Io`.
fn (c: ServerConn) close()

/// Either kind of connection, for code that reads and writes both
/// (decision 0280).
interface Stream {
  fn read(self, max: Int) -> Bytes? ! NetErr uses net
  fn write(self, data: Bytes) -> () ! NetErr uses net
  fn close(self)
}

interface Net {
  fn listen(self, addr: Str) -> Listener ! NetErr uses net.listen
  fn dial(self, addr: Str) -> Conn ! NetErr uses net.dial
  /// dial giving up after d over the lookup and the connect: `Timeout`
  /// then, where dial's own 30 second limit is `Io` (decision 0406).
  fn dial_timeout(self, addr: Str, d: Duration) -> Conn ! NetErr uses net.dial
  /// The addresses of host, as text, in the order dial tries them (Go's
  /// net.LookupHost; decision 0406).
  fn lookup_host(self, host: Str) -> List[Str] ! NetErr uses net.dial
  /// A Net that dials and listens only on the listed hosts: `host`,
  /// `*.domain`, or `host:port`, and `unix:PATH` for a Unix domain
  /// socket (std.md 3.2, decisions 0156 and 0190).
  fn only(self, hosts: List[Str]) -> Net
}

interface Clock {
  fn now(self) -> Time uses clock
  fn sleep(self, d: Duration) uses clock
  /// Like sleep, but cancellation is an error instead of an unwind
  /// (core 7.2, decision 0088).
  fn sleep_or_cancel(self, d: Duration) -> () ! ClockErr uses clock
  fn since(self, t: Time) -> Duration uses clock
}

interface Rand {
  fn int(self, lo: Int, hi: Int) -> Int uses rand
  fn float(self) -> Float uses rand
  fn bool(self) -> Bool uses rand
  fn bytes(self, n: Int) -> Bytes uses rand
  fn shuffle[T](self, xs: List[T]) -> List[T] uses rand
}

/// The error of `Clock.sleep_or_cancel` (decision 0088).
enum ClockErr {
  Canceled
}

/// `canceled` (decision 0358).
fn (e: ClockErr) display() -> Str

enum EnvErr {
  Missing(name: Str)
}

/// `NAME is not set` (decision 0358).
fn (e: EnvErr) display() -> Str

interface Env {
  fn get(self, name: Str) -> Str? uses env
  fn vars(self) -> Map[Str, Str] uses env
  fn args(self) -> List[Str] uses env
  fn program(self) -> Str uses env
  fn home(self) -> Str ! EnvErr uses env
  /// An Env that reads only the listed variables (std.md 3.5, decision
  /// 0156).
  fn only(self, names: List[Str]) -> Env
  /// Where a program keeps its configuration: XDG_CONFIG_HOME, else
  /// ~/.config, ~/Library/Application Support, or %AppData% (std.md 3.5,
  /// decision 0163).
  fn config_dir(self) -> Str ! EnvErr uses env
  /// Where a program keeps its cache: XDG_CACHE_HOME, else ~/.cache,
  /// ~/Library/Caches, or %LocalAppData%.
  fn cache_dir(self) -> Str ! EnvErr uses env
  /// The host's name (Go's os.Hostname): "" where the system cannot say
  /// (decision 0410).
  fn hostname(self) -> Str uses env
}

enum IoErr {
  Closed
  Io(msg: Str)
  Canceled
}

/// Plain text (decision 0358): `closed`, the message of an Io, `canceled`.
fn (e: IoErr) display() -> Str

interface Stdio {
  fn print(self, text: Str) uses stdio
  fn println(self, text: Str) uses stdio
  fn eprint(self, text: Str) uses stdio
  fn eprintln(self, text: Str) uses stdio
  fn write(self, data: Bytes) -> () ! IoErr uses stdio
  fn read_line(self) -> Str? ! IoErr uses stdio
  fn read_all(self) -> Str ! IoErr uses stdio
  fn lines(self) -> List[Str] ! IoErr uses stdio
  /// Whether standard input is a terminal (std.md 3.6, decision 0162).
  fn stdin_is_tty(self) -> Bool uses stdio
  /// Whether standard output is a terminal.
  fn stdout_is_tty(self) -> Bool uses stdio
  /// Whether standard error is a terminal.
  fn stderr_is_tty(self) -> Bool uses stdio
  /// The columns of the terminal on standard output, error, or input (the
  /// first that is one); None when none is.
  fn width(self) -> Int? uses stdio
  /// Writes prompt to standard error and reads a line of standard input
  /// without echoing it (a password); None at the end of input.
  fn read_secret(self, prompt: Str) -> Str? ! IoErr uses stdio
  /// At most max bytes of standard input, any bytes; None at the end.
  fn read_bytes(self, max: Int) -> Bytes? ! IoErr uses stdio
  /// The rest of standard input, any bytes.
  fn read_all_bytes(self) -> Bytes ! IoErr uses stdio
}

struct ProcOutput {
  code: Int
  stdout: Bytes
  stderr: Bytes
}

enum ProcErr {
  NotFound(cmd: Str)
  Io(msg: Str)
  Canceled
  /// The command is outside an attenuated Proc (`Proc.only`, decision
  /// 0156).
  Denied(cmd: Str)
}

/// Plain text (decision 0358): `CMD: executable file not found`, the message
/// of an Io, `canceled`, `denied by Proc.only: CMD`.
fn (e: ProcErr) display() -> Str

interface Proc {
  fn exit(self, code: Int) -> Never uses proc
  /// Time between a stop request and the cancellation of main's root scope
  /// (core 7.5, default 30s; 0s cancels at the first signal).
  fn set_grace(self, d: Duration) uses proc
  /// This process's ID (0 under WASI).
  fn pid(self) -> Int uses proc
  /// The parent process's ID (0 on Windows and under WASI).
  fn ppid(self) -> Int uses proc
  fn run(self, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr uses proc
  /// A Proc that runs only the listed commands (std.md 3.7, decision
  /// 0156).
  fn only(self, cmds: List[Str]) -> Proc
  /// A command to run, not started (std.md 3.8, decision 0161).
  fn cmd(self, name: Str, args: List[Str] = []) -> Cmd
  /// Runs the commands with each one's output piped into the next one's
  /// input: the last one's output, every error stream, and the status of
  /// the rightmost failing command (std.md 3.8).
  fn pipeline(self, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc
  /// Sends the signal named (HUP, INT, QUIT, KILL, TERM, USR1, USR2,
  /// CONT, STOP) to the process pid; an attenuated Proc must list "kill"
  /// (std.md 3.7, decision 0190).
  fn kill(self, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc
  /// A channel that receives each listed signal as it arrives (Go's
  /// signal.Notify): one pending signal of each kind, a repeat dropped.
  /// While any subscription lists Interrupt or Terminate, that signal no
  /// longer starts the shutdown (core 7.5); stop_notify gives it back
  /// (std.md 3.7, decision 0407).
  fn notify(self, signals: List[Signal]) -> Chan[Signal] uses proc
  /// Ends c's subscription and closes c.
  fn stop_notify(self, c: Chan[Signal]) uses proc
  /// Starts core 7.5's phase 1 as the first signal does: the stop state
  /// set, `task.stopping()` closed, servers draining.
  fn request_stop(self) uses proc
}

/// A signal a program can subscribe to (Proc.notify, decision 0407).
/// Windows delivers Interrupt (Ctrl-C, Ctrl-Break) and Terminate (the
/// console's close, a logoff, a shutdown) only.
enum Signal { Hangup, Interrupt, Quit, Terminate, User1, User2, WindowChange }

/// A command that has not run (std.md 3.8, decision 0161). A value: each
/// builder method returns a changed copy.
struct Cmd {}
/// The working directory of the child.
fn (c: Cmd) dir(path: Str) -> Cmd
/// The child's environment is exactly the variables `e` shows now (so an
/// attenuated Env narrows it); without it the child inherits the program's.
fn (c: Cmd) env(e: Env) -> Cmd uses env
/// One more variable for the child.
fn (c: Cmd) set_env(name: Str, value: Str) -> Cmd
/// The child's standard input.
fn (c: Cmd) stdin(data: Bytes) -> Cmd
/// The child's standard streams are the program's own (the terminal).
fn (c: Cmd) inherit() -> Cmd
/// The child's standard error goes into its standard output stream.
fn (c: Cmd) merge_stderr() -> Cmd
/// Runs to the end and collects both streams.
fn (c: Cmd) output() -> ProcOutput ! ProcErr uses proc
/// Runs on the terminal and returns the exit status.
fn (c: Cmd) run() -> Int ! ProcErr uses proc
/// Starts the command and returns at once.
fn (c: Cmd) spawn() -> Child ! ProcErr uses proc

/// A started command (std.md 3.8). A handle.
struct Child {}
fn (c: Child) pid() -> Int
/// Writes to the child's standard input.
fn (c: Child) write(data: Bytes) -> () ! ProcErr uses proc
fn (c: Child) close_stdin()
/// At most max bytes of the child's output; None at the end.
fn (c: Child) read(max: Int) -> Bytes? ! ProcErr uses proc
/// At most max bytes of the child's error stream; None at the end.
fn (c: Child) read_err(max: Int) -> Bytes? ! ProcErr uses proc
/// One line of the child's output, without `\n` or `\r\n`.
fn (c: Child) read_line() -> Str? ! ProcErr uses proc
/// Closes the child's input, waits for it, and returns its status.
fn (c: Child) wait() -> Int ! ProcErr uses proc
fn (c: Child) kill()
