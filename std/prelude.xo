// The prelude: builtin types, prelude interfaces, capability interfaces, and
// methods on builtin types (spec/std.md sections 1 to 3, core 2.1, 5.4, 7.1).
// Available in every module without `use`.
//
// This is a declaration file. It is parsed in signature mode (function
// declarations have no bodies) and read by internal/check. It is never
// compiled. Encoding rules shared by every file under std/:
//
//  1. Everything declared in a std file is public; `pub` is not written.
//     Fields of std structs are public (std.md 0).
//  2. A struct with no fields is an opaque handle: it cannot be built with a
//     struct literal (Int, List, Router, Task, ...). Builtin types are such
//     structs; the checker knows their literals and operators by name.
//  3. `[var] xs` receivers in std.md are written `var xs`.
//  4. A receiver named `static` declares an associated function, called on
//     the type rather than on a value: `Int.parse(s)`, `Chan[Job].new(cap: 8)`,
//     `Duration.from_secs(1.5)`. A static with an UPPER_SNAKE name and no
//     parameters is an associated constant, read without a call:
//     `Time.UNIX_EPOCH`.
//  5. In a receiver type, a type argument that is a bare name not declared
//     as a type (T, K, V, E) is an implicit type parameter of the method. A
//     declared type there restricts the method: `fn (xs: List[Str]) join`
//     exists only on `List[Str]`.
//  6. `T?` receivers are written `Option[T]`.
//  7. "also x, y" comments in std.md are expanded into one declaration each.
//  8. A doc comment line `@moves` marks a method that moves its receiver
//     (core 5.3: `freeze`).
//  9. Things the checker builds in rather than reads from here: numeric
//     conversions `Int(x)`, `Float(x)`, `Int32(x)` and the other sized types
//     (any numeric type to any numeric type); operators (core 2.1, 15);
//     `min`, `max`, `clamp` on every `Ord` type; `t.await` on a Task without
//     parentheses; `expect(a) <op> b` in tests; the predeclared `target`.
//     Eq, Hash, Ord, Json, OpenApi, Proto, SqlRow, and Debug are marker interfaces
//     whose satisfaction rules are builtin (std.md 1).
// 10a. A doc comment line `@move_only` on a std struct makes its values move
//     only like the builders (core 5.3; std/compress's Compressor).
// 10b. std writes no `pub`: its declarations and fields are public. A doc
//     comment line `@internal` on a std struct keeps its fields to std's
//     modules: user code naming one (a field access, a struct literal or
//     pattern, `with`) is XO0605 (decision 0440; std/uuid's Uuid).
// 10. The prelude imports std/task for `task.Group` (the type of `os.tasks`
//     and of `s.group()`, core 7.1). The import is not visible to user code:
//     a module still needs `use std/task` to name `task.Group`.
use std/task

// ---------------------------------------------------------------------------
// Builtin types (core 2.1)

struct Bool {}
struct Int {}
struct Int8 {}
struct Int16 {}
struct Int32 {}
struct Int64 {}
struct UInt8 {}
struct UInt16 {}
struct UInt32 {}
struct UInt64 {}
struct Float {}
struct Float32 {}
struct Rune {}
struct Str {}
struct Bytes {}
struct Duration {}
struct Time {}
struct List[T] {}
struct Map[K, V] {}
struct Set[T] {}
struct Buf[T] {}
struct StrBuilder {}
struct BytesBuilder {}
struct Chan[T] {}
struct Mutex[T] {}
struct Atomic[T] {}
struct Secret[T] {}

/// The type of a range expression `a..b` or `a..=b` (core 3.5, 3.6). Not
/// named by the spec; it exists so ranges can be stored and iterated.
struct Range[T] {}
/// The range's integers in order as a list: `(0..3).to_list()` is [0, 1, 2].
fn (r: Range[Int]) to_list() -> List[Int]

/// The type with no values (core 2.1). An enum with no variants, so a match
/// on it needs no arms. Converts to every type.
enum Never {}

/// `T?` (core 2.5).
enum Option[T] {
  None
  Some(v: T)
}

/// Success or failure (core 2.6).
enum Result[T, E] {
  Ok(v: T)
  Err(e: E)
}

// ---------------------------------------------------------------------------
// Prelude interfaces (std.md 1)

interface Display {
  fn display(self) -> Str
}

/// The open error interface: any Display type is an Error.
interface Error {
  fn display(self) -> Str
}

/// Implemented by every type.
interface Debug {
  fn debug(self) -> Str
}

// Marker interfaces with builtin satisfaction rules.
interface Eq {}
interface Hash {}
interface Ord {}
interface Json {}
interface OpenApi {}
interface Proto {}
/// Decodable from a std/sql row by column name (`derive SqlRow`, std.md 10.4).
interface SqlRow {}
/// Reads and writes XML as Go's encoding/xml does (`derive Xml`, std.md 34).
interface Xml {}
/// Read from YAML by the types of its fields (`derive Yaml`, decision 0512).
interface Yaml {}
/// Marshaled to and from CBOR by the types of its fields (`derive Cbor`, decision 0527).
interface Cbor {}

// ---------------------------------------------------------------------------
// Predeclared functions (core 1.4, 8, 11.4)

/// A fault with msg, as Go's panic (core 8): it ends the current task, and
/// one reaching main exits with status 70 and a traceback. For a bug,
/// never for an error a caller should handle.
fn fault(msg: Str) -> Never
/// Returns x and writes `[file.xo:LINE:COL] expr = value` (its Debug text)
/// on standard error, as Rust's dbg! (core 11.4). Needs no capability;
/// `--release` and `--dbg=off` builds print nothing, and xo vet warns.
fn dbg[T](x: T) -> T

// ---------------------------------------------------------------------------
// Targets (core 12.2). `target` is a predeclared value of type Target.

// ---------------------------------------------------------------------------
// Ordering (decision 0586): `a.cmp(b)` on every Ord type (built in, as
// min and max are), the comparator of sort_with.

/// The result of comparing two values: `a.cmp(b)` is Less when a < b.
enum Ordering {
  Less
  Equal
  Greater
}

/// Less and Greater swapped: `a.cmp(b).reverse()` is `b.cmp(a)`.
fn (o: Ordering) reverse() -> Ordering
/// o, or next when o is Equal: the next key of a multi-key order (Go's
/// cmp.Or, Rust's then): `a.n.cmp(b.n).then(a.s.cmp(b.s))`.
fn (o: Ordering) then(next: Ordering) -> Ordering

enum TargetOs {
  Linux
  Darwin
  Windows
  Wasi
  FreeBSD
}

enum TargetArch {
  Amd64
  Arm64
  Wasm32
  Riscv64
}

struct Target {
  os: TargetOs
  arch: TargetArch
}

// ---------------------------------------------------------------------------
// Numbers (std.md 2.1)

// The integer types' bounds, `Int.max` and `Int.min` (decision 0587):
// type constants, so these names are not in scope.
/// The largest Int. @static Int.max
const INT_MAX: Int = 9223372036854775807
/// The smallest Int. @static Int.min
const INT_MIN: Int = -9223372036854775807 - 1
/// The largest Int8. @static Int8.max
const INT8_MAX: Int8 = 127
/// The smallest Int8. @static Int8.min
const INT8_MIN: Int8 = -128
/// The largest Int16. @static Int16.max
const INT16_MAX: Int16 = 32767
/// The smallest Int16. @static Int16.min
const INT16_MIN: Int16 = -32768
/// The largest Int32. @static Int32.max
const INT32_MAX: Int32 = 2147483647
/// The smallest Int32. @static Int32.min
const INT32_MIN: Int32 = -2147483648
/// The largest Int64. @static Int64.max
const INT64_MAX: Int64 = 9223372036854775807
/// The smallest Int64. @static Int64.min
const INT64_MIN: Int64 = -9223372036854775807 - 1
/// The largest UInt8. @static UInt8.max
const UINT8_MAX: UInt8 = 255
/// The smallest UInt8. @static UInt8.min
const UINT8_MIN: UInt8 = 0
/// The largest UInt16. @static UInt16.max
const UINT16_MAX: UInt16 = 65535
/// The smallest UInt16. @static UInt16.min
const UINT16_MIN: UInt16 = 0
/// The largest UInt32. @static UInt32.max
const UINT32_MAX: UInt32 = 4294967295
/// The smallest UInt32. @static UInt32.min
const UINT32_MIN: UInt32 = 0
/// The largest UInt64. @static UInt64.max
const UINT64_MAX: UInt64 = 18446744073709551615
/// The smallest UInt64. @static UInt64.min
const UINT64_MIN: UInt64 = 0

// Float's constants (decision 0592): type constants as the integer bounds.
/// The largest code point, U+10FFFF (Go's unicode.MaxRune, decision
/// 0595). @static Rune.max
const RUNE_MAX: Rune = '\u{10FFFF}'
/// The largest ASCII code point, U+007F (Go's unicode.MaxASCII; a byte
/// below utf8.RuneSelf is `<= Rune.max_ascii`, decision 0595).
/// @static Rune.max_ascii
const RUNE_MAX_ASCII: Rune = '\u{7F}'
/// Positive infinity (Go's math.Inf(1)); `-Float.inf` is negative
/// infinity. @static Float.inf
const FLOAT_INF: Float = 1.0 / 0.0
/// A NaN (Go's math.NaN()): unequal to every Float, itself too; test one
/// with `is_nan`. @static Float.nan
const FLOAT_NAN: Float = 0.0 / 0.0
/// π, the Float nearest it (Go's math.Pi). @static Float.pi
const FLOAT_PI: Float = 3.141592653589793
/// e, the Float nearest it (Go's math.E). @static Float.e
const FLOAT_E: Float = 2.718281828459045
/// The largest finite Float (Go's math.MaxFloat64). @static Float.max
const FLOAT_MAX: Float = 1.7976931348623157e308
/// The most negative finite Float, `-Float.max`. @static Float.min
const FLOAT_MIN: Float = -1.7976931348623157e308
/// The smallest positive Float, a subnormal (Go's
/// math.SmallestNonzeroFloat64). @static Float.smallest_nonzero
const FLOAT_SMALLEST_NONZERO: Float = 4.9406564584124654e-324

/// Go's strconv.ParseInt(s, 10, 64): decimal text with an optional sign and
/// _ between digits; None for anything else (spaces included) or a value
/// that overflows Int.
fn (static: Int) parse(s: Str) -> Int?
/// Go's ParseInt(s, base, 64): base 2 to 36, or 0 for the 0b, 0o, 0x, and
/// 0 prefixes and _ separators; None for text that is not a number in
/// base or overflows Int; faults on another base (decision 0287).
fn (static: Int) parse_base(s: Str, base: Int) -> Int?
/// Go's FormatInt(n, base): base 2 to 36, lower case digits; faults on
/// another base (decision 0287).
fn (n: Int) to_str_base(base: Int) -> Str
/// n as text in base (2 to 36, lower case) in at least `width` characters:
/// padded on the left with spaces, or after the sign with zeros when `zero`
/// is set (`%08d`), or on the right with spaces when width is negative
/// (`%-8d`, zero ignored); `plus` writes a `+` before a positive n (`%+d`),
/// as Go's fmt (decision 0410).
fn (n: Int) to_str_width(width: Int, base: Int = 10, zero: Bool = false, plus: Bool = false) -> Str
/// Go's ParseBool: 1, t, T, TRUE, true, True; 0, f, F, FALSE, false,
/// False (decision 0287).
fn (static: Bool) parse(s: Str) -> Bool?
/// Go's strconv.ParseFloat(s, 64): decimal or hexadecimal (`0x1.8p1`) text,
/// _ between digits, and inf, infinity and nan in any case; None for
/// anything else or a value out of range.
fn (static: Float) parse(s: Str) -> Float?
/// x as a Int8, or None when it is out of Int8's range (`Int8(x)` faults
/// instead).
fn (static: Int8) try(x: Int) -> Int8?
/// x as a Int16, or None when it is out of Int16's range (`Int16(x)` faults
/// instead).
fn (static: Int16) try(x: Int) -> Int16?
/// x as a Int32, or None when it is out of Int32's range (`Int32(x)` faults
/// instead).
fn (static: Int32) try(x: Int) -> Int32?
/// x as a Int64, or None when it is out of Int64's range (`Int64(x)` faults
/// instead).
fn (static: Int64) try(x: Int) -> Int64?
/// x as a UInt8, or None when it is out of UInt8's range (`UInt8(x)` faults
/// instead).
fn (static: UInt8) try(x: Int) -> UInt8?
/// x as a UInt16, or None when it is out of UInt16's range (`UInt16(x)` faults
/// instead).
fn (static: UInt16) try(x: Int) -> UInt16?
/// x as a UInt32, or None when it is out of UInt32's range (`UInt32(x)` faults
/// instead).
fn (static: UInt32) try(x: Int) -> UInt32?
/// x as a UInt64, or None when it is out of UInt64's range (`UInt64(x)` faults
/// instead).
fn (static: UInt64) try(x: Int) -> UInt64?
/// Go's conversion T(x) of an Int to a smaller integer type: the low bits
/// kept, sign extended for a signed T, no fault (`Int8.wrapping_from(300)`
/// is 44, `UInt8.wrapping_from(-1)` is 255). `try` is the checked one.
fn (static: Int8) wrapping_from(x: Int) -> Int8
/// Go's int16(x): x's low bits as a Int16, no fault.
fn (static: Int16) wrapping_from(x: Int) -> Int16
/// Go's int32(x): x's low bits as a Int32, no fault.
fn (static: Int32) wrapping_from(x: Int) -> Int32
/// Go's uint8(x): x's low bits as a UInt8, no fault.
fn (static: UInt8) wrapping_from(x: Int) -> UInt8
/// Go's uint16(x): x's low bits as a UInt16, no fault.
fn (static: UInt16) wrapping_from(x: Int) -> UInt16
/// Go's uint32(x): x's low bits as a UInt32, no fault.
fn (static: UInt32) wrapping_from(x: Int) -> UInt32
/// UInt64.wrapping_from(x) is UInt64.from_bits(x).
fn (static: UInt64) wrapping_from(x: Int) -> UInt64
/// Int's 64 bits as a UInt64 (Go's uint64(x)): -1 is 18446744073709551615.
fn (static: UInt64) from_bits(b: Int) -> UInt64
/// u's 64 bits as an Int (Go's int64(u)): 2^63 and up are negative.
fn (u: UInt64) to_bits() -> Int
/// The IEEE 754 binary32 bits of f (Go's Float32bits), and the Float32 of
/// bits b (Float32frombits); a NaN keeps its payload.
fn (f: Float32) to_bits() -> UInt32
/// The Float32 whose IEEE 754 binary32 bits are b (Go's
/// math.Float32frombits).
fn (static: Float32) from_bits(b: UInt32) -> Float32
/// The character with code point x, or None when x is not a Unicode
/// scalar value (a surrogate, negative, or above U+10FFFF).
fn (static: Rune) try(x: Int) -> Rune?

/// The absolute value of n; faults on the minimum Int, whose absolute value
/// does not fit.
fn (n: Int) abs() -> Int
/// n to the power e; faults on a negative e or a result that overflows Int.
fn (n: Int) pow(e: Int) -> Int
/// n + m wrapped to 64 bits (two's complement, as Go's +): never faults.
fn (n: Int) wrapping_add(m: Int) -> Int
/// n - m wrapped to 64 bits (two's complement, as Go's -): never faults.
fn (n: Int) wrapping_sub(m: Int) -> Int
/// n * m wrapped to 64 bits (the low word, as Go's *): never faults.
fn (n: Int) wrapping_mul(m: Int) -> Int
/// n shifted left by k mod 64 (the bits shifted out dropped; decision
/// 0260: Int's word methods, inline on every native backend).
fn (n: Int) wrapping_shl(k: Int) -> Int
/// n's 64 bits shifted right by k mod 64 with zeros in at the top (a
/// logical shift: `>>` keeps the sign).
fn (n: Int) shr_logical(k: Int) -> Int
/// n's 64 bits rotated right by k mod 64.
fn (n: Int) rotate_right(k: Int) -> Int
/// n's low 32 bits rotated right by k mod 32, zero extended.
fn (n: Int) rotate_right32(k: Int) -> Int
/// n's 8 bytes in the reverse order.
fn (n: Int) swap_bytes() -> Int
/// The high 64 bits of the 128 bit product of n and m as unsigned words.
fn (n: Int) mul_hi_unsigned(m: Int) -> Int
/// Whether n < m as unsigned 64 bit words.
fn (n: Int) lt_unsigned(m: Int) -> Bool
/// Whether n <= m as unsigned 64 bit words.
fn (n: Int) le_unsigned(m: Int) -> Bool
/// math/bits on the 64 bit word (decision 0287).
fn (n: Int) leading_zeros() -> Int
/// The bits needed to write n's 64 bit word as unsigned: 64 minus its
/// leading zeros, 0 for 0 (Go's bits.Len64, decision 0595).
fn (n: Int) bit_len() -> Int
/// n + m + carry as unsigned 64 bit words, and the carry out, 0 or 1
/// (Go's bits.Add64, decision 0595); carry should be 0 or 1.
fn (n: Int) add_carry(m: Int, carry: Int) -> (Int, Int)
/// n - m - borrow as unsigned 64 bit words, and the borrow out, 0 or 1
/// (Go's bits.Sub64, decision 0595); borrow should be 0 or 1.
fn (n: Int) sub_borrow(m: Int, borrow: Int) -> (Int, Int)
/// The number of trailing zero bits of n's 64 bit word; 64 for 0 (Go's
/// bits.TrailingZeros64).
fn (n: Int) trailing_zeros() -> Int
/// The number of one bits in n's 64 bit word (Go's bits.OnesCount64).
fn (n: Int) ones_count() -> Int
/// n + m, clamped to the maximum or minimum Int when it overflows.
fn (n: Int) saturating_add(m: Int) -> Int
/// n - m, clamped to the maximum or minimum Int when it overflows.
fn (n: Int) saturating_sub(m: Int) -> Int
/// n * m, clamped to the maximum or minimum Int when it overflows.
fn (n: Int) saturating_mul(m: Int) -> Int
/// n + m, or None when it overflows.
fn (n: Int) checked_add(m: Int) -> Int?
/// n - m, or None when it overflows.
fn (n: Int) checked_sub(m: Int) -> Int?
/// n * m, or None when it overflows.
fn (n: Int) checked_mul(m: Int) -> Int?
/// n / m (truncated toward zero), or None when m is 0 or the quotient
/// overflows (the minimum Int divided by -1).
fn (n: Int) checked_div(m: Int) -> Int?

/// The greatest integer value at most f (Go's math.Floor).
fn (f: Float) floor() -> Float
/// f as strconv.FormatFloat's 'f', 'e' and 'g' text with prec digits
/// (`%.3f`, `%e`, `%g`; prec below 0 is the shortest digits that round
/// trip), padded as Int.to_str_width does: `width` columns, zeros after the
/// sign with `zero`, left justified for a negative width, `+` before a
/// positive number with `plus`. NaN and the infinities are never zero
/// padded (decision 0410).
fn (f: Float) to_fixed(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
/// f in exponent form with prec digits after the point, as Go's %e
/// (strconv.FormatFloat 'e'); padded as to_fixed.
fn (f: Float) to_exp(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
/// f with prec significant digits in the shorter of the plain and exponent
/// forms, as Go's %g (strconv.FormatFloat 'g'); padded as to_fixed.
fn (f: Float) to_general(prec: Int, width: Int = 0, zero: Bool = false, plus: Bool = false) -> Str
/// The least integer value at least f (Go's math.Ceil).
fn (f: Float) ceil() -> Float
/// f rounded to the nearest integer value, half away from zero (Go's
/// math.Round: 2.5 is 3.0, -2.5 is -3.0).
fn (f: Float) round() -> Float
/// f with its fraction dropped, toward zero (Go's math.Trunc).
fn (f: Float) trunc() -> Float
/// The absolute value of f (Go's math.Abs).
fn (f: Float) abs() -> Float
/// The square root of f; NaN below 0 (Go's math.Sqrt).
fn (f: Float) sqrt() -> Float
/// Whether f is NaN (Go's math.IsNaN).
fn (f: Float) is_nan() -> Bool
/// Go's math, its portable algorithms with every operation rounded, so
/// the results are the same bits on every backend and architecture
/// (decision 0287).
fn (f: Float) pow(y: Float) -> Float
/// e to the power f (Go's math.Exp).
fn (f: Float) exp() -> Float
/// 2 to the power f (Go's math.Exp2).
fn (f: Float) exp2() -> Float
/// e to the power f, minus 1, accurate near 0 (Go's math.Expm1).
fn (f: Float) expm1() -> Float
/// The natural logarithm of f (Go's math.Log).
fn (f: Float) log() -> Float
/// The base 2 logarithm of f (Go's math.Log2).
fn (f: Float) log2() -> Float
/// The base 10 logarithm of f (Go's math.Log10).
fn (f: Float) log10() -> Float
/// The natural logarithm of 1 + f, accurate near 0 (Go's math.Log1p).
fn (f: Float) log1p() -> Float
/// The sine of f radians (Go's math.Sin).
fn (f: Float) sin() -> Float
/// The cosine of f radians (Go's math.Cos).
fn (f: Float) cos() -> Float
/// The tangent of f radians (Go's math.Tan).
fn (f: Float) tan() -> Float
/// The arcsine of f in radians (Go's math.Asin).
fn (f: Float) asin() -> Float
/// The arccosine of f in radians (Go's math.Acos).
fn (f: Float) acos() -> Float
/// The arctangent of f in radians (Go's math.Atan).
fn (f: Float) atan() -> Float
/// The hyperbolic sine of f (Go's math.Sinh).
fn (f: Float) sinh() -> Float
/// The hyperbolic cosine of f (Go's math.Cosh).
fn (f: Float) cosh() -> Float
/// The hyperbolic tangent of f (Go's math.Tanh).
fn (f: Float) tanh() -> Float
/// The cube root of f (Go's math.Cbrt).
fn (f: Float) cbrt() -> Float
/// atan(f / x) in the quadrant of (x, f), as Go's Atan2(f, x).
fn (f: Float) atan2(x: Float) -> Float
/// The square root of f*f + y*y without overflow or underflow on the way
/// (Go's math.Hypot).
fn (f: Float) hypot(y: Float) -> Float
/// f * y + z computed exactly and rounded once (IEEE 754
/// fusedMultiplyAdd; Go's math.FMA), the same bits on every backend
/// (decision 0385). `f * y + z` written out rounds twice and is never
/// fused.
fn (f: Float) fma(y: Float, z: Float) -> Float
/// Go's Mod: the remainder of f / y with the sign of f.
fn (f: Float) mod(y: Float) -> Float
/// Whether f is +Inf or -Inf (Go's math.IsInf(f, 0)).
fn (f: Float) is_inf() -> Bool
/// The IEEE 754 bits of f, and the Float of bits b (Go's Float64bits,
/// Float64frombits).
fn (f: Float) to_bits() -> Int
/// The Float whose IEEE 754 bits are b (Go's math.Float64frombits).
fn (static: Float) from_bits(b: Int) -> Float

// ---------------------------------------------------------------------------
// Str, Rune, Bytes (std.md 2.2)

/// The length of s in bytes (Go's len); rune_count counts characters.
fn (s: Str) len() -> Int
/// The number of runes in s (Go's utf8.RuneCountInString).
fn (s: Str) rune_count() -> Int
/// Whether s is "".
fn (s: Str) is_empty() -> Bool
/// Whether sub is in s (Go's strings.Contains); true for "".
fn (s: Str) contains(sub: Str) -> Bool
/// Whether s begins with p (Go's strings.HasPrefix).
fn (s: Str) starts_with(p: Str) -> Bool
/// Whether s ends with p (Go's strings.HasSuffix).
fn (s: Str) ends_with(p: Str) -> Bool
/// Whether s and other are equal under Unicode simple case folding
/// (strings.EqualFold), not only ASCII case.
fn (s: Str) equal_fold(other: Str) -> Bool
/// The byte offset of the first sub in s, or None (Go's strings.Index);
/// Some(0) for "".
fn (s: Str) find(sub: Str) -> Int?
/// The byte offset of the last sub (strings.LastIndex); Some(s.len()) for "".
fn (s: Str) rfind(sub: Str) -> Int?
/// The number of non-overlapping copies of sub (strings.Count); the count
/// of s's runes plus one for "".
fn (s: Str) count(sub: Str) -> Int
/// The byte offset of the first rune for which f is true (strings.IndexFunc),
/// None when there is none; an invalid byte of s is U+FFFD, as in find.
fn (s: Str) find_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// The byte offset of the last rune for which f is true
/// (strings.LastIndexFunc), None when there is none.
fn (s: Str) rfind_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// Whether s holds a rune for which f is true (strings.ContainsFunc).
fn (s: Str) contains_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx
/// The byte offset of the first rune of chars in s (strings.IndexAny),
/// None for no rune of chars and for "".
fn (s: Str) find_any(chars: Str) -> Int?
/// The byte offset of the last rune of chars in s (strings.LastIndexAny).
fn (s: Str) rfind_any(chars: Str) -> Int?
/// Whether s holds a rune of chars (strings.ContainsAny).
fn (s: Str) contains_any(chars: Str) -> Bool
/// Whether s holds r (strings.ContainsRune); an invalid byte of s reads as
/// U+FFFD, so a U+FFFD r finds it.
fn (s: Str) contains_rune(r: Rune) -> Bool
/// s cut at each sep, at most n pieces with the unsplit rest in the last;
/// n below 0 for every piece and 0 for none (strings.SplitN). Pieces are
/// views of s like split's.
fn (s: Str) split_n(sep: Str, n: Int) -> List[Str]
/// Like split, each piece keeping its separator (strings.SplitAfter).
fn (s: Str) split_after(sep: Str) -> List[Str]
/// At most n pieces, each keeping its separator (strings.SplitAfterN).
fn (s: Str) split_after_n(sep: Str, n: Int) -> List[Str]
/// The text before and after the first sep (strings.Cut), as views of s;
/// None when sep does not occur, and sep "" cuts at the start.
fn (s: Str) cut(sep: Str) -> (Str, Str)?
/// The rest of s after prefix (strings.CutPrefix), a view of s; None when
/// s does not start with prefix, and prefix "" gives s.
fn (s: Str) cut_prefix(prefix: Str) -> Str?
/// s up to its suffix (strings.CutSuffix), a view of s; None when s does
/// not end with suffix, and suffix "" gives s.
fn (s: Str) cut_suffix(suffix: Str) -> Str?
/// The pieces of s between each sep (Go's strings.Split): "a,b," gives
/// ["a", "b", ""], an empty sep splits after each rune. Pieces are views of s.
fn (s: Str) split(sep: Str) -> List[Str]
/// The runs of non-white-space text, split around runs of white space
/// (strings.Fields, unicode.IsSpace); pieces are views of s like split's.
fn (s: Str) fields() -> List[Str]
/// The runs of runes between runs of runes for which f is true
/// (strings.FieldsFunc); pieces are views of s like split's.
fn (s: Str) split_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> List[Str] ! E uses fx
/// The lines of s, split on \n with a \r before it removed; a final newline
/// starts no empty line (Go's bufio.ScanLines). Pieces are views of s.
fn (s: Str) lines() -> List[Str]
/// s without Unicode white space at either end (Go's strings.TrimSpace); a
/// view of s.
fn (s: Str) trim() -> Str
/// s without Unicode white space at the start (Go's strings.TrimLeftFunc
/// with unicode.IsSpace); a view of s.
fn (s: Str) trim_start() -> Str
/// s without Unicode white space at the end (Go's strings.TrimRightFunc
/// with unicode.IsSpace); a view of s.
fn (s: Str) trim_end() -> Str
/// s without a leading p, or s itself when it does not start with p (Go's
/// strings.TrimPrefix).
fn (s: Str) trim_prefix(p: Str) -> Str
/// s without a trailing p, or s itself when it does not end with p (Go's
/// strings.TrimSuffix).
fn (s: Str) trim_suffix(p: Str) -> Str
/// s without its leading and trailing runes in chars, a view of s like
/// trim (strings.Trim); an empty s or chars gives s.
fn (s: Str) trim_chars(chars: Str) -> Str
/// s without its leading runes in chars, a view of s (strings.TrimLeft).
fn (s: Str) trim_start_chars(chars: Str) -> Str
/// s without its trailing runes in chars, a view of s (strings.TrimRight).
fn (s: Str) trim_end_chars(chars: Str) -> Str
/// s without its leading and trailing runes for which f is true, a view of
/// s like trim (strings.TrimFunc).
fn (s: Str) trim_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
/// s without its leading runes for which f is true, a view of s
/// (strings.TrimLeftFunc).
fn (s: Str) trim_start_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
/// s without its trailing runes for which f is true, a view of s
/// (strings.TrimRightFunc).
fn (s: Str) trim_end_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Str ! E uses fx
/// s with every rune in lower case, Unicode aware (Go's strings.ToLower).
fn (s: Str) to_lower() -> Str
/// s with every rune in upper case, Unicode aware (Go's strings.ToUpper).
fn (s: Str) to_upper() -> Str
/// f applied to every rune of s (strings.Map); None (Go's negative
/// mapping) drops the rune, and s itself, not a copy, when nothing changes.
fn (s: Str) map_runes[E, fx: Effects](f: fn(Rune) -> Rune? ! E uses fx) -> Str ! E uses fx
/// s with every non-overlapping old replaced by new (Go's
/// strings.ReplaceAll).
fn (s: Str) replace(old: Str, new: Str) -> Str
/// s with the first n copies of old replaced by new; n below 0 for every
/// copy and 0 for none (strings.Replace). s itself, not a copy, when
/// nothing changes.
fn (s: Str) replace_n(old: Str, new: Str, n: Int) -> Str
/// n copies of s joined (Go's strings.Repeat); "" for 0, a fault below 0.
fn (s: Str) repeat(n: Int) -> Str
/// s with `fill` (one rune) added on the left (pad_left), on the right
/// (pad_right) or on both sides (center, the extra one on the right) until
/// it is `width` runes; s itself when it is that long already (Go's fmt
/// width, `%*s` and `%-*s`, is a minimum; decision 0410).
fn (s: Str) pad_left(width: Int, fill: Str = " ") -> Str
/// s with fill added on the right until it is width runes (Go's %-*s); see
/// pad_left.
fn (s: Str) pad_right(width: Int, fill: Str = " ") -> Str
/// s with fill added on both sides until it is width runes, the extra one
/// on the right; see pad_left.
fn (s: Str) center(width: Int, fill: Str = " ") -> Str
/// An explicit copy of s in a buffer of its own: a slice, a `split` piece or
/// a `trim` result shares its source's buffer on native targets (core 3.6),
/// so a small piece to keep for long copies it to let a large source go.
fn (s: Str) clone() -> Str
/// The runes of s in order (Go's []rune(s)); an invalid byte is U+FFFD.
fn (s: Str) runes() -> List[Rune]
/// s's UTF-8 bytes, without a copy (Go's []byte(s) copies): s.bytes()[i]
/// is byte i in O(1).
fn (s: Str) bytes() -> Bytes

/// The number of bytes in b (Go's len); b[i] is the byte at i.
fn (b: Bytes) len() -> Int
/// Whether b has no bytes.
fn (b: Bytes) is_empty() -> Bool
/// b as text, or None when b is not valid UTF-8 (to_str_lossy replaces
/// instead).
fn (b: Bytes) to_str() -> Str?
/// b as text with each byte of an invalid UTF-8 sequence U+FFFD, the rule
/// std's outside text follows (std.md 0, decision 0259; Go's
/// `string([]rune(string(b)))`); b's text itself when it is valid.
fn (b: Bytes) to_str_lossy() -> Str
/// Go's bytes.ToValidUTF8: b as text with each run of invalid UTF-8
/// bytes replaced by one copy of replacement ("" drops them).
fn (b: Bytes) to_valid_utf8(replacement: Str) -> Str
/// b in lower case hexadecimal, two digits a byte (Go's
/// hex.EncodeToString).
fn (b: Bytes) to_hex() -> Str
/// An explicit copy of b in a buffer of its own (see Str.clone).
fn (b: Bytes) clone() -> Bytes
/// b in the standard base64 encoding with padding (Go's
/// base64.StdEncoding.EncodeToString).
fn (b: Bytes) to_base64() -> Str
/// The bytes of hexadecimal text s, either case, or None for an odd length
/// or a non-hex digit (Go's hex.DecodeString).
fn (static: Bytes) from_hex(s: Str) -> Bytes?
/// The bytes of standard padded base64 text s, or None when it is not
/// valid (Go's base64.StdEncoding.DecodeString).
fn (static: Bytes) from_base64(s: Str) -> Bytes?
/// The number of UTF-8 runes in b, an invalid byte counting as one (Go's
/// utf8.RuneCount).
fn (b: Bytes) rune_count() -> Int
/// The rune at byte i and its size (Go's utf8.DecodeRune(b[i:])):
/// (U+FFFD, 1) for an invalid or short sequence, (U+FFFD, 0) at the end; a
/// fault when i is negative or past the end.
fn (b: Bytes) decode_rune(i: Int) -> (Rune, Int)
/// b as a double quoted literal with escapes, an invalid byte as \xHH
/// (Go's strconv.Quote(string(b))).
fn (b: Bytes) quote() -> Str
/// The offset of the first sub (bytes.Index); Some(0) for an empty sub.
fn (b: Bytes) find(sub: Bytes) -> Int?
/// The offset of the last sub (bytes.LastIndex); Some(b.len()) for an empty sub.
fn (b: Bytes) rfind(sub: Bytes) -> Int?
/// Whether sub is in b (bytes.Contains); true for an empty sub. The bytes
/// need not be UTF-8: compare bytes, not text.
fn (b: Bytes) contains(sub: Bytes) -> Bool
/// Whether b starts with p (bytes.HasPrefix); true for an empty p.
fn (b: Bytes) starts_with(p: Bytes) -> Bool
/// Whether b ends with p (bytes.HasSuffix); true for an empty p.
fn (b: Bytes) ends_with(p: Bytes) -> Bool
/// The number of non-overlapping copies of sub in b (bytes.Count); for an
/// empty sub the rune count plus one, an invalid byte counting as one rune.
fn (b: Bytes) count(sub: Bytes) -> Int
/// The byte offset of the first rune of chars in b (bytes.IndexAny), None
/// for no rune of chars and for ""; an invalid byte of b reads as U+FFFD.
fn (b: Bytes) find_any(chars: Str) -> Int?
/// The byte offset of the last rune of chars in b (bytes.LastIndexAny).
fn (b: Bytes) rfind_any(chars: Str) -> Int?
/// Whether b holds a rune of chars (bytes.ContainsAny); false for "".
fn (b: Bytes) contains_any(chars: Str) -> Bool
/// Whether b holds r (bytes.ContainsRune); an invalid byte of b reads as
/// U+FFFD, so a U+FFFD r finds it.
fn (b: Bytes) contains_rune(r: Rune) -> Bool
/// The byte offset of the first rune for which f is true (bytes.IndexFunc),
/// None when there is none; an invalid byte of b is U+FFFD, as in find.
fn (b: Bytes) find_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// The byte offset of the last rune for which f is true
/// (bytes.LastIndexFunc), None when there is none.
fn (b: Bytes) rfind_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Int? ! E uses fx
/// Whether b holds a rune for which f is true (bytes.ContainsFunc).
fn (b: Bytes) contains_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bool ! E uses fx
/// b cut at each sep, the pieces views of b (bytes.Split); an empty sep
/// splits after each UTF-8 sequence, an invalid byte alone.
fn (b: Bytes) split(sep: Bytes) -> List[Bytes]
/// b cut at each sep, at most n pieces with the unsplit rest in the last;
/// n below 0 means every piece and n 0 an empty list (bytes.SplitN).
fn (b: Bytes) split_n(sep: Bytes, n: Int) -> List[Bytes]
/// Like split, each piece keeping its separator (bytes.SplitAfter).
fn (b: Bytes) split_after(sep: Bytes) -> List[Bytes]
/// At most n pieces, each keeping its separator (bytes.SplitAfterN).
fn (b: Bytes) split_after_n(sep: Bytes, n: Int) -> List[Bytes]
/// The bytes before and after the first sep (bytes.Cut), as views of b;
/// None when sep does not occur, and sep "" cuts at the start.
fn (b: Bytes) cut(sep: Bytes) -> (Bytes, Bytes)?
/// The rest of b after prefix (bytes.CutPrefix), a view of b; None when b
/// does not start with prefix, and prefix "" gives b.
fn (b: Bytes) cut_prefix(prefix: Bytes) -> Bytes?
/// b up to its suffix (bytes.CutSuffix), a view of b; None when b does not
/// end with suffix, and suffix "" gives b.
fn (b: Bytes) cut_suffix(suffix: Bytes) -> Bytes?
/// The runs of non-white-space bytes, split around runs of white space
/// (bytes.Fields, unicode.IsSpace); pieces are views of b.
fn (b: Bytes) fields() -> List[Bytes]
/// The runs of runes between runs of runes for which f is true
/// (bytes.FieldsFunc); pieces are views of b.
fn (b: Bytes) split_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> List[Bytes] ! E uses fx
/// b without its leading and trailing white space (bytes.TrimSpace,
/// unicode.IsSpace), a view of b; b itself when there is none.
fn (b: Bytes) trim() -> Bytes
/// b without the prefix p (bytes.TrimPrefix), a view of b; b itself when p
/// is not a prefix.
fn (b: Bytes) trim_prefix(p: Bytes) -> Bytes
/// b without the suffix p (bytes.TrimSuffix), a view of b; b itself when p
/// is not a suffix.
fn (b: Bytes) trim_suffix(p: Bytes) -> Bytes
/// b without its leading and trailing runes for which f is true, a view of
/// b like trim (bytes.TrimFunc).
fn (b: Bytes) trim_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b without its leading runes for which f is true, a view of b
/// (bytes.TrimLeftFunc).
fn (b: Bytes) trim_start_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b without its trailing runes for which f is true, a view of b
/// (bytes.TrimRightFunc).
fn (b: Bytes) trim_end_where[E, fx: Effects](f: fn(Rune) -> Bool ! E uses fx) -> Bytes ! E uses fx
/// b with every copy of old replaced by new (bytes.ReplaceAll); b itself,
/// not a copy, when nothing changes, since a Bytes is immutable.
fn (b: Bytes) replace(old: Bytes, new: Bytes) -> Bytes
/// b with the first n copies of old replaced by new; n below 0 for every
/// copy and 0 for none (bytes.Replace). b itself, not a copy, when
/// nothing changes.
fn (b: Bytes) replace_n(old: Bytes, new: Bytes, n: Int) -> Bytes
/// b lowered (bytes.ToLower): ASCII bytes the fast way, a rune outside
/// ASCII by Go's Unicode mapping, and each byte of an invalid sequence as
/// U+FFFD, as Go maps it; b itself when it is already in the case.
fn (b: Bytes) to_lower() -> Bytes
/// b raised (bytes.ToUpper), as to_lower.
fn (b: Bytes) to_upper() -> Bytes
/// f applied to every rune of b (bytes.Map); None (Go's negative mapping)
/// drops the rune, and b itself, not a copy, when nothing changes.
fn (b: Bytes) map_runes[E, fx: Effects](f: fn(Rune) -> Rune? ! E uses fx) -> Bytes ! E uses fx
/// Whether b and other are equal under Unicode simple case folding
/// (bytes.EqualFold, not only ASCII case); two bytes of invalid sequences
/// compare equal, as both decode to U+FFFD.
fn (b: Bytes) equal_fold(other: Bytes) -> Bool
/// n copies of b (bytes.Repeat); empty for n 0, and a fault for n below 0
/// as Go's bytes.Repeat, and past 4 GiB a fault.
fn (b: Bytes) repeat(n: Int) -> Bytes
/// Each byte of b with its offset, as List.indexed.
fn (b: Bytes) indexed() -> List[(Int, UInt8)]
/// n zero bytes (Go's make([]byte, n)); a fault for n < 0.
fn (static: Bytes) zeroed(n: Int) -> Bytes
/// s as a double quoted Xo and Go literal with escapes (Go's
/// strconv.Quote); an invalid byte is \xHH.
fn (s: Str) quote() -> Str
/// Go's Unquote: a "..." or '...' literal with Go's escapes, or a `...`
/// one; None when s is not one or the result is not UTF-8 (decision 0287).
fn (s: Str) unquote() -> Str?

/// Whether r is a decimal digit, category Nd (Go's unicode.IsDigit).
fn (r: Rune) is_digit() -> Bool
/// Whether r is a letter, category L (Go's unicode.IsLetter).
fn (r: Rune) is_letter() -> Bool
/// Whether r is white space: \t \n \v \f \r, space, U+0085, U+00A0 and
/// category Zs (Go's unicode.IsSpace).
fn (r: Rune) is_space() -> Bool
/// Whether r is an upper case letter (Go's unicode.IsUpper).
fn (r: Rune) is_upper() -> Bool
/// Whether r is a lower case letter (Go's unicode.IsLower).
fn (r: Rune) is_lower() -> Bool
/// Whether r is a title case letter (Go's unicode.IsTitle).
fn (r: Rune) is_title() -> Bool
/// Whether r is punctuation, category P (Go's unicode.IsPunct).
fn (r: Rune) is_punct() -> Bool
/// Whether r is a control character (Go's unicode.IsControl).
fn (r: Rune) is_control() -> Bool
/// Whether r is graphic: a letter, mark, number, punctuation, symbol or
/// Zs space (Go's unicode.IsGraphic).
fn (r: Rune) is_graphic() -> Bool
/// Whether r is a mark, category M (Go's unicode.IsMark).
fn (r: Rune) is_mark() -> Bool
/// Whether r is a symbol, category S (Go's unicode.IsSymbol).
fn (r: Rune) is_symbol() -> Bool
/// Whether r is a number, category N (Go's unicode.IsNumber).
fn (r: Rune) is_number() -> Bool
/// r in lower case (Go's unicode.ToLower); r itself when it has none.
fn (r: Rune) to_lower() -> Rune
/// r in upper case (Go's unicode.ToUpper); r itself when it has none.
fn (r: Rune) to_upper() -> Rune
/// The next rune of r's simple case folding orbit, the smallest one past
/// r, wrapping (Go's unicode.SimpleFold, decision 0595): 'A' gives 'a',
/// 'a' gives 'A', 'k' gives the Kelvin sign; r itself when it has none.
fn (r: Rune) simple_fold() -> Rune
/// r in title case (Go's unicode.ToTitle): the upper case of an ASCII
/// letter, `ǅ` for `Ǆ` and `ǆ`.
fn (r: Rune) to_title() -> Rune
/// The 1, 2, 3 or 4 bytes the rune takes in UTF-8 (utf8.RuneLen; a Rune
/// is a scalar value, so Go's -1 cannot happen, and Rune.try(n) is the
/// check on an Int).
fn (r: Rune) utf8_len() -> Int
/// Whether r is printable: a letter, mark, number, punctuation, symbol or
/// the ASCII space (Go's strconv.IsPrint).
fn (r: Rune) is_print() -> Bool
/// r as a single quoted literal: 'a', '\n', '\u2028' (Go's
/// strconv.QuoteRune).
fn (r: Rune) quote() -> Str

// ---------------------------------------------------------------------------
// List[T] (std.md 2.3). Higher order methods pass through the callback's
// effects and errors (std.md 2.3, core 6.2).

/// An empty list with room for n elements before it grows (decision
/// 0170): `[]` that pushes up to n without copying. n below 0 counts as 0.
fn (static: List[T]) with_capacity(n: Int) -> List[T]
/// The number of elements (Go's len).
fn (xs: List[T]) len() -> Int
/// Whether xs has no elements.
fn (xs: List[T]) is_empty() -> Bool
/// The element at i, or None when i is outside the list (xs[i] faults
/// instead).
fn (xs: List[T]) get(i: Int) -> T?
/// The first element, or None for an empty list.
fn (xs: List[T]) first() -> T?
/// The last element, or None for an empty list.
fn (xs: List[T]) last() -> T?
/// Whether an element equals x (Go's slices.Contains); T is Eq.
fn (xs: List[T]) contains(x: T) -> Bool
/// The index of the first element equal to x, or None (Go's slices.Index);
/// T is Eq.
fn (xs: List[T]) index_of(x: T) -> Int?
/// Each element with its index: `for (i, x) in xs.indexed()`.
fn (xs: List[T]) indexed() -> List[(Int, T)]
/// f of each element, in order; f's first error stops it and is returned.
fn (xs: List[T]) map[U, E, fx: Effects](f: fn(T) -> U ! E uses fx) -> List[U] ! E uses fx
/// The elements f accepts, in order.
fn (xs: List[T]) filter[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> List[T] ! E uses fx
/// f of every element, keeping the Some values in order (Rust's
/// filter_map): a map and a filter in one pass.
fn (xs: List[T]) filter_map[U, E, fx: Effects](f: fn(T) -> U? ! E uses fx) -> List[U] ! E uses fx
/// init combined with each element in order by f: `xs.fold(0, fn(s, x) {
/// s + x })` is the sum.
fn (xs: List[T]) fold[A, E, fx: Effects](init: A, f: fn(A, T) -> A ! E uses fx) -> A ! E uses fx
/// The first element f accepts, or None.
fn (xs: List[T]) find[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> T? ! E uses fx
/// Whether f accepts some element; stops at the first (Go's
/// slices.ContainsFunc). False for an empty list.
fn (xs: List[T]) any[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
/// Whether f accepts every element; stops at the first it rejects. True for
/// an empty list.
fn (xs: List[T]) all[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
/// A sorted copy of xs, ascending and stable; T is Ord (Go's
/// slices.SortStableFunc; a List[Int] uses slices.Sort's pdqsort).
fn (xs: List[T]) sort() -> List[T]
/// A copy of xs sorted by key(x), ascending and stable (Go's
/// slices.SortStableFunc comparing the keys).
fn (xs: List[T]) sort_by[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx
/// A stable sort of the receiver itself (decision 0374): it returns
/// nothing, and a list another binding shares is copied first the way
/// `push` and `set` copy one, so the other holder keeps its order. A
/// uniquely owned list is sorted in its own array with a scratch under one
/// list, where `sort` builds a whole second list.
fn (var xs: List[T]) sort_in_place()
/// Sorts xs itself by key(x), ascending and stable; returns nothing.
fn (var xs: List[T]) sort_in_place_by[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> () ! E uses fx
/// Sorted by the comparator, stable: equal elements keep their order (Go's
/// slices.SortStableFunc; decision 0586). A comparator that is not a strict
/// weak order gives some permutation, never a fault. The first error the
/// comparator returns stops the sort and is returned.
fn (xs: List[T]) sort_with[E, fx: Effects](cmp: fn(T, T) -> Ordering ! E uses fx) -> List[T] ! E uses fx
/// Sorts xs itself by the comparator, stable, as sort_with; returns nothing.
fn (var xs: List[T]) sort_in_place_with[E, fx: Effects](cmp: fn(T, T) -> Ordering ! E uses fx) -> () ! E uses fx
/// Sorted by key from greatest to least, stable (no key negation, so
/// `Int.min` and Str keys work; decision 0586).
fn (xs: List[T]) sort_by_desc[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> List[T] ! E uses fx
/// Sorts xs itself by key from greatest to least, stable; returns nothing.
fn (var xs: List[T]) sort_in_place_by_desc[K: Ord, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> () ! E uses fx
/// The elements grouped by key(x): keys in order of first appearance, each
/// group in input order.
fn (xs: List[T]) group_by[K: Hash, E, fx: Effects](key: fn(T) -> K ! E uses fx) -> List[(K, List[T])] ! E uses fx
/// A copy of xs with a buffer of its own (Go's slices.Clone, decision
/// 0592). Assignment already copies a List, shared until one is written
/// (core 5.1); clone gives the copy its storage at once.
fn (xs: List[T]) clone() -> List[T]
/// The lists joined in order in one new list (Go's slices.Concat,
/// decision 0592): `List.concat([a, b, c])`, sized once where `a + b + c`
/// copies a + b again.
fn (static: List[T]) concat(lists: List[List[T]]) -> List[T]
/// Where x is in a list sorted by the Ord of T, or where it would go, and
/// whether it is there (Go's slices.BinarySearch, decision 0592): the
/// first index whose element is not below x.
fn (xs: List[T]) binary_search(x: T) -> (Int, Bool)
/// The largest element by the Ord of T, or None for an empty list (Go's
/// slices.Max, which panics there, decision 0592); the first of equal
/// ones; a NaN Float makes the result NaN, as Go's does.
fn (xs: List[T]) max() -> T?
/// The smallest element, as max (Go's slices.Min).
fn (xs: List[T]) min() -> T?
/// A copy of xs in reverse order (Go's slices.Reverse on a clone).
fn (xs: List[T]) reverse() -> List[T]
/// The distinct elements as a set, in order of first appearance.
fn (xs: List[T]) to_set() -> Set[T]
/// The strings joined with sep between them (Go's strings.Join).
fn (xs: List[Str]) join(sep: Str) -> Str

/// Appends x (Go's append); amortized O(1).
fn (var xs: List[T]) push(x: T)
/// Removes and returns the last element, or None for an empty list.
fn (var xs: List[T]) pop() -> T?
/// Inserts x before index i, 0 to len() (Go's slices.Insert); a fault
/// outside that.
fn (var xs: List[T]) insert(i: Int, x: T)
/// Removes and returns the element at i, shifting the rest down (Go's
/// slices.Delete); a fault outside the list.
fn (var xs: List[T]) remove_at(i: Int) -> T
/// Replaces the element at i with x, as `xs[i] = x`; a fault outside the
/// list.
fn (var xs: List[T]) set(i: Int, x: T)
/// A binary min heap in the list, as Go's container/heap keeps one in a
/// slice by the Ord of T (decision 0410): `heap_push` adds x and restores
/// the order, `heap_pop` removes and returns the least element (the first
/// of the list, None for an empty list), `heap_remove(i)` removes and
/// returns the element at index i (a fault outside the list), `heap_fix(i)`
/// restores the order after the element at i changed (set, then fix), and
/// `heapify` makes any list a heap. Each is O(log n), heapify O(n). A
/// priority queue by a key is a heap of (key, value) pairs.
fn (var xs: List[T]) heap_push(x: T)
/// Removes and returns the least element of the heap xs, or None when it is
/// empty (Go's heap.Pop).
fn (var xs: List[T]) heap_pop() -> T?
/// Removes and returns the element at i of the heap xs (Go's heap.Remove);
/// a fault outside the list.
fn (var xs: List[T]) heap_remove(i: Int) -> T
/// Restores the heap order after the element at i changed (Go's heap.Fix).
fn (var xs: List[T]) heap_fix(i: Int)
/// Reorders xs into a binary min heap (Go's heap.Init).
fn (var xs: List[T]) heapify()

// ---------------------------------------------------------------------------
// Map[K, V] and Set[T] (std.md 2.4)

/// The number of entries (Go's len).
fn (m: Map[K, V]) len() -> Int
/// Whether m has no entries.
fn (m: Map[K, V]) is_empty() -> Bool
/// The value at k, or None (Go's v, ok := m[k]).
fn (m: Map[K, V]) get(k: K) -> V?
/// The value at k; a fault naming k and reason when it is missing (for a
/// key that must be there).
fn (m: Map[K, V]) get_or_fault(k: K, reason: Str) -> V
/// Whether k has an entry.
fn (m: Map[K, V]) contains(k: K) -> Bool
/// The keys in insertion order.
fn (m: Map[K, V]) keys() -> List[K]
/// The values in insertion order of their keys.
fn (m: Map[K, V]) values() -> List[V]
/// The (key, value) pairs in insertion order.
fn (m: Map[K, V]) entries() -> List[(K, V)]
/// The entries f accepts, in insertion order.
fn (m: Map[K, V]) filter[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Map[K, V] ! E uses fx
/// Every key with f's value, in the map's insertion order.
fn (m: Map[K, V]) map[U, E, fx: Effects](f: fn(K, V) -> U ! E uses fx) -> Map[K, U] ! E uses fx
/// Whether f holds for some entry, in insertion order, stopping at the first.
fn (m: Map[K, V]) any[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx
/// Whether f holds for every entry, in insertion order, stopping at the first that fails.
fn (m: Map[K, V]) all[E, fx: Effects](f: fn(K, V) -> Bool ! E uses fx) -> Bool ! E uses fx

/// Stores v at k, as `m[k] = v`; an existing key keeps its position.
fn (var m: Map[K, V]) put(k: K, v: V)
/// Puts every entry of other into m, other's value winning for a key
/// both have (Go's maps.Copy(m, other)); a key m had keeps its position,
/// new keys follow in other's order (decision 0592).
fn (var m: Map[K, V]) extend(other: Map[K, V])
/// A copy of m with a table of its own (Go's maps.Clone). Assigning a Map
/// already copies it (core 5.1, shared until one is written); clone gives
/// the copy its storage at once, as Str.clone does (decision 0592).
fn (m: Map[K, V]) clone() -> Map[K, V]
/// Removes k and returns its value, or None when it had none (Go's
/// delete).
fn (var m: Map[K, V]) remove(k: K) -> V?
/// Runs f on the value at k (init when missing), stores what f left and
/// returns f's result: `by.update(n, [], fn(var ids) { ids.push(i) })`.
fn (var m: Map[K, V]) update[R, E, fx: Effects](k: K, init: V, f: fn(var V) -> R ! E uses fx) -> R ! E uses fx

/// The number of elements.
fn (s: Set[T]) len() -> Int
/// Whether s has no elements.
fn (s: Set[T]) is_empty() -> Bool
/// Whether x is in s.
fn (s: Set[T]) contains(x: T) -> Bool
/// The elements in s or o: s's in order, then o's new ones.
fn (s: Set[T]) union(o: Set[T]) -> Set[T]
/// The elements in both s and o, in s's order.
fn (s: Set[T]) intersect(o: Set[T]) -> Set[T]
/// The elements of s not in o, in s's order.
fn (s: Set[T]) difference(o: Set[T]) -> Set[T]
/// Whether every element of s is in o (the empty set is a subset of every set).
fn (s: Set[T]) is_subset(o: Set[T]) -> Bool
/// Whether s and o share an element; stops at the first one and allocates nothing.
fn (s: Set[T]) intersects(o: Set[T]) -> Bool
/// The elements in insertion order.
fn (s: Set[T]) to_list() -> List[T]
/// Whether f accepts some element; stops at the first.
fn (s: Set[T]) any[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
/// Whether f accepts every element; stops at the first it rejects.
fn (s: Set[T]) all[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Bool ! E uses fx
/// The elements f accepts, in insertion order.
fn (s: Set[T]) filter[E, fx: Effects](f: fn(T) -> Bool ! E uses fx) -> Set[T] ! E uses fx
/// The set of f of each element; equal results collapse into one.
fn (s: Set[T]) map[U, E, fx: Effects](f: fn(T) -> U ! E uses fx) -> Set[U] ! E uses fx
/// Adds x; nothing changes when it is already in s.
fn (var s: Set[T]) add(x: T)
/// Removes x and returns whether it was in s.
fn (var s: Set[T]) remove(x: T) -> Bool

// ---------------------------------------------------------------------------
// Option[T] and Result[T, E] (std.md 2.5)

/// Whether o holds a value.
fn (o: Option[T]) is_some() -> Bool
/// Whether o is None.
fn (o: Option[T]) is_none() -> Bool
/// Ok of o's value, or Err(e) for None, to turn a missing value into an
/// error for `?`.
fn (o: Option[T]) or_err[E](e: E) -> Result[T, E]
/// Some(f(v)) for Some(v), None for None.
fn (o: Option[T]) map[U, fx: Effects](f: fn(T) -> U uses fx) -> U? uses fx
/// f(v) for Some(v), None for None: chains steps that may each give None.
fn (o: Option[T]) and_then[U, fx: Effects](f: fn(T) -> U? uses fx) -> U? uses fx
/// o's value; a fault with msg on None (for a value that must be there).
fn (o: Option[T]) or_fault(msg: Str) -> T

/// Whether r is Ok.
fn (r: Result[T, E]) is_ok() -> Bool
/// Whether r is Err.
fn (r: Result[T, E]) is_err() -> Bool
/// Ok(f(v)) for Ok(v); an Err as it is.
fn (r: Result[T, E]) map[U, fx: Effects](f: fn(T) -> U uses fx) -> Result[U, E] uses fx
/// Err(f(e)) for Err(e); an Ok as it is (wraps an error, as Go's
/// fmt.Errorf with %w).
fn (r: Result[T, E]) map_err[F, fx: Effects](f: fn(E) -> F uses fx) -> Result[T, F] uses fx
/// The Ok value, or None for an Err (the error is dropped).
fn (r: Result[T, E]) ok() -> T?
/// The Err value, or None for an Ok.
fn (r: Result[T, E]) err() -> E?
/// The Ok value; a fault with msg and the error on Err.
fn (r: Result[T, E]) or_fault(msg: Str) -> T
/// The only way to discard an error (core 2.6): yields the success value or
/// None, and logs the error with the reason at debug level.
fn (r: Result[T, E]) ignore_err(reason: Str) -> T?

// ---------------------------------------------------------------------------
// Duration and Time (std.md 2.6). Operators are builtin (core 2.1).

/// s seconds, rounded to the nearest nanosecond.
fn (static: Duration) from_secs(s: Float) -> Duration
/// Whole seconds; the same as `1s * s` (std.md 2.6).
fn (static: Duration) from_secs_int(s: Int) -> Duration
/// ms milliseconds (Go's time.Duration(ms) * time.Millisecond).
fn (static: Duration) from_millis(ms: Int) -> Duration
/// ns nanoseconds (Go's time.Duration(ns)).
fn (static: Duration) from_nanos(ns: Int) -> Duration
/// Go's time.ParseDuration syntax after trimming white space: a signed
/// sequence of decimal numbers with units ns, us (or µs), ms, s, m, h,
/// such as "1.5s", "-2h45m", "300ms"; "0" alone is zero (std.md 2.6).
fn (static: Duration) parse(s: Str) -> Duration ! DurationErr
/// d in seconds with the fraction (Go's Duration.Seconds, to the bit).
fn (d: Duration) seconds() -> Float
/// d in whole milliseconds, truncated (Go's Duration.Milliseconds).
fn (d: Duration) millis() -> Int
/// d in nanoseconds (Go's Duration.Nanoseconds).
fn (d: Duration) nanos() -> Int
/// d times f, rounded to the nearest nanosecond.
fn (d: Duration) scale(f: Float) -> Duration
/// d in whole seconds, rounded up (for a Retry-After or a timeout in
/// seconds).
fn (d: Duration) ceil_seconds() -> Int
/// The absolute value of d (Go's Duration.Abs); durations may be negative.
fn (d: Duration) abs() -> Duration
/// Go's Duration.Round: d rounded to the nearest multiple of m, halfway
/// values away from zero; d itself when m <= 0, and the largest or
/// smallest Duration when the result would overflow.
fn (d: Duration) round(m: Duration) -> Duration
/// Go's Duration.Truncate: d rounded toward zero to a multiple of m; d
/// itself when m <= 0.
fn (d: Duration) truncate(m: Duration) -> Duration

/// The error of `Duration.parse`: the text that is not a duration.
struct DurationErr {
  input: Str
}
/// `invalid duration "1x": ` and what a duration looks like.
fn (e: DurationErr) display() -> Str

/// 1970-01-01T00:00:00Z (Go's time.Unix(0, 0)); written `Time.UNIX_EPOCH`,
/// a constant.
fn (static: Time) UNIX_EPOCH() -> Time
/// The time secs seconds after the Unix epoch (Go's time.Unix(secs, 0)).
fn (static: Time) from_unix(secs: Int) -> Time
/// The time ms milliseconds after the Unix epoch (Go's time.UnixMilli).
fn (static: Time) from_unix_millis(ms: Int) -> Time
/// The time us microseconds after the Unix epoch (Go's time.UnixMicro,
/// decision 0595).
fn (static: Time) from_unix_micros(us: Int) -> Time
/// The time ns nanoseconds after the Unix epoch (Go's time.Unix(0, ns),
/// decision 0595).
fn (static: Time) from_unix_nanos(ns: Int) -> Time
/// The time of RFC 3339 text (Go's time.Parse(time.RFC3339Nano, s)), or
/// None for other text or a time outside 1677-09-21 to 2262-04-11.
fn (static: Time) parse_rfc3339(s: Str) -> Time?
/// The offset an RFC 3339 text carries (`Z` and `+00:00` are zero; Go's Zone() of time.Parse), or None
/// when `parse_rfc3339` refuses the text. A `Time` is an instant, so this is how a caller keeps `+01:00`.
fn (static: Time) rfc3339_offset(s: Str) -> Duration?
/// Seconds since the Unix epoch (Go's Time.Unix).
fn (t: Time) unix() -> Int
/// Milliseconds since the Unix epoch (Go's Time.UnixMilli).
fn (t: Time) unix_millis() -> Int
/// Microseconds since the Unix epoch, rounded down (Go's Time.UnixMicro,
/// decision 0595).
fn (t: Time) unix_micros() -> Int
/// Nanoseconds since the Unix epoch (Go's Time.UnixNano, decision 0595).
fn (t: Time) unix_nanos() -> Int
/// The nanoseconds within t's second, 0 to 999999999 (Go's
/// Time.Nanosecond; the same in every zone, decision 0595).
fn (t: Time) nanosecond() -> Int
/// t as RFC 3339 text in UTC, as t displays.
fn (t: Time) format_rfc3339() -> Str

// ---------------------------------------------------------------------------
// Concurrency and state types (std.md 2.7, core 5.4, 7)

/// A channel with room for cap values; 0 is unbuffered (Go's make(chan T,
/// cap)).
fn (static: Chan[T]) new(cap: Int = 0) -> Chan[T]
/// Sends x, waiting while the channel is full; a cancellation point.
fn (c: Chan[T]) send(x: T)
/// The next value, waiting for one; None when the channel is closed and
/// drained. A cancellation point.
fn (c: Chan[T]) recv() -> T?
/// Sends x if there is room; false when the channel is full or closed.
/// Never waits.
fn (c: Chan[T]) try_send(x: T) -> Bool
/// The next value if one is ready, else None. Never waits.
fn (c: Chan[T]) try_recv() -> T?
/// Closes the channel: receivers drain what is left, then get None.
fn (c: Chan[T]) close()
/// The number of values waiting in the buffer.
fn (c: Chan[T]) len() -> Int

/// A mutex guarding v; the value is reached only through with and
/// with_read.
fn (static: Mutex[T]) new(v: T) -> Mutex[T]
/// Runs f with the value locked for writing, keeps what f leaves in it, and
/// returns f's result. A fault in f poisons the mutex (core 5.4).
fn (m: Mutex[T]) with[R, E, fx: Effects](f: fn(var T) -> R ! E uses fx) -> R ! E uses fx
/// Shared read only access (decision 0063): many readers or one writer.
fn (m: Mutex[T]) with_read[R, E, fx: Effects](f: fn(T) -> R ! E uses fx) -> R ! E uses fx
/// Stores v and clears the poison a fault inside `with` left (decision 0482).
fn (m: Mutex[T]) reset(v: T)

/// An atomic holding v; T is Int or Bool (Go's sync/atomic).
fn (static: Atomic[T]) new(v: T) -> Atomic[T]
/// The current value (Go's atomic Load).
fn (a: Atomic[T]) get() -> T
/// Stores v (Go's atomic Store).
fn (a: Atomic[T]) set(v: T)
/// Adds n and returns the new value (Go's atomic Add).
fn (a: Atomic[Int]) add(n: Int) -> Int
/// Stores n when it is larger and returns the value then held.
fn (a: Atomic[Int]) max(n: Int) -> Int
/// Stores v and returns the old value (Go's atomic Swap).
fn (a: Atomic[T]) swap(v: T) -> T
/// Stores new if the value is old and returns whether it did (Go's
/// atomic CompareAndSwap).
fn (a: Atomic[T]) compare_and_swap(old: T, new: T) -> Bool

/// The handle bound by `scope s { ... }` (core 7.1). The only way to start a
/// task.
struct Scope {}
/// Starts f as a foreground task of the scope; the scope waits for it. The
/// handle's `await` gives f's result.
fn (s: Scope) spawn[T, E, fx: Effects](f: fn() -> T ! E uses fx) -> Task[T, E] uses fx
/// Starts f as a background task (a daemon), cancelled when the scope's
/// body finishes.
fn (s: Scope) spawn_background[T, E, fx: Effects](f: fn() -> T ! E uses fx) -> Task[T, E] uses fx
/// Cancels every task of the scope (not the body).
fn (s: Scope) cancel()
/// A storable handle whose tasks belong to this scope (core 7.1).
fn (s: Scope) group() -> task.Group

struct Task[T, E] {}
/// Written `t.await`, without parentheses.
fn (t: Task[T, E]) await() -> T ! E

/// An empty buffer that collects a list with amortized O(1) pushes.
fn (static: Buf[T]) new() -> Buf[T]
/// An empty buffer with room for n items before it grows.
fn (static: Buf[T]) with_capacity(n: Int) -> Buf[T]
/// Appends x.
fn (var b: Buf[T]) push(x: T)
/// The number of items pushed.
fn (b: Buf[T]) len() -> Int
/// The items as a list, without a copy; it moves b.
/// @moves
fn (b: Buf[T]) freeze() -> List[T]

/// An empty builder of a Str (Go's strings.Builder).
fn (static: StrBuilder) new() -> StrBuilder
/// Appends s (amortized O(1), where `out = out + s` copies out).
fn (var b: StrBuilder) write(s: Str)
/// The length in bytes of what has been written.
fn (b: StrBuilder) len() -> Int
/// What has been written as a Str, without a copy; it moves b.
/// @moves
fn (b: StrBuilder) freeze() -> Str

/// An empty builder of Bytes (Go's bytes.Buffer used for writes).
fn (static: BytesBuilder) new() -> BytesBuilder
/// An empty builder with room for n bytes before it grows.
fn (static: BytesBuilder) with_capacity(n: Int) -> BytesBuilder
/// Appends data.
fn (var b: BytesBuilder) write(data: Bytes)
/// Appends one byte.
fn (var b: BytesBuilder) write_byte(x: UInt8)
/// Appends s's UTF-8 bytes.
fn (var b: BytesBuilder) write_str(s: Str)
/// Appends r's UTF-8 encoding.
fn (var b: BytesBuilder) write_rune(r: Rune)
/// Overwrites the n (1, 2, 4 or 8) bytes at..at + n in place with v's low n
/// bytes, lowest first (Go's binary.LittleEndian.PutUint32); a fault for
/// another n or a range outside len().
fn (var b: BytesBuilder) put_le(at: Int, v: Int, n: Int)
/// Overwrites the n (1, 2, 4 or 8) bytes at..at + n in place with v's low n
/// bytes, highest first (Go's binary.BigEndian.PutUint32); a fault for
/// another n or a range outside len().
fn (var b: BytesBuilder) put_be(at: Int, v: Int, n: Int)
/// Appends v's low n (0 to 8) bytes, lowest first (Go's
/// binary.LittleEndian.AppendUint64 cut to n); a fault for another n.
fn (var b: BytesBuilder) write_le(v: Int, n: Int)
/// Appends v's low n (0 to 8) bytes, highest first (Go's
/// binary.BigEndian.AppendUint64 cut to n); a fault for another n.
fn (var b: BytesBuilder) write_be(v: Int, n: Int)
/// The number of bytes written.
fn (b: BytesBuilder) len() -> Int
/// What has been written as Bytes, without a copy; it moves b.
/// @moves
fn (b: BytesBuilder) freeze() -> Bytes

/// Replaces several strings in one pass (Go's strings.Replacer, decision
/// 0594): at each position the first pair, in the order given, whose old
/// starts there is replaced, and the scan goes on after it, so a
/// replacement is never rescanned. An empty old matches at every byte
/// position and at the end. Build one and keep it: new picks Go's
/// algorithm for the pairs (one pair, single bytes, or by first byte).
struct Replacer {}

/// A replacer of the pairs (old, new), earlier pairs first (Go's
/// strings.NewReplacer).
fn (static: Replacer) new(pairs: List[(Str, Str)]) -> Replacer
/// s with the pairs replaced (Replacer.Replace); s itself, not a copy,
/// when nothing changes.
fn (r: Replacer) replace(s: Str) -> Str

/// Bytes appended at the back and consumed from the front (Go's
/// bytes.Buffer, decision 0480): records cut from bytes that arrive in
/// pieces cost time linear in their size. peek, next and read_until
/// return views that stay valid after later writes.
/// @move_only
struct ByteBuffer {}

/// An empty buffer (Go's bytes.Buffer).
fn (static: ByteBuffer) new() -> ByteBuffer
/// An empty buffer; n is a hint and may be ignored.
fn (static: ByteBuffer) with_capacity(n: Int) -> ByteBuffer
/// Appends data at the back, without a copy.
fn (var b: ByteBuffer) write(data: Bytes)
/// The number of unread bytes.
fn (b: ByteBuffer) len() -> Int
/// Up to n unread bytes, not consumed (n is clamped to 0..len()).
fn (b: ByteBuffer) peek(n: Int) -> Bytes
/// Up to n unread bytes, consumed (Go's Buffer.Next; n is clamped to
/// 0..len()).
fn (var b: ByteBuffer) next(n: Int) -> Bytes
/// The unread bytes through the first delim, consumed; None, consuming
/// nothing, when delim has not arrived (Go's Buffer.ReadBytes).
fn (var b: ByteBuffer) read_until(delim: UInt8) -> Bytes?
/// Consumes up to n unread bytes.
fn (var b: ByteBuffer) discard(n: Int)
/// The offset of sub in the unread bytes, or None (Go's bytes.Index on
/// Buffer.Bytes()).
fn (b: ByteBuffer) find(sub: Bytes) -> Int?

/// Wraps v so it prints as `<redacted>` in every output: interpolation,
/// Debug, logs and crash bundles (core 2.1). reveal gives it back.
fn (static: Secret[T]) new(v: T) -> Secret[T]
/// The wrapped value.
fn (s: Secret[T]) reveal() -> T

// ---------------------------------------------------------------------------
// Capabilities (std.md 3, core 6.3)

struct Os {
  net: Net
  fs: Fs
  clock: Clock
  rand: Rand
  env: Env
  proc: Proc
  stdio: Stdio
  /// The user's secret stores (decision 0584).
  secrets: Secrets
  /// Program lifetime task group (core 6.3, 7.1).
  tasks: task.Group
}

enum FsErr {
  NotFound(path: Str)
  Exists(path: Str)
  NotEmpty(path: Str)
  NotDir(path: Str)
  IsDir(path: Str)
  Denied(path: Str)
  Io(path: Str, msg: Str)
  Canceled
}

/// Plain text (decision 0358): `PATH: no such file or directory`.
fn (e: FsErr) display() -> Str

struct FileInfo {
  name: Str
  path: Str
  is_dir: Bool
  size: Int
  modified: Time
  /// The entry is a symbolic link itself (std.md 3.1): read_dir and
  /// walk report a link (Go's os.Lstat, DirEntry.Type), stat follows
  /// it and reports the target, so is false there.
  is_symlink: Bool = false
}

/// The space of the file system holding a path (Fs.disk_usage, decision
/// 0426; Go's syscall.Statfs, GetDiskFreeSpaceEx on Windows).
struct DiskUsage {
  /// Bytes in the file system.
  total: Int
  /// Bytes free, a superuser's reserve included.
  free: Int
  /// Bytes free to this user.
  available: Int
  /// Inodes (0 on Windows, which has none).
  files: Int
  /// Free inodes (0 on Windows).
  files_free: Int
}

interface Fs {
  fn sub(self, dir: Str) -> Fs
  fn cwd(self) -> Fs
  /// The working directory as an absolute path with / separators, from
  /// the OS (getcwd), not $PWD (std.md 3.1, decision 0218).
  fn cwd_path(self) -> Str ! FsErr
  fn read_only(self) -> Fs
  fn write_only(self) -> Fs
  fn case_sensitive(self) -> Bool
  fn stat(self, path: Str) -> FileInfo? ! FsErr uses fs.read
  fn exists(self, path: Str) -> Bool ! FsErr uses fs.read
  /// The space of the file system holding path (decision 0426).
  fn disk_usage(self, path: Str) -> DiskUsage ! FsErr uses fs.read
  fn read(self, path: Str) -> Bytes ! FsErr uses fs.read
  fn read_text(self, path: Str) -> Str ! FsErr uses fs.read
  fn read_dir(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn walk(self, dir: Str) -> List[FileInfo] ! FsErr uses fs.read
  fn write(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  fn create_temp(self, dir: Str, prefix: Str) -> Str ! FsErr uses fs.write
  fn rename(self, from: Str, to: Str) -> () ! FsErr uses fs.write
  fn remove(self, path: Str) -> () ! FsErr uses fs.write
  fn remove_all(self, path: Str) -> () ! FsErr uses fs.write
  fn create_dir_all(self, dir: Str) -> () ! FsErr uses fs.write
  fn set_modified(self, path: Str, t: Time) -> () ! FsErr uses fs.write
  /// A handle that reads the file as a stream (std.md 3.1, decision 0163).
  fn open(self, path: Str) -> File ! FsErr uses fs.read
  /// A handle that writes the file, created or truncated.
  fn create(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes at the end of the file, created if missing.
  fn open_append(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that reads and writes the file, created if missing and not
  /// truncated (Go's os.OpenFile with O_RDWR|O_CREATE). Reads are not
  /// buffered: `read` and `write` share one position, as Go's File.
  fn open_rw(self, path: Str) -> File ! FsErr uses fs.write
  /// A handle that writes a new file: Exists(path) when something is
  /// already at path (O_EXCL; a symbolic link counts, dangling or not).
  fn create_new(self, path: Str) -> File ! FsErr uses fs.write
  /// Adds data at the end of the file, created if missing.
  fn append(self, path: Str, data: Bytes) -> () ! FsErr uses fs.write
  /// Copies the contents and permission bits of a file.
  fn copy(self, from: Str, to: Str) -> () ! FsErr uses fs
  /// The permission bits, 0o644 style.
  fn mode(self, path: Str) -> Int ! FsErr uses fs.read
  fn set_mode(self, path: Str, mode: Int) -> () ! FsErr uses fs.write
  /// Creates a symbolic link at `link` that points to `target`.
  fn symlink(self, target: Str, link: Str) -> () ! FsErr uses fs.write
  /// The target of a symbolic link; None when path is not one.
  fn read_link(self, path: Str) -> Str? ! FsErr uses fs.read
  /// The paths that match pattern (`*`, `?`, `[a-z]`, `**`), sorted.
  fn glob(self, pattern: Str) -> List[Str] ! FsErr uses fs.read
  /// An advisory lock on the file (created if missing); waits for it.
  fn lock(self, path: Str) -> FileLock ! FsErr uses fs.write
  /// The lock if no one holds it, else None at once.
  fn try_lock(self, path: Str) -> FileLock? ! FsErr uses fs.write
}

/// Creates dir and every missing parent as create_dir_all does, then
/// gives each directory it created the permission bits mode exactly
/// (no umask), deepest first so a mode without write or search still
/// applies; directories already there keep theirs, as Go's MkdirAll
/// (std.md 3.1). A free function, not a method of Fs.
fn create_dir_all_mode(fs: Fs, dir: Str, mode: Int) -> () ! FsErr uses fs

/// What walk_dir's visit asks for next (Go's fs.WalkDirFunc results:
/// nil, fs.SkipDir, fs.SkipAll).
enum WalkStep {
  /// Go on: into a directory, else to the next entry.
  Continue
  /// On a directory, skip its contents; on a file, the rest of the
  /// files in its directory.
  SkipDir
  /// End the walk; walk_dir returns Ok.
  Stop
}

/// Calls visit for each entry under dir, parents before children and
/// siblings by name, without following symbolic links (Go's
/// filepath.WalkDir), and lets visit skip a directory or stop the walk;
/// the result is every entry visit was called on, in order (a closure
/// cannot add to a captured list, core 3.7), so the list holds every
/// visited entry: on a huge tree, return SkipDir or Stop, or do the work
/// in visit, and drop the result (std.md 3.1). Two differences
/// from Go: dir itself is not visited (as walk), and the first error
/// (reading a directory) ends the walk with that error, where Go hands it
/// to the function. A free function, not a method of Fs, so every type
/// that satisfies Fs still does.
fn walk_dir[fx: Effects](fs: Fs, dir: Str, visit: fn(FileInfo) -> WalkStep uses fx) -> List[FileInfo] ! FsErr uses (fs.read, fx)

/// A directory entry with the name and the type the directory itself
/// gives and no stat (Go's fs.DirEntry, decision 0483): read_dir_entries,
/// walk_entries and walk_dir_entries return them, `info` is the stat.
struct DirEntry {
  name: Str
  /// Relative to the capability root, as FileInfo.path.
  path: Str
  /// A directory; a symbolic link is not followed.
  is_dir: Bool
  /// A symbolic link itself.
  is_symlink: Bool = false
}

/// The FileInfo of the entry, a stat now (Go's DirEntry.Info, an lstat):
/// NotFound when the entry was removed since the listing.
fn (e: DirEntry) info(fs: Fs) -> FileInfo ! FsErr uses fs.read

/// The entries of dir by name with no stat of any, as read_dir's order
/// (Go's os.ReadDir). A free function, not a method of Fs, so every type
/// that satisfies Fs still does.
fn read_dir_entries(fs: Fs, dir: Str) -> List[DirEntry] ! FsErr uses fs.read

/// Every entry under dir, as walk's order, with no stat of any.
fn walk_entries(fs: Fs, dir: Str) -> List[DirEntry] ! FsErr uses fs.read

/// walk_dir with DirEntry: no stat of any entry unless visit calls info.
fn walk_dir_entries[fx: Effects](fs: Fs, dir: Str, visit: fn(DirEntry) -> WalkStep uses fx) -> List[DirEntry] ! FsErr uses (fs.read, fx)

/// The text of the file at path, or default when it does not exist
/// (FsErr.NotFound); any other error is the result (std.md 3.1). A free
/// function, not a method of Fs, so every type that satisfies Fs still does.
fn read_text_or(fs: Fs, path: Str, default: Str) -> Str ! FsErr uses fs.read
/// The bytes of the file at path, or default when it does not exist.
fn read_or(fs: Fs, path: Str, default: Bytes) -> Bytes ! FsErr uses fs.read
/// The bytes of the file at path, as fs.read(path) gives them, with the
/// same errors (decision 0402). On the native linux and darwin backends
/// it may share the file's pages instead of copying them: the program
/// must not truncate the file or change it in place while the Bytes (or
/// a slice of it) is alive; replacing it by rename is safe. Where mapping
/// is not possible it is read. Use read for a file other processes may
/// change in place. A free function, not a method of Fs, so every type
/// that satisfies Fs still does.
fn read_mapped(fs: Fs, path: Str) -> Bytes ! FsErr uses fs.read
/// Replaces the file at path with data so that a reader, or the file after
/// a crash, holds the old contents or the new, never a part: written to a
/// temporary file in path's directory, synced, given path's permission
/// bits (0o644 for a new file), renamed over path, and the directory
/// synced where the OS allows it (std.md 3.1). Atomic only within one
/// file system, which the temporary file beside path ensures.
fn write_atomic(fs: Fs, path: Str, data: Bytes) -> () ! FsErr uses fs

/// Where `File.seek` counts from (Go's io.SeekStart, SeekCurrent,
/// SeekEnd; decision 0600).
enum Whence {
  /// From the start of the file.
  Start
  /// From the position the program has read or written to.
  Current
  /// From the end of the file.
  End
}

/// An open file (std.md 3.1, decision 0163). A handle; close it.
struct File {}
/// At most max bytes; None at the end.
fn (f: File) read(max: Int) -> Bytes? ! FsErr uses fs.read
/// At most max bytes at offset, whatever the position: None at or past
/// the end (Go's os.File.ReadAt, one call, a short read allowed); the
/// handle's position and reads are unaffected. A wasm build answers
/// "function not implemented".
fn (f: File) read_at(offset: Int, max: Int) -> Bytes? ! FsErr uses fs.read
/// One line without `\n` or `\r\n`; None at the end.
fn (f: File) read_line() -> Str? ! FsErr uses fs.read
/// Writes all of data at the position (Go's os.File.Write).
fn (f: File) write(data: Bytes) -> () ! FsErr uses fs.write
/// Writes all of data at offset of a file made by `create`, whatever the
/// position, which the call leaves alone (Go's os.File.WriteAt: the file
/// grows, a gap reads as zero bytes); an error on a file from
/// `open_append`. A wasm build answers "function not implemented".
fn (f: File) write_at(offset: Int, data: Bytes) -> () ! FsErr uses fs.write
/// Moves the position to offset counted from whence and returns it from
/// the start (Go's os.File.Seek, decision 0600): `Current` counts from
/// what the program has read (buffered bytes not yet returned are not
/// past it), `seek(0, Whence.End)` is the size. A position before the
/// start is an error (`invalid argument`); past the end is allowed (a
/// write there leaves a gap that reads as zero bytes). On a file from
/// `open_append` a write still goes to the end. A wasm build answers
/// "function not implemented".
fn (f: File) seek(offset: Int, whence: Whence = Whence.Start) -> Int ! FsErr uses fs.read
/// Sets the size of a file made by `create` (Go's os.File.Truncate: shorter
/// cuts it, longer pads with zero bytes); the position is unchanged. A
/// wasm build answers "function not implemented".
fn (f: File) truncate(size: Int) -> () ! FsErr uses fs.write
/// The name, size and modification time of the open file, from its handle
/// (Go's os.File.Stat), so a file replaced or renamed since it was opened
/// is not confused with its path. A wasm build answers "function not
/// implemented".
fn (f: File) stat() -> FileInfo ! FsErr uses fs.read
/// Commits what was written to stable storage (Go's File.Sync: fsync,
/// F_FULLFSYNC on macOS, FlushFileBuffers on Windows).
fn (f: File) sync() -> () ! FsErr uses fs.write
/// Closes the file; closing it again does nothing.
fn (f: File) close() -> () ! FsErr
/// Copies the file from its position to its end into dst, 32 KiB at a
/// time (Go's io.Copy(conn, file), decision 0593); the bytes copied.
fn (f: File) copy_to(dst: Stream) -> Int ! CopyErr[FsErr, NetErr] uses (fs.read, net)
/// Copies src until it ends into the file at its position (Go's
/// io.Copy(file, conn), decision 0593); the bytes copied.
fn (f: File) copy_from(src: Stream) -> Int ! CopyErr[NetErr, FsErr] uses (fs.write, net)

/// A held advisory file lock (std.md 3.1). A handle.
struct FileLock {}
/// Releases the lock; unlocking again does nothing.
fn (l: FileLock) unlock()

enum NetErr {
  InvalidAddr(msg: Str)
  Refused
  Timeout
  Io(msg: Str)
  Canceled
  /// The address is outside an attenuated Net (`Net.only`, decision 0156).
  Denied(addr: Str)
}

/// Plain text (decision 0358): `connection refused`, `i/o timeout`, the
/// message of an Io, `denied by Net.only: ADDR`.
fn (e: NetErr) display() -> Str

struct Listener {}
/// The bound address, `host:port`, with the port the system chose for
/// `:0` (std.md 3.2).
fn (l: Listener) addr() -> Str
/// Waits for the next connection (std.md 3.2, decision 0071).
fn (l: Listener) accept() -> ServerConn ! NetErr uses net.listen
/// Stops listening; a waiting `accept` fails with `Io`.
fn (l: Listener) close()
/// A connection made by `Net.dial`: its reads and writes are `net.dial`
/// (decision 0280).
struct Conn {}
/// At most max bytes (at most 1 MiB); None at the end of the stream.
fn (c: Conn) read(max: Int) -> Bytes? ! NetErr uses net.dial
/// Writes every byte of data.
fn (c: Conn) write(data: Bytes) -> () ! NetErr uses net.dial
/// Closes the connection; waiting reads and writes fail with `Io`.
fn (c: Conn) close()
/// Go's SetDeadline (decision 0430): reads and writes past t fail with
/// `Timeout` and the connection stays usable; a later t (or None, no
/// deadline) lets them run again. t is on clock.
fn (c: Conn) set_deadline(clock: Clock, t: Time?) uses clock
/// set_deadline for reads only (Go's SetReadDeadline).
fn (c: Conn) set_read_deadline(clock: Clock, t: Time?) uses clock
/// set_deadline for writes only (Go's SetWriteDeadline).
fn (c: Conn) set_write_deadline(clock: Clock, t: Time?) uses clock
/// A connection taken by `Listener.accept`: its reads and writes are
/// `net.listen` (decision 0280).
struct ServerConn {}
/// At most max bytes (at most 1 MiB); None at the end of the stream.
fn (c: ServerConn) read(max: Int) -> Bytes? ! NetErr uses net.listen
/// Writes every byte of data.
fn (c: ServerConn) write(data: Bytes) -> () ! NetErr uses net.listen
/// Closes the connection; waiting reads and writes fail with `Io`.
fn (c: ServerConn) close()
/// Go's SetDeadline (decision 0430): reads and writes past t fail with
/// `Timeout` and the connection stays usable; a later t (or None, no
/// deadline) lets them run again. t is on clock.
fn (c: ServerConn) set_deadline(clock: Clock, t: Time?) uses clock
/// set_deadline for reads only (Go's SetReadDeadline).
fn (c: ServerConn) set_read_deadline(clock: Clock, t: Time?) uses clock
/// set_deadline for writes only (Go's SetWriteDeadline).
fn (c: ServerConn) set_write_deadline(clock: Clock, t: Time?) uses clock

/// Either kind of connection, for code that reads and writes both
/// (decision 0280).
interface Stream {
  fn read(self, max: Int) -> Bytes? ! NetErr uses net
  fn write(self, data: Bytes) -> () ! NetErr uses net
  fn close(self)
}

/// Which side of a copy failed (decision 0593), with that side's own
/// error: reading the source (R) or writing the destination (W). Go's
/// io.Copy returns one error and cannot say.
enum CopyErr[R, W] {
  Read(err: R)
  Write(err: W)
} derive Display

/// Copies src to dst until src ends, 32 KiB at a time, writing each piece
/// in full (Go's io.Copy, decision 0593); the bytes copied.
fn copy_stream(dst: Stream, src: Stream) -> Int ! CopyErr[NetErr, NetErr] uses net

/// A connection whose reads and writes take deadlines (Go's net.Conn):
/// Conn, ServerConn and TlsConn. Every NetConn is also a Stream
/// (decision 0481).
interface NetConn {
  fn read(self, max: Int) -> Bytes? ! NetErr uses net
  fn write(self, data: Bytes) -> () ! NetErr uses net
  fn close(self)
  fn set_deadline(self, clock: Clock, t: Time?) uses clock
  fn set_read_deadline(self, clock: Clock, t: Time?) uses clock
  fn set_write_deadline(self, clock: Clock, t: Time?) uses clock
}

/// A network interface of the host (Net.interfaces, decision 0426; Go's
/// net.Interface and its Addrs).
struct NetInterface {
  /// The system's index of the interface (1 and up).
  index: Int
  /// The name: "lo", "eth0", "en0"; on Windows the friendly name.
  name: Str
  /// The maximum transmission unit (-1 when Windows reports none).
  mtu: Int
  /// The hardware address, "aa:bb:cc:dd:ee:ff"; "" when there is none.
  hardware_addr: Str
  flags: InterfaceFlags
  /// The interface's addresses as CIDR text: "192.168.1.5/24", "fe80::1/64".
  addrs: List[Str]
}

/// Go's net.Flags of an interface.
struct InterfaceFlags {
  up: Bool
  broadcast: Bool
  loopback: Bool
  point_to_point: Bool
  multicast: Bool
  running: Bool
}

interface Net {
  fn listen(self, addr: Str) -> Listener ! NetErr uses net.listen
  fn dial(self, addr: Str) -> Conn ! NetErr uses net.dial
  /// dial giving up after d over the lookup and the connect: `Timeout`
  /// then, where dial's own 30 second limit is `Io` (decision 0406).
  fn dial_timeout(self, addr: Str, d: Duration) -> Conn ! NetErr uses net.dial
  /// The addresses of host, as text, in the order dial tries them (Go's
  /// net.LookupHost; decision 0406).
  fn lookup_host(self, host: Str) -> List[Str] ! NetErr uses net.dial
  /// The host's network interfaces, sorted by index (decision 0426).
  fn interfaces(self) -> List[NetInterface] ! NetErr uses net.listen
  /// A Net that dials and listens only on the listed hosts: `host`,
  /// `*.domain`, or `host:port`, and `unix:PATH` for a Unix domain
  /// socket (std.md 3.2, decisions 0156 and 0190).
  fn only(self, hosts: List[Str]) -> Net
}

interface Clock {
  fn now(self) -> Time uses clock
  fn sleep(self, d: Duration) uses clock
  /// Like sleep, but cancellation is an error instead of an unwind
  /// (core 7.2, decision 0088).
  fn sleep_or_cancel(self, d: Duration) -> () ! ClockErr uses clock
  fn since(self, t: Time) -> Duration uses clock
}

interface Rand {
  fn int(self, lo: Int, hi: Int) -> Int uses rand
  fn float(self) -> Float uses rand
  fn bool(self) -> Bool uses rand
  fn bytes(self, n: Int) -> Bytes uses rand
  fn shuffle[T](self, xs: List[T]) -> List[T] uses rand
}

/// The error of `Clock.sleep_or_cancel` (decision 0088).
enum ClockErr {
  Canceled
}

/// `canceled` (decision 0358).
fn (e: ClockErr) display() -> Str

enum EnvErr {
  Missing(name: Str)
}

/// `NAME is not set` (decision 0358).
fn (e: EnvErr) display() -> Str

interface Env {
  fn get(self, name: Str) -> Str? uses env
  fn vars(self) -> Map[Str, Str] uses env
  /// The program's arguments without the program name (Go's
  /// os.Args[1:]); `program()` is the name.
  fn args(self) -> List[Str] uses env
  fn program(self) -> Str uses env
  fn home(self) -> Str ! EnvErr uses env
  /// An Env that reads only the listed variables (std.md 3.5, decision
  /// 0156).
  fn only(self, names: List[Str]) -> Env
  /// Where a program keeps its configuration: XDG_CONFIG_HOME, else
  /// ~/.config, ~/Library/Application Support, or %AppData% (std.md 3.5,
  /// decision 0163).
  fn config_dir(self) -> Str ! EnvErr uses env
  /// Where a program keeps its cache: XDG_CACHE_HOME, else ~/.cache,
  /// ~/Library/Caches, or %LocalAppData%.
  fn cache_dir(self) -> Str ! EnvErr uses env
  /// The host's name (Go's os.Hostname): "" where the system cannot say
  /// (decision 0410).
  fn hostname(self) -> Str uses env
  /// Windows' local application data folder (SHGetKnownFolderPath of
  /// FOLDERID_LocalAppData, as Go's windows.KnownFolderPath; not the
  /// variable), with / separators; `Missing("LocalAppData")` on other
  /// OSes. `only` does not narrow it (decision 0584).
  fn local_app_data(self) -> Str ! EnvErr uses env
}

enum IoErr {
  Closed
  Io(msg: Str)
  Canceled
}

/// Plain text (decision 0358): `closed`, the message of an Io, `canceled`.
fn (e: IoErr) display() -> Str

interface Stdio {
  fn print(self, text: Str) uses stdio
  fn println(self, text: Str) uses stdio
  fn eprint(self, text: Str) uses stdio
  fn eprintln(self, text: Str) uses stdio
  fn write(self, data: Bytes) -> () ! IoErr uses stdio
  fn read_line(self) -> Str? ! IoErr uses stdio
  fn read_all(self) -> Str ! IoErr uses stdio
  fn lines(self) -> List[Str] ! IoErr uses stdio
  /// Whether standard input is a terminal (std.md 3.6, decision 0162).
  fn stdin_is_tty(self) -> Bool uses stdio
  /// Whether standard output is a terminal.
  fn stdout_is_tty(self) -> Bool uses stdio
  /// Whether standard error is a terminal.
  fn stderr_is_tty(self) -> Bool uses stdio
  /// The columns of the terminal on standard output, error, or input (the
  /// first that is one); None when none is.
  fn width(self) -> Int? uses stdio
  /// Writes prompt to standard error and reads a line of standard input
  /// without echoing it (a password); None at the end of input.
  fn read_secret(self, prompt: Str) -> Str? ! IoErr uses stdio
  /// Sets standard input's terminal to raw input (on true): each key as
  /// it is typed, no echo, no line editing, ctrl-c and ctrl-z as bytes,
  /// output unchanged; false restores the settings (decision 0581). True
  /// when standard input is a terminal it set. The settings are restored
  /// when the program exits, faults or crashes.
  fn raw_input(self, on: Bool) -> Bool uses stdio
  /// At most max bytes of standard input, any bytes; None at the end.
  fn read_bytes(self, max: Int) -> Bytes? ! IoErr uses stdio
  /// The rest of standard input, any bytes.
  fn read_all_bytes(self) -> Bytes ! IoErr uses stdio
}

struct ProcOutput {
  code: Int
  stdout: Bytes
  stderr: Bytes
  /// The child's own CPU time and peak memory (decision 0426's
  /// addendum; a pipeline's: the commands' times added, the largest
  /// peak); zeros from a fake Proc and under WASI.
  usage: ProcUsage = ProcUsage{user: 0s, system: 0s, max_rss: 0}
}

/// Why a Keyring call failed (decision 0584).
enum KeyErr {
  /// ENOKEY or ENOENT: no such key or keyring.
  NotFound
  /// EKEYEXPIRED.
  Expired
  /// EKEYREVOKED.
  Revoked
  /// EACCES or EPERM.
  Denied
  /// Any other errno, as its text.
  Io(msg: Str)
}

/// Plain text: `key not found`, `key expired`, `key revoked`, `permission
/// denied`, or the message of an Io.
fn (e: KeyErr) display() -> Str

/// The calling user's kernel keyring (Linux keyrings(7), decision 0584).
/// `Secrets.keyring()` is None on other OSes. A keyring or key is its
/// serial number (an Int).
interface Keyring {
  /// The keyring Go's azidentity uses: the persistent keyring linked to
  /// the user keyring, else the user keyring (the session keyring linked
  /// to it first, errors ignored).
  fn user_persistent(self) -> Int ! KeyErr uses secrets.read
  /// Adds (or updates) the key of type kind and description desc in ring.
  fn add(self, ring: Int, kind: Str, desc: Str, payload: Bytes) -> Int ! KeyErr uses secrets.write
  fn search(self, ring: Int, kind: Str, desc: Str) -> Int ! KeyErr uses secrets.read
  fn read(self, id: Int) -> Bytes ! KeyErr uses secrets.read
  fn unlink(self, id: Int, ring: Int) -> () ! KeyErr uses secrets.write
}

/// Why a Keychain call failed (decision 0584): the Security framework's
/// OSStatus and its text (SecCopyErrorMessageString).
struct KeychainErr {
  status: Int
  msg: Str
}

/// `keychain: MSG (STATUS)`.
fn (e: KeychainErr) display() -> Str

/// The macOS login keychain's generic passwords (Security.framework's
/// SecItem calls, as Go's keybase/go-keychain), by service and account.
interface Keychain {
  /// The password data, or None when there is no such item.
  fn get_generic(self, service: Str, account: Str) -> Bytes? ! KeychainErr uses secrets.read
  /// Adds the item, or replaces the data of the existing one.
  fn set_generic(self, service: Str, account: Str, data: Bytes) -> () ! KeychainErr uses secrets.write
  /// Removes the item; removing a missing one is not an error.
  fn delete_generic(self, service: Str, account: Str) -> () ! KeychainErr uses secrets.write
}

/// Why a Dpapi call failed (decision 0584): the Win32 error code
/// (GetLastError) and its system text.
struct DpapiErr {
  code: Int
  msg: Str
}

/// `dpapi: MSG (CODE)`.
fn (e: DpapiErr) display() -> Str

/// Windows' Data Protection API for the current user
/// (CryptProtectData and CryptUnprotectData with no description and no
/// prompt, as Go's golang.org/x/sys/windows callers make them): blobs the
/// caller keeps, readable only by the same user on the same machine.
interface Dpapi {
  /// The protected blob of data; entropy, when given, must be given again
  /// to unprotect it.
  fn protect(self, data: Bytes, entropy: Bytes = b"") -> Bytes ! DpapiErr uses secrets.write
  /// The data of a blob protect made, with the same entropy.
  fn unprotect(self, blob: Bytes, entropy: Bytes = b"") -> Bytes ! DpapiErr uses secrets.read
}

/// The user's secret stores (decisions 0584, 0585): the member for an OS is
/// None on the others. `Os.secrets`; an omitted field of an Os literal is
/// `only([])`.
interface Secrets {
  /// The Linux kernel keyring; None on other OSes.
  fn keyring(self) -> Keyring?
  /// The macOS login keychain's generic passwords; None on other OSes
  /// (and on the Go backend, which has no cgo).
  fn keychain(self) -> Keychain?
  /// Windows' Data Protection API; None on other OSes.
  fn dpapi(self) -> Dpapi?
  /// A Secrets with only the named stores ("keyring", "keychain", "dpapi").
  fn only(self, stores: List[Str]) -> Secrets
}

enum ProcErr {
  NotFound(cmd: Str)
  Io(msg: Str)
  Canceled
  /// The command is outside an attenuated Proc (`Proc.only`, decision
  /// 0156).
  Denied(cmd: Str)
}

/// Plain text (decision 0358): `CMD: executable file not found`, the message
/// of an Io, `canceled`, `denied by Proc.only: CMD`.
fn (e: ProcErr) display() -> Str

/// CPU time and peak memory of a process (Proc.usage, decision 0426;
/// Go's syscall.Getrusage).
struct ProcUsage {
  /// CPU time in user mode.
  user: Duration
  /// CPU time in the kernel.
  system: Duration
  /// The peak resident set (Windows: the peak working set) in bytes.
  max_rss: Int
}

interface Proc {
  fn exit(self, code: Int) -> Never uses proc
  /// Time between a stop request and the cancellation of main's root scope
  /// (core 7.5, default 30s; 0s cancels at the first signal).
  fn set_grace(self, d: Duration) uses proc
  /// This process's ID (0 under WASI).
  fn pid(self) -> Int uses proc
  /// The parent process's ID (0 on Windows and under WASI).
  fn ppid(self) -> Int uses proc
  /// This process's CPU time and peak memory (decision 0426).
  fn usage(self) -> ProcUsage uses proc
  /// The waited children's CPU time and their largest peak memory.
  fn children_usage(self) -> ProcUsage uses proc
  fn run(self, cmd: Str, args: List[Str]) -> ProcOutput ! ProcErr uses proc
  /// A Proc that runs only the listed commands (std.md 3.7, decision
  /// 0156).
  fn only(self, cmds: List[Str]) -> Proc
  /// A command to run, not started (std.md 3.8, decision 0161).
  fn cmd(self, name: Str, args: List[Str] = []) -> Cmd
  /// Runs the commands with each one's output piped into the next one's
  /// input: the last one's output, every error stream, and the status of
  /// the rightmost failing command (std.md 3.8).
  fn pipeline(self, cmds: List[Cmd]) -> ProcOutput ! ProcErr uses proc
  /// Sends the signal named (HUP, INT, QUIT, KILL, TERM, USR1, USR2,
  /// CONT, STOP) to the process pid; an attenuated Proc must list "kill"
  /// (std.md 3.7, decision 0190).
  fn kill(self, pid: Int, signal: Str = "TERM") -> () ! ProcErr uses proc
  /// A channel that receives each listed signal as it arrives (Go's
  /// signal.Notify): one pending signal of each kind, a repeat dropped.
  /// While any subscription lists Interrupt or Terminate, that signal no
  /// longer starts the shutdown (core 7.5); stop_notify gives it back
  /// (std.md 3.7, decision 0407).
  fn notify(self, signals: List[Signal]) -> Chan[Signal] uses proc
  /// Ends c's subscription and closes c.
  fn stop_notify(self, c: Chan[Signal]) uses proc
  /// Starts core 7.5's phase 1 as the first signal does: the stop state
  /// set, `task.stopping()` closed, servers draining.
  fn request_stop(self) uses proc
}

/// A signal a program can subscribe to (Proc.notify, decision 0407).
/// Windows delivers Interrupt (Ctrl-C, Ctrl-Break) and Terminate (the
/// console's close, a logoff, a shutdown) only.
enum Signal { Hangup, Interrupt, Quit, Terminate, User1, User2, WindowChange }

/// A command that has not run (std.md 3.8, decision 0161). A value: each
/// builder method returns a changed copy.
struct Cmd {}
/// The working directory of the child.
fn (c: Cmd) dir(path: Str) -> Cmd
/// The child's environment is exactly the variables `e` shows now (so an
/// attenuated Env narrows it); without it the child inherits the program's.
fn (c: Cmd) env(e: Env) -> Cmd uses env
/// One more variable for the child.
fn (c: Cmd) set_env(name: Str, value: Str) -> Cmd
/// The child's standard input.
fn (c: Cmd) stdin(data: Bytes) -> Cmd
/// The child's standard streams are the program's own (the terminal).
fn (c: Cmd) inherit() -> Cmd
/// The child's standard error goes into its standard output stream.
fn (c: Cmd) merge_stderr() -> Cmd
/// Runs to the end and collects both streams.
fn (c: Cmd) output() -> ProcOutput ! ProcErr uses proc
/// Runs on the terminal and returns the exit status.
fn (c: Cmd) run() -> Int ! ProcErr uses proc
/// Starts the command and returns at once.
fn (c: Cmd) spawn() -> Child ! ProcErr uses proc

/// A started command (std.md 3.8). A handle.
struct Child {}
/// The child's process id.
fn (c: Child) pid() -> Int
/// Writes to the child's standard input.
fn (c: Child) write(data: Bytes) -> () ! ProcErr uses proc
/// Closes the child's standard input, so it sees the end of its input.
fn (c: Child) close_stdin()
/// At most max bytes of the child's output; None at the end.
fn (c: Child) read(max: Int) -> Bytes? ! ProcErr uses proc
/// At most max bytes of the child's error stream; None at the end.
fn (c: Child) read_err(max: Int) -> Bytes? ! ProcErr uses proc
/// One line of the child's output, without `\n` or `\r\n`.
fn (c: Child) read_line() -> Str? ! ProcErr uses proc
/// Closes the child's input, waits for it, and returns its status.
fn (c: Child) wait() -> Int ! ProcErr uses proc
/// wait, with the child's own CPU time and peak memory (decision 0426's
/// addendum; Go's ProcessState.UserTime, SystemTime and SysUsage).
fn (c: Child) wait_usage() -> (Int, ProcUsage) ! ProcErr uses proc
/// Kills the child (SIGKILL on Unix; status 137 on Windows too).
fn (c: Child) kill()
