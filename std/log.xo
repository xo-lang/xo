// std/log (spec/std.md 6). Declaration file; encoding rules are listed at
// the top of std/prelude.xo. Logging is ambient: no capability, no effect
// (core 6.1), so only `configure` has a `uses` clause.

fn debug(msg: Str, fields: Map[Str, Debug] = {})
fn info(msg: Str, fields: Map[Str, Debug] = {})
fn warn(msg: Str, fields: Map[Str, Debug] = {})
fn error(msg: Str, fields: Map[Str, Debug] = {})
fn configure(out: Stdio, level: Level = Level.Info, format: Format = Format.Text) uses stdio

enum Level {
  Debug
  Info
  Warn
  Error
}

enum Format {
  Text
  Json
}

/// One log record as captured in tests (std.md 6, 8.6). Field values are
/// their text form.
struct Record {
  level: Level
  msg: Str
  fields: Map[Str, Str]
}
