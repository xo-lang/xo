// std/internal: primitives for std's implementation and the Xo
// toolchain's own modules (decision 0214), not part of std's public
// surface (spec/std.md does not list it). Declaration file; encoding rules
// are listed at the top of std/prelude.xo. Only std modules and modules
// whose path is github.com/xo-lang/xo or below it may import it; for any
// other module `use std/internal` is a module not found (XO0601), as
// `use native/rt` is.

/// A held shared advisory lock (flock LOCK_SH on Unix, LockFileEx without
/// LOCKFILE_EXCLUSIVE_LOCK on Windows). A handle.
struct SharedLock {}

/// A shared advisory lock on the file (created if missing); waits while
/// someone holds it exclusively (Fs.lock, or another process's exclusive
/// flock). Many holders may share it. Only the unrestricted root Fs
/// (`os.fs`) takes it; a sub, read only, write only, or memory Fs is
/// Denied.
fn lock_shared(f: Fs, path: Str) -> SharedLock ! FsErr uses fs.write

/// Releases the lock; unlocking again does nothing.
fn (l: SharedLock) unlock()

/// A primitive of the native TLS stack's (work item B31, decision 0202)
/// for the golden tests that diff it against Go's crypto (std/rt's
/// internal_crypto.go): op is "area.what", a to d its inputs (unused ones
/// empty, lengths as decimal text). One dispatcher: each area is one arm
/// in std/native/internal.xo calling that file's op, whose doc lists its
/// whats. Areas: "hash" (std/native/llrt/sha256.xo), "hmac" (hmac.xo),
/// "hkdf" (hkdf.xo), "aes" (aesgcm.xo), "chacha" (chacha.xo), "x25519"
/// (x25519.xo), "p256" and "p384" (nistec.xo), "rsa" (rsa.xo), "x509"
/// (x509.xo), "chain" (x509verify.xo), "tls13" (tls13.xo), "tls13srv"
/// (tls13srv.xo), "sha3" (sha3.xo), "mlkem" (mlkem.xo). An unknown op
/// faults.
fn crypto_op(op: Str, a: Bytes, b: Bytes, c: Bytes, d: Bytes) -> Bytes

/// A probe of the native runtime for the toolchain's own tests of it
/// (decision 0241: the C stress tests of std/llrt/testdata as Xo
/// programs), over the runtime's functions; a to d are its inputs, 0 when
/// unused. Ops: "live" and "total" (allocations live and made, all
/// heaps; counted only with XO_LEAKCHECK=1), "chunks" (heap chunks
/// carved), "thread" (the calling thread's thread local area: equal on
/// one thread only); "alloc" (a block of a bytes),
/// "free" (block a), "resize" (block a of b bytes to c bytes),
/// "fill" (block a, b bytes, with the pattern of tag c), "check" (whether
/// the first b bytes of block a, filled for c bytes, hold tag d's
/// pattern: 1 or 0), "rs_cap" (a new string object of capacity at least
/// a, written over and freed: its capacity); "obj" (a counted object,
/// count 1, holding the word a), "word" (the word object a holds), "inc",
/// "dec" (1 when it was the last reference), "claim", "mark" (1 when the
/// count was thread local), "count" (the count word of object a, as
/// obj_word gives for a value); "readers" and "writers" (a Mutex's
/// waiting readers and writers, a its obj_word) and "listed" (the
/// tasks a scope's list holds, a its obj_word). An unknown op faults, and
/// every op faults on the Go backend.
fn rt_probe(op: Str, a: Int, b: Int, c: Int, d: Int) -> Int

/// The address of x's object, for rt_probe (0 for a value without one).
fn obj_word[T](x: T) -> Int
