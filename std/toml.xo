// std/toml (spec/std.md 19, decision 0164). Declaration file; encoding
// rules are listed at the top of std/prelude.xo. TOML 1.0 configuration
// files decoded into the same types as JSON (`derive Json`, std.md 5):
// a table is an object, an array an array, a date or time its RFC 3339
// text. Pure.
use std/json

/// Displays as `toml: line 3: expected a value after =`; an encode error
/// has line 0 and displays as `toml: msg`.
struct TomlErr {
  line: Int
  msg: Str
}

fn (e: TomlErr) display() -> Str

/// The document decoded into T by the rules of json.decode; a document
/// that is not valid TOML is TomlErr. With `strict` (go-toml's
/// Decoder.DisallowUnknownFields) a key or table T has no field for is
/// an error, DecodeErr.Strict listing each one in document order.
fn decode[T: Json](text: Str, strict: Bool = false) -> T ! DecodeErr
/// The document as JSON text, its keys in document order.
fn to_json(text: Str) -> Str ! TomlErr
/// v as a TOML document, laid out as pelletier/go-toml/v2's Marshal: a
/// table's plain keys first, then its tables (`[a.b]`, a blank line
/// before each) and arrays of tables (`[[a]]`) in field order; strings as
/// literal strings ('...') when they can be, else basic strings with
/// Go's escapes; an array of values or mixed values inline. v goes
/// through json.to_value, so a None field is left out, Time and Duration
/// are their JSON strings, and a Float with no fraction is an integer
/// (decode reads each back). TomlErr (line 0) when v is not a record or
/// map, or an array holds a None.
fn encode[T: Json](v: T) -> Str ! TomlErr

/// go-toml's Encoder settings. `tables_inline` (SetTablesInline): every
/// table and array of tables is an inline value (`a = {x = 1}`,
/// `b = [{y = 2}]`) on its key's line, in field order. `arrays_multiline`
/// (SetArraysMultiline): a non-empty array writes an element a line, each
/// one `indent` deeper than its key, with no trailing comma. `indent_tables`
/// (SetIndentTables): a table's keys and its sub-tables' headers are
/// indented one `indent` (SetIndentSymbol) per level of nesting.
struct EncodeOptions {
  tables_inline: Bool = false
  arrays_multiline: Bool = false
  indent_tables: Bool = false
  indent: Str = "  "
}

/// `encode` with opts (go-toml's NewEncoder with its setters).
fn encode_with[T: Json](v: T, opts: EncodeOptions) -> Str ! TomlErr

/// Why decode failed: the text is not TOML, its values do not fit T, or
/// (strict decode) it has keys T has no field for (go-toml's
/// StrictMissingError, whose text Strict displays as: `strict mode:
/// fields in the document are missing in the target struct`).
open enum DecodeErr {
  Syntax(err: TomlErr)
  Value(err: json.DecodeErr)
  Strict(errs: List[StrictErr])
}

/// A key of the document that a strict decode found no field for
/// (go-toml's DecodeError in a StrictMissingError). Displays as
/// `toml: line 3: unknown field server.port`.
struct StrictErr {
  /// the key's line and byte column, from 1
  line: Int
  column: Int
  /// the full key, a part a level (go-toml's Key): `[server]` then
  /// `a.b = 1` is ["server", "a", "b"]
  key: List[Str]
  /// "unknown field" for a key and value, "missing table" for a `[table]`
  /// or `[[array of tables]]` header (the keys under it are not listed)
  msg: Str
  /// go-toml's DecodeError.String(): up to 3 lines either side of the
  /// key's, the key underlined with `~` and msg. go-toml's
  /// StrictMissingError.String() is these joined by "\n---\n".
  context: Str
}

fn (e: StrictErr) display() -> Str

fn (e: DecodeErr) display() -> Str
