// std/compress (spec/std.md 32, decision 0305). Declaration file; encoding
// rules are listed at the top of std/prelude.xo. Go's compress/gzip,
// compress/flate, and compress/zlib over whole buffers: the bytes Go's
// writers write at each level, Go's error texts, and decoders bounded by
// max_size. Pure.

/// A compression level: Go's -2 (HuffmanOnly) to 9 (BestCompression);
/// `Of(n)` for any of them, a fault outside -2 to 9.
enum Level {
  NoCompression
  BestSpeed
  Default
  BestCompression
  HuffmanOnly
  Of(n: Int)
}

/// Go's error texts (`gzip: invalid header`, `flate: corrupt input before
/// offset 5`, `zlib: invalid checksum`, `unexpected EOF`), or
/// `gzip: output exceeds max_size (N bytes)` (flate, zlib likewise).
struct CompressErr {
  msg: Str
}

fn (e: CompressErr) display() -> Str

/// A gzip member with no name and no time (the output depends on the data
/// and the level only).
fn gzip(data: Bytes, level: Level = Level.Default) -> Bytes
/// Every concatenated member; more than max_size bytes of output is an
/// error.
fn gunzip(data: Bytes, max_size: Int = 1073741824) -> Bytes ! CompressErr
/// The fields of a gzip member's header (Go's gzip.Header): name and
/// comment are Latin-1 in the stream (every rune 1 to 255), extra is the
/// FEXTRA field (none when empty), mtime the modification time in Unix
/// seconds (none when 0), os the operating system byte (255: unknown).
struct GzipHeader {
  name: Str = ""
  comment: Str = ""
  extra: Bytes = b""
  mtime: Int = 0
  os: Int = 255
} derive Eq, Debug

/// gzip with header's fields (gzip.Writer with its Header set): gzip(data,
/// level) when header is GzipHeader{}. Errors are Go's texts:
/// `gzip.Write: non-Latin-1 header string` for a name or comment with a
/// rune of 0 or above 255, `gzip.Write: Extra data is too large` for an
/// extra of more than 65535 bytes.
fn gzip_with(data: Bytes, header: GzipHeader, level: Level = Level.Default) -> Bytes ! CompressErr
/// The header of the first gzip member in data (gzip.NewReader's Header):
/// its errors are Go's (`EOF` for no data, `unexpected EOF`, `gzip:
/// invalid header`); the member's body is not read.
fn gzip_header(data: Bytes) -> GzipHeader ! CompressErr

/// Raw DEFLATE (RFC 1951). dict is a preset dictionary (Go's
/// flate.NewWriterDict): the data may refer back into its last 32 KB, and
/// the reader must be given the same one. Levels 2 to 9 use it; store,
/// BestSpeed, and HuffmanOnly ignore it, as Go's do.
fn deflate(data: Bytes, level: Level = Level.Default, dict: Bytes = b"") -> Bytes
/// flate.NewReaderDict when dict is not empty: back references reach into
/// it, and the output does not include it.
fn inflate(data: Bytes, max_size: Int = 1073741824, dict: Bytes = b"") -> Bytes ! CompressErr
/// zlib (RFC 1950): a two byte header, DEFLATE, and the Adler-32 sum. A
/// non-empty dict sets the header's FDICT bit and writes its Adler-32
/// after it (zlib.NewWriterLevelDict).
fn zlib(data: Bytes, level: Level = Level.Default, dict: Bytes = b"") -> Bytes
/// zlib.NewReaderDict: a header that names a dictionary needs dict to be
/// it (`zlib: invalid dictionary` otherwise, Go's ErrDictionary); dict is
/// ignored when the header names none.
fn unzlib(data: Bytes, max_size: Int = 1073741824, dict: Bytes = b"") -> Bytes ! CompressErr

/// The stream formats of a Compressor or Decompressor.
enum Format {
  Gzip
  Deflate
  Zlib
}

/// A streaming compressor: bytes in, compressed bytes out, no I/O of its
/// own; `write` returns the output ready so far (it may be empty),
/// `flush` everything written so far (a sync block: a reader can decode
/// it all), `finish` the rest and the format's trailer. The concatenation
/// of its outputs is what gzip, deflate, or zlib gives for all the data.
/// @move_only
struct Compressor {}

/// dict: a preset dictionary for Deflate and Zlib as in deflate and zlib;
/// a fault for Gzip, which has none.
fn compressor(format: Format, level: Level = Level.Default, dict: Bytes = b"") -> Compressor
fn (var c: Compressor) write(data: Bytes) -> Bytes
fn (var c: Compressor) flush() -> Bytes
/// @moves
fn (var c: Compressor) finish() -> Bytes

/// A streaming decompressor: compressed bytes in, decoded bytes out as
/// their input arrives (how much each write returns may differ between
/// backends: natively everything decoded so far, on the Go backend what Go's
/// reader returns); `finish` returns the rest, or `unexpected EOF` when
/// the stream did not end. The concatenation of the outputs is what
/// gunzip, inflate, or unzlib gives; more than max_size bytes in all is an
/// error at once.
/// @move_only
struct Decompressor {}

/// dict: a preset dictionary for Deflate and Zlib as in inflate and
/// unzlib; a fault for Gzip, which has none.
fn decompressor(format: Format, max_size: Int = 1073741824, dict: Bytes = b"") -> Decompressor
fn (var d: Decompressor) write(data: Bytes) -> Bytes ! CompressErr
/// @moves
fn (var d: Decompressor) finish() -> Bytes ! CompressErr

/// The bit order of an LZW stream (Go's compress/lzw Order): LSB (GIF, and
/// TIFF's predecessor) packs codes from the low end of each byte, MSB (PDF,
/// TIFF) from the high end.
enum LzwOrder {
  LSB
  MSB
} derive Eq, Display

/// Go's compress/lzw writer over a whole buffer: the codes Go writes for
/// the data, a leading clear code, a table reset when the 12 bit codes run
/// out, then the end code. lit_width (2 to 8) is the width of a literal code
/// and every byte must fit in it. Errors are Go's texts: `lzw: litWidth 9
/// out of range`, `lzw: input byte too large for the litWidth`.
fn lzw_encode(data: Bytes, order: LzwOrder, lit_width: Int) -> Bytes ! CompressErr

/// Go's compress/lzw reader over a whole buffer: the bytes up to the end
/// code (anything after it is ignored). Errors are Go's texts: `lzw: invalid
/// code`, `unexpected EOF` (no end code), `lzw: litWidth 1 out of range`, or
/// `lzw: output exceeds max_size (N bytes)`.
fn lzw_decode(data: Bytes, order: LzwOrder, lit_width: Int, max_size: Int = 1073741824) -> Bytes ! CompressErr

