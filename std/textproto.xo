// std/textproto: the text of line protocols and MIME headers (decision
// 0598): canonical header keys, a header of every value in field order,
// and a reader of lines, continued lines, header blocks, numbered reply
// lines and dot-encoded blocks over bytes held in memory. Ported from Go's
// net/textproto (go1.26.1 reader.go, header.go, writer.go, textproto.go),
// with its tests in std/textproto_test.xo. Pure.

/// A protocol error: Go's ProtocolError (its text), Error (a reply's code
/// and message), io.EOF (the input ended where a line was expected) or
/// io.ErrUnexpectedEOF (it ended inside a dot-encoded block).
pub enum TextErr {
  Protocol(msg: Str)
  Code(code: Int, msg: Str)
  Eof
  UnexpectedEof
}

/// Go's text: the protocol error's own, `NNN message` for a reply's
/// code, `EOF` and `unexpected EOF`.
pub fn (e: TextErr) display() -> Str {
  match e {
    TextErr.Protocol(m) => m
    TextErr.Code(c, m) => "${pad3(c)} ${m}"
    TextErr.Eof => "EOF"
    TextErr.UnexpectedEof => "unexpected EOF"
  }
}

fn pad3(n: Int) -> Str {
  if n >= 0 && n < 10 {
    return "00${n}"
  }
  if n >= 0 && n < 100 {
    return "0${n}"
  }
  "${n}"
}

// ---- keys ----------------------------------------------------------------

/// Whether c may be in a header field name (RFC 7230 token: Go's
/// validHeaderFieldByte).
fn field_byte(c: UInt8) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c is '!' | '#' | '$' | '%' | '&' | '\'' | '*' | '+' | '-' | '.' | '^' | '_' | '`' | '|' | '~'
}

/// Whether c may be in a header value (Go's validHeaderValueByte: no
/// control byte but a tab; bytes past ASCII are allowed).
fn value_byte(c: UInt8) -> Bool { c >= 0x20 && c != 0x7f || c == '\t' || c >= 0x80 }

/// The canonical form of a header key (Go's CanonicalMIMEHeaderKey): the
/// first letter and each letter after a hyphen upper case, the rest lower
/// case (`accept-encoding` is `Accept-Encoding`). A key with a byte that
/// cannot be in a field name (a space) is returned unchanged.
pub fn canonical_key(s: Str) -> Str {
  let b = s.bytes()
  var upper = true
  var i = 0
  while i < b.len() {
    let c = b[i]
    if !field_byte(c) {
      return s
    }
    if (upper && c >= 'a' && c <= 'z') || (!upper && c >= 'A' && c <= 'Z') {
      // Go's canonicalMIMEHeaderKey of the whole key: unchanged for a bad
      // byte or a space past here
      return line_key(b) ?? s
    }
    upper = c == '-'
    i += 1
  }
  s
}

/// b (only field bytes) with each word capitalized.
fn canon(b: Bytes) -> Str {
  var out = BytesBuilder.with_capacity(b.len())
  var upper = true
  for c0 in b {
    var c = c0
    if upper && c >= 'a' && c <= 'z' {
      c -= 32
    } else if !upper && c >= 'A' && c <= 'Z' {
      c += 32
    }
    out.write_byte(c)
    upper = c == '-'
  }
  out.freeze().to_str_lossy()
}

/// The key of a header line (Go's canonicalMIMEHeaderKey): None when it
/// is empty or has a byte that cannot be in a field name; a key with a
/// space is kept as it is.
fn line_key(k: Bytes) -> Str? {
  if k.is_empty() {
    return None
  }
  var spaces = false
  for c in k {
    if c == ' ' {
      spaces = true
    } else if !field_byte(c) {
      return None
    }
  }
  if spaces {
    return Some(k.to_str_lossy())
  }
  Some(canon(k))
}

/// s without leading and trailing ASCII space: spaces, tabs, CR and LF
/// (Go's TrimString).
pub fn trim(s: Str) -> Str {
  let b = s.bytes()
  var lo = 0
  while lo < b.len() && ascii_space(b[lo]) {
    lo += 1
  }
  var hi = b.len()
  while hi > lo && ascii_space(b[hi - 1]) {
    hi -= 1
  }
  s[lo..hi]
}

/// Go's textproto isASCIISpace.
fn ascii_space(c: UInt8) -> Bool { c == ' ' || c == '\t' || c == '\r' || c == '\n' }

fn trim_bytes(b: Bytes) -> Bytes {
  var lo = 0
  while lo < b.len() && (b[lo] == ' ' || b[lo] == '\t') {
    lo += 1
  }
  var hi = b.len()
  while hi > lo && (b[hi - 1] == ' ' || b[hi - 1] == '\t') {
    hi -= 1
  }
  b[lo..hi]
}

// ---- Header --------------------------------------------------------------

/// A MIME header (Go's MIMEHeader): every value of every key, the keys
/// canonical, in the order their fields came. A value.
pub struct Header {
  keys: List[Str] = []
  vals: List[List[Str]] = []
}

/// An empty header.
pub fn header() -> Header { Header{} }

fn (h: Header) index(key: Str) -> Int {
  let k = canonical_key(key)
  var i = 0
  while i < h.keys.len() {
    if h.keys[i] == k {
      return i
    }
    i += 1
  }
  -1
}

/// The first value of key (canonicalized), None when it has none (Go's
/// Get, which gives "").
pub fn (h: Header) get(key: Str) -> Str? {
  let i = h.index(key)
  if i < 0 || h.vals[i].is_empty() {
    return None
  }
  Some(h.vals[i][0])
}

/// Every value of key (canonicalized) in order, [] for none (Values).
pub fn (h: Header) values(key: Str) -> List[Str] {
  let i = h.index(key)
  if i < 0 {
    return []
  }
  h.vals[i]
}

/// The canonical keys, in the order each first came.
pub fn (h: Header) keys() -> List[Str] { h.keys }

/// The number of keys.
pub fn (h: Header) len() -> Int { h.keys.len() }

/// h with value added to key's values (Add).
pub fn (h: Header) add(key: Str, value: Str) -> Header {
  let i = h.index(key)
  if i < 0 {
    return Header{keys: h.keys + [canonical_key(key)], vals: h.vals + [[value]]}
  }
  var vals = h.vals
  vals[i] = vals[i] + [value]
  Header{keys: h.keys, vals: vals}
}

/// h with key's values replaced by value (Set).
pub fn (h: Header) set(key: Str, value: Str) -> Header {
  let i = h.index(key)
  if i < 0 {
    return h.add(key, value)
  }
  var vals = h.vals
  vals[i] = [value]
  Header{keys: h.keys, vals: vals}
}

/// h without key (Del).
pub fn (h: Header) del(key: Str) -> Header {
  let i = h.index(key)
  if i < 0 {
    return h
  }
  var keys = h.keys
  var vals = h.vals
  keys.remove_at(i)
  vals.remove_at(i)
  Header{keys: keys, vals: vals}
}

/// Each key's first value, in key order: the shape of std/http's and
/// std/multipart's `headers` maps.
pub fn (h: Header) to_map() -> Map[Str, Str] {
  var m: Map[Str, Str] = {}
  var i = 0
  while i < h.keys.len() {
    if !h.vals[i].is_empty() {
      m.put(h.keys[i], h.vals[i][0])
    }
    i += 1
  }
  m
}

// ---- Reader --------------------------------------------------------------

/// A reader of a line protocol's text held in memory (Go's Reader over a
/// bufio.Reader that has it all): lines end at `\n` or `\r\n`, and the
/// last line may have no end. `eof_header` is whether the last
/// read_header ended at the end of the input instead of a blank line.
pub struct Reader {
  b: Bytes
  at: Int = 0
  eof_header: Bool = false
}

/// A reader of b.
pub fn reader(b: Bytes) -> Reader { Reader{b: b} }

/// The bytes not read yet.
pub fn (r: Reader) rest() -> Bytes { r.b[r.at..] }

/// Whether the last read_header ended at the end of the input, not at a
/// blank line: Go's ReadMIMEHeader returns that header with io.EOF, which
/// net/mail accepts and a multipart part does not.
pub fn (r: Reader) header_truncated() -> Bool { r.eof_header }

/// The next line's bytes without its `\n` or `\r\n` (bufio's ReadLine),
/// None at the end of the input.
fn (var r: Reader) line_bytes() -> Bytes? {
  let n = r.b.len()
  if r.at >= n {
    return None
  }
  let start = r.at
  match r.b[start..].find(b"\n") {
    Some(k) => {
      r.at = start + k + 1
      var end = start + k
      if end > start && r.b[end - 1] == '\r' {
        end -= 1
      }
      Some(r.b[start..end])
    }
    None => {
      r.at = n
      Some(r.b[start..n])
    }
  }
}

/// The next line (ReadLine), Err(Eof) at the end of the input.
pub fn (var r: Reader) read_line() -> Str ! TextErr {
  match r.line_bytes() {
    Some(l) => Ok(l.to_str_lossy())
    None => Err(TextErr.Eof)
  }
}

/// Spaces and tabs at the reader's position skipped, how many.
fn (var r: Reader) skip_space() -> Int {
  var k = 0
  while r.at < r.b.len() && (r.b[r.at] == ' ' || r.b[r.at] == '\t') {
    r.at += 1
    k += 1
  }
  k
}

/// A line and the lines after it that start with a space or a tab, each
/// trimmed and joined by one space (readContinuedLineSlice); an empty
/// line is returned as it is, unchecked; check tests the first line.
fn (var r: Reader) continued(check: Bool) -> Bytes ! TextErr {
  let line = match r.line_bytes() {
    Some(l) => l
    None => return Err(TextErr.Eof)
  }
  if line.is_empty() {
    return Ok(line)
  }
  if check && line.find(b":").is_none() {
    return Err(TextErr.Protocol(msg: "malformed MIME header: missing colon: ${line.quote()}"))
  }
  var buf = BytesBuilder.new()
  buf.write(trim_bytes(line))
  while r.skip_space() > 0 {
    buf.write_byte(' ')
    match r.line_bytes() {
      Some(l) => buf.write(trim_bytes(l))
      None => break
    }
  }
  Ok(buf.freeze())
}

/// A line and its continuation lines joined (ReadContinuedLine): leading
/// and trailing spaces and tabs of each removed, one space between them.
pub fn (var r: Reader) read_continued_line() -> Str ! TextErr {
  Ok(r.continued(false)?.to_str_lossy())
}

/// A MIME header block up to and including its blank line
/// (ReadMIMEHeader): continued lines joined, keys canonical, values with
/// leading spaces and tabs removed. A first line that starts with a space
/// or a tab, a line without a colon, a bad key and a control byte in a
/// value are Protocol errors with Go's text. The end of the input after
/// at least one field ends the block (header_truncated is then true);
/// with none it is Eof.
pub fn (var r: Reader) read_header() -> Header ! TextErr {
  r.eof_header = false
  var h = header()
  if r.at < r.b.len() && (r.b[r.at] == ' ' || r.b[r.at] == '\t') {
    // Go quotes at most 80 bytes of the line
    let l = r.line_bytes() ?? b""
    let shown = if l.len() > 80 { l[0..80] } else { l }
    return Err(TextErr.Protocol(msg: "malformed MIME header initial line: ${shown.to_str_lossy()}"))
  }
  while true {
    let kv = match r.continued(true) {
      Ok(x) => x
      Err(TextErr.Eof) => {
        if h.len() == 0 {
          return Err(TextErr.Eof)
        }
        r.eof_header = true
        return Ok(h)
      }
      Err(e) => return Err(e)
    }
    if kv.is_empty() {
      return Ok(h)
    }
    let bad = TextErr.Protocol(msg: "malformed MIME header line: ${kv.to_str_lossy()}")
    let c = match kv.find(b":") {
      Some(i) => i
      None => return Err(bad)
    }
    let key = match line_key(kv[0..c]) {
      Some(k) => k
      None => return Err(bad)
    }
    let v = kv[c + 1..]
    for x in v {
      if !value_byte(x) {
        // Go canonicalizes the key in place, so its text shows the key
        // canonical
        return Err(TextErr.Protocol(msg: "malformed MIME header line: ${key}:${v.to_str_lossy()}"))
      }
    }
    var s = 0
    while s < v.len() && (v[s] == ' ' || v[s] == '\t') {
      s += 1
    }
    h = h.add_canonical(key, v[s..].to_str_lossy())
  }
  Ok(h)
}

/// h with value added to key, which is already canonical (a key with a
/// space stays as it came, as Go's map key does).
fn (h: Header) add_canonical(key: Str, value: Str) -> Header {
  var i = 0
  while i < h.keys.len() {
    if h.keys[i] == key {
      var vals = h.vals
      vals[i] = vals[i] + [value]
      return Header{keys: h.keys, vals: vals}
    }
    i += 1
  }
  Header{keys: h.keys + [key], vals: h.vals + [[value]]}
}

/// A reply line `NNN message` or `NNN-message` (Go's parseCodeLine,
/// all its results): the code, whether more lines follow, the message,
/// and the error: a Protocol error for a short line or a code that is not
/// three digits of at least 100 (the code is then 0 or what parsed), Code
/// when the code does not match expect (1 to 9 its first digit, 10 to 99
/// its first two, 100 to 999 all of it; 0 or less any).
struct CodeLine {
  code: Int
  more: Bool
  msg: Str
  err: TextErr?
}

fn code_line(line: Str, expect: Int) -> CodeLine {
  let b = line.bytes()
  if b.len() < 4 || (b[3] != ' ' && b[3] != '-') {
    return CodeLine{code: 0, more: false, msg: "", err: Some(TextErr.Protocol(msg: "short response: ${line}"))}
  }
  let more = b[3] == '-'
  let parsed = Int.parse(line[0..3])
  let code = parsed ?? 0
  if parsed.is_none() || code < 100 {
    return CodeLine{code: code, more: more, msg: "", err: Some(TextErr.Protocol(msg: "invalid response code: ${line}"))}
  }
  let msg = line[4..]
  if (1 <= expect && expect < 10 && code / 100 != expect) || (10 <= expect && expect < 100 && code / 10 != expect) || (100 <= expect && expect < 1000 && code != expect) {
    return CodeLine{code: code, more: more, msg: msg, err: Some(TextErr.Code(code: code, msg: msg))}
  }
  CodeLine{code: code, more: more, msg: msg, err: None}
}

/// One reply line (ReadCodeLine): its code and message; a line that
/// says more lines follow is a Protocol error.
pub fn (var r: Reader) read_code_line(expect: Int) -> (Int, Str) ! TextErr {
  let cl = code_line(r.read_line()?, expect)
  if let Some(e) = cl.err {
    return Err(e)
  }
  if cl.more {
    return Err(TextErr.Protocol(msg: "unexpected multi-line response: ${cl.msg}"))
  }
  Ok((cl.code, cl.msg))
}

/// A reply of one or more lines (ReadResponse): `NNN-` lines then a
/// `NNN ` line of the same code, the messages joined by `\n`. A line in
/// between that is not of that code is kept whole in the message. The
/// first line's error is returned after the whole reply is read; for a
/// reply of several lines it becomes Code with the whole message.
pub fn (var r: Reader) read_response(expect: Int) -> (Int, Str) ! TextErr {
  let first = code_line(r.read_line()?, expect)
  var more = first.more
  var msg = StrBuilder.new()
  msg.write(first.msg)
  while more {
    let line = r.read_line()?
    msg.write("\n")
    let cl = code_line(line, 0)
    if cl.err.is_some() || cl.code != first.code {
      msg.write(line.trim_end_chars("\r\n"))
      more = true
    } else {
      msg.write(cl.msg)
      more = cl.more
    }
  }
  let text = msg.freeze()
  if let Some(e) = first.err {
    if first.more && !text.is_empty() {
      return Err(TextErr.Code(code: first.code, msg: text))
    }
    return Err(e)
  }
  Ok((first.code, text))
}

/// A dot-encoded block up to its `.` line (DotReader read whole, Go's
/// ReadDotBytes): a leading `.` of a line removed, `\r\n` read as `\n`;
/// the end of the input first is UnexpectedEof.
pub fn (var r: Reader) read_dot_bytes() -> Bytes ! TextErr {
  // DotReader's states
  let begin = 0
  let dot = 1
  let dot_cr = 2
  let cr = 3
  let data = 4
  var st = begin
  var out = BytesBuilder.new()
  while true {
    if r.at >= r.b.len() {
      return Err(TextErr.UnexpectedEof)
    }
    var c = r.b[r.at]
    r.at += 1
    if st == begin {
      if c == '.' {
        st = dot
        continue
      }
      if c == '\r' {
        st = cr
        continue
      }
      st = data
    } else if st == dot {
      if c == '\r' {
        st = dot_cr
        continue
      }
      if c == '\n' {
        return Ok(out.freeze())
      }
      st = data
    } else if st == dot_cr {
      if c == '\n' {
        return Ok(out.freeze())
      }
      r.at -= 1
      c = '\r'
      st = data
    } else if st == cr {
      if c == '\n' {
        st = begin
      } else {
        r.at -= 1
        c = '\r'
        st = data
      }
    } else {
      if c == '\r' {
        st = cr
        continue
      }
      if c == '\n' {
        st = begin
      }
    }
    out.write_byte(c)
  }
  Ok(out.freeze())
}

/// The lines of a dot-encoded block up to its `.` line (ReadDotLines),
/// a leading `.` of each removed; the end of the input first is
/// UnexpectedEof.
pub fn (var r: Reader) read_dot_lines() -> List[Str] ! TextErr {
  var out: List[Str] = []
  while true {
    let line = match r.read_line() {
      Ok(l) => l
      Err(TextErr.Eof) => return Err(TextErr.UnexpectedEof)
      Err(e) => return Err(e)
    }
    if line.starts_with(".") {
      if line.len() == 1 {
        return Ok(out)
      }
      out.push(line[1..])
    } else {
      out.push(line)
    }
  }
  Ok(out)
}

// ---- writing -------------------------------------------------------------

/// b dot-encoded with its end line (Go's DotWriter given b, then
/// closed): `\n` written as `\r\n`, a `.` at a line's start doubled, and
/// `\r\n.\r\n` at the end (`.\r\n` alone after a line's end).
pub fn dot_encode(b: Bytes) -> Bytes {
  let begin = 0
  let begin_line = 1
  let cr = 2
  let data = 3
  var st = begin
  var out = BytesBuilder.with_capacity(b.len() + b.len() / 16 + 5)
  for c in b {
    if st == begin || st == begin_line {
      st = data
      if c == '.' {
        out.write_byte('.')
      }
      if c == '\r' {
        st = cr
      }
      if c == '\n' {
        out.write_byte('\r')
        st = begin_line
      }
    } else if st == data {
      if c == '\r' {
        st = cr
      }
      if c == '\n' {
        out.write_byte('\r')
        st = begin_line
      }
    } else {
      st = data
      if c == '\n' {
        st = begin_line
      }
    }
    out.write_byte(c)
  }
  if st == begin || st == data {
    out.write(b"\r\n.\r\n")
  } else if st == cr {
    out.write(b"\n.\r\n")
  } else {
    out.write(b".\r\n")
  }
  out.freeze()
}
