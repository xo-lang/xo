// std/tls (spec/std.md 27, decision 0281). Declaration file; encoding
// rules are listed at the top of std/prelude.xo. A TLS client on a
// connection the program dialed itself (the STARTTLS shape: Postgres's
// SSLRequest, SMTP, Redis).

use std/x509

/// How the server's certificate is checked (std.md 27).
enum Verify {
  /// the chain against the roots and the server's name (the default)
  Full
  /// INSECURE: the chain but not the name, so any certificate the roots
  /// issued for any host is accepted
  ChainOnly
  /// INSECURE: nothing (Go's InsecureSkipVerify); refused without a
  /// verify_conn that pins the certificate
  None
} derive Display

/// Certificates a client trusts (std.md 27); a handle.
struct Roots {}

struct TlsErr {
  msg: Str
  /// Which of Go's error types this is (decision 0644 T12); Other for an
  /// error Go returns untyped. The text is msg either way.
  kind: TlsErrKind = TlsErrKind.Other
}

/// Go's crypto/tls error types, for errors.As (decision 0644 T12):
/// RecordHeaderError (a record that is not TLS, an oversized one, one of
/// another version: the record's header, up to five bytes) and
/// CertificateVerificationError (the peer's certificates, leaf first, as
/// they came, and the x509 error that refused them).
enum TlsErrKind {
  Other
  RecordHeader(header: Bytes)
  CertificateVerification(certs: List[x509.Certificate], cause: x509.CertErr)
  /// Go's ECHRejectionError (decision 0644 T13): the server rejected the
  /// client's Encrypted Client Hello; its retry configs (an
  /// ECHConfigList to try again with, empty when it sent none, which a
  /// client may take as the server's signal that it has no ECH)
  EchRejection(retry_config_list: Bytes)
  /// Go's AlertError: a TLS alert as a QUIC connection reports it
  /// (decision 0644 T14; a QUIC transport closes with 0x100 + code)
  Alert(code: Int)
}

/// The message (decision 0358).
fn (e: TlsErr) display() -> Str

/// Parses the CERTIFICATE blocks of a PEM text, as http's with_roots.
fn roots(pem: Bytes) -> Roots ! TlsErr

/// Roots of parsed certificates (std/x509), as roots does of a PEM text.
fn roots_of(certs: List[x509.Certificate]) -> Roots ! TlsErr

/// A certificate chain with its private key (std.md 27); a handle.
/// std/http's TlsCert is this type (decision 0433).
struct TlsCert {}

/// Parses a PEM certificate chain and its PEM private key (Go's
/// tls.X509KeyPair), as http.tls_cert.
fn cert(cert_pem: Bytes, key_pem: Bytes) -> TlsCert ! TlsErr
/// The certificate with an OCSP response to staple (Go's
/// Certificate.OCSPStaple, decision 0644 T10): a server sends it to a
/// client that asks (status_request), in TLS 1.3's Certificate and as
/// TLS 1.2's CertificateStatus; a client reads it as
/// ConnState.ocsp_response. Not checked, as Go's.
fn (c: TlsCert) with_ocsp_staple(staple: Bytes) -> TlsCert
/// The certificate with Signed Certificate Timestamps to send (Go's
/// Certificate.SignedCertificateTimestamps, RFC 6962): to a client that
/// asks, in TLS 1.3's Certificate and TLS 1.2's ServerHello; a client
/// reads them as ConnState.signed_certificate_timestamps.
fn (c: TlsCert) with_signed_certificate_timestamps(scts: List[Bytes]) -> TlsCert

/// What a TLS server asks of a client's certificate (Go's
/// tls.ClientAuthType, in Go's order and meaning; decision 0433).
enum ClientAuth {
  /// asks for none (Go's NoClientCert)
  None
  /// asks for one, checks none (RequestClientCert)
  Request
  /// requires one, checks none (RequireAnyClientCert)
  RequireAny
  /// checks one if given (VerifyClientCertIfGiven)
  VerifyIfGiven
  /// requires one and checks it (RequireAndVerifyClientCert)
  RequireAndVerify
} derive Display

/// A TLS connection (std.md 27); a handle.
struct TlsConn {}

/// Runs a TLS client handshake on c, which belongs to the result from
/// then on (std.md 27). cert is the certificate presented when the
/// server asks for one (decision 0433). min_version and max_version are
/// Go's MinVersion and MaxVersion (VERSION_TLS12, VERSION_TLS13; 0: TLS
/// 1.2 and 1.3); cipher_suites are the TLS 1.2 suites offered and
/// curve_preferences the key exchanges, each in Go's order whatever the
/// list's ([]: Go's defaults; decision 0644 T7).
fn client(c: Conn, host: Str, roots: Roots? = None, verify: Verify = Verify.Full, alpn: List[Str] = [], cert: TlsCert? = None, verify_conn: (fn(List[x509.Certificate]) -> () ! Str)? = None, min_version: Int = 0, max_version: Int = 0, cipher_suites: List[Int] = [], curve_preferences: List[Int] = []) -> TlsConn ! NetErr uses net.dial
/// Dials addr on net and runs `client` on the connection (Go's tls.Dial
/// and DialWithDialer): server_name defaults to addr's host (an IPv6
/// literal's brackets dropped). timeout, when given, bounds the dial and
/// the handshake together (Go's Dialer.Timeout); the connection's
/// deadlines are clear again in the result. The other arguments are
/// client's.
fn dial(net: Net, addr: Str, server_name: Str = "", roots: Roots? = None, verify: Verify = Verify.Full, alpn: List[Str] = [], cert: TlsCert? = None, verify_conn: (fn(List[x509.Certificate]) -> () ! Str)? = None, timeout: Duration? = None, min_version: Int = 0, max_version: Int = 0, cipher_suites: List[Int] = [], curve_preferences: List[Int] = []) -> TlsConn ! NetErr uses net.dial
/// A TLS client's settings (Go's Config, the fields a client reads;
/// decision 0644 T6): `client` and `dial`'s named arguments plus Go's
/// verification and certificate hooks. A plain value: each
/// client_config or dial_config call reads the one it is given.
struct ClientConfig {
  /// the name sent (SNI) and verified (Go's ServerName); dial_config's
  /// "" is addr's host
  server_name: Str = ""
  /// the roots that verify the server (Go's RootCAs; None: the system's)
  roots: Roots? = None
  /// what is verified (Verify.None is Go's InsecureSkipVerify, which
  /// needs verify_peer_certificate or verify_connection to pin)
  verify: Verify = Verify.Full
  /// the ALPN protocols offered, most preferred first (Go's NextProtos)
  next_protos: List[Str] = []
  /// the client certificates: the first one a CertificateRequest
  /// accepts is sent (Go's Certificates), none when no one does
  certificates: List[TlsCert] = []
  /// Go's VerifyPeerCertificate: the server's certificates (DER, the
  /// leaf first) and the chains that verified them ([] with
  /// Verify.None), after the normal verification; an Err fails the
  /// handshake with its text
  verify_peer_certificate: (fn(List[Bytes], List[List[x509.Certificate]]) -> () ! Str uses sync)? = None
  /// Go's VerifyConnection: the state so far (handshake_complete false)
  /// after verify_peer_certificate; an Err fails the handshake
  verify_connection: (fn(ConnState) -> () ! Str uses sync)? = None
  /// Go's GetClientCertificate: asked when the server requests a
  /// certificate, in place of certificates; None sends none, and an Err
  /// fails the handshake with its text
  get_client_certificate: (fn(CertificateRequestInfo) -> TlsCert? ! Str uses sync)? = None
  /// as client's (decision 0644 T7)
  min_version: Int = 0
  max_version: Int = 0
  cipher_suites: List[Int] = []
  curve_preferences: List[Int] = []
  /// Go's KeyLogWriter (decision 0644 T8): each secret of the handshake
  /// as an NSS key log line (`LABEL <client random> <secret>`, in
  /// hexadecimal, with a newline) for tools such as Wireshark to decrypt
  /// the connection; it compromises the connection's security, so use
  /// it only to debug. An Err fails the handshake. It runs on the
  /// connection's task, so calls from several connections can overlap.
  key_log: (fn(Str) -> () ! Str uses sync)? = None
  /// Go's ClientSessionCache (decision 0644 T3): sessions to resume,
  /// keyed by server_name (else the server's address); None resumes
  /// none
  session_cache: SessionCache? = None
  /// Go's SessionTicketsDisabled: no session is resumed or kept
  session_tickets_disabled: Bool = false
  /// Go's EncryptedClientHelloConfigList (decision 0644 T13): an
  /// ECHConfigList (from the server's DNS HTTPS record); the hello then
  /// sends server_name and the rest encrypted to the first config it can
  /// use, under the config's public name, and offers TLS 1.3 alone
  /// (min_version and max_version must allow it). A server that rejects
  /// it fails the handshake with TlsErrKind.EchRejection once its
  /// certificate verifies for the public name.
  encrypted_client_hello_config_list: Bytes? = None
  /// Go's EncryptedClientHelloRejectionVerify: on a rejection, checks
  /// the state in place of the verification against the public name;
  /// an Err fails the handshake
  encrypted_client_hello_rejection_verify: (fn(ConnState) -> () ! Str)? = None
}

/// A client's session cache (Go's ClientSessionCache, decision 0644
/// T3); a handle: the copies of a ClientConfig share its sessions.
struct SessionCache {}

/// Go's NewLRUClientSessionCache: at most capacity sessions (below 1,
/// Go's 64), the least recently used replaced first.
fn lru_session_cache(capacity: Int) -> SessionCache

/// What a server's CertificateRequest asks for (Go's
/// CertificateRequestInfo): the DER names of the CAs it accepts ([]:
/// any), the signature schemes it verifies, and the version.
struct CertificateRequestInfo {
  acceptable_cas: List[Bytes]
  signature_schemes: List[Int]
  version: Int
}

/// Go's SupportsCertificate: Ok when cert signs with a scheme the
/// request lists and one of its chain was issued by an acceptable CA.
fn (i: CertificateRequestInfo) supports_certificate(cert: TlsCert) -> () ! TlsErr

/// The TLS client on connection c with config (Go's tls.Client and
/// Handshake): as client, with ClientConfig's hooks.
fn client_config(c: Conn, config: ClientConfig) -> TlsConn ! NetErr uses net.dial
/// A client on c under config that has not handshaked (Go's tls.Client):
/// the handshake runs at the first handshake, read or write, under the
/// connection's deadlines, and its failure is the connection's err()
/// (decision 0644 T12).
fn client_conn(c: Conn, config: ClientConfig) -> TlsConn
/// Runs the handshake now if it has not run (Go's Conn.Handshake): its
/// Err again on every later call when it failed; Ok on a connection
/// client, dial or their config forms made, which handshake at once.
fn (t: TlsConn) handshake() -> () ! NetErr uses net.dial
/// The connection's first failure, typed (decision 0644 T12, Go's error
/// types under the Io's text): of the handshake, a read or a write; None
/// while there is none. A Timeout is not one: the connection stays usable.
fn (t: TlsConn) err() -> TlsErr?
/// Dials addr on net and runs client_config (Go's tls.Dial,
/// DialWithDialer with Timeout): as dial.
fn dial_config(net: Net, addr: Str, config: ClientConfig, timeout: Duration? = None) -> TlsConn ! NetErr uses net.dial
/// A client that dials and runs the handshake with one configuration
/// (Go's tls.Dialer: Config, and NetDialer's Timeout for the dial and the
/// handshake together). `Dialer{config: c}.dial(net, addr)` is
/// `dial_config(net, addr, c)`; Go's nil Config is ClientConfig's
/// defaults.
struct Dialer {
  config: ClientConfig
  /// the dial and handshake's limit together (Go's NetDialer.Timeout);
  /// None: no limit
  timeout: Duration? = None
}

/// Dials addr on net and runs the handshake (Go's Dialer.Dial and
/// DialContext, whose cancellation is the calling task's): as
/// dial_config with the Dialer's config and timeout.
fn (d: Dialer) dial(net: Net, addr: Str) -> TlsConn ! NetErr uses net.dial
/// Reads a PEM certificate chain and its PEM private key from two files
/// (Go's tls.LoadX509KeyPair); a file that cannot be read is the Err's
/// text, as `open NAME: ...`.
fn load_cert(fs: Fs, cert_file: Str, key_file: Str) -> TlsCert ! TlsErr uses fs.read
/// A verify_conn function (also Client.with_verify_conn's) that accepts a server whose leaf certificate's DER has the
/// SHA-1 digest pin (hex, colons and spaces ignored; Service Fabric's thumbprint), compared in constant time; the
/// text of a bad pin is the Err of the call.
fn pin_sha1(pin: Str) -> (fn(List[x509.Certificate]) -> () ! Str) ! Str
/// Like pin_sha1, over SHA-256.
fn pin_sha256(pin: Str) -> (fn(List[x509.Certificate]) -> () ! Str) ! Str
fn (t: TlsConn) read(max: Int) -> Bytes? ! NetErr uses net.dial
fn (t: TlsConn) write(data: Bytes) -> () ! NetErr uses net.dial
fn (t: TlsConn) close()
/// The connection's deadlines (decision 0430), Go's tls.Conn SetDeadline:
/// a read or write past t fails with Timeout and the connection stays
/// usable, mid-record included; they apply to the handshake too when set
/// on the Conn before `client`.
fn (t: TlsConn) set_deadline(clock: Clock, at: Time?) uses clock
fn (t: TlsConn) set_read_deadline(clock: Clock, at: Time?) uses clock
fn (t: TlsConn) set_write_deadline(clock: Clock, at: Time?) uses clock
/// The connection under the TLS one (Go's Conn.NetConn); reading or
/// writing it directly breaks the TLS stream.
fn (t: TlsConn) net_conn() -> Conn
/// Checks the server's leaf certificate against host (Go's
/// Conn.VerifyHostname): Err when the chain was not verified
/// (`tls: handshake did not verify certificate chain`, verify None or
/// FakeNet) or the name does not match (x509's verify_hostname text).
fn (t: TlsConn) verify_hostname(host: Str) -> () ! TlsErr
/// The connection's addresses (Go's Conn.LocalAddr and RemoteAddr), as
/// Conn's local_addr and remote_addr.
fn (t: TlsConn) local_addr() -> Str
fn (t: TlsConn) remote_addr() -> Str
/// Sends close_notify and shuts the connection's sending side (Go's
/// Conn.CloseWrite): the peer reads the end of the stream, reads here go
/// on, and a later write fails with `tls: protocol is shutdown`.
fn (t: TlsConn) close_write() -> () ! NetErr uses net.dial
/// The protocol the server chose by ALPN, "" for none.
fn (t: TlsConn) alpn() -> Str
/// "TLS 1.2" or "TLS 1.3".
fn (t: TlsConn) version() -> Str
/// The server's certificates as it sent them, leaf first (Go's
/// ConnectionState.PeerCertificates); empty without TLS (FakeNet).
fn (t: TlsConn) peer_certificates() -> List[x509.Certificate]

/// What the handshake negotiated (Go's ConnectionState; decision 0644).
/// version, cipher_suite and curve_id are Go's numbers (version_name,
/// cipher_suite_name and curve_name give Go's texts);
/// negotiated_protocol is ALPN's choice ("" for none); server_name is the
/// name the client asked for. verified_chains holds the chains the
/// verification built (a client's of the server's chain under
/// Verify.Full, a server's of a client certificate), empty when nothing
/// was verified. The fields after verified_chains are
/// filled by later pieces of decision 0644 and are empty until then.
struct ConnState {
  version: Int
  handshake_complete: Bool
  did_resume: Bool
  cipher_suite: Int
  curve_id: Int
  negotiated_protocol: Str
  negotiated_protocol_is_mutual: Bool = true
  server_name: Str
  peer_certificates: List[x509.Certificate]
  verified_chains: List[List[x509.Certificate]]
  signed_certificate_timestamps: List[Bytes] = []
  ocsp_response: Bytes = b""
  tls_unique: Bytes = b""
  ech_accepted: Bool = false
}

/// The connection's ConnState; without TLS (FakeNet) a TLS 1.3 state
/// with no suite, curve or certificates.
fn (t: TlsConn) state() -> ConnState

/// Go's ConnectionState.ExportKeyingMaterial (RFC 5705; TLS 1.3's RFC
/// 8446 7.5): length bytes of keying material for label and context
/// (None is Go's nil context, which TLS 1.2 tells apart from an empty
/// one), with Go's errors: a reserved label, a context of 64 KiB or more,
/// and TLS 1.2 without Extended Master Secret (decision 0644 T9).
fn (t: TlsConn) export_keying_material(label: Str, context: Bytes?, length: Int) -> Bytes ! TlsErr

/// Go's protocol versions (VersionTLS10 to VersionTLS13); Xo speaks 1.2
/// and 1.3.
const VERSION_TLS10: Int = 0x0301
const VERSION_TLS11: Int = 0x0302
const VERSION_TLS12: Int = 0x0303
const VERSION_TLS13: Int = 0x0304

/// Go's cipher suite IDs for the suites Xo implements.
const TLS_AES_128_GCM_SHA256: Int = 0x1301
const TLS_AES_256_GCM_SHA384: Int = 0x1302
const TLS_CHACHA20_POLY1305_SHA256: Int = 0x1303
const TLS_ECDHE_ECDSA_WITH_AES_128_CBC_SHA: Int = 0xc009
const TLS_ECDHE_ECDSA_WITH_AES_256_CBC_SHA: Int = 0xc00a
const TLS_ECDHE_RSA_WITH_AES_128_CBC_SHA: Int = 0xc013
const TLS_ECDHE_RSA_WITH_AES_256_CBC_SHA: Int = 0xc014
const TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256: Int = 0xc02b
const TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384: Int = 0xc02c
const TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256: Int = 0xc02f
const TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384: Int = 0xc030
const TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256: Int = 0xcca8
const TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256: Int = 0xcca9

/// Go's CurveID values.
const CURVE_P256: Int = 23
const CURVE_P384: Int = 24
const CURVE_P521: Int = 25
const X25519: Int = 29
const SECP256R1_MLKEM768: Int = 4587
const X25519_MLKEM768: Int = 4588
const SECP384R1_MLKEM1024: Int = 4589

/// A cipher suite (Go's tls.CipherSuite).
struct CipherSuite {
  id: Int
  name: Str
  supported_versions: List[Int]
  insecure: Bool
}

/// The suites Xo implements that are not insecure, in Go's
/// tls.CipherSuites order.
fn cipher_suites() -> List[CipherSuite]

/// The insecure suites Xo implements (Go's tls.InsecureCipherSuites);
/// Xo implements none, so it is empty: Go's RC4, 3DES, CBC-SHA256 and
/// RSA key exchange suites are not offered or accepted.
fn insecure_cipher_suites() -> List[CipherSuite]

/// Go's tls.CipherSuiteName: the suite's name, `0x%04X` for one Go does
/// not name.
fn cipher_suite_name(id: Int) -> Str

/// Go's tls.VersionName: `TLS 1.3`, `TLS 1.2`, ..., `0x%04X` otherwise.
fn version_name(version: Int) -> Str

/// Go's CurveID.String: `X25519`, `CurveP256`, `X25519MLKEM768`, ...,
/// `CurveID(N)` otherwise.
fn curve_name(id: Int) -> Str

/// A TLS server's settings (Go's Config, the fields a server reads;
/// decision 0644). A plain value: each tls.server call reads the one it
/// is given.
struct ServerConfig {
  /// the chains with their keys; the first unless SNI names another's
  /// certificate (Go's Certificates)
  certificates: List[TlsCert]
  /// the ALPN protocols offered, most preferred first (Go's NextProtos);
  /// [] negotiates none
  next_protos: List[Str] = []
  /// what is asked of a client's certificate (Go's ClientAuth)
  client_auth: ClientAuth = ClientAuth.None
  /// the roots that verify client certificates (Go's ClientCAs; None:
  /// no CA is named and a certificate that must verify fails)
  client_cas: Roots? = None
  /// Go's MinVersion and MaxVersion (0: TLS 1.2 and 1.3; decision 0644 T7)
  min_version: Int = 0
  max_version: Int = 0
  /// the TLS 1.2 suites accepted (Go's CipherSuites; []: Go's defaults);
  /// the server picks in Go's order, whatever the list's
  cipher_suites: List[Int] = []
  /// the key exchanges accepted (Go's CurvePreferences; []: Go's
  /// defaults), in Go's order
  curve_preferences: List[Int] = []
  /// Go's VerifyPeerCertificate: the client's certificates (DER, the
  /// leaf first; [] when it sent none) and the chains that verified
  /// them, when client_auth asks for one; an Err fails the handshake
  /// (decision 0644 T6)
  verify_peer_certificate: (fn(List[Bytes], List[List[x509.Certificate]]) -> () ! Str uses sync)? = None
  /// Go's VerifyConnection: the state so far (handshake_complete false)
  /// on every handshake, resumptions too; an Err fails it
  verify_connection: (fn(ConnState) -> () ! Str uses sync)? = None
  /// Go's GetCertificate: the certificate for a ClientHello (called
  /// when certificates is empty or the client sent a server name); None
  /// falls back to certificates, and an Err fails the handshake with its
  /// text (decision 0644 T5)
  get_certificate: (fn(ClientHelloInfo) -> TlsCert? ! Str uses sync)? = None
  /// Go's GetConfigForClient: the settings for the rest of a handshake
  /// from its ClientHello (their own get_config_for_client is not
  /// called); None keeps these, and an Err fails the handshake
  get_config_for_client: (fn(ClientHelloInfo) -> ServerConfig? ! Str uses sync)? = None
  /// as ClientConfig's (Go's KeyLogWriter, decision 0644 T8)
  key_log: (fn(Str) -> () ! Str uses sync)? = None
  /// Go's SessionTicketsDisabled: no session tickets, so no client
  /// resumes (decision 0644 T4)
  session_tickets_disabled: Bool = false
  /// Go's SetSessionTicketKeys: the first seals new tickets, every one
  /// opens them (rotate by putting a new key first). [] is automatic
  /// keys: a TlsListener's, made and rotated as Go's (a new key a day,
  /// each opening tickets a week); a `server` outside a listener issues
  /// none, since its keys would open no other connection's ticket
  session_ticket_keys: List[TicketKey] = []
  /// Go's EncryptedClientHelloKeys (decision 0644 T13): the keys that
  /// decrypt a client's Encrypted Client Hello, tried in order; those
  /// with send_as_retry are sent to a client whose ECH none opens
  encrypted_client_hello_keys: List[EchKey] = []
  /// Go's GetEncryptedClientHelloKeys: the keys for a ClientHello in
  /// place of encrypted_client_hello_keys; an Err fails the handshake
  get_encrypted_client_hello_keys: (fn(ClientHelloInfo) -> List[EchKey] ! Str)? = None
}

/// A server's ECH key (Go's EncryptedClientHelloKey): an ECHConfig
/// (its whole encoding, as in an ECHConfigList), the HPKE private key of
/// its KEM, and whether the config is a retry config.
struct EchKey {
  config: Bytes
  private_key: Bytes
  send_as_retry: Bool = false
}

/// A session ticket key (Go's SetSessionTicketKeys key, decision 0644
/// T4); a handle.
struct TicketKey {}

/// A ticket key of 32 bytes, from a secret source (rand, or a secret
/// shared by servers that resume each other's sessions); any other
/// length is an error.
fn ticket_key(key: Bytes) -> TicketKey ! TlsErr

/// What a client's ClientHello offers (Go's ClientHelloInfo; decision
/// 0644 T5): its cipher suites, server name (SNI; "" for none), curves
/// and point formats, signature schemes, ALPN protocols, versions and
/// the extension types in order, with the connection's addresses.
struct ClientHelloInfo {
  cipher_suites: List[Int]
  server_name: Str
  supported_curves: List[Int]
  supported_points: List[Int]
  signature_schemes: List[Int]
  supported_protos: List[Str]
  supported_versions: List[Int]
  extensions: List[Int]
  local_addr: Str
  remote_addr: Str
}

/// Go's ClientHelloInfo.SupportsCertificate under Go's default settings:
/// Ok when cert can serve this client (a common version, the server name,
/// a signature scheme, and for TLS 1.2 an ECDHE curve and a suite for its
/// key), else Go's reason.
fn (i: ClientHelloInfo) supports_certificate(cert: TlsCert) -> () ! TlsErr

/// The server side of a TLS connection (Go's tls.Server's Conn; decision
/// 0644): its reads and writes are `net.listen`. A handle.
struct TlsServerConn {}

/// The TLS server on connection c, which belongs to the result from then
/// on (Go's tls.Server): the handshake runs at the first handshake, read,
/// write or close_write, under the connection's deadlines.
fn server(c: ServerConn, config: ServerConfig) -> TlsServerConn
/// Runs the handshake now if it has not run (Go's Conn.Handshake): its
/// Err again on every later call when it failed; `Timeout` past the
/// connection's deadline. With no certificate:
/// `tls: no certificates configured`.
fn (t: TlsServerConn) handshake() -> () ! NetErr uses net.listen
/// The connection's first failure, typed, as TlsConn's err() (decision
/// 0644 T12): a client certificate that does not verify is
/// CertificateVerification, a client that does not speak TLS RecordHeader.
fn (t: TlsServerConn) err() -> TlsErr?
/// At most max bytes after the handshake; None when the client closed.
fn (t: TlsServerConn) read(max: Int) -> Bytes? ! NetErr uses net.listen
fn (t: TlsServerConn) write(data: Bytes) -> () ! NetErr uses net.listen
/// Sends close_notify (after a handshake) and closes the connection.
fn (t: TlsServerConn) close()
/// As TlsConn's close_write.
fn (t: TlsServerConn) close_write() -> () ! NetErr uses net.listen
fn (t: TlsServerConn) set_deadline(clock: Clock, at: Time?) uses clock
fn (t: TlsServerConn) set_read_deadline(clock: Clock, at: Time?) uses clock
fn (t: TlsServerConn) set_write_deadline(clock: Clock, at: Time?) uses clock
/// What the handshake negotiated; before it ran, handshake_complete is
/// false and the rest empty. peer_certificates are the client's,
/// verified_chains the chains that verified them.
fn (t: TlsServerConn) state() -> ConnState
/// As TlsConn's (decision 0644 T9).
fn (t: TlsServerConn) export_keying_material(label: Str, context: Bytes?, length: Int) -> Bytes ! TlsErr
fn (t: TlsServerConn) local_addr() -> Str
fn (t: TlsServerConn) remote_addr() -> Str
/// The connection under the TLS one (Go's Conn.NetConn).
fn (t: TlsServerConn) net_conn() -> ServerConn

/// A listener whose connections are TLS servers (Go's tls.Listen and
/// NewListener). A handle.
struct TlsListener {}
/// Listens on addr (Go's tls.Listen). Err when config has no certificate
/// (`tls: neither Certificates, GetCertificate, nor GetConfigForClient set
/// in Config`) or the listen fails.
fn listen(net: Net, addr: Str, config: ServerConfig) -> TlsListener ! NetErr uses net.listen
/// l's connections as TLS servers (Go's tls.NewListener).
fn new_listener(l: Listener, config: ServerConfig) -> TlsListener
/// The next connection, its handshake not yet run (Go's: so one slow
/// client does not hold up the accept loop).
fn (l: TlsListener) accept() -> TlsServerConn ! NetErr uses net.listen
fn (l: TlsListener) addr() -> Str
fn (l: TlsListener) close()

// ---------------------------------------------------------------------------
// QUIC (decision 0644 T14): Go's QUICConn, the TLS 1.3 handshake of RFC
// 9001 driven by a QUIC transport. The transport carries the handshake
// bytes in CRYPTO frames and protects packets with the secrets; TLS
// records are not used.

/// Go's QUICEncryptionLevel.
enum QuicEncryptionLevel {
  Initial
  Early
  Handshake
  Application
}

/// Go's String: "Initial", "Early", "Handshake", "Application".
fn (l: QuicEncryptionLevel) display() -> Str

/// Go's QUICEventKind.
enum QuicEventKind {
  /// No event is ready (Go's QUICNoEvent): feed the peer's data, or wait.
  NoEvent
  /// The read or write secret of level (level, data and suite set).
  /// Initial secrets come from the connection ID, not from here.
  SetReadSecret
  SetWriteSecret
  /// data goes to the peer in CRYPTO frames at level.
  WriteData
  /// The peer's transport parameters (data).
  TransportParameters
  /// set_transport_parameters must be called before the next next_event.
  TransportParametersRequired
  /// The server declined 0-RTT data (a client only).
  RejectedEarlyData
  /// The handshake is complete.
  HandshakeDone
  /// A client resumes a session, or a server got a client's ticket.
  ResumeSession
  /// A server sent state the client may resume (a client only).
  StoreSession
  /// A fatal error (err set): the connection must be closed.
  ErrorEvent
}

/// Go's QUICEvent: kind, and the fields that kind sets.
struct QuicEvent {
  kind: QuicEventKind
  level: QuicEncryptionLevel = QuicEncryptionLevel.Initial
  data: Bytes = b""
  suite: Int = 0
  err: TlsErr? = None
}

/// A QUIC connection's TLS side (Go's QUICConn); a handle. Its methods are
/// not for concurrent use, as Go's.
struct QuicConn {}

/// A client (Go's QUICClient). config's min_version must be
/// VERSION_TLS13 (RFC 9001 4.2; start refuses less, as Go), and
/// next_protos should be set: QUIC requires ALPN.
fn quic_client(config: ClientConfig) -> QuicConn

/// A server (Go's QUICServer).
fn quic_server(config: ServerConfig) -> QuicConn

/// Starts the handshake (Go's Start): a client's ClientHello is then in
/// next_event. Err when called twice (`tls: Start called more than
/// once`), or when min_version is below TLS 1.3 (`tls: Config MinVersion
/// must be at least TLS 1.3`). Cancelling the task stops a handshake
/// waiting in a hook.
fn (q: QuicConn) start() -> () ! TlsErr

/// The next event (Go's NextEvent); NoEvent when there is none.
fn (q: QuicConn) next_event() -> QuicEvent

/// Handshake bytes the peer sent at level in CRYPTO frames, in order;
/// any split (Go's HandleData). A handshake message too large, or data at
/// a level that has no read secret yet, is an error.
fn (q: QuicConn) handle_data(level: QuicEncryptionLevel, data: Bytes) -> () ! TlsErr

/// A server's session ticket, after HandshakeDone, once (Go's
/// SendSessionTicket); early_data marks it as accepting 0-RTT data and
/// extra is carried in it.
fn (q: QuicConn) send_session_ticket(early_data: Bool = false, extra: List[Bytes] = []) -> () ! TlsErr

/// The transport parameters to send (Go's SetTransportParameters), before
/// start or on TransportParametersRequired; empty is valid.
fn (q: QuicConn) set_transport_parameters(params: Bytes)

/// What the handshake negotiated (Go's ConnectionState).
fn (q: QuicConn) state() -> ConnState

/// Ends the connection (Go's Close); a handshake in progress stops.
fn (q: QuicConn) close() -> () ! TlsErr
