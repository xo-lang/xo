use std/embed
use std/log
use std/sql
use std/testing

fn ups(text: Str) -> List[Str] { (parse("1_t.sql", text) ?? e => fault("${e}")).up }
fn downs(text: Str) -> List[Str] { (parse("1_t.sql", text) ?? e => fault("${e}")).down }

test "endsWithSemicolon (TestSemicolons)" {
  expect(ends_with_semicolon("END;")) == true
  expect(ends_with_semicolon("END; -- comment")) == true
  expect(ends_with_semicolon("END   ; -- comment")) == true
  expect(ends_with_semicolon("END -- comment")) == false
  expect(ends_with_semicolon("END -- comment ;")) == false
  expect(ends_with_semicolon("END \" ; \" -- comment")) == false
}

const MULTILINE = "-- +goose Up\nCREATE TABLE post (\n\t\tid int NOT NULL,\n\t\ttitle text,\n\t\tbody text,\n\t\tPRIMARY KEY(id)\n);                  -- 1st stmt\n\n-- comment\nSELECT 2;           -- 2nd stmt\nSELECT 3; SELECT 3; -- 3rd stmt\nSELECT 4;           -- 4th stmt\n\n-- +goose Down\n-- comment\nDROP TABLE post;    -- 1st stmt\n"
const FUNCTXT = "-- +goose Up\nCREATE TABLE IF NOT EXISTS histories (\n\tid                BIGSERIAL  PRIMARY KEY,\n\tcurrent_value     varchar(2000) NOT NULL,\n\tcreated_at      timestamp with time zone  NOT NULL\n);\n\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION histories_partition_creation( DATE, DATE )\nreturns void AS $$\nDECLARE\n\tcreate_query text;\nBEGIN\n\tFOR create_query IN SELECT\n\t\t\t'CREATE TABLE IF NOT EXISTS histories_'\n\t\t\t|| TO_CHAR( d, 'YYYY_MM' )\n\t\t\t|| ' ( CHECK( created_at >= timestamp '''\n\t\t\t|| TO_CHAR( d, 'YYYY-MM-DD 00:00:00' )\n\t\t\t|| ''' AND created_at < timestamp '''\n\t\t\t|| TO_CHAR( d + INTERVAL '1 month', 'YYYY-MM-DD 00:00:00' )\n\t\t\t|| ''' ) ) inherits ( histories );'\n\t\tFROM generate_series( $1, $2, '1 month' ) AS d\n\tLOOP\n\t\tEXECUTE create_query;\n\tEND LOOP;  -- LOOP END\nEND;         -- FUNCTION END\n$$\nlanguage plpgsql;\n-- +goose StatementEnd\n\n-- +goose Down\ndrop function histories_partition_creation(DATE, DATE);\ndrop TABLE histories;\n"
const MYSQL_DELIMITER = "\n-- +goose Up\n-- +goose StatementBegin\nDELIMITER | \n-- +goose StatementEnd\n\n-- +goose StatementBegin\nCREATE FUNCTION my_func( str CHAR(255) ) RETURNS CHAR(255) DETERMINISTIC\nBEGIN \n  RETURN \"Dummy Body\"; \nEND | \n-- +goose StatementEnd\n\n-- +goose StatementBegin\nDELIMITER ; \n-- +goose StatementEnd\n\nselect my_func(\"123\") from dual;\n-- +goose Down\n"
const COPY_STDIN = "\n-- +goose Up\n-- +goose StatementBegin\nCOPY public.django_content_type (id, app_label, model) FROM stdin;\n1\tadmin\tlogentry\n2\tauth\tpermission\n3\tauth\tgroup\n4\tauth\tuser\n5\tcontenttypes\tcontenttype\n6\tsessions\tsession\n\\.\n-- +goose StatementEnd\n"
const PLPGSQL = "\n-- +goose Up\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = now();\n    RETURN NEW;\nEND;\n$$ language 'plpgsql';\n-- +goose StatementEnd\n-- +goose StatementBegin\nCREATE TRIGGER update_properties_updated_at BEFORE UPDATE ON properties FOR EACH ROW EXECUTE PROCEDURE  update_updated_at_column();\n-- +goose StatementEnd\n\n-- +goose Down\n-- +goose StatementBegin\nDROP TRIGGER update_properties_updated_at\n-- +goose StatementEnd\n-- +goose StatementBegin\nDROP FUNCTION update_updated_at_column()\n-- +goose StatementEnd\n"
const PLPGSQL_MIXED = "\n-- +goose Up\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = now();\n    RETURN NEW;\nEND;\n$$ language 'plpgsql';\n-- +goose StatementEnd\n\nCREATE TRIGGER update_properties_updated_at\nBEFORE UPDATE\nON properties \nFOR EACH ROW EXECUTE PROCEDURE  update_updated_at_column();\n\n-- +goose Down\nDROP TRIGGER update_properties_updated_at;\nDROP FUNCTION update_updated_at_column();\n"

test "statement counts per direction (TestSplitStatements)" {
  let cases: List[(Str, Int, Int)] = [
    (MULTILINE, 4, 1),
    ("-- +goose Up\n-- This is just a comment", 0, 0),
    ("\n\n-- comment\n-- +goose Up\n\n-- comment\n-- +goose Down\n\n", 0, 0),
    (FUNCTXT, 2, 2),
    (MYSQL_DELIMITER, 4, 0),
    (COPY_STDIN, 1, 0),
    (PLPGSQL, 2, 2),
    (PLPGSQL_MIXED, 2, 2),
  ]
  for (text, up, down) in cases {
    expect(ups(text).len()) == up
    expect(downs(text).len()) == down
  }
  expect(ups(MULTILINE)[2]) == "SELECT 3; SELECT 3; -- 3rd stmt"
  expect(downs(MULTILINE)) == ["DROP TABLE post;    -- 1st stmt"]
}

test "parsing errors (TestParsingErrors)" {
  let bad = [
    // statementBeginNoStatementEnd
    "-- +goose Up\nCREATE TABLE t (id int);\n\n-- +goose StatementBegin\nCREATE FUNCTION f() returns void AS $$\nBEGIN\n  SELECT 1;\nEND;\n$$\nlanguage plpgsql;\n\n-- +goose Down\ndrop TABLE t;\n",
    // unfinishedSQL
    "\n-- +goose Up\nALTER TABLE post\n\n-- +goose Down\n",
    // noUpDownAnnotations
    "\nCREATE TABLE post (\n    id int NOT NULL,\n    PRIMARY KEY(id)\n);\n",
    // multiUpDown
    "-- +goose Up\nCREATE TABLE post (id int);\n\n-- +goose Down\nDROP TABLE post;\n\n-- +goose Up\nCREATE TABLE fancier_post (id int);\n",
    // downFirst
    "-- +goose Down\nDROP TABLE fancier_post;\n",
  ]
  for text in bad {
    expect(parse("1_t.sql", text).is_ok()) == false
  }
  match parse("1_t.sql", "\n-- +goose Up\nALTER TABLE post\n\n-- +goose Down\n") {
    Err(MigrateErr.Parse(_, msg)) => expect(msg.contains("unexpected unfinished SQL query") && msg.contains("missing semicolon?")) == true
    _ => fault("want a parse error")
  }
}

test "every testdata/invalid/up file fails (TestInvalidUp)" {
  expect(invalid_up().len()) == 4
  for (name, text) in invalid_up() {
    expect(parse(name, text).is_ok()) == false
  }
}

test "NO TRANSACTION (TestUseTransactions)" {
  for (name, text, tx) in valid_txn() {
    expect((parse(name, text) ?? e => fault("${e}")).tx) == tx
  }
}

test "Up statements match testdata/valid-up's goldens (TestValidUp)" {
  expect(valid_up().len()) == 9
  for (dir, input, want) in valid_up() {
    let got = ups(input)
    expect("${dir}: ${got.len()}") == "${dir}: ${want.len()}"
    for i in 0..want.len() {
      expect(got[i]) == want[i]
    }
  }
}

test "annotations (Test_extractAnnotation)" {
  expect(annotation("-- +goose Up").ok()) == Some("Up")
  expect(annotation("-- +goose Down").ok()) == Some("Down")
  expect(annotation("-- +goose StatementBegin").ok()) == Some("StatementBegin")
  expect(annotation("-- +goose NO TRANSACTION").ok()) == Some("NO TRANSACTION")
  expect(annotation("-- +goose unsupported").is_ok()) == false
  expect(annotation("-- +goose").is_ok()) == false
  expect(annotation("-- +goose   UP \t").ok()) == Some("Up")
  expect(annotation(" -- +goose   UP \t").is_ok()) == false
  expect(annotation("\t-- +goose   UP \t").is_ok()) == false
  expect(annotation("-- +goose +goose Up").is_ok()) == false
}

// goose's TestEnvsub environment (internal/sqlparser/parser_test.go)
fn envsub_env() -> Map[Str, Str] {
  {"GOOSE_ENV_REGION": "us_east_", "GOOSE_ENV_SET_BUT_EMPTY_VALUE": "", "GOOSE_ENV_NAME": "foo"}
}

test "TestEnvsub test01: ENVSUB ON before Up substitutes both directions" {
  let text = r"""
-- +goose ENVSUB ON
-- +goose Up
CREATE TABLE ${GOOSE_ENV_REGION}post (
		id int NOT NULL,
		title text,
		body text,
		PRIMARY KEY(id)
);                  -- 1st stmt

-- comment
SELECT 2;           -- 2nd stmt
SELECT 3; SELECT 3; -- 3rd stmt
SELECT 4;           -- 4th stmt

-- +goose Down
-- comment
DROP TABLE ${GOOSE_ENV_REGION}post;    -- 1st stmt
"""
  let m = parse("1_t.sql", text, envsub_env()).ok() ?? fault("parse")
  expect(m.up) == [
    "CREATE TABLE us_east_post (\n\t\tid int NOT NULL,\n\t\ttitle text,\n\t\tbody text,\n\t\tPRIMARY KEY(id)\n);                  -- 1st stmt",
    "SELECT 2;           -- 2nd stmt",
    "SELECT 3; SELECT 3; -- 3rd stmt",
    "SELECT 4;           -- 4th stmt",
  ]
  expect(m.down) == ["DROP TABLE us_east_post;    -- 1st stmt"]
}

test "TestEnvsub test02: ENVSUB OFF stops it, and it works inside StatementBegin" {
  let text = r"""
-- +goose Up

-- +goose ENVSUB ON
CREATE TABLE post (
	id int NOT NULL,
	title text,
	$GOOSE_ENV_NAME text,
	${GOOSE_ENV_NAME}title3 text,
	${ANOTHER_VAR:-default}title4 text,
	${GOOSE_ENV_SET_BUT_EMPTY_VALUE-default}title5 text,
);
-- +goose ENVSUB OFF

CREATE TABLE post (
	id int NOT NULL,
	title text,
	$GOOSE_ENV_NAME text,
	${GOOSE_ENV_NAME}title3 text,
	${ANOTHER_VAR:-default}title4 text,
	${GOOSE_ENV_SET_BUT_EMPTY_VALUE-default}title5 text,
);

-- +goose StatementBegin
CREATE OR REPLACE FUNCTION test_func()
RETURNS void AS $$
-- +goose ENVSUB ON
BEGIN
	RAISE NOTICE '${GOOSE_ENV_NAME} \$GOOSE_ENV_NAME \$GOOSE_ENV_NAME';
END;
-- +goose ENVSUB OFF
$$ LANGUAGE plpgsql;
-- +goose StatementEnd
"""
  let m = parse("2_t.sql", text, envsub_env()).ok() ?? fault("parse")
  expect(m.up) == [
    "CREATE TABLE post (\n\tid int NOT NULL,\n\ttitle text,\n\tfoo text,\n\tfootitle3 text,\n\tdefaulttitle4 text,\n\ttitle5 text,\n);",
    r"CREATE TABLE post (" + "\n\tid int NOT NULL,\n\ttitle text,\n\t" + r"$GOOSE_ENV_NAME text," + "\n\t" + r"${GOOSE_ENV_NAME}title3 text," + "\n\t" + r"${ANOTHER_VAR:-default}title4 text," + "\n\t" + r"${GOOSE_ENV_SET_BUT_EMPTY_VALUE-default}title5 text," + "\n);",
    "CREATE OR REPLACE FUNCTION test_func()\nRETURNS void AS $$\nBEGIN\n\tRAISE NOTICE 'foo $GOOSE_ENV_NAME $GOOSE_ENV_NAME';\nEND;\n$$ LANGUAGE plpgsql;",
  ]
  expect(m.down) == []
}

test "TestEnvsub test03: no ENVSUB ON, no substitution" {
  let text = r"""
-- +goose Up
CREATE TABLE post (
	id int NOT NULL,
	$NAME text,
	${ANOTHER_VAR:-default}title4 text,
);
"""
  let m = parse("3_t.sql", text, envsub_env()).ok() ?? fault("parse")
  expect(m.up) == [r"CREATE TABLE post (" + "\n\tid int NOT NULL,\n\t" + r"$NAME text," + "\n\t" + r"${ANOTHER_VAR:-default}title4 text," + "\n);"]
}

test "TestEnvsubError: an unset required variable fails the parse" {
  let text = r"""
-- +goose ENVSUB ON
-- +goose Up
CREATE TABLE post (
	id int NOT NULL,
	title text,
	${SOME_UNSET_VAR?required env var not set} text,
	PRIMARY KEY(id)
);
"""
  match parse("4_t.sql", text, envsub_env()) {
    Err(MigrateErr.Parse(_, msg)) => expect(msg.contains(r"variable substitution failed: $SOME_UNSET_VAR: required env var not set:")) == true
    _ => fault("want a parse error")
  }
}

test "collect passes env to each file" {
  let files = dir({"1_a.sql": "-- +goose ENVSUB ON\n-- +goose Up\nSELECT '" + r"${GOOSE_ENV_NAME}" + "';\n"})
  let ms = collect(files, env: envsub_env()).ok() ?? fault("collect")
  expect(ms[0].up) == ["SELECT 'foo';"]
}

test "interpolate's grammar" {
  let env: Map[Str, Str] = {"A": "hello", "E": "", "Ünï": "u"}
  for (in_, want) in [
    (r"\\x", r"\\x"),
    (r"\$A $$A", r"$A $A"),
    (r"$(cmd) $A", "$(cmd) hello"),
    (r"$A-$Ünï", "hello-u"),
    (r"${B} ${B:-d} ${E:-d} ${E-d} ${B-d}", " d d  d"),
    (r"${A:-${B}x}", "hello"),
    (r"${B:-${A}x}", "hellox"),
    (r"${A:1} ${A:1:3} ${A: -3} ${A: -3:2} ${A: 1:-1} ${A:9} ${A:-3}", "ello ell llo ll ell  hello"),
    (r"${A?gone}", "hello"),
    (r"${E?gone}", ""),
    (r"${A:-${B?unused}}", "hello"),
    ("cost $", "cost $"),
  ] {
    expect(envsub(in_, env)) == Ok(want)
  }
  for (in_, want) in [
    (r"${B?}", r"$B: not set"),
    (r"${B?need ${A}}", r"$B: need hello"),
    (r"$1", "Expected identifier to start with a letter, got 1"),
    (r"${A%x}", "Expected an operator, got %"),
    (r"${A", "Expected an operator, got \u{FFFD}"),
    (r"${A:x}", "Unable to parse offset: strconv.Atoi: parsing \"x\": invalid syntax"),
    (r"${A:1:y}", "Unable to parse length: strconv.Atoi: parsing \"y\": invalid syntax"),
    (r"${A:-x", "Expected brace expansion to end with }, got \u{FFFD}"),
    (r"${B?x} ${A", "Expected an operator, got \u{FFFD}"),
  ] {
    expect(envsub(in_, env)) == Err(want)
  }
}

fn dir(files: Map[Str, Str]) -> embed.Dir {
  var m: Map[Str, Bytes] = {}
  for (k, v) in files {
    m[k] = v.bytes()
  }
  embed.Dir{files: m}
}

test "ParseAllFromFS: empty file and all_statements" {
  match parse("001_foo.sql", "") {
    Err(MigrateErr.Parse(_, msg)) => expect(msg.contains("must start with '-- +goose Up' annotation")) == true
    _ => fault("want a parse error")
  }
  let ms = collect(dir({
    "001_foo.sql": "\n-- +goose Up\n",
    "002_bar.sql": "\n-- +goose Up\n-- +goose Down\n",
    "003_baz.sql": "\n-- +goose Up\nCREATE TABLE foo (id int);\nCREATE TABLE bar (id int);\n\n-- +goose Down\nDROP TABLE bar;\n",
    "004_qux.sql": "\n-- +goose NO TRANSACTION\n-- +goose Up\nCREATE TABLE foo (id int);\n-- +goose Down\nDROP TABLE foo;\n",
  })) ?? e => fault("${e}")
  expect(ms.map(fn(m) { (m.version, m.tx, m.up.len(), m.down.len()) })) == [(1, true, 0, 0), (2, true, 0, 0), (3, true, 2, 1), (4, false, 1, 1)]
}

const SQL1 = "-- +goose Up\nSELECT 1;\n"

test "file names (TestCollectFileSources, NumericComponent)" {
  expect(version_of("00001_foo.sql")) == Some(1)
  expect(version_of("00110_qux.sql")) == Some(110)
  expect(version_of("00000_foo.sql")) == None
  expect(version_of("not_valid.sql")) == None
  expect(version_of("1.sql")) == None
  expect(version_of("4_something.go")) == None
  expect(version_of("dir/7_x.sql")) == Some(7)
  // skip_random_files: other files and subdirectories are skipped
  let ms = collect(dir({
    "1_foo.sql": SQL1,
    "4_something.go": "package goose",
    "5_qux.sql": SQL1,
    "README.md": "# README",
    "LICENSE": "MIT",
    "no_a_real_migration.sql": "SELECT 1;",
    "some/other/dir/2_foo.sql": "SELECT 1;",
  })) ?? e => fault("${e}")
  expect(ms.map(fn(m) { (m.version, m.name) })) == [(1, "1_foo.sql"), (5, "5_qux.sql")]
  // duplicate_versions
  match collect(dir({"001_foo.sql": SQL1, "01_bar.sql": SQL1})) {
    Err(e) => expect(e.display().contains("found duplicate migration version 1")) == true
    Ok(_) => fault("want a duplicate error")
  }
}

const OWNERS = "-- +goose Up\nCREATE TABLE owners ( owner_name TEXT NOT NULL );\n"
const SEED = "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('seed-user-1');\nINSERT INTO owners (owner_name) VALUES ('seed-user-2');\nINSERT INTO owners (owner_name) VALUES ('seed-user-3');\n"

fn owners(db: sql.Db) -> Int uses net.dial {
  ((db.query_one("SELECT count(*) AS n FROM owners") ?? e => fault("${e}")).int("n")) ?? e => fault("${e}")
}

test "up applies in order once; status reports each (up_and_down_all, status)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
  let before = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(before.map(fn(s) { (s.version, s.applied_at.is_some()) })) == [(1, false), (2, false)]
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 2]
  expect(owners(db)) == 3
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == []
  expect(owners(db)) == 3
  let after = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(after.map(fn(s) { (s.version, s.name, s.applied_at.is_some()) })) == [(1, "00001_owners.sql", true), (2, "00002_seed.sql", true)]
  // a new file later is applied alone
  let more = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS, "00003_more.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('x');\n"})
  expect(up(db, more, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [3]
  expect(owners(db)) == 4
}

test "a failed migration leaves the ones before it applied and none of itself (tx_partial_errors)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "00001_users_table.sql": OWNERS,
    "00002_partial_error.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('kept-only-on-success');\nINSERT INTO invalid_table (invalid_table) VALUES ('invalid_value');\n",
    "00003_insert_data.sql": SEED,
  })
  match up(db, files, os.clock, dialect: Dialect.Memory) {
    Err(MigrateErr.Failed(v, name, i, err)) => {
      expect((v, name, i)) == (2, "00002_partial_error.sql", 1)
      expect(err.display()) == "no such table: invalid_table"
    }
    r => fault("want Failed, got ${r:?}")
  }
  expect(owners(db)) == 0
  let st = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(st.map(fn(s) { s.applied_at.is_some() })) == [true, false, false]
}

test "a pending version below the newest applied one (TestPending)" {
  let db = sql.memory() ?? e => fault("${e}")
  let first = dir({"00001_owners.sql": OWNERS, "00003_seed.sql": SEED})
  expect(up(db, first, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 3]
  let all = dir({"00001_owners.sql": OWNERS, "00002_one.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('two');\n", "00003_seed.sql": SEED})
  match up(db, all, os.clock, dialect: Dialect.Memory) {
    Err(e) => {
      expect(e.display().contains("missing (out-of-order) migration")) == true
      expect(e) == MigrateErr.Missing(versions: [2], newest: 3, to: Int.max)
      expect(e.display()) == "migrate: detected 1 missing (out-of-order) migration lower than database version (3): version 2"
    }
    Ok(vs) => fault("want Missing, got ${vs:?}")
  }
  expect(owners(db)) == 3
  expect(up(db, all, os.clock, dialect: Dialect.Memory, allow_missing: true) ?? e => fault("${e}")) == [2]
  expect(owners(db)) == 4
}

test "NO TRANSACTION statements run one by one: those before a failure stay" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "1_owners.sql": OWNERS,
    "2_nt.sql": "-- +goose NO TRANSACTION\n-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('a');\nINSERT INTO nope (x) VALUES (1);\n",
  })
  expect(up(db, files, os.clock, dialect: Dialect.Memory).is_ok()) == false
  expect(owners(db)) == 1
}

test "the version table's name is a parameter" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"1_owners.sql": OWNERS})
  expect(up(db, files, os.clock, table: "schema_a", dialect: Dialect.Memory) ?? e => fault("${e}")) == [1]
  let n = ((db.query_one("SELECT count(*) AS n FROM schema_a") ?? e => fault("${e}")).int("n")) ?? e => fault("${e}")
  expect(n) == 1
  match up(db, files, os.clock, table: "x; DROP TABLE owners", dialect: Dialect.Memory) {
    Err(e) => expect(e) == MigrateErr.Table(name: "x; DROP TABLE owners")
    Ok(_) => fault("want Table")
  }
  expect(check_table("public.xo_migrations").is_ok()) == true
  expect(check_table("1abc").is_ok()) == false
  expect(check_table("a.b.c").is_ok()) == false
}

// Generated from pressly/goose v3.27.3 internal/sqlparser/testdata
// (Copyright (c) 2012 Liam Staskawicz, MIT license).

/// testdata/valid-up: each input.sql with its golden Up statements.
fn valid_up() -> List[(Str, Str, List[Str])] { [
  ("test01", "-- +goose UP\nCREATE TABLE emp (\n    empname text,\n    salary integer,\n    last_date timestamp,\n    last_user text\n);\n\n-- +goose statementBegin\nCREATE FUNCTION emp_stamp() RETURNS trigger AS $emp_stamp$\n    BEGIN\n        -- Check that empname and salary are given\n        IF NEW.empname IS NULL THEN\n            RAISE EXCEPTION 'empname cannot be null';\n        END IF;\n        IF NEW.salary IS NULL THEN\n            RAISE EXCEPTION '% cannot have null salary', NEW.empname;\n        END IF;\n\n        -- Who works for us when they must pay for it?\n        IF NEW.salary < 0 THEN\n            RAISE EXCEPTION '% cannot have a negative salary', NEW.empname;\n        END IF;\n\n        -- Remember who changed the payroll when\n        NEW.last_date := current_timestamp;\n        NEW.last_user := current_user;\n        RETURN NEW;\n    END;\n$emp_stamp$ LANGUAGE plpgsql;\n-- +goose StatementEnd\n\nCREATE TRIGGER emp_stamp BEFORE INSERT OR UPDATE ON emp\n    FOR EACH ROW EXECUTE FUNCTION emp_stamp();\n\n-- +goose Down\n", [
    "CREATE TABLE emp (\n    empname text,\n    salary integer,\n    last_date timestamp,\n    last_user text\n);",
    "CREATE FUNCTION emp_stamp() RETURNS trigger AS $emp_stamp$\n    BEGIN\n        -- Check that empname and salary are given\n        IF NEW.empname IS NULL THEN\n            RAISE EXCEPTION 'empname cannot be null';\n        END IF;\n        IF NEW.salary IS NULL THEN\n            RAISE EXCEPTION '% cannot have null salary', NEW.empname;\n        END IF;\n\n        -- Who works for us when they must pay for it?\n        IF NEW.salary < 0 THEN\n            RAISE EXCEPTION '% cannot have a negative salary', NEW.empname;\n        END IF;\n\n        -- Remember who changed the payroll when\n        NEW.last_date := current_timestamp;\n        NEW.last_user := current_user;\n        RETURN NEW;\n    END;\n$emp_stamp$ LANGUAGE plpgsql;",
    "CREATE TRIGGER emp_stamp BEFORE INSERT OR UPDATE ON emp\n    FOR EACH ROW EXECUTE FUNCTION emp_stamp();",
  ]),
  ("test02", "-- +goose Up\n-- +goose StatementBegin\nCREATE TABLE emp (\n    empname           text NOT NULL,\n    salary            integer\n);\n\nCREATE TABLE emp_audit(\n    operation         char(1)   NOT NULL,\n    stamp             timestamp NOT NULL,\n    userid            text      NOT NULL,\n    empname           text      NOT NULL,\n    salary integer\n);\n\nCREATE OR REPLACE FUNCTION process_emp_audit() RETURNS TRIGGER AS $emp_audit$\n    BEGIN\n        --\n        -- Create a row in emp_audit to reflect the operation performed on emp,\n        -- making use of the special variable TG_OP to work out the operation.\n        --\n        IF (TG_OP = 'DELETE') THEN\n            INSERT INTO emp_audit SELECT 'D', now(), user, OLD.*;\n        ELSIF (TG_OP = 'UPDATE') THEN\n            INSERT INTO emp_audit SELECT 'U', now(), user, NEW.*;\n        ELSIF (TG_OP = 'INSERT') THEN\n            INSERT INTO emp_audit SELECT 'I', now(), user, NEW.*;\n        END IF;\n        RETURN NULL; -- result is ignored since this is an AFTER trigger\n    END;\n$emp_audit$ LANGUAGE plpgsql;\n\nCREATE TRIGGER emp_audit\nAFTER INSERT OR UPDATE OR DELETE ON emp\n    FOR EACH ROW EXECUTE FUNCTION process_emp_audit();\n-- +goose StatementEnd\n\n-- +goose Down\n", [
    "CREATE TABLE emp (\n    empname           text NOT NULL,\n    salary            integer\n);\n\nCREATE TABLE emp_audit(\n    operation         char(1)   NOT NULL,\n    stamp             timestamp NOT NULL,\n    userid            text      NOT NULL,\n    empname           text      NOT NULL,\n    salary integer\n);\n\nCREATE OR REPLACE FUNCTION process_emp_audit() RETURNS TRIGGER AS $emp_audit$\n    BEGIN\n        --\n        -- Create a row in emp_audit to reflect the operation performed on emp,\n        -- making use of the special variable TG_OP to work out the operation.\n        --\n        IF (TG_OP = 'DELETE') THEN\n            INSERT INTO emp_audit SELECT 'D', now(), user, OLD.*;\n        ELSIF (TG_OP = 'UPDATE') THEN\n            INSERT INTO emp_audit SELECT 'U', now(), user, NEW.*;\n        ELSIF (TG_OP = 'INSERT') THEN\n            INSERT INTO emp_audit SELECT 'I', now(), user, NEW.*;\n        END IF;\n        RETURN NULL; -- result is ignored since this is an AFTER trigger\n    END;\n$emp_audit$ LANGUAGE plpgsql;\n\nCREATE TRIGGER emp_audit\nAFTER INSERT OR UPDATE OR DELETE ON emp\n    FOR EACH ROW EXECUTE FUNCTION process_emp_audit();",
  ]),
  ("test03", "-- +goose Up\n-- +goose StatementBegin\nCREATE FUNCTION cs_update_referrer_type_proc() RETURNS INTEGER AS '\nDECLARE\n    referrer_keys RECORD;  -- Declare a generic record to be used in a FOR\n    a_output varchar(4000);\nBEGIN \n    a_output := ''CREATE FUNCTION cs_find_referrer_type(varchar,varchar,varchar) \n                  RETURNS VARCHAR AS '''' \n                     DECLARE \n                         v_host ALIAS FOR $1; \n                         v_domain ALIAS FOR $2; \n                         v_url ALIAS FOR $3;\n                     BEGIN ''; \n\n-- \n-- Notice how we scan through the results of a query in a FOR loop\n-- using the FOR <record> construct.\n--\n\n    FOR referrer_keys IN SELECT * FROM cs_referrer_keys ORDER BY try_order LOOP\n        a_output := a_output || '' IF v_'' || referrer_keys.kind || '' LIKE '''''''''' \n                 || referrer_keys.key_string || '''''''''' THEN RETURN '''''' \n                 || referrer_keys.referrer_type || ''''''; END IF;''; \n    END LOOP; \n  \n    a_output := a_output || '' RETURN NULL; END; '''' LANGUAGE ''''plpgsql'''';''; \n \n    -- This works because we are not substituting any variables\n    -- Otherwise it would fail. Look at PERFORM for another way to run functions\n    \n    EXECUTE a_output; \nEND; \n' LANGUAGE 'plpgsql'; -- This comment WILL BE preserved.\n-- And so will this one.\n-- +goose StatementEnd\n\n-- +goose Down\n", [
    "CREATE FUNCTION cs_update_referrer_type_proc() RETURNS INTEGER AS '\nDECLARE\n    referrer_keys RECORD;  -- Declare a generic record to be used in a FOR\n    a_output varchar(4000);\nBEGIN \n    a_output := ''CREATE FUNCTION cs_find_referrer_type(varchar,varchar,varchar) \n                  RETURNS VARCHAR AS '''' \n                     DECLARE \n                         v_host ALIAS FOR $1; \n                         v_domain ALIAS FOR $2; \n                         v_url ALIAS FOR $3;\n                     BEGIN ''; \n\n-- \n-- Notice how we scan through the results of a query in a FOR loop\n-- using the FOR <record> construct.\n--\n\n    FOR referrer_keys IN SELECT * FROM cs_referrer_keys ORDER BY try_order LOOP\n        a_output := a_output || '' IF v_'' || referrer_keys.kind || '' LIKE '''''''''' \n                 || referrer_keys.key_string || '''''''''' THEN RETURN '''''' \n                 || referrer_keys.referrer_type || ''''''; END IF;''; \n    END LOOP; \n  \n    a_output := a_output || '' RETURN NULL; END; '''' LANGUAGE ''''plpgsql'''';''; \n \n    -- This works because we are not substituting any variables\n    -- Otherwise it would fail. Look at PERFORM for another way to run functions\n    \n    EXECUTE a_output; \nEND; \n' LANGUAGE 'plpgsql'; -- This comment WILL BE preserved.\n-- And so will this one.",
  ]),
  ("test04", "-- +goose Up\n\nCREATE TABLE ssh_keys (\n    id integer NOT NULL,\n    \"publicKey\" text\n);\n\n-- +goose StatementBegin\nINSERT INTO ssh_keys (id, \"publicKey\") VALUES (1, 'fake fixture begin (goose testdata held a key here)\nnot-a-key line one\nnot-a-key line two\nfake fixture end\n');\n-- +goose StatementEnd\n\nINSERT INTO ssh_keys (id, \"publicKey\") VALUES (2, 'fake fixture begin (goose testdata held a key here)\nnot-a-key line one\nnot-a-key line two\nfake fixture end\n');\n\n-- +goose Down\n", [
    "CREATE TABLE ssh_keys (\n    id integer NOT NULL,\n    \"publicKey\" text\n);",
    "INSERT INTO ssh_keys (id, \"publicKey\") VALUES (1, 'fake fixture begin (goose testdata held a key here)\nnot-a-key line one\nnot-a-key line two\nfake fixture end\n');",
    "INSERT INTO ssh_keys (id, \"publicKey\") VALUES (2, 'fake fixture begin (goose testdata held a key here)\nnot-a-key line one\nnot-a-key line two\nfake fixture end\n');",
  ]),
  ("test05", "-- +goose Up\n\nCREATE TABLE ssh_keys (\n    id integer NOT NULL,\n    \"publicKey\" text\n-- insert comment there\n);\n-- insert comment there\n\n-- This is a dangling comment\n-- Another comment\n-- Foo comment\n\nCREATE TABLE ssh_keys_backup (\n    id integer NOT NULL,\n    -- insert comment here\n    \"publicKey\" text\n    -- insert comment there\n);\n\n\n-- +goose Down\n", [
    "CREATE TABLE ssh_keys (\n    id integer NOT NULL,\n    \"publicKey\" text\n-- insert comment there\n);",
    "CREATE TABLE ssh_keys_backup (\n    id integer NOT NULL,\n    -- insert comment here\n    \"publicKey\" text\n    -- insert comment there\n);",
  ]),
  ("test06", "-- +goose Up\n\nCREATE TABLE article (\n    id text,\n            content text);\n\nINSERT INTO article (id, content) VALUES ('id_0001',  E'# My markdown doc\n\nfirst paragraph\n\nsecond paragraph');\n\nINSERT INTO article (id, content) VALUES ('id_0002',  E'# My second \n\nmarkdown doc\n\nfirst paragraph\n\n-- with a comment\n    -- with an indent comment\n\nsecond paragraph');\n\n-- +goose StatementBegin\n\n\n\n\n-- 1 this comment will NOT be preserved\n  -- 2 this comment will NOT be preserved\n\n\nCREATE FUNCTION do_something(sql TEXT) RETURNS INTEGER AS $$\nBEGIN\n  -- initiate technology\n  PERFORM something_or_other(sql);\n\n  -- increase technology\n  PERFORM some_other_thing(sql);\n\n  -- technology was successful\n  RETURN 1;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- 3 this comment WILL BE preserved\n  -- 4 this comment WILL BE preserved\n\n\n-- +goose StatementEnd\n\nINSERT INTO post (id, title, body)\nVALUES ('id_01', 'my_title', '\nthis is an insert statement including empty lines.\n\nempty (blank) lines can be meaningful.\n\nleave the lines to keep the text syntax.\n');\n\n-- +goose Down\nTRUNCATE TABLE post; \n", [
    "CREATE TABLE article (\n    id text,\n            content text);",
    "INSERT INTO article (id, content) VALUES ('id_0001',  E'# My markdown doc\n\nfirst paragraph\n\nsecond paragraph');",
    "INSERT INTO article (id, content) VALUES ('id_0002',  E'# My second \n\nmarkdown doc\n\nfirst paragraph\n\n-- with a comment\n    -- with an indent comment\n\nsecond paragraph');",
    "CREATE FUNCTION do_something(sql TEXT) RETURNS INTEGER AS $$\nBEGIN\n  -- initiate technology\n  PERFORM something_or_other(sql);\n\n  -- increase technology\n  PERFORM some_other_thing(sql);\n\n  -- technology was successful\n  RETURN 1;\nEND;\n$$ LANGUAGE plpgsql;\n\n-- 3 this comment WILL BE preserved\n  -- 4 this comment WILL BE preserved",
    "INSERT INTO post (id, title, body)\nVALUES ('id_01', 'my_title', '\nthis is an insert statement including empty lines.\n\nempty (blank) lines can be meaningful.\n\nleave the lines to keep the text syntax.\n');",
  ]),
  ("test07", "    \n-- +goose Up\n-- +goose StatementBegin\nCREATE INDEX ON public.users (user_id);\n-- +goose StatementEnd\n\n-- +goose Down\n-- +goose StatementBegin\nDROP INDEX IF EXISTS users_user_id_idx;\n-- +goose StatementEnd\n", [
    "CREATE INDEX ON public.users (user_id);",
  ]),
  ("test08", "-- +goose Up\n\nCREATE TABLE `table_a` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;\n\nCREATE TABLE `table_b` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;\n\nCREATE TABLE `table_c` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;\n\n/*!80031 ALTER TABLE `table_a` MODIFY `column_1` TEXT NOT NULL */;\n/*!80031 ALTER TABLE `table_b` MODIFY `column_2` TEXT NOT NULL */;\n/*!80033 ALTER TABLE `table_c` MODIFY `column_3` TEXT NOT NULL */;\n", [
    "CREATE TABLE `table_a` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;",
    "CREATE TABLE `table_b` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;",
    "CREATE TABLE `table_c` (\n    `column_1` DATETIME DEFAULT NOW(),\n    `column_2` DATETIME DEFAULT NOW(),\n    `column_3` DATETIME DEFAULT NOW()\n) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4;",
    "/*!80031 ALTER TABLE `table_a` MODIFY `column_1` TEXT NOT NULL */;",
    "/*!80031 ALTER TABLE `table_b` MODIFY `column_2` TEXT NOT NULL */;",
    "/*!80033 ALTER TABLE `table_c` MODIFY `column_3` TEXT NOT NULL */;",
  ]),
  ("test09", "-- +goose Up\n-- +goose StatementBegin\ncreate table t ( id int );\nupdate rows set value = now() -- missing semicolon. valid statement because wrapped in goose annotation, but will fail when executed.\n-- +goose StatementEnd\n\n-- +goose Down\nDROP TABLE IF EXISTS t;\n", [
    "create table t ( id int );\nupdate rows set value = now() -- missing semicolon. valid statement because wrapped in goose annotation, but will fail when executed.",
  ]),
] }

/// testdata/invalid/up: every file fails to parse.
fn invalid_up() -> List[(Str, Str)] { [
  ("a.sql", "-- +goose Up\nSELECT * FROM foo;\nSELECT * FROM bar\n-- +goose Down\nSELECT * FROM baz;\n"),
  ("b.sql", "-- +goose Up\nSELECT * FROM bar\n-- +goose Down\nSELECT * FROM baz;\n"),
  ("c.sql", "-- +goose Up\nSELECT * FROM bar\n-- +goose Down\n"),
  ("d.sql", "-- +goose Up\nSELECT * FROM bar\n"),
] }

/// testdata/valid-txn: the file and whether it runs in a transaction.
fn valid_txn() -> List[(Str, Str, Bool)] { [
  ("00001_create_users_table.sql", "-- +goose Up\nCREATE TABLE users (\n    id int NOT NULL PRIMARY KEY,\n    username text,\n    name text,\n    surname text\n);\n\nINSERT INTO users VALUES\n(0, 'root', '', ''),\n(1, 'vojtechvitek', 'Vojtech', 'Vitek');\n\n-- +goose Down\nDROP TABLE users;\n", true),
  ("00002_rename_root.sql", "-- +goose Up\n-- +goose StatementBegin\nUPDATE users SET username='admin' WHERE username='root';\n-- +goose StatementEnd\n\n-- +goose Down\n-- +goose StatementBegin\nUPDATE users SET username='root' WHERE username='admin';\n-- +goose StatementEnd\n", true),
  ("00003_no_transaction.sql", "-- +goose NO TRANSACTION\n-- +goose Up\nCREATE TABLE post (\n    id int NOT NULL,\n    title text,\n    body text,\n    PRIMARY KEY(id)\n);\n\n-- +goose Down\nDROP TABLE post;\n", false),
] }

// ---------------------------------------------------------------------------
// up_versions (goose's internal/gooseutil/resolve_test.go)

fn uv(versions: List[Int], applied: List[Int], to: Int, allow: Bool) -> List[Int] {
  up_versions(versions, applied, to, allow) ?? e => fault("${e}")
}

fn uv_err(versions: List[Int], applied: List[Int], to: Int) -> Str {
  match up_versions(versions, applied, to) {
    Err(e) => e.display()
    Ok(vs) => fault("want Missing, got ${vs:?}")
  }
}

const MAX = Int.max

test "up_versions without allow_missing (TestResolveVersions not_allow_missing)" {
  expect(uv([], [], MAX, false)) == []
  expect(uv([1, 2, 3], [1, 2, 3], MAX, false)) == []
  expect(uv([1, 2, 3], [], MAX, false)) == [1, 2, 3]
  expect(uv([3], [3], MAX, false)) == []
  expect(uv([3, 4], [3], MAX, false)) == [4]
  expect(uv([1, 2, 3, 4, 5], [1, 2], 4, false)) == [3, 4]
  expect(uv([1, 2, 3, 4, 5], [1, 2], 0, false)) == []
  expect(uv_err([1, 2, 3, 4], [1, 3], MAX)) == "migrate: detected 1 missing (out-of-order) migration lower than database version (3): version 2"
  expect(uv_err([1, 2, 3, 4, 5], [2, 4, 5], MAX)) == "migrate: detected 2 missing (out-of-order) migrations lower than database version (5): versions 1,3"
  // target_lower_than_max
  expect(uv([1, 2, 3], [1, 3], 1, false)) == []
  expect(uv_err([1, 2, 3], [1, 3], 2)) == "migrate: detected 1 missing (out-of-order) migration lower than database version (3), with target version (2): version 2"
  expect(uv_err([1, 2, 3], [1, 3], 3)) == "migrate: detected 1 missing (out-of-order) migration lower than database version (3), with target version (3): version 2"
  expect(uv_err([1, 2, 3, 4, 5, 6], [1, 3, 4, 6], 4)) == "migrate: detected 1 missing (out-of-order) migration lower than database version (6), with target version (4): version 2"
  expect(uv_err([1, 2, 3, 4, 5, 6], [1, 3, 4, 6], 6)) == "migrate: detected 2 missing (out-of-order) migrations lower than database version (6), with target version (6): versions 2,5"
  match up_versions([1, 2, 3, 4], [1, 3]) {
    Err(e) => expect(e) == MigrateErr.Missing(versions: [2], newest: 3, to: MAX)
    Ok(vs) => fault("want Missing, got ${vs:?}")
  }
}

test "up_versions with allow_missing (TestResolveVersions allow_missing)" {
  expect(uv([], [], MAX, true)) == []
  expect(uv([1, 2, 3], [1, 2, 3], MAX, true)) == []
  expect(uv([1, 2, 3], [], MAX, true)) == [1, 2, 3]
  expect(uv([3], [3], MAX, true)) == []
  expect(uv([3, 4], [3], MAX, true)) == [4]
  expect(uv([1, 2, 3, 4, 5], [1, 2], 4, true)) == [3, 4]
  expect(uv([1, 2, 3, 4, 5], [1, 2], 0, true)) == []
  expect(uv([1, 2, 3], [1, 3], MAX, true)) == [2]
  expect(uv([1, 2, 3, 4, 5], [2, 4], MAX, true)) == [1, 3, 5]
  // target_lower_than_max
  expect(uv([1, 2, 3], [1, 3], 1, true)) == []
  expect(uv([1, 2, 3], [1, 3], 2, true)) == [2]
  expect(uv([1, 2, 3], [1, 3], 3, true)) == [2]
  expect(uv([1, 2, 3, 4, 5, 6], [1, 3, 4, 6], 4, true)) == [2]
  expect(uv([1, 2, 3, 4, 5, 6], [1, 3, 4, 6], 6, true)) == [2, 5]
  // unsorted input is sorted first
  expect(uv([3, 1, 2], [], MAX, false)) == [1, 2, 3]
}

// ---------------------------------------------------------------------------
// up to, by one, apply_version, db_version, has_pending
// (provider_run_test.go)

fn tables() -> embed.Dir {
  dir({
    "00001_a.sql": "-- +goose Up\nCREATE TABLE a ( x TEXT );\n",
    "00002_b.sql": "-- +goose Up\nCREATE TABLE b ( x TEXT );\n",
    "00003_c.sql": "-- +goose Up\nCREATE TABLE c ( x TEXT );\n",
    "00004_d.sql": "-- +goose Up\nCREATE TABLE d ( x TEXT );\n",
  })
}

test "up with a target applies up to it, inclusive (up_to)" {
  let db = sql.memory() ?? e => fault("${e}")
  expect(up(db, tables(), os.clock, dialect: Dialect.Memory, to: 2) ?? e => fault("${e}")) == [1, 2]
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 2
  expect(up(db, tables(), os.clock, dialect: Dialect.Memory, to: 2) ?? e => fault("${e}")) == []
  expect(up(db, tables(), os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [3, 4]
}

test "a target or version below 1 (run_zero)" {
  let db = sql.memory() ?? e => fault("${e}")
  match up(db, tables(), os.clock, dialect: Dialect.Memory, to: 0) {
    Err(e) => {
      expect(e) == MigrateErr.BadVersion(0)
      expect(e.display()) == "migrate: version must be greater than 0"
    }
    Ok(vs) => fault("want BadVersion, got ${vs:?}")
  }
  match apply_version(db, tables(), 0, os.clock, dialect: Dialect.Memory) {
    Err(e) => expect(e) == MigrateErr.BadVersion(0)
    Ok(_) => fault("want BadVersion")
  }
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 0
}

test "up_by_one applies one at a time, then NoNext (up_and_down_by_one)" {
  let db = sql.memory() ?? e => fault("${e}")
  for want in 1..5 {
    expect(up_by_one(db, tables(), os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == want
    expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == want
  }
  match up_by_one(db, tables(), os.clock, dialect: Dialect.Memory) {
    Err(e) => {
      expect(e) == MigrateErr.NoNext
      expect(e.display()) == "migrate: no next version found"
    }
    Ok(v) => fault("want NoNext, got ${v}")
  }
}

test "apply_version: unknown, then each, then again (apply_unknown_version, apply)" {
  let db = sql.memory() ?? e => fault("${e}")
  match apply_version(db, tables(), 999, os.clock, dialect: Dialect.Memory) {
    Err(e) => {
      expect(e) == MigrateErr.NotFound(999)
      expect(e.display()) == "migrate: version 999: version not found"
    }
    Ok(_) => fault("want NotFound")
  }
  for v in [1, 2, 3, 4] {
    apply_version(db, tables(), v, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  }
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 4
  match apply_version(db, tables(), 1, os.clock, dialect: Dialect.Memory) {
    Err(e) => {
      expect(e) == MigrateErr.AlreadyApplied(1)
      expect(e.display().contains("version 1: migration already applied")) == true
    }
    Ok(_) => fault("want AlreadyApplied")
  }
}

test "has_pending with allow_missing (TestPending allow_out_of_order)" {
  let db = sql.memory() ?? e => fault("${e}")
  apply_version(db, tables(), 1, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  apply_version(db, tables(), 3, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 3
  expect(has_pending(db, tables(), dialect: Dialect.Memory, allow_missing: true) ?? e => fault("${e}")) == true
  expect(up(db, tables(), os.clock, dialect: Dialect.Memory, allow_missing: true) ?? e => fault("${e}")) == [2, 4]
  expect(has_pending(db, tables(), dialect: Dialect.Memory, allow_missing: true) ?? e => fault("${e}")) == false
}

test "has_pending without allow_missing (TestPending disallow_out_of_order)" {
  for applied in [4, 3] {
    let db = sql.memory() ?? e => fault("${e}")
    apply_version(db, tables(), 1, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
    apply_version(db, tables(), applied, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
    expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == applied
    match has_pending(db, tables(), dialect: Dialect.Memory) {
      Err(e) => expect(e.display().contains("missing (out-of-order) migration")) == true
      Ok(b) => fault("want Missing, got ${b}")
    }
    match up(db, tables(), os.clock, dialect: Dialect.Memory) {
      Err(e) => expect(e.display().contains("missing (out-of-order) migration")) == true
      Ok(vs) => fault("want Missing, got ${vs:?}")
    }
  }
}

test "no migrations is an error (TestProvider empty)" {
  let db = sql.memory() ?? e => fault("${e}")
  let empty = dir({})
  // goose's mapFS under "migrations/" without fs.Sub: no top level file.
  let nested = dir({"migrations/001_foo.sql": "-- +goose Up\n", "migrations/002_bar.sql": "-- +goose Up\n"})
  for files in [empty, nested] {
    match up(db, files, os.clock, dialect: Dialect.Memory) {
      Err(NoMigrations) => {}
      Err(e) => fault("want NoMigrations, got ${e}")
      Ok(vs) => fault("want NoMigrations, got ${vs:?}")
    }
    match status(db, files, dialect: Dialect.Memory) {
      Err(e) => expect(e.display()) == "migrate: no migrations found"
      Ok(_) => fault("want NoMigrations")
    }
    match has_pending(db, files, dialect: Dialect.Memory) {
      Err(NoMigrations) => {}
      _ => fault("want NoMigrations")
    }
  }
  expect((collect(nested) ?? e => fault("${e}")).len()) == 0
  let sub = collect(nested.sub("migrations")) ?? e => fault("${e}")
  expect(sub.map(fn(m) { (m.version, m.name) })) == [(1, "001_foo.sql"), (2, "002_bar.sql")]
}

test "up_results: one per migration applied, empty ones marked (assertResult)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "00001_a.sql": "-- +goose Up\nCREATE TABLE a ( x TEXT );\n",
    "00002_empty.sql": "-- +goose Up\n",
    "00003_c.sql": "-- +goose Up\nCREATE TABLE c ( x TEXT );\n",
  })
  let rs = up_results(db, files, os.clock, dialect: Dialect.Memory, to: 2) ?? e => fault("${e}")
  expect(rs.map(fn(r) { (r.version, r.name, r.empty) })) == [(1, "00001_a.sql", false), (2, "00002_empty.sql", true)]
  expect(rs.all(fn(r) { r.duration >= 0s })) == true
  let more = up_results(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(more.map(fn(r) { r.version })) == [3]
  expect(up_results(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == []
}

test "MigrationResult display is goose's log line (MigrationResult.String)" {
  let r = MigrationResult{version: 5, name: "00005_posts_view.sql", duration: Duration.from_nanos(727_500), empty: false}
  expect(r.display()) == "OK    up 00005_posts_view.sql (727.5µs)"
  let e = MigrationResult{version: 6, name: "migrations/00006_posts_view-copy.sql", duration: Duration.from_nanos(378_334), empty: true}
  expect(e.display()) == "EMPTY up 00006_posts_view-copy.sql (378.33µs)"
  // truncateDuration: over 1s to 10ms, over 1ms to 10µs, over 1µs to 10ns.
  let long = MigrationResult{version: 7, name: "00007_x.sql", duration: Duration.from_nanos(1_234_567_891), empty: false}
  expect(long.display()) == "OK    up 00007_x.sql (1.23s)"
  let mid = MigrationResult{version: 8, name: "00008_x.sql", duration: Duration.from_nanos(12_345_678), empty: false}
  expect(mid.display()) == "OK    up 00008_x.sql (12.35ms)"
  let tiny = MigrationResult{version: 9, name: "00009_x.sql", duration: Duration.from_nanos(999), empty: false}
  expect(tiny.display()) == "OK    up 00009_x.sql (999ns)"
}

test "camel_case and snake_case (goose TestCamelSnake)" {
  let cases = [
    ("Add updated_at to users table", "AddUpdatedAtToUsersTable", "add_updated_at_to_users_table"),
    ("$()&^%(_--crazy__--input$)", "CrazyInput", "crazy_input"),
  ]
  for (input, camel, snake) in cases {
    expect(camel_case(input)) == camel
    expect(snake_case(input)) == snake
  }
}

test "create with sequential numbers from 00001 (goose TestSequential)" {
  var names: List[Str] = []
  for _ in 0..4 {
    names.push(create(os.fs, "create_table", os.clock, sequential: true) ?? e => fault("${e}"))
  }
  expect(names) == ["00001_create_table.sql", "00002_create_table.sql", "00003_create_table.sql", "00004_create_table.sql"]
  expect(os.fs.read_text("00001_create_table.sql") ?? e => fault("${e}")) == SQL_TEMPLATE
}

test "create stamps the clock's UTC time and fills the template" {
  os.clock.set(Time.from_unix(1_794_960_000))
  let f = create(os.fs, "Add users", os.clock, template: "-- {{.Version}} {{.CamelName}}\n") ?? e => fault("${e}")
  expect(f) == "20261118000000_add_users.sql"
  expect(os.fs.read_text(f) ?? e => fault("${e}")) == "-- 20261118000000 AddUsers\n"
  // The same second again is the same file: an error, nothing overwritten.
  match create(os.fs, "Add users", os.clock) {
    Ok(_) => fault("created twice")
    Err(e) => expect(e.display().contains("failed to create migration file")) == true
  }
}

test "fix renames timestamped files to sequential versions (goose TestFix)" {
  expect(fix(os.fs).is_err()) == true
  os.clock.set(Time.from_unix(1_794_960_000))
  for _ in 0..4 {
    let _ = create(os.fs, "create_table", os.clock) ?? e => fault("${e}")
    os.clock.advance(1s)
  }
  let renamed = fix(os.fs) ?? e => fault("${e}")
  expect(renamed.map(fn(p) { p.1 })) == ["00001_create_table.sql", "00002_create_table.sql", "00003_create_table.sql", "00004_create_table.sql"]
  expect(renamed[0].0) == "20261118000000_create_table.sql"
  // Two more timestamped files continue the sequence.
  for _ in 0..2 {
    let _ = create(os.fs, "create_table", os.clock) ?? e => fault("${e}")
    os.clock.advance(1s)
  }
  let more = fix(os.fs) ?? e => fault("${e}")
  expect(more.map(fn(p) { p.1 })) == ["00005_create_table.sql", "00006_create_table.sql"]
  let left = os.fs.read_dir(".") ?? e => fault("${e}")
  expect(left.len()) == 6
}

test "is_timestamp: goose's 14 digit time after the epoch" {
  expect(is_timestamp(20261118000000)) == true
  expect(is_timestamp(20240229235959)) == true
  expect(is_timestamp(20230229000000)) == false
  expect(is_timestamp(19700101000000)) == false
  expect(is_timestamp(1)) == false
  expect(is_timestamp(20261324000000)) == false
}

test "collect skips excluded names and versions (goose provider_collect excludes)" {
  let files = dir({
    "00001_foo.sql": OWNERS,
    "00002_bar.sql": SEED,
    "00003_baz.sql": SEED,
    "00110_qux.sql": SEED,
  })
  let by_name = collect(files, exclude_names: ["00002_bar.sql", "00110_qux.sql"]) ?? e => fault("${e}")
  expect(by_name.map(fn(m) { m.version })) == [1, 3]
  let by_version = collect(files, exclude_versions: [2, 110]) ?? e => fault("${e}")
  expect(by_version.map(fn(m) { m.version })) == [1, 3]
  // An excluded version is never a duplicate.
  let dup = dir({"00001_a.sql": OWNERS, "001_b.sql": OWNERS, "00002_c.sql": SEED})
  expect(collect(dup).is_err()) == true
  let kept = collect(dup, exclude_versions: [1]) ?? e => fault("${e}")
  expect(kept.map(fn(m) { m.name })) == ["00002_c.sql"]
  match collect(files, exclude_versions: [0]) {
    Err(MigrateErr.BadVersion(v)) => expect(v) == 0
    _ => fault("version 0 excluded")
  }
}

test "isolate_ddl runs every migration outside a transaction (goose WithIsolateDDL)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"00001_owners.sql": OWNERS, "00002_seed.sql": SEED})
  let ms = isolate_ddl(collect(files) ?? e => fault("${e}"))
  expect(ms.map(fn(m) { m.tx })) == [false, false]
  expect(up_list(db, ms, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 2]
  expect(owners(db)) == 3
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 2
}

test "up_unversioned applies every time and keeps no version table (goose WithDisableVersioning)" {
  let db = sql.memory() ?? e => fault("${e}")
  db.exec("CREATE TABLE owners ( owner_name TEXT NOT NULL )") ?? e => fault("${e}")
  let files = dir({"00001_seed.sql": SEED})
  let first = up_unversioned(db, files, os.clock) ?? e => fault("${e}")
  expect(first.map(fn(r) { r.name })) == ["00001_seed.sql"]
  expect(owners(db)) == 3
  up_unversioned(db, files, os.clock) ?? e => fault("${e}")
  expect(owners(db)) == 6
  expect(db.query_one("SELECT count(*) AS n FROM xo_migrations").is_err()) == true
}

fn tx_step(q: Str) -> CodeStep[()] {
  CodeStep.Tx(fn(t: sql.Tx[()]) -> () ! sql.SqlErr uses net.dial {
    t.exec(q)?
    Ok(())
  })
}

fn conn_step(q: Str) -> CodeStep[()] {
  CodeStep.NoTx(fn(c: sql.Conn[()]) -> () ! sql.SqlErr uses net.dial {
    c.exec(q)?
    Ok(())
  })
}

fn users(db: sql.Db) -> Int uses net.dial {
  ((db.query_one("SELECT count(*) AS n FROM users") ?? e => fault("${e}")).int("n")) ?? e => fault("${e}")
}

test "code migrations in a transaction, one by one (goose TestGoOnly with_tx)" {
  let db = sql.memory() ?? e => fault("${e}")
  let code = [
    CodeMigration{version: 1, name: "1", up: tx_step("CREATE TABLE users (id INTEGER PRIMARY KEY)")},
    CodeMigration{version: 2, name: "2", up: tx_step("INSERT INTO users (id) VALUES (1), (2), (3)")},
  ]
  let one = up_code_by_one(db, [], code, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect((one.version, one.empty)) == (1, false)
  expect(users(db)) == 0
  let two = up_code_by_one(db, [], code, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(two.version) == 2
  expect(users(db)) == 3
  match up_code_by_one(db, [], code, os.clock, dialect: Dialect.Memory) {
    Err(MigrateErr.NoNext) => {}
    _ => fault("a third migration")
  }
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 2
}

test "code migrations on the connection (goose TestGoOnly with_db)" {
  let db = sql.memory() ?? e => fault("${e}")
  let code = [
    CodeMigration{version: 1, name: "1", up: conn_step("CREATE TABLE users (id INTEGER PRIMARY KEY)")},
    CodeMigration{version: 2, name: "2", up: conn_step("INSERT INTO users (id) VALUES (1), (2), (3)")},
  ]
  expect(code.map(fn(c) { c.migration().tx })) == [false, false]
  let rs = up_code(db, [], code, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(rs.map(fn(r) { r.version })) == [1, 2]
  expect(users(db)) == 3
}

test "SQL and code migrations apply together in version order" {
  let db = sql.memory() ?? e => fault("${e}")
  let sqls = collect(dir({"00001_owners.sql": OWNERS, "00003_seed.sql": SEED})) ?? e => fault("${e}")
  let code = [CodeMigration{version: 2, name: "00002_users.go", up: tx_step("CREATE TABLE users (id INTEGER PRIMARY KEY)")}]
  let rs = up_code(db, sqls, code, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(rs.map(fn(r) { r.name })) == ["00001_owners.sql", "00002_users.go", "00003_seed.sql"]
  expect(owners(db)) == 3
  expect(users(db)) == 0
  var all = sqls.clone()
  all.push(code[0].migration())
  let st = status_list(db, all, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(st.map(fn(s) { (s.version, s.applied_at.is_some()) })) == [(1, true), (2, true), (3, true)]
  // One version may not be both.
  let twice = [CodeMigration{version: 1, name: "1", up: tx_step("SELECT 1")}]
  match up_code(db, sqls, twice, os.clock, dialect: Dialect.Memory) {
    Err(MigrateErr.Duplicate(v, _, _)) => expect(v) == 1
    _ => fault("a duplicate version ran")
  }
}

test "a failed code step rolls back its transaction and stops" {
  let db = sql.memory() ?? e => fault("${e}")
  let code = [
    CodeMigration{version: 1, name: "1", up: tx_step("CREATE TABLE users (id INTEGER PRIMARY KEY)")},
    CodeMigration{version: 2, name: "2", up: tx_step("INSERT INTO missing (id) VALUES (1)")},
    CodeMigration{version: 3, name: "3", up: tx_step("INSERT INTO users (id) VALUES (1)")},
  ]
  match up_code(db, [], code, os.clock, dialect: Dialect.Memory) {
    Err(MigrateErr.Failed(v, _, i, err)) => {
      expect((v, i)) == (2, 0)
      expect(err.display()) == "no such table: missing"
    }
    _ => fault("no failure")
  }
  expect(db_version(db, dialect: Dialect.Memory) ?? e => fault("${e}")) == 1
  expect(users(db)) == 0
}

// Layout.Goose: goose's goose_db_version (internal/dialects in pressly/goose
// v3.27.3; its store tests' rows), on sql.memory.
const GOOSE_TABLE = "CREATE TABLE goose_db_version (id INTEGER PRIMARY KEY, version_id BIGINT NOT NULL, is_applied BOOL NOT NULL, tstamp TIMESTAMP)"

fn goose_rows(db: sql.Db) -> List[(Int, Bool)] uses net.dial {
  let rows = db.query("SELECT version_id, is_applied FROM goose_db_version ORDER BY id") ?? e => fault("${e}")
  rows.map(fn(r) { ((r.int("version_id") ?? e => fault("${e}")), (r.bool("is_applied") ?? e => fault("${e}"))) })
}

test "Layout.Goose continues a database goose migrated" {
  let db = sql.memory() ?? e => fault("${e}")
  // what goose left: its table, version 0 and version 1 applied
  db.exec(GOOSE_TABLE) ?? e => fault("${e}")
  db.exec("CREATE TABLE owners ( owner_name TEXT NOT NULL )") ?? e => fault("${e}")
  for v in [0, 1] {
    db.exec("INSERT INTO goose_db_version (version_id, is_applied, tstamp) VALUES ($1, $2, $3)", [sql.int(v), sql.bool(true), sql.time(Time.from_unix(1_700_000_000))]) ?? e => fault("${e}")
  }
  let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
  let t = "goose_db_version"
  expect(db_version(db, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == 1
  expect(has_pending(db, files, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == true
  os.clock.set(Time.from_unix(1_794_960_000))
  expect(up(db, files, os.clock, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == [2]
  expect(owners(db)) == 3
  expect(goose_rows(db)) == [(0, true), (1, true), (2, true)]
  let st = status(db, files, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")
  expect(st.map(fn(s) { (s.version, s.applied_at.map(fn(a) { a.unix() })) })) == [(1, Some(1_700_000_000)), (2, Some(1_794_960_000))]
  expect(db_version(db, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == 2
}

test "Layout.Goose makes goose's table with its version 0 row" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
  let t = "goose_db_version"
  expect(db_version(db, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == 0
  expect(goose_rows(db)) == [(0, true)]
  expect(up(db, files, os.clock, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == [1, 2]
  expect(goose_rows(db)) == [(0, true), (1, true), (2, true)]
  expect(up(db, files, os.clock, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == []
}

test "Layout.Goose: a version's newest row decides (goose's down leaves is_applied false)" {
  let db = sql.memory() ?? e => fault("${e}")
  db.exec(GOOSE_TABLE) ?? e => fault("${e}")
  db.exec("CREATE TABLE owners ( owner_name TEXT NOT NULL )") ?? e => fault("${e}")
  for (v, on) in [(0, true), (1, true), (2, true), (2, false)] {
    db.exec("INSERT INTO goose_db_version (version_id, is_applied) VALUES ($1, $2)", [sql.int(v), sql.bool(on)]) ?? e => fault("${e}")
  }
  let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
  let t = "goose_db_version"
  let st = status(db, files, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")
  // version 1's NULL tstamp reads as the epoch
  expect(st.map(fn(s) { (s.version, s.applied_at.map(fn(a) { a.unix() })) })) == [(1, Some(0)), (2, None)]
  expect(up(db, files, os.clock, table: t, dialect: Dialect.Memory, layout: Layout.Goose) ?? e => fault("${e}")) == [2]
  expect(owners(db)) == 3
}

test "goose's tables for TiDB, Redshift, Aurora DSQL and Turso (internal/dialects CreateTable)" {
  expect(goose_columns(Dialect.Tidb)) == "id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT UNIQUE, version_id bigint NOT NULL, is_applied boolean NOT NULL, tstamp timestamp NULL default now(), PRIMARY KEY(id)"
  expect(goose_columns(Dialect.Redshift)) == "id integer NOT NULL identity(1, 1), version_id bigint NOT NULL, is_applied boolean NOT NULL, tstamp timestamp NULL default sysdate, PRIMARY KEY(id)"
  expect(goose_columns(Dialect.Dsql)) == "id integer PRIMARY KEY, version_id bigint NOT NULL, is_applied boolean NOT NULL, tstamp timestamp NOT NULL DEFAULT now()"
  expect(goose_columns(Dialect.Turso)) == goose_columns(Dialect.Sqlite)
  expect(time_type(Dialect.Tidb)) == "DATETIME(6)"
  expect(time_type(Dialect.Redshift)) == "TIMESTAMPTZ"
}

test "Aurora DSQL's goose rows take the highest id plus 1 (dsql InsertVersion)" {
  let m = Migration{version: 7, name: "00007_x.sql", up: [], down: [], tx: true}
  let at = Time.from_unix(5)
  let (q, args) = record_stmt("goose_db_version", Dialect.Dsql, Layout.Goose, m, at)
  expect(q) == "INSERT INTO goose_db_version (id, version_id, is_applied, tstamp) VALUES (COALESCE((SELECT MAX(id) FROM goose_db_version), 0) + 1, $1, $2, $3)"
  expect(args) == [sql.int(7), sql.bool(true), sql.time(at)]
  let (q0, _) = goose_insert("goose_db_version", Dialect.Dsql, [sql.int(0), sql.bool(true)])
  expect(q0) == "INSERT INTO goose_db_version (id, version_id, is_applied) VALUES (COALESCE((SELECT MAX(id) FROM goose_db_version), 0) + 1, $1, $2)"
  let (qr, _) = record_stmt("goose_db_version", Dialect.Redshift, Layout.Goose, m, at)
  expect(qr) == "INSERT INTO goose_db_version (version_id, is_applied, tstamp) VALUES ($1, $2, $3)"
}

test "Redshift, Aurora DSQL and Turso migrate without a lock statement" {
  for d in [Dialect.Redshift, Dialect.Dsql, Dialect.Turso] {
    // sql.memory has no pg_advisory_lock or GET_LOCK: a lock statement fails the run
    let db = sql.memory() ?? e => fault("${e}")
    let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
    expect(up(db, files, os.clock, dialect: d) ?? e => fault("${e}")) == [1, 2]
    expect(db_version(db, dialect: d) ?? e => fault("${e}")) == 2
  }
}

fn goose_records() -> List[log.Record] {
  testing.logs().filter(fn(r) { r.fields.get("logger") == Some("goose") })
}

test "at Debug, up logs goose Provider's verbose records (WithVerbose, WithSlog)" {
  log.configure(os.stdio, level: log.Level.Debug)
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "00001_a.sql": "-- +goose Up\nCREATE TABLE a (id INT);\nINSERT INTO a (id) VALUES (1);\n",
    "00002_b.sql": "-- +goose NO TRANSACTION\n-- +goose Up\nINSERT INTO a (id) VALUES (2);\n",
    "00003_c.sql": "-- +goose Up\n",
  })
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 2, 3]
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == []
  let recs = goose_records()
  expect(recs.map(fn(r) { r.level })) == [log.Level.Debug, log.Level.Debug, log.Level.Debug, log.Level.Debug, log.Level.Debug, log.Level.Debug, log.Level.Debug, log.Level.Debug]
  let show = fn(r: log.Record) -> Str {
    r.msg + " " + r.fields.keys().filter(fn(k) { k != "duration_seconds" }).map(fn(k) { "${k}=${r.fields.get(k) ?? ""}" }).join(" ")
  }
  expect(recs.map(show)) == [
    "executing statement logger=goose direction=up source=00001_a.sql statement=CREATE TABLE a (id INT); type=sql version=1",
    "executing statement logger=goose direction=up source=00001_a.sql statement=INSERT INTO a (id) VALUES (1); type=sql version=1",
    "migration completed logger=goose direction=up source=00001_a.sql state=applied type=sql version=1",
    "executing statement logger=goose direction=up source=00002_b.sql statement=INSERT INTO a (id) VALUES (2); type=sql version=2",
    "migration completed logger=goose direction=up source=00002_b.sql state=applied type=sql version=2",
    "migration completed logger=goose direction=up source=00003_c.sql state=empty type=sql version=3",
    "successfully migrated database logger=goose current_version=3",
    "no migrations to run logger=goose current_version=3",
  ]
  expect(recs[2].fields.contains("duration_seconds")) == true
}

test "at the default Info level up logs no goose records" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"00001_owners.sql": OWNERS})
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1]
  expect(goose_records().len()) == 0
}

test "up_code logs a code migration as type go" {
  log.configure(os.stdio, level: log.Level.Debug)
  let db = sql.memory() ?? e => fault("${e}")
  let code = [CodeMigration{version: 1, name: "00001_a.go", up: tx_step("CREATE TABLE g (id INT)")}]
  expect((up_code(db, [], code, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")).map(fn(r) { r.version })) == [1]
  let done = goose_records().filter(fn(r) { r.msg == "migration completed" })
  expect(done.map(fn(r) { (r.fields.get("type"), r.fields.get("state")) })) == [(Some("go"), Some("applied"))]
}
