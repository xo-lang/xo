// collect tests port provider_collect_test.go's TestCollectFileSources,
// and the run tests port provider_run_test.go's tx_partial_errors and
// TestPending on sql.memory.

use std/embed
use std/sql
use std/testing

fn ups(text: Str) -> List[Str] { (parse("1_t.sql", text) ?? e => fault("${e}")).up }
fn downs(text: Str) -> List[Str] { (parse("1_t.sql", text) ?? e => fault("${e}")).down }

test "endsWithSemicolon (TestSemicolons)" {
  expect(ends_with_semicolon("END;")) == true
  expect(ends_with_semicolon("END; -- comment")) == true
  expect(ends_with_semicolon("END   ; -- comment")) == true
  expect(ends_with_semicolon("END -- comment")) == false
  expect(ends_with_semicolon("END -- comment ;")) == false
  expect(ends_with_semicolon("END \" ; \" -- comment")) == false
}

const MULTILINE = "-- +goose Up\nCREATE TABLE post (\n\t\tid int NOT NULL,\n\t\ttitle text,\n\t\tbody text,\n\t\tPRIMARY KEY(id)\n);                  -- 1st stmt\n\n-- comment\nSELECT 2;           -- 2nd stmt\nSELECT 3; SELECT 3; -- 3rd stmt\nSELECT 4;           -- 4th stmt\n\n-- +goose Down\n-- comment\nDROP TABLE post;    -- 1st stmt\n"
const FUNCTXT = "-- +goose Up\nCREATE TABLE IF NOT EXISTS histories (\n\tid                BIGSERIAL  PRIMARY KEY,\n\tcurrent_value     varchar(2000) NOT NULL,\n\tcreated_at      timestamp with time zone  NOT NULL\n);\n\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION histories_partition_creation( DATE, DATE )\nreturns void AS $$\nDECLARE\n\tcreate_query text;\nBEGIN\n\tFOR create_query IN SELECT\n\t\t\t'CREATE TABLE IF NOT EXISTS histories_'\n\t\t\t|| TO_CHAR( d, 'YYYY_MM' )\n\t\t\t|| ' ( CHECK( created_at >= timestamp '''\n\t\t\t|| TO_CHAR( d, 'YYYY-MM-DD 00:00:00' )\n\t\t\t|| ''' AND created_at < timestamp '''\n\t\t\t|| TO_CHAR( d + INTERVAL '1 month', 'YYYY-MM-DD 00:00:00' )\n\t\t\t|| ''' ) ) inherits ( histories );'\n\t\tFROM generate_series( $1, $2, '1 month' ) AS d\n\tLOOP\n\t\tEXECUTE create_query;\n\tEND LOOP;  -- LOOP END\nEND;         -- FUNCTION END\n$$\nlanguage plpgsql;\n-- +goose StatementEnd\n\n-- +goose Down\ndrop function histories_partition_creation(DATE, DATE);\ndrop TABLE histories;\n"
const MYSQL_DELIMITER = "\n-- +goose Up\n-- +goose StatementBegin\nDELIMITER | \n-- +goose StatementEnd\n\n-- +goose StatementBegin\nCREATE FUNCTION my_func( str CHAR(255) ) RETURNS CHAR(255) DETERMINISTIC\nBEGIN \n  RETURN \"Dummy Body\"; \nEND | \n-- +goose StatementEnd\n\n-- +goose StatementBegin\nDELIMITER ; \n-- +goose StatementEnd\n\nselect my_func(\"123\") from dual;\n-- +goose Down\n"
const COPY_STDIN = "\n-- +goose Up\n-- +goose StatementBegin\nCOPY public.django_content_type (id, app_label, model) FROM stdin;\n1\tadmin\tlogentry\n2\tauth\tpermission\n3\tauth\tgroup\n4\tauth\tuser\n5\tcontenttypes\tcontenttype\n6\tsessions\tsession\n\\.\n-- +goose StatementEnd\n"
const PLPGSQL = "\n-- +goose Up\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = now();\n    RETURN NEW;\nEND;\n$$ language 'plpgsql';\n-- +goose StatementEnd\n-- +goose StatementBegin\nCREATE TRIGGER update_properties_updated_at BEFORE UPDATE ON properties FOR EACH ROW EXECUTE PROCEDURE  update_updated_at_column();\n-- +goose StatementEnd\n\n-- +goose Down\n-- +goose StatementBegin\nDROP TRIGGER update_properties_updated_at\n-- +goose StatementEnd\n-- +goose StatementBegin\nDROP FUNCTION update_updated_at_column()\n-- +goose StatementEnd\n"
const PLPGSQL_MIXED = "\n-- +goose Up\n-- +goose StatementBegin\nCREATE OR REPLACE FUNCTION update_updated_at_column()\nRETURNS TRIGGER AS $$\nBEGIN\n    NEW.updated_at = now();\n    RETURN NEW;\nEND;\n$$ language 'plpgsql';\n-- +goose StatementEnd\n\nCREATE TRIGGER update_properties_updated_at\nBEFORE UPDATE\nON properties \nFOR EACH ROW EXECUTE PROCEDURE  update_updated_at_column();\n\n-- +goose Down\nDROP TRIGGER update_properties_updated_at;\nDROP FUNCTION update_updated_at_column();\n"

test "statement counts per direction (TestSplitStatements)" {
  let cases: List[(Str, Int, Int)] = [
    (MULTILINE, 4, 1),
    ("-- +goose Up\n-- This is just a comment", 0, 0),
    ("\n\n-- comment\n-- +goose Up\n\n-- comment\n-- +goose Down\n\n", 0, 0),
    (FUNCTXT, 2, 2),
    (MYSQL_DELIMITER, 4, 0),
    (COPY_STDIN, 1, 0),
    (PLPGSQL, 2, 2),
    (PLPGSQL_MIXED, 2, 2),
  ]
  for (text, up, down) in cases {
    expect(ups(text).len()) == up
    expect(downs(text).len()) == down
  }
  expect(ups(MULTILINE)[2]) == "SELECT 3; SELECT 3; -- 3rd stmt"
  expect(downs(MULTILINE)) == ["DROP TABLE post;    -- 1st stmt"]
}

test "parsing errors (TestParsingErrors)" {
  let bad = [
    // statementBeginNoStatementEnd
    "-- +goose Up\nCREATE TABLE t (id int);\n\n-- +goose StatementBegin\nCREATE FUNCTION f() returns void AS $$\nBEGIN\n  SELECT 1;\nEND;\n$$\nlanguage plpgsql;\n\n-- +goose Down\ndrop TABLE t;\n",
    // unfinishedSQL
    "\n-- +goose Up\nALTER TABLE post\n\n-- +goose Down\n",
    // noUpDownAnnotations
    "\nCREATE TABLE post (\n    id int NOT NULL,\n    PRIMARY KEY(id)\n);\n",
    // multiUpDown
    "-- +goose Up\nCREATE TABLE post (id int);\n\n-- +goose Down\nDROP TABLE post;\n\n-- +goose Up\nCREATE TABLE fancier_post (id int);\n",
    // downFirst
    "-- +goose Down\nDROP TABLE fancier_post;\n",
  ]
  for text in bad {
    expect(parse("1_t.sql", text).is_ok()) == false
  }
  match parse("1_t.sql", "\n-- +goose Up\nALTER TABLE post\n\n-- +goose Down\n") {
    Err(MigrateErr.Parse(_, msg)) => expect(msg.contains("unexpected unfinished SQL query") && msg.contains("missing semicolon?")) == true
    _ => fault("want a parse error")
  }
}

test "every testdata/invalid/up file fails (TestInvalidUp)" {
  expect(invalid_up().len()) == 4
  for (name, text) in invalid_up() {
    expect(parse(name, text).is_ok()) == false
  }
}

test "NO TRANSACTION (TestUseTransactions)" {
  for (name, text, tx) in valid_txn() {
    expect((parse(name, text) ?? e => fault("${e}")).tx) == tx
  }
}

test "Up statements match testdata/valid-up's goldens (TestValidUp)" {
  expect(valid_up().len()) == 9
  for (dir, input, want) in valid_up() {
    let got = ups(input)
    expect("${dir}: ${got.len()}") == "${dir}: ${want.len()}"
    for i in 0..want.len() {
      expect(got[i]) == want[i]
    }
  }
}

test "annotations (Test_extractAnnotation)" {
  expect(annotation("-- +goose Up").ok()) == Some("Up")
  expect(annotation("-- +goose Down").ok()) == Some("Down")
  expect(annotation("-- +goose StatementBegin").ok()) == Some("StatementBegin")
  expect(annotation("-- +goose NO TRANSACTION").ok()) == Some("NO TRANSACTION")
  expect(annotation("-- +goose unsupported").is_ok()) == false
  expect(annotation("-- +goose").is_ok()) == false
  expect(annotation("-- +goose   UP \t").ok()) == Some("Up")
  expect(annotation(" -- +goose   UP \t").is_ok()) == false
  expect(annotation("\t-- +goose   UP \t").is_ok()) == false
  expect(annotation("-- +goose +goose Up").is_ok()) == false
}

test "ENVSUB is refused: an embedded migration's text is fixed" {
  expect(parse("1_t.sql", "-- +goose ENVSUB ON\n-- +goose Up\nSELECT 1;\n").is_ok()) == false
}

fn dir(files: Map[Str, Str]) -> embed.Dir {
  var m: Map[Str, Bytes] = {}
  for (k, v) in files {
    m[k] = v.bytes()
  }
  embed.Dir{files: m}
}

test "ParseAllFromFS: empty file and all_statements" {
  match parse("001_foo.sql", "") {
    Err(MigrateErr.Parse(_, msg)) => expect(msg.contains("must start with '-- +goose Up' annotation")) == true
    _ => fault("want a parse error")
  }
  let ms = collect(dir({
    "001_foo.sql": "\n-- +goose Up\n",
    "002_bar.sql": "\n-- +goose Up\n-- +goose Down\n",
    "003_baz.sql": "\n-- +goose Up\nCREATE TABLE foo (id int);\nCREATE TABLE bar (id int);\n\n-- +goose Down\nDROP TABLE bar;\n",
    "004_qux.sql": "\n-- +goose NO TRANSACTION\n-- +goose Up\nCREATE TABLE foo (id int);\n-- +goose Down\nDROP TABLE foo;\n",
  })) ?? e => fault("${e}")
  expect(ms.map(fn(m) { (m.version, m.tx, m.up.len(), m.down.len()) })) == [(1, true, 0, 0), (2, true, 0, 0), (3, true, 2, 1), (4, false, 1, 1)]
}

const SQL1 = "-- +goose Up\nSELECT 1;\n"

test "file names (TestCollectFileSources, NumericComponent)" {
  expect(version_of("00001_foo.sql")) == Some(1)
  expect(version_of("00110_qux.sql")) == Some(110)
  expect(version_of("00000_foo.sql")) == None
  expect(version_of("not_valid.sql")) == None
  expect(version_of("1.sql")) == None
  expect(version_of("4_something.go")) == None
  expect(version_of("dir/7_x.sql")) == Some(7)
  // skip_random_files: other files and subdirectories are skipped
  let ms = collect(dir({
    "1_foo.sql": SQL1,
    "4_something.go": "package goose",
    "5_qux.sql": SQL1,
    "README.md": "# README",
    "LICENSE": "MIT",
    "no_a_real_migration.sql": "SELECT 1;",
    "some/other/dir/2_foo.sql": "SELECT 1;",
  })) ?? e => fault("${e}")
  expect(ms.map(fn(m) { (m.version, m.name) })) == [(1, "1_foo.sql"), (5, "5_qux.sql")]
  // duplicate_versions
  match collect(dir({"001_foo.sql": SQL1, "01_bar.sql": SQL1})) {
    Err(e) => expect(e.display().contains("found duplicate migration version 1")) == true
    Ok(_) => fault("want a duplicate error")
  }
}

const OWNERS = "-- +goose Up\nCREATE TABLE owners ( owner_name TEXT NOT NULL );\n"
const SEED = "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('seed-user-1');\nINSERT INTO owners (owner_name) VALUES ('seed-user-2');\nINSERT INTO owners (owner_name) VALUES ('seed-user-3');\n"

fn owners(db: sql.Db) -> Int uses net.dial {
  ((db.query_one("SELECT count(*) AS n FROM owners") ?? e => fault("${e}")).int("n")) ?? e => fault("${e}")
}

test "up applies in order once; status reports each (up_and_down_all, status)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS})
  let before = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(before.map(fn(s) { (s.version, s.applied_at.is_some()) })) == [(1, false), (2, false)]
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 2]
  expect(owners(db)) == 3
  expect(up(db, files, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == []
  expect(owners(db)) == 3
  let after = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(after.map(fn(s) { (s.version, s.name, s.applied_at.is_some()) })) == [(1, "00001_owners.sql", true), (2, "00002_seed.sql", true)]
  // a new file later is applied alone
  let more = dir({"00002_seed.sql": SEED, "00001_owners.sql": OWNERS, "00003_more.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('x');\n"})
  expect(up(db, more, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [3]
  expect(owners(db)) == 4
}

test "a failed migration leaves the ones before it applied and none of itself (tx_partial_errors)" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "00001_users_table.sql": OWNERS,
    "00002_partial_error.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('kept-only-on-success');\nINSERT INTO invalid_table (invalid_table) VALUES ('invalid_value');\n",
    "00003_insert_data.sql": SEED,
  })
  match up(db, files, os.clock, dialect: Dialect.Memory) {
    Err(MigrateErr.Failed(v, name, i, err)) => {
      expect((v, name, i)) == (2, "00002_partial_error.sql", 1)
      expect(err.display()) == "no such table: invalid_table"
    }
    r => fault("want Failed, got ${r:?}")
  }
  expect(owners(db)) == 0
  let st = status(db, files, dialect: Dialect.Memory) ?? e => fault("${e}")
  expect(st.map(fn(s) { s.applied_at.is_some() })) == [true, false, false]
}

test "a pending version below the newest applied one (TestPending)" {
  let db = sql.memory() ?? e => fault("${e}")
  let first = dir({"00001_owners.sql": OWNERS, "00003_seed.sql": SEED})
  expect(up(db, first, os.clock, dialect: Dialect.Memory) ?? e => fault("${e}")) == [1, 3]
  let all = dir({"00001_owners.sql": OWNERS, "00002_one.sql": "-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('two');\n", "00003_seed.sql": SEED})
  match up(db, all, os.clock, dialect: Dialect.Memory) {
    Err(e) => {
      expect(e.display().contains("missing (out-of-order) migration")) == true
      expect(e) == MigrateErr.Missing(versions: [2])
    }
    Ok(vs) => fault("want Missing, got ${vs:?}")
  }
  expect(owners(db)) == 3
  expect(up(db, all, os.clock, dialect: Dialect.Memory, allow_missing: true) ?? e => fault("${e}")) == [2]
  expect(owners(db)) == 4
}

test "NO TRANSACTION statements run one by one: those before a failure stay" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({
    "1_owners.sql": OWNERS,
    "2_nt.sql": "-- +goose NO TRANSACTION\n-- +goose Up\nINSERT INTO owners (owner_name) VALUES ('a');\nINSERT INTO nope (x) VALUES (1);\n",
  })
  expect(up(db, files, os.clock, dialect: Dialect.Memory).is_ok()) == false
  expect(owners(db)) == 1
}

test "the version table's name is a parameter" {
  let db = sql.memory() ?? e => fault("${e}")
  let files = dir({"1_owners.sql": OWNERS})
  expect(up(db, files, os.clock, table: "schema_a", dialect: Dialect.Memory) ?? e => fault("${e}")) == [1]
  let n = ((db.query_one("SELECT count(*) AS n FROM schema_a") ?? e => fault("${e}")).int("n")) ?? e => fault("${e}")
  expect(n) == 1
  match up(db, files, os.clock, table: "x; DROP TABLE owners", dialect: Dialect.Memory) {
    Err(e) => expect(e) == MigrateErr.Table(name: "x; DROP TABLE owners")
    Ok(_) => fault("want Table")
  }
  expect(check_table("public.xo_migrations").is_ok()) == true
  expect(check_table("1abc").is_ok()) == false
  expect(check_table("a.b.c").is_ok()) == false
}

