// std/protojson's string writer (jstr, jstr_to): the escapes protobuf-go's
// encoding/protojson writes (internal/encoding/json/encode.go appendString),
// runs written as they are.

use std/protodesc

test "jstr escapes quotes, backslashes and controls, keeps the rest" {
  expect(jstr("")) == "\"\""
  expect(jstr("plain")) == "\"plain\""
  expect(jstr("a\"b\\c")) == "\"a\\\"b\\\\c\""
  expect(jstr("\u{8}\u{C}\n\r\t")) == "\"\\b\\f\\n\\r\\t\""
  expect(jstr("\u{0}\u{1F}x\u{1}")) == "\"\\u0000\\u001fx\\u0001\""
  expect(jstr("héllo ☃ \u{7F}")) == "\"héllo ☃ \u{7F}\""
  expect(jstr("\"")) == "\"\\\"\""
  expect(jstr("end\n")) == "\"end\\n\""
}

test "jstr_to appends to what the builder holds" {
  var b = StrBuilder.new()
  b.write("{")
  jstr_to(b, "k\t")
  b.write(":")
  jstr_to(b, "v")
  expect(b.freeze()) == "{\"k\\t\":\"v\""
}

// An integer map key as protobuf-go's unmarshalMapKey reads it (strconv.ParseInt
// or ParseUint, base 10). TestProtojsonFuzz seed 2 found "-20735673E0" accepted
// as an int32 key, which Go refuses.

fn key_v(kind: Int, ks: Str) -> Int? {
  match key_sv(protodesc.FieldDesc{name: "key", number: 1, kind: kind}, ks) {
    Ok((x, _)) => Some(x.v)
    Err(_) => None
  }
}

test "an integer map key takes a sign and leading zeros, never an exponent, fraction or space" {
  let i32 = protodesc.TYPE_INT32
  let u64 = protodesc.TYPE_UINT64
  expect(key_v(i32, "-20735673E0")) == None
  expect(key_v(i32, "1e2")) == None
  expect(key_v(i32, "1.0")) == None
  expect(key_v(i32, " 1")) == None
  expect(key_v(i32, "")) == None
  expect(key_v(i32, "+")) == None
  expect(key_v(i32, "2147483648")) == None
  expect(key_v(u64, "-1")) == None
  expect(key_v(u64, "+1")) == None
  expect(key_v(i32, "007")) == Some(7)
  expect(key_v(i32, "+5")) == Some(5)
  expect(key_v(i32, "-0")) == Some(0)
  expect(key_v(i32, "-2147483648")) == Some(-2147483648)
  expect(key_v(u64, "0018446744073709551615")) == Some(-1)
}

/// A registry of one empty message p.M.
fn over_max_reg() -> Registry {
  let set = protodesc.encode(protodesc.FileDesc{name: "a.proto", package: "p", message_type: [protodesc.MessageDesc{name: "M"}]})
  registry_from_set(b"\x0a\x11" + set).or_fault("registry")
}

test "marshal fails a field number over 536870911, as proto.Unmarshal does first" {
  expect(marshal(over_max_reg(), "p.M", b"\xca\xc7\xa3\xe8\x22\x00").is_ok()) == false
}

// Go's protojson reads a Timestamp with time.Parse(RFC3339Nano), which takes a comma before the
// fraction too; it rejects more than 9 digits only after a period, and time.Parse keeps the
// first 9 of a longer fraction (fuzz case, 2026-11-17; values from Go's protojson.Unmarshal)
test "a Timestamp's fraction may follow a comma, as Go's time.Parse reads it" {
  expect(parse_timestamp("2000-01-01T00:00:00,5Z") ?? e => fault("${e}")) == ts_wire(946684800, 500000000)
  expect(parse_timestamp("2000-01-01T00:00:00,123456789123Z") ?? e => fault("${e}")) == ts_wire(946684800, 123456789)
  expect(parse_timestamp("2000-01-01T00:00:00,5+01:00") ?? e => fault("${e}")) == ts_wire(946681200, 500000000)
  expect(parse_timestamp("2000-01-01T00:00:00.123456789123Z").is_err()) == true
  expect(parse_timestamp("2000-01-01T00:00:00,Z").is_err()) == true
}

// Go's parseDuration takes a fraction with no integer part and an empty
// fraction after the period (TestProtojsonFuzz seed 179, 2026-11-18: Go read
// "+.000001s", which Xo refused; values from Go's protojson.Unmarshal)
test "a Duration may leave out its integer part or its fraction's digits, as in Go" {
  let d = fn(s: Str) -> Str {
    match parse_duration(s) {
      Ok(b) => b.debug()
      Err(_) => "error"
    }
  }
  expect(d(".5s")) == d("0.5s")
  expect(d("+.000001s")) == d("0.000001s")
  expect(d("-.5s")) == d("-0.5s")
  expect(d("1.s")) == d("1s")
  expect(d(".s")) == d("0s")
  expect(d("-.s")) == d("0s")
  expect(d("+s")) == "error"
  expect(d("..5s")) == "error"
  expect(d(".1234567891s")) == "error"
  expect(d("00.5s")) == "error"
}

// Go's protojson counts the Any against RecursionLimit but not a well known
// type in its "value" (unmarshalAnyValue calls the type's own unmarshaler), and
// an object in a member it skips while finding "@type" may nest only as deep as
// the levels left. TestProtojsonFuzz (AllowPartial and RecursionLimit, limit 2)
// found a Timestamp in an Any refused, which Go reads.

fn wkt_reg() -> Registry {
  let any = protodesc.MessageDesc{name: "Any", field: [
    protodesc.FieldDesc{name: "type_url", number: 1, label: 1, kind: 9},
    protodesc.FieldDesc{name: "value", number: 2, label: 1, kind: 12},
  ]}
  let ts = protodesc.MessageDesc{name: "Timestamp", field: [
    protodesc.FieldDesc{name: "seconds", number: 1, label: 1, kind: 3},
    protodesc.FieldDesc{name: "nanos", number: 2, label: 1, kind: 5},
  ]}
  let empty = protodesc.MessageDesc{name: "Empty"}
  let w = protodesc.MessageDesc{name: "W", field: [
    protodesc.FieldDesc{name: "a", number: 1, label: 1, kind: 11, type_name: ".google.protobuf.Any"},
  ]}
  registry([protodesc.FileDesc{name: "wkt.proto", package: "google.protobuf", syntax: "proto3", message_type: [any, ts, empty, w]}])
}

test "a well known type in an Any's value does not count against the recursion limit, as in Go" {
  let r = wkt_reg()
  let u = "type.googleapis.com/google.protobuf."
  let tsj = "{\"@type\":\"${u}Timestamp\",\"value\":\"2000-01-01T00:00:00Z\"}"
  expect(unmarshal(r, "google.protobuf.Any", tsj, Opts{recursion_limit: 1}).is_ok()) == true
  expect(unmarshal(r, "google.protobuf.W", "{\"a\":${tsj}}", Opts{recursion_limit: 2}).is_ok()) == true
  expect(unmarshal(r, "google.protobuf.W", "{\"a\":${tsj}}", Opts{recursion_limit: 1}).is_err()) == true
  let ej = "{\"@type\":\"${u}Empty\",\"value\":{}}"
  expect(unmarshal(r, "google.protobuf.Any", ej, Opts{recursion_limit: 1}).is_err()) == true
  expect(unmarshal(r, "google.protobuf.Any", ej, Opts{recursion_limit: 2}).is_ok()) == true
  let aj = "{\"@type\":\"${u}Any\",\"value\":${ej}}"
  expect(unmarshal(r, "google.protobuf.Any", aj, Opts{recursion_limit: 2}).is_err()) == true
  expect(unmarshal(r, "google.protobuf.Any", aj, Opts{recursion_limit: 3}).is_ok()) == true
}
