// std/protobuf (decision 0530): the Protocol Buffers wire format, as Go's
// google.golang.org/protobuf/encoding/protowire. Declaration file. Pure.

/// A field's wire type (the low three bits of its tag).
const VARINT: Int = 0
const FIXED64: Int = 1
const BYTES: Int = 2
const START_GROUP: Int = 3
const END_GROUP: Int = 4
const FIXED32: Int = 5

/// Why a wire read failed: the cases of protowire's error codes.
/// `Truncated` the input ends inside a value, `Overflow` a varint is longer than ten bytes or
/// its tenth byte is above 1, `BadTag` a field number outside 1..2^29-1 or a tag over 32 bits,
/// `BadWire` a wire type of 6 or 7 (or an end group with no start), `Recursion` groups nested
/// deeper than the limit, `BadLength` a length that does not fit the input, `Utf8` text that is
/// not valid UTF-8.
open enum ProtoErr {
  Truncated
  Overflow
  BadTag
  BadWire(wire: Int)
  EndGroup
  Recursion
  BadLength
  Utf8
} derive Display

/// The field numbers a message may use (protowire's MinValidNumber, MaxValidNumber) and the
/// range reserved for the protobuf implementation (FirstReservedNumber, LastReservedNumber).
const MIN_VALID_NUMBER: Int = 1
const MAX_VALID_NUMBER: Int = 536870911
const FIRST_RESERVED_NUMBER: Int = 19000
const LAST_RESERVED_NUMBER: Int = 19999

/// Whether `num` is a field number the wire format can carry (protowire's Number.IsValid): in
/// 1..=2^29-1. The reserved range 19000..=19999 is valid on the wire; only a .proto may not
/// declare it (Go's protodesc checks that, not protowire).
fn valid_number(num: Int) -> Bool

/// The greatest nesting of groups `skip_field` follows (protowire's 10000).
const MAX_GROUP_DEPTH: Int = 10000

/// The bytes of `v` as a varint appended to `b` (protowire.AppendVarint).
fn append_varint(b: Bytes, v: UInt64) -> Bytes
/// The bytes of the tag of field `num` with wire type `wire` appended to `b` (AppendTag).
fn append_tag(b: Bytes, num: Int, wire: Int) -> Bytes
fn append_fixed32(b: Bytes, v: UInt32) -> Bytes
fn append_fixed64(b: Bytes, v: UInt64) -> Bytes
/// A length prefix then the bytes (AppendBytes).
fn append_bytes(b: Bytes, data: Bytes) -> Bytes
/// Builder forms of the append functions (the generated writers of `derive Proto` use them: one buffer, no copy per field).
fn put_varint(out: BytesBuilder, v: UInt64) -> BytesBuilder
fn put_tag(out: BytesBuilder, num: Int, wire: Int) -> BytesBuilder
fn put_fixed32(out: BytesBuilder, v: UInt32) -> BytesBuilder
fn put_fixed64(out: BytesBuilder, v: UInt64) -> BytesBuilder
fn put_bytes(out: BytesBuilder, data: Bytes) -> BytesBuilder
/// A field's key (`num << 3 | wire`, the tag's varint) and then its value, written together: one word
/// when the key is one byte and the value fits beside it (the generated writers of `derive Proto` call
/// these for every field: a tag pushed alone was a builder call per field).
fn put_key_varint(out: BytesBuilder, key: Int, v: UInt64) -> BytesBuilder
fn put_key_fixed32(out: BytesBuilder, key: Int, v: UInt32) -> BytesBuilder
/// The key, the length prefix, then the bytes.
fn put_key_bytes(out: BytesBuilder, key: Int, data: Bytes) -> BytesBuilder
/// The number of bytes `append_varint` writes for `v` (SizeVarint).
fn size_varint(v: UInt64) -> Int
/// The zigzag form of a signed value (EncodeZigZag) and its inverse (DecodeZigZag).
fn encode_zigzag(v: Int) -> UInt64
fn decode_zigzag(v: UInt64) -> Int

/// The varint at offset `at` of `b` and the offset after it (ConsumeVarint).
fn read_varint(b: Bytes, at: Int) -> (UInt64, Int) ! ProtoErr
/// The field number, wire type and the offset after the tag at `at` (ConsumeTag).
fn read_tag(b: Bytes, at: Int) -> (Int, Int, Int) ! ProtoErr
fn read_fixed32(b: Bytes, at: Int) -> (UInt32, Int) ! ProtoErr
fn read_fixed64(b: Bytes, at: Int) -> (UInt64, Int) ! ProtoErr
/// A length prefixed value: its bytes (a view) and the offset after it (ConsumeBytes).
fn read_bytes(b: Bytes, at: Int) -> (Bytes, Int) ! ProtoErr
/// The offset after the value of a field with tag number `num` and wire type `wire` starting at
/// `at`, groups included (ConsumeFieldValue).
fn skip_field(b: Bytes, at: Int, num: Int, wire: Int) -> Int ! ProtoErr

/// `v` as protobuf wire bytes, fields in declaration order, proto3 implicit presence (a zero
/// value is not written). `T` derives Proto (decision 0530).
fn marshal[T: Proto](v: T) -> Bytes
/// The `T` that `data` encodes; unknown fields are skipped, a later value of a field wins.
/// Messages nested more than 10000 deep are `ProtoErr.Recursion` (protowire's RecursionLimit).
fn unmarshal[T: Proto](data: Bytes) -> T ! ProtoErr

/// proto.UnmarshalOptions (decision 0683 item 1): `recursion_limit` the
/// nesting `unmarshal_with` accepts (protowire's DefaultRecursionLimit,
/// 10000), `discard_unknown` drops unknown fields instead of keeping them
/// in the `proto "unknown"` field, `allow_partial` has no effect (derive
/// Proto has no proto2 required fields).
struct UnmarshalOptions {
  discard_unknown: Bool = false
  recursion_limit: Int = 10000
  allow_partial: Bool = false
}

/// The type of a message field (protoreflect.Kind): the wire form a
/// `derive Proto` field type maps to (decision 0683 item 2).
enum FieldKind {
  Bool
  Enum
  Int32
  Sint32
  Uint32
  Int64
  Sint64
  Uint64
  Sfixed32
  Fixed32
  Float
  Sfixed64
  Fixed64
  Double
  String
  Bytes
  Message
} derive Eq, Display

/// Whether a field holds one value, a list or a map (protoreflect.Cardinality and IsMap).
enum Cardinality {
  Optional
  Repeated
  Map
} derive Eq, Display

/// One field of a message: its .proto name, protojson's lowerCamelCase name, its number, the kind
/// of its value (a map's value), its cardinality, the oneof it is a member of, and the descriptor
/// of a message (or map value message) field's type, a function so a recursive message needs no
/// cycle in data.
struct FieldDesc {
  name: Str
  json_name: Str
  number: Int
  kind: FieldKind
  cardinality: Cardinality
  oneof: Str?
  message: (fn() -> MessageDesc)?
}

/// A message: its full name (`derive Proto(name: "pkg.Msg")`, else the Xo module path and type
/// name) and its fields in declaration order, a oneof's members where the oneof is
/// (protoreflect.MessageDescriptor's names and fields; decision 0683 item 2).
struct MessageDesc {
  full_name: Str
  fields: List[FieldDesc]
}

/// The descriptor of message type T, which derive Proto generates.
fn descriptor[T: Proto]() -> MessageDesc
/// T's full name (proto.MessageName).
fn message_name[T: Proto]() -> Str

/// `unmarshal` with options (proto.UnmarshalOptions.Unmarshal): messages
/// nested past `opts.recursion_limit` are `ProtoErr.Recursion`.
fn unmarshal_with[T: Proto](data: Bytes, opts: UnmarshalOptions) -> T ! ProtoErr
/// proto.Size: the length of `marshal(v)`, from marshal's sizes pass without writing the bytes.
fn size[T: Proto](v: T) -> Int
/// proto.Merge: `src`'s populated fields merged into `dst`, as parsing `marshal(src)` onto `dst`
/// merges them: a scalar replaces, a nested message merges, a list appends, a map entry replaces,
/// unknown fields append.
fn merge_from[T: Proto](dst: T, src: T) -> T
