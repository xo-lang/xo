// 529 cases, 0 left out (not UTF-8)
// END GENERATED by scripts/genurltest

test "parse refuses the hosts Go refuses, with Go's texts (GO-2025-4010, GO-2026-4601, GO-2022-0211; a bracketed host byte from 0x80)" {
  match parse("http://[::1%80]/") {
    Ok(_) => expect("http://[::1%80]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[::1%80]/\": invalid host: ParseAddr(\"::1\\x80\"): unexpected character, want colon (at \"\\x80\")"
  }
  match parse("http://[f%80::1%25eth0]/") {
    Ok(_) => expect("http://[f%80::1%25eth0]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[f%80::1%25eth0]/\": invalid host: ParseAddr(\"f\\x80::1%eth0\"): unexpected character, want colon (at \"\\x80::1\")"
  }
  match parse("http://[%80]/") {
    Ok(_) => expect("http://[%80]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[%80]/\": invalid host: ParseAddr(\"\\x80\"): unable to parse IP"
  }
  match parse("http://[1.2.3.%80]/") {
    Ok(_) => expect("http://[1.2.3.%80]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[1.2.3.%80]/\": invalid host: ParseAddr(\"1.2.3.\\x80\"): unexpected character (at \"\\x80\")"
  }
  match parse("http://[fe80::1%25%80]/") {
    Ok(_) => expect("http://[fe80::1%25%80]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[fe80::1%25%80]/\": invalid URL escape \"%80\""
  }
  match parse("http://[abc]/") {
    Ok(_) => expect("http://[abc]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[abc]/\": invalid host: ParseAddr(\"abc\"): unable to parse IP"
  }
  match parse("http://[1.2.3.4]/") {
    Ok(_) => expect("http://[1.2.3.4]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[1.2.3.4]/\": invalid IP-literal"
  }
  match parse("http://[]/") {
    Ok(_) => expect("http://[]/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[]/\": invalid host: ParseAddr(\"\"): unable to parse IP"
  }
  match parse("http://[::1]junk/") {
    Ok(_) => expect("http://[::1]junk/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[::1]junk/\": invalid port \"junk\" after host"
  }
  match parse("http://[::1]%3A80/") {
    Ok(_) => expect("http://[::1]%3A80/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://[::1]%3A80/\": invalid port \"%3A80\" after host"
  }
  match parse("http://example.com:80junk/") {
    Ok(_) => expect("http://example.com:80junk/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://example.com:80junk/\": invalid port \":80junk\" after host"
  }
  match parse("http://example.com:80:90/") {
    Ok(_) => expect("http://example.com:80:90/ parsed") == "an error"
    Err(e) => expect(e.display()) == "parse \"http://example.com:80:90/\": invalid port \":80:90\" after host"
  }
  // other schemes split at the last colon, as Go
  match parse("postgres://a:80:90/") {
    Ok(u) => expect((u.hostname(), u.port())) == ("a:80", "90")
    Err(e) => expect(e.display()) == "parsed"
  }
}

test "resolve_reference and join_path stay linear on long dot segments (GO-2026-6218, GO-2022-0988)" {
  let base = parse("http://h/b/c").ok() ?? Url{}
  let r = base.resolve_reference(Url{path: "a/".repeat(200000) + "../".repeat(200000) + "x"})
  expect(r.path) == "/b/x"
  let s = base.resolve_reference(Url{path: "/".repeat(400000)})
  expect(s.path.len()) == 400000
  expect(join_path("https://go.dev", ["../go"])) == Ok("https://go.dev/go")
  expect(join_path("https://go.dev/", ["a/../".repeat(100000) + "b"])) == Ok("https://go.dev/b")
  expect(join_path("rel", ["../../x"])) == Ok("x")
}
