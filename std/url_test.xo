  expect(mp(h("68747470733a2f2f676f2e676f6f676c65736f757263652e636f6d2f2f")).join_path([h("2f676f"), h("61"), h("62"), h("63")]).display()) == h("68747470733a2f2f676f2e676f6f676c65736f757263652e636f6d2f676f2f612f622f63")
}

