test "values keep first appearance order and replace with set" {
  var v = values()
  v.add("b", "1")
  v.add("a", "2")
  v.add("b", "3")
  expect(v.keys()) == ["b", "a"]
  expect(v.all("b")) == ["1", "3"]
  expect(v.get("b")) == Some("1")
  expect(v.get("c")) == None
  v.set("b", "x")
  expect(v.all("b")) == ["x"]
  v.remove("b")
  expect(v.has("b")) == false
  expect(v.encode()) == "a=2"
}

test "values are values" {
  var a = values()
  a.add("k", "1")
  var b = a
  b.add("k", "2")
  expect(a.all("k")) == ["1"]
  expect(b.all("k")) == ["1", "2"]
}

test "invalid UTF-8 stays escaped" {
  expect(query_unescape("a%82b")) == Ok("a%82b")
  expect(query_unescape("%E2%82%AC+x")) == Ok("\u{20AC} x")
  expect(path_unescape("%C3%A9%2F")) == Ok("\u{E9}/")
}

test "the parameter limit" {
  expect(parse_query("a=1&".repeat(10000)).is_ok()) == false
  expect(parse_query("a=1&".repeat(9999) + "a=1").map(fn(v) { v.all("a").len() })) == Ok(10000)
}

test "encode round trips" for pairs: List[(Str, Str)] {
  var v = values()
  for (k, x) in pairs {
    v.add(k, x)
  }
  let back = parse_query(v.encode()).or_fault("encode output parses")
  for k in v.keys() {
    if !k.is_empty() || !v.all(k).is_empty() {
      expect(back.all(k)) == v.all(k)
    }
  }
}

test "parse_query counts the separators before it splits (GO-2026-4341)" {
  match parse_query("&".repeat(10000)) {
    Ok(_) => expect("parsed") == "an error"
    Err(e) => expect(e.msg) == "number of URL query parameters exceeded limit"
  }
  expect(parse_query("&".repeat(9999)).map(fn(v) { v.encode() })) == Ok("")
  match parse_query("a=1&".repeat(3000000)) {
    Ok(_) => expect("parsed") == "an error"
    Err(e) => expect(e.msg) == "number of URL query parameters exceeded limit"
  }
}

test "Values finds keys through add, set, remove and parse_query, in first-appearance order" {
  // 40 keys; every answer is checked against keys()
  var v = values()
  for i in 0..40 {
    v.add("k${i % 40}", "a${i}")
    v.add("k${(i * 7) % 40}", "b${i}")
  }
  v.set("k3", "s")
  v.set("new", "n")
  v.remove("k0")
  v.remove("k39")
  v.remove("k20")
  v.remove("absent")
  for k in v.keys() {
    expect(v.has(k)) == true
    expect(v.get(k)) == v.all(k).first()
  }
  expect(v.has("k0")) == false
  expect(v.all("k20")) == []
  expect(v.get("k3")) == Some("s")
  expect(v.get("new")) == Some("n")
  expect(v.keys().len()) == 38
  for i in 1..30 {
    v.remove("k${i}")
  }
  expect(v.keys().sort()) == ["k30", "k31", "k32", "k33", "k34", "k35", "k36", "k37", "k38", "new"]
  expect(v.get("k35")) == Some("b5")
  v.add("k35", "again")
  expect(v.all("k35")) == ["b5", "a35", "again"]
  let p = parse_query(v.encode() + "&z=1&z=2").or_fault("parses")
  expect(p.all("z")) == ["1", "2"]
  expect(p.all("k35")) == ["b5", "a35", "again"]
  var q = values()
  for i in 0..10000 {
    q.add("key${i}", "${i}")
  }
  var n = 0
  for k in q.keys() {
    n += (q.get(k) ?? "").len()
  }
  expect(n) == 38890
}

test "many values of one key, parsed and added" {
  let v = parse_query("a=x&".repeat(9998) + "a=y").or_fault("parses")
  expect(v.all("a").len()) == 9999
  expect(v.all("a").last()) == Some("y")
  var w = values()
  for x in v.all("a") {
    w.add("a", x)
  }
  expect(w.all("a")) == v.all("a")
  expect(w.encode().len()) == 39995
}

// BEGIN GENERATED by scripts/genurltest: do not edit
// net/url's url_test.go tables (go1.26: urltests, parseRequestURLTests,
// stringURLTests, the Redacted, ParseErrors, RejectControlCharacters,
// strict colon, Hostname and Port and JoinPath tables, requritests,
// resolvePathTests, resolveReferenceTests), each answer from Go.

fn pr(s: Str) -> Str {
  match parse(s) {
    Ok(u) => "ok " + u.display()
    Err(e) => "err " + e.display()
  }
}

fn prq(s: Str) -> Str {
  match parse_request_uri(s) {
    Ok(u) => "ok " + u.display()
    Err(e) => "err " + e.display()
  }
}

fn mp(s: Str) -> Url {
  match parse(s) {
    Ok(u) => u
    Err(_) => Url{scheme: "parse failed"}
  }
}

fn jp(base: Str, elems: List[Str]) -> Str {
  match join_path(base, elems) {
    Ok(s) => "ok " + s
    Err(e) => "err " + e.display()
  }
}

test "url type parse 1" {
  let u = mp(h("687474703a2f2f7777772e676f6f676c652e636f6d"))
  expect(u) == Url{scheme: h("68747470"), host: h("7777772e676f6f676c652e636f6d")}
  expect(u.display()) == h("687474703a2f2f7777772e676f6f676c652e636f6d")
  expect(u.hostname()) == h("7777772e676f6f676c652e636f6d")
  expect(u.port()) == h("")
  expect(u.request_uri()) == h("2f")
  expect(u.redacted()) == h("687474703a2f2f7777772e676f6f676c652e636f6d")
  expect(u.query().encode()) == h("")
  expect(u.is_abs()) == true
}

test "url type parse_request_uri 2" {
  expect(parse_request_uri(h("687474703a2f2f7777772e676f6f676c652e636f6d"))) == Ok(Url{scheme: h("68747470"), host: h("7777772e676f6f676c652e636f6d")})
  expect(prq(h("687474703a2f2f7777772e676f6f676c652e636f6d"))) == h("6f6b20687474703a2f2f7777772e676f6f676c652e636f6d")
}

