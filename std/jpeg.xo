// std/jpeg (spec/std.md 49, decision 0467). Go's
// image/jpeg Decode and DecodeConfig over whole buffers: baseline and
// progressive JPEG, every chroma subsampling Go supports, restart
// intervals, Adobe CMYK, YCCK and RGB, with Go's integer IDCT, so the
// decoded planes are the bytes Go's decoder returns. Pure.
//
// std/jpeg on the native backends and, through std/go_compiled.txt, on the
// Go backend (decision 0312): one source, Go's image/jpeg decoder (reader.go,
// huffman.go, scan.go, dct.go; Copyright 2009 and 2025 The Go Authors,
// BSD-style license) over a whole buffer. Go's int32 arithmetic wraps; Xo's
// Int is 64 bits, so the wrap is taken where it shows (before a right shift
// and when a value is stored: the sums and products between two such points
// agree modulo 2**32), which keeps the planes Go returns even for hostile
// coefficients.

/// The image types image/jpeg decodes to:
/// Gray (`pix`, 1 byte a pixel), YCbCr (the `y`, `cb` and `cr` planes with
/// the chroma `subsample` ratio), CMYK (`pix`, 4 bytes a pixel, Go's
/// image.CMYK: 255 is full ink) and RGBA (`pix`, 4 bytes a pixel with alpha
/// 255; Go's decoder returns it for an RGB JPEG, one with an Adobe marker
/// that says RGB or components named R, G and B).
pub enum Model {
  Gray
  YCbCr
  CMYK
  RGBA
} derive Eq, Display

/// Go's image.YCbCrSubsampleRatio: how the chroma planes are subsampled
/// against luma (4:4:4 none, 4:4:0 vertical, 4:2:2 horizontal, 4:2:0 both,
/// 4:1:1 horizontal by 4, 4:1:0 horizontal by 4 and vertical by 2).
pub enum Subsample {
  S444
  S440
  S422
  S420
  S411
  S410
} derive Eq, Display

/// A decoded image. Rows are tight (no padding): `pix` has `width * height`
/// bytes for Gray and `width * height * 4` for CMYK and RGBA; a YCbCr image
/// has `y` of `width * height` bytes and `cb` and `cr` of `chroma_width *
/// chroma_height` bytes each (`pix` is empty).
pub struct Image {
  pub width: Int
  pub height: Int
  pub model: Model
  pub subsample: Subsample = Subsample.S444
  pub pix: Bytes = b""
  pub y: Bytes = b""
  pub cb: Bytes = b""
  pub cr: Bytes = b""
}

/// The size and image type of a JPEG (Go's image.Config).
pub struct Config {
  pub width: Int
  pub height: Int
  pub model: Model
}

/// Go's errors: `invalid JPEG format: ...` (Format), `unsupported JPEG
/// feature: ...` (Unsupported) and `unexpected EOF` (Truncated); Encode is
/// Go's `jpeg: image is too large to encode` (decision 0510); also Format
/// for a JPEG whose frame header asks for more than max_pixels pixels,
/// `image too large`.
pub enum JpegErr {
  Format(msg: Str)
  Unsupported(msg: Str)
  Truncated
  Encode(msg: Str)
}

pub fn (e: JpegErr) display() -> Str {
  match e {
    JpegErr.Format(msg) => "invalid JPEG format: " + msg
    JpegErr.Unsupported(msg) => "unsupported JPEG feature: " + msg
    JpegErr.Truncated => "unexpected EOF"
    JpegErr.Encode(msg) => msg
  }
}

/// The size of a YCbCr image's chroma planes.
pub fn (img: Image) chroma_width() -> Int {
  if img.model != Model.YCbCr {
    return 0
  }
  chroma_dims(img.subsample, img.width, img.height).0
}

pub fn (img: Image) chroma_height() -> Int {
  if img.model != Model.YCbCr {
    return 0
  }
  chroma_dims(img.subsample, img.width, img.height).1
}

/// The image as `width * height * 4` bytes of 8 bit RGBA, as Go's draw.Draw
/// converts it: YCbCr through color.YCbCrToRGB, CMYK through color.CMYKToRGB,
/// Gray as gray with alpha 255.
pub fn (img: Image) to_rgba() -> Bytes {
  let w = img.width
  let h = img.height
  var out = BytesBuilder.with_capacity(w * h * 4)
  if img.model == Model.Gray {
    for i in 0..(w * h) {
      let g = img.pix[i]
      out.write_byte(g)
      out.write_byte(g)
      out.write_byte(g)
      out.write_byte(UInt8(255))
    }
  } else if img.model == Model.RGBA {
    out.write(img.pix)
  } else if img.model == Model.CMYK {
    for i in 0..(w * h) {
      let k = Int(img.pix[4 * i + 3])
      let wk = 65535 - k * 257
      for c in 0..3 {
        let v = (65535 - Int(img.pix[4 * i + c]) * 257) * wk / 65535
        out.write_byte(UInt8(v >> 8))
      }
      out.write_byte(UInt8(255))
    }
  } else {
    let rt = ratios(img.subsample)
    let cw = img.chroma_width()
    // the ratios are 1, 2 or 4: shifts, not divisions, and the chroma row is fixed per row
    let sx = if rt.0 == 4 { 2 } else if rt.0 == 2 { 1 } else { 0 }
    let sy = if rt.1 == 4 { 2 } else if rt.1 == 2 { 1 } else { 0 }
    for y in 0..h {
      let crow = (y >> sy) * cw
      let yrow = y * w
      for x in 0..w {
        let ci = crow + (x >> sx)
        let rgb = ycbcr_rgb(Int(img.y[yrow + x]), Int(img.cb[ci]), Int(img.cr[ci]))
        out.write_byte(UInt8(rgb >> 16))
        out.write_byte(UInt8((rgb >> 8) & 255))
        out.write_byte(UInt8(rgb & 255))
        out.write_byte(UInt8(255))
      }
    }
  }
  out.freeze()
}

/// Go's jpeg.Decode. A header over max_pixels pixels is refused before
/// anything is allocated (Go allocates from the header).
pub fn decode(data: Bytes, max_pixels: Int = 100000000) -> Image ! JpegErr {
  var d = dec_new(data)
  segments(d, false, max_pixels)?
  finish(d)?
}

/// Go's jpeg.DecodeConfig: the size and image type without the pixels.
pub fn decode_config(data: Bytes) -> Config ! JpegErr {
  var d = dec_new(data)
  let complete = segments(d, true, 0)?
  if complete {
    // the end of the image without a scan: Go's decode goes on to its
    // missing SOS marker error
    return Err(fmt_err("missing SOS marker"))
  }
  if d.n_comp == 1 {
    return Config{width: d.w, height: d.h, model: Model.Gray}
  }
  if d.n_comp == 3 {
    let m = if is_rgb(d) { Model.RGBA } else { Model.YCbCr }
    return Config{width: d.w, height: d.h, model: m}
  }
  if d.n_comp == 4 {
    return Config{width: d.w, height: d.h, model: Model.CMYK}
  }
  Err(fmt_err("missing SOF marker"))
}

/// Go's jpeg.Encode with `Options{Quality: quality}` (decision 0510): baseline
/// 4:2:0 (one component for Gray), the standard Huffman tables, the quality
/// scaled quantization tables, Go's integer forward DCT, so the bytes are the
/// bytes Go writes. Gray, YCbCr (any subsample ratio), RGBA (Go's image.RGBA
/// fast path: premultiplied, alpha ignored) and CMYK inputs; `quality` is
/// clamped to 1..100. A width or height of 65,536 or more is
/// `JpegErr.Encode`; planes that do not match the size are a fault.
pub fn encode(img: Image, quality: Int = 75) -> Bytes ! JpegErr {
  let w = img.width
  let h = img.height
  if w >= 65536 || h >= 65536 {
    return Err(JpegErr.Encode(msg: "jpeg: image is too large to encode"))
  }
  let gray = img.model == Model.Gray
  if w < 0 || h < 0 {
    fault("encode: negative size ${w}x${h}")
  }
  if gray && img.pix.len() != w * h {
    fault("encode: pix has ${img.pix.len()} bytes, want ${w * h} for ${w}x${h}")
  }
  if (img.model == Model.RGBA || img.model == Model.CMYK) && img.pix.len() != w * h * 4 {
    fault("encode: pix has ${img.pix.len()} bytes, want ${w * h * 4} for ${w}x${h}")
  }
  var q = quality
  if q < 1 {
    q = 1
  } else if q > 100 {
    q = 100
  }
  var sc = 0
  if q < 50 {
    sc = 5000 / q
  } else {
    sc = 200 - q * 2
  }
  var quant_y = zlist(64)
  var quant_c = zlist(64)
  for j in 0..64 {
    var x = (ENC_QUANT_LUMA[j] * sc + 50) / 100
    if x < 1 {
      x = 1
    } else if x > 255 {
      x = 255
    }
    quant_y[j] = x
    var z = (ENC_QUANT_CHROMA[j] * sc + 50) / 100
    if z < 1 {
      z = 1
    } else if z > 255 {
      z = 255
    }
    quant_c[j] = z
  }
  var cw = 0
  var ch = 0
  var sx = 1
  var sy = 1
  if img.model == Model.YCbCr {
    cw = img.chroma_width()
    ch = img.chroma_height()
    if img.y.len() != w * h || img.cb.len() != cw * ch || img.cr.len() != cw * ch {
      fault("encode: planes do not match ${w}x${h}")
    }
    let rt = ratios(img.subsample)
    sx = rt.0
    sy = rt.1
  }
  let dv_y = enc_divs(quant_y)
  let dv_c = enc_divs(quant_c)
  let ncomp = if gray { 1 } else { 3 }
  let lum_dc = enc_lut(ENC_LUM_DC_COUNT, ENC_LUM_DC_VALUE)
  let lum_ac = enc_lut(ENC_LUM_AC_COUNT, ENC_LUM_AC_VALUE)
  let chr_dc = enc_lut(ENC_CHR_DC_COUNT, ENC_CHR_DC_VALUE)
  let chr_ac = enc_lut(ENC_CHR_AC_COUNT, ENC_CHR_AC_VALUE)
  var e = Enc{out: BytesBuilder.with_capacity(w * h / 4 + 700), acc: 0, n: 0}
  e.out.write(b"\xff\xd8")
  e.out.write(b"\xff\xdb\x00\x84")
  e.out.write_byte(UInt8(0))
  for j in 0..64 {
    e.out.write_byte(UInt8(quant_y[j]))
  }
  e.out.write_byte(UInt8(1))
  for j in 0..64 {
    e.out.write_byte(UInt8(quant_c[j]))
  }
  e.out.write(b"\xff\xc0")
  e.out.write_byte(UInt8(0))
  e.out.write_byte(UInt8(8 + 3 * ncomp))
  e.out.write_byte(UInt8(8))
  e.out.write_byte(UInt8(h >> 8))
  e.out.write_byte(UInt8(h & 255))
  e.out.write_byte(UInt8(w >> 8))
  e.out.write_byte(UInt8(w & 255))
  e.out.write_byte(UInt8(ncomp))
  if gray {
    e.out.write(b"\x01\x11\x00")
  } else {
    e.out.write(b"\x01\x22\x00\x02\x11\x01\x03\x11\x01")
  }
  var mlen = 2
  mlen += 1 + 16 + ENC_LUM_DC_VALUE.len()
  mlen += 1 + 16 + ENC_LUM_AC_VALUE.len()
  if !gray {
    mlen += 1 + 16 + ENC_CHR_DC_VALUE.len()
    mlen += 1 + 16 + ENC_CHR_AC_VALUE.len()
  }
  e.out.write(b"\xff\xc4")
  e.out.write_byte(UInt8(mlen >> 8))
  e.out.write_byte(UInt8(mlen & 255))
  e.out.write_byte(UInt8(0))
  for v in ENC_LUM_DC_COUNT {
    e.out.write_byte(UInt8(v))
  }
  for v in ENC_LUM_DC_VALUE {
    e.out.write_byte(UInt8(v))
  }
  e.out.write_byte(UInt8(16))
  for v in ENC_LUM_AC_COUNT {
    e.out.write_byte(UInt8(v))
  }
  for v in ENC_LUM_AC_VALUE {
    e.out.write_byte(UInt8(v))
  }
  if !gray {
    e.out.write_byte(UInt8(1))
    for v in ENC_CHR_DC_COUNT {
      e.out.write_byte(UInt8(v))
    }
    for v in ENC_CHR_DC_VALUE {
      e.out.write_byte(UInt8(v))
    }
    e.out.write_byte(UInt8(17))
    for v in ENC_CHR_AC_COUNT {
      e.out.write_byte(UInt8(v))
    }
    for v in ENC_CHR_AC_VALUE {
      e.out.write_byte(UInt8(v))
    }
  }
  if gray {
    e.out.write(b"\xff\xda\x00\x08\x01\x01\x00\x00\x3f\x00")
  } else {
    e.out.write(b"\xff\xda\x00\x0c\x03\x01\x00\x02\x11\x03\x11\x00\x3f\x00")
  }
  let xmax = w - 1
  let ymax = h - 1
  let shx = if sx == 4 { 2 } else if sx == 2 { 1 } else { 0 }
  let shy = if sy == 2 { 1 } else { 0 }
  let mk = if img.model == Model.YCbCr { 1 } else if img.model == Model.RGBA { 2 } else { 3 }
  let ypl = img.y
  let cbpl = img.cb
  let crpl = img.cr
  let pxs = img.pix
  var b = zlist(64)
  var cbs = zlist(256)
  var xi = zlist(16)
  var crs = zlist(256)
  var prev_y = 0
  var prev_cb = 0
  var prev_cr = 0
  if gray {
    var y = 0
    while y < h {
      var x = 0
      while x < w {
        for j in 0..8 {
          let row = min2(y + j, ymax) * w
          for i in 0..8 {
            b[8 * j + i] = Int(pxs[row + min2(x + i, xmax)])
          }
        }
        prev_y = enc_block(e, b, 0, dv_y, lum_dc, lum_ac, prev_y)
        x += 8
      }
      y += 8
    }
  } else {
    var y = 0
    while y < h {
      var x = 0
      while x < w {
        for i in 0..16 {
          xi[i] = min2(x + i, xmax)
        }
        for blk in 0..4 {
          let xo = (blk & 1) * 8
          let py = y + ((blk & 2) * 4)
          for j in 0..8 {
            let syy = min2(py + j, ymax)
            for i in 0..8 {
              let sxx = xi[xo + i]
              var yv = 0
              var cbv = 0
              var crv = 0
              if mk == 1 {
                yv = Int(ypl[syy * w + sxx])
                let ci = (syy >> shy) * cw + (sxx >> shx)
                cbv = Int(cbpl[ci])
                crv = Int(crpl[ci])
              } else if mk == 2 {
                let o = (syy * w + sxx) * 4
                let t = rgb_ycc(Int(pxs[o]), Int(pxs[o + 1]), Int(pxs[o + 2]))
                yv = t.0
                cbv = t.1
                crv = t.2
              } else {
                let o = (syy * w + sxx) * 4
                let wk = 65535 - Int(pxs[o + 3]) * 257
                let r = (65535 - Int(pxs[o]) * 257) * wk / 65535
                let g = (65535 - Int(pxs[o + 1]) * 257) * wk / 65535
                let bl = (65535 - Int(pxs[o + 2]) * 257) * wk / 65535
                let t = rgb_ycc(r >> 8, g >> 8, bl >> 8)
                yv = t.0
                cbv = t.1
                crv = t.2
              }
              b[8 * j + i] = yv
              cbs[blk * 64 + 8 * j + i] = cbv
              crs[blk * 64 + 8 * j + i] = crv
            }
          }
          prev_y = enc_block(e, b, 0, dv_y, lum_dc, lum_ac, prev_y)
        }
        enc_scale(b, cbs)
        prev_cb = enc_block(e, b, 0, dv_c, chr_dc, chr_ac, prev_cb)
        enc_scale(b, crs)
        prev_cr = enc_block(e, b, 0, dv_c, chr_dc, chr_ac, prev_cr)
        x += 16
      }
      y += 16
    }
  }
  enc_emit(e, 127, 7)
  e.out.write(b"\xff\xd9")
  Ok(e.out.freeze())
}

