struct Enc {
  out: BytesBuilder
  acc: Int
  n: Int
}

fn enc_emit(var e: Enc, bits: Int, nb: Int) {
  e.acc = (e.acc << nb) | bits
  e.n += nb
  while e.n >= 8 {
    let b = (e.acc >> (e.n - 8)) & 255
    e.out.write_byte(UInt8(b))
    if b == 255 {
      e.out.write_byte(UInt8(0))
    }
    e.n -= 8
  }
  e.acc = e.acc & ((1 << e.n) - 1)
}

/// A look-up table of a Huffman specification: the codeword size in the high
/// bits (shifted by 24) and the codeword in the low 24 (Go's huffmanLUT).
fn enc_lut(count: List[Int], value: List[Int]) -> List[Int] {
  var lut = zlist(256)
  var code = 0
  var k = 0
  for i in 0..16 {
    let nbits = (i + 1) << 24
    for _j in 0..count[i] {
      lut[value[k]] = nbits | code
      code += 1
      k += 1
    }
    code = code << 1
  }
  lut
}

fn enc_huff(var e: Enc, lut: List[Int], value: Int) {
  let x = lut[value]
  enc_emit(e, x & 16777215, x >> 24)
}

fn enc_huff_rle(var e: Enc, lut: List[Int], run: Int, value: Int) {
  var a = value
  var b = value
  if a < 0 {
    a = -value
    b = value - 1
  }
  var nbits = 0
  if a < 256 {
    nbits = ENC_BITCOUNT[a]
  } else {
    nbits = 8 + ENC_BITCOUNT[a >> 8]
  }
  let x = lut[(run << 4) | nbits]
  let cs = x >> 24
  if nbits > 0 {
    enc_emit(e, ((x & 16777215) << nbits) | (b & ((1 << nbits) - 1)), cs + nbits)
  } else {
    enc_emit(e, x & 16777215, cs)
  }
}

/// Go's div: a / d rounded to the nearest integer, not toward zero, as a
/// multiply by m = ceil(2^31 / d) (exact for |a| below 2^20, d below 2^11
/// here; the coefficients are below 2^15).
fn enc_div(a: Int, d: Int, m: Int) -> Int {
  if a >= 0 {
    return ((a + (d >> 1)) * m) >> 31
  }
  -(((d >> 1) - a) * m >> 31)
}

/// The divisors 8 * quant and their multipliers for enc_div.
fn enc_divs(quant: List[Int]) -> List[Int] {
  var out = zlist(192)
  for j in 0..64 {
    let d = 8 * quant[j]
    out[j] = d
    out[64 + j] = (2147483648 + d - 1) / d
    out[128 + j] = d - (d >> 1)
  }
  out
}

/// The forward DCT of Go's dct.go on the 64 values of b at off, in place.
fn fdct(var b: List[Int], off: Int) {
  for i in 0..8 {
    var x0 = b[off + i]
    var x1 = b[off + 8 + i]
    var x2 = b[off + 16 + i]
    var x3 = b[off + 24 + i]
    var x4 = b[off + 32 + i]
    var x5 = b[off + 40 + i]
    var x6 = b[off + 48 + i]
    var x7 = b[off + 56 + i]
    var t = x0 + x7
    x7 = x0 - x7
    x0 = t
    t = x1 + x6
    x6 = x1 - x6
    x1 = t
    t = x2 + x5
    x5 = x2 - x5
    x2 = t
    t = x3 + x4
    x4 = x3 - x4
    x3 = t
    var ks = FD_COS3_18 * (x4 + x7)
    t = ks + (FD_SIN3_18 - FD_COS3_18) * x7
    x7 = ks - (FD_COS3_18 + FD_SIN3_18) * x4
    x4 = t
    ks = FD_COS1_18 * (x5 + x6)
    t = ks + (FD_SIN1_18 - FD_COS1_18) * x6
    x6 = ks - (FD_COS1_18 + FD_SIN1_18) * x5
    x5 = t
    t = x0 + x3
    x3 = x0 - x3
    x0 = t
    t = x1 + x2
    x2 = x1 - x2
    x1 = t
    ks = FD_S2C6_18 * (x2 + x3)
    t = ks + (FD_S2S6_18 - FD_S2C6_18) * x3
    x3 = ks - (FD_S2C6_18 + FD_S2S6_18) * x2
    x2 = t
    t = x0 + x1
    x1 = x0 - x1
    x0 = t
    b[off + i] = (x0 - 1024) << 18
    b[off + 32 + i] = x1 << 18
    b[off + 16 + i] = x2
    b[off + 48 + i] = x3
    t = x4 + x6
    x6 = x4 - x6
    x4 = t
    t = x7 + x5
    x5 = x7 - x5
    x7 = t
    x5 = (x5 >> 12) * FD_SQRT2_12
    x6 = (x6 >> 12) * FD_SQRT2_12
    t = x7 + x4
    x4 = x7 - x4
    x7 = t
    b[off + 8 + i] = x7
    b[off + 24 + i] = x5
    b[off + 40 + i] = x6
    b[off + 56 + i] = x4
  }
  for i in 0..8 {
    let r = off + 8 * i
    var x0 = b[r]
    var x1 = b[r + 1]
    var x2 = b[r + 2]
    var x3 = b[r + 3]
    var x4 = b[r + 4]
    var x5 = b[r + 5]
    var x6 = b[r + 6]
    var x7 = b[r + 7]
    var t = x0 + x7
    x7 = x0 - x7
    x0 = t
    t = x1 + x6
    x6 = x1 - x6
    x1 = t
    t = x2 + x5
    x5 = x2 - x5
    x2 = t
    t = x3 + x4
    x4 = x3 - x4
    x3 = t
    var a = x4 >> 14
    var c = x7 >> 14
    var ks = FD_COS3_14 * (a + c)
    x4 = ks + (FD_SIN3_14 - FD_COS3_14) * c
    x7 = ks - (FD_COS3_14 + FD_SIN3_14) * a
    a = x5 >> 14
    c = x6 >> 14
    ks = FD_COS1_14 * (a + c)
    x5 = ks + (FD_SIN1_14 - FD_COS1_14) * c
    x6 = ks - (FD_COS1_14 + FD_SIN1_14) * a
    t = x0 + x3
    x3 = x0 - x3
    x0 = t
    t = x1 + x2
    x2 = x1 - x2
    x1 = t
    a = x2 >> 14
    c = x3 >> 14
    ks = FD_S2C6_14 * (a + c)
    x2 = ks + (FD_S2S6_14 - FD_S2C6_14) * c
    x3 = ks - (FD_S2C6_14 + FD_S2S6_14) * a
    t = x0 + x1
    x1 = x0 - x1
    x0 = t
    t = x4 + x6
    x6 = x4 - x6
    x4 = t
    t = x7 + x5
    x5 = x7 - x5
    x7 = t
    x5 = (x5 >> 14) * FD_SQRT2_14
    x6 = (x6 >> 14) * FD_SQRT2_14
    t = x7 + x4
    x4 = x7 - x4
    x7 = t
    b[r] = (x0 + 131072) >> 18
    b[r + 1] = (x7 + 131072) >> 18
    b[r + 2] = (x2 + 131072) >> 18
    b[r + 3] = (x5 + 131072) >> 18
    b[r + 4] = (x1 + 131072) >> 18
    b[r + 5] = (x6 + 131072) >> 18
    b[r + 6] = (x3 + 131072) >> 18
    b[r + 7] = (x4 + 131072) >> 18
  }
}

/// Go's writeBlock: the block at off (natural order), quantized with q and
/// written; the DC value (post quantization) is returned.
fn enc_block(var e: Enc, var b: List[Int], off: Int, dv: List[Int], dc_lut: List[Int], ac_lut: List[Int], prev_dc: Int) -> Int {
  fdct(b, off)
  let dc = enc_div(b[off], dv[0], dv[64])
  enc_huff_rle(e, dc_lut, 0, dc - prev_dc)
  var run = 0
  for zig in 1..64 {
    let a = b[off + UNZIG[zig]]
    let th = dv[128 + zig]
    if a < th && a > -th {
      run += 1
    } else {
      let ac = enc_div(a, dv[zig], dv[64 + zig])
      while run > 15 {
        enc_huff(e, ac_lut, 240)
        run -= 16
      }
      enc_huff_rle(e, ac_lut, run, ac)
      run = 0
    }
  }
  if run > 0 {
    enc_huff(e, ac_lut, 0)
  }
  dc
}

/// color.RGBToYCbCr.
fn rgb_ycc(r: Int, g: Int, b: Int) -> (Int, Int, Int) {
  let yy = (19595 * r + 38470 * g + 7471 * b + 32768) >> 16
  var cb = -11056 * r - 21712 * g + 32768 * b + 8421376
  if cb < 0 {
    cb = 0
  } else {
    cb = cb >> 16
    if cb > 255 {
      cb = 255
    }
  }
  var cr = 32768 * r - 27440 * g - 5328 * b + 8421376
  if cr < 0 {
    cr = 0
  } else {
    cr = cr >> 16
    if cr > 255 {
      cr = 255
    }
  }
  (yy, cb, cr)
}

fn min2(a: Int, b: Int) -> Int { if a < b { a } else { b } }

/// Go's scale: the 16x16 region of the four blocks at 256 of src to the 8x8
/// block at 0 of dst.
fn enc_scale(var dst: List[Int], src: List[Int]) {
  for i in 0..4 {
    let dst_off = ((i & 2) << 4) | ((i & 1) << 2)
    for y in 0..4 {
      for x in 0..4 {
        let j = 16 * y + 2 * x
        let s = src[i * 64 + j] + src[i * 64 + j + 1] + src[i * 64 + j + 8] + src[i * 64 + j + 9]
        dst[8 * y + x + dst_off] = (s + 2) >> 2
      }
    }
  }
}
