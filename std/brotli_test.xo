/// 16 MB of varied text through a Compressor (window 16) a piece at a
/// time, keeping only the compressed stream.
fn long_stream() -> Bytes {
  var c = compressor(1, 16)
  var out = BytesBuilder.new()
  var x = 7
  for _ in 0..256 {
    var b = BytesBuilder.new()
    while b.len() < 65536 {
      x = (x * 1103515245 + 12345) % 2147483648
      b.write_str(WORDS[(x >> 8) % WORDS.len()])
    }
    out.write(c.write(b.freeze()[0..65536]))
  }
  out.write(c.finish())
  out.freeze()
}

test "the Decompressor holds a meta-block and a window, not the stream" {
  let s = long_stream()
  let before = debug.mem_peak()
  var z = decompressor()
  var n = 0
  var at = 0
  while at < s.len() {
    let e = if at + 65536 < s.len() { at + 65536 } else { s.len() }
    n += z.write(s[at..e]).or_fault("write").len()
    at = e
  }
  n += z.finish().or_fault("finish").len()
  expect(n) == 16777216
  // 0 on the Go backend; natively the decode of the whole 16 MB output at
  // once would be over 16 MB (task #89, 2026-11-16)
  expect(debug.mem_peak() - before < 4194304) == true
}

test "ld64 is the little endian word at every offset, the last one too" {
  let b = Bytes.from_list([1, 2, 3, 4, 5, 6, 7, 8, 9, 250, 251, 252, 253, 254, 255, 128])
  for i in 0..9 {
    var want = 0
    var k = 7
    while k >= 0 {
      want = want.wrapping_shl(8) | Int(b[i + k])
      k -= 1
    }
    expect(ld64(b, i)) == want
  }
}

test "update_nodes' packed distance cache tables match Z_DC_INDEX and Z_DC_OFFSET" {
  for j in 0..16 {
    expect((Z_DC_INDEX_BITS >> (2 * j)) & 3) == Z_DC_INDEX[j]
    expect(((Z_DC_OFFSET_BITS >> (3 * j)) & 7) - 3) == Z_DC_OFFSET[j]
  }
}
