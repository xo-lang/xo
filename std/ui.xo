  // (at most a second: a pointerup outside the window may never arrive)
  var down=false,downAt=0,held=null;
  on(document,"pointerdown",function(){down=true;downAt=Date.now();},true);
  function release(){down=false;if(held!==null){setTimeout(function(){if(!down&&held!==null){var h=held;held=null;show(h);}},0);}}
  on(document,"pointerup",release,true);
  on(document,"pointercancel",release,true);
  function show(html){
    if(stopped||html===last)return;
    if(down&&Date.now()-downAt<1000){held=html;return;}
    held=null;
    if(document.createElement){
      var t=document.createElement("template");t.innerHTML=html;
      xoMorph(root,t.content,document.activeElement);
    }else root.innerHTML=html;
    last=html;
  }
  function predict(q){
