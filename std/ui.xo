// std/ui (spec/std.md 86, decision 0659 stage 1). Encoding rules are
// listed at the top of std/prelude.xo. Early: the API may change until
// decision 0659's stage 1 is done.
//
// A UI is an App: a model's start, one pure update and a view. The same
// update runs on every client (predicted at once) and on the server (in
// arrival order, the authority): clients send their Msgs, the server
// applies each (client, seq) exactly once and appends it to a log, and a
// client replays the log it has not seen with the same update and folds
// its pending Msgs on top. A client that is offline keeps working; its
// Msgs wait in its outbox. update and view are fn types without `uses`,
// so the checker already refuses a clock, randomness or I/O in them.
//
// Server and Replica are pure values that turn messages into messages;
// `host` serves an App over HTTP: the first page, the browser runtime and
// a sync endpoint. The browser queues its Msgs (in localStorage, so they
// survive going offline and reloads) and sends them. Given the App's
// client program built for wasm (`client_main`, decision 0659 stage 3) it
// runs update and view itself and shows each event at once; without one
// it is a thin client that shows the server's rendered view.

use std/compress
use std/crypto
use std/html
use std/http
use std/json
use std/sql
use std/task
use std/url
use std/websocket

/// A UI program.
pub struct App[M, E] {
  /// The model a new server starts from.
  pub init: M
  /// The one update, run on clients and the server alike. An invalid Msg
  /// should leave the model as it is: that is also the server's check.
  pub update: fn(M, E) -> M
  /// The page for a model.
  pub view: fn(M) -> Html
  /// The page for a model and the page's query, when the App keeps tab
  /// state in the URL (with_url_view); None: view.
  pub url_view: (fn(M, url.Values) -> Html)?
  /// Whether a Msg needs the server's answer before it shows (a payment, a
  /// booking): a replica never predicts it, and lists it in awaiting()
  /// until the server's log has it.
  pub confirm: fn(E) -> Bool
}

/// An App whose Msgs all show at once (confirm says false for each).
pub fn app[M, E](init: M, update: fn(M, E) -> M, view: fn(M) -> Html) -> App[M, E] {
  App{init: init, update: update, view: view, url_view: None, confirm: fn(_) { false }}
}

/// The same App with confirm deciding which Msgs wait for the server.
pub fn (a: App[M, E]) confirming(confirm: fn(E) -> Bool) -> App[M, E] {
  App{init: a.init, update: a.update, view: a.view, url_view: a.url_view, confirm: confirm}
}

/// The same App whose view also reads the page's query: tab state (a
/// filter, a sort, a selected row, a step) kept in the URL, so reload,
/// back and forward and a shared link show it, and the server renders it
/// on a first load (decision 0672). A link or a GET form changes it (the
/// page layer of decision 0670 fetches the new URL and morphs the page);
/// the shared model is not touched, and other viewers see nothing.
pub fn (a: App[M, E]) with_url_view(view: fn(M, url.Values) -> Html) -> App[M, E] {
  App{init: a.init, update: a.update, view: a.view, url_view: Some(view), confirm: a.confirm}
}

// The page for m at a page whose query is query (without the "?"); a
// query that does not parse reads as empty.
fn (a: App[M, E]) show(m: M, query: Str) -> Html {
  match a.url_view {
    Some(f) => f(m, url.parse_query(query).ok() ?? url.values())
    None => (a.view)(m)
  }
}

// ---- views ----

/// A view: text or an element. There is no raw HTML: text and attribute
/// values are always escaped.
pub enum Html {
  Text(s: Str)
  El(tag: Str, attrs: List[Attr], kids: List[Html])
}

/// An attribute; build one with `attr` or `on`.
pub struct Attr {
  pub name: Str
  pub value: Str
}

/// A text node.
pub fn text(s: Str) -> Html {
  Html.Text(s: s)
}

/// An element. A tag is lower case letters, digits and `-`, starting with
/// a letter; `script`, `style`, `iframe`, `object` and `embed` are
/// refused (a fault at render), since a view never carries code.
pub fn el(tag: Str, attrs: List[Attr] = [], kids: List[Html] = []) -> Html {
  Html.El(tag: tag, attrs: attrs, kids: kids)
}

/// An attribute. A name is lower case letters, digits and `-`, starting
/// with a letter, and never `on...` (event handlers are `on`); a fault at
/// render otherwise. A URL attribute (href, src, action, formaction)
/// whose scheme is not http, https, mailto or tel, or relative, renders
/// as `about:invalid#xo-unsafe` (html/template's rule).
pub fn attr(name: Str, value: Str) -> Attr {
  Attr{name: name, value: value}
}

/// An event that sends msg: `on("click", Msg.Add)` renders
/// `data-xo-click` holding msg as JSON, which the client runtime sends.
pub fn on[E: Json](event: Str, msg: E) -> Attr {
  Attr{name: "data-xo-${event}", value: json.encode_str(msg)}
}

fn name_ok(s: Str) -> Bool {
  if s == "" {
    return false
  }
  // every allowed character is ASCII, so the bytes are the runes (a
  // byte of a longer one fails); no list of runes per name
  for (i, c) in s.bytes().indexed() {
    let ok = (c >= 97 && c <= 122) || (i > 0 && ((c >= 48 && c <= 57) || c == 45))
    if !ok {
      return false
    }
  }
  true
}

fn void_tag(t: Str) -> Bool {
  match t {
    "area" | "base" | "br" | "col" | "embed" | "hr" | "img" | "input" | "link" | "meta" | "source" | "track" | "wbr" => true
    _ => false
  }
}

fn url_attr(n: Str) -> Bool {
  n == "href" || n == "src" || n == "action" || n == "formaction"
}

fn safe_url(v: Str) -> Bool {
  let t = v.trim().to_lower()
  match t.find(":") {
    None => true
    Some(i) => {
      // A ':' after a '/', '?' or '#' is not a scheme.
      let first = t.find_any("/?#")
      if let Some(j) = first {
        if j < i {
          return true
        }
      }
      let scheme = t[0..i]
      scheme == "http" || scheme == "https" || scheme == "mailto" || scheme == "tel"
    }
  }
}

/// The HTML text of a view.
pub fn render(h: Html) -> Str {
  var b = BytesBuilder.new()
  write_html(b, h)
  b.freeze().to_str_lossy()
}

fn write_html(var b: BytesBuilder, h: Html) {
  match h {
    Text(s) => b.write_str(html.escape_string(s))
    El(tag, attrs, kids) => {
      if !name_ok(tag) {
        fault("std/ui: bad tag name ${tag:?}")
      }
      match tag {
        "script" | "style" | "iframe" | "object" | "embed" => fault("std/ui: tag <${tag}> is refused: a view carries no code")
        _ => {}
      }
      b.write_byte(60)
      b.write_str(tag)
      for a in attrs {
        if !name_ok(a.name) || a.name.starts_with("on") {
          fault("std/ui: bad attribute name ${a.name:?}")
        }
        let v = if url_attr(a.name) && !safe_url(a.value) { "about:invalid#xo-unsafe" } else { a.value }
        b.write_byte(32)
        b.write_str(a.name)
        b.write_str("=\"")
        b.write_str(html.escape_string(v))
        b.write_byte(34)
      }
      b.write_str(">")
      if void_tag(tag) {
        return
      }
      for k in kids {
        write_html(b, k)
      }
      b.write_str("</")
      b.write_str(tag)
      b.write_byte(62)
    }
  }
}

// ---- the protocol ----

/// One Msg from a client, numbered from 1 per client.
pub struct Envelope[E] {
  pub seq: Int
  pub msg: E
} derive Json

/// A Msg the server applied: the log's entry `ver` (from 1).
pub struct Entry[E] {
  pub ver: Int
  pub client: Str
  pub seq: Int
  pub msg: E
  /// The server refused msg (`allow`, decision 0664): it takes a version
  /// and leaves the model as it was, so the sender drops it from pending.
  pub refused: Bool = false
} derive Json

/// A client's sync: its Msgs the server has not acknowledged, and the log
/// version it has.
pub struct Up[E] {
  pub client: Str
  pub ver: Int
  pub msgs: List[Envelope[E]]
  /// The digest of the page the client shows (Sync.seen), "" for none: a
  /// Host with redact answers `same` when this principal's view did not
  /// change, however far the version moved.
  pub seen: Str = ""
  /// The page's query (tab state, App.with_url_view), without the "?".
  pub query: Str = ""
} derive Json

/// The model at a log version, sent to a client too far behind for the
/// log the server kept (or ahead of it). `applied` is the last seq of
/// this client's Msgs the snapshot includes.
pub struct Snapshot[M] {
  pub ver: Int
  pub model: M
  pub applied: Int
} derive Json

/// The server's reply: the last seq of this client it applied, a
/// snapshot when the client must restart from one, and the log after the
/// client's version (at most the server's batch).
pub struct Down[M, E] {
  pub acked: Int
  pub reset: Snapshot[M]?
  pub entries: List[Entry[E]]
  /// Msgs of this sync the server refused (`allow`, decision 0664):
  /// acknowledged, so the client stops sending them, and not applied.
  pub refused: Int = 0
} derive Json

/// The authority: the model, the log, and each client's last seq.
pub struct Server[M, E] {
  app: App[M, E]
  model: M
  // The log holds versions base+1 ..= base+log.len(); base_model is the
  // model at base and base_seqs each client's last seq at base.
  base: Int
  base_model: M
  base_seqs: Map[Str, Int]
  log: List[Entry[E]]
  last_seq: Map[Str, Int]
  max_batch: Int
  // Each client id's principal, from its first receive_as (decision 0664).
  owners: Map[Str, Str] = {}
}

/// A server at the app's initial model. A reply carries at most
/// max_batch log entries (at least 1).
pub fn server[M, E](app: App[M, E], max_batch: Int = 256) -> Server[M, E] {
  Server{app: app, model: app.init, base: 0, base_model: app.init, base_seqs: {}, log: [], last_seq: {}, max_batch: if max_batch < 1 { 1 } else { max_batch }}
}

/// The authoritative model.
pub fn (s: Server[M, E]) model() -> M {
  s.model
}

/// The log version of the model: the number of Msgs logged (applied, or
/// refused by `allow`).
pub fn (s: Server[M, E]) version() -> Int {
  s.base + s.log.len()
}

/// The last seq applied for a client (0 for none).
pub fn (s: Server[M, E]) applied(client: Str) -> Int {
  s.last_seq.get(client) ?? 0
}

/// Applies the client's next Msgs (each seq once, in order: a duplicate
/// or one after a gap is skipped, and the client sends it again) and
/// returns the reply.
pub fn (var s: Server[M, E]) receive(up: Up[E]) -> Down[M, E] {
  for e in up.msgs {
    let last = s.last_seq.get(up.client) ?? 0
    if e.seq == last + 1 {
      s.model = s.app.update(s.model, e.msg)
      s.last_seq.put(up.client, e.seq)
      s.log.push(Entry{ver: s.version() + 1, client: up.client, seq: e.seq, msg: e.msg})
    }
  }
  s.reply(up.client, up.ver)
}

/// receive for a client acting as principal (decision 0664): a client id
/// belongs to the principal of its first call, and None answers another
/// principal using it. Each next Msg that allow refuses is acknowledged,
/// counted in the reply's refused and logged as refused, not applied.
pub fn (var s: Server[M, E]) receive_as(up: Up[E], principal: Str, allow: fn(M, Str, E) -> Bool) -> Down[M, E]? {
  match s.owners.get(up.client) {
    Some(o) => if o != principal { return None }
    None => s.owners.put(up.client, principal)
  }
  var refused = 0
  for e in up.msgs {
    let last = s.last_seq.get(up.client) ?? 0
    if e.seq == last + 1 {
      s.last_seq.put(up.client, e.seq)
      if allow(s.model, principal, e.msg) {
        s.model = s.app.update(s.model, e.msg)
        s.log.push(Entry{ver: s.version() + 1, client: up.client, seq: e.seq, msg: e.msg})
      } else {
        // logged, so a replica whose reply was lost still learns of it
        s.log.push(Entry{ver: s.version() + 1, client: up.client, seq: e.seq, msg: e.msg, refused: true})
        refused += 1
      }
    }
  }
  Some(s.reply(up.client, up.ver) with {refused: refused})
}

/// The client id of the Msgs the server applies itself (Server.apply,
/// Host.apply). The runtime's ids never take it, and a sync naming it is
/// refused.
pub const SERVER_CLIENT = "~server"

/// Applies a Msg of the server's own (data loaded from elsewhere, a
/// timer): logged as the next seq of SERVER_CLIENT, so every replica
/// applies it in order; `allow` is not asked.
pub fn (var s: Server[M, E]) apply(msg: E) {
  let seq = (s.last_seq.get(SERVER_CLIENT) ?? 0) + 1
  s.model = s.app.update(s.model, msg)
  s.last_seq.put(SERVER_CLIENT, seq)
  s.log.push(Entry{ver: s.version() + 1, client: SERVER_CLIENT, seq: seq, msg: msg})
}

/// The reply for a client at version ver, without new Msgs.
pub fn (s: Server[M, E]) reply(client: Str, ver: Int) -> Down[M, E] {
  let acked = s.last_seq.get(client) ?? 0
  if ver < s.base || ver > s.version() {
    let snap = Snapshot{ver: s.base, model: s.base_model, applied: s.base_seqs.get(client) ?? 0}
    return Down{acked: acked, reset: Some(snap), entries: s.batch(0)}
  }
  Down{acked: acked, reset: None, entries: s.batch(ver - s.base)}
}

fn (s: Server[M, E]) batch(from: Int) -> List[Entry[E]] {
  let end = if s.log.len() - from > s.max_batch { from + s.max_batch } else { s.log.len() }
  s.log[from..end].clone()
}

/// Drops all but the newest keep log entries; a client older than the
/// rest gets a snapshot.
pub fn (var s: Server[M, E]) compact(keep: Int) {
  let k = if keep < 0 { 0 } else { keep }
  if s.log.len() <= k {
    return
  }
  let drop = s.log.len() - k
  for e in s.log[0..drop] {
    if !e.refused {
      s.base_model = s.app.update(s.base_model, e.msg)
    }
    s.base_seqs.put(e.client, e.seq)
  }
  s.base = s.base + drop
  s.log = s.log[drop..].clone()
}

// ---- scoped logs in a durable store (decision 0686) ----

/// One append to a scope's log: count entries as the versions after
/// `after`, encoded by the Scope (a backend never reads them).
pub struct Batch {
  pub after: Int
  pub count: Int
  pub data: Bytes
}

/// Where scoped logs are kept. append is the one atomic operation, a
/// conditional create that every durable backend has (memory, a
/// directory, Postgres, S3, ...): it writes the batch only if the
/// scope's log ends at `after`, and answers false when another writer
/// took that version first.
pub struct Store[fx: Effects] {
  pub append: fn(Str, Batch) -> Bool ! Str uses fx
  /// The batches holding versions after `after`, oldest first (the first
  /// may start before it: a snapshot's version can fall inside a batch).
  /// Batches a snapshot covers may be gone.
  pub read: fn(Str, Int) -> List[Batch] ! Str uses fx
  /// The newest snapshot of a scope (`after` is its version, count 0).
  pub snapshot: fn(Str) -> Batch? ! Str uses fx
  /// Keeps a snapshot if it is newer than the one kept; the batches it
  /// covers may then be dropped.
  pub put_snapshot: fn(Str, Batch) -> () ! Str uses fx
}

/// A store in this process's memory: one instance, or tests of several
/// Scopes sharing it.
pub fn memory_store() -> Store[sync] {
  let logs = Mutex[Map[Str, List[Batch]]].new({})
  let snaps = Mutex[Map[Str, Batch]].new({})
  Store{
    append: fn(scope: Str, b: Batch) -> Bool ! Str uses sync {
      Ok(logs.with(fn(var m) {
        var l = m.get(scope) ?? []
        let top = if l.is_empty() { 0 } else { l[l.len() - 1].after + l[l.len() - 1].count }
        if b.after != top {
          return false
        }
        l.push(b)
        m.put(scope, l)
        true
      }))
    },
    read: fn(scope: Str, after: Int) -> List[Batch] ! Str uses sync {
      Ok(logs.with_read(fn(m) { (m.get(scope) ?? []).filter(fn(b) { b.after + b.count > after }) }))
    },
    snapshot: fn(scope: Str) -> Batch? ! Str uses sync {
      Ok(snaps.with_read(fn(m) { m.get(scope) }))
    },
    put_snapshot: fn(scope: Str, b: Batch) -> () ! Str uses sync {
      let newer = snaps.with(fn(var m) {
        if let Some(old) = m.get(scope) {
          if old.after >= b.after {
            return false
          }
        }
        m.put(scope, b)
        true
      })
      if newer {
        // the batches it covers go: memory stays bounded by keep
        logs.with(fn(var m) {
          if let Some(l) = m.get(scope) {
            m.put(scope, l.filter(fn(x) { x.after + x.count > b.after }))
          }
        })
      }
      Ok(())
    },
  }
}

// A scope's state at a version, as a snapshot keeps it.
struct Snap[M] {
  model: M
  seqs: Map[Str, Int]
  owners: Map[Str, Str]
} derive Json

// A log entry as stored: with the principal its client acted as, which
// replay needs to bind clients and a client is never sent.
struct Logged[E] {
  entry: Entry[E]
  principal: Str
} derive Json

/// A Server kept in step with one scope of a store: any number of Scopes
/// (in one process or many) share a scope's log, and each Msg is applied
/// once whichever Scope receives it. Each change reads the batches the
/// Scope lacks, applies the Msgs, and appends the new entries after the
/// version it read; when another Scope appended first it reads that
/// batch and applies the Msgs again.
pub struct Scope[M: Json, E: Json, fx: Effects] {
  s: Server[M, E]
  store: Store[fx]
  key: Str
  // whether this copy has read the store once (a new instance must)
  loaded: Bool = false
}

/// A Scope of store's log key, for app.
pub fn scope[M: Json, E: Json, fx: Effects](app: App[M, E], store: Store[fx], key: Str = "", max_batch: Int = 256) -> Scope[M, E, fx] {
  ui_scope(app, store, key, max_batch)
}

fn ui_scope[M: Json, E: Json, fx: Effects](app: App[M, E], store: Store[fx], key: Str, max_batch: Int) -> Scope[M, E, fx] {
  Scope{s: server(app, max_batch: max_batch), store: store, key: key}
}

// Applies an entry another Scope logged.
fn (var s: Server[M, E]) replay(e: Entry[E], principal: Str) {
  if e.client != SERVER_CLIENT && !s.owners.contains(e.client) {
    s.owners.put(e.client, principal)
  }
  s.last_seq.put(e.client, e.seq)
  if !e.refused {
    s.model = s.app.update(s.model, e.msg)
  }
  s.log.push(e)
}

// Starts this copy from the store's snapshot when it is past it.
fn (var c: Scope[M, E, fx]) load_snapshot() -> Bool ! Str uses (sync, fx) {
  let b = (c.store.snapshot)(c.key)? ?? return Ok(false)
  if b.after <= c.s.version() {
    return Ok(false)
  }
  let sn = json.decode_str[Snap[M]](b.data.to_str_lossy()).map_err(fn(e) { "std/ui: scope ${c.key}: snapshot: ${e}" })?
  c.s = Server{app: c.s.app, model: sn.model, base: b.after, base_model: sn.model, base_seqs: sn.seqs, log: [], last_seq: sn.seqs, max_batch: c.s.max_batch, owners: sn.owners}
  Ok(true)
}

/// Reads and applies the entries other Scopes appended (from the store's
/// snapshot first when this copy is older than the batches kept).
pub fn (var c: Scope[M, E, fx]) catch_up() -> () ! Str uses (sync, fx) {
  var bs = (c.store.read)(c.key, c.s.version())?
  if (bs.is_empty() && c.s.version() == 0) || (!bs.is_empty() && bs[0].after > c.s.version()) {
    if c.load_snapshot()? {
      bs = (c.store.read)(c.key, c.s.version())?
    }
  }
  for b in bs {
    if b.after > c.s.version() {
      return Err("std/ui: scope ${c.key}: a batch after ${b.after}, the log is at ${c.s.version()}")
    }
    let ls = json.decode_str[List[Logged[E]]](b.data.to_str_lossy()).map_err(fn(e) { "std/ui: scope ${c.key}: ${e}" })?
    for l in ls {
      // a batch can start before this copy's version (after a snapshot)
      if l.entry.ver == c.s.version() + 1 {
        c.s.replay(l.entry, l.principal)
      }
    }
  }
  c.loaded = true
  Ok(())
}

// How many lost races a change may take before it gives up. Each loss
// costs a read and a rerun; a store with W writers racing at full speed
// loses a given append k times in a row with odds near ((W-1)/W)^k, so
// 16 was hit by 4 processes on one Postgres scope (300 appends each) and
// 100 leaves it at about 3e-13 per append.
const commit_tries = 100


// Runs change on the Server and appends the entries it logs, as principal;
// on a lost race, catches up and runs it again.
fn (var c: Scope[M, E, fx]) commit[T](principal: Str, change: fn(var Server[M, E]) -> T) -> T ! Str uses (sync, fx) {
  Ok(c.commit_all([Change{principal: principal, run: change}])?[0])
}

// A change to run on a Scope's Server, logged as principal's.
struct Change[M: Json, E: Json, T] {
  principal: Str
  run: fn(var Server[M, E]) -> T
}

// Runs the changes in order and appends what they log as one batch
// (group commit: the syncs that queue while an append is in flight share
// the next one); on a lost race, catches up and runs them all again.
fn (var c: Scope[M, E, fx]) commit_all[T](changes: List[Change[M, E, T]]) -> List[T] ! Str uses (sync, fx) {
  var read = false
  for _ in 0..commit_tries {
    // a copy the Host keeps current (its bus) appends at once; a stale one
    // loses the race and reads the store, so a writer alone on a scope
    // pays one request per append, not two
    let caught = read || !c.loaded
    if caught {
      c.catch_up()?
    }
    read = true
    let before = c.s
    let v0 = c.s.version()
    var outs: List[T] = []
    var logged: List[Logged[E]] = []
    for ch in changes {
      let n0 = c.s.version()
      outs.push((ch.run)(c.s))
      for e in c.s.log[n0 - c.s.base..] {
        logged.push(Logged{entry: e, principal: ch.principal})
      }
    }
    if logged.is_empty() {
      if caught {
        return Ok(outs)
      }
      // an answer with no append (a refusal, a gap in a client's seqs)
      // must come from the store's state: read it and run again
      c.s = before
      continue
    }
    let data = json.encode_str(logged).bytes()
    match (c.store.append)(c.key, Batch{after: v0, count: logged.len(), data: data}) {
      Ok(true) => return Ok(outs)
      Ok(false) => c.s = before
      Err(e) => {
        // nothing was appended: this copy goes back to the store's version
        c.s = before
        return Err(e)
      }
    }
  }
  Err("std/ui: scope ${c.key}: ${commit_tries} appends lost to other writers in a row")
}

/// Server.receive through the store.
pub fn (var c: Scope[M, E, fx]) receive(up: Up[E]) -> Down[M, E] ! Str uses (sync, fx) {
  c.commit("", fn(var s) { s.receive(up) })
}

/// Server.receive_as through the store.
pub fn (var c: Scope[M, E, fx]) receive_as(up: Up[E], principal: Str, allow: fn(M, Str, E) -> Bool) -> Down[M, E]? ! Str uses (sync, fx) {
  c.commit(principal, fn(var s) { s.receive_as(up, principal, allow) })
}

/// Server.apply through the store.
pub fn (var c: Scope[M, E, fx]) apply(msg: E) -> () ! Str uses (sync, fx) {
  c.commit("", fn(var s) { s.apply(msg) })
}

/// Server.reply after catching up.
pub fn (var c: Scope[M, E, fx]) reply(client: Str, ver: Int) -> Down[M, E] ! Str uses (sync, fx) {
  c.catch_up()?
  Ok(c.s.reply(client, ver))
}

/// The model and version this Scope has read (catch_up first for the
/// store's newest).
pub fn (c: Scope[M, E, fx]) model() -> M {
  c.s.model
}

pub fn (c: Scope[M, E, fx]) version() -> Int {
  c.s.version()
}

/// Server.compact on this Scope's copy, and a snapshot at the new base
/// for the store (which may then drop the batches before it).
pub fn (var c: Scope[M, E, fx]) compact(keep: Int) -> () ! Str uses (sync, fx) {
  let b0 = c.s.base
  c.s.compact(keep)
  if c.s.base == b0 {
    return Ok(())
  }
  let data = json.encode_str(Snap{model: c.s.base_model, seqs: c.s.base_seqs, owners: c.s.owners}).bytes()
  (c.store.put_snapshot)(c.key, Batch{after: c.s.base, count: 0, data: data})
}

// Catches up when a notice named a version past this Scope's.
fn (var c: Scope[M, E, fx]) fresh(latest: Int, again: Bool = false) -> () ! Str uses (sync, fx) {
  if again {
    // the bus may have missed notices: read the store before trusting it
    c.loaded = false
  }
  if !c.loaded || latest > c.s.version() {
    c.catch_up()?
  }
  Ok(())
}

/// A store in a directory (decision 0686): one directory per scope, a file
/// per batch named by its `after`, and `snapshot.json`. An append holds
/// the scope's file lock, checks the log ends at `after`, and renames the
/// batch into place, so processes on one host (or one shared file system
/// with working locks) share it and a reader never sees part of a batch.
pub fn dir_store(f: Fs, dir: Str) -> Store[fs] {
  Store{
    append: fn(scope: Str, b: Batch) -> Bool ! Str uses fs {
      let d = dir_scope(f, dir, scope)?
      let l = f.lock("${d}/lock").map_err(fs_msg)?
      defer l.unlock()
      if dir_top(f, d)? != b.after {
        return Ok(false)
      }
      write_atomic(f, "${d}/${dir_name(b.after)}", dir_encode(b)).map_err(fs_msg)?
      Ok(true)
    },
    read: fn(scope: Str, after: Int) -> List[Batch] ! Str uses fs {
      let d = dir_scope(f, dir, scope)?
      let ns = dir_batches(f, d)?
      // the last batch starting at or before after may hold versions past it
      var from = 0
      for i in 0..ns.len() {
        if ns[i] <= after {
          from = i
        }
      }
      var out: List[Batch] = []
      for i in from..ns.len() {
        let b = dir_decode(f.read("${d}/${dir_name(ns[i])}").map_err(fs_msg)?)?
        if b.after + b.count > after {
          out.push(b)
        }
      }
      Ok(out)
    },
    snapshot: fn(scope: Str) -> Batch? ! Str uses fs {
      let d = dir_scope(f, dir, scope)?
      if !f.exists("${d}/snapshot.json").map_err(fs_msg)? {
        return Ok(None)
      }
      Ok(Some(dir_decode(f.read("${d}/snapshot.json").map_err(fs_msg)?)?))
    },
    put_snapshot: fn(scope: Str, b: Batch) -> () ! Str uses fs {
      let d = dir_scope(f, dir, scope)?
      let l = f.lock("${d}/lock").map_err(fs_msg)?
      defer l.unlock()
      if f.exists("${d}/snapshot.json").map_err(fs_msg)? {
        if dir_decode(f.read("${d}/snapshot.json").map_err(fs_msg)?)?.after >= b.after {
          return Ok(())
        }
      }
      write_atomic(f, "${d}/snapshot.json", dir_encode(b)).map_err(fs_msg)?
      // the batches it covers go; the one it falls inside stays
      for n in dir_batches(f, d)? {
        let x = dir_decode(f.read("${d}/${dir_name(n)}").map_err(fs_msg)?)?
        if x.after + x.count <= b.after {
          f.remove("${d}/${dir_name(n)}").map_err(fs_msg)?
        }
      }
      Ok(())
    },
  }
}

/// A store in SQL tables (decision 0686): Postgres (or any std/sql
/// database), `table` for batches and `table_snap` for snapshots, both
/// created if missing. An append is one INSERT that writes the batch only
/// when the log ends at `after`; the key (scope, after) turns a race into
/// a lost append. Instances on any number of hosts share it.
pub fn sql_store[fx: Effects](db: sql.Db[fx], table: Str = "xo_ui_log") -> Store[(net.dial, fx)] ! Str uses (net.dial, fx) {
  // a plain name, so it needs no quoting on any driver
  if table.is_empty() || !table.runes().all(fn(r) { (r >= 'a' && r <= 'z') || (r >= '0' && r <= '9') || r == '_' }) {
    return Err("std/ui: sql_store: table ${table}: use a-z, 0-9 and _")
  }
  let t = table
  let ts = table + "_snap"
  sql_create(db, "CREATE TABLE IF NOT EXISTS ${t} (scope TEXT NOT NULL, after BIGINT NOT NULL, count BIGINT NOT NULL, data BYTEA NOT NULL, PRIMARY KEY (scope, after))")?
  sql_create(db, "CREATE TABLE IF NOT EXISTS ${ts} (scope TEXT PRIMARY KEY, after BIGINT NOT NULL, data BYTEA NOT NULL)")?
  Ok(Store{
    append: fn(scope: Str, b: Batch) -> Bool ! Str uses (net.dial, fx) {
      let top = sql_top(db, t, ts, scope)?
      if top != b.after {
        return Ok(false)
      }
      match db.exec("INSERT INTO ${t} (scope, after, count, data) VALUES ($1, $2, $3, $4)", [sql.str(scope), sql.int(b.after), sql.int(b.count), sql.bytes(b.data)]) {
        Ok(_) => {}
        // another instance appended after the same version first
        Err(sql.SqlErr.Constraint(..)) => return Ok(false)
        Err(e) => return Err(sql_msg(e))
      }
      // a batch written after a snapshot dropped what it covered, or a
      // stale writer that read before another's batch: the key on after
      // stops a second batch at the same version, and the check above
      // stops a gap; a batch inside the log is impossible as after is
      // always a batch end the writer read
      Ok(true)
    },
    read: fn(scope: Str, after: Int) -> List[Batch] ! Str uses (net.dial, fx) {
      let rows = db.query("SELECT after, count, data FROM ${t} WHERE scope = $1 AND after + count > $2 ORDER BY after", [sql.str(scope), sql.int(after)]).map_err(sql_msg)?
      var out: List[Batch] = []
      for r in rows {
        out.push(Batch{after: r.int("after").map_err(sql_msg)?, count: r.int("count").map_err(sql_msg)?, data: r.bytes("data").map_err(sql_msg)?})
      }
      Ok(out)
    },
    snapshot: fn(scope: Str) -> Batch? ! Str uses (net.dial, fx) {
      let rows = db.query("SELECT after, data FROM ${ts} WHERE scope = $1", [sql.str(scope)]).map_err(sql_msg)?
      if rows.is_empty() {
        return Ok(None)
      }
      Ok(Some(Batch{after: rows[0].int("after").map_err(sql_msg)?, count: 0, data: rows[0].bytes("data").map_err(sql_msg)?}))
    },
    put_snapshot: fn(scope: Str, b: Batch) -> () ! Str uses (net.dial, fx) {
      let n = db.exec("UPDATE ${ts} SET after = $2, data = $3 WHERE scope = $1 AND after < $2", [sql.str(scope), sql.int(b.after), sql.bytes(b.data)]).map_err(sql_msg)?.rows_affected
      if n == 0 {
        match db.exec("INSERT INTO ${ts} (scope, after, data) VALUES ($1, $2, $3)", [sql.str(scope), sql.int(b.after), sql.bytes(b.data)]) {
          Ok(_) => {}
          // there is one, as new or newer
          Err(sql.SqlErr.Constraint(..)) => return Ok(())
          Err(e) => return Err(sql_msg(e))
        }
      }
      db.exec("DELETE FROM ${t} WHERE scope = $1 AND after + count <= $2", [sql.str(scope), sql.int(b.after)]).map_err(sql_msg)?
      Ok(())
    },
  })
}

// Runs a CREATE TABLE IF NOT EXISTS. Postgres's is not safe against itself:
// two instances starting together can both pass the check, and the second
// gets a duplicate key in the catalog; the table is then there.
fn sql_create[fx: Effects](db: sql.Db[fx], q: Str) -> () ! Str uses (net.dial, fx) {
  match db.exec(q) {
    Ok(_) => Ok(())
    Err(sql.SqlErr.Constraint(..)) => Ok(())
    Err(e) => Err(sql_msg(e))
  }
}

// Where a scope's log ends: the last batch's end, else the snapshot's.
fn sql_top[fx: Effects](db: sql.Db[fx], t: Str, ts: Str, scope: Str) -> Int ! Str uses (net.dial, fx) {
  let rows = db.query("SELECT after + count AS top FROM ${t} WHERE scope = $1 ORDER BY after DESC LIMIT 1", [sql.str(scope)]).map_err(sql_msg)?
  if !rows.is_empty() {
    return rows[0].int("top").map_err(sql_msg)
  }
  let snaps = db.query("SELECT after FROM ${ts} WHERE scope = $1", [sql.str(scope)]).map_err(sql_msg)?
  if !snaps.is_empty() {
    return snaps[0].int("after").map_err(sql_msg)
  }
  Ok(0)
}

fn sql_msg(e: sql.SqlErr) -> Str {
  "std/ui: store: ${e}"
}

fn fs_msg(e: FsErr) -> Str {
  "std/ui: store: ${e}"
}

/// Objects in a bucket (S3, R2, GCS, MinIO, ...): the four calls
/// object_store needs, which a program writes over its SDK.
pub struct Objects[fx: Effects] {
  /// Writes the object only if no object has the key (S3: a PUT with
  /// `If-None-Match: *`), false when one does (S3: 412, or 409 for a
  /// concurrent conditional write).
  pub create: fn(Str, Bytes) -> Bool ! Str uses fx
  /// Writes or replaces the object.
  pub put: fn(Str, Bytes) -> () ! Str uses fx
  /// The object, None when there is none.
  pub get: fn(Str) -> Bytes? ! Str uses fx
  /// The keys starting with the prefix that sort after the second
  /// argument ("" for all), in order (S3: ListObjectsV2 with StartAfter,
  /// every page).
  pub list: fn(Str, Str) -> List[Str] ! Str uses fx
}

/// A store in a bucket (decision 0686): an object per batch named by the
/// scope (in hex) and its `after`, zero padded, and one snapshot object
/// per scope. An append is a conditional create: a writer appends only at
/// the end of the log it read, so the name is free exactly when the log
/// still ends there, and instances on any number of hosts share it with
/// no lock. Batches stay after a snapshot (a deleted name could be taken
/// again by a writer that had not seen it, so a bucket lifecycle rule
/// must not expire them); readers start at the snapshot's batch, so the
/// old ones are not read.
pub fn object_store[fx: Effects](o: Objects[fx], prefix: Str = "xo-ui/") -> Store[(sync, fx)] {
  // Per scope, the batch the newest snapshot this store has seen falls
  // in. Batches are never deleted, so an older one is only slower.
  let froms = Mutex[Map[Str, Int]].new({})
  Store{
    append: fn(scope: Str, b: Batch) -> Bool ! Str {
      (o.create)(obj_dir(prefix, scope) + obj_name(b.after), dir_encode(b))
    },
    read: fn(scope: Str, after: Int) -> List[Batch] ! Str {
      let d = obj_dir(prefix, scope)
      if after > 0 {
        // catching up from where a batch ended: one list
        let ns = obj_starts(o, d, after)?
        if !ns.is_empty() && ns[0] == after {
          return obj_fetch(o, d, scope, ns, after)
        }
      }
      // after is 0, the log's end, or inside a batch (a snapshot's
      // version): read from the batch the snapshot falls in, so the
      // history it covers is not read
      var from = froms.with_read(fn(m) { m.get(scope) ?? -1 })
      if from < 0 {
        from = 0
        if let Some(raw) = (o.get)(d + "snap")? {
          from = obj_snap_decode(raw)?.0
        }
        note_from(froms, scope, from)
      }
      let all = obj_starts(o, d, from)?
      var start = from
      for n in all {
        if n <= after {
          start = n
        }
      }
      obj_fetch(o, d, scope, all.filter(fn(n) { n >= start }), after)
    },
    snapshot: fn(scope: Str) -> Batch? ! Str {
      let raw = (o.get)(obj_dir(prefix, scope) + "snap")? ?? return Ok(None)
      let (from, b) = obj_snap_decode(raw)?
      note_from(froms, scope, from)
      Ok(Some(b))
    },
    put_snapshot: fn(scope: Str, b: Batch) -> () ! Str {
      let d = obj_dir(prefix, scope)
      var low = 0
      if let Some(raw) = (o.get)(d + "snap")? {
        let (f, old) = obj_snap_decode(raw)?
        if old.after >= b.after {
          return Ok(())
        }
        low = f
      }
      // the batch the snapshot's version falls in (or ends): readers
      // start there
      var from = low
      for n in obj_starts(o, d, low)? {
        if n <= b.after {
          from = n
        }
      }
      // two writers may race here; either snapshot is a true state
      (o.put)(d + "snap", "${from}\n".bytes() + dir_encode(b))?
      note_from(froms, scope, from)
      Ok(())
    },
  }
}

// A scope's objects: prefix, s + the key in hex, "/".
fn obj_dir(prefix: Str, scope: Str) -> Str {
  "${prefix}s${scope.bytes().to_hex()}/"
}

// A batch object: b + after zero padded, so names sort as numbers.
fn obj_name(after: Int) -> Str {
  "b" + "${after}".pad_left(20, "0")
}

// The afters of a scope's batches from low on, in order.
fn obj_starts[fx: Effects](o: Objects[fx], d: Str, low: Int) -> List[Int] ! Str uses fx {
  let from = if low > 0 { d + obj_name(low - 1) } else { "" }
  var ns: List[Int] = []
  for k in (o.list)(d + "b", from)? {
    if let Some(n) = Int.parse(k.trim_prefix(d + "b")) {
      ns.push(n)
    }
  }
  Ok(ns)
}

// Keeps the newest snapshot batch seen for a scope (snapshots only move
// forward, and a stale one is still safe to read from).
fn note_from(froms: Mutex[Map[Str, Int]], scope: Str, from: Int) {
  froms.with(fn(var m) {
    if from > (m.get(scope) ?? -1) {
      m.put(scope, from)
    }
  })
}

// The batches named ns, those with versions after `after`.
fn obj_fetch[fx: Effects](o: Objects[fx], d: Str, scope: Str, ns: List[Int], after: Int) -> List[Batch] ! Str uses fx {
  var out: List[Batch] = []
  for n in ns {
    let raw = (o.get)(d + obj_name(n))? ?? return Err("std/ui: store: batch ${n} of scope ${scope} is gone")
    let b = dir_decode(raw)?
    if b.after + b.count > after {
      out.push(b)
    }
  }
  Ok(out)
}

// A snapshot object: "from\n" (the batch it falls in), then a batch.
fn obj_snap_decode(raw: Bytes) -> (Int, Batch) ! Str {
  let nl = raw.find(b"\n") ?? return Err("std/ui: store: a snapshot without a header")
  let from = Int.parse(raw[..nl].to_str_lossy()) ?? return Err("std/ui: store: a bad snapshot header")
  Ok((from, dir_decode(raw[nl + 1..])?))
}

// A scope's directory: s + the key in hex, so any key is a safe name.
fn dir_scope(f: Fs, dir: Str, scope: Str) -> Str ! Str uses fs {
  let d = "${dir}/s${scope.bytes().to_hex()}"
  f.create_dir_all(d).map_err(fs_msg)?
  Ok(d)
}

// Batch files are named by after, zero padded so names sort as numbers.
fn dir_name(after: Int) -> Str {
  "${after}".pad_left(20, "0") + ".batch"
}

fn dir_batches(f: Fs, d: Str) -> List[Int] ! Str uses fs.read {
  var ns: List[Int] = []
  for e in f.read_dir(d).map_err(fs_msg)? {
    if e.name.ends_with(".batch") && !e.name.starts_with(".") {
      if let Some(n) = Int.parse(e.name.trim_suffix(".batch")) {
        ns.push(n)
      }
    }
  }
  Ok(ns)
}

// Where the log ends: the last batch's end, else the snapshot's version.
fn dir_top(f: Fs, d: Str) -> Int ! Str uses fs.read {
  let ns = dir_batches(f, d)?
  if !ns.is_empty() {
    let b = dir_decode(f.read("${d}/${dir_name(ns[ns.len() - 1])}").map_err(fs_msg)?)?
    return Ok(b.after + b.count)
  }
  if f.exists("${d}/snapshot.json").map_err(fs_msg)? {
    return Ok(dir_decode(f.read("${d}/snapshot.json").map_err(fs_msg)?)?.after)
  }
  Ok(0)
}

// A batch on disk: "after count\n" then the data.
fn dir_encode(b: Batch) -> Bytes {
  "${b.after} ${b.count}\n".bytes() + b.data
}

fn dir_decode(raw: Bytes) -> Batch ! Str {
  let nl = raw.find(b"\n") ?? return Err("std/ui: store: a batch file without a header")
  let head = raw[..nl].to_str_lossy().split(" ")
  if head.len() != 2 {
    return Err("std/ui: store: a bad batch header")
  }
  let after = Int.parse(head[0]) ?? return Err("std/ui: store: a bad batch header")
  let count = Int.parse(head[1]) ?? return Err("std/ui: store: a bad batch header")
  Ok(Batch{after: after, count: count, data: raw[nl + 1..]})
}

/// Notices of new versions between instances (decision 0686), chosen
/// apart from the store: an instance publishes after each append, and
/// every instance subscribed to the scope hears it (in process, Postgres
/// LISTEN/NOTIFY, Redis, NATS, or polling the store).
/// A subscriber hears each (scope, version) appended, for every scope (an
/// instance keeps the scopes it serves and skips the rest), and a negative
/// version when notices may have been missed (a reconnect): it then reads
/// the store before it trusts any copy again.
pub struct Bus[fx: Effects] {
  pub publish: fn(Str, Int) uses fx
  pub subscribe: fn(fn(Str, Int) uses sync) uses fx
}

/// A bus within this process: every Host given it hears the others.
pub fn local_bus() -> Bus[sync] {
  local_bus_of([])
}

// A local bus starting with these subscribers (making it performs nothing,
// so a one-instance host stays pure to build).
fn local_bus_of(first: List[fn(Str, Int) uses sync]) -> Bus[sync] {
  let subs = Mutex[List[fn(Str, Int) uses sync]].new(first)
  Bus{
    publish: fn(scope: Str, v: Int) uses sync {
      for f in subs.with_read(fn(l) { l }) {
        f(scope, v)
      }
    },
    subscribe: fn(f: fn(Str, Int) uses sync) uses sync {
      subs.with(fn(var l) { l.push(f) })
    },
  }
}

/// A bus over Postgres LISTEN/NOTIFY (decision 0686): publish is one
/// NOTIFY on `channel` ("version:scope"), and the first subscribe starts a
/// task in tasks holding one connection that LISTENs and hands each notice
/// to the scope's subscribers. After every LISTEN (the first and each
/// reconnect, a second apart while the database is away) the subscribers
/// hear -1 and read the store, since notices sent meanwhile are lost.
pub fn pg_bus[fx: Effects](db: sql.Db[fx], tasks: task.Group, clock: Clock, channel: Str = "xo_ui") -> Bus[(sync, net.dial, fx, clock)] {
  let subs = Mutex[List[fn(Str, Int) uses sync]].new([])
  let started = Atomic[Int].new(0)
  let deliver = fn(scope: Str, v: Int) uses sync {
    for f in subs.with_read(fn(l) { l }) {
      f(scope, v)
    }
  }
  Bus{
    publish: fn(scope: Str, v: Int) uses (sync, net.dial, fx, clock) {
      // this instance's own subscribers at once; the others by NOTIFY (a
      // lost NOTIFY delays them until their next notice or reconnect)
      deliver(scope, v)
      let _sent = db.query("SELECT pg_notify($1, $2)", [sql.str(channel), sql.str("${v}:${scope}")]).is_ok()
    },
    subscribe: fn(f: fn(Str, Int) uses sync) uses (sync, net.dial, fx, clock) {
      subs.with(fn(var l) { l.push(f) })
      if started.add(1) == 1 {
        tasks.spawn_background(fn() -> () ! Never uses (sync, net.dial, fx, clock) {
          while !task.is_canceled() {
            // an error ends this connection; the next LISTEN starts again
            let _ended = pg_listen(db, channel, deliver).is_ok()
            if task.is_canceled() {
              break
            }
            clock.sleep(1s)
          }
        })
      }
    },
  }
}

// One LISTEN connection: every scope hears -1 once it listens, then each
// notice; returns at the first error.
fn pg_listen[fx: Effects](db: sql.Db[fx], channel: Str, deliver: fn(Str, Int) uses sync) -> () ! sql.SqlErr uses (sync, net.dial, fx) {
  let conn = db.conn()?
  defer conn.close()
  conn.listen(channel)?
  deliver("", -1)
  while {
    let n = conn.wait_notification()?
    let i = n.payload.find(":") ?? continue
    if let Some(v) = Int.parse(n.payload[..i]) {
      deliver(n.payload[i + 1..], v)
    }
  }
}

/// A client's copy: the confirmed model at a log version and its own
/// Msgs not yet in the log.
pub struct Replica[M, E] {
  app: App[M, E]
  client: Str
  confirmed: M
  ver: Int
  pending: List[Envelope[E]]
  next_seq: Int
  acked: Int
}

/// A replica for client starting from model at log version ver (the
/// state a server rendered page carries).
pub fn replica[M, E](app: App[M, E], client: Str, model: M, ver: Int) -> Replica[M, E] {
  Replica{app: app, client: client, confirmed: model, ver: ver, pending: [], next_seq: 1, acked: 0}
}

/// Applies msg locally at once and queues it for the server.
pub fn (var r: Replica[M, E]) send(msg: E) {
  r.pending.push(Envelope{seq: r.next_seq, msg: msg})
  r.next_seq = r.next_seq + 1
}

/// What the client shows: its pending Msgs over the confirmed model,
/// except those the App confirms (they wait for the server).
pub fn (r: Replica[M, E]) model() -> M {
  let up = r.app.update
  let confirm = r.app.confirm
  r.pending.fold(r.confirmed, fn(m, e) { if confirm(e.msg) { m } else { up(m, e.msg) } })
}

/// The pending Msgs the App confirms, oldest first: the view shows them
/// as waiting, never as done.
pub fn (r: Replica[M, E]) awaiting() -> List[E] {
  let confirm = r.app.confirm
  r.pending.filter(fn(e) { confirm(e.msg) }).map(fn(e) { e.msg })
}

/// The confirmed model, as the server had it at version().
pub fn (r: Replica[M, E]) confirmed() -> M {
  r.confirmed
}

/// The log version the confirmed model is at.
pub fn (r: Replica[M, E]) version() -> Int {
  r.ver
}

/// The number of Msgs not yet confirmed.
pub fn (r: Replica[M, E]) pending() -> Int {
  r.pending.len()
}

/// The sync to send: the Msgs the server has not acknowledged. Send it
/// whenever there is a connection; a lost one is sent again next time.
pub fn (r: Replica[M, E]) outbox() -> Up[E] {
  let acked = r.acked
  Up{client: r.client, ver: r.ver, msgs: r.pending.filter(fn(e) { e.seq > acked })}
}

/// Takes the server's reply: a snapshot if any, then the log entries that
/// follow the confirmed version (others are skipped); confirmed Msgs of
/// this client leave pending.
pub fn (var r: Replica[M, E]) receive(d: Down[M, E]) {
  if d.acked > r.acked {
    r.acked = d.acked
  }
  if let Some(snap) = d.reset {
    r.confirmed = snap.model
    r.ver = snap.ver
    r.drop_through(snap.applied)
  }
  for e in d.entries {
    if e.ver == r.ver + 1 {
      if !e.refused {
        r.confirmed = r.app.update(r.confirmed, e.msg)
      }
      r.ver = e.ver
      if e.client == r.client {
        r.drop_through(e.seq)
      }
    }
  }
}

fn (var r: Replica[M, E]) drop_through(seq: Int) {
  while let Some(p) = r.pending.first() {
    if p.seq > seq {
      break
    }
    r.pending.remove_at(0)
  }
}

// ---- the first page ----

/// The page's state as the client runtime reads it.
pub struct PageState[M] {
  pub ver: Int
  pub model: M
} derive Json

/// A whole HTML document for model at log version ver: the rendered view
/// in `<div id="xo-ui">`, so the page reads before any script runs, and
/// the state as JSON in `<script type="application/json" id="xo-state">`
/// for the client runtime at runtime_src, which syncs with sync_url and,
/// when live_url is not "", listens there for new versions. css,
/// if any, goes in a `<style>` element in the head.
pub fn page[M: Json, E](app: App[M, E], model: M, ver: Int, title: Str = "", runtime_src: Str = "/_xo/ui.js", sync_url: Str = "/_xo/sync", css: Str = "", live_url: Str = "", wasm_url: Str = "", build: Str = "", seen: Str = "", query: Str = "") -> Str {
  var b = BytesBuilder.new()
  b.write_str("<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>")
  b.write_str(html.escape_string(title))
  b.write_str("</title>")
  if wasm_url != "" && safe_url(wasm_url) {
    // start fetching the client module with the page, not after the
    // deferred runtime runs (crossorigin anonymous is the runtime fetch's
    // same-origin credentials mode, so the preload is reused)
    b.write_str("<link rel=\"preload\" href=\"${html.escape_string(wasm_url)}\" as=\"fetch\" type=\"application/wasm\" crossorigin=\"anonymous\">")
  }
  if css != "" {
    // CSS has no escapes for markup; `<` written as the CSS escape \3c
    // keeps the text from ending the style element.
    b.write_str("<style>")
    b.write_str(css.replace("<", "\\3c "))
    b.write_str("</style>")
  }
  b.write_str("</head><body><div id=\"xo-ui\" data-xo-sync=\"")
  b.write_str(html.escape_string(if safe_url(sync_url) { sync_url } else { "about:invalid#xo-unsafe" }))
  if live_url != "" && safe_url(live_url) {
    b.write_str("\" data-xo-live=\"")
    b.write_str(html.escape_string(live_url))
  }
  if wasm_url != "" && safe_url(wasm_url) {
    b.write_str("\" data-xo-wasm=\"")
    b.write_str(html.escape_string(wasm_url))
  }
  if build != "" {
    b.write_str("\" data-xo-build=\"")
    b.write_str(html.escape_string(build))
  }
  if seen != "" {
    b.write_str("\" data-xo-seen=\"")
    b.write_str(html.escape_string(seen))
  }
  b.write_str("\">")
  write_html(b, app.show(model, query))
  b.write_str("</div><script type=\"application/json\" id=\"xo-state\">")
  // encode_str does not escape HTML; html_escape writes the JSON's
  // angle brackets and ampersands as escapes, so a model's text cannot
  // end the element.
  b.write_str(json.html_escape(json.encode_str(PageState{ver: ver, model: model})))
  b.write_str("</script>")
  if runtime_src != "" {
    let src = if safe_url(runtime_src) { runtime_src } else { "about:invalid#xo-unsafe" }
    b.write_str("<script src=\"${html.escape_string(src)}\" defer></script>")
  }
  b.write_str("</body></html>")
  b.freeze().to_str_lossy()
}

// ---- form values ----

const FIELD_MARK = "\u{E000}"

/// A placeholder for the value of the form field `name`, filled in by the
/// client runtime when the event fires: `on("submit",
/// Msg.Add(title: field("title")))` sends the form's `title` field. A
/// field the form lacks is "". Only Str fields of a Msg can hold one.
pub fn field(name: Str) -> Str {
  "${FIELD_MARK}${name}"
}

// ---- serving an App over HTTP ----

/// The reply to the browser runtime: the protocol reply, the log version
/// the server is at, and the view rendered for the server's model.
pub struct Sync[M, E] {
  pub down: Down[M, E]
  pub ver: Int
  pub html: Str
  /// The server's model, when the request asked for it (`?model=1`): a
  /// client that predicts folds its pending Msgs over it.
  pub model: M? = None
  /// Nothing changed for this client: it sent no Msgs and already has the
  /// current version, so html is "" and model None, and it keeps what it
  /// shows (an idle poll costs bytes, not the whole page).
  pub same: Bool = false
  /// The build of the runtime and client this server serves (the stamps
  /// in their URLs): a page showing another build reloads once nothing
  /// waits to be sent.
  pub build: Str = ""
  /// The digest of what this principal is shown (a Host with redact; ""
  /// otherwise): the client sends it back as Up.seen.
  pub seen: Str = ""
} derive Json

// ---- the predicting client (decision 0659 stage 3) ----

/// What a browser hands its App's client program: the server's confirmed
/// model and the Msgs it has sent that the server has not confirmed.
pub struct ClientIn[M, E] {
  pub model: M
  pub pending: List[E]
  /// The page's query (tab state, App.with_url_view), without the "?".
  pub query: Str = ""
} derive Json

/// What the client program answers: the view of the predicted model, and
/// how many of the pending Msgs wait for the server (App.confirm).
pub struct ClientOut {
  pub html: Str
  pub awaiting: Int
} derive Json

/// The view of the pending Msgs folded over the confirmed model, leaving
/// out those the App confirms (they wait for the server, as in a
/// Replica). The browser runs this, built for wasm, on every event.
pub fn predict[M, E](app: App[M, E], input: ClientIn[M, E]) -> ClientOut {
  var m = input.model
  var awaiting = 0
  for e in input.pending {
    if (app.confirm)(e) {
      awaiting += 1
    } else {
      m = (app.update)(m, e)
    }
  }
  ClientOut{html: render(app.show(m, input.query)), awaiting: awaiting}
}

/// The main of an App's client program, built with `--targets=wasip1/wasm`
/// and given to `host(client: ...)`: reads a ClientIn as JSON on stdin and
/// writes the ClientOut as JSON on stdout.
pub fn client_main[M: Json, E: Json](stdio: Stdio, app: App[M, E]) -> () ! Str uses stdio {
  let text = stdio.read_all().map_err(fn(e) { "${e}" })?
  let input = json.decode_str[ClientIn[M, E]](text).map_err(fn(e) { "${e}" })?
  stdio.print(json.encode_str(predict(app, input)))
  Ok(())
}

/// Serves the runtime at prefix/_xo/ui.js (a Host's mount does this for
/// its prefix): for server pages that load it without an App
/// (decision 0670). The stamped URL is runtime_url(prefix).
pub fn serve_runtime(var r: http.Router, prefix: Str = "") {
  let v = runtime_stamp()
  let tag = "\"${v}\""
  let gz = compress.gzip(RUNTIME_JS.bytes(), compress.Level.BestCompression)
  r.handle("GET ${prefix}/_xo/ui.js", fn(req) -> http.Response ! Never {
    let cc = cache_control(req, v)
    if req.header("If-None-Match") == Some(tag) {
      return http.Response{status: 304, headers: {"ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: b""}
    }
    if accepts_gzip(req.header("Accept-Encoding") ?? "") {
      return http.Response{status: 200, headers: {"Content-Type": "text/javascript; charset=utf-8", "Content-Encoding": "gzip", "ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: gz}
    }
    http.Response{status: 200, headers: {"Content-Type": "text/javascript; charset=utf-8", "ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: RUNTIME_JS.bytes()}
  })
}

/// The stamped URL of the runtime served under prefix, for a server
/// page's script element (decision 0670).
pub fn runtime_url(prefix: Str = "") -> Str {
  "${prefix}/_xo/ui.js?v=${runtime_stamp()}"
}

/// A server page the runtime takes over (decision 0670): links, forms and
/// frames on it, and links to it from other such pages, work without a
/// full load. body is the page's content; css goes in a style element;
/// prefix is where the runtime is served (serve_runtime, or a Host's
/// mount).
pub fn plain(title: Str, body: Html, css: Str = "", prefix: Str = "") -> Str {
  var b = BytesBuilder.new()
  b.write_str("<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>")
  b.write_str(html.escape_string(title))
  b.write_str("</title>")
  if css != "" {
    b.write_str("<style>")
    b.write_str(css.replace("<", "\\3c "))
    b.write_str("</style>")
  }
  b.write_str("</head><body data-xo-page>")
  write_html(b, body)
  let src = runtime_url(prefix)
  b.write_str("<script src=\"${html.escape_string(if safe_url(src) { src } else { "about:invalid#xo-unsafe" })}\" defer></script></body></html>")
  b.freeze().to_str_lossy()
}

/// The runtime's stamp: a SHA-256 prefix of RUNTIME_JS.
fn runtime_stamp() -> Str {
  crypto.sha256(RUNTIME_JS.bytes()).to_hex()[..16]
}

/// Cache-Control for an asset whose current stamp is v: cached for good
/// when the request names that stamp (a new build has a new URL), else
/// revalidated, so an old or missing stamp never pins today's bytes.
fn cache_control(req: http.Request, v: Str) -> Str {
  if req.query("v") == Some(v) { "public, max-age=31536000, immutable" } else { "no-cache" }
}

/// Whether an Accept-Encoding value accepts gzip (a `gzip` or `*` token
/// whose q is not 0).
fn accepts_gzip(v: Str) -> Bool {
  for part in v.split(",") {
    let fields = part.split(";")
    let name = fields[0].trim().to_lower()
    if name != "gzip" && name != "*" {
      continue
    }
    var ok = true
    for f in fields[1..] {
      let kv = f.trim().to_lower()
      if kv == "q=0" || kv == "q=0.0" || kv == "q=0.00" || kv == "q=0.000" {
        ok = false
      }
    }
    if ok {
      return true
    }
  }
  false
}

/// An App served over HTTP (decision 0686): its state in scopes of a
/// store, each scope this instance serves cached here behind its own lock.
pub struct Host[M: Json, E: Json, fx: Effects, bx: Effects] {
  app: App[M, E]
  store: Store[fx]
  bus: Bus[bx]
  // The scope of apply and model without one, and of every page when
  // scope_of is None.
  key: Str
  // The scope a page belongs to, from its path (never its query, which
  // is tab state) and the principal; None: not found (404). With it the
  // Host serves every path under its prefix. Sync and live requests name their
  // page and are given the scope that page has, so a client reaches only
  // a scope its own pages could.
  scope_of: (fn(Str, Str) -> Str?)?
  max_batch: Int
  // The scopes this instance holds (at most max_scopes; the least recently
  // used without a live page goes first, and is read again from the store
  // when it is next used).
  slots: Mutex[Map[Str, Slot[M, E, fx]]]
  max_scopes: Int
  tick: Atomic[Int]
  title: Str
  css: Str
  // The App's client program built for wasm, "" for a thin client.
  client: Bytes
  // client gzipped once, and its ETag (a quoted SHA-256 prefix)
  client_gz: Bytes
  client_tag: Str
  // Decision 0664: the principal of a request (None: 401), who may send
  // which Msg, and what each principal sees.
  auth: (fn(http.Request) -> Str? uses sync)?
  allow: (fn(M, Str, E) -> Bool)?
  redact: (fn(M, Str) -> M)?
  // Where a page request without a principal is sent (303), "" for 401.
  signin_url: Str
  // The log entries kept (Server.compact once the log holds twice as
  // many), 0 to keep every entry.
  keep: Int
  // The live connections, each told its scope's version when it changes
  // (with redact, only when its principal's view changed).
  subs: Mutex[Map[Int, Sub]]
  next_sub: Atomic[Int]
}

// One scope this instance serves: its copy of the log, the newest version
// the bus announced, whether the bus may have missed notices (it
// reconnected), and when it was last used.
struct Slot[M: Json, E: Json, fx: Effects] {
  state: Mutex[Scope[M, E, fx]]
  latest: Atomic[Int]
  resync: Atomic[Int]
  used: Atomic[Int]
  // syncs waiting for the next append, and whether a request is writing
  // them (group commit)
  queue: Mutex[List[Waiting[M, E]]]
  writing: Atomic[Int]
  // the live frames last sent, by the view they show (query and seen
  // digest): each is rendered and encoded once per version, then written
  // to every live page showing that view (decision 0689)
  frames: Mutex[Map[Str, Frame]]
}

// A live frame of a scope at version ver.
struct Frame {
  ver: Int
  text: Str
}

// What a live page is sent when its view changes (decision 0689): the
// version, its view, the seen digest and the build, as a Sync without
// msgs answers; q is the query the view was rendered for.
struct Push {
  ver: Int
  html: Str
  seen: Str
  build: Str
  q: Str
} derive Json

// A sync's change and where its answer goes.
struct Waiting[M: Json, E: Json] {
  change: Change[M, E, Down[M, E]?]
  out: Chan[Result[Down[M, E]?, Str]]
}

/// A host for app starting at app.init: one instance, its log in memory.
/// scope_of puts each page in a scope of its own (a room, a tenant, a
/// user), of which the instance keeps at most max_scopes.
pub fn host[M: Json, E: Json](app: App[M, E], title: Str = "", css: Str = "", max_batch: Int = 256, client: Bytes = b"", auth: (fn(http.Request) -> Str? uses sync)? = None, allow: (fn(M, Str, E) -> Bool)? = None, redact: (fn(M, Str) -> M)? = None, signin_url: Str = "", keep: Int = 10000, scope_of: (fn(Str, Str) -> Str?)? = None, max_scopes: Int = 1000) -> Host[M, E, sync, sync] {
  let subs = Mutex[Map[Int, Sub]].new({})
  let slots = Mutex[Map[Str, Slot[M, E, sync]]].new({})
  let bus = local_bus_of([waker(slots, subs)])
  host_core(app, memory_store(), bus, "", scope_of, max_scopes, slots, subs, title, css, max_batch, client, auth, allow, redact, signin_url, keep)
}

/// A host whose scopes live in store, hearing other instances' appends on
/// bus (decision 0686): Hosts given one store and one bus act as one App
/// behind a load balancer. `scope` is the scope of every page without
/// scope_of. The Host performs what the store and bus perform (a memory
/// store: sync; a networked one: net).
pub fn host_with[M: Json, E: Json, fx: Effects, bx: Effects](app: App[M, E], store: Store[fx], bus: Bus[bx], scope: Str = "", title: Str = "", css: Str = "", max_batch: Int = 256, client: Bytes = b"", auth: (fn(http.Request) -> Str? uses sync)? = None, allow: (fn(M, Str, E) -> Bool)? = None, redact: (fn(M, Str) -> M)? = None, signin_url: Str = "", keep: Int = 10000, scope_of: (fn(Str, Str) -> Str?)? = None, max_scopes: Int = 1000) -> Host[M, E, fx, bx] uses bx {
  let subs = Mutex[Map[Int, Sub]].new({})
  let slots = Mutex[Map[Str, Slot[M, E, fx]]].new({})
  (bus.subscribe)(waker(slots, subs))
  host_core(app, store, bus, scope, scope_of, max_scopes, slots, subs, title, css, max_batch, client, auth, allow, redact, signin_url, keep)
}

// What a Host hears from its bus: each instance's append (this one's
// too) to a scope it holds wakes that scope's live connections; -1 (a
// reconnect) makes every scope read the store again.
fn waker[M: Json, E: Json, fx: Effects](slots: Mutex[Map[Str, Slot[M, E, fx]]], subs: Mutex[Map[Int, Sub]]) -> fn(Str, Int) uses sync {
  fn(scope: Str, v: Int) uses sync {
    if v < 0 {
      slots.with_read(fn(m) {
        for (_, sl) in m {
          sl.resync.set(1)
        }
      })
    } else if let Some(sl) = slots.with_read(fn(m) { m.get(scope) }) {
      // a scope not held here is read from the store when next used
      sl.latest.max(v)
    }
    subs.with_read(fn(m) {
      for (_, c) in m {
        if v < 0 || c.key == scope {
          let _sent = c.ch.try_send(v)
        }
      }
    })
  }
}

fn host_core[M: Json, E: Json, fx: Effects, bx: Effects](app: App[M, E], st: Store[fx], b: Bus[bx], scope: Str, scope_of: (fn(Str, Str) -> Str?)?, max_scopes: Int, slots: Mutex[Map[Str, Slot[M, E, fx]]], subs: Mutex[Map[Int, Sub]], title: Str, css: Str, max_batch: Int, client: Bytes, auth: (fn(http.Request) -> Str? uses sync)?, allow: (fn(M, Str, E) -> Bool)?, redact: (fn(M, Str) -> M)?, signin_url: Str, keep: Int) -> Host[M, E, fx, bx] {
  Host{app: app, store: st, bus: b, key: scope, scope_of: scope_of, max_batch: max_batch, slots: slots, max_scopes: if max_scopes < 1 { 1 } else { max_scopes }, tick: Atomic[Int].new(0), auth: auth, allow: allow, redact: redact, signin_url: signin_url, keep: if keep < 0 { 0 } else { keep }, title: title, css: css, client: client, client_gz: if client.is_empty() { b"" } else { compress.gzip(client, compress.Level.BestCompression) }, client_tag: if client.is_empty() { "" } else { "\"" + crypto.sha256(client).to_hex()[..32] + "\"" }, subs: subs, next_sub: Atomic[Int].new(0)}
}

// A live connection: its principal, its scope and its channel.
struct Sub {
  p: Str
  key: Str
  ch: Chan[Int]
}

// The slot of scope key, made (and the least recently used scope without
// a live page dropped, past max_scopes) when this instance has none.
fn (h: Host[M, E, fx, bx]) slot(key: Str) -> Slot[M, E, fx] {
  let t = h.tick.add(1)
  if let Some(sl) = h.slots.with_read(fn(m) { m.get(key) }) {
    sl.used.set(t)
    return sl
  }
  var busy: Set[Str] = #{}
  for c in h.subs.with_read(fn(m) { m.values() }) {
    busy.add(c.key)
  }
  let app = h.app
  let st = h.store
  let mb = h.max_batch
  let cap = h.max_scopes
  h.slots.with(fn(var m) {
    if let Some(sl) = m.get(key) {
      sl.used.set(t)
      return sl
    }
    if m.len() >= cap {
      var old = ""
      var at = Int.max
      for (k, sl) in m {
        let u = sl.used.get()
        if u < at && !busy.contains(k) {
          old = k
          at = u
        }
      }
      if at != Int.max {
        m.remove(old)
      }
    }
    let sl = Slot{state: Mutex.new(ui_scope(app, st, key, mb)), latest: Atomic[Int].new(0), resync: Atomic[Int].new(0), used: Atomic[Int].new(t), queue: Mutex.new([]), writing: Atomic[Int].new(0), frames: Mutex.new({})}
    m.put(key, sl)
    sl
  })
}

// The scopes this instance holds now.
fn (h: Host[M, E]) held() -> Int {
  h.slots.with_read(fn(m) { m.len() })
}

fn (h: Host[M, E]) shown(m: M, p: Str) -> M {
  match h.redact {
    Some(f) => f(m, p)
    None => m
  }
}

// The digest of what p is shown of m, "" without redact (then every
// version is news to every viewer).
fn (h: Host[M, E]) digest(m: M, p: Str) -> Str {
  match h.redact {
    Some(f) => crypto.sha256(json.encode_str(f(m, p)).bytes()).to_hex()[..16]
    None => ""
  }
}

fn (h: Host[M, E]) subscribe(p: Str = "", scope: Str? = None) -> (Int, Chan[Int]) {
  let id = h.next_sub.add(1)
  // One slot: a client needs only to know that something changed, and
  // versions that come while its connection is busy fold into one.
  let ch = Chan[Int].new(cap: 1)
  let key = scope ?? h.key
  h.subs.with(fn(var m) { m.put(id, Sub{p: p, key: key, ch: ch}) })
  (id, ch)
}

// Whether a new version of scope key is news to a live connection of p
// that was last told of the view with digest last: Some(the new digest)
// when p's view changed (always without redact), None when it did not.
// Each connection asks in its own task, so a change costs the request
// that made it one send per connection, and the digests run outside every
// lock.
fn (h: Host[M, E]) news(p: Str, last: Str, key: Str? = None) -> Str? {
  if h.redact.is_none() {
    return Some("")
  }
  let d = h.digest(h.model(scope: key), p)
  if d == last { None } else { Some(d) }
}

fn (h: Host[M, E]) unsubscribe(id: Int) {
  h.subs.with(fn(var m) { m.remove(id) })
}

/// The number of live connections.
pub fn (h: Host[M, E]) live() -> Int {
  h.subs.with_read(fn(m) { m.len() })
}

/// Applies a Msg of the server's own (Server.apply) to a scope (the
/// Host's own by default) and wakes its live pages: how data from
/// elsewhere (a database, a queue, a timer) reaches the model.
pub fn (h: Host[M, E]) apply(msg: E, scope: Str? = None) uses sync {
  h.try_apply(msg, scope: scope).or_fault("std/ui: Host.apply: the store failed")
}

/// Host.apply, with the store's error (decision 0686).
pub fn (h: Host[M, E]) try_apply(msg: E, scope: Str? = None) -> () ! Str uses sync {
  let key = scope ?? h.key
  let sl = h.slot(key)
  let keep = h.keep
  let latest = sl.latest.get()
  let again = sl.resync.swap(0) > 0
  // the copy keeps what it caught up even when the append fails (commit
  // undoes its own change), so the closure's result is a value
  let (v, err) = sl.state.with(fn(var c) -> (Int, Str) {
    if let Err(e) = c.fresh(latest, again: again) {
      return (0, e)
    }
    match c.apply(msg) {
      Ok(_) => {}
      Err(e) => return (0, e)
    }
    if keep > 0 && c.s.log.len() >= 2 * keep {
      // best effort: the next compaction writes the snapshot again
      let _snap = c.compact(keep).is_ok()
    }
    (c.version(), "")
  })
  if err != "" {
    return Err(err)
  }
  (h.bus.publish)(key, v)
  Ok(())
}

/// The model of a scope (the Host's own by default) now.
pub fn (h: Host[M, E]) model(scope: Str? = None) -> M uses sync {
  let sl = h.slot(scope ?? h.key)
  let latest = sl.latest.get()
  let again = sl.resync.swap(0) > 0
  sl.state.with(fn(var c) {
    // a store error leaves this instance's copy, which is still a version
    let _ok = c.fresh(latest, again: again).is_ok()
    c.model()
  })
}

// The version of scope key this instance holds.
fn (h: Host[M, E]) version_of(key: Str) -> Int {
  h.slot(key).state.with_read(fn(c) { c.version() })
}

// Group commit for scope key: unless another request is writing, appends
// every queued sync as one batch, then what queued during that append,
// until the queue is empty. Waiters get their answers on their channels.
fn (h: Host[M, E, fx, bx]) write_queued(key: Str, sl: Slot[M, E, fx]) uses (bx, fx) {
  let keep = h.keep
  while sl.writing.swap(1) == 0 {
    while true {
      let ws = sl.queue.with(fn(var q) {
        let all = q
        q = []
        all
      })
      if ws.is_empty() {
        break
      }
      let latest = sl.latest.get()
      let again = sl.resync.swap(0) > 0
      let (v0, v) = sl.state.with(fn(var c) -> (Int, Int) {
        let b = c.version()
        if let Err(e) = c.fresh(latest, again: again) {
          for w in ws {
            let _sent = w.out.try_send(Err(e))
          }
          return (b, b)
        }
        match c.commit_all(ws.map(fn(w) { w.change })) {
          Ok(outs) => {
            for i in 0..ws.len() {
              let _sent = ws[i].out.try_send(Ok(outs[i]))
            }
          }
          Err(e) => {
            for w in ws {
              let _sent = w.out.try_send(Err(e))
            }
          }
        }
        if keep > 0 && c.s.log.len() >= 2 * keep {
          let _snap = c.compact(keep).is_ok()
        }
        (b, c.version())
      })
      if v != v0 {
        (h.bus.publish)(key, v)
      }
    }
    sl.writing.set(0)
    // a sync queued after the last round but before the flag dropped has
    // no writer yet: take the role again
    if sl.queue.with_read(fn(q) { q.is_empty() }) {
      break
    }
  }
}

// The scope of a page (its path and query) for principal p.
fn (h: Host[M, E]) scope_for(page: Str, p: Str) -> Str? {
  match h.scope_of {
    Some(f) => f(page, p)
    None => Some(h.key)
  }
}

/// Adds the routes to r under prefix ("" or a path like "/todo"): GET
/// prefix/ (the page), GET prefix/_xo/ui.js (the runtime), POST
/// prefix/_xo/sync (an Up as JSON, answered with a Sync) and GET
/// prefix/_xo/live (a websocket that sends the server's version as text
/// now and whenever it changes). The sync route
/// takes only `Content-Type: application/json`, which a cross-site form
/// cannot send without CORS (415 otherwise); a body that is not an Up is
/// 400. `?thin=1` leaves the log entries out of the reply, for a client
/// that shows the rendered view.
pub fn (h: Host[M, E]) mount(var r: http.Router, prefix: Str = "") {
  let app = h.app
  let title = h.title
  let css = h.css
  // The runtime and the client are served at URLs stamped with their
  // content (?v=SHA-256 prefix) and cached for good; a rebuild changes the
  // URL, so a browser never runs a stale copy, and the build (both
  // stamps) tells an open page that it should reload.
  let js_path = "${prefix}/_xo/ui.js"
  let js_v = runtime_stamp()
  let js = "${js_path}?v=${js_v}"
  let sync = "${prefix}/_xo/sync"
  let live = "${prefix}/_xo/live"
  let client = h.client
  let wasm_path = "${prefix}/_xo/app.wasm"
  let wasm_v = if client.is_empty() { "" } else { h.client_tag[1..17] }
  let wasm = if client.is_empty() { "" } else { "${wasm_path}?v=${wasm_v}" }
  let build = if wasm_v == "" { js_v } else { "${js_v}.${wasm_v}" }
  let hh = h
  let auth = h.auth
  let allow = h.allow
  let redact = h.redact
  let signin = h.signin_url
  // The principal of req: "" without auth, None when auth refuses it.
  let who = fn(req: http.Request) -> Str? uses sync {
    match auth {
      Some(f) => f(req)
      None => Some("")
    }
  }
  let shown = fn(m: M, p: Str) -> M { hh.shown(m, p) }
  let show_page = fn(req: http.Request) -> http.Response ! Never {
    let p = match who(req) {
      Some(x) => x
      None => {
        if signin.is_empty() {
          return http.text(401, "std/ui: sign in first")
        }
        return http.Response{status: 303, headers: {"Location": signin}, body: b""}
      }
    }
    // the path, not the query: a query is the page's tab state, which the
    // client may render itself, so it never changes the scope
    let at = req.url.path
    let key = hh.scope_for(at, p) ?? return http.text(404, "std/ui: no such page")
    // sync and live requests name the page, which gives them its scope
    let named = if hh.scope_of.is_some() { "?page=" + url.query_escape(at) } else { "" }
    let sl = hh.slot(key)
    let latest = sl.latest.get()
    let again = sl.resync.swap(0) > 0
    let (m0, v, err) = sl.state.with(fn(var c) -> (M, Int, Str) {
      let e = match c.fresh(latest, again: again) {
        Ok(_) => ""
        Err(x) => x
      }
      (c.model(), c.version(), e)
    })
    if err != "" {
      return http.text(503, "std/ui: ${err}")
    }
    let m = shown(m0, p)
    http.text(200, page(app, m, v, title: title, runtime_src: js, sync_url: sync + named, css: css, live_url: live + named, wasm_url: wasm, build: build, seen: hh.digest(m0, p), query: req.url.to_url().raw_query)).with_header("Content-Type", "text/html; charset=utf-8")
  }
  r.handle("GET ${prefix}/{$}", show_page)
  if h.scope_of.is_some() {
    // a page under prefix is in the scope its path gives (a room, /room/5)
    r.handle("GET ${prefix}/{rest...}", show_page)
  }
  serve_runtime(r, prefix: prefix)
  r.handle("POST ${sync}", fn(req) -> http.Response ! Never {
    let ct = (req.header("Content-Type") ?? "").to_lower()
    if !ct.starts_with("application/json") {
      return http.text(415, "std/ui: sync takes application/json")
    }
    let up = match req.json[Up[E]]() {
      Ok(u) => u
      Err(e) => return http.text(400, "std/ui: bad sync: ${e}")
    }
    if up.client == SERVER_CLIENT {
      return http.text(400, "std/ui: ${SERVER_CLIENT} is the server's own client id")
    }
    let p = who(req) ?? return http.text(401, "std/ui: sign in first")
    let checked = auth.is_some() || allow.is_some()
    let ok = allow ?? fn(m: M, q: Str, e: E) -> Bool { true }
    let key = hh.scope_for(req.query("page") ?? "", p) ?? return http.text(404, "std/ui: no such page")
    let sl = hh.slot(key)
    var res: Result[Down[M, E]?, Str] = Err("std/ui: a queued sync had no answer")
    if up.msgs.is_empty() {
      // answered from this copy, which the bus keeps current, without the
      // store
      let latest = sl.latest.get()
      let again = sl.resync.swap(0) > 0
      res = sl.state.with(fn(var c) -> Result[Down[M, E]?, Str] {
        if let Err(e) = c.fresh(latest, again: again) {
          return Err(e)
        }
        Ok(if checked { c.s.receive_as(up, p, ok) } else { Some(c.s.receive(up)) })
      })
    } else {
      // group commit: the sync waits in the scope's queue, and the request
      // that finds no writer appends everything queued, round after round
      let mine = Chan[Result[Down[M, E]?, Str]].new(cap: 1)
      let run = fn(var s: Server[M, E]) -> Down[M, E]? {
        if checked { s.receive_as(up, p, ok) } else { Some(s.receive(up)) }
      }
      sl.queue.with(fn(var q) { q.push(Waiting{change: Change{principal: p, run: run}, out: mine}) })
      hh.write_queued(key, sl)
      if let Some(r) = mine.recv() {
        res = r
      }
    }
    // the writer published each version it appended
    let (m0, v) = sl.state.with_read(fn(c) { (c.model(), c.version()) })
    let dd = match res {
      Ok(x) => x
      Err(e) => return http.text(503, "std/ui: ${e}")
    }
    let d = dd ?? return http.text(403, "std/ui: this client belongs to another principal")
    let m = shown(m0, p)
    // with redact a log entry may hold what this principal must not see
    let down = if req.query("thin") == Some("1") || redact.is_some() { Down{acked: d.acked, reset: None, entries: [], refused: d.refused} } else { d }
    let with_model = if req.query("model") == Some("1") { Some(m) } else { None }
    let seen = hh.digest(m0, p)
    if up.msgs.is_empty() && (up.ver == v || (seen != "" && up.seen == seen)) {
      return http.json(200, Sync{down: down, ver: v, html: "", model: None, same: true, build: build, seen: seen})
    }
    http.json(200, Sync{down: down, ver: v, html: render(app.show(m, up.query)), model: with_model, build: build, seen: seen})
  })
  if !client.is_empty() {
    let gz = h.client_gz
    let tag = h.client_tag
    r.handle("GET ${wasm_path}", fn(req) -> http.Response ! Never {
      let cc = cache_control(req, wasm_v)
      if req.header("If-None-Match") == Some(tag) {
        return http.Response{status: 304, headers: {"ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: b""}
      }
      if accepts_gzip(req.header("Accept-Encoding") ?? "") {
        return http.Response{status: 200, headers: {"Content-Type": "application/wasm", "Content-Encoding": "gzip", "ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: gz}
      }
      http.Response{status: 200, headers: {"Content-Type": "application/wasm", "ETag": tag, "Cache-Control": cc, "Vary": "Accept-Encoding"}, body: client}
    })
  }
  r.handle("GET ${live}", fn(req) {
    let p = who(req) ?? return http.text(401, "std/ui: sign in first")
    let key = hh.scope_for(req.query("page") ?? "", p) ?? return http.text(404, "std/ui: no such page")
    // a thin page asks for the view itself (push=1, with its query q),
    // others for the version, then sync
    let push: Str? = if req.query("push") == Some("1") { Some(req.query("q") ?? "") } else { None }
    websocket.upgrade(req, fn(conn) { serve_live(hh, conn, p, key, push: push, build: build) })
  })
}

// The live frame of scope key for principal p and query q: its view at
// the version this instance holds, rendered and encoded once per version
// and view, the same text for every page showing it (decision 0689).
fn (h: Host[M, E]) frame(key: Str, p: Str, q: Str, build: Str) -> Str {
  let sl = h.slot(key)
  let latest = sl.latest.get()
  let again = sl.resync.swap(0) > 0
  // shared while the scope holds latest: a version wakes every page
  // showing the scope at once, and as writers they took the lock one
  // wake after another (#162)
  let held: (M, Int)? = if again { None } else {
    sl.state.with_read(fn(c) -> (M, Int)? {
      if c.loaded && latest <= c.version() { Some((c.model(), c.version())) } else { None }
    })
  }
  let (m0, v) = held ?? sl.state.with(fn(var c) {
    let _ok = c.fresh(latest, again: again).is_ok()
    (c.model(), c.version())
  })
  let seen = h.digest(m0, p)
  let vk = "${q}\n${seen}"
  let app = h.app
  // a frame already rendered for this version, under a share
  let ready: Str? = sl.frames.with_read(fn(fs) -> Str? {
    if let Some(f) = fs.get(vk) {
      if f.ver == v {
        return Some(f.text)
      }
    }
    None
  })
  if let Some(t) = ready {
    return t
  }
  // under the scope's lock: a version's frame is rendered once while its
  // other pages wait for it
  // xo:allow XO0804 ready is only a hint: this with looks the frame up again
  sl.frames.with(fn(var fs) -> Str {
    if let Some(f) = fs.get(vk) {
      if f.ver == v {
        return f.text
      }
    }
    let text = json.encode_str(Push{ver: v, html: render(app.show(h.shown(m0, p), q)), seen: seen, build: build, q: q})
    if fs.len() >= 256 {
      fs = {}
    }
    fs.put(vk, Frame{ver: v, text: text})
    text
  })
}

// A live connection: the server's version now, then each new version; the
// client syncs when it sees one past its own. With push (the page's
// query), each new version comes as its view (a Push), so the page need
// not sync (decision 0689). Reads only to notice the close.
fn serve_live[M: Json, E: Json](h: Host[M, E], conn: websocket.WsConn, p: Str, key: Str, push: Str? = None, build: Str = "") {
  let (id, ch) = h.subscribe(p, scope: Some(key))
  defer h.unsubscribe(id)
  // the digest after subscribing: a change in between is seen again and
  // skipped if this view already holds it (the page syncs on open)
  let first = h.digest(h.model(scope: Some(key)), p)
  let now = h.version_of(key)
  if conn.write_text("${now}") is Err(_) {
    return
  }
  scope s {
    s.spawn_background(fn() {
      var last = first
      for v in ch {
        // with redact, only a change to what p is shown
        if let Some(d) = h.news(p, last, key: Some(key)) {
          last = d
          // after a resync (-1) the version is this instance's once it has
          // read the store (model() does), which the runtime syncs to
          let msg = if let Some(q) = push {
            h.frame(key, p, q, build)
          } else if v < 0 {
            let _read = h.model(scope: Some(key))
            "${h.version_of(key)}"
          } else {
            "${v}"
          }
          if conn.write_text(msg) is Err(_) {
            break
          }
        }
      }
    })
    s.spawn_background(fn() {
      let _ = task.stopping().recv()
      conn.close(code: 1001, reason: "server stopping").ignore_err("stopping")
    })
    while true {
      if conn.read() is Err(_) {
        break
      }
    }
  }
}

/// The browser runtime (served at prefix/_xo/ui.js). Thin until decision
/// 0659 stage 3: it sends the Msgs of `on` events (click, submit, change;
/// `field` placeholders filled from the form or the element), keeps
/// unacknowledged Msgs in localStorage, syncs after each event, when the
/// live websocket announces a newer version, every 2 s while the page is
/// visible and the websocket is down (every 30 s while it is up), when it
/// becomes visible and when the browser comes back online,
/// and replaces the view with the server's when it changed. The html
/// element carries data-xo-pending while Msgs wait and data-xo-offline
/// after a failed sync, for the app's CSS.
const RUNTIME_JS = r#"""(function(){
"use strict";
// morph-begin
// The new view is patched into the live one instead of replacing it: a
// node that matches (same tag, and same data-key or id when it has one)
// is kept and updated, so what the view does not describe survives: focus,
// the text of the input being typed in, scroll positions, an open
// <details>, a selection.
function xoKey(n){return n.nodeType===1?(n.getAttribute("data-key")||n.id||null):null;}
function xoSame(x,y){return x.nodeType===y.nodeType&&(x.nodeType!==1||(x.tagName===y.tagName&&xoKey(x)===xoKey(y)));}
function xoPatch(x,y,focus){
  if(x.nodeType!==1){if(x.nodeValue!==y.nodeValue)x.nodeValue=y.nodeValue;return;}
  var i,at=y.attributes;
  for(i=0;i<at.length;i++){if(x.getAttribute(at[i].name)!==at[i].value)x.setAttribute(at[i].name,at[i].value);}
  var old=[];for(i=0;i<x.attributes.length;i++)old.push(x.attributes[i].name);
  for(i=0;i<old.length;i++){if(!y.hasAttribute(old[i])&&!(x.tagName==="DETAILS"&&old[i]==="open"))x.removeAttribute(old[i]);}
  var t=x.tagName;
  if(t==="INPUT"||t==="TEXTAREA"||t==="SELECT"){
    if(x!==focus){
      if(t==="TEXTAREA"){if(x.value!==y.textContent)x.value=y.textContent;}
      else if(t==="INPUT"&&(x.type==="checkbox"||x.type==="radio"))x.checked=y.hasAttribute("checked");
      else if(t==="INPUT"){var v=y.getAttribute("value")||"";if(x.value!==v)x.value=v;}
    }
    if(t==="TEXTAREA")return;
  }
  xoMorph(x,y,focus);
}
function xoMorph(cur,next,focus){
  var a=cur.firstChild,b=next.firstChild;
  while(b){
    var nb=b.nextSibling,k=xoKey(b),m=a;
    if(k!==null){m=null;for(var x=a;x;x=x.nextSibling){if(xoKey(x)===k){m=x;break;}}if(m&&m!==a)cur.insertBefore(m,a);}
    if(m&&xoSame(m,b)){xoPatch(m,b,focus);a=m.nextSibling;}
    else cur.insertBefore(b,a);
    b=nb;
  }
  while(a){var na=a.nextSibling;cur.removeChild(a);a=na;}
}
// morph-end
var drainers={},mods={};
function boot(){
  var root=document.getElementById("xo-ui");
  var stEl=document.getElementById("xo-state");
  if(!root||!stEl)return null;
  var url=root.getAttribute("data-xo-sync")||"/_xo/sync";
  var live=root.getAttribute("data-xo-live");
  var ws=null,wsUp=false,backoff=1000,tick=0;
  var st=JSON.parse(stEl.textContent);
  var wasmUrl=root.getAttribute("data-xo-wasm");
  var build=root.getAttribute("data-xo-build")||"",stale=false;
  function editing(){var a=document.activeElement;return !!(a&&root.contains(a)&&(a.tagName==="INPUT"||a.tagName==="TEXTAREA")&&a.value!=="");}
  var mod=null,confirmed=st.model;
  var KEY="xo-ui:"+location.pathname+":"+url;
  if(drainers[KEY])drainers[KEY]();
  // stopped: navigated away (no view, listeners or socket; the queue still
  // drains); dead: replaced by a new instance for the same page
  var stopped=false,dead=false,offs=[],iv=0;
  function on(t,n,f,c){t.addEventListener(n,f,c);offs.push(function(){t.removeEventListener(n,f,c);});}
  var NOATTR={setAttribute:function(){},removeAttribute:function(){}};
  function H(){return stopped?NOATTR:document.documentElement;}
  var MARK="";
  // Each tab is its own client: its id lives in sessionStorage (a reload
  // keeps it), its queue in localStorage under KEY|id. A new tab adopts the
  // queue a closed tab left (marked free on pagehide, or not seen for 10
  // minutes), so offline work survives closing the tab. Two tabs never
  // share an id: the server keeps one seq per client.
  function ls(k){try{return JSON.parse(localStorage.getItem(k));}catch(e){return null;}}
  var client=null;
  try{client=sessionStorage.getItem(KEY);}catch(e){}
  if(!client){
    try{for(var i=0;i<localStorage.length;i++){var k=localStorage.key(i);if(k&&k.indexOf(KEY+"|")===0){var e=ls(k);if(e&&e.client&&(e.free||Date.now()-(e.seen||0)>600000)){client=e.client;e.free=false;e.seen=Date.now();localStorage.setItem(k,JSON.stringify(e));break;}}}}catch(e){}
  }
  if(!client)client="c"+Math.random().toString(36).slice(2)+Date.now().toString(36);
  try{sessionStorage.setItem(KEY,client);}catch(e){}
  var saved=ls(KEY+"|"+client);
  var next=(saved&&saved.next)||1;
  var queue=(saved&&saved.queue)||[];
  var acked=(saved&&saved.acked)||0;
  // the digest of the page shown (Sync.seen): a Host with redact answers
  // `same` while this viewer's page did not change
  var dg=root.getAttribute("data-xo-seen")||"";
  var ver=st.ver;
  var last=root.innerHTML;
  var busy=false,again=false;
  function save(free){try{localStorage.setItem(KEY+"|"+client,JSON.stringify({client:client,next:next,queue:queue,acked:acked,seen:Date.now(),free:!!free}));}catch(e){}}
  function mark(){var h=H();if(queue.length)h.setAttribute("data-xo-pending","");else h.removeAttribute("data-xo-pending");}
  function fill(v,get){
    if(typeof v==="string"&&v.charAt(0)===MARK){var x=get(v.slice(1));return x==null?"":String(x);}
    if(Array.isArray(v))return v.map(function(e){return fill(e,get);});
    if(v&&typeof v==="object"){var o={};for(var k in v)if(Object.prototype.hasOwnProperty.call(v,k))o[k]=fill(v[k],get);return o;}
    return v;
  }
  function run(input){
    var enc=new TextEncoder(),inb=enc.encode(input),pos=0,out=[],mem;
    var dv=function(){return new DataView(mem.buffer);},u8=function(){return new Uint8Array(mem.buffer);};
    function Exit(c){this.code=c;}
    var w={
      fd_read:function(fd,iovs,n,nr){if(fd!==0)return 8;var t=0,v=dv();for(var i=0;i<n;i++){var p=v.getUint32(iovs+i*8,true),l=v.getUint32(iovs+i*8+4,true),k=Math.min(l,inb.length-pos);u8().set(inb.subarray(pos,pos+k),p);pos+=k;t+=k;if(k<l)break;}v.setUint32(nr,t,true);return 0;},
      fd_write:function(fd,iovs,n,nw){var t=0,v=dv();for(var i=0;i<n;i++){var p=v.getUint32(iovs+i*8,true),l=v.getUint32(iovs+i*8+4,true);if(fd===1)out.push(u8().slice(p,p+l));t+=l;}v.setUint32(nw,t,true);return 0;},
      proc_exit:function(c){throw new Exit(c);},
      args_sizes_get:function(a,b){dv().setUint32(a,0,true);dv().setUint32(b,0,true);return 0;},
      args_get:function(){return 0;},
      environ_sizes_get:function(a,b){dv().setUint32(a,0,true);dv().setUint32(b,0,true);return 0;},
      environ_get:function(){return 0;},
      clock_time_get:function(id,pr,p){dv().setBigUint64(p,BigInt(Math.round(performance.now()*1e6)),true);return 0;},
      random_get:function(p,l){crypto.getRandomValues(u8().subarray(p,p+l));return 0;}
    };
    var imp={wasi_snapshot_preview1:new Proxy(w,{get:function(o,k){return o[k]||function(){return 52;};}})};
    var inst=new WebAssembly.Instance(mod,imp);mem=inst.exports.memory;var code=0;
    try{inst.exports._start();}catch(e){if(e instanceof Exit)code=e.code;else throw e;}
    if(code!==0)throw new Error("xo-ui client exit "+code);
    var len=0;out.forEach(function(b){len+=b.length;});var all=new Uint8Array(len),o=0;out.forEach(function(b){all.set(b,o);o+=b.length;});
    return new TextDecoder().decode(all);
  }
  // a replace between pointerdown and pointerup removes the element under
