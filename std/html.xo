// std/html (spec/std.md 39, decision 0408). Encoding
// rules are listed at the top of std/prelude.xo. Go's html package: the
// five HTML special characters escaped, and entities (named, including
// the legacy ones without a semicolon, decimal and hexadecimal numeric)
// unescaped. Pure.
//
// std/html on the native backends (decision 0408): Go's html package,
// ported from escape.go of go1.26.1 (EscapeString's replacer,
// UnescapeString's unescapeEntity with the entity tables of entity.go,
// generated at the end of this file). The same results on every input.

use std/htmlent as ent

/// html.EscapeString: `<`, `>`, `&`, `'` and `"` as `&lt;`, `&gt;`,
/// `&amp;`, `&#39;` and `&#34;`.
/// On the native backends the fast path of std/native/html_native.xo (a
/// word at a time over the address: 1.674 times this as prelude
/// BytesBuilder writes, host 1 2026-11-10, decision 0597 part 2); on the
/// Go backend Go's html.EscapeString (std/rt/html.go).
pub fn escape_string(s: Str) -> Str

/// html.UnescapeString: every entity reference unescaped (named, the
/// legacy names without a semicolon such as `&amp` and `&copy`, decimal
/// `&#916;` and hexadecimal `&#x3bb;` numeric references, the C1 control
/// code points replaced as browsers do, invalid ones as U+FFFD);
/// `unescape_string(escape_string(s)) == s` always, the converse not.
pub fn unescape_string(s: Str) -> Str {
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n && b[i] != 38 {
    i += 1
  }
  if i == n {
    return s
  }
  // the result is never longer than the input (Go unescapes in place)
  var out = BytesBuilder.with_capacity(n)
  out.write(b[0..i])
  while i < n {
    // the run up to the next `&` as it is (Go's UnescapeString copies
    // between entities too), by index: a find call and a slice per run
    // cost more than the runs are long
    var run_end = i
    while run_end < n && b[run_end] != 38 {
      run_end += 1
    }
    if run_end > i {
      out.write(b[i..run_end])
      i = run_end
    }
    if i >= n {
      break
    }
    // the five references EscapeString writes, and &quot;, by their
    // bytes: what the tables give, without the name's Str and the
    // binary search (the search's compares were 30% of the profile and
    // the names' drops 8%, 2026-10-29)
    let rest = n - i
    if rest >= 4 && b[i + 1] == 108 && b[i + 2] == 116 && b[i + 3] == 59 {
      out.write_byte(60)
      i += 4
      continue
    }
    if rest >= 4 && b[i + 1] == 103 && b[i + 2] == 116 && b[i + 3] == 59 {
      out.write_byte(62)
      i += 4
      continue
    }
    if rest >= 5 && b[i + 1] == 97 && b[i + 2] == 109 && b[i + 3] == 112 && b[i + 4] == 59 {
      out.write_byte(38)
      i += 5
      continue
    }
    if rest >= 5 && b[i + 1] == 35 && b[i + 2] == 51 && b[i + 3] == 52 && b[i + 4] == 59 {
      out.write_byte(34)
      i += 5
      continue
    }
    if rest >= 5 && b[i + 1] == 35 && b[i + 2] == 51 && b[i + 3] == 57 && b[i + 4] == 59 {
      out.write_byte(39)
      i += 5
      continue
    }
    if rest >= 6 && b[i + 1] == 113 && b[i + 2] == 117 && b[i + 3] == 111 && b[i + 4] == 116 && b[i + 5] == 59 {
      out.write_byte(34)
      i += 6
      continue
    }
    let c = b[i]
    // unescapeEntity at i
    if n - i <= 1 {
      out.write_byte(c)
      i += 1
      continue
    }
    var j = i + 1
    if b[j] == 35 {
      // a numeric reference: at least "&#."
      if n - i <= 3 {
        out.write_byte(c)
        i += 1
        continue
      }
      j += 1
      var hex = false
      if b[j] == 120 || b[j] == 88 {
        hex = true
        j += 1
      }
      var x = 0
      var digits = false
      while j < n {
        let d = b[j]
        j += 1
        if hex {
          if d >= 48 && d <= 57 {
            x = 16 * x + (Int(d) - 48)
            digits = true
            continue
          } else if d >= 97 && d <= 102 {
            x = 16 * x + (Int(d) - 97) + 10
            digits = true
            continue
          } else if d >= 65 && d <= 70 {
            x = 16 * x + (Int(d) - 65) + 10
            digits = true
            continue
          }
        } else if d >= 48 && d <= 57 {
          x = 10 * x + (Int(d) - 48)
          digits = true
          continue
        }
        if d != 59 {
          j -= 1
        }
        break
      }
      if !digits {
        out.write_byte(c)
        i += 1
        continue
      }
      var r = x
      if r >= 0x80 && r <= 0x9F {
        out.write(ent.REPLACEMENT[r - 0x80].bytes())
      } else {
        if r == 0 || (r >= 0xD800 && r <= 0xDFFF) || r > 0x10FFFF {
          r = 0xFFFD
        }
        out.write_rune(Rune.try(r) ?? Rune.try(0xFFFD).or_fault("rune"))
      }
      i = j
      continue
    }
    // a named reference: the letters and digits after the &
    while j < n {
      let d = b[j]
      if (d >= 97 && d <= 122) || (d >= 65 && d <= 90) || (d >= 48 && d <= 57) {
        j += 1
        continue
      }
      break
    }
    var name_end = j
    if j < n && b[j] == 59 {
      name_end = j + 1
    }
    let name = b[i + 1..name_end].to_str() ?? ""
    if name.is_empty() {
      out.write_byte(c)
      i += 1
      continue
    }
    let one = ent.entity_of(name)
    if !one.is_empty() {
      out.write(one.bytes())
      i = name_end
      continue
    }
    let two = ent.entity2_of(name)
    if !two.is_empty() {
      out.write(two.bytes())
      i = name_end
      continue
    }
    // a legacy name without its semicolon as a prefix: the longest
    // match, at least two characters
    var max_len = name.len() - 1
    if max_len > ent.LONGEST_ENTITY_WITHOUT_SEMICOLON {
      max_len = ent.LONGEST_ENTITY_WITHOUT_SEMICOLON
    }
    var k = max_len
    var matched = false
    while k > 1 {
      let pre = ent.entity_of(name[0..k])
      if !pre.is_empty() {
        out.write(pre.bytes())
        i = i + 1 + k
        matched = true
        break
      }
      k -= 1
    }
    if matched {
      continue
    }
    out.write(b[i..name_end])
    i = name_end
  }
  out.freeze().to_str() ?? s
}
