/// Whether rune r (from U+C0) may change under NFC (NFKC when compat) or
/// combines with the rune before it; any other rune is its own normalization.
fn unstable(r: Int, compat: Bool) -> Bool {
  if r < 0xC0 {
    return compat
  }
  let t = if compat { NFKC_UNSTABLE } else { NFC_UNSTABLE }
  var lo = 0
  var hi = t.len() / 4 - 1
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if rd3(t, mid * 4) <= r {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  let st = rd3(t, lo * 4)
  st <= r && r <= st + Int(t[lo * 4 + 3])
}

fn rd2(t: Bytes, p: Int) -> Int { Int(t[p]) | (Int(t[p + 1]) << 8) }

fn rd3(t: Bytes, p: Int) -> Int { Int(t[p]) | (Int(t[p + 1]) << 8) | (Int(t[p + 2]) << 16) }

/// The index of the record whose first 3 bytes are k in the ascending records of t, or -1.
fn find_rec(t: Bytes, size: Int, k: Int) -> Int {
  var lo = 0
  var hi = t.len() / size - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = rd3(t, mid * size)
    if v == k {
      return mid
    }
    if v < k {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

/// The canonical combining class of r.
fn ccc(r: Int) -> Int {
  if r < 0x300 {
    return 0
  }
  var lo = 0
  var hi = CCC.len() / 7 - 1
  while lo <= hi {
    let mid = (lo + hi) / 2
    let q = mid * 7
    if r < rd3(CCC, q) {
      hi = mid - 1
    } else if r > rd3(CCC, q + 3) {
      lo = mid + 1
    } else {
      return Int(CCC[q + 6])
    }
  }
  0
}

/// Appends the decomposition of r from recs (7 byte records of a rune or a run
/// of runes, see scripts/gennorm), or returns false when it has none.
fn push_decomp(var out: List[Int], recs: Bytes, pool: Bytes, idx: Bytes, r: Int) -> Bool {
  var lo = 0
  var hi = recs.len() / 7 - 1
  if r < 0x3000 {
    lo = rd2(idx, (r >> 6) * 2)
    hi = rd2(idx, (r >> 6) * 2 + 2)
  } else {
    lo = rd2(idx, 0x3000 / 64 * 2)
  }
  while lo < hi {
    let mid = (lo + hi + 1) / 2
    if rd3(recs, mid * 7) <= r {
      lo = mid
    } else {
      hi = mid - 1
    }
  }
  let q = lo * 7
  let start = rd3(recs, q)
  if start > r {
    return false
  }
  let fc = Int(recs[q + 3])
  let data = rd3(recs, q + 4)
  if fc >= 0x80 {
    if r > start + (fc & 0x7f) {
      return false
    }
    let d = if data & 1 == 1 { 0 - (data + 1) / 2 } else { data / 2 }
    out.push(r + d)
    return true
  }
  if r != start {
    return false
  }
  var p = data
  for _ in 0..fc {
    var v = 0
    var sh = 0
    while true {
      let c = Int(pool[p])
      p += 1
      v = v | ((c & 0x7f) << sh)
      if c < 0x80 {
        break
      }
      sh += 7
    }
    out.push(v)
  }
  true
}

/// Appends the (full) decomposition of r to out: NFD, or NFKD when compat.
fn decompose_rune(var out: List[Int], r: Int, compat: Bool) {
  if r < 0xA0 || (!compat && r < 0xC0) {
    out.push(r)
    return
  }
  if r >= S_BASE && r < S_BASE + S_COUNT {
    let si = r - S_BASE
    out.push(L_BASE + si / N_COUNT)
    out.push(V_BASE + (si % N_COUNT) / T_COUNT)
    let t = si % T_COUNT
    if t != 0 {
      out.push(T_BASE + t)
    }
    return
  }
  if compat {
    if push_decomp(out, COMPAT, COMPAT_POOL, COMPAT_IDX, r) {
      return
    }
  }
  if !push_decomp(out, CANON, CANON_POOL, CANON_IDX, r) {
    out.push(r)
  }
}

/// Puts the runs of non starters in canonical order (stable by class); cs
/// holds the class of each rune of rs and moves with it.
fn reorder(var rs: List[Int], var cs: List[Int]) {
  var i = 0
  let n = rs.len()
  while i < n {
    if cs[i] == 0 {
      i += 1
      continue
    }
    var j = i + 1
    while j < n && cs[j] != 0 {
      j += 1
    }
    var a = i + 1
    while a < j {
      let x = rs[a]
      let cx = cs[a]
      var b = a
      while b > i && cs[b - 1] > cx {
        rs[b] = rs[b - 1]
        cs[b] = cs[b - 1]
        b -= 1
      }
      rs[b] = x
      cs[b] = cx
      a += 1
    }
    i = j
  }
}

/// The primary composite of the pair, or -1.
fn compose_pair(a: Int, b: Int) -> Int {
  if a >= L_BASE && a < L_BASE + L_COUNT && b >= V_BASE && b < V_BASE + V_COUNT {
    return S_BASE + ((a - L_BASE) * V_COUNT + (b - V_BASE)) * T_COUNT
  }
  if a >= S_BASE && a < S_BASE + S_COUNT && (a - S_BASE) % T_COUNT == 0 && b > T_BASE && b < T_BASE + T_COUNT {
    return a + (b - T_BASE)
  }
  let key = a * 2097152 + b
  var lo = 0
  var hi = COMP.len() / 9 - 1
  if a < 0x400 {
    lo = rd2(COMP_IDX, a * 2)
    hi = rd2(COMP_IDX, a * 2 + 2) - 1
  } else {
    lo = rd2(COMP_IDX, 0x400 * 2)
  }
  while lo <= hi {
    let mid = (lo + hi) / 2
    let q = mid * 9
    let v = rd3(COMP, q) | (rd3(COMP, q + 3) << 24)
    if v == key {
      return rd3(COMP, q + 6)
    }
    if v < key {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  -1
}

fn compose(rs: List[Int], cs: List[Int]) -> List[Int] {
  var out: List[Int] = List.with_capacity(rs.len())
  var starter = -1
  var last = -1
  var i = 0
  while i < rs.len() {
    let r = rs[i]
    let c = cs[i]
    i += 1
    if r < 0x300 {
      // a starter that no pair has as its second rune
      starter = out.len()
      last = -1
      out.push(r)
      continue
    }
    if starter >= 0 && (last == -1 || last < c) {
      let p = compose_pair(out[starter], r)
      if p >= 0 {
        out[starter] = p
        continue
      }
    }
    if c == 0 {
      starter = out.len()
      last = -1
    } else {
      last = c
    }
    out.push(r)
  }
  out
}

fn is_ascii(s: Str) -> Bool {
  for c in s.bytes() {
    if c >= 0x80 {
      return false
    }
  }
  true
}

/// The normalization of one run of text that starts at a starter.
fn normalize_run(s: Str, compat: Bool, composing: Bool) -> List[Int] {
  var rs: List[Int] = []
  let b = s.bytes()
  let n = b.len()
  var i = 0
  while i < n {
    let c = Int(b[i])
    var r = c
    if c >= 0xF0 {
      r = ((c & 7) << 18) | ((Int(b[i + 1]) & 63) << 12) | ((Int(b[i + 2]) & 63) << 6) | (Int(b[i + 3]) & 63)
      i += 4
    } else if c >= 0xE0 {
      r = ((c & 15) << 12) | ((Int(b[i + 1]) & 63) << 6) | (Int(b[i + 2]) & 63)
      i += 3
    } else if c >= 0xC0 {
      r = ((c & 31) << 6) | (Int(b[i + 1]) & 63)
      i += 2
    } else {
      i += 1
    }
    decompose_rune(rs, r, compat)
  }
  var cs: List[Int] = List.with_capacity(rs.len())
  for r in rs {
    cs.push(ccc(r))
  }
  reorder(rs, cs)
  if composing {
    return compose(rs, cs)
  }
  rs
}
