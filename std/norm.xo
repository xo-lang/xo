      w = 3
      ri = ((c & 15) << 12) | ((Int(bs[at + 1]) & 63) << 6) | (Int(bs[at + 2]) & 63)
    } else if c >= 0xC0 {
      w = 2
      ri = ((c & 31) << 6) | (Int(bs[at + 1]) & 63)
    }
    if ri >= lim && (!composing || unstable(ri, compat)) {
