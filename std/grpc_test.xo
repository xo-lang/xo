// Vectors from grpc-go (rpc_util.go, http_util.go encodeTimeout and encodeGrpcMessage, codes).
use std/http
use std/testing
test "frame and unframe" {
  let f = frame(b"abc")
  expect(f) == b"\x00\x00\x00\x00\x03abc"
  let (c, p, n) = unframe(f, 0).or_fault("u")
  expect((c, p, n)) == (false, b"abc", 8)
  expect(frame(b"", true)) == b"\x01\x00\x00\x00\x00"
  expect(unframe(b"\x02\x00\x00\x00\x00", 0)) == Err(FrameErr.BadFlag(flag: 2))
  expect(unframe(b"\x00\x00\x00", 0)) == Err(FrameErr.Truncated)
  expect(unframe(b"\x00\x00\x00\x00\x05ab", 0)) == Err(FrameErr.Truncated)
  expect(unframe(b"\x00\x00\x00\x40\x01", 0, 16384)) == Err(FrameErr.TooLarge(len: 16385))
}

test "timeouts" {
  expect(encode_timeout(0)) == "0n"
  expect(encode_timeout(-5)) == "0n"
  expect(encode_timeout(1)) == "1n"
  expect(encode_timeout(99999999)) == "99999999n"
  expect(encode_timeout(100000000)) == "100000u"
  expect(encode_timeout(1000000000)) == "1000000u"
  expect(encode_timeout(60000000000)) == "60000000u"
  expect(encode_timeout(7200000000000)) == "7200000m"
  expect(decode_timeout("1000m")) == Some(1000000000)
  expect(decode_timeout("5S")) == Some(5000000000)
  expect(decode_timeout("2H")) == Some(7200000000000)
  expect(decode_timeout("S")) == None
  expect(decode_timeout("123456789S")) == None
  expect(decode_timeout("5x")) == None
  expect(decode_timeout("")) == None
}

test "codes" {
  expect(Code.Unauthenticated.number()) == 16
  expect(code_from(4)) == Some(Code.DeadlineExceeded)
  expect(code_from(17)) == None
}

test "grpc-message encoding" {
  expect(encode_message("hello world")) == "hello world"
  expect(encode_message("100%")) == "100%25"
  expect(encode_message("a\nb")) == "a%0Ab"
  expect(encode_message("é")) == "%C3%A9"
  expect(decode_message("a%0Ab")) == "a\nb"
  expect(decode_message("%C3%A9")) == "é"
  expect(decode_message("%zz")) == "%zz"
  expect(decode_message("100%")) == "100%"
}

fn lcg(x: Int) -> Int {
  (x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)) & 0x7fffffffffffffff
}

test "random bytes never fault the frame, timeout and message readers" {
  var x = 12345
  for _ in 0..3000 {
    x = lcg(x)
    let n = (x >> 33) % 24
    var b = BytesBuilder.with_capacity(n)
    for _ in 0..n {
      x = lcg(x)
      b.write_byte(UInt8.wrapping_from((x >> 40) & 255))
    }
    let data = b.freeze()
    // a frame read of any bytes is Ok or an error, and an Ok frame reframes to the bytes it came from
    match unframe(data, 0) {
      Ok((compressed, msg, next)) => {
        expect(frame(msg, compressed)) == data[0..next]
      }
      Err(_) => {}
    }
    let s = data.to_str_lossy()
    let back = decode_message_bytes(s)
    expect(back.len() <= s.len()) == true
    match decode_timeout(s) {
      Some(ns) => expect(ns >= 0) == true
      None => {}
    }
  }
}

test "frame round trips every length class and the receive limit" {
  for n in [0, 1, 255, 256, 65535, 65536, 100000] {
    let payload = Bytes.zeroed(n)
    let (c, m, next) = unframe(frame(payload), 0).or_fault("unframe")
    expect(c) == false
    expect(m.len()) == n
    expect(next) == n + 5
  }
  match unframe(frame(Bytes.zeroed(10)), 0, 9) {
    Ok(_) => fault("want TooLarge")
    Err(e) => expect(e) == FrameErr.TooLarge(len: 10)
  }
}

test "binary metadata is unpadded base64 and reads padded or not" {
  expect(bin_encode(b"")) == ""
  expect(bin_encode(b"f")) == "Zg"
  expect(bin_encode(b"fo")) == "Zm8"
  expect(bin_encode(b"foo")) == "Zm9v"
  expect(bin_decode("Zg")) == Some(b"f")
  expect(bin_decode("Zg==")) == Some(b"f")
  expect(bin_decode("Zm8=")) == Some(b"fo")
  expect(bin_decode("Zm9v")) == Some(b"foo")
  expect(bin_decode("!!")) == None
  expect(bin_decode("Z")) == None
  for n in 0..40 {
    var b = BytesBuilder.new()
    for i in 0..n {
      b.write_byte(UInt8(i * 37 % 256))
    }
    let data = b.freeze()
    expect(bin_decode(bin_encode(data))) == Some(data)
  }
}

fn canned_status(os: testing.TestOs, path: Str, status: Int, headers: List[(Str, Str)]) -> Str uses net.dial {
  os.net.handle("POST https://g.test${path}", fn(_r: http.Request) -> http.Response {
    var resp = http.text(status, "")
    for (k, v) in headers {
      resp = resp.with_header(k, v)
    }
    resp
  })
  let c = client(http.client(os.net), "https://g.test")
  let got = c.call(path, {}, None, fn(cc) -> List[Str] ! Status {
    cc.close_send()
    var out: List[Str] = []
    while let Some(m) = cc.recv()? {
      out.push(m.to_hex())
    }
    Ok(out)
  })
  match got {
    Ok(ms) => "ok ${ms}"
    Err(e) => "${e.code.number()} ${e.message}"
  }
}

test "the client answers a response's head as grpc-go does (TestGrpcFuzz, task #115)" {
  // not gRPC (its content-type): the HTTP status's code and grpc-go's text, whatever grpc-status says
  expect(canned_status(os, "/a", 200, [("Content-Type", "text/html"), ("Grpc-Status", "10")])) == "2 unexpected HTTP status code received from server: 200 (OK); transport: received unexpected content-type \"text/html\""
  expect(canned_status(os, "/b", 503, [])) == "14 unexpected HTTP status code received from server: 503 (Service Unavailable); transport: received unexpected content-type \"text/plain; charset=utf-8\""
  expect(canned_status(os, "/c", 200, [("Content-Type", "Application/GRPC"), ("Grpc-Status", "0")]).starts_with("2 unexpected HTTP status code")) == true
  // gRPC: the HTTP status is not looked at, grpc-status is
  expect(canned_status(os, "/d", 429, [("Content-Type", "application/grpc+proto"), ("Grpc-Status", "0")])) == "ok []"
  // no grpc-status: Unknown with the message; one that does not parse: Unknown with ParseInt's text
  expect(canned_status(os, "/e", 200, [("Content-Type", "application/grpc"), ("Grpc-Message", "a%20b")])) == "2 a b"
  expect(canned_status(os, "/f", 200, [("Content-Type", "application/grpc;x=y"), ("Grpc-Status", " 0")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \" 0\": invalid syntax"
  // a head's grpc-status that does not parse comes before its content-type
  expect(canned_status(os, "/h", 400, [("Content-Type", "Application/GRPC"), ("Grpc-Status", "x")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \"x\": invalid syntax"
  expect(canned_status(os, "/g", 200, [("Content-Type", "application/grpc"), ("Grpc-Status", "4294967296")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \"4294967296\": value out of range"
}

test "a frame's length is checked before its flag, as grpc-go (TestGrpcFuzz, task #115)" {
  expect(unframe(b"\x07\x7f\xff\xff\xff", 0)) == Err(FrameErr.TooLarge(len: 2147483647))
  expect(unframe(b"\x07\x00\x00\x00\x00", 0)) == Err(FrameErr.BadFlag(flag: 7))
  // a payload cut short is Truncated whatever the flag
  expect(unframe(b"\x40\x00\x00\x00\x02a", 0)) == Err(FrameErr.Truncated)
}
test "a status's details reach the client as grpc-status-details-bin" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/s.S/Fail", fn(call, _req) -> Bytes ! Status {
    let d = if call.metadata.get("x-empty") == Some("1") { b"" } else { b"\x08\x08\x12\x04slow\x1a\x00\xff" }
    Err(Status{code: Code.ResourceExhausted, message: "slow", details: d})
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() {
      hs.serve().ignore_err("the test ends the server")
    })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    match c.unary("/s.S/Fail", b"x") {
      Err(st) => expect((st.code, st.message, st.details)) == (Code.ResourceExhausted, "slow", b"\x08\x08\x12\x04slow\x1a\x00\xff")
      Ok(_) => fault("the call succeeded")
    }
    match c.unary("/s.S/Fail", b"x", {"x-empty": "1"}) {
      Err(st) => expect(st.details) == b""
      Ok(_) => fault("the call succeeded")
    }
  }
}
