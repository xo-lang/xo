// Vectors from grpc-go (rpc_util.go, http_util.go encodeTimeout and encodeGrpcMessage, codes).
use std/compress
use std/http
use std/testing
test "frame and unframe" {
  let f = frame(b"abc")
  expect(f) == b"\x00\x00\x00\x00\x03abc"
  let (c, p, n) = unframe(f, 0).or_fault("u")
  expect((c, p, n)) == (false, b"abc", 8)
  expect(frame(b"", true)) == b"\x01\x00\x00\x00\x00"
  expect(unframe(b"\x02\x00\x00\x00\x00", 0)) == Err(FrameErr.BadFlag(flag: 2))
  expect(unframe(b"\x00\x00\x00", 0)) == Err(FrameErr.Truncated)
  expect(unframe(b"\x00\x00\x00\x00\x05ab", 0)) == Err(FrameErr.Truncated)
  expect(unframe(b"\x00\x00\x00\x40\x01", 0, 16384)) == Err(FrameErr.TooLarge(len: 16385))
}

test "timeouts" {
  expect(encode_timeout(0)) == "0n"
  expect(encode_timeout(-5)) == "0n"
  expect(encode_timeout(1)) == "1n"
  expect(encode_timeout(99999999)) == "99999999n"
  expect(encode_timeout(100000000)) == "100000u"
  expect(encode_timeout(1000000000)) == "1000000u"
  expect(encode_timeout(60000000000)) == "60000000u"
  expect(encode_timeout(7200000000000)) == "7200000m"
  expect(decode_timeout("1000m")) == Some(1000000000)
  expect(decode_timeout("5S")) == Some(5000000000)
  expect(decode_timeout("2H")) == Some(7200000000000)
  expect(decode_timeout("S")) == None
  expect(decode_timeout("123456789S")) == None
  expect(decode_timeout("5x")) == None
  expect(decode_timeout("")) == None
}

test "codes" {
  expect(Code.Unauthenticated.number()) == 16
  expect(code_from(4)) == Some(Code.DeadlineExceeded)
  expect(code_from(17)) == None
}

test "grpc-message encoding" {
  expect(encode_message("hello world")) == "hello world"
  expect(encode_message("100%")) == "100%25"
  expect(encode_message("a\nb")) == "a%0Ab"
  expect(encode_message("é")) == "%C3%A9"
  expect(decode_message("a%0Ab")) == "a\nb"
  expect(decode_message("%C3%A9")) == "é"
  expect(decode_message("%zz")) == "%zz"
  expect(decode_message("100%")) == "100%"
}

fn lcg(x: Int) -> Int {
  (x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407)) & 0x7fffffffffffffff
}

test "random bytes never fault the frame, timeout and message readers" {
  var x = 12345
  for _ in 0..3000 {
    x = lcg(x)
    let n = (x >> 33) % 24
    var b = BytesBuilder.with_capacity(n)
    for _ in 0..n {
      x = lcg(x)
      b.write_byte(UInt8.wrapping_from((x >> 40) & 255))
    }
    let data = b.freeze()
    // a frame read of any bytes is Ok or an error, and an Ok frame reframes to the bytes it came from
    match unframe(data, 0) {
      Ok((compressed, msg, next)) => {
        expect(frame(msg, compressed)) == data[0..next]
      }
      Err(_) => {}
    }
    let s = data.to_str_lossy()
    let back = decode_message_bytes(s)
    expect(back.len() <= s.len()) == true
    match decode_timeout(s) {
      Some(ns) => expect(ns >= 0) == true
      None => {}
    }
  }
}

test "frame round trips every length class and the receive limit" {
  for n in [0, 1, 255, 256, 65535, 65536, 100000] {
    let payload = Bytes.zeroed(n)
    let (c, m, next) = unframe(frame(payload), 0).or_fault("unframe")
    expect(c) == false
    expect(m.len()) == n
    expect(next) == n + 5
  }
  match unframe(frame(Bytes.zeroed(10)), 0, 9) {
    Ok(_) => fault("want TooLarge")
    Err(e) => expect(e) == FrameErr.TooLarge(len: 10)
  }
}

test "binary metadata is unpadded base64 and reads padded or not" {
  expect(bin_encode(b"")) == ""
  expect(bin_encode(b"f")) == "Zg"
  expect(bin_encode(b"fo")) == "Zm8"
  expect(bin_encode(b"foo")) == "Zm9v"
  expect(bin_decode("Zg")) == Some(b"f")
  expect(bin_decode("Zg==")) == Some(b"f")
  expect(bin_decode("Zm8=")) == Some(b"fo")
  expect(bin_decode("Zm9v")) == Some(b"foo")
  expect(bin_decode("!!")) == None
  expect(bin_decode("Z")) == None
  for n in 0..40 {
    var b = BytesBuilder.new()
    for i in 0..n {
      b.write_byte(UInt8(i * 37 % 256))
    }
    let data = b.freeze()
    expect(bin_decode(bin_encode(data))) == Some(data)
  }
}

fn canned_status(os: testing.TestOs, path: Str, status: Int, headers: List[(Str, Str)]) -> Str uses net.dial {
  os.net.handle("POST https://g.test${path}", fn(_r: http.Request) -> http.Response {
    var resp = http.text(status, "")
    for (k, v) in headers {
      resp = resp.with_header(k, v)
    }
    resp
  })
  let c = client(http.client(os.net), "https://g.test")
  let got = c.call(path, {}, None, fn(cc) -> List[Str] ! Status {
    cc.close_send()
    var out: List[Str] = []
    while let Some(m) = cc.recv()? {
      out.push(m.to_hex())
    }
    Ok(out)
  })
  match got {
    Ok(ms) => "ok ${ms}"
    Err(e) => "${e.code.number()} ${e.message}"
  }
}

test "the client answers a response's head as grpc-go does (TestGrpcFuzz, task #115)" {
  // not gRPC (its content-type): the HTTP status's code and grpc-go's text, whatever grpc-status says
  expect(canned_status(os, "/a", 200, [("Content-Type", "text/html"), ("Grpc-Status", "10")])) == "2 unexpected HTTP status code received from server: 200 (OK); transport: received unexpected content-type \"text/html\""
  expect(canned_status(os, "/b", 503, [])) == "14 unexpected HTTP status code received from server: 503 (Service Unavailable); transport: received unexpected content-type \"text/plain; charset=utf-8\""
  expect(canned_status(os, "/c", 200, [("Content-Type", "Application/GRPC"), ("Grpc-Status", "0")]).starts_with("2 unexpected HTTP status code")) == true
  // gRPC: the HTTP status is not looked at, grpc-status is
  expect(canned_status(os, "/d", 429, [("Content-Type", "application/grpc+proto"), ("Grpc-Status", "0")])) == "ok []"
  // no grpc-status: Unknown with the message; one that does not parse: Unknown with ParseInt's text
  expect(canned_status(os, "/e", 200, [("Content-Type", "application/grpc"), ("Grpc-Message", "a%20b")])) == "2 a b"
  expect(canned_status(os, "/f", 200, [("Content-Type", "application/grpc;x=y"), ("Grpc-Status", " 0")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \" 0\": invalid syntax"
  // a head's grpc-status that does not parse comes before its content-type
  expect(canned_status(os, "/h", 400, [("Content-Type", "Application/GRPC"), ("Grpc-Status", "x")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \"x\": invalid syntax"
  expect(canned_status(os, "/g", 200, [("Content-Type", "application/grpc"), ("Grpc-Status", "4294967296")])) == "2 transport: malformed grpc-status: strconv.ParseInt: parsing \"4294967296\": value out of range"
}

test "a frame's length is checked before its flag, as grpc-go (TestGrpcFuzz, task #115)" {
  expect(unframe(b"\x07\x7f\xff\xff\xff", 0)) == Err(FrameErr.TooLarge(len: 2147483647))
  expect(unframe(b"\x07\x00\x00\x00\x00", 0)) == Err(FrameErr.BadFlag(flag: 7))
  // a payload cut short is Truncated whatever the flag
  expect(unframe(b"\x40\x00\x00\x00\x02a", 0)) == Err(FrameErr.Truncated)
}
test "a status's details reach the client as grpc-status-details-bin" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/s.S/Fail", fn(call, _req) -> Bytes ! Status {
    let d = if call.metadata.get("x-empty") == Some("1") { b"" } else { b"\x08\x08\x12\x04slow\x1a\x00\xff" }
    Err(Status{code: Code.ResourceExhausted, message: "slow", details: d})
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() {
      hs.serve().ignore_err("the test ends the server")
    })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    match c.unary("/s.S/Fail", b"x") {
      Err(st) => expect((st.code, st.message, st.details)) == (Code.ResourceExhausted, "slow", b"\x08\x08\x12\x04slow\x1a\x00\xff")
      Ok(_) => fault("the call succeeded")
    }
    match c.unary("/s.S/Fail", b"x", {"x-empty": "1"}) {
      Err(st) => expect(st.details) == b""
      Ok(_) => fault("the call succeeded")
    }
  }
}

test "send and receive limits and response metadata, as grpc-go" uses (net, clock) {
  var srv = server(os.clock).with_max_send(3)
  srv.unary("/s.S/Five", fn(_call, _req) -> Bytes ! Status { Ok(b"12345") })
  srv.stream("/s.S/Md", fn(_call, recv, send) -> () ! Status {
    let m = recv.next()? ?? b""
    send.set_trailer("x-t", "tv")
    send.send(m)?
    send.send(b"four")?
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() {
      hs.serve().ignore_err("the test ends the server")
    })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    // a unary response's limit text has grpc-go's "grpc: " prefix (server.go), a stream's has none (stream.go)
    expect(c.unary("/s.S/Five", b"")) == Err(status_new(Code.ResourceExhausted, "grpc: trying to send message larger than max (5 vs. 3)"))
    expect(c.with_max_send(1).unary("/s.S/Five", b"ab")) == Err(status_new(Code.ResourceExhausted, "trying to send message larger than max (2 vs. 1)"))
    let got = c.call("/s.S/Md", {}, None, fn(cc) -> (Map[Str, Str], List[Str], Map[Str, Str]) ! Status {
      cc.send(b"ab")?
      cc.close_send()
      let h = cc.header()?
      var msgs: List[Str] = []
      while true {
        match cc.recv() {
          Ok(Some(m)) => msgs.push(m.to_str() ?? "?")
          Ok(None) => break
          Err(e) => {
            msgs.push(e.display())
            break
          }
        }
      }
      Ok((h, msgs, cc.trailer()))
    }).or_fault("call")
    expect(got.0.get("content-type")) == Some("application/grpc")
    expect(got.0.get("grpc-encoding")) == None
    // grpc-go's server head has no Date (behavior.response_head)
    expect(got.0.get("date")) == None
    expect(got.1) == ["ab", "rpc error: code = ResourceExhausted desc = trying to send message larger than max (4 vs. 3)"]
    expect(got.2.get("x-t")) == Some("tv")
    expect(got.2.get("grpc-status")) == None
    expect(c.with_max_recv(1).unary("/s.S/Five", b"")) == Err(status_new(Code.ResourceExhausted, "grpc: trying to send message larger than max (5 vs. 3)"))
  }
}

test "services lists the registered methods by service, as grpc-go's GetServiceInfo" uses clock {
  var srv = server(os.clock)
  srv.unary("/b.Svc/Get", fn(_c, req) -> Bytes ! Status { Ok(req) })
  srv.stream("/b.Svc/Watch", fn(_c, _r, _s) -> () ! Status { Ok(()) }, client_stream: false)
  srv.stream("/a.Other/Upload", fn(_c, _r, _s) -> () ! Status { Ok(()) }, server_stream: false)
  srv.stream("/b.Svc/Chat", fn(_c, _r, _s) -> () ! Status { Ok(()) })
  let got = srv.services()
  expect(got.map(fn(si) -> Str { si.name })) == ["a.Other", "b.Svc"]
  expect(got[0].methods) == [MethodInfo{name: "Upload", client_stream: true, server_stream: false}]
  expect(got[1].methods) == [
    MethodInfo{name: "Get", client_stream: false, server_stream: false},
    MethodInfo{name: "Watch", client_stream: false, server_stream: true},
    MethodInfo{name: "Chat", client_stream: true, server_stream: true},
  ]
  expect(server(os.clock).services()) == []
}

test "unknown serves the methods no service registered, as grpc-go's UnknownServiceHandler" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/k.Known/Echo", fn(_c, req) -> Bytes ! Status { Ok(b"known " + req) })
  srv.unknown(fn(call, recv, send) -> () ! Status {
    while true {
      match recv.next()? {
        Some(m) => send.send("${call.method} ".bytes() + m)?
        None => break
      }
    }
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    expect(c.unary("/k.Known/Echo", b"a")) == Ok(b"known a")
    // an unknown service and an unknown method of a known one
    expect(c.unary("/x.Nope/Get", b"b")) == Ok(b"/x.Nope/Get b")
    expect(c.unary("/k.Known/Other", b"c")) == Ok(b"/k.Known/Other c")
    // a stream: each message as it comes
    let got = c.call("/x.Nope/Stream", {}, None, fn(cc) -> List[Str] ! Status {
      cc.send(b"1")?
      cc.send(b"2")?
      cc.close_send()
      var out: List[Str] = []
      while let Some(m) = cc.recv()? {
        out.push(m.to_str_lossy())
      }
      Ok(out)
    })
    expect(got) == Ok(["/x.Nope/Stream 1", "/x.Nope/Stream 2"])
    // not gRPC: a 404 as before
    let r = http.client(os.net, timeout: 10s).with_protocols(#{http.Protocol.UnencryptedHttp2}).send(http.new_request("GET", "http://${hs.addr()}/x")).or_fault("get")
    expect(r.status) == 404
  }
  // without unknown, the same call is Unimplemented
  var plain = server(os.clock)
  plain.unary("/k.Known/Echo", fn(_c, req) -> Bytes ! Status { Ok(req) })
  let l2 = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs2 = http.server(l2, plain.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs2.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs2.addr()}")
    expect(c.unary("/x.Nope/Get", b"b")) == Err(status_new(Code.Unimplemented, "unknown service x.Nope"))
  }
}

test "a stop waits for the running handlers, as grpc-go's WaitForHandlers" uses (net, clock) {
  let started = Chan[Bool].new(1)
  let release = Chan[Bool].new(1)
  var srv = server(os.clock)
  srv.unary("/w.W/Slow", fn(_c, req) -> Bytes ! Status {
    started.send(true)
    let _ = release.recv()
    Ok(b"done " + req)
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  let addr = hs.addr()
  let result = Chan[Str].new(1)
  scope outer {
    outer.spawn(fn() {
      let c = client(http.client(os.net, timeout: 10s), "http://${addr}")
      match c.unary("/w.W/Slow", b"x") {
        Ok(b) => result.send(b.to_str_lossy())
        Err(st) => result.send(st.display())
      }
    })
    outer.spawn(fn() {
      let _ = started.recv()
      // after the server's scope has ended and its stop began
      os.clock.sleep(200ms)
      release.send(true)
    })
    scope inner {
      inner.spawn_background(fn() { hs.serve().ignore_err("stopped") })
      let _ = started.recv()
      started.send(true)
    }
  }
  expect(result.recv()) == Some("done x")
}

// grpc-go's TestChainUnaryServerInterceptor and TestChainStreamServerInterceptor: registration order, the first
// outermost, unary ones inside stream ones (decision 0703)
test "server interceptors chain in order around every method, as grpc-go's ChainUnaryInterceptor" uses (net, clock) {
  let log = Mutex[List[Str]].new([])
  let note = fn(t: Str) { log.with(fn(var l: List[Str]) { l.push(t) }) }
  var srv = server(os.clock)
  srv.intercept(fn(call, recv, send, next) -> () ! Status {
    note("s1 in ${call.method} ${call.client_stream} ${call.server_stream}")
    next(call, recv, send)?
    note("s1 out")
  })
  srv.unary("/i.I/Get", fn(call, req) -> Bytes ! Status {
    note("handler ${call.metadata.get("x-user") ?? "-"}")
    Ok(b"got " + req)
  })
  srv.stream("/i.I/Chat", fn(_call, recv, send) -> () ! Status {
    note("chat")
    while let Some(m) = recv.next()? {
      send.send(m)?
    }
  })
  // registered after the methods: still around them
  srv.intercept(fn(call, recv, send, next) -> () ! Status {
    note("s2 in")
    next(call, recv, send)?
    note("s2 out")
  })
  srv.intercept_unary(fn(call, req, next) -> Bytes ! Status {
    note("u1 in")
    // metadata and the request changed on the way in
    let out = next(call with {metadata: md_with(call.metadata, "x-user", "ann")}, req + b"!")?
    note("u1 out")
    Ok(out)
  })
  srv.intercept_unary(fn(call, req, next) -> Bytes ! Status {
    note("u2 in")
    if call.metadata.get("x-deny") == Some("1") {
      return Err(status_new(Code.PermissionDenied, "denied"))
    }
    next(call, req)
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    expect(c.unary("/i.I/Get", b"a")) == Ok(b"got a!")
    expect(log.with(fn(var l: List[Str]) -> List[Str] {
      let out = l
      l = []
      out
    })) == ["s1 in /i.I/Get false false", "s2 in", "u1 in", "u2 in", "handler ann", "u1 out", "s2 out", "s1 out"]
    // a refusal ends the call with its status; the handler does not run
    expect(c.unary("/i.I/Get", b"a", {"x-deny": "1"})) == Err(status_new(Code.PermissionDenied, "denied"))
    expect(log.with(fn(var l: List[Str]) -> List[Str] {
      let out = l
      l = []
      out
    })) == ["s1 in /i.I/Get false false", "s2 in", "u1 in", "u2 in"]
    // a stream method: the stream interceptors only, with its kind
    let got = c.call("/i.I/Chat", {}, None, fn(cc) -> List[Str] ! Status {
      cc.send(b"x")?
      cc.close_send()
      var out: List[Str] = []
      while let Some(m) = cc.recv()? {
        out.push(m.to_str_lossy())
      }
      Ok(out)
    })
    expect(got) == Ok(["x"])
    expect(log.with(fn(var l: List[Str]) -> List[Str] { l })) == ["s1 in /i.I/Chat true true", "s2 in", "chat", "s2 out", "s1 out"]
  }
}

// grpc-go's TestChainUnaryClientInterceptor and the stream client interceptor's options
test "client interceptors chain around a call, as grpc-go's WithChainUnaryInterceptor" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/c.C/Who", fn(call, req) -> Bytes ! Status {
    Ok("${call.metadata.get("authorization") ?? "none"} ${call.metadata.get("x-trace") ?? "-"} ${req.to_str_lossy()}".bytes())
  })
  srv.stream("/c.C/Who2", fn(call, _recv, send) -> () ! Status {
    send.send((call.metadata.get("authorization") ?? "none").bytes())?
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  let order = Mutex[List[Str]].new([])
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let base = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    let c = base.with_unary_interceptor(fn(m, req, o, inv) -> Bytes ! Status {
      order.with(fn(var l: List[Str]) { l.push("auth") })
      inv(m, req, o with {metadata: md_with(o.metadata, "authorization", "Bearer t")})
    }).with_unary_interceptor(fn(m, req, o, inv) -> Bytes ! Status {
      order.with(fn(var l: List[Str]) { l.push("trace") })
      if m == "/c.C/Cached" {
        // answered without a call
        return Ok(b"cached")
      }
      inv(m, req + b"?", o with {metadata: md_with(o.metadata, "x-trace", "1")})
    })
    expect(c.unary("/c.C/Who", b"q")) == Ok(b"Bearer t 1 q?")
    expect(c.unary("/c.C/Cached", b"q")) == Ok(b"cached")
    expect(order.with(fn(var l: List[Str]) -> List[Str] { l })) == ["auth", "trace", "auth", "trace"]
    expect(base.unary("/c.C/Who", b"q")) == Ok(b"none - q")
    let sc = base.with_stream_interceptor(fn(m, o) -> CallOpts ! Status {
      if m == "/c.C/No" {
        return Err(status_new(Code.Unauthenticated, "no token"))
      }
      Ok(o with {metadata: md_with(o.metadata, "authorization", "Bearer s")})
    })
    let first = fn(cc: ClientCall) -> Str ! Status {
      cc.close_send()
      Ok((cc.recv()? ?? b"").to_str_lossy())
    }
    expect(sc.call("/c.C/Who2", {}, None, first)) == Ok("Bearer s")
    expect(sc.call("/c.C/No", {}, None, first)) == Err(status_new(Code.Unauthenticated, "no token"))
  }
}

fn md_with(m: Map[Str, Str], k: Str, v: Str) -> Map[Str, Str] {
  var out = m
  out[k] = v
  out
}

// grpc-go's WithDefaultCallOptions, OnFinish and peer.FromContext
test "default call options, on_finish and the peer, as grpc-go's" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/d.D/Echo", fn(call, _req) -> Bytes ! Status {
    let t = if call.timeout is Some(_) { "deadline" } else { "none" }
    Ok("${call.metadata.get("x-a") ?? "-"} ${call.metadata.get("x-b") ?? "-"} ${t} ${call.peer}".bytes())
  })
  srv.unary("/d.D/Fail", fn(_c, _r) -> Bytes ! Status { Err(status_new(Code.NotFound, "gone")) })
  srv.stream("/d.D/S", fn(_c, _r, send) -> () ! Status { send.send(b"s")? })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  let ended = Mutex[List[Str]].new([])
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let base = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    let c = base.with_default_metadata({"x-a": "1", "x-b": "2"}).with_default_timeout(5s).with_on_finish(fn(m, st) {
      let what = match st {
        None => "ok"
        Some(e) => "${e.code}"
      }
      ended.with(fn(var l: List[Str]) { l.push("${m} ${what}") })
    })
    // the call's own metadata wins; the default timeout is sent; the peer is the client's IP
    expect(c.unary("/d.D/Echo", b"", {"x-b": "own"})) == Ok(b"1 own deadline 127.0.0.1")
    expect(base.unary("/d.D/Echo", b"")) == Ok(b"- - none 127.0.0.1")
    expect(c.unary("/d.D/Fail", b"")) == Err(status_new(Code.NotFound, "gone"))
    let got = c.call("/d.D/S", {}, None, fn(cc) -> Bytes ! Status {
      cc.close_send()
      Ok(cc.recv()? ?? b"")
    })
    expect(got) == Ok(b"s")
    expect(ended.with(fn(var l: List[Str]) -> List[Str] { l })) == ["/d.D/Echo ok", "/d.D/Fail NotFound", "/d.D/S ok"]
  }
}

// grpc-go's keepalive client test (keepalive_test.go TestKeepaliveClientClosesUnresponsiveServer): a server that
// finishes the HTTP/2 handshake and then never answers, nor acks a PING. With keepalive the call fails Unavailable
// after time (10 s, grpc-go's minimum) and timeout; without it, it would wait for the call's own deadline.
test "client keepalive closes a connection whose server stopped answering, as grpc-go's" uses (net, clock) {
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let addr = l.addr()
  scope s {
    s.spawn_background(fn() {
      let sc = l.accept().or_fault("accept")
      // the server's SETTINGS and its ack of the client's, then silence
      sc.write(b"\x00\x00\x00\x04\x00\x00\x00\x00\x00\x00\x00\x00\x04\x01\x00\x00\x00\x00").or_fault("settings")
      while true {
        match sc.read(65536) {
          Ok(Some(_)) => {}
          _ => break
        }
      }
    })
    let c = client(http.client(os.net, timeout: 60s), "http://${addr}").with_keepalive(ClientKeepalive{time: 1s, timeout: 1s})
    let start = os.clock.now()
    let r = c.unary("/k.K/Hang", b"x")
    let took = os.clock.now() - start
    match r {
      Err(st) => expect((st.code, st.message.ends_with("http2: client connection lost"))) == (Code.Unavailable, true)
      Ok(_) => fault("the call succeeded")
    }
    // time 1 s is raised to 10 s; the ack wait is 1 s
    expect(took >= 10s && took < 30s) == true
  }
}

test "keepalive_server sets the HTTP/2 pings and the idle timeout" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/k.K/Ok", fn(_c, req) -> Bytes ! Status { Ok(req) })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = keepalive_server(http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2}), ServerKeepalive{max_connection_idle: 5s, time: 100ms, timeout: 5s})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    // the client acks the server's pings: a call after more than time idle still works
    expect(c.unary("/k.K/Ok", b"a")) == Ok(b"a")
    os.clock.sleep(1500ms)
    expect(c.unary("/k.K/Ok", b"b")) == Ok(b"b")
  }
}

/// The frame types read from h2 (whole frames only) and, for a GOAWAY, its error code and debug text.
fn h2_frames(h2: Bytes) -> List[Str] {
  var out: List[Str] = []
  var i = 0
  while i + 9 <= h2.len() {
    let n = (Int(h2[i]) << 16) | (Int(h2[i + 1]) << 8) | Int(h2[i + 2])
    if i + 9 + n > h2.len() {
      break
    }
    let ty = Int(h2[i + 3])
    if ty == 7 {
      let code = (Int(h2[i + 13]) << 24) | (Int(h2[i + 14]) << 16) | (Int(h2[i + 15]) << 8) | Int(h2[i + 16])
      out.push("goaway ${code} ${h2[i + 17..i + 9 + n].to_str_lossy()}")
    } else if ty == 6 {
      out.push(if (Int(h2[i + 4]) & 1) != 0 { "ping ack" } else { "ping" })
    } else {
      out.push("type ${ty}")
    }
    i = i + 9 + n
  }
  out
}

// grpc-go's keepalive enforcement (http2_server.go handlePing, maxPingStrikes 2): a client's PING sooner than
// min_time after its last is a strike, and the third ends the connection with GOAWAY ENHANCE_YOUR_CALM (11)
// "too_many_pings"; the PINGs are acked first. With no call open the least gap is 2 hours.
test "keepalive_server closes a connection that pings too often, as grpc-go's enforcement policy" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/k.K/Ok", fn(_c, req) -> Bytes ! Status { Ok(req) })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = keepalive_server(http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2}), ServerKeepalive{min_time: 1s})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = os.net.dial(hs.addr()).or_fault("dial")
    let ping = b"\x00\x00\x08\x06\x00\x00\x00\x00\x00\x01\x02\x03\x04\x05\x06\x07\x08"
    c.write(b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n\x00\x00\x00\x04\x00\x00\x00\x00\x00" + ping + ping + ping).or_fault("write")
    // three PINGs: the first is no strike, the next two are; all acked, no GOAWAY
    var got = b""
    while h2_frames(got).filter(fn(f) { f == "ping ack" }).len() < 3 {
      got = got + (c.read(4096).or_fault("read") ?? fault("closed after 3 pings: ${h2_frames(got)}"))
    }
    expect(h2_frames(got).filter(fn(f) { f.starts_with("goaway") })) == []
    // the fourth is the third strike
    c.write(ping).or_fault("write 4")
    while {
      match c.read(4096).or_fault("read 4") {
        Some(x) => got = got + x
        None => break
      }
    }
    let fs = h2_frames(got)
    expect(fs.filter(fn(f) { f == "ping ack" }).len()) == 4
    expect(fs.last()) == Some("goaway 11 too_many_pings")
  }
}

// grpc-go's target parsing (clientconn.go parseTargetAndFindResolver, the default scheme dns) and ClientConn.Target and
// CanonicalTarget
test "target names: dns, passthrough and a bare host:port, as grpc-go's" uses (net, clock) {
  let hc = http.client(os.net, timeout: 10s)
  expect(target_url("dns:///h:1")) == "http://h:1"
  expect(target_url("dns://8.8.8.8/h:1")) == "http://h:1"
  expect(target_url("passthrough:///10.0.0.1:50051")) == "http://10.0.0.1:50051"
  expect(target_url("h:1")) == "http://h:1"
  expect(target_url("https://h:1")) == "https://h:1"
  expect(client(hc, "h:1").target()) == "h:1"
  expect(client(hc, "h:1").canonical_target()) == "dns:///h:1"
  expect(client(hc, "localhost").canonical_target()) == "dns:///localhost"
  expect(client(hc, "passthrough:///h:1").canonical_target()) == "passthrough:///h:1"
  expect(client(hc, "http://h:1").canonical_target()) == "http://h:1"
  // a call through a target name reaches the server
  var srv = server(os.clock)
  srv.unary("/t.T/Echo", fn(_c, req) -> Bytes ! Status { Ok(req) })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    for t in ["dns:///${hs.addr()}", "passthrough:///${hs.addr()}", hs.addr()] {
      expect(client(hc, t).unary("/t.T/Echo", b"x")) == Ok(b"x")
    }
  }
}

test "security levels as grpc-go's credentials.CheckSecurityLevel" {
  expect(check_security_level(None, SecurityLevel.NoSecurity)) == Err("AuthInfo is nil")
  expect(check_security_level(Some(insecure_info()), SecurityLevel.NoSecurity)) == Ok(())
  expect(check_security_level(Some(insecure_info()), SecurityLevel.PrivacyAndIntegrity)) == Err("requires SecurityLevel PrivacyAndIntegrity; connection has NoSecurity")
  expect(check_security_level(Some(tls_info(None)), SecurityLevel.PrivacyAndIntegrity)) == Ok(())
  expect(check_security_level(Some(AuthInfo{auth_type: "x", level: SecurityLevel.InvalidSecurityLevel}), SecurityLevel.PrivacyAndIntegrity)) == Ok(())
  expect(SecurityLevel.IntegrityOnly.display()) == "IntegrityOnly"
  expect(SecurityLevel.InvalidSecurityLevel.display()) == "invalid SecurityLevel: 0"
}

test "per-RPC credentials, as grpc-go's getTrAuthData and getCallAuthData" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/s.S/Who", fn(call, _req) -> Bytes ! Status {
    Ok("${call.metadata.get("authorization") ?? "-"} ${call.metadata.get("x-call") ?? "-"} ${call.metadata.get("x-k") ?? "-"} ${call.auth_info.auth_type} ${call.auth_info.level.display()}".bytes())
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() {
      hs.serve().ignore_err("the test ends the server")
    })
    let base = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    let seen = Mutex[List[Str]].new([])
    let tok = PerRpcCreds{metadata: fn(ri) -> Map[Str, Str] ! Status uses sync {
      seen.with(fn(var l) { l.push("${ri.method} ${ri.audience} ${ri.auth_info.auth_type}") })
      Ok({"Authorization": "Bearer t", "x-k": "creds"})
    }, require_tls: false}
    let c = base.with_per_rpc_creds(tok)
    expect(c.unary("/s.S/Who", b"").map(fn(b) { b.to_str() ?? "?" })) == Ok("Bearer t - creds insecure NoSecurity")
    // the call's own metadata wins on a shared name; call credentials come after the client's
    let cc = c.with_call_creds(PerRpcCreds{metadata: fn(_ri) -> Map[Str, Str] ! Status uses sync { Ok({"x-call": "c", "authorization": "Bearer call"}) }, require_tls: false})
    expect(cc.unary("/s.S/Who", b"", {"x-k": "md"}).map(fn(b) { b.to_str() ?? "?" })) == Ok("Bearer call c md insecure NoSecurity")
    expect(seen.with_read(fn(l) { l })) == ["/s.S/Who https://${hs.addr()}/s.S insecure", "/s.S/Who https://${hs.addr()}/s.S insecure"]
    // credentials that need TLS are refused over cleartext
    let secure = base.with_per_rpc_creds(PerRpcCreds{metadata: fn(_ri) -> Map[Str, Str] ! Status uses sync { Ok({}) }})
    expect(secure.unary("/s.S/Who", b"")) == Err(status_new(Code.Unauthenticated, "transport: cannot send secure credentials on an insecure connection"))
    let r = secure.call("/s.S/Who", {}, None, fn(_cc) -> Int ! Status { Ok(1) })
    expect(r) == Err(status_new(Code.Unauthenticated, "transport: cannot send secure credentials on an insecure connection"))
    // a status from the credentials ends the call; a control plane code becomes Internal (gRFC A54)
    let failing = fn(code: Code) -> Client {
      base.with_per_rpc_creds(PerRpcCreds{metadata: fn(_ri) -> Map[Str, Str] ! Status uses sync { Err(status_new(code, "no token")) }, require_tls: false})
    }
    expect(failing(Code.Unauthenticated).unary("/s.S/Who", b"")) == Err(status_new(Code.Unauthenticated, "no token"))
    expect(failing(Code.NotFound).unary("/s.S/Who", b"")) == Err(status_new(Code.Internal, "transport: received per-RPC creds error with illegal status: rpc error: code = NotFound desc = no token"))
  }
}

// grpc-go's service_config_test.go: parsing and validation (decision 0705)
test "service config JSON parses as grpc-go's and rejects what it rejects" {
  let cfg = service_config_json("{\"methodConfig\": [{\"name\": [{\"service\": \"s.S\", \"method\": \"M\"}, {\"service\": \"s.T\"}], \"timeout\": \"1.5s\", \"maxRequestMessageBytes\": 10, \"retryPolicy\": {\"maxAttempts\": 4, \"initialBackoff\": \"0.01s\", \"maxBackoff\": \"1s\", \"backoffMultiplier\": 2, \"retryableStatusCodes\": [\"UNAVAILABLE\", 4]}}, {\"name\": [{}], \"timeout\": \"0.000000001s\"}], \"retryThrottling\": {\"maxTokens\": 10, \"tokenRatio\": 0.5}, \"loadBalancingConfig\": [{\"round_robin\": {}}]}").or_fault("parse")
  expect(cfg.methods.len()) == 2
  expect(cfg.methods[0].names) == [MethodName{service: "s.S", method: "M"}, MethodName{service: "s.T"}]
  expect(cfg.methods[0].timeout) == Some(1500ms)
  expect(cfg.methods[0].max_request_bytes) == Some(10)
  expect(cfg.methods[0].retry) == Some(RetryPolicy{max_attempts: 4, initial_backoff: 10ms, max_backoff: 1s, backoff_multiplier: 2.0, retryable_codes: [Code.Unavailable, Code.DeadlineExceeded]})
  expect(cfg.methods[1].timeout) == Some(Duration.from_nanos(1))
  expect(cfg.retry_throttling) == Some(RetryThrottling{max_tokens: 10.0, token_ratio: 0.5})
  let bad_policy = "{\"methodConfig\": [{\"name\": [{\"service\": \"s.S\"}], \"retryPolicy\": {\"maxAttempts\": 1, \"initialBackoff\": \"1s\", \"maxBackoff\": \"1s\", \"backoffMultiplier\": 1, \"retryableStatusCodes\": [\"UNAVAILABLE\"]}}]}"
  expect(service_config_json(bad_policy)) == Err("service config: invalid retry policy")
  expect(service_config_json("{\"methodConfig\": [{\"name\": [{\"method\": \"M\"}]}]}").is_err()) == true
  expect(service_config_json("{\"methodConfig\": [{\"name\": [{\"service\": \"a\"}, {\"service\": \"a\"}]}]}").is_err()) == true
  expect(service_config_json("{\"methodConfig\": [{\"name\": [{}], \"timeout\": \"1m\"}]}").is_err()) == true
  expect(service_config_json("{\"retryThrottling\": {\"maxTokens\": 2000, \"tokenRatio\": 1}}")) == Err("service config: invalid retry throttling config")
  expect(service_config_json("not json").is_err()) == true
}

test "method_config takes the method's entry, then its service's, then the default, as grpc-go's" uses (net, clock, rand) {
  let cfg = service_config_json("{\"methodConfig\": [{\"name\": [{}], \"timeout\": \"3s\"}, {\"name\": [{\"service\": \"s.S\"}], \"timeout\": \"2s\"}, {\"name\": [{\"service\": \"s.S\", \"method\": \"M\"}], \"timeout\": \"1s\"}]}").or_fault("parse")
  let c = client(http.client(os.net), "h:1").with_service_config(cfg, os.clock, os.rand)
  expect(c.method_config("/s.S/M").and_then(fn(m) -> Duration? { m.timeout })) == Some(1s)
  expect(c.method_config("/s.S/N").and_then(fn(m) -> Duration? { m.timeout })) == Some(2s)
  expect(c.method_config("/x.X/N").and_then(fn(m) -> Duration? { m.timeout })) == Some(3s)
  expect(client(http.client(os.net), "h:1").method_config("/s.S/M")) == None
}

// grpc-go's retry_test.go: retried codes, attempts, a committed call, pushback, throttling, disabling
test "retries follow the service config, as grpc-go's" uses (net, clock, rand) {
  let calls = Mutex[Map[Str, Int]].new({})
  let count = fn(k: Str) -> Int { calls.with(fn(var m: Map[Str, Int]) -> Int {
    let n = (m.get(k) ?? 0) + 1
    m[k] = n
    n
  }) }
  var srv = server(os.clock)
  // fails Unavailable before its third call
  srv.unary("/r.R/Flaky", fn(call, req) -> Bytes ! Status {
    let n = count("${call.metadata.get("x-key") ?? ""}")
    if n < 3 { Err(status_new(Code.Unavailable, "try again ${n}")) } else { Ok(req) }
  })
  srv.unary("/r.R/Bad", fn(_c, _r) -> Bytes ! Status {
    let _ = count("bad")
    Err(status_new(Code.InvalidArgument, "no"))
  })
  // sends a response message, then fails: committed, never retried
  srv.stream("/r.R/Half", fn(_c, recv, send) -> () ! Status {
    let _ = recv.next()?
    let _ = count("half")
    send.send(b"part")?
    Err(status_new(Code.Unavailable, "after a message"))
  }, client_stream: false, server_stream: false)
  srv.unary("/r.R/Push", fn(_c, _r) -> Bytes ! Status {
    let _ = count("push")
    Err(status_new(Code.Unavailable, "pushed back"))
  })
  srv.stream("/r.R/NoMore", fn(_c, recv, send) -> () ! Status {
    let _ = recv.next()?
    let _ = count("nomore")
    send.set_trailer("grpc-retry-pushback-ms", "-1")
    Err(status_new(Code.Unavailable, "do not retry"))
  }, client_stream: false, server_stream: false)
  srv.unary("/r.R/Slow", fn(_c, req) -> Bytes ! Status {
    os.clock.sleep(2s)
    Ok(req)
  })
  srv.unary("/r.R/Big", fn(_c, _r) -> Bytes ! Status { Ok("x".repeat(100).bytes()) })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  let policy = "\"retryPolicy\": {\"maxAttempts\": 5, \"initialBackoff\": \"0.001s\", \"maxBackoff\": \"0.005s\", \"backoffMultiplier\": 2, \"retryableStatusCodes\": [\"UNAVAILABLE\"]}"
  let cfg = service_config_json("{\"methodConfig\": [{\"name\": [{\"service\": \"r.R\"}], ${policy}}, {\"name\": [{\"service\": \"r.R\", \"method\": \"Slow\"}], \"timeout\": \"0.2s\"}, {\"name\": [{\"service\": \"r.R\", \"method\": \"Big\"}], \"maxResponseMessageBytes\": 10}]}").or_fault("parse")
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let base = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    let c = base.with_service_config(cfg, os.clock, os.rand)
    // two Unavailable answers, then the third attempt succeeds
    expect(c.unary("/r.R/Flaky", b"a", {"x-key": "a"})) == Ok(b"a")
    expect(calls.with(fn(var m: Map[Str, Int]) -> Int? { m.get("a") })) == Some(3)
    // capped at 2 attempts: the second failure is the result
    expect(c.with_max_call_attempts(2).unary("/r.R/Flaky", b"b", {"x-key": "b"})) == Err(status_new(Code.Unavailable, "try again 2"))
    // without retries, or without a config, one attempt
    expect(c.with_disable_retry().unary("/r.R/Flaky", b"c", {"x-key": "c"})) == Err(status_new(Code.Unavailable, "try again 1"))
    expect(base.unary("/r.R/Flaky", b"d", {"x-key": "d"})) == Err(status_new(Code.Unavailable, "try again 1"))
    // a code the policy does not list
    expect(c.unary("/r.R/Bad", b"")) == Err(status_new(Code.InvalidArgument, "no"))
    expect(calls.with(fn(var m: Map[Str, Int]) -> Int? { m.get("bad") })) == Some(1)
    // committed by the response head: one attempt
    expect(c.unary("/r.R/Half", b"").is_err()) == true
    expect(calls.with(fn(var m: Map[Str, Int]) -> Int? { m.get("half") })) == Some(1)
    // every attempt fails: max_attempts calls
    expect(c.unary("/r.R/Push", b"")) == Err(status_new(Code.Unavailable, "pushed back"))
    expect(calls.with(fn(var m: Map[Str, Int]) -> Int? { m.get("push") })) == Some(5)
    // a negative pushback stops the retries
    expect(c.unary("/r.R/NoMore", b"")) == Err(status_new(Code.Unavailable, "do not retry"))
    expect(calls.with(fn(var m: Map[Str, Int]) -> Int? { m.get("nomore") })) == Some(1)
    // the method's timeout and response limit
    expect(c.unary("/r.R/Slow", b"").map_err(fn(e) -> Code { e.code })) == Err(Code.DeadlineExceeded)
    expect(c.unary("/r.R/Big", b"").map_err(fn(e) -> Code { e.code })) == Err(Code.ResourceExhausted)
    // throttling: 2 tokens, half is 1; the first failure leaves 1, which stops the retries
    let tc = service_config_json("{\"methodConfig\": [{\"name\": [{\"service\": \"r.R\"}], ${policy}}], \"retryThrottling\": {\"maxTokens\": 2, \"tokenRatio\": 0.1}}").or_fault("parse")
    expect(base.with_service_config(tc, os.clock, os.rand).unary("/r.R/Flaky", b"e", {"x-key": "e"})) == Err(status_new(Code.Unavailable, "try again 1"))
  }
}

// grpc-go's SetSendCompressor and ClientSupportedCompressors (server.go validateSendCompressor's texts)
test "a handler chooses the response's compressor from the client's list, as grpc-go's SetSendCompressor" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/z.Z/Gz", fn(call, req) -> Bytes ! Status {
    Ok("${call.accept_encodings.join(",")} ${req.to_str_lossy()}".bytes())
  })
  srv.stream("/z.Z/Force", fn(call, recv, send) -> () ! Status {
    let m = recv.next()? ?? b""
    let want = call.metadata.get("x-want") ?? "gzip"
    send.set_compressor(want)?
    send.send(m)?
    // after the head went out
    match send.set_compressor("gzip") {
      Ok(_) => send.send(b"no error")?
      Err(e) => send.send(e.message.bytes())?
    }
  }, client_stream: false, server_stream: true)
  srv.stream("/z.Z/Bad", fn(_c, recv, send) -> () ! Status {
    let _ = recv.next()?
    match send.set_compressor("zstd") {
      Ok(_) => send.send(b"no error")?
      Err(e) => send.send(e.message.bytes())?
    }
  }, client_stream: false, server_stream: true)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 10s), "http://${hs.addr()}")
    expect(c.unary("/z.Z/Gz", b"x")) == Ok(b"gzip,identity x")
    let read = fn(cl: Client, md: Map[Str, Str]) -> (Str, List[Str]) ! Status {
      cl.call("/z.Z/Force", md, None, fn(cc) -> (Str, List[Str]) ! Status {
        cc.send(b"hello")?
        cc.close_send()
        let h = cc.header()?
        var msgs: List[Str] = []
        while let Some(m) = cc.recv()? {
          msgs.push(m.to_str_lossy())
        }
        Ok((h.get("grpc-encoding") ?? "-", msgs))
      })
    }
    // the client reads either answer (grpc-encoding is a reserved name, not header metadata)
    expect(read(c, {"x-want": "gzip"})) == Ok(("-", ["hello", "transport: set send compressor called after headers sent or stream done"]))
    expect(read(c.with_gzip(), {"x-want": "identity"})) == Ok(("-", ["hello", "transport: set send compressor called after headers sent or stream done"]))
    // on the wire: a plain request's answer is gzip, its first frame flagged compressed; a gzip request's is identity
    let hc = http.client(os.net, timeout: 10s).with_protocols(#{http.Protocol.UnencryptedHttp2})
    for (want, req_enc, flag) in [("gzip", "identity", 1), ("identity", "gzip", 0)] {
      var h = {"content-type": "application/grpc", "te": "trailers", "x-want": want, "grpc-accept-encoding": "gzip,identity"}
      let body = if req_enc == "gzip" { frame(compress.gzip(b"hello"), compressed: true) } else { frame(b"hello") }
      if req_enc == "gzip" {
        h["grpc-encoding"] = "gzip"
      }
      let r = hc.send(http.new_request("POST", "http://${hs.addr()}/z.Z/Force", h, body)).or_fault("raw")
      expect((r.headers.get("Grpc-Encoding"), Int(r.body[0]))) == (Some(want), flag)
    }
    let bad = c.call("/z.Z/Bad", {}, None, fn(cc) -> Str ! Status {
      cc.send(b"")?
      cc.close_send()
      Ok((cc.recv()? ?? b"").to_str_lossy())
    })
    expect(bad) == Ok("compressor not registered \"zstd\"")
  }
}

// A message the client sends on an open stream goes out at once (task #286): the native h2 client's pump read the
// socket for 10 ms before it looked for the next request piece, so each send-then-recv round took 11 ms (grpc-go:
// 0.1 ms). 300 rounds take about 3.3 s at the tick; the budget is 1.5 s.
test "a bidi stream's send then recv rounds do not wait for the h2 read tick" uses (net, clock) {
  var srv = server(os.clock)
  srv.stream("/e.E/Echo", fn(_call, recv, send) -> () ! Status {
    while true {
      match recv.next()? {
        Some(m) => send.send(m)?
        None => break
      }
    }
    Ok(())
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 30s), "http://${hs.addr()}")
    let t0 = os.clock.now()
    let got = c.call("/e.E/Echo", {}, None, fn(cc) -> Int ! Status {
      var n = 0
      for i in 0..300 {
        cc.send("m${i}".bytes())?
        if cc.recv()? == Some("m${i}".bytes()) {
          n += 1
        }
      }
      cc.close_send()
      Ok(n)
    })
    let took = os.clock.now() - t0
    expect(got) == Ok(300)
    expect(took < 1500ms) == true
  }
}

// grpc-go's unix resolver (internal/resolver/unix): unix:///abs/path and unix:path dial the socket, authority localhost
test "unix: targets call a server on a Unix socket, as grpc-go's" uses (net, clock) {
  let path = "/tmp/xo-grpc-unix-${os.clock.now().unix_nanos()}.sock"
  var srv = server(os.clock)
  srv.unary("/u.U/Echo", fn(call, req) -> Bytes ! Status { Ok("${call.authority} ".bytes() + req) })
  let l = os.net.listen("unix:${path}").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let hc = http.client(os.net, timeout: 10s)
    for t in ["unix://${path}", "unix:${path}"] {
      expect(client(hc, t).unary("/u.U/Echo", b"x")) == Ok(b"localhost x")
    }
    expect(unix_path("unix://host/p")) == None
    expect(client(hc, "unix:${path}").canonical_target()) == "unix:${path}"
  }
}

// decision 0707: grpc-go's pick_first and round_robin over a manual resolver's addresses (one of them refusing
// connections), the policy from a service config's loadBalancingConfig, and a resolver run on the first call only
test "with_addrs spreads calls as grpc-go's pick_first and round_robin" uses (net, clock, rand) {
  let dead = os.net.listen("127.0.0.1:0").or_fault("listen")
  let dead_addr = dead.addr()
  dead.close()
  var one = server(os.clock)
  one.unary("/b.B/Who", fn(_c, _r) -> Bytes ! Status { Ok(b"one") })
  var two = server(os.clock)
  two.unary("/b.B/Who", fn(_c, _r) -> Bytes ! Status { Ok(b"two") })
  let h1 = http.server(os.net.listen("127.0.0.1:0").or_fault("listen"), one.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  let h2 = http.server(os.net.listen("127.0.0.1:0").or_fault("listen"), two.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { h1.serve().ignore_err("the test ends the server") })
    s.spawn_background(fn() { h2.serve().ignore_err("the test ends the server") })
    let hc = http.client(os.net, timeout: 10s)
    let who = fn(c: Client) -> Str {
      match c.unary("/b.B/Who", b"") {
        Ok(b) => b.to_str_lossy()
        Err(e) => if e.code == Code.Unavailable { "unavailable" } else { "err ${e.message}" }
      }
    }
    let addrs = [dead_addr, h1.addr(), h2.addr()]
    let pf = client(hc, "dns:///svc.test:50051").with_addrs(addrs)
    expect([who(pf), who(pf), who(pf)]) == ["one", "one", "one"]
    let rr = client(hc, "dns:///svc.test:50051").with_addrs(addrs).with_balancer(Balancer.RoundRobin)
    expect([who(rr), who(rr), who(rr), who(rr)]) == ["one", "two", "one", "two"]
    let cfg = service_config_json("{\"loadBalancingConfig\": [{\"weighted_round_robin\": {}}, {\"round_robin\": {}}]}").or_fault("config")
    expect(cfg.balancer) == Some(Balancer.RoundRobin)
    let sc = client(hc, "svc.test:50051").with_addrs([h1.addr(), h2.addr()]).with_service_config(cfg, os.clock, os.rand)
    expect([who(sc), who(sc)]) == ["one", "two"]
    expect(who(client(hc, "svc.test:50051").with_addrs([dead_addr]))) == "unavailable"
    expect(who(client(hc, "svc.test:50051").with_addrs([]))) == "unavailable"
    let runs = Mutex[Int].new(0)
    let rs = client(hc, "svc.test:50051").with_resolver(fn() -> List[Str] ! Status {
      runs.with(fn(var n: Int) { n += 1 })
      Ok([h2.addr()])
    }, os.clock)
    expect([who(rs), who(rs)]) == ["two", "two"]
    expect(runs.with(fn(var n: Int) -> Int { n })) == 1
  }
}

test "a service config's balancer policy, as grpc-go's parser" {
  expect(service_config_json("{\"loadBalancingPolicy\": \"ROUND_ROBIN\"}").map(fn(c) -> Balancer? { c.balancer })) == Ok(Some(Balancer.RoundRobin))
  expect(service_config_json("{\"loadBalancingPolicy\": \"grpclb\"}").map(fn(c) -> Balancer? { c.balancer })) == Ok(None)
  expect(service_config_json("{\"loadBalancingConfig\": [{\"pick_first\": {}}], \"loadBalancingPolicy\": \"round_robin\"}").map(fn(c) -> Balancer? { c.balancer })) == Ok(Some(Balancer.PickFirst))
  expect(service_config_json("{\"loadBalancingConfig\": [{\"grpclb\": {}}]}")) == Err("service config: invalid loadBalancingConfig: no supported policies found")
  expect(target_host_port("http://svc.test:50051")) == ("svc.test", "50051")
  expect(target_host_port("http://svc.test")) == ("svc.test", "443")
  expect(target_host_port("https://[::1]:8443/x")) == ("::1", "8443")
}

// task #293: a message another task sends while this one waits in recv goes out at once; the native h2 client's pump
// waited in its 10 ms read tick for it (300 rounds of a 1 ms pause, then the send: about 3.3 s at the tick, 0.4 s
// with the wake; the budget is 1.5 s)
test "a message another task sends while recv waits does not wait for the h2 read tick" uses (net, clock) {
  var srv = server(os.clock)
  srv.stream("/e.E/Echo", fn(_call, recv, send) -> () ! Status {
    while true {
      match recv.next()? {
        Some(m) => send.send(m)?
        None => break
      }
    }
    Ok(())
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 30s), "http://${hs.addr()}")
    // the stream is open (the first round trip) before the timed rounds
    let t0 = Mutex[Duration].new(0s)
    let got = c.call("/e.E/Echo", {}, None, fn(cc) -> Int ! Status {
      cc.send(b"first")?
      let _ = cc.recv()?
      let go = Chan[Int].new(1)
      var n = 0
      let start = os.clock.now()
      scope inner {
        inner.spawn(fn() {
          while let Some(i) = go.recv() {
            os.clock.sleep(1ms)
            cc.send("m${i}".bytes()).ignore_err("the call fails below")
          }
        })
        for i in 0..300 {
          go.send(i)
          if cc.recv()? == Some("m${i}".bytes()) {
            n += 1
          }
        }
        go.close()
      }
      t0.with(fn(var d: Duration) { d = os.clock.now() - start })
      cc.close_send()
      Ok(n)
    })
    expect(got) == Ok(300)
    expect(t0.with(fn(var d: Duration) -> Duration { d }) < 1500ms) == true
  }
}

// task #293, Lang 3's review: a recv cancelled while it waits (the pump armed in its read) disarms on the way out,
// so the next send's piece wakes no freed exchange; the client goes on calling
test "a recv cancelled while it waits leaves the stream's wake disarmed" uses (net, clock) {
  var srv = server(os.clock)
  srv.stream("/e.E/Echo", fn(_call, recv, send) -> () ! Status {
    while true {
      match recv.next()? {
        Some(m) => send.send(m)?
        None => break
      }
    }
    Ok(())
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 30s), "http://${hs.addr()}")
    for _ in 0..20 {
      c.call("/e.E/Echo", {}, None, fn(cc) -> Int ! Status {
        cc.send(b"first")?
        let _ = cc.recv()?
        scope inner {
          inner.spawn(fn() { cc.recv().ignore_err("cancelled") })
          os.clock.sleep(15ms)
          inner.cancel()
        }
        for i in 0..5 {
          cc.send("after${i}".bytes()).ignore_err("the stream may be gone")
        }
        os.clock.sleep(5ms)
        cc.close_send()
        Ok(0)
      }).ignore_err("a cancelled recv may end the call")
    }
    expect(c.call("/e.E/Echo", {}, None, fn(cc) -> Bytes? ! Status {
      cc.send(b"again")?
      cc.recv()
    })) == Ok(Some(b"again"))
  }
}

// grpc-go's MaxConnectionAge and MaxConnectionAgeGrace: a connection that old gets GOAWAY "max_age", a stream still
// open after the grace is cut (Unavailable), and the client's next call goes on a new connection
test "keepalive_server ends a connection at max_connection_age after its grace, as grpc-go's" uses (net, clock) {
  var srv = server(os.clock)
  srv.unary("/a.A/Ping", fn(_c, _r) -> Bytes ! Status { Ok(b"pong") })
  srv.stream("/a.A/Echo", fn(_call, recv, send) -> () ! Status {
    while true {
      match recv.next()? {
        Some(m) => send.send(m)?
        None => break
      }
    }
    Ok(())
  })
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  let hs = keepalive_server(http.server(l, srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2}), ServerKeepalive{max_connection_age: 300ms, max_connection_age_grace: 300ms})
  scope s {
    s.spawn_background(fn() { hs.serve().ignore_err("the test ends the server") })
    let c = client(http.client(os.net, timeout: 5s), "http://${hs.addr()}")
    let got = c.call("/a.A/Echo", {}, None, fn(cc) -> Code ! Status {
      cc.send(b"x")?
      let _ = cc.recv()?
      os.clock.sleep(1s)
      match cc.recv() {
        Ok(_) => Ok(Code.Ok)
        Err(e) => if e.code == Code.Unavailable { Ok(e.code) } else { Err(e) }
      }
    })
    expect(got) == Ok(Code.Unavailable)
    expect(c.unary("/a.A/Ping", b"")) == Ok(b"pong")
  }
}

test "ClientCall.peer is the address the call went to, as grpc-go's grpc.Peer call option" uses (net, clock) {
  let dead = os.net.listen("127.0.0.1:0").or_fault("listen")
  let dead_addr = dead.addr()
  dead.close()
  var srv = server(os.clock)
  srv.stream("/p.P/Who", fn(_c, _r, out) -> () ! Status { out.send(b"x") })
  let h = http.server(os.net.listen("127.0.0.1:0").or_fault("listen"), srv.router()).with_protocols(#{http.Protocol.UnencryptedHttp2})
  scope s {
    s.spawn_background(fn() { h.serve().ignore_err("the test ends the server") })
    let hc = http.client(os.net, timeout: 10s)
    let peer_of = fn(c: Client) -> Str ! Status {
      c.call("/p.P/Who", {}, None, fn(cc) -> Str ! Status {
        cc.send(b"")?
        cc.close_send()
        let p = cc.peer()?
        while cc.recv()?.is_some() {}
        Ok(p)
      })
    }
    // a balancing client: the address it connected to, past the dead one
    expect(peer_of(client(hc, "dns:///svc.test:50051").with_addrs([dead_addr, h.addr()]))) == Ok(h.addr())
    // a base URL: its host and port
    expect(peer_of(client(hc, "http://${h.addr()}"))) == Ok(h.addr())
    // a call that never opened has its status, not an address
    expect(peer_of(client(hc, "svc.test:50051").with_addrs([dead_addr])).map_err(fn(e) -> Code { e.code })) == Err(Code.Unavailable)
  }
  expect(plain_peer(client(http.client(os.net), "https://svc.test/x"))) == "svc.test:443"
  expect(plain_peer(client(http.client(os.net), "http://[::1]"))) == "[::1]:80"
  expect(plain_peer(client(http.client(os.net), "unix:///tmp/g.sock"))) == "unix:/tmp/g.sock"
}
