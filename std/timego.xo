// std/timego (decision 0537): Go's time layouts ("2006-01-02T15:04:05Z07:00") for code ported from Go: Go's own
// layout scanner, formatter and parser over core time's civil functions. The core API is unchanged (decision 0087).
// Pure.
//
// std/timego: Go's time layouts (decision 0537), a port of time/format.go's nextStdChunk, appendFormat and parse over
// core time's civil functions. A layout is scanned once into chunks: a kind, the literal text of a literal chunk, and
// for a fractional second its digit count (the separator is the literal).

use std/time

/// Go's layout constants (time/format.go).
pub const ANSIC: Str = "Mon Jan _2 15:04:05 2006"

pub const UNIX_DATE: Str = "Mon Jan _2 15:04:05 MST 2006"

pub const RUBY_DATE: Str = "Mon Jan 02 15:04:05 -0700 2006"

pub const RFC822: Str = "02 Jan 06 15:04 MST"

pub const RFC822Z: Str = "02 Jan 06 15:04 -0700"

pub const RFC850: Str = "Monday, 02-Jan-06 15:04:05 MST"

pub const RFC1123: Str = "Mon, 02 Jan 2006 15:04:05 MST"

pub const RFC1123Z: Str = "Mon, 02 Jan 2006 15:04:05 -0700"

pub const RFC3339: Str = "2006-01-02T15:04:05Z07:00"

pub const RFC3339_NANO: Str = "2006-01-02T15:04:05.999999999Z07:00"

pub const KITCHEN: Str = "3:04PM"

pub const STAMP: Str = "Jan _2 15:04:05"

pub const STAMP_MILLI: Str = "Jan _2 15:04:05.000"

pub const STAMP_MICRO: Str = "Jan _2 15:04:05.000000"

pub const STAMP_NANO: Str = "Jan _2 15:04:05.000000000"

pub const DATE_TIME: Str = "2006-01-02 15:04:05"

pub const DATE_ONLY: Str = "2006-01-02"

pub const TIME_ONLY: Str = "15:04:05"

/// A Go layout scanned once: its literal text and reference elements. Hot code makes one and calls `format` and
/// `parse` on it.
pub struct Layout {
  pub text: Str
  pub kinds: List[Int]
  pub lits: List[Str]
  pub ns: List[Int]
}

/// Scans a Go layout (every string is a layout: text that is not a reference element is literal).
pub fn layout(go_layout: Str) -> Layout {
  let b = go_layout.bytes()
  var kinds: List[Int] = []
  var lits: List[Str] = []
  var ns: List[Int] = []
  var lit_start = 0
  var i = 0
  while i < b.len() {
    let (k, n, d) = std_at(b, i)
    if k < 0 {
      i += 1
    } else {
      if i > lit_start {
        kinds.push(LIT)
        lits.push(go_layout[lit_start..i].clone())
        ns.push(0)
      }
      kinds.push(k)
      // a fraction keeps its separator in lits, the other elements nothing
      lits.push(if k == FRAC0 || k == FRAC9 { go_layout[i..i + 1].clone() } else { "" })
      ns.push(d)
      i += n
      lit_start = i
    }
  }
  if b.len() > lit_start {
    kinds.push(LIT)
    lits.push(go_layout[lit_start..].clone())
    ns.push(0)
  }
  Layout{text: go_layout, kinds: kinds, lits: lits, ns: ns}
}

/// Go's Time.Format for the layout.
pub fn (l: Layout) format(t: Time, z: time.Zone) -> Str {
  let c = time.civil(t, z)
  let year = c.date.year
  let month = c.date.month
  let day = c.date.day
  let hour = c.time.hour
  let offset = c.offset.nanos() / 1000000000
  let wd = c.date.weekday().number() % 7
  var out = BytesBuilder.with_capacity(l.text.len() + 16)
  var i = 0
  while i < l.kinds.len() {
    let k = l.kinds[i]
    if k == LIT {
      out.write(l.lits[i].bytes())
    } else if k == YEAR2 {
      out = put_int(out, (if year < 0 { -year } else { year }) % 100, 2, 48)
    } else if k == YEAR4 {
      out = put_int(out, year, 4, 48)
    } else if k == MONTH_LONG {
      out.write(month_name(month, true))
    } else if k == MONTH_SHORT {
      out.write(month_name(month, false))
    } else if k == MONTH_NUM {
      out = put_int(out, month, 1, 48)
    } else if k == MONTH_ZERO {
      out = put_int(out, month, 2, 48)
    } else if k == WD_LONG {
      out.write(day_name(wd, true))
    } else if k == WD_SHORT {
      out.write(day_name(wd, false))
    } else if k == DAY {
      out = put_int(out, day, 1, 48)
    } else if k == DAY_UNDER {
      out = put_int(out, day, 2, 32)
    } else if k == DAY_ZERO {
      out = put_int(out, day, 2, 48)
    } else if k == YDAY_UNDER {
      out = put_int(out, yday_of(year, month, day), 3, 32)
    } else if k == YDAY_ZERO {
      out = put_int(out, yday_of(year, month, day), 3, 48)
    } else if k == HOUR24 {
      out = put_int(out, hour, 2, 48)
    } else if k == HOUR12 || k == HOUR12_ZERO {
      var h = hour % 12
      if h == 0 {
        h = 12
      }
      out = put_int(out, h, if k == HOUR12 { 1 } else { 2 }, 48)
    } else if k == MIN {
      out = put_int(out, c.time.minute, 1, 48)
    } else if k == MIN_ZERO {
      out = put_int(out, c.time.minute, 2, 48)
    } else if k == SEC {
      out = put_int(out, c.time.second, 1, 48)
    } else if k == SEC_ZERO {
      out = put_int(out, c.time.second, 2, 48)
    } else if k == PM_UP {
      out.write(if hour >= 12 { b"PM" } else { b"AM" })
    } else if k == PM_LO {
      out.write(if hour >= 12 { b"pm" } else { b"am" })
    } else if k == TZ_NAME {
      if c.zone != "" {
        out.write(c.zone.bytes())
      } else {
        var zone = offset / 60
        if zone < 0 {
          out.write_byte(UInt8(45))
          zone = -zone
        } else {
          out.write_byte(UInt8(43))
        }
        out = put_int(out, zone / 60, 2, 48)
        out = put_int(out, zone % 60, 2, 48)
      }
    } else if k >= ISO_BASIC && k <= NUM_COLON_SECS {
      out = put_zone(out, k, offset)
    } else {
      // a fractional second: ns digits of the nanoseconds, a run of nines without its trailing zeros
      let digits = put_int(BytesBuilder.with_capacity(9), c.time.nanos, 9, 48).freeze()
      var n = l.ns[i]
      if n > 9 {
        n = 9
      }
      if k == FRAC0 {
        out.write(l.lits[i].bytes())
        out.write(digits[0..n])
        var extra = n
        while extra < l.ns[i] {
          out.write_byte(UInt8(48))
          extra += 1
        }
      } else {
        var end = n
        while end > 0 && digits[end - 1] == UInt8(48) {
          end -= 1
        }
        if end > 0 {
          out.write(l.lits[i].bytes())
          out.write(digits[0..end])
        }
      }
    }
    i += 1
  }
  out.freeze().to_str_lossy()
}

/// Go's time.ParseInLocation for the layout: `z` is the zone of a text without an offset. A time outside what a
/// `Time` holds (1677 to 2262) is a `ParseErr`; a civil time in a daylight saving gap or overlap is the earlier one.
pub fn (l: Layout) parse(s: Str, z: time.Zone) -> Time ! time.ParseErr {
  let v = s.bytes()
  if l.text == "2006-01-02T15:04:05Z07:00" || l.text == "2006-01-02T15:04:05.999999999Z07:00" {
    match parse_rfc3339(v, z) {
      Some(t) => return Ok(t)
      None => {}
    }
  }
  var p = 0
  var year = 0
  var month = -1
  var day = -1
  var yday = -1
  var hour = 0
  var minute = 0
  var sec = 0
  var nsec = 0
  var pm_set = false
  var am_set = false
  var have_off = false
  var off = 0
  var zname = ""
  var i = 0
  while i < l.kinds.len() {
    let k = l.kinds[i]
    var bad = ""
    let start = p
    if k == LIT {
      let q = skip_lit(v, p, l.lits[i].bytes())
      if q < 0 {
        return Err(perr_go(s, l.text, p, "does not match the layout text " + l.lits[i], 1, l.lits[i],
          s[lit_fail_pos(v, p, l.lits[i].bytes())..], ""))
      }
      p = q
    } else if k == YEAR2 {
      let x = digits_at(v, p, 2)
      if x < 0 {
        bad = "expected 2 digit year"
      } else {
        year = if x >= 69 { x + 1900 } else { x + 2000 }
        p += 2
      }
    } else if k == YEAR4 {
      let x = digits_at(v, p, 4)
      if x < 0 {
        bad = "expected 4 digit year"
      } else {
        year = x
        p += 4
      }
    } else if k == MONTH_LONG || k == MONTH_SHORT {
      let x = lookup_name(true, k == MONTH_LONG, v, p)
      if x < 0 {
        bad = "expected month name"
      } else {
        month = x
        p += month_name(x, k == MONTH_LONG).len()
      }
    } else if k == MONTH_NUM || k == MONTH_ZERO {
      let (x, q) = getnum(v, p, k == MONTH_ZERO)
      if x < 0 {
        bad = "expected month number"
      } else if x < 1 || x > 12 {
        bad = "month out of range"
      } else {
        month = x
        p = q
      }
    } else if k == WD_LONG || k == WD_SHORT {
      let x = lookup_name(false, k == WD_LONG, v, p)
      if x < 0 {
        bad = "expected weekday name"
      } else {
        p += day_name(x, k == WD_LONG).len()
      }
    } else if k == DAY || k == DAY_UNDER || k == DAY_ZERO {
      if k == DAY_UNDER && p < v.len() && Int(v[p]) == 32 {
        p += 1
      }
      let (x, q) = getnum(v, p, k == DAY_ZERO)
      if x < 0 {
        bad = "expected day"
      } else {
        day = x
        p = q
      }
    } else if k == YDAY_UNDER || k == YDAY_ZERO {
      var skipped = 0
      if k == YDAY_UNDER {
        while skipped < 2 && p < v.len() && Int(v[p]) == 32 {
          p += 1
          skipped += 1
        }
      }
      let (x, q) = getnum3(v, p, k == YDAY_ZERO)
      if x < 0 {
        bad = "expected day of year"
      } else if x < 1 || x > 366 {
        bad = "day-of-year out of range"
      } else {
        yday = x
        p = q
      }
    } else if k == HOUR24 {
      let (x, q) = getnum(v, p, false)
      if x < 0 {
        bad = "expected hour"
      } else if x >= 24 {
        bad = "hour out of range"
      } else {
        hour = x
        p = q
      }
    } else if k == HOUR12 || k == HOUR12_ZERO {
      let (x, q) = getnum(v, p, k == HOUR12_ZERO)
      if x < 0 {
        bad = "expected hour"
      } else if x > 12 {
        bad = "hour out of range"
      } else {
        hour = x
        p = q
      }
    } else if k == MIN || k == MIN_ZERO {
      let (x, q) = getnum(v, p, k == MIN_ZERO)
      if x < 0 {
        bad = "expected minute"
      } else if x >= 60 {
        bad = "minute out of range"
      } else {
        minute = x
        p = q
      }
    } else if k == SEC || k == SEC_ZERO {
      let (x, q) = getnum(v, p, k == SEC_ZERO)
      if x < 0 {
        bad = "expected second"
      } else if x >= 60 {
        bad = "second out of range"
      } else {
        sec = x
        p = q
        // a fraction without a fractional second element in the layout is still read
        if comma_or_period(v, p) && digit_at(v, p + 1) {
          var j = i + 1
          while j < l.kinds.len() && l.kinds[j] == LIT {
            j += 1
          }
          let has_frac = j < l.kinds.len() && (l.kinds[j] == FRAC0 || l.kinds[j] == FRAC9)
          if !has_frac {
            var n = 2
            while digit_at(v, p + n) {
              n += 1
            }
            nsec = parse_nanos(v, p, n)
            p += n
          }
        }
      }
    } else if k == PM_UP || k == PM_LO {
      if at_is(v, p, if k == PM_UP { b"PM" } else { b"pm" }) {
        pm_set = true
        p += 2
      } else if at_is(v, p, if k == PM_UP { b"AM" } else { b"am" }) {
        am_set = true
        p += 2
      } else {
        bad = "expected AM or PM"
      }
    } else if k == TZ_NAME {
      if at_is(v, p, b"UTC") {
        have_off = true
        off = 0
        p += 3
      } else {
        let n = parse_zone_name(v, p)
        if n == 0 {
          bad = "expected time zone name"
        } else {
          zname = s[p..p + n]
          p += n
        }
      }
    } else if k >= ISO_BASIC && k <= NUM_COLON_SECS {
      let iso = k >= ISO_BASIC && k <= ISO_COLON_SECS
      if iso && p < v.len() && Int(v[p]) == 90 {
        have_off = true
        off = 0
        p += 1
      } else {
        let colon = k == ISO_COLON || k == NUM_COLON
        let colon_secs = k == ISO_COLON_SECS || k == NUM_COLON_SECS
        let short = k == ISO_SHORT || k == NUM_SHORT
        let secs = k == ISO_SECS || k == NUM_SECS
        var need = 5
        if colon {
          need = 6
        } else if short {
          need = 3
        } else if colon_secs {
          need = 9
        } else if secs {
          need = 7
        }
        var hh = -1
        var mm = 0
        var ss = 0
        if v.len() - p >= need {
          let h0 = p + 1
          if colon {
            if Int(v[p + 3]) == 58 {
              hh = digits_at(v, h0, 2)
              mm = digits_at(v, p + 4, 2)
            }
          } else if short {
            hh = digits_at(v, h0, 2)
          } else if colon_secs {
            if Int(v[p + 3]) == 58 && Int(v[p + 6]) == 58 {
              hh = digits_at(v, h0, 2)
              mm = digits_at(v, p + 4, 2)
              ss = digits_at(v, p + 7, 2)
            }
          } else if secs {
            hh = digits_at(v, h0, 2)
            mm = digits_at(v, p + 3, 2)
            ss = digits_at(v, p + 5, 2)
          } else {
            hh = digits_at(v, h0, 2)
            mm = digits_at(v, p + 3, 2)
          }
        }
        let sign = if v.len() - p >= 1 { Int(v[p]) } else { 0 }
        if hh < 0 || mm < 0 || ss < 0 || (sign != 43 && sign != 45) {
          bad = "expected time zone offset"
        } else if hh > 24 || mm > 60 || ss > 60 {
          // Go names the last part out of range
          bad = if ss > 60 { "time zone offset second out of range" } else if mm > 60 { "time zone offset minute out of range" } else { "time zone offset hour out of range" }
        } else {
          off = (hh * 60 + mm) * 60 + ss
          if sign == 45 {
            off = -off
          }
          have_off = true
          p += need
        }
      }
    } else if k == FRAC0 {
      let nd = 1 + l.ns[i]
      if v.len() - p < nd || !comma_or_period(v, p) {
        bad = "expected fractional second"
      } else {
        let x = parse_nanos(v, p, nd)
        if x < 0 {
          bad = "expected fractional second"
        } else {
          nsec = x
          p += nd
        }
      }
    } else {
      if comma_or_period(v, p) && digit_at(v, p + 1) {
        var n = 1
        while digit_at(v, p + n) {
          n += 1
        }
        nsec = parse_nanos(v, p, n)
        p += n
      }
    }
    if bad != "" {
      if bad.ends_with(" out of range") {
        return Err(perr_go(s, l.text, p, bad, 3, "", "", bad))
      }
      return Err(perr_go(s, l.text, p, bad, 1, elem_text(k, l.lits[i], l.ns[i]), s[start..], ""))
    }
    if nsec < 0 {
      return Err(perr(s, l.text, p, "bad fractional second"))
    }
    i += 1
  }
  if p < v.len() {
    return Err(perr_go(s, l.text, p, "extra text", 2, "", s[p..], ""))
  }
  if pm_set && hour < 12 {
    hour += 12
  } else if am_set && hour == 12 {
    hour = 0
  }
  if yday >= 0 {
    var d = 0
    var m = 0
    var yd = yday
    if is_leap(year) {
      if yd == 60 {
        m = 2
        d = 29
      } else if yd > 60 {
        yd -= 1
      }
    }
    if yd < 1 || yd > 365 {
      return Err(perr_go(s, l.text, p, "day-of-year out of range", 3, "", "", "day-of-year out of range"))
    }
    if m == 0 {
      m = (yd - 1) / 31 + 1
      if days_before(m) < yd {
        m += 1
      }
      d = yd - days_before(m - 1)
    }
    if month >= 0 && month != m {
      return Err(perr_go(s, l.text, p, "day-of-year does not match month", 3, "", "", "day-of-year does not match month"))
    }
    month = m
    if day >= 0 && day != d {
      return Err(perr_go(s, l.text, p, "day-of-year does not match day", 3, "", "", "day-of-year does not match day"))
    }
    day = d
  } else {
    if month < 0 {
      month = 1
    }
    if day < 0 {
      day = 1
    }
  }
  if day < 1 || day > days_in(month, year) {
    return Err(perr_go(s, l.text, p, "day out of range", 3, "", "", "day out of range"))
  }
  if have_off && zname == "" && year >= 1678 && year <= 2261 {
    return Ok(unix_time(year, month, day, hour, minute, sec, nsec, off))
  }
  let clock = time.ClockTime{hour: hour, minute: minute, second: sec, nanos: nsec}
  let d = match time.date(year, month, day) {
    Ok(d) => d
    Err(e) => return Err(perr(s, l.text, p, "range: " + e.display()))
  }
  if zname != "" {
    // a zone name: the zone's own offset when it was in effect, else a fixed zone with an unknown offset (GMT+N
    // reads its hour)
    let t = match time.instant(d, clock, time.utc(), time.Ambiguity.Earlier) {
      Ok(t) => t
      Err(e) => return Err(perr(s, l.text, p, "range: " + e.display()))
    }
    if z.abbreviation_at(t) == zname {
      return Ok(t - z.offset_at(t))
    }
    var secs = 0
    if zname.len() > 3 && zname.starts_with("GMT") {
      let zb = zname.bytes()
      var q = 3
      let neg = Int(zb[q]) == 45
      if Int(zb[q]) == 45 || Int(zb[q]) == 43 {
        q += 1
      }
      var x = 0
      while digit_at(zb, q) {
        x = x * 10 + Int(zb[q]) - 48
        q += 1
      }
      secs = (if neg { -x } else { x }) * 3600
    }
    return Ok(t - Duration.from_secs_int(secs))
  }
  if have_off {
    let t = match time.instant(d, clock, time.utc(), time.Ambiguity.Earlier) {
      Ok(t) => t
      Err(e) => return Err(perr(s, l.text, p, "range: " + e.display()))
    }
    return Ok(t - Duration.from_secs_int(off))
  }
  match time.instant(d, clock, z, time.Ambiguity.Earlier) {
    Ok(t) => Ok(t)
    Err(e) => Err(perr(s, l.text, p, "range: " + e.display()))
  }
}

/// `layout(go_layout).format(t, z)`.
pub fn format(t: Time, z: time.Zone, go_layout: Str) -> Str {
  layout(go_layout).format(t, z)
}

/// `layout(go_layout).parse(s, z)`.
pub fn parse(s: Str, go_layout: Str, z: time.Zone) -> Time ! time.ParseErr {
  layout(go_layout).parse(s, z)
}

/// The text Go's time.Parse gives for the same failure (`parsing time "X" as "LAYOUT": cannot parse "REST" as "ELEM"`,
/// `parsing time "X": extra text: "REST"`, `parsing time "X": month out of range`) when `e` came from a timego parse; the
/// display text of `e` for any other failure (a time outside what a Time holds, an error of core time's parser).
pub fn go_text(e: time.ParseErr) -> Str {
  match e.go_kind {
    1 => "parsing time ${go_quote(e.input)} as ${go_quote(e.layout)}: cannot parse ${go_quote(e.go_rest)} as ${go_quote(e.go_elem)}"
    2 => "parsing time ${go_quote(e.input)}: extra text: ${go_quote(e.go_rest)}"
    3 => "parsing time ${go_quote(e.input)}: ${e.go_msg}"
    _ => e.display()
  }
}

const LIT: Int = 0

const YEAR2: Int = 1

const YEAR4: Int = 2

const MONTH_LONG: Int = 3

const MONTH_SHORT: Int = 4

const MONTH_NUM: Int = 5

const MONTH_ZERO: Int = 6

const WD_LONG: Int = 7

const WD_SHORT: Int = 8

const DAY: Int = 9

const DAY_UNDER: Int = 10

const DAY_ZERO: Int = 11

const YDAY_UNDER: Int = 12

const YDAY_ZERO: Int = 13

const HOUR24: Int = 14

const HOUR12: Int = 15

const HOUR12_ZERO: Int = 16

const MIN: Int = 17

const MIN_ZERO: Int = 18

const SEC: Int = 19

const SEC_ZERO: Int = 20

const PM_UP: Int = 21

const PM_LO: Int = 22

const TZ_NAME: Int = 23

const ISO_BASIC: Int = 24

const ISO_SECS: Int = 25

const ISO_SHORT: Int = 26

const ISO_COLON: Int = 27

const ISO_COLON_SECS: Int = 28

const NUM_BASIC: Int = 29

const NUM_SECS: Int = 30

const NUM_SHORT: Int = 31

const NUM_COLON: Int = 32

const NUM_COLON_SECS: Int = 33

const FRAC0: Int = 34

const FRAC9: Int = 35

/// The name tables are functions over Bytes literals: a package level List allocates at each use (gotchas/std-port-costly-go-idioms.md).
fn month_name(m: Int, long: Bool) -> Bytes {
  match m {
    1 => if long { b"January" } else { b"Jan" }
    2 => if long { b"February" } else { b"Feb" }
    3 => if long { b"March" } else { b"Mar" }
    4 => if long { b"April" } else { b"Apr" }
    5 => if long { b"May" } else { b"May" }
    6 => if long { b"June" } else { b"Jun" }
    7 => if long { b"July" } else { b"Jul" }
    8 => if long { b"August" } else { b"Aug" }
    9 => if long { b"September" } else { b"Sep" }
    10 => if long { b"October" } else { b"Oct" }
    11 => if long { b"November" } else { b"Nov" }
    _ => if long { b"December" } else { b"Dec" }
  }
}

/// Weekday d, Sunday 0.
fn day_name(d: Int, long: Bool) -> Bytes {
  match d {
    0 => if long { b"Sunday" } else { b"Sun" }
    1 => if long { b"Monday" } else { b"Mon" }
    2 => if long { b"Tuesday" } else { b"Tue" }
    3 => if long { b"Wednesday" } else { b"Wed" }
    4 => if long { b"Thursday" } else { b"Thu" }
    5 => if long { b"Friday" } else { b"Fri" }
    _ => if long { b"Saturday" } else { b"Sat" }
  }
}

/// Days before month m (1 to 13) of a common year.
fn days_before(m: Int) -> Int {
  match m {
    0 => 0
    1 => 31
    2 => 59
    3 => 90
    4 => 120
    5 => 151
    6 => 181
    7 => 212
    8 => 243
    9 => 273
    10 => 304
    11 => 334
    _ => 365
  }
}

fn at_is(b: Bytes, i: Int, p: Bytes) -> Bool {
  if i + p.len() > b.len() {
    return false
  }
  var k = 0
  while k < p.len() {
    if b[i + k] != p[k] {
      return false
    }
    k += 1
  }
  true
}

fn lower_at(b: Bytes, j: Int) -> Bool { j < b.len() && Int(b[j]) >= 97 && Int(b[j]) <= 122 }

fn digit_at(b: Bytes, j: Int) -> Bool { j >= 0 && j < b.len() && Int(b[j]) >= 48 && Int(b[j]) <= 57 }

/// The reference element at byte i of a layout: (kind, length, digits), kind -1 for none.
fn std_at(b: Bytes, i: Int) -> (Int, Int, Int) {
  let c = Int(b[i])
  if c == 74 {
    if at_is(b, i, b"Jan") {
      if at_is(b, i, b"January") {
        return (MONTH_LONG, 7, 0)
      }
      if !lower_at(b, i + 3) {
        return (MONTH_SHORT, 3, 0)
      }
    }
  } else if c == 77 {
    if at_is(b, i, b"Mon") {
      if at_is(b, i, b"Monday") {
        return (WD_LONG, 6, 0)
      }
      if !lower_at(b, i + 3) {
        return (WD_SHORT, 3, 0)
      }
    }
    if at_is(b, i, b"MST") {
      return (TZ_NAME, 3, 0)
    }
  } else if c == 48 {
    if i + 1 < b.len() && Int(b[i + 1]) >= 49 && Int(b[i + 1]) <= 54 {
      let d = Int(b[i + 1]) - 49
      let ks = [MONTH_ZERO, DAY_ZERO, HOUR12_ZERO, MIN_ZERO, SEC_ZERO, YEAR2]
      return (ks[d], 2, 0)
    }
    if at_is(b, i, b"002") {
      return (YDAY_ZERO, 3, 0)
    }
  } else if c == 49 {
    if i + 1 < b.len() && Int(b[i + 1]) == 53 {
      return (HOUR24, 2, 0)
    }
    return (MONTH_NUM, 1, 0)
  } else if c == 50 {
    if at_is(b, i, b"2006") {
      return (YEAR4, 4, 0)
    }
    return (DAY, 1, 0)
  } else if c == 95 {
    if i + 1 < b.len() && Int(b[i + 1]) == 50 {
      if at_is(b, i + 1, b"2006") {
        return (-1, 1, 0)
      }
      return (DAY_UNDER, 2, 0)
    }
    if at_is(b, i, b"__2") {
      return (YDAY_UNDER, 3, 0)
    }
  } else if c == 51 {
    return (HOUR12, 1, 0)
  } else if c == 52 {
    return (MIN, 1, 0)
  } else if c == 53 {
    return (SEC, 1, 0)
  } else if c == 80 {
    if at_is(b, i, b"PM") {
      return (PM_UP, 2, 0)
    }
  } else if c == 112 {
    if at_is(b, i, b"pm") {
      return (PM_LO, 2, 0)
    }
  } else if c == 45 {
    if at_is(b, i, b"-070000") {
      return (NUM_SECS, 7, 0)
    }
    if at_is(b, i, b"-07:00:00") {
      return (NUM_COLON_SECS, 9, 0)
    }
    if at_is(b, i, b"-0700") {
      return (NUM_BASIC, 5, 0)
    }
    if at_is(b, i, b"-07:00") {
      return (NUM_COLON, 6, 0)
    }
    if at_is(b, i, b"-07") {
      return (NUM_SHORT, 3, 0)
    }
  } else if c == 90 {
    if at_is(b, i, b"Z070000") {
      return (ISO_SECS, 7, 0)
    }
    if at_is(b, i, b"Z07:00:00") {
      return (ISO_COLON_SECS, 9, 0)
    }
    if at_is(b, i, b"Z0700") {
      return (ISO_BASIC, 5, 0)
    }
    if at_is(b, i, b"Z07:00") {
      return (ISO_COLON, 6, 0)
    }
    if at_is(b, i, b"Z07") {
      return (ISO_SHORT, 3, 0)
    }
  } else if c == 46 || c == 44 {
    if i + 1 < b.len() && (Int(b[i + 1]) == 48 || Int(b[i + 1]) == 57) {
      let ch = Int(b[i + 1])
      var j = i + 1
      while j < b.len() && Int(b[j]) == ch {
        j += 1
      }
      if !digit_at(b, j) {
        return (if ch == 48 { FRAC0 } else { FRAC9 }, j - i, j - (i + 1))
      }
    }
  }
  (-1, 1, 0)
}

fn put_int(out: BytesBuilder, n: Int, width: Int, pad: Int) -> BytesBuilder {
  var o = out
  var nd = 1
  var div = 1
  while n / div >= 10 {
    div = div * 10
    nd += 1
  }
  var k = nd
  while k < width {
    o.write_byte(UInt8.wrapping_from(pad))
    k += 1
  }
  while div > 0 {
    o.write_byte(UInt8.wrapping_from(48 + (n / div) % 10))
    div = div / 10
  }
  o
}

fn is_leap(y: Int) -> Bool { y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) }

fn days_in(m: Int, y: Int) -> Int {
  if m == 2 && is_leap(y) { 29 } else { days_before(m) - days_before(m - 1) }
}

fn yday_of(y: Int, m: Int, d: Int) -> Int {
  days_before(m - 1) + d + (if m > 2 && is_leap(y) { 1 } else { 0 })
}

fn put_zone(out: BytesBuilder, kind: Int, offset: Int) -> BytesBuilder {
  var o = out
  let iso = kind >= ISO_BASIC && kind <= ISO_COLON_SECS
  if offset == 0 && iso {
    o.write_byte(UInt8(90))
    return o
  }
  var zone = offset / 60
  var abs_off = offset
  if zone < 0 {
    o.write_byte(UInt8(45))
    zone = -zone
    abs_off = -abs_off
  } else {
    o.write_byte(UInt8(43))
  }
  o = put_int(o, zone / 60, 2, 48)
  let colon = kind == ISO_COLON || kind == NUM_COLON || kind == ISO_COLON_SECS || kind == NUM_COLON_SECS
  if colon {
    o.write_byte(UInt8(58))
  }
  if kind != NUM_SHORT && kind != ISO_SHORT {
    o = put_int(o, zone % 60, 2, 48)
  }
  if kind == ISO_SECS || kind == NUM_SECS || kind == NUM_COLON_SECS || kind == ISO_COLON_SECS {
    if kind == NUM_COLON_SECS || kind == ISO_COLON_SECS {
      o.write_byte(UInt8(58))
    }
    o = put_int(o, abs_off % 60, 2, 48)
  }
  o
}

fn perr(s: Str, go_layout: Str, at: Int, msg: Str) -> time.ParseErr {
  time.ParseErr{input: s, layout: go_layout, at: at, msg: msg}
}

/// A parse error that also carries what Go's text needs: kind 1 `cannot parse REST as ELEM`, 2 `extra text: REST`, 3 a message.
fn perr_go(s: Str, go_layout: Str, at: Int, msg: Str, kind: Int, elem: Str, rest: Str, go_msg: Str) -> time.ParseErr {
  time.ParseErr{input: s, layout: go_layout, at: at, msg: msg, go_kind: kind, go_elem: elem, go_rest: rest, go_msg: go_msg}
}

/// The reference text of a layout element (what Go quotes in `cannot parse "REST" as "ELEM"`).
fn elem_text(k: Int, lit: Str, n: Int) -> Str {
  match k {
    YEAR2 => "06"
    YEAR4 => "2006"
    MONTH_LONG => "January"
    MONTH_SHORT => "Jan"
    MONTH_NUM => "1"
    MONTH_ZERO => "01"
    WD_LONG => "Monday"
    WD_SHORT => "Mon"
    DAY => "2"
    DAY_UNDER => "_2"
    DAY_ZERO => "02"
    YDAY_UNDER => "__2"
    YDAY_ZERO => "002"
    HOUR24 => "15"
    HOUR12 => "3"
    HOUR12_ZERO => "03"
    MIN => "4"
    MIN_ZERO => "04"
    SEC => "5"
    SEC_ZERO => "05"
    PM_UP => "PM"
    PM_LO => "pm"
    TZ_NAME => "MST"
    ISO_BASIC => "Z0700"
    ISO_SECS => "Z070000"
    ISO_SHORT => "Z07"
    ISO_COLON => "Z07:00"
    ISO_COLON_SECS => "Z07:00:00"
    NUM_BASIC => "-0700"
    NUM_SECS => "-070000"
    NUM_SHORT => "-07"
    NUM_COLON => "-07:00"
    NUM_COLON_SECS => "-07:00:00"
    FRAC0 => lit + "0".repeat(n)
    FRAC9 => lit + "9".repeat(n)
    _ => lit
  }
}

/// Go's time.quote: `"`, `\` escaped, bytes below a space and non ASCII bytes as \xNN.
fn go_quote(s: Str) -> Str {
  var out = BytesBuilder.new()
  out.write_byte(UInt8(34))
  let b = s.bytes()
  let hex = "0123456789abcdef".bytes()
  for c in b {
    let n = Int(c)
    if n >= 128 || n < 32 {
      out.write_byte(UInt8(92))
      out.write_byte(UInt8(120))
      out.write_byte(hex[n / 16])
      out.write_byte(hex[n % 16])
    } else {
      if n == 34 || n == 92 {
        out.write_byte(UInt8(92))
      }
      out.write_byte(c)
    }
  }
  out.write_byte(UInt8(34))
  out.freeze().to_str_lossy()
}

/// The position in v where the literal lit stops matching from p0 (skip_lit's walk).
fn lit_fail_pos(v: Bytes, p0: Int, lit: Bytes) -> Int {
  var p = p0
  var k = 0
  while k < lit.len() {
    if Int(lit[k]) == 32 {
      if p < v.len() && Int(v[p]) != 32 {
        return p
      }
      while k < lit.len() && Int(lit[k]) == 32 {
        k += 1
      }
      while p < v.len() && Int(v[p]) == 32 {
        p += 1
      }
    } else {
      if p >= v.len() || v[p] != lit[k] {
        return p
      }
      p += 1
      k += 1
    }
  }
  p
}

fn lower_byte(c: Int) -> Int { if c >= 65 && c <= 90 { c + 32 } else { c } }

/// Go's lookup: the number of the month (1 to 12) or weekday (0 to 6) whose name v begins with at p (case insensitive), -1 for none.
fn lookup_name(month: Bool, long: Bool, v: Bytes, p: Int) -> Int {
  var i = if month { 1 } else { 0 }
  let end = if month { 13 } else { 7 }
  while i < end {
    let nb = if month { month_name(i, long) } else { day_name(i, long) }
    if p + nb.len() <= v.len() {
      var k = 0
      var ok = true
      while k < nb.len() {
        if lower_byte(Int(v[p + k])) != lower_byte(Int(nb[k])) {
          ok = false
          break
        }
        k += 1
      }
      if ok {
        return i
      }
    }
    i += 1
  }
  -1
}

/// Go's getnum: one or two digits (two when fixed): (value, next position), value -1 when bad.
fn getnum(v: Bytes, p: Int, fixed: Bool) -> (Int, Int) {
  if !digit_at(v, p) {
    return (-1, p)
  }
  if !digit_at(v, p + 1) {
    if fixed {
      return (-1, p)
    }
    return (Int(v[p]) - 48, p + 1)
  }
  ((Int(v[p]) - 48) * 10 + Int(v[p + 1]) - 48, p + 2)
}

fn getnum3(v: Bytes, p: Int, fixed: Bool) -> (Int, Int) {
  var n = 0
  var i = 0
  while i < 3 && digit_at(v, p + i) {
    n = n * 10 + Int(v[p + i]) - 48
    i += 1
  }
  if i == 0 || (fixed && i != 3) {
    return (-1, p)
  }
  (n, p + i)
}

fn digits_at(v: Bytes, p: Int, n: Int) -> Int {
  var x = 0
  var i = 0
  while i < n {
    if !digit_at(v, p + i) {
      return -1
    }
    x = x * 10 + Int(v[p + i]) - 48
    i += 1
  }
  x
}

fn comma_or_period(v: Bytes, p: Int) -> Bool { p < v.len() && (Int(v[p]) == 46 || Int(v[p]) == 44) }

/// Go's parseNanoseconds over nbytes at p (the separator included): nanoseconds, or -1.
fn parse_nanos(v: Bytes, p: Int, nbytes: Int) -> Int {
  var n = nbytes
  if n > 10 {
    n = 10
  }
  var ns = 0
  var i = 1
  while i < n {
    if !digit_at(v, p + i) {
      return -1
    }
    ns = ns * 10 + Int(v[p + i]) - 48
    i += 1
  }
  var scale = 10 - n
  while scale > 0 {
    ns = ns * 10
    scale -= 1
  }
  ns
}

/// Go's parseSignedOffset (a sign and a hour of at most 23): the length, 0 when none.
fn parse_signed_offset(v: Bytes, p: Int) -> Int {
  if p >= v.len() || (Int(v[p]) != 43 && Int(v[p]) != 45) {
    return 0
  }
  var x = 0
  var i = p + 1
  while digit_at(v, i) {
    x = x * 10 + Int(v[i]) - 48
    if x > 100000000 {
      return 0
    }
    i += 1
  }
  if i == p + 1 || x > 23 {
    return 0
  }
  i - p
}

/// Go's parseTimeZone: the length of a zone name at p, 0 when it is not one.
fn parse_zone_name(v: Bytes, p: Int) -> Int {
  if v.len() - p < 3 {
    return 0
  }
  if v.len() - p >= 4 && (at_is(v, p, b"ChST") || at_is(v, p, b"MeST")) {
    return 4
  }
  if at_is(v, p, b"GMT") {
    if v.len() - p == 3 {
      return 3
    }
    return 3 + parse_signed_offset(v, p + 3)
  }
  if Int(v[p]) == 43 || Int(v[p]) == 45 {
    return parse_signed_offset(v, p)
  }
  var up = 0
  while up < 6 && p + up < v.len() && Int(v[p + up]) >= 65 && Int(v[p + up]) <= 90 {
    up += 1
  }
  if up == 5 && Int(v[p + 4]) == 84 {
    return 5
  }
  if up == 4 && (Int(v[p + 3]) == 84 || at_is(v, p, b"WITA")) {
    return 4
  }
  if up == 3 {
    return 3
  }
  0
}

/// Whether the literal prefix of a layout matches at p (Go's skip: a space in the layout matches a run of spaces).
/// The next position, or -1.
fn skip_lit(v: Bytes, p0: Int, lit: Bytes) -> Int {
  var p = p0
  var k = 0
  while k < lit.len() {
    if Int(lit[k]) == 32 {
      if p < v.len() && Int(v[p]) != 32 {
        return -1
      }
      while k < lit.len() && Int(lit[k]) == 32 {
        k += 1
      }
      while p < v.len() && Int(v[p]) == 32 {
        p += 1
      }
    } else {
      if p >= v.len() || v[p] != lit[k] {
        return -1
      }
      p += 1
      k += 1
    }
  }
  p
}

/// Go's RFC 3339 fast path: the text of the two reference layouts when it is plain, otherwise a failure the general
/// parser then explains (as in Go, the result is the general parser's).
fn parse_rfc3339(v: Bytes, z: time.Zone) -> Time? {
  let n = v.len()
  if n < 20 || !digit_at(v, 0) || Int(v[4]) != 45 || Int(v[7]) != 45 || Int(v[10]) != 84 || Int(v[13]) != 58 || Int(v[16]) != 58 {
    return None
  }
  let year = digits_at(v, 0, 4)
  let month = digits_at(v, 5, 2)
  let day = digits_at(v, 8, 2)
  let hour = digits_at(v, 11, 2)
  let minute = digits_at(v, 14, 2)
  let sec = digits_at(v, 17, 2)
  if year < 0 || month < 1 || month > 12 || day < 1 || hour < 0 || hour > 23 || minute < 0 || minute > 59 || sec < 0 || sec > 59 {
    return None
  }
  if day > days_in(month, year) {
    return None
  }
  var p = 19
  var nsec = 0
  if Int(v[p]) == 46 {
    var q = p + 1
    while digit_at(v, q) {
      q += 1
    }
    if q == p + 1 {
      return None
    }
    nsec = parse_nanos(v, p, q - p)
    p = q
  }
  var off = 0
  if p == n - 1 && Int(v[p]) == 90 {
    off = 0
  } else if p == n - 6 && (Int(v[p]) == 43 || Int(v[p]) == 45) && Int(v[p + 3]) == 58 {
    let hh = digits_at(v, p + 1, 2)
    let mm = digits_at(v, p + 4, 2)
    if hh < 0 || mm < 0 || hh > 24 || mm > 60 {
      return None
    }
    off = (hh * 60 + mm) * 60
    if Int(v[p]) == 45 {
      off = -off
    }
  } else {
    return None
  }
  if year < 1678 || year > 2261 {
    return None
  }
  Some(unix_time(year, month, day, hour, minute, sec, nsec, off))
}

/// The instant of a civil time in UTC (year 1678 to 2261) less the offset, by Hinnant's days from civil.
fn unix_time(year: Int, month: Int, day: Int, hour: Int, minute: Int, sec: Int, nsec: Int, off: Int) -> Time {
  let y = if month <= 2 { year - 1 } else { year }
  let era = y / 400
  let yoe = y - era * 400
  let mp = if month > 2 { month - 3 } else { month + 9 }
  let doy = (153 * mp + 2) / 5 + day - 1
  let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
  let days = era * 146097 + doe - 719468
  Time.from_unix(days * 86400 + hour * 3600 + minute * 60 + sec - off) + Duration.from_nanos(nsec)
}
