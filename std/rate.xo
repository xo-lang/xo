// std/rate (spec/std.md 42, std survey gap 15).
// Encoding rules are listed at the top of std/prelude.xo. A token bucket
// rate limiter, golang.org/x/time/rate's Limiter: limit tokens a second
// fill a bucket of burst tokens, which starts full; an event takes n.
// The limiter holds the Clock it reads, so a test's virtual clock makes
// it deterministic.
//
// std/rate on the native backends and, through std/go_compiled.txt, on
// the Go backend (decision 0312): one source, golang.org/x/time/rate
// v0.16.0's rate.go (Copyright 2015 The Go Authors, BSD-style license)
// with the limiter's clock in place of the *At methods' times.

/// A limit that allows every event (rate.Inf).
pub const INF: Float = 1.7976931348623157e308

/// An instant as Go's Time keeps it: seconds from the Unix epoch and
/// nanoseconds, so it reaches the years past 2262 that a wait at a tiny
/// limit lands in (Xo's Time is Unix nanoseconds in an Int, Go's reaches
/// year 292277026596). Internal.
pub struct At {
  pub sec: Int
  pub ns: Int
}

/// A limiter's state. Internal: use the methods.
pub struct LimitState {
  pub limit: Float
  pub burst: Int
  pub tokens: Float
  pub last: At
  pub last_event: At
}

/// A token bucket: `limit` tokens a second, at most `burst` at once.
/// A handle: copies share the bucket, and tasks may use it at once.
pub struct Limiter {
  pub st: Mutex[LimitState]
  pub clock: Clock
}

/// The tokens an event reserved and when it may happen (rate.Reservation).
pub struct Reservation {
  pub ok: Bool
  pub lim: Limiter
  pub tokens: Int
  /// When the event may happen, held to Xo's Time range (`act` is exact).
  pub time_to_act: Time
  pub limit: Float
  pub act: At
}

/// Why wait failed.
pub open enum RateErr {
  /// n is more than the burst (and the limit is not INF).
  Exceeds(n: Int, burst: Int)
  /// The task was cancelled while waiting; the tokens went back.
  Canceled
}

/// `rate: Wait(n=5) exceeds limiter's burst 3`, `rate: canceled`.
pub fn (e: RateErr) display() -> Str {
  match e {
    RateErr.Exceeds(n, burst) => "rate: Wait(n=${n}) exceeds limiter's burst ${burst}"
    RateErr.Canceled => "rate: canceled"
  }
}

/// A limiter of limit tokens a second and a bucket of burst, full
/// (rate.NewLimiter); limit 0 with burst 0 allows nothing, INF everything.
pub fn new(limit: Float, burst: Int, clock: Clock) -> Limiter {
  // Go's zero Time, year 1, is where a new limiter's times start
  let st = LimitState{limit: limit, burst: burst, tokens: Float(burst), last: go_zero(), last_event: go_zero()}
  Limiter{st: Mutex[LimitState].new(st), clock: clock}
}

/// The limit of one token per interval (rate.Every; INF for 0 or less).
pub fn every(interval: Duration) -> Float {
  if interval <= 0s {
    return INF
  }
  1.0 / interval.seconds()
}

pub fn (l: Limiter) limit() -> Float { l.st.with_read(fn(s: LimitState) { s.limit }) }

pub fn (l: Limiter) burst() -> Int { l.st.with_read(fn(s: LimitState) { s.burst }) }

/// The tokens in the bucket now (negative while reservations wait).
pub fn (l: Limiter) tokens() -> Float uses clock {
  let t = at_of(l.clock.now())
  l.st.with_read(fn(s: LimitState) { advance(s, t) })
}

/// Whether one event may happen now; takes its token if so (rate.Allow).
pub fn (l: Limiter) allow() -> Bool uses clock { allow_at(l, l.clock.now(), 1) }

/// Whether n events may happen now; takes n tokens if so.
pub fn (l: Limiter) allow_n(n: Int) -> Bool uses clock { allow_at(l, l.clock.now(), n) }

/// Reserves a token for an event: act after `delay()`, or `cancel()` to
/// give the token back (rate.Reserve). Not ok when n is over the burst.
pub fn (l: Limiter) reserve() -> Reservation uses clock { reserve_at(l, l.clock.now(), 1, inf_duration()) }

pub fn (l: Limiter) reserve_n(n: Int) -> Reservation uses clock { reserve_at(l, l.clock.now(), n, inf_duration()) }

/// Sleeps on the clock until one event may happen (rate.Wait).
pub fn (l: Limiter) wait() -> () ! RateErr uses clock { l.wait_n(1) }

/// Sleeps until n events may happen; Exceeds when n is over the burst.
pub fn (l: Limiter) wait_n(n: Int) -> () ! RateErr uses clock {
  let (burst, limit) = l.st.with_read(fn(s: LimitState) { (s.burst, s.limit) })
  if n > burst && limit != INF {
    return Err(RateErr.Exceeds(n: n, burst: burst))
  }
  let t = l.clock.now()
  let r = reserve_at(l, t, n, inf_duration())
  let d = delay_from(r, t)
  if d == 0s {
    return
  }
  match l.clock.sleep_or_cancel(d) {
    Ok(_) => ()
    Err(_) => {
      cancel_at(r, l.clock.now())
      return Err(RateErr.Canceled)
    }
  }
}

/// Changes the limit, the tokens so far kept (rate.SetLimit).
pub fn (l: Limiter) set_limit(limit: Float) uses clock {
  let t = at_of(l.clock.now())
  l.st.with(fn(var s: LimitState) {
    s.tokens = advance(s, t)
    s.last = t
    s.limit = limit
  })
}

/// Changes the burst (rate.SetBurst).
pub fn (l: Limiter) set_burst(burst: Int) uses clock {
  let t = at_of(l.clock.now())
  l.st.with(fn(var s: LimitState) {
    s.tokens = advance(s, t)
    s.last = t
    s.burst = burst
  })
}

/// False when the limiter can never allow the event (n over the burst).
pub fn (r: Reservation) ok() -> Bool { r.ok }

/// How long to wait before acting: 0 when now is fine; the longest
/// Duration when not ok.
pub fn (r: Reservation) delay() -> Duration uses clock { delay_from(r, r.lim.clock.now()) }

/// Gives back the reservation's tokens, as far as later reservations
/// have not counted on them (rate.CancelAt).
pub fn (r: Reservation) cancel() uses clock { cancel_at(r, r.lim.clock.now()) }

const MAX_NANOS: Int = Int.max

fn inf_duration() -> Duration { Duration.from_nanos(MAX_NANOS) }

/// Go's zero Time (January 1, year 1, UTC) from the Unix epoch.
fn go_zero() -> At { At{sec: -62135596800, ns: 0} }

/// t as an At.
fn at_of(t: Time) -> At {
  let n = t.unix_nanos()
  var sec = n / 1000000000
  var ns = n % 1000000000
  if ns < 0 {
    sec -= 1
    ns += 1000000000
  }
  At{sec: sec, ns: ns}
}

/// a as a Time, held to Xo's range: Reservation.time_to_act.
fn time_of(a: At) -> Time {
  // Xo's Time covers Unix seconds -9223372036 to 9223372036 (and a part)
  if a.sec >= 9223372036 {
    return Time.UNIX_EPOCH + inf_duration()
  }
  if a.sec <= -9223372036 {
    return Time.UNIX_EPOCH - inf_duration()
  }
  Time.from_unix_nanos(a.sec * 1000000000 + a.ns)
}

/// a + d (Go's Time.Add).
fn add(a: At, d: Duration) -> At {
  let n = d.nanos()
  var sec = a.sec + n / 1000000000
  var ns = a.ns + n % 1000000000
  if ns >= 1000000000 {
    sec += 1
    ns -= 1000000000
  } else if ns < 0 {
    sec -= 1
    ns += 1000000000
  }
  At{sec: sec, ns: ns}
}

/// a - b, the longest Duration either way when it does not fit (Go's
/// Time.Sub).
fn sub(a: At, b: At) -> Duration {
  // 9223372036 seconds and 854775807 ns is Int.max nanoseconds
  let ds = a.sec - b.sec
  let dn = a.ns - b.ns
  if ds > 9223372037 {
    return inf_duration()
  }
  if ds < -9223372037 {
    return Duration.from_nanos(Int.min)
  }
  if ds >= 9223372036 {
    let extra = (ds - 9223372036) * 1000000000 + dn
    if extra > 854775807 {
      return inf_duration()
    }
    return Duration.from_nanos(9223372036000000000 + extra)
  }
  if ds <= -9223372036 {
    let extra = (ds + 9223372036) * 1000000000 + dn
    if extra < -854775808 {
      return Duration.from_nanos(Int.min)
    }
    return Duration.from_nanos(-9223372036000000000 + extra)
  }
  Duration.from_nanos(ds * 1000000000 + dn)
}

fn before(a: At, b: At) -> Bool { a.sec < b.sec || (a.sec == b.sec && a.ns < b.ns) }

/// a - b for Sometimes, as Go's time.Since.
fn sub_sat(a: Time, b: Time) -> Duration { sub(at_of(a), at_of(b)) }

fn delay_from(r: Reservation, t: Time) -> Duration {
  if !r.ok {
    return inf_duration()
  }
  let d = sub(r.act, at_of(t))
  if d < 0s {
    return 0s
  }
  d
}

// CancelAt
fn cancel_at(r: Reservation, t0: Time) {
  if !r.ok {
    return
  }
  let t = at_of(t0)
  r.lim.st.with(fn(var s: LimitState) {
    if s.limit == INF || r.tokens == 0 || before(r.act, t) {
      return
    }
    let restore = Float(r.tokens) - tokens_from_duration(r.limit, sub(s.last_event, r.act))
    if restore <= 0.0 {
      return
    }
    var tokens = advance(s, t) + restore
    if tokens > Float(s.burst) {
      tokens = Float(s.burst)
    }
    s.last = t
    s.tokens = tokens
    if r.act.sec == s.last_event.sec && r.act.ns == s.last_event.ns {
      let prev = add(r.act, duration_from_tokens(r.limit, -Float(r.tokens)))
      if !before(prev, t) {
        s.last_event = prev
      }
    }
  })
}

// AllowN: reserveN with no wait, as a Bool: no Reservation is built (it
// holds the limiter), the common call of a request path.
fn allow_at(l: Limiter, t0: Time, n: Int) -> Bool {
  let t = at_of(t0)
  l.st.with(fn(var s: LimitState) -> Bool {
    if s.limit == INF {
      return true
    }
    let tokens = advance(s, t) - Float(n)
    var wait = 0s
    if tokens < 0.0 {
      wait = duration_from_tokens(s.limit, -tokens)
    }
    if n > s.burst || wait > 0s {
      return false
    }
    s.last = t
    s.tokens = tokens
    s.last_event = add(t, wait)
    true
  })
}

// reserveN
fn reserve_at(l: Limiter, t0: Time, n: Int, max_future: Duration) -> Reservation {
  let t = at_of(t0)
  l.st.with(fn(var s: LimitState) -> Reservation {
    if s.limit == INF {
      return Reservation{ok: true, lim: l, tokens: n, time_to_act: t0, limit: 0.0, act: t}
    }
    let tokens = advance(s, t) - Float(n)
    var wait = 0s
    if tokens < 0.0 {
      wait = duration_from_tokens(s.limit, -tokens)
    }
    let ok = n <= s.burst && wait <= max_future
    if !ok {
      return Reservation{ok: false, lim: l, tokens: 0, time_to_act: Time.UNIX_EPOCH, limit: s.limit, act: go_zero()}
    }
    let act = add(t, wait)
    s.last = t
    s.tokens = tokens
    s.last_event = act
    Reservation{ok: true, lim: l, tokens: n, time_to_act: time_of(act), limit: s.limit, act: act}
  })
}

// advance: the tokens at t, not stored
fn advance(s: LimitState, t: At) -> Float {
  let last = if before(t, s.last) { t } else { s.last }
  let tokens = s.tokens + tokens_from_duration(s.limit, sub(t, last))
  if tokens > Float(s.burst) {
    return Float(s.burst)
  }
  tokens
}

/// Go's durationFromTokens: a float64 past Int.min converts to Int.min
/// (arm64 and amd64 alike), one past Int.max is InfDuration.
fn duration_from_tokens(limit: Float, tokens: Float) -> Duration {
  if limit <= 0.0 {
    return inf_duration()
  }
  let ns = (tokens / limit) * 1e9
  if ns >= 9.223372036854775807e18 {
    return inf_duration()
  }
  if ns <= -9.223372036854775807e18 {
    return Duration.from_nanos(Int.min)
  }
  Duration.from_nanos(Int(ns))
}

fn tokens_from_duration(limit: Float, d: Duration) -> Float {
  if limit <= 0.0 {
    return 0.0
  }
  d.seconds() * limit
}

/// Sometimes's state. Internal: use `do`.
pub struct SometimesState {
  pub count: Int
  pub last: Time
}

/// An action run only sometimes (rate.Sometimes, x/time v0.16.0
/// sometimes.go): `do` runs it on the first call, on each of the first
/// `first` calls, on every `every`th call, and when `interval` has passed
/// on the clock since it last ran; with none set it runs once, as Go's
/// zero value does (a sync.Once). A handle: copies share the count, and
/// tasks may call `do` at once (one runs the action at a time).
pub struct Sometimes {
  pub first: Int
  pub every: Int
  pub interval: Duration
  pub st: Mutex[SometimesState]
  pub clock: Clock
}

/// A Sometimes reading `clock` for `interval` (rate.Sometimes{First,
/// Every, Interval}); 0 leaves a rule off.
pub fn sometimes(clock: Clock, first: Int = 0, every: Int = 0, interval: Duration = 0s) -> Sometimes {
  Sometimes{first: first, every: every, interval: interval, st: Mutex[SometimesState].new(SometimesState{count: 0, last: Time.UNIX_EPOCH}), clock: clock}
}

/// Runs f when one of the Sometimes's rules says so (Sometimes.Do), and
/// counts the call either way.
pub fn (s: Sometimes) do[fx: Effects](f: fn() uses fx) uses (clock, fx) {
  s.st.with(fn(var st: SometimesState) uses (clock, fx, sync) {
    if st.count == 0 || (s.first > 0 && st.count < s.first) || (s.every > 0 && st.count % s.every == 0) || (s.interval > 0s && sub_sat(s.clock.now(), st.last) >= s.interval) {
      f()
      if s.interval > 0s {
        st.last = s.clock.now()
      }
    }
    st.count += 1
  })
}
