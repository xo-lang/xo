// std/sql (spec/std.md 10). SQL databases through drivers: the in-memory
// one, Postgres and those written in Xo, with parameters, rows and
// transactions (Go's database/sql). Declaration file; encoding rules are
// listed at the top of std/prelude.xo. Notes for this file:
//
// - Db, Tx, and Row are opaque handles (empty structs).
// - Every operation on a Db or Tx declares `uses net.dial`: a Db may be backed
//   by a network driver. Db, Tx and Rows also carry their driver's effects
//   (`fx`, decision 0534): a driver that opens files (std/sqlite) is a
//   `Driver[fs]`, and its Db's operations perform fs too. Postgres and the
//   in memory driver add none. Code that names `Db` without an effect
//   argument gets it as an implicit effect variable (core 6.2). The in memory driver (`memory`) performs no I/O but
//   keeps the same signatures, so code under test is typed like production
//   code. Opening the in memory driver needs no capability.
// - Network drivers are written in Xo (decision 0278): `open` knows
//   "postgres" natively, and other drivers implement Driver and are opened
//   with `open_driver`.
use std/json
use std/time
use std/uuid
use std/netip

/// A query parameter. `$1` is `args[0]`.
enum SqlValue {
  Null
  Integer(n: Int)
  Text(s: Str)
  Real(f: Float)
  Flag(b: Bool)
  At(t: Time)
  /// bytea and BLOB columns (decision 0278).
  Blob(b: Bytes)
  /// json and jsonb columns: the JSON text.
  JsonText(s: Str)
  /// A one dimensional array (Postgres `int8[]`, `text[]`, ...).
  Array(items: List[SqlValue])
}

fn null() -> SqlValue
fn int(n: Int) -> SqlValue
fn str(s: Str) -> SqlValue
fn float(f: Float) -> SqlValue
fn bool(b: Bool) -> SqlValue
fn time(t: Time) -> SqlValue
fn bytes(b: Bytes) -> SqlValue
/// JsonText of `json.encode_str(v)`.
fn json[T: Json](v: T) -> SqlValue
fn array(items: List[SqlValue]) -> SqlValue
/// Parameters of the Postgres types the typed readers read (decision
/// 0679), sent as their Postgres text, which the server parses by the
/// parameter's type: `uuid` its canonical text, `date` ISO (`0044-03-15
/// BC` for year -43), `time_of_day` `HH:MM:SS.ffffff`, `interval` its
/// months, days and microseconds, `prefix` its text (an inet or cidr).
fn uuid(u: uuid.Uuid) -> SqlValue
fn date(d: time.Date) -> SqlValue
fn time_of_day(t: time.ClockTime) -> SqlValue
fn interval(i: Interval) -> SqlValue
fn prefix(p: netip.Prefix) -> SqlValue
/// A macaddr or macaddr8 parameter: 6 or 8 bytes as `08:00:2b:01:02:03`.
fn mac(b: Bytes) -> SqlValue
/// An hstore parameter: `"k"=>"v", "n"=>NULL`, quotes and backslashes
/// escaped.
fn hstore(m: Map[Str, Str?]) -> SqlValue
/// A date or timestamp parameter that may be infinite: `infinity`,
/// `-infinity`, or the finite value's text.
fn date_bound(b: Bound[time.Date]) -> SqlValue
fn time_bound(b: Bound[Time]) -> SqlValue

/// A date or time that may be infinite (Postgres's `infinity` and
/// `-infinity`; pgx's InfinityModifier, decision 0679).
enum Bound[T] {
  Finite(v: T)
  Infinity
  NegInfinity
}

/// A Postgres interval (pgx's pgtype.Interval, decision 0679): months,
/// days and microseconds apart, as Postgres keeps them (a month is not a
/// fixed number of days, nor a day of hours across a DST change).
struct Interval {
  months: Int
  days: Int
  micros: Int
} derive Eq
/// The interval as a Duration when it has no months and no days.
fn (i: Interval) duration() -> Duration?
/// An SQL identifier in double quotes, a double quote doubled (Postgres's
/// quote_ident, pgx's Identifier.Sanitize).
fn quote_ident(name: Str) -> Str

/// A transaction's isolation level (Go's sql.IsolationLevel, the four of
/// standard SQL); Default is the server's own.
enum Isolation {
  Default
  ReadUncommitted
  ReadCommitted
  RepeatableRead
  Serializable
}

enum SqlErr {
  Syntax(msg: Str)
  /// A key, uniqueness, NOT NULL, check, or type violation: code is the
  /// SQLSTATE (`23505` unique, `23503` foreign key, `23502` not null,
  /// `23514` check, `42804` a value of another type), name the
  /// constraint's ("" when there is none).
  Constraint(msg: Str, code: Str, name: Str)
  /// The number of arguments does not match the placeholders.
  Param(msg: Str)
  NoTable(name: Str)
  /// `query_one` found no row.
  NoRows
  /// A row accessor named a column the row does not have.
  NoColumn(name: Str)
  /// A row accessor of the wrong type, or a NULL read by a non optional one.
  Mismatch(column: Str, msg: Str)
  Conn(msg: Str)
  Driver(msg: Str)
  /// Any other error the server reports with an SQLSTATE code.
  Server(code: Str, msg: Str)
  /// The transaction was already committed or rolled back.
  TxDone
  Closed
  Canceled
}

/// Plain text (decision 0358): `syntax error: MSG`, MSG for a Constraint,
/// Param or Driver, `no such table: NAME`, `no rows in result set`,
/// `no such column: NAME`, `column COL: MSG`, `connection: MSG`,
/// `MSG (SQLSTATE CODE)`, `transaction already committed or rolled back`,
/// `database is closed`, `canceled`.
fn (e: SqlErr) display() -> Str

struct ExecResult {
  rows_affected: Int
  /// The last generated integer key (0 when the driver has none).
  last_insert_id: Int
}

struct Db[fx: Effects] {}
struct Tx[fx: Effects] {}
struct Row {}
/// A result read row by row (decision 0479, Go's *sql.Rows): holds a
/// connection from `rows` to the last row or `close`.
struct Rows[fx: Effects] {}
/// A prepared statement (decision 0648 item 6, Go's *sql.Stmt): made by
/// `Db.prepare` or `Tx.prepare`, run any number of times with arguments.
/// A Db's statement prepares again on each pool connection it runs on.
struct Stmt[fx: Effects] {}

/// One result set of `query_all` (Go's Rows.NextResultSet), or one
/// query's result in a `batch` or `pipeline`.
struct ResultSet {}

/// One query of a batch (pgx's QueuedQuery, decision 0648 item 15): one
/// statement and its arguments.
struct BatchQuery {
  query: Str
  args: List[SqlValue] = []
}

/// One connection held from the pool (decision 0648 item 14, Go's *sql.Conn,
/// pgxpool's *Conn from Acquire): every call runs on the same connection,
/// so session state (SET, temporary tables, LISTEN) stays from one call to
/// the next. It holds a `max_open` permit until `close`, which gives the
/// connection back; use `defer c.close()`. On the in memory database a
/// Conn runs on the Db. Used by one task at a time, as pgx's Conn.
struct Conn[fx: Effects] {}

/// A NOTIFY on a channel the connection LISTENs to (pgconn.Notification):
/// the notifying backend's process id, the channel and the payload.
struct Notification {
  pid: Int
  channel: Str
  payload: Str
}

/// A message the server sends besides a result (pgconn.Notice: Postgres's
/// NoticeResponse, a RAISE NOTICE or a WARNING): severity is the
/// unlocalized one ("NOTICE", "WARNING", ...), code the SQLSTATE.
struct Notice {
  severity: Str
  code: Str
  message: Str
  detail: Str = ""
  hint: Str = ""
}

/// A pool's counts (decision 0648 item 16; Go's DB.Stats and sql.DBStats,
/// pgxpool's Pool.Stat). On the in memory database every count is 0.
struct PoolStats {
  max_open: Int
  /// Connections open: in use, idle, and being connected.
  open: Int
  /// Taken by an operation, a transaction, a Conn or a cursor.
  in_use: Int
  idle: Int
  connecting: Int
  /// Permits taken (pgxpool's AcquireCount) and the time they took,
  /// connecting included (AcquireDuration).
  acquire_count: Int
  acquire_time: Duration
  /// Acquires that found every permit taken and waited (Go's WaitCount,
  /// pgxpool's EmptyAcquireCount), counted as the wait starts, and the
  /// total of the waits that ended.
  wait_count: Int
  wait_time: Duration
  /// Waits ended by a cancellation.
  canceled_acquire_count: Int
  new_conns: Int
  /// Connections closed because max_idle were idle already, and because
  /// they reached max_lifetime.
  max_idle_closed: Int
  max_lifetime_closed: Int
}

/// What a TraceRecord is of (decision 0648 item 16; pgx's QueryTracer,
/// BatchTracer, CopyFromTracer, PrepareTracer and ConnectTracer,
/// pgxpool's AcquireTracer and ReleaseTracer).
enum TraceOp {
  /// A new pool connection.
  Connect
  /// A connection taken from the pool (waiting for a permit included).
  Acquire
  /// A connection given back.
  Release
  /// query, rows (to the cursor's end or close), query_one, query_all, a
  /// Stmt's query.
  Query
  /// exec, a Stmt's exec, and BEGIN, COMMIT and ROLLBACK (as pgx traces
  /// them).
  Exec
  Prepare
  /// One query of a batch or pipeline, after the driver returned (pgx's
  /// TraceBatchQuery), before the batch's own record.
  BatchQuery
  /// A batch or pipeline.
  Batch
  CopyFrom
}

/// One traced operation of a pool connection, given to open's `on_trace`
/// when it ends: `query` is the statement (CopyFrom's table, "" for
/// Connect, Acquire, Release and Batch), `rows_affected` the count (the
/// rows read for a Query), `err` its error. `start_ns` is when it started
/// (Unix nanoseconds, std/trace's Span.start_ns) and `elapsed` how long it
/// took.
struct TraceRecord {
  op: TraceOp
  query: Str = ""
  args: List[SqlValue] = []
  rows_affected: Int = 0
  err: SqlErr? = None
  start_ns: Int = 0
  elapsed: Duration = 0s
}

/// Opens a database: "postgres" (decision 0278; `roots` is PEM for
/// sslmode verify-ca and verify-full) and "mysql" (decision 0648; `roots`
/// for tls=true and tls=custom) natively. `max_open` bounds concurrent
/// operations and open transactions (waiting is a cancellation point),
/// `max_idle` and `max_lifetime` are passed to the driver. `loc` is
/// MySQL's zone for DATE, DATETIME and TIMESTAMP (go-sql-driver's Loc; the
/// DSN's `loc`, when it has one, must name it); a zone other than UTC is
/// refused for any other driver. `server_pub_key` is MySQL's RSA key (PEM,
/// go-sql-driver's RegisterServerPubKey) for full authentication over
/// plain TCP; refused for any other driver. `on_notice` is called with
/// each notice the server sends, in order, after the operation that
/// received it (pgconn's OnNotice; a driver's `DriverConn.notices`).
/// `on_trace` is called with a TraceRecord as each traced operation ends
/// (pgx's tracers; decision 0648 item 16); like on_notice it is pure and
/// keeps records through a Mutex or a Chan.
fn open(net: Net, driver: Str, dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m, roots: Bytes = b"", loc: time.Zone = time.utc(), server_pub_key: Bytes = b"", on_notice: (fn(Notice) uses sync)? = None, on_trace: (fn(TraceRecord) uses sync)? = None) -> Db ! SqlErr uses net.dial
/// An in memory database, optionally created with `schema` (`;` separated
/// statements). Needs no capability.
fn memory(schema: Str = "") -> Db ! SqlErr

fn (d: Db) query(q: Str, args: List[SqlValue] = []) -> List[Row] ! SqlErr uses net.dial
/// `query` as a cursor: the rows are read from the connection as `next`
/// asks (the Postgres driver; the in memory database and the Go backend
/// read the result whole), so a result larger than memory can be walked.
/// The connection stays taken until `next` returns None or an error, or
/// `close`; use `each` or `defer rows.close()`.
fn (d: Db) rows(q: Str, args: List[SqlValue] = []) -> Rows ! SqlErr uses net.dial
/// `rows`, calling f on each row and closing in every path; an error from
/// f ends the walk and is returned.
fn (d: Db) each(q: Str, args: List[SqlValue], f: fn(Row) -> () ! SqlErr uses sync) -> () ! SqlErr uses net.dial
/// Loads rows with COPY FROM STDIN in the text format (decision 0479, pgx's
/// CopyFrom): `rows` is called until it returns None, each row a list of
/// values in the order of `columns`; the result is the number of rows
/// copied. An error from `rows` cancels the COPY (the server rolls it
/// back) and is returned. `table` and `columns` are identifiers, quoted by
/// the driver (`quote_ident`); values are never interpolated. The in
/// memory database inserts the rows one by one; a driver without COPY
/// returns Driver.
fn (d: Db) copy_from(table: Str, columns: List[Str], rows: fn() -> List[SqlValue]? ! SqlErr uses sync) -> Int ! SqlErr uses net.dial
fn (d: Db) query_one(q: Str, args: List[SqlValue] = []) -> Row ! SqlErr uses net.dial
fn (d: Db) exec(q: Str, args: List[SqlValue] = []) -> ExecResult ! SqlErr uses net.dial
/// `query` with every row decoded into `T` (`derive SqlRow`, std.md 10.4).
fn (d: Db) query_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> List[T] ! SqlErr uses net.dial
/// `query_one` with the row decoded into `T`.
fn (d: Db) query_one_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> T ! SqlErr uses net.dial
/// A transaction (Go's DB.BeginTx): isolation and read_only are Go's
/// sql.TxOptions. A driver's connection gets `SET TRANSACTION ...` with
/// them right after BEGIN (nothing for the defaults); the in memory
/// database is serializable whatever the level, and refuses a write in a
/// read only transaction with Server("25006", ...), as Postgres does.
/// `deferrable` adds DEFERRABLE (pgx's TxOptions.DeferrableMode; Postgres
/// uses it for a serializable read only transaction, MySQL's server
/// refuses it; the in memory database ignores it).
fn (d: Db) begin(isolation: Isolation = Isolation.Default, read_only: Bool = false, deferrable: Bool = false) -> Tx ! SqlErr uses net.dial
/// Prepares q (Go's DB.Prepare): on one pool connection now, so a syntax
/// error is the call's, and on each other connection the statement first
/// runs on. A driver whose `DriverConn.prepare` returns None, and the in
/// memory database, run the text each time.
fn (d: Db) prepare(q: Str) -> Stmt ! SqlErr uses net.dial
/// Every result set of q (decision 0648 item 7): a `;` separated script
/// (MySQL's multiStatements=true, Postgres's simple query, the in memory
/// database's statements) gives one set per statement that returns rows;
/// statements without rows run and give none. The first error is the
/// call's.
fn (d: Db) query_all(q: Str, args: List[SqlValue] = []) -> List[ResultSet] ! SqlErr uses net.dial
/// Sends the queries at once and reads their results in order (pgx's
/// SendBatch, decision 0648 item 15): Postgres gets them in one round trip
/// (a pipeline with one Sync), other drivers one by one on one connection.
/// One ResultSet per query, in order: its rows (none for a statement
/// without) and `rows_affected`. Each query is one statement. The batch is
/// atomic: it runs as one transaction (Postgres's implicit transaction,
/// BEGIN and COMMIT on a driver that runs the queries one by one, a copy
/// of the tables on the in memory database), so an error rolls back the queries before it, and the
/// first error is the call's. An empty batch sends nothing.
fn (d: Db) batch(queries: List[BatchQuery]) -> List[ResultSet] ! SqlErr uses net.dial
/// Several batches at once on one connection (pgconn's Pipeline, a Sync
/// after each batch): each is atomic as `batch`, and a failed one does not
/// stop the ones after it. The result per batch is its sets or its first
/// error; the call's own error is a connection failure or Canceled.
fn (d: Db) pipeline(batches: List[List[BatchQuery]]) -> List[Result[List[ResultSet], SqlErr]] ! SqlErr uses net.dial
fn (d: Db) ping() -> () ! SqlErr uses net.dial
fn (d: Db) close() -> () ! SqlErr
/// The pool's counts now (Go's DB.Stats, pgxpool's Pool.Stat).
fn (d: Db) stats() -> PoolStats
/// Takes one connection from the pool and holds it (Go's DB.Conn, pgxpool's
/// Acquire); waiting for a permit is a cancellation point.
fn (d: Db) conn() -> Conn ! SqlErr uses net.dial

fn (c: Conn) query(q: Str, args: List[SqlValue] = []) -> List[Row] ! SqlErr uses net.dial
/// `Db.rows` on the connection: it is busy until the cursor ends or is
/// closed.
fn (c: Conn) rows(q: Str, args: List[SqlValue] = []) -> Rows ! SqlErr uses net.dial
fn (c: Conn) each(q: Str, args: List[SqlValue], f: fn(Row) -> () ! SqlErr uses sync) -> () ! SqlErr uses net.dial
fn (c: Conn) copy_from(table: Str, columns: List[Str], rows: fn() -> List[SqlValue]? ! SqlErr uses sync) -> Int ! SqlErr uses net.dial
fn (c: Conn) query_one(q: Str, args: List[SqlValue] = []) -> Row ! SqlErr uses net.dial
fn (c: Conn) exec(q: Str, args: List[SqlValue] = []) -> ExecResult ! SqlErr uses net.dial
fn (c: Conn) query_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> List[T] ! SqlErr uses net.dial
fn (c: Conn) query_one_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> T ! SqlErr uses net.dial
/// A transaction on the connection (Db.begin's options); the connection
/// stays the Conn's when it ends.
fn (c: Conn) begin(isolation: Isolation = Isolation.Default, read_only: Bool = false, deferrable: Bool = false) -> Tx ! SqlErr uses net.dial
/// Prepares q on the connection (Go's Conn.PrepareContext); the statement
/// is closed when the Conn is.
fn (c: Conn) prepare(q: Str) -> Stmt ! SqlErr uses net.dial
fn (c: Conn) query_all(q: Str, args: List[SqlValue] = []) -> List[ResultSet] ! SqlErr uses net.dial
/// `Db.batch` on the connection.
fn (c: Conn) batch(queries: List[BatchQuery]) -> List[ResultSet] ! SqlErr uses net.dial
/// `Db.pipeline` on the connection.
fn (c: Conn) pipeline(batches: List[List[BatchQuery]]) -> List[Result[List[ResultSet], SqlErr]] ! SqlErr uses net.dial
fn (c: Conn) ping() -> () ! SqlErr uses net.dial
/// `LISTEN channel` with the name quoted (quote_ident): NOTIFYs on it are
/// kept on the connection for `wait_notification`.
fn (c: Conn) listen(channel: Str) -> () ! SqlErr uses net.dial
/// `UNLISTEN channel`, quoted as `listen`.
fn (c: Conn) unlisten(channel: Str) -> () ! SqlErr uses net.dial
/// The next notification (pgx's Conn.WaitForNotification): one received
/// during an earlier call first, else a wait for the server. The wait is a
/// cancellation point that leaves the connection usable; a timeout is the
/// caller's (`task.with_timeout`). Driver for a driver without
/// LISTEN/NOTIFY and on the in memory database.
fn (c: Conn) wait_notification() -> Notification ! SqlErr uses net.dial
/// Gives the connection back to the pool (pgxpool's Conn.Release), after
/// `UNLISTEN *` when the Conn listened; later calls return Closed (Go's
/// ErrConnDone; as a closed Stmt's, not a new variant that would break an
/// exhaustive match).
/// Idempotent.
fn (c: Conn) close() uses net.dial

fn (t: Tx) query(q: Str, args: List[SqlValue] = []) -> List[Row] ! SqlErr uses net.dial
/// `Db.rows` inside the transaction: the transaction's connection is
/// busy until the cursor ends or is closed.
fn (t: Tx) rows(q: Str, args: List[SqlValue] = []) -> Rows ! SqlErr uses net.dial
fn (t: Tx) each(q: Str, args: List[SqlValue], f: fn(Row) -> () ! SqlErr uses sync) -> () ! SqlErr uses net.dial
fn (t: Tx) copy_from(table: Str, columns: List[Str], rows: fn() -> List[SqlValue]? ! SqlErr uses sync) -> Int ! SqlErr uses net.dial
fn (t: Tx) query_one(q: Str, args: List[SqlValue] = []) -> Row ! SqlErr uses net.dial
fn (t: Tx) exec(q: Str, args: List[SqlValue] = []) -> ExecResult ! SqlErr uses net.dial
fn (t: Tx) query_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> List[T] ! SqlErr uses net.dial
fn (t: Tx) query_one_as[T: SqlRow](q: Str, args: List[SqlValue] = []) -> T ! SqlErr uses net.dial
/// Prepares q on the transaction's connection (Go's Tx.Prepare); the
/// statement is closed when the transaction ends, and later runs return
/// TxDone.
fn (t: Tx) prepare(q: Str) -> Stmt ! SqlErr uses net.dial
fn (t: Tx) query_all(q: Str, args: List[SqlValue] = []) -> List[ResultSet] ! SqlErr uses net.dial
/// `Db.batch` inside the transaction (pgxpool's Tx.SendBatch): the queries
/// before a failing one stay in the transaction, which Postgres then
/// refuses to go on with (SQLSTATE 25P02) until a rollback; on the in
/// memory database a failed batch changes nothing.
fn (t: Tx) batch(queries: List[BatchQuery]) -> List[ResultSet] ! SqlErr uses net.dial
/// A pseudo nested transaction (pgx's Tx.Begin): `SAVEPOINT sp_N` on the
/// transaction's connection, N counting the savepoints of the outermost
/// transaction; its commit is `RELEASE SAVEPOINT sp_N` and its rollback
/// `ROLLBACK TO SAVEPOINT sp_N`, and the connection stays the outer
/// transaction's. On the in memory database it works on a copy of the
/// outer transaction's tables that its commit writes back. Once an outer
/// transaction ends, the nested one returns TxDone.
fn (t: Tx) begin() -> Tx ! SqlErr uses net.dial
fn (t: Tx) commit() -> () ! SqlErr uses net.dial
fn (t: Tx) rollback() -> () ! SqlErr uses net.dial

fn (s: Stmt) query(args: List[SqlValue] = []) -> List[Row] ! SqlErr uses net.dial
fn (s: Stmt) query_one(args: List[SqlValue] = []) -> Row ! SqlErr uses net.dial
fn (s: Stmt) exec(args: List[SqlValue] = []) -> ExecResult ! SqlErr uses net.dial
/// `Db.rows` of the statement: the connection is held until the cursor
/// ends or is closed.
fn (s: Stmt) rows(args: List[SqlValue] = []) -> Rows ! SqlErr uses net.dial
fn (s: Stmt) query_as[T: SqlRow](args: List[SqlValue] = []) -> List[T] ! SqlErr uses net.dial
fn (s: Stmt) query_one_as[T: SqlRow](args: List[SqlValue] = []) -> T ! SqlErr uses net.dial
/// The statement's text.
fn (s: Stmt) text() -> Str
/// Closes the statement on every connection (on an idle one now, on one in
/// use when it comes back to the pool); later runs return Closed.
/// Idempotent.
fn (s: Stmt) close() uses net.dial

fn (r: Rows) columns() -> List[Str]
/// Each column's type (Go's Rows.ColumnTypes, decision 0609):
/// `ColumnType{name}` per column when the driver does not say.
fn (r: Rows) column_types() -> List[ColumnType]
/// The next row, None after the last (the connection is then released).
fn (r: Rows) next() -> Row? ! SqlErr uses net.dial
/// `next` decoded into `T` (`derive SqlRow`).
fn (r: Rows) next_as[T: SqlRow]() -> T? ! SqlErr uses net.dial
/// Reads and discards the rest of the result and releases the connection;
/// idempotent.
fn (r: Rows) close() uses net.dial

fn (s: ResultSet) columns() -> List[Str]
/// As Rows.column_types.
fn (s: ResultSet) column_types() -> List[ColumnType]
fn (s: ResultSet) rows() -> List[Row]
/// The statement's count (pgconn's CommandTag.RowsAffected): the rows
/// written, or read by a SELECT; 0 from `query_all`'s sets.
fn (s: ResultSet) rows_affected() -> Int

fn (r: Row) columns() -> List[Str]
/// The row's values in column order (Go's Rows.Scan into a slice of any,
/// pgx's Rows.Values): the one way to every column when two share a name
/// (`SELECT a.id, b.id ...`), which `value` and the other accessors read
/// the first of.
fn (r: Row) values() -> List[SqlValue]
/// The result's column types, as Rows.column_types.
fn (r: Row) column_types() -> List[ColumnType]
/// Decodes the row into a struct with `derive SqlRow`: each field from the
/// column of the same name (std.md 10.4).
fn (r: Row) decode[T: SqlRow]() -> T ! SqlErr
/// The column's value as the driver read it (pgx's Rows.Values, one
/// column; NoColumn for an unknown name).
fn (r: Row) value(name: Str) -> SqlValue ! SqlErr
fn (r: Row) is_null(name: Str) -> Bool ! SqlErr
fn (r: Row) int(name: Str) -> Int ! SqlErr
fn (r: Row) str(name: Str) -> Str ! SqlErr
fn (r: Row) float(name: Str) -> Float ! SqlErr
fn (r: Row) bool(name: Str) -> Bool ! SqlErr
fn (r: Row) time(name: Str) -> Time ! SqlErr
fn (r: Row) int_opt(name: Str) -> Int? ! SqlErr
fn (r: Row) str_opt(name: Str) -> Str? ! SqlErr
fn (r: Row) float_opt(name: Str) -> Float? ! SqlErr
fn (r: Row) bool_opt(name: Str) -> Bool? ! SqlErr
fn (r: Row) time_opt(name: Str) -> Time? ! SqlErr
fn (r: Row) bytes(name: Str) -> Bytes ! SqlErr
fn (r: Row) bytes_opt(name: Str) -> Bytes? ! SqlErr
/// Typed readers of Postgres types sent as text (decision 0679), parsed
/// as pgx's pgtype parses them: a uuid column; a date (ISO, `BC` years as
/// year 1 - n, so 1 BC is year 0; infinity and -infinity are Mismatch); a
/// time (`24:00:00` is hour 24); an interval in the default IntervalStyle
/// (`1 year 2 mons 3 days 04:05:06.5`); an inet or cidr (an inet with no
/// mask is the address's full length). Another value is Mismatch.
fn (r: Row) uuid(name: Str) -> uuid.Uuid ! SqlErr
fn (r: Row) uuid_opt(name: Str) -> uuid.Uuid? ! SqlErr
fn (r: Row) date(name: Str) -> time.Date ! SqlErr
fn (r: Row) date_opt(name: Str) -> time.Date? ! SqlErr
fn (r: Row) time_of_day(name: Str) -> time.ClockTime ! SqlErr
fn (r: Row) time_of_day_opt(name: Str) -> time.ClockTime? ! SqlErr
fn (r: Row) interval(name: Str) -> Interval ! SqlErr
fn (r: Row) interval_opt(name: Str) -> Interval? ! SqlErr
fn (r: Row) prefix(name: Str) -> netip.Prefix ! SqlErr
fn (r: Row) prefix_opt(name: Str) -> netip.Prefix? ! SqlErr
/// A date, timestamp or timestamptz column that may be `infinity` or
/// `-infinity` (decision 0679).
fn (r: Row) date_bound(name: Str) -> Bound[time.Date] ! SqlErr
fn (r: Row) date_bound_opt(name: Str) -> Bound[time.Date]? ! SqlErr
fn (r: Row) time_bound(name: Str) -> Bound[Time] ! SqlErr
fn (r: Row) time_bound_opt(name: Str) -> Bound[Time]? ! SqlErr
/// A macaddr (6 bytes) or macaddr8 (8 bytes) column (pgx reads both into
/// net.HardwareAddr).
fn (r: Row) mac(name: Str) -> Bytes ! SqlErr
fn (r: Row) mac_opt(name: Str) -> Bytes? ! SqlErr
/// An hstore column (pgx's Hstore): each key and its value, None for a
/// NULL value, in the server's order.
fn (r: Row) hstore(name: Str) -> Map[Str, Str?] ! SqlErr
fn (r: Row) hstore_opt(name: Str) -> Map[Str, Str?]? ! SqlErr
/// A json or jsonb column (or text) decoded into T; a decode error is
/// Mismatch(column, msg).
fn (r: Row) json[T: Json](name: Str) -> T ! SqlErr
/// An array of integers; a NULL element is Mismatch.
fn (r: Row) ints(name: Str) -> List[Int] ! SqlErr
fn (r: Row) strs(name: Str) -> List[Str] ! SqlErr
/// An array's elements as values.
fn (r: Row) items(name: Str) -> List[SqlValue] ! SqlErr

/// A database driver written in Xo (decision 0278): opened with
/// `open_driver`, which gives it std/sql's pool, transactions, and
/// cancellation. It dials through the Net it is given.
interface Driver[fx: Effects] {
  fn connect(self, net: Net, dsn: Str) -> DriverConn[fx] ! SqlErr uses (net.dial, fx)
}

/// One connection of a Driver, used by one task at a time. Its waits are
/// cancellation points that return Canceled.
interface DriverConn[fx: Effects] {
  fn query(self, q: Str, args: List[SqlValue]) -> DriverRows[fx] ! SqlErr uses (net.dial, fx)
  fn exec(self, q: Str, args: List[SqlValue]) -> ExecResult ! SqlErr uses (net.dial, fx)
  fn begin(self) -> () ! SqlErr uses (net.dial, fx)
  fn commit(self) -> () ! SqlErr uses (net.dial, fx)
  fn rollback(self) -> () ! SqlErr uses (net.dial, fx)
  fn ping(self) -> () ! SqlErr uses (net.dial, fx)
  /// COPY FROM STDIN (decision 0479): a driver without it returns Driver.
  fn copy_from(self, table: Str, columns: List[Str], rows: fn() -> List[SqlValue]? ! SqlErr uses sync) -> Int ! SqlErr uses (net.dial, fx)
  /// A statement prepared on the server (decision 0648 item 6); None when
  /// the driver has none, and std/sql runs the text with `query` and
  /// `exec` each time.
  fn prepare(self, q: Str) -> DriverStmt[fx]? ! SqlErr uses (net.dial, fx)
  fn close(self) uses (net.dial, fx)
  /// True once the connection cannot be used again; the pool drops it,
  /// asking when it gives the connection back and again before it reuses
  /// an idle one (where a driver may check the socket, as go-sql-driver's
  /// connCheck).
  fn is_broken(self) -> Bool
  /// The next notification of a LISTEN (decision 0648 item 14, pgconn's
  /// WaitForNotification): one kept from an earlier call first, else a
  /// wait for the server that a cancellation ends with Canceled. A driver
  /// without LISTEN/NOTIFY returns Driver.
  fn wait_notification(self) -> Notification ! SqlErr uses (net.dial, fx)
  /// The notices received since the last call, in order (pgconn's
  /// OnNotice); std/sql drains them after each call and gives them to
  /// open's `on_notice`. A driver without notices returns [].
  fn notices(self) -> List[Notice]
  /// Runs the batches of `pipeline` (decision 0648 item 15), each a
  /// DriverResult per query (with rows_affected) or the batch's first
  /// error. Each batch is atomic: with `in_tx` false the driver runs it in
  /// a transaction of its own (Postgres's implicit transaction of a Sync);
  /// with `in_tx` true it is inside the caller's. The call's error is the
  /// connection's (the pool then drops a broken one). A driver without
  /// batches returns Driver.
  fn pipeline(self, batches: List[List[BatchQuery]], in_tx: Bool) -> List[Result[List[DriverResult], SqlErr]] ! SqlErr uses (net.dial, fx)
}

/// The result of DriverConn.query: column names and rows of values. A
/// driver may return a few rows (or none) and a cursor for the rest
/// (decision 0479): Db.rows reads them as asked, Db.query reads them all.
struct DriverRows[fx: Effects] {
  columns: List[Str]
  rows: List[List[SqlValue]]
  cursor: DriverCursor[fx]? = None
  /// Each column's type, in columns' order (decision 0609); empty when
  /// the driver does not say, and Rows.column_types gives
  /// `ColumnType{name}` per column then.
  column_types: List[ColumnType] = []
  /// The result sets after this one, of a `;` separated script (decision
  /// 0648 item 7), read whole: `query_all` returns them, `query` and
  /// `rows` drop them. Empty with a cursor.
  more: List[DriverResult] = []
}

/// A later result set of DriverRows, or one query's result of
/// DriverConn.pipeline.
struct DriverResult {
  columns: List[Str]
  rows: List[List[SqlValue]]
  column_types: List[ColumnType] = []
  /// DriverConn.pipeline's count (ResultSet.rows_affected).
  rows_affected: Int = 0
}

/// A statement prepared on one connection (DriverConn.prepare), used by
/// one task at a time with that connection.
interface DriverStmt[fx: Effects] {
  fn query(self, args: List[SqlValue]) -> DriverRows[fx] ! SqlErr uses (net.dial, fx)
  fn exec(self, args: List[SqlValue]) -> ExecResult ! SqlErr uses (net.dial, fx)
  /// Frees the statement on the server; the connection stays usable.
  fn close(self) uses (net.dial, fx)
}

/// A result column's type as the driver reports it (Go's
/// sql.ColumnType, decision 0609).
struct ColumnType {
  name: Str
  /// The database's name for the type, upper case ("INT4", "VARCHAR",
  /// "NUMERIC"; Go's DatabaseTypeName); "" when unknown.
  database_type: Str = ""
  /// Go's Length: varchar(n), bytea and text as Go's drivers report them.
  length: Int? = None
  /// Go's DecimalSize.
  precision: Int? = None
  scale: Int? = None
  /// Go's Nullable; None when the driver cannot tell.
  nullable: Bool? = None
  /// The SqlValue variant the column decodes to ("Integer", "Text", ...;
  /// Go's ScanType); "" when unknown.
  kind: Str = ""
}

/// The rest of a result still on the connection. The connection is not
/// used again until the cursor is read to the end or closed.
interface DriverCursor[fx: Effects] {
  /// The next row, None after the last.
  fn next(self) -> List[SqlValue]? ! SqlErr uses (net.dial, fx)
  /// All the remaining rows.
  fn rest(self) -> List[List[SqlValue]] ! SqlErr uses (net.dial, fx)
  /// Reads and discards the remaining rows.
  fn close(self) uses (net.dial, fx)
}

/// A Db over d: `max_open` connections at most (operations and open
/// transactions; waiting is a cancellation point), `max_idle` kept open
/// when unused, each closed after `max_lifetime`. Connects once before it
/// returns, so a wrong password or host fails here. `on_notice` as open's.
fn open_driver[fx: Effects](net: Net, d: Driver[fx], dsn: Str, max_open: Int = 10, max_idle: Int = 2, max_lifetime: Duration = 30m, on_notice: (fn(Notice) uses sync)? = None, on_trace: (fn(TraceRecord) uses sync)? = None) -> Db[fx] ! SqlErr uses (net.dial, fx)
