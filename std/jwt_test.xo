use std/json
use std/base64

struct Claims {
  sub: Str
  exp: Int
  role: Str?
} derive Json

fn opts(now: Int) -> Options {
  Options{algs: [Alg.HS256], now: Time.UNIX_EPOCH + Duration.from_secs_int(now)}
}

test "HS256 round trip and the checks" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(os.rand, Alg.HS256, key, Claims{sub: "ann", exp: 2000, role: Some("admin")}, Some("k1"))?
  let got = verify_with[Claims](tok, key, opts(1000))?
  expect(got.sub) == "ann"
  expect(got.role) == Some("admin")
  expect(peek_header(tok)?.kid) == Some("k1")
  // expired and wrong key
  match verify_with[Claims](tok, key, opts(2000)) {
    Err(JwtErr.Expired(_)) => ()
    _ => fault("expected Expired")
  }
  let other = Key.Hmac(secret: Secret.new(b"another secret"))
  match verify_with[Claims](tok, other, opts(1000)) {
    Err(JwtErr.Signature) => ()
    _ => fault("expected Signature")
  }
  // not in algs
  var o = opts(1000)
  o.algs = [Alg.HS512]
  match verify_with[Claims](tok, key, o) {
    Err(JwtErr.Alg(_)) => ()
    _ => fault("expected Alg")
  }
  // a none token
  let none = "eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiJhbm4iLCJleHAiOjIwMDB9."
  match verify_with[Claims](none, key, opts(1000)) {
    Err(JwtErr.Alg(_)) => ()
    _ => fault("expected Alg for none")
  }
}

struct Dates {
  exp: Int
  nbf: Int
  iat: Int
} derive Json

test "dates past 2262 do not overflow (b25)" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  // year 3000: golang-jwt accepts it as not expired, not early
  let tok = sign(os.rand, Alg.HS256, key, Dates{exp: 32503680000, nbf: 0, iat: 0}, None)?
  var o = opts(1000)
  o.leeway = Duration.from_secs_int(60)
  o.check_iat = true
  o.max_age = Some(Duration.from_secs_int(3000))
  let _ = verify_with[Dates](tok, key, o)?
  // nbf and iat in the far future are not yet valid
  let early = sign(os.rand, Alg.HS256, key, Dates{exp: 32503680000, nbf: 32503680000, iat: 0}, None)?
  match verify_with[Dates](early, key, opts(1000)) {
    Err(JwtErr.NotYetValid(_)) => ()
    _ => fault("expected NotYetValid")
  }
  // an exp far in the past is expired, with a leeway that would overflow the sum
  let old = sign(os.rand, Alg.HS256, key, Dates{exp: -32503680000, nbf: 0, iat: 0}, None)?
  var big = opts(1000)
  big.leeway = Duration.from_secs_int(3000000000)
  match verify_with[Dates](old, key, big) {
    Err(JwtErr.Expired(_)) => ()
    _ => fault("expected Expired")
  }
  // the largest allowed date with a large leeway
  let edge = sign(os.rand, Alg.HS256, key, Dates{exp: 100000000000, nbf: 0, iat: 0}, None)?
  big.leeway = Duration.from_secs_int(9000000000)
  let _ = verify_with[Dates](edge, key, big)?
}

struct Aud {
  exp: Int
  aud: List[json.Value]
} derive Json

test "an aud list holding a non string is refused when the audience is checked" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(os.rand, Alg.HS256, key, Aud{exp: 2000, aud: [json.Value.Str(s: "x"), json.Value.Int(n: 1)]}, None)?
  var o = opts(1000)
  o.audience = Some("x")
  match verify_with[Aud](tok, key, o) {
    Err(JwtErr.Claim(_)) => ()
    _ => fault("expected Claim")
  }
  // not checked: the claim is not looked at
  let _ = verify_with[Aud](tok, key, opts(1000))?
}

test "extra header fields and x5c follow alg, kid and typ in order of name" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(os.rand, Alg.HS256, key, Claims{sub: "ann", exp: 2000, role: None}, Some("k1"), {"x5t#S256": "abc_-", "jku": "https://x/y"}, ["MIIB", "MIIC"])?
  let seg = tok.split(".")[0]
  let head = base64.decode(seg, base64.Base64.RawUrl).ok() ?? b""
  expect(head.to_str() ?? "") == "{\"alg\":\"HS256\",\"kid\":\"k1\",\"typ\":\"JWT\",\"jku\":\"https://x/y\",\"x5c\":[\"MIIB\",\"MIIC\"],\"x5t#S256\":\"abc_-\"}"
  let h = peek_header(tok)?
  expect(h.extra.get("x5t#S256")) == Some("abc_-")
  expect(h.x5c) == ["MIIB", "MIIC"]
  // the token still verifies
  let got = verify_with[Claims](tok, key, opts(1000))?
  expect(got.sub) == "ann"
  // a reserved name is refused
  match sign(os.rand, Alg.HS256, key, Claims{sub: "ann", exp: 2000, role: None}, None, {"alg": "none"}) {
    Err(JwtErr.Malformed(_)) => ()
    _ => fault("expected Malformed")
  }
  // unchanged without them
  let plain = sign(os.rand, Alg.HS256, key, Claims{sub: "ann", exp: 2000, role: None})?
  expect((base64.decode(plain.split(".")[0], base64.Base64.RawUrl).ok() ?? b"").to_str() ?? "") == "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
}

struct AudOne {
  exp: Int
  aud: Str
} derive Json

struct Nbf {
  exp: Int
  nbf: Int
} derive Json

struct ExpOnly {
  exp: Int
} derive Json

/// Whether a token with this aud list verifies against all_audiences.
fn all_aud_ok(r: Rand, aud: List[Str], all: List[Str]) -> Bool ! JwtErr uses rand {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(r, Alg.HS256, key, Aud{exp: 2000, aud: aud.map(fn(s) { json.Value.Str(s: s) })}, None)?
  var o = opts(1000)
  o.all_audiences = all
  match verify_with[Aud](tok, key, o) {
    Ok(_) => Ok(true)
    Err(JwtErr.Audience) => Ok(false)
    Err(e) => Err(e)
  }
}

test "all_audiences is golang-jwt's WithAllAudiences (Test_Validator_verifyAudience, TestVerifyAud)" {
  // (aud, every audience wanted, verifies)
  let cases: List[(List[Str], List[Str], Bool)] = [
    ([], ["example.com"], false),
    (["example.com"], ["example.com"], true),
    (["example.org", "example.com"], ["example.org", "example.com"], true),
    (["example.com", "example.example.com"], ["example.com", "example.example.com"], true),
    (["example.org", "example.net"], ["example.org", "example.com"], false),
    (["example.com"], ["example.org", "example.com"], false),
    ([""], ["example.com"], false),
    (["a", "b", "c"], ["c", "a"], true),
  ]
  for (aud, all, want) in cases {
    expect((aud, all, all_aud_ok(os.rand, aud, all)?)) == (aud, all, want)
  }
  // a single string aud
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(os.rand, Alg.HS256, key, AudOne{exp: 2000, aud: "example.com"}, None)?
  var o = opts(1000)
  o.all_audiences = ["example.com"]
  let _ = verify_with[AudOne](tok, key, o)?
  o.all_audiences = ["example.com", "example.org"]
  match verify_with[AudOne](tok, key, o) {
    Err(JwtErr.Audience) => ()
    _ => fault("expected Audience")
  }
}

test "all_audiences refuses an aud list holding a non string" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let tok = sign(os.rand, Alg.HS256, key, Aud{exp: 2000, aud: [json.Value.Str(s: "x"), json.Value.Int(n: 5)]}, None)?
  var o = opts(1000)
  o.all_audiences = ["x"]
  match verify_with[Aud](tok, key, o) {
    Err(JwtErr.Claim(_)) => ()
    _ => fault("expected Claim")
  }
}

test "require_nbf is golang-jwt's WithNotBeforeRequired (Test_Validator_verifyNotBefore)" {
  let key = Key.Hmac(secret: Secret.new(b"a secret of some length"))
  let without = sign(os.rand, Alg.HS256, key, ExpOnly{exp: 2000}, None)?
  let past = sign(os.rand, Alg.HS256, key, Nbf{exp: 2000, nbf: 400}, None)?
  let future = sign(os.rand, Alg.HS256, key, Nbf{exp: 2000, nbf: 1600}, None)?
  // not required: a token without nbf verifies
  let _ = verify_with[ExpOnly](without, key, opts(1000))?
  var o = opts(1000)
  o.require_nbf = true
  match verify_with[ExpOnly](without, key, o) {
    Err(JwtErr.Claim(msg)) => expect(msg) == "nbf is required"
    _ => fault("expected Claim")
  }
  let _ = verify_with[Nbf](past, key, o)?
  match verify_with[Nbf](future, key, o) {
    Err(JwtErr.NotYetValid(_)) => ()
    _ => fault("expected NotYetValid")
  }
}
