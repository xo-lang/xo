// Tests from Prometheus client_golang v1.23.2's prometheus/vec_test.go
// (testCurryVec, testDeletePartialMatch) and histogram_test.go
// (TestBuckets), changed to Xo's API.
//
// Origin: prometheus (THIRD_PARTY_NOTICES)

use std/compress
use std/http
use std/protobuf

/// How many series the instrument holds.
fn nseries(f: Family) -> Int { series_snapshot(f).len() }

/// The counter value of the series of the full label values, or -1.
fn cval(f: Family, values: List[Str]) -> Float {
  match series_snapshot(f).get(key_of(values)) {
    Some(s) => counter_value(s.cells)
    None => -1.0
  }
}

fn vec3() -> Counter {
  registry().counter("test", "helpless", ["one", "two", "three"])
}

fn two_metrics(c: Counter) {
  expect(nseries(c.f)) == 2
  expect(cval(c.f, ["1", "2", "3"])) == 1.0
  expect(cval(c.f, ["11", "22", "33"])) == 1.0
}

test "currying with zero labels changes nothing (testCurryVec zero labels)" {
  let v = vec3()
  let c1 = v.must_curry_with({})
  let c2 = v.must_curry_with({})
  c1.inc(["1", "2", "3"])
  c2.inc(["11", "22", "33"])
  two_metrics(v)
  expect(c1.remove(["1", "2", "3"])) == true
  expect(c2.remove(["11", "22", "33"])) == true
  expect(nseries(v.f)) == 0
}

test "currying the first, middle, last and two labels (testCurryVec)" {
  for (curry1, rest1, curry2, rest2) in [
    ({"one": "1"}, ["2", "3"], {"one": "11"}, ["22", "33"]),
    ({"two": "2"}, ["1", "3"], {"two": "22"}, ["11", "33"]),
    ({"three": "3"}, ["1", "2"], {"three": "33"}, ["11", "22"]),
    ({"three": "3", "one": "1"}, ["2"], {"three": "33", "one": "11"}, ["22"]),
    ({"three": "3", "two": "2", "one": "1"}, [], {"three": "33", "one": "11", "two": "22"}, []),
  ] {
    let v = vec3()
    let c1 = v.must_curry_with(curry1)
    let c2 = v.must_curry_with(curry2)
    c1.inc(rest1)
    c2.inc(rest2)
    two_metrics(v)
    if rest1.len() > 0 {
      expect(c1.remove(rest2)) == false
      expect(c2.remove(rest1)) == false
    }
    expect(c1.remove(rest1)) == true
    expect(c2.remove(rest2)) == true
    expect(nseries(v.f)) == 0
  }
}

test "a curried instrument curries again (testCurryVec double curry)" {
  let v = vec3()
  let c1 = v.must_curry_with({"three": "3"}).must_curry_with({"one": "1"})
  let c2 = v.must_curry_with({"three": "33"}).must_curry_with({"one": "11"})
  c1.inc(["2"])
  c2.inc(["22"])
  two_metrics(v)
  expect(c1.remove(["22"])) == false
  expect(c2.remove(["2"])) == false
  expect(c1.remove(["2"])) == true
  expect(c2.remove(["22"])) == true
  expect(nseries(v.f)) == 0
}

test "currying a curried label or an unknown one is an error (testCurryVec)" {
  let v = vec3()
  match v.must_curry_with({"three": "3"}).curry_with({"three": "33"}) {
    Ok(_) => fault("currying unexpectedly succeeded")
    Err(e) => expect(e.msg) == "label name \"three\" is already curried"
  }
  match v.curry_with({"foo": "bar"}) {
    Ok(_) => fault("currying unexpectedly succeeded")
    Err(e) => expect(e.msg) == "1 unknown label(s) found during currying"
  }
  expect(nseries(v.f)) == 0
}

test "curried gauges, histograms and summaries share the series" {
  let r = registry()
  let g = r.gauge("g", "h", ["a", "b"])
  g.must_curry_with({"b": "x"}).set(4.0, ["y"])
  expect(r.text().contains("g{a=\"y\",b=\"x\"} 4\n")) == true
  let h = r.histogram("hh", "h", ["a", "b"], [1.0])
  h.must_curry_with({"a": "p"}).observe(0.5, ["q"])
  expect(r.text().contains("hh_count{a=\"p\",b=\"q\"} 1\n")) == true
  let s = r.summary("ss", "h", ["a"])
  s.must_curry_with({"a": "z"}).observe(2.0)
  expect(r.text().contains("ss_sum{a=\"z\"} 2\n")) == true
}

fn x_prefix(s: Str) -> Str { "x" + s }

test "delete_partial_match removes every series holding the pairs (testDeletePartialMatch)" {
  delete_partial_case(registry().gauge("test", "helpless", ["l1", "l2", "l3"]))
}

test "delete_partial_match constrains its values (TestDeletePartialMatchWithConstraints)" {
  delete_partial_case(registry().gauge("test", "helpless", ["l1", "l2", "l3"], constraints: {"l2": x_prefix}))
}

fn delete_partial_case(v: Gauge) {
  expect(v.delete_partial_match({"l1": "v1", "l2": "v2"})) == 0
  v.add(1.0, ["baseValue1", "baseValue2", "baseValue3"])
  v.set(42.0, ["multiDeleteV1", "diff1BaseValue2", "v3"])
  v.set(84.0, ["multiDeleteV1", "diff2BaseValue2", "v3"])
  v.set(168.0, ["multiDeleteV1", "diff3BaseValue2", "v3"])
  let c = v.must_curry_with({"l2": "curriedValue2"})
  c.add(1.0, ["curriedValue1", "curriedValue3"])
  c.add(1.0, ["curriedValue1", "differentCurriedValue3"])
  c.add(1.0, ["differentCurriedValue1", "differentCurriedValue3"])
  expect(c.delete_partial_match({"lx": "curriedValue1"})) == 0
  expect(c.delete_partial_match({"l1": "badValue1"})) == 0
  expect(c.delete_partial_match({"l2": "curriedValue2"})) == 0
  expect(c.delete_partial_match({"l2": "baseValue2"})) == 0
  expect(c.delete_partial_match({"l1": "curriedValue1"})) == 2
  expect(v.delete_partial_match({"lx": "curriedValue1"})) == 0
  expect(v.delete_partial_match({"l1": "baseValue1", "l2": "badValue2"})) == 0
  expect(v.delete_partial_match({"l2": "curriedValue2"})) == 1
  expect(v.delete_partial_match({"l1": "multiDeleteV1"})) == 3
  expect(v.delete_partial_match({"l3": "baseValue3"})) == 1
  expect(nseries(v.f)) == 0
}

test "remove constrains its values (testDelete and testDeleteLabelValues, WithConstraints)" {
  for cons in [{}, {"l2": x_prefix}] {
    let v = registry().gauge("test", "helpless", ["l1", "l2"], constraints: cons)
    expect(v.remove(["v1", "v2"])) == false
    v.set(42.0, ["v1", "v2"])
    v.set(42.0, ["v1", "v3"])
    expect(v.remove(["v1", "v2"])) == true
    expect(v.remove(["v1", "v2"])) == false
    expect(v.remove(["v1", "v3"])) == true
    v.set(42.0, ["v1", "v2"])
    expect(v.remove(["v2", "v1"])) == false
  }
}

test "constrained label values count into one series each (TestMetricVecWithConstraints)" {
  let r = registry()
  let v = r.gauge("test", "helpless", ["l1", "l2"], constraints: {"l2": x_prefix})
  var want: Map[Str, Int] = {}
  for i in 0..1000 {
    let a = "${i % 4}"
    let b = "${i % 5}"
    let k = key_of([a, x_prefix(b)])
    want[k] = (want.get(k) ?? 0) + 1
    v.add(1.0, [a, b])
    let k2 = key_of(["v1", x_prefix("v2")])
    want[k2] = (want.get(k2) ?? 0) + 1
    v.add(1.0, ["v1", "v2"])
  }
  let got = series_snapshot(v.f)
  expect(got.len()) == want.len()
  for (k, n) in want {
    let s = got.get(k) ?? fault("no series ${k}")
    expect(load(s.cells[0])) == Float(n)
  }
  expect(r.text().contains("test{l1=\"v1\",l2=\"xv2\"} 1000\n")) == true
  v.reset()
  expect(nseries(v.f)) == 0
}

test "currying with a constrained label (TestCurryVecWithConstraints)" {
  // constrainedLabels overlap variableLabels: the curry cases on a vector
  // whose last label is constrained, checked by the constrained values
  for (curry1, rest1, curry2, rest2) in [
    ({"one": "1"}, ["2", "3"], {"one": "11"}, ["22", "33"]),
    ({"three": "3"}, ["1", "2"], {"three": "33"}, ["11", "22"]),
    ({"three": "3", "one": "1"}, ["2"], {"three": "33", "one": "11"}, ["22"]),
  ] {
    let v = registry().counter("test", "helpless", ["one", "two", "three"], constraints: {"three": x_prefix})
    let c1 = v.must_curry_with(curry1)
    let c2 = v.must_curry_with(curry2)
    c1.inc(rest1)
    c2.inc(rest2)
    expect(nseries(v.f)) == 2
    expect(cval(v.f, ["1", "2", "x3"])) == 1.0
    expect(cval(v.f, ["11", "22", "x33"])) == 1.0
    expect(c1.remove(rest1)) == true
    expect(c2.remove(rest2)) == true
    expect(nseries(v.f)) == 0
  }
  // constrainedLabels reducing cardinality: every value of three is "x"
  let v = registry().counter("test", "helpless", ["one", "two", "three"], constraints: {"three": fn(s: Str) -> Str { "x" }})
  v.must_curry_with({"three": "3"}).inc(["1", "2"])
  v.must_curry_with({"three": "33"}).inc(["11", "22"])
  expect(cval(v.f, ["1", "2", "x"])) == 1.0
  expect(cval(v.f, ["11", "22", "x"])) == 1.0
  expect(v.remove(["1", "2", "anything"])) == true
}

test "a series kept after a partial delete is still found by its labels" {
  let v = registry().counter("c", "h", ["a", "b"])
  v.inc(["1", "x"])
  v.inc(["2", "y"])
  v.inc(["3", "x"])
  expect(v.delete_partial_match({"b": "x"})) == 2
  v.inc(["2", "y"])
  expect(cval(v.f, ["2", "y"])) == 2.0
  expect(nseries(v.f)) == 1
}

test "linear and exponential buckets (TestBuckets)" {
  expect(linear_buckets(-15.0, 5.0, 6)) == [-15.0, -10.0, -5.0, 0.0, 5.0, 10.0]
  expect(exponential_buckets(100.0, 1.2, 3)) == [100.0, 120.0, 144.0]
  let got = exponential_buckets_range(1.0, 100.0, 10)
  let want = [1.0, 1.6681, 2.7825, 4.6415, 7.7426, 12.9154, 21.5443, 35.9381, 59.9484, 100.0]
  expect(got.len()) == want.len()
  for (i, w) in want.indexed() {
    expect((got[i] - w).abs() < 1e-4) == true
  }
}

test "untyped_func exposes an untyped series (UntypedFunc)" {
  let r = registry()
  r.untyped_func("temp", "A temperature.", fn() -> Float uses sync { 21.5 })
  r.collector("u", "Untyped series.", Kind.Untyped, ["k"], fn() -> List[Sample] uses sync { [Sample{values: ["a"], value: 2.0}] })
  let t = r.text()
  expect(t.contains("# TYPE temp untyped\ntemp 21.5\n")) == true
  expect(t.contains("# TYPE u untyped\nu{k=\"a\"} 2\n")) == true
}

test "wrap puts a prefix and constant labels on what is made through it (WrapRegistererWith, WrapRegistererWithPrefix)" {
  let r = registry()
  let w = r.wrap(prefix: "app_", labels: {"zone": "b", "region": "a"})
  let c = w.counter("hits_total", "Hits.", ["path"])
  c.inc(["/x"])
  let h = w.histogram("lat", "L.", [], [1.0])
  h.observe(0.5)
  // nested wrappers: the inner prefix first, as Go's
  let n = w.wrap(prefix: "db_", labels: {"shard": "1"})
  n.gauge("open", "Open.").set(3.0)
  let t = r.text()
  expect(t.contains("app_hits_total{region=\"a\",zone=\"b\",path=\"/x\"} 1\n")) == true
  expect(t.contains("app_lat_bucket{region=\"a\",zone=\"b\",le=\"1\"} 1\n")) == true
  expect(t.contains("app_lat_count{region=\"a\",zone=\"b\"} 1\n")) == true
  expect(t.contains("app_db_open{region=\"a\",shard=\"1\",zone=\"b\"} 3\n")) == true
  // the wrapped value shares the registry's instruments
  expect(w.text()) == t
}

test "a histogram collector's samples are its buckets, sum and count (NewConstHistogram)" {
  let r = registry()
  r.collector("sample_value", "sample value", Kind.Histogram, [], fn() -> List[Sample] uses sync {
    [Sample{values: [], count: 100, sum: 200.0, buckets: [(50.0, 200), (25.0, 100)]}]
  })
  expect(r.text().split("\n")[0..6]) == [
    "# HELP sample_value sample value",
    "# TYPE sample_value histogram",
    "sample_value_bucket{le=\"25\"} 100",
    "sample_value_bucket{le=\"50\"} 200",
    "sample_value_bucket{le=\"+Inf\"} 100",
    "sample_value_sum 200",
  ]
}

test "a summary collector's samples are its quantiles, sum and count (NewConstSummary)" {
  let r = registry()
  r.collector("sample_value", "sample value", Kind.Summary, ["a"], fn() -> List[Sample] uses sync {
    [Sample{values: ["x"], count: 100, sum: 200.0, quantiles: [(0.99, 500.342), (0.5, 200.12)]}]
  })
  let t = r.text()
  expect(t.contains("# TYPE sample_value summary\nsample_value{a=\"x\",quantile=\"0.5\"} 200.12\nsample_value{a=\"x\",quantile=\"0.99\"} 500.342\nsample_value_sum{a=\"x\"} 200\nsample_value_count{a=\"x\"} 100\n")) == true
}

test "a sample's timestamp follows each of its values (NewMetricWithTimestamp)" {
  let r = registry()
  let at = Time.from_unix_millis(1719670764123)
  r.collector("c", "C.", Kind.Counter, [], fn() -> List[Sample] uses sync { [Sample{values: [], value: 3.0, timestamp: Some(at)}] })
  r.collector("h", "H.", Kind.Histogram, [], fn() -> List[Sample] uses sync { [Sample{values: [], count: 1, sum: 0.5, buckets: [(1.0, 1)], timestamp: Some(at)}] })
  let t = r.text()
  expect(t.contains("\nc 3 1719670764123\n")) == true
  expect(t.contains("\nh_bucket{le=\"1\"} 1 1719670764123\nh_bucket{le=\"+Inf\"} 1 1719670764123\nh_sum 0.5 1719670764123\nh_count 1 1719670764123\n")) == true
}

test "gather merges families of several registries (ExampleGatherers)" {
  let reg = registry()
  let temp = reg.gauge("temperature_kelvin", "Temperature in Kelvin.", ["location"])
  temp.set(273.14, ["outside"])
  temp.set(298.44, ["inside"])
  let other = registry()
  other.collector("humidity_percent", "Humidity in %.", Kind.Gauge, ["location"], fn() -> List[Sample] uses sync {
    [Sample{values: ["outside"], value: 45.4}, Sample{values: ["inside"], value: 33.2}]
  })
  other.collector("temperature_kelvin", "Temperature in Kelvin.", Kind.Gauge, ["location"], fn() -> List[Sample] uses sync {
    [Sample{values: ["somewhere else"], value: 4.5}]
  })
  let (t, errs) = gather([reg, other])
  expect(errs.errors.len()) == 0
  expect(t.split("\n")[0..9]) == [
    "# HELP humidity_percent Humidity in %.",
    "# TYPE humidity_percent gauge",
    "humidity_percent{location=\"inside\"} 33.2",
    "humidity_percent{location=\"outside\"} 45.4",
    "# HELP temperature_kelvin Temperature in Kelvin.",
    "# TYPE temperature_kelvin gauge",
    "temperature_kelvin{location=\"inside\"} 298.44",
    "temperature_kelvin{location=\"outside\"} 273.14",
    "temperature_kelvin{location=\"somewhere else\"} 4.5",
  ]
}

test "a duplicate series is an error and the rest is still gathered (ExampleGatherers)" {
  let reg = registry()
  let temp = reg.gauge("temperature_kelvin", "Temperature in Kelvin.", ["location"])
  temp.set(273.14, ["outside"])
  temp.set(298.44, ["inside"])
  let other = registry()
  other.collector("temperature_kelvin", "Temperature in Kelvin.", Kind.Gauge, ["location"], fn() -> List[Sample] uses sync {
    [Sample{values: ["outside"], value: 265.3}]
  })
  // the missing location label: valid, and a series of its own
  let third = registry()
  third.gauge("temperature_kelvin", "Temperature in Kelvin.").set(4.5)
  let (t, errs) = gather([reg, other, third])
  expect(errs.errors.len()) == 1
  expect(errs.errors[0].msg.starts_with("collected metric temperature_kelvin {location=\"outside\"} was collected before")) == true
  expect(t.split("\n")[0..5]) == [
    "# HELP temperature_kelvin Temperature in Kelvin.",
    "# TYPE temperature_kelvin gauge",
    "temperature_kelvin 4.5",
    "temperature_kelvin{location=\"inside\"} 298.44",
    "temperature_kelvin{location=\"outside\"} 273.14",
  ]
}

test "a family with another help or type is an error; dropped counts are summed" {
  let a = registry()
  a.counter("x", "One.").inc()
  let b = registry()
  b.counter("x", "Two.").inc()
  let c = registry()
  c.gauge("x", "One.").set(1.0)
  let (t, errs) = gather([a, b, c])
  expect(errs.errors.map(fn(e: MetricsErr) -> Str { e.msg })) == [
    "gathered metric family x has help \"Two.\" but should have \"One.\"",
    "gathered metric family x has type gauge but should have counter",
  ]
  expect(errs.display()) == "2 error(s) occurred:\n* gathered metric family x has help \"Two.\" but should have \"One.\"\n* gathered metric family x has type gauge but should have counter"
  expect(t.contains("\nx 1\n")) == true
  expect(t.ends_with("xo_metrics_dropped_total 0\n")) == true
}

fn scrape(r: Registry, accept: Str, offer: List[Compression] = [Compression.Gzip, Compression.Identity]) -> http.Response {
  let h = r.handler(offer)
  h(http.Request{method: "GET", path: "/metrics", url: http.Url{scheme: "", host: "", port: None, path: "/metrics", query: {}}, headers: if accept.is_empty() { {} } else { {"Accept-Encoding": accept} }, body: b"", remote_ip: ""})
}

test "the handler negotiates gzip as promhttp does (TestNegotiateEncodingWriter)" {
  let r = registry()
  r.counter("c_total", "C.").inc()
  let plain = r.text().bytes()
  for (accept, gz) in [
    ("", false),
    ("gzip", true),
    ("deflate, gzip;q=1.0, *;q=0.5", true),
    ("gzip;q=0", false),
    ("identity", false),
    ("*", true),
    ("br", false),
    ("gzip;q=0.5, identity;q=0.9", false),
  ] {
    let resp = scrape(r, accept)
    expect(resp.status) == 200
    if gz {
      expect(resp.headers.get("Content-Encoding")) == Some("gzip")
      expect(compress.gunzip(resp.body) ?? e => fault("${e}")) == plain
    } else {
      expect(resp.headers.get("Content-Encoding")) == None
      expect(resp.body) == plain
    }
  }
  // offering identity only never compresses
  expect(scrape(r, "gzip", [Compression.Identity]).body) == plain
}

test "the middleware observes request and response sizes (InstrumentHandlerRequestSize, ResponseSize)" {
  let r = registry()
  let mw = r.middleware(os.clock, fn(req: http.Request) -> Str { req.path }, sizes: true)
  let req = http.Request{method: "POST", path: "/a", url: http.Url{scheme: "", host: "", port: None, path: "/a", query: {"k": "v"}}, headers: {"X": "yz"}, body: b"hello", remote_ip: ""}
  let resp = mw(req, fn(_r: http.Request) -> http.Response { http.Response{status: 201, headers: {}, body: b"0123456789"} })
  expect(resp.status) == 201
  // "/a?k=v" 6, "POST" 4, protocol 8, "X" and "yz" 3, body 5
  expect(request_size(req)) == 26
  let t = r.text()
  expect(t.contains("http_request_size_bytes_sum{route=\"/a\"} 26\n")) == true
  expect(t.contains("http_response_size_bytes_sum{route=\"/a\"} 10\n")) == true
  expect(t.contains("http_requests_total{method=\"POST\",route=\"/a\",status=\"201\"} 1\n")) == true
}

test "size_buckets are 100 bytes to 100 MB by tens" {
  expect(size_buckets()) == [100.0, 1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0, 100000000.0]
}

test "client_send counts a failed send as code error (InstrumentRoundTripperCounter, Duration, InFlight)" uses (net, clock) {
  let r = registry()
  let send = r.client_send(os.clock)
  let req = http.Request{method: "GET", path: "/", url: http.parse_url("http://127.0.0.1:1/") ?? e => fault("${e}"), headers: {}, body: b"", remote_ip: ""}
  match send(http.client(os.net, 5s), req) {
    Ok(_) => fault("a send to port 1 succeeded")
    Err(_) => {}
  }
  let t = r.text()
  expect(t.contains("http_client_requests_total{method=\"GET\",code=\"error\"} 1\n")) == true
  expect(t.contains("http_client_request_seconds_count{method=\"GET\"} 1\n")) == true
  expect(t.contains("http_client_in_flight 0\n")) == true
}

test "runtime_collector and build_info (NewGoCollector, NewBuildInfoCollector)" {
  let r = registry()
  r.runtime_collector()
  r.build_info(path: "example.com/app", version: "v1.2.3")
  let t = r.text()
  expect(t.contains("# TYPE xo_heap_bytes gauge\nxo_heap_bytes ")) == true
  expect(t.contains("# TYPE xo_heap_peak_bytes gauge\nxo_heap_peak_bytes ")) == true
  expect(t.contains("xo_build_info{checksum=\"unknown\",path=\"example.com/app\",version=\"v1.2.3\"} 1\n")) == true
}

test "OpenMetrics: a histogram's bucket exemplars (expfmt TestCreateOpenMetrics 9)" {
  let r = registry()
  let at = Time.from_unix_millis(12345600)
  r.collector("request_duration_microseconds", "The response latency.", Kind.Histogram, [], fn() -> List[Sample] uses sync {
    [Sample{values: [], count: 2693, sum: 1756047.3, buckets: [(100.0, 123), (120.0, 412), (144.0, 592), (172.8, 1524)],
      exemplars: [Exemplar{labels: {"foo": "bar"}, value: 119.9, at: Some(at)}, Exemplar{labels: {"foo": "baz", "dings": "bums"}, value: 140.14}]}]
  })
  expect(r.open_metrics().split("\n")[0..8]) == [
    "# HELP request_duration_microseconds The response latency.",
    "# TYPE request_duration_microseconds histogram",
    "request_duration_microseconds_bucket{le=\"100.0\"} 123",
    "request_duration_microseconds_bucket{le=\"120.0\"} 412 # {foo=\"bar\"} 119.9 12345.6",
    "request_duration_microseconds_bucket{le=\"144.0\"} 592 # {dings=\"bums\",foo=\"baz\"} 140.14",
    "request_duration_microseconds_bucket{le=\"172.8\"} 1524",
    "request_duration_microseconds_bucket{le=\"+Inf\"} 2693",
    "request_duration_microseconds_sum 1.7560473e+06",
  ]
}

test "OpenMetrics: counters drop _total from the family, others are unknown (expfmt 10, 11, 13)" {
  let r = registry()
  r.counter("foos_total", "Number of foos.").add(42.0)
  r.counter("bars", "Bars.").inc()
  r.untyped_func("u", "U.", fn() -> Float uses sync { 2.5 })
  let t = r.open_metrics()
  expect(t.starts_with("# HELP foos Number of foos.\n# TYPE foos counter\nfoos_total 42.0\n# HELP bars Bars.\n# TYPE bars unknown\nbars 1.0\n# HELP u U.\n# TYPE u unknown\nu 2.5\n")) == true
  expect(t.ends_with("xo_metrics_dropped_total 0.0\n# EOF\n")) == true
}

test "exemplars on instruments and their checks (AddWithExemplar, ObserveWithExemplar, newExemplar)" {
  let r = registry()
  let c = r.counter("hits_total", "Hits.", ["path"])
  let h = r.histogram("lat", "Latency.", [], [0.1, 1.0])
  let at = Time.from_unix_millis(1520879607789)
  let ex = exemplar({"trace_id": "abc"}, Some(at)) ?? e => fault(e.msg)
  c.add_with_exemplar(2.0, ex, ["/x"])
  h.observe_with_exemplar(0.5, ex)
  h.observe(0.05)
  let t = r.open_metrics()
  expect(t.contains("hits_total{path=\"/x\"} 2.0 # {trace_id=\"abc\"} 2.0 1.520879607789e+09\n")) == true
  expect(t.contains("lat_bucket{le=\"0.1\"} 1\nlat_bucket{le=\"1.0\"} 2 # {trace_id=\"abc\"} 0.5 1.520879607789e+09\nlat_bucket{le=\"+Inf\"} 2\n")) == true
  // the 0.0.4 text has no exemplars
  expect(r.text().contains("# {")) == false
  // a removed series takes its exemplar with it
  expect(c.remove(["/x"])) == true
  c.inc(["/x"])
  expect(r.open_metrics().contains("hits_total{path=\"/x\"} 1.0\n")) == true
  match exemplar({"0bad": "x"}) {
    Ok(_) => fault("an invalid label name passed")
    Err(e) => expect(e.msg) == "exemplar label name \"0bad\" is invalid"
  }
  match exemplar({"k": "x".repeat(128)}) {
    Ok(_) => fault("129 runes passed")
    Err(e) => expect(e.msg) == "exemplar labels have 129 runes, exceeding the limit of 128"
  }
}

test "the handler answers OpenMetrics when enabled and asked for (EnableOpenMetrics)" {
  let r = registry()
  r.counter("c_total", "C.").inc()
  let req = fn(accept: Str) -> http.Request {
    http.Request{method: "GET", path: "/metrics", url: http.Url{scheme: "", host: "", port: None, path: "/metrics", query: {}}, headers: {"Accept": accept}, body: b"", remote_ip: ""}
  }
  let om = r.handler([Compression.Identity], open_metrics: true)
  let resp = om(req("application/openmetrics-text;version=1.0.0,text/plain;q=0.5"))
  expect(resp.headers.get("Content-Type")) == Some("application/openmetrics-text; version=1.0.0; charset=utf-8")
  expect(resp.body.to_str_lossy().ends_with("# EOF\n")) == true
  expect(om(req("text/plain")).body.to_str_lossy().contains("# EOF")) == false
  let plain = r.handler([Compression.Identity])
  expect(plain(req("application/openmetrics-text")).body.to_str_lossy().contains("# EOF")) == false
}

test "the middleware's exemplar_of labels the count and latency (WithExemplarFromContext)" {
  let r = registry()
  let mw = r.middleware(os.clock, fn(req: http.Request) -> Str { req.path }, exemplar_of: Some(fn(req: http.Request) -> Map[Str, Str] { {"trace_id": req.headers.get("X-Trace") ?? ""} }))
  let req = http.Request{method: "GET", path: "/a", url: http.Url{scheme: "", host: "", port: None, path: "/a", query: {}}, headers: {"X-Trace": "t1"}, body: b"", remote_ip: ""}
  let _resp = mw(req, fn(_r: http.Request) -> http.Response { http.Response{status: 200, headers: {}, body: b""} })
  let t = r.open_metrics()
  expect(t.contains("http_requests_total{method=\"GET\",route=\"/a\",status=\"200\"} 1.0 # {trace_id=\"t1\"} 1.0 ")) == true
  expect(t.contains("le=\"0.005\"} 1 # {trace_id=\"t1\"} ")) == true
}

test "process_collector reports what update read (NewProcessCollector, ProcessCollectorOpts.Namespace)" uses (clock, proc) {
  let r = registry()
  let pc = r.process_collector(os.clock, namespace: "app")
  var x = 0
  for i in 0..2000000 {
    x += i % 7
  }
  expect(x > 0) == true
  pc.update(os.proc)
  let t = r.text()
  expect(t.contains("# TYPE app_process_cpu_seconds_total counter\napp_process_cpu_seconds_total ")) == true
  expect(pc.max_rss.get() > 0) == true
  // the text format writes a value as Go's FormatFloat(v, 'g', -1): 2.0381696e+07
  expect(t.contains("app_process_max_resident_memory_bytes ${num(Float(pc.max_rss.get()))}\n")) == true
  expect(t.contains("app_process_start_time_seconds ")) == true
}

test "native_histogram checks the schema and the counts (NewConstNativeHistogram)" {
  match native_histogram(3, 1.0, {1: 2}, {}, 1, 9) {
    Ok(_) => fault("schema 9 passed")
    Err(e) => expect(e.msg) == "invalid native histogram schema"
  }
  match native_histogram(3, 1.0, {1: 2}, {}, 2, 3) {
    Ok(_) => fault("4 bucket counts for 3 observations passed")
    Err(e) => expect(e.msg) == "the sum of all bucket populations exceeds the count of observations"
  }
  let nan = native_histogram(5, Float.nan, {1: 2}, {}, 1, 3) ?? e => fault(e.msg)
  expect(nan.zero_threshold) == DEF_NATIVE_HISTOGRAM_ZERO_THRESHOLD
  let zero = native_histogram(0, 0.0, {}, {}, 0, 3, NATIVE_HISTOGRAM_ZERO_THRESHOLD_ZERO) ?? e => fault(e.msg)
  expect(zero.zero_threshold) == 0.0
}

test "makeBucketsFromMap: gaps of two buckets or less stay in the span (pb_spans)" {
  let (spans, deltas) = pb_spans({-2: 1, 0: 3, 1: 3, 5: 2, 6: 4})
  expect(spans.map(fn(s: PbSpan) -> (Int, Int) { (Int(s.offset ?? Int32.wrapping_from(0)), Int(s.length ?? UInt32.wrapping_from(0))) })) == [(-2, 4), (3, 2)]
  expect(deltas) == [1, -1, 3, 0, -1, 2]
}

// client_model's messages with derive Proto: the test reads the
// exposition std/metrics writes by hand with the derived decoder.
struct TLabel {
  name proto "1": Str? = None
  value proto "2": Str? = None
} derive Proto

struct TTimestamp {
  seconds proto "1": Int = 0
  nanos proto "2": Int32 = 0
} derive Proto

struct TExemplar {
  label proto "1": List[TLabel] = []
  value proto "2": Float? = None
  timestamp proto "3": TTimestamp? = None
} derive Proto

struct TCounter {
  value proto "1": Float? = None
  exemplar proto "2": TExemplar? = None
  created_timestamp proto "3": TTimestamp? = None
} derive Proto

struct TSpan {
  offset proto "1,zigzag": Int32? = None
  length proto "2": UInt32? = None
} derive Proto

struct THistogram {
  sample_count proto "1": UInt64? = None
  sample_sum proto "2": Float? = None
  schema proto "5,zigzag": Int32? = None
  zero_threshold proto "6": Float? = None
  zero_count proto "7": UInt64? = None
  negative_span proto "9": List[TSpan] = []
  negative_delta proto "10,zigzag": List[Int] = []
  positive_span proto "12": List[TSpan] = []
  positive_delta proto "13,zigzag": List[Int] = []
  created_timestamp proto "15": TTimestamp? = None
} derive Proto

struct TMetric {
  label proto "1": List[TLabel] = []
  counter proto "3": TCounter? = None
  timestamp_ms proto "6": Int? = None
  histogram proto "7": THistogram? = None
} derive Proto

struct TFamily {
  name proto "1": Str? = None
  help proto "2": Str? = None
  kind proto "3": Int? = None
  metric proto "4": List[TMetric] = []
} derive Proto

test "the protobuf exposition carries native histograms (TestConstNativeHistogram)" {
  let r = registry()
  let created = Time.from_unix_millis(1719670764123)
  r.collector("nh", "Native.", Kind.Histogram, [], fn() -> List[Sample] uses sync {
    let n = native_histogram(4, 6.0, {0: 1, 8: 1, 13: 1}, {}, 1, 3) ?? e => fault(e.msg)
    [Sample{values: [], count: 4, sum: 6.0, native: Some(n), created: Some(created)}]
  })
  r.collector("empty", "No-op span.", Kind.Histogram, [], fn() -> List[Sample] uses sync {
    let n = native_histogram(0, 0.0, {}, {}, 0, 3, NATIVE_HISTOGRAM_ZERO_THRESHOLD_ZERO) ?? e => fault(e.msg)
    [Sample{values: [], native: Some(n)}]
  })
  let c = r.counter("c_total", "C.", ["k"])
  c.add_with_exemplar(2.0, exemplar({"trace_id": "t"}) ?? e => fault(e.msg), ["v"])
  let fams = read_delimited(r.protobuf())
  expect(fams.map(fn(f: TFamily) -> Str { f.name ?? "" })) == ["nh", "empty", "c_total", "xo_metrics_dropped_total"]
  let h = fams[0].metric[0].histogram ?? fault("no histogram")
  expect(h.schema) == Some(Int32.wrapping_from(3))
  expect(h.zero_threshold) == Some(DEF_NATIVE_HISTOGRAM_ZERO_THRESHOLD)
  expect(h.zero_count) == Some(UInt64.wrapping_from(1))
  expect(h.positive_delta) == [1, 0, 0]
  expect(h.positive_span.len()) == 3
  expect((h.created_timestamp ?? fault("no created")).seconds) == 1719670764
  let e = fams[1].metric[0].histogram ?? fault("no histogram")
  expect(e.positive_span.len()) == 1
  expect(e.positive_span[0].length) == Some(UInt32.wrapping_from(0))
  let cm = fams[2].metric[0]
  expect(fams[2].kind) == Some(0)
  expect(cm.label.map(fn(l: TLabel) -> Str { l.value ?? "" })) == ["v"]
  expect((cm.counter ?? fault("no counter")).value) == Some(2.0)
  expect(((cm.counter ?? fault("no counter")).exemplar ?? fault("no exemplar")).value) == Some(2.0)
}

/// The families of a delimited protobuf exposition.
fn read_delimited(b: Bytes) -> List[TFamily] {
  var out: List[TFamily] = []
  var i = 0
  while i < b.len() {
    var n = 0
    var shift = 1
    while true {
      let x = Int(b[i])
      i += 1
      n += (x % 128) * shift
      shift *= 128
      if x < 128 {
        break
      }
    }
    out.push(protobuf.unmarshal[TFamily](b[i..i + n]) ?? e => fault("${e}"))
    i += n
  }
  out
}

test "the handler answers protobuf when it is asked for first" {
  let r = registry()
  r.counter("c_total", "C.").inc()
  let h = r.handler([Compression.Identity])
  let req = http.Request{method: "GET", path: "/metrics", url: http.Url{scheme: "", host: "", port: None, path: "/metrics", query: {}}, headers: {"Accept": "application/vnd.google.protobuf;proto=io.prometheus.client.MetricFamily;encoding=delimited;q=0.7,text/plain;version=0.0.4;q=0.3"}, body: b"", remote_ip: ""}
  let resp = h(req)
  expect(resp.headers.get("Content-Type")) == Some(PROTOBUF_TYPE)
  expect(read_delimited(resp.body).len()) == 2
}

test "/proc parsing as procfs reads it (stat with a spaced command, btime, VmRSS)" {
  let stat = "4242 (my (odd) cmd) S 1 4242 4242 0 -1 4194560 1234 0 0 0 250 50 0 0 20 0 7 0 98765 123456789 2048 18446744073709551615"
  let ps = parse_proc_stat(stat) ?? e => fault(e.msg)
  expect(ps) == (250, 50, 98765, 123456789)
  expect(parse_btime("cpu  1 2 3\nbtime 1719670000\nprocesses 9\n") ?? e => fault(e.msg)) == 1719670000
  expect(parse_vmrss("Name:\tx\nVmRSS:\t   2048 kB\n") ?? e => fault(e.msg)) == 2097152
  match parse_proc_stat("garbage") {
    Ok(_) => fault("garbage parsed")
    Err(e) => expect(e.msg) == "malformed /proc stat"
  }
}

test "pid_from_file and pid_collector (NewPidFileFn, ProcessCollectorOpts.PidFn)" uses (fs, proc) {
  let path = os.fs.create_temp(".", "pidfile") ?? e => fault("${e}")
  os.fs.write(path, b" 4242\n") ?? e => fault("${e}")
  expect(pid_from_file(os.fs, path) ?? e => fault(e.msg)) == 4242
  os.fs.write(path, b"x") ?? e => fault("${e}")
  match pid_from_file(os.fs, path) {
    Ok(_) => fault("x parsed")
    Err(e) => expect(e.msg) == "can't parse pid file ${path.quote()}"
  }
  os.fs.remove(path) ?? e => fault("${e}")
  let r = registry()
  let pc = r.pid_collector(namespace: "child")
  match pc.update(os.fs, os.proc.pid()) {
    // Linux: this process's own figures
    Ok(_) => {
      expect(pc.rss.get() > 0) == true
      expect(pc.start_ms.get() > 1000000000000) == true
      expect(r.text().contains("child_process_resident_memory_bytes ${num(Float(pc.rss.get()))}\n")) == true
    }
    // elsewhere there is no /proc
    Err(e) => expect(e.msg.starts_with("process metrics need /proc/")) == true
  }
}

test "values print as client_golang's text format: Go's shortest 'g', any zero 0 (metricsfuzz, task #261)" {
  let r = registry()
  let g = r.gauge("v", "", ["k"])
  g.set(1000000.0, ["a"])
  g.set(7.0e12, ["b"])
  g.set(1.0e301, ["c"])
  g.set(-0.0, ["d"])
  g.set(123456.0, ["e"])
  g.set(0.000012, ["f"])
  let t = r.text()
  expect(t.contains("v{k=\"a\"} 1e+06\n")) == true
  expect(t.contains("v{k=\"b\"} 7e+12\n")) == true
  expect(t.contains("v{k=\"c\"} 1e+301\n")) == true
  expect(t.contains("v{k=\"d\"} 0\n")) == true
  expect(t.contains("v{k=\"e\"} 123456\n")) == true
  expect(t.contains("v{k=\"f\"} 1.2e-05\n")) == true
}

test "a whole counter add up to 2^63 is exact, as client_golang's valInt (metricsfuzz seed 3, task #261)" {
  let r = registry()
  let c = r.counter("m", "", [])
  c.add(9.0e17)
  c.add(30.56306661486793)
  c.add(584.0)
  c.add(64.60991267343569)
  c.add(888.0)
  expect(r.text().contains("m 9.000000000000017e+17\n")) == true
}

test "whole counter adds past 2^63 wrap as client_golang's uint64 valInt (metricsfuzz seed 7, task #261)" {
  let r = registry()
  let c = r.counter("m", "", [])
  c.add(6.0e17)
  c.add(9.0e18)
  c.add(1.0e19)
  c.add(0.5)
  // 6e17 + 9e18 + 1e19 is 1.96e19, past 2^64: Go's uint64 wraps to
  // 1.96e19 - 2^64 = 1153255926290448384
  expect(r.text().contains("m 1.1532559262904484e+18\n")) == true
}
