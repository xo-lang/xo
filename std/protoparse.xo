// std/protoparse (decision 0530): a parser for `.proto` files (proto3), for `xo proto gen`.
// Pure.
//
// std/protoparse on the native backends (decision 0530): the lexer of a `.proto` file.

/// Where and why a parse failed; the position is 1 based.
pub struct ParseErr {
  pub line: Int
  pub col: Int
  pub msg: Str
}

/// `LINE:COL: MSG`.
pub fn (e: ParseErr) display() -> Str { "${e.line}:${e.col}: ${e.msg}" }

/// A token kind: an identifier (dots allowed inside, as in `foo.Bar`), an integer, a float, a
/// string literal (unquoted, escapes decoded), or one symbol character.
pub enum Kind {
  Ident
  Int
  Float
  Str
  Sym
}

pub struct Token {
  pub kind: Kind
  pub text: Str
  pub line: Int
  pub col: Int
  /// A string literal's bytes, escapes applied (text is the same read as UTF-8, lossy); empty for
  /// other kinds
  pub raw: Bytes = b""
  /// protoc's column (0 based; a tab moves to the next multiple of 8) of the token's first byte, and of
  /// the byte after it (source info spans)
  pub pcol: Int = 0
  pub pend: Int = 0
}

/// The tokens of `src` without comments (`//` and `/* */`). A token never spans lines except
/// inside a comment.
pub fn tokens(src: Str) -> List[Token] ! ParseErr { Ok(lex(src)?.tokens) }

/// A comment, kept for source info (`protodesc.build_with_source_info`): its text as written (a line
/// comment without its newline), protoc's line (0 based) and columns of its first byte and of the byte
/// after it, and the token it belongs to, `tok` (an index into the tokens, their count for the end of the
/// file), as that token's trailing comment or one of its leading ones (protocompile's lexer rules).
pub struct Comment {
  pub text: Str
  pub line: Int
  pub col: Int
  pub end_line: Int
  pub end_col: Int
  /// A line comment ended by a newline (source info keeps the newline).
  pub nl: Bool
  pub tok: Int
  pub trailing: Bool = false
}

/// The tokens and comments of a file, and protoc's position of its end (0 based line and column).
pub struct Lexed {
  pub tokens: List[Token]
  pub comments: List[Comment]
  pub eof_line: Int
  pub eof_col: Int
}

/// A cursor for protoc's columns on the line starting at byte `ls`: byte `i` is at column `c`.
struct Pc {
  ls: Int
  i: Int
  c: Int
}

/// Protoc's column of byte `to` on the line starting at byte `ls`: a byte is one column, a tab moves to
/// the next multiple of 8.
fn pc_at(b: Bytes, var pc: Pc, ls: Int, to: Int) -> Int {
  if pc.ls != ls || pc.i > to {
    pc.ls = ls
    pc.i = ls
    pc.c = 0
  }
  while pc.i < to {
    if Int(b[pc.i]) == 9 {
      pc.c += 8 - pc.c % 8
    } else {
      pc.c += 1
    }
    pc.i += 1
  }
  pc.c
}

/// The tokens of `src` with each token's protoc columns, and its comments, each given to the token
/// before it as a trailing comment or to the one after it as a leading one.
pub fn lex(src: Str) -> Lexed ! ParseErr {
  let b = src.bytes()
  var out: List[Token] = []
  var cs: List[Comment] = []
  var pc = Pc{ls: 0, i: 0, c: 0}
  var i = 0
  var line = 1
  var ls = 0
  while i < b.len() {
    let c = Int(b[i])
    let col = i - ls + 1
    if c == 10 {
      line += 1
      i += 1
      ls = i
    } else if c == 32 || c == 9 || c == 13 || c == 12 || c == 11 {
      i += 1
    } else if c == 47 && i + 1 < b.len() && Int(b[i + 1]) == 47 {
      let s = i
      while i < b.len() && Int(b[i]) != 10 { i += 1 }
      let pcs = pc_at(b, pc, ls, s)
      cs.push(Comment{text: src[s..i], line: line - 1, col: pcs, end_line: line - 1, end_col: pc_at(b, pc, ls, i), nl: i < b.len(), tok: out.len()})
    } else if c == 47 && i + 1 < b.len() && Int(b[i + 1]) == 42 {
      let s = i
      let sl = line - 1
      let scol = pc_at(b, pc, ls, s)
      i += 2
      var closed = false
      while i < b.len() {
        if Int(b[i]) == 42 && i + 1 < b.len() && Int(b[i + 1]) == 47 {
          i += 2
          closed = true
          break
        }
        if Int(b[i]) == 10 {
          line += 1
          ls = i + 1
        }
        i += 1
      }
      if !closed { return Err(ParseErr{line: sl + 1, col: col, msg: "unterminated comment"}) }
      cs.push(Comment{text: src[s..i], line: sl, col: scol, end_line: line - 1, end_col: pc_at(b, pc, ls, i), nl: false, tok: out.len()})
    } else if is_letter(c) {
      let s = i
      while i < b.len() && (is_letter(Int(b[i])) || is_digit(Int(b[i])) || Int(b[i]) == 46) { i += 1 }
      let pcs = pc_at(b, pc, ls, s)
      out.push(Token{kind: Kind.Ident, text: src[s..i], line: line, col: col, pcol: pcs, pend: pc_at(b, pc, ls, i)})
    } else if is_digit(c) || (c == 46 && i + 1 < b.len() && is_digit(Int(b[i + 1]))) {
      let s = i
      var fl = false
      while i < b.len() {
        let d = Int(b[i])
        if is_digit(d) || is_letter(d) {
          i += 1
        } else if d == 46 {
          fl = true
          i += 1
        } else if (d == 43 || d == 45) && (Int(b[i - 1]) == 101 || Int(b[i - 1]) == 69) && !(i - s > 1 && Int(b[s + 1]) == 120) {
          fl = true
          i += 1
        } else {
          break
        }
      }
      let t = src[s..i]
      let isf = fl || ((t.contains("e") || t.contains("E")) && !t.starts_with("0x") && !t.starts_with("0X"))
      // digits run into letters (`31reserved`): protocompile's lexer
      // rejects the number
      if Int.parse_base(t, 0) is None && Float.parse(t) is None {
        return Err(ParseErr{line: line, col: col, msg: "invalid syntax in ${if isf { "float" } else { "int" }} value: ${t}"})
      }
      let pcs = pc_at(b, pc, ls, s)
      out.push(Token{kind: if isf { Kind.Float } else { Kind.Int }, text: t, line: line, col: col, pcol: pcs, pend: pc_at(b, pc, ls, i)})
    } else if c == 34 || c == 39 {
      let s = i
      i += 1
      var sb = BytesBuilder.new()
      var closed = false
      while i < b.len() {
        let d = Int(b[i])
        if d == c {
          i += 1
          closed = true
          break
        }
        if d == 10 { break }
        if d == 92 && i + 1 < b.len() {
          i = str_escape(b, i, sb)
        } else {
          sb.write(b[i..i + 1])
          i += 1
        }
      }
      if !closed { return Err(ParseErr{line: line, col: col, msg: "unterminated string"}) }
      let pcs = pc_at(b, pc, ls, s)
      let raw = sb.freeze()
      out.push(Token{kind: Kind.Str, text: raw.to_str_lossy(), line: line, col: col, pcol: pcs, pend: pc_at(b, pc, ls, i), raw: raw})
    } else if c < 128 {
      let pcs = pc_at(b, pc, ls, i)
      out.push(Token{kind: Kind.Sym, text: src[i..i + 1], line: line, col: col, pcol: pcs, pend: pcs + 1})
      i += 1
    } else {
      return Err(ParseErr{line: line, col: col, msg: "unexpected character"})
    }
  }
  let eof_line = line - 1
  let eof_col = pc_at(b, pc, ls, b.len())
  attribute_comments(cs, out, eof_line)
  Ok(Lexed{tokens: out, comments: cs, eof_line: eof_line, eof_col: eof_col})
}

fn hex_val(c: Int) -> Int {
  if is_digit(c) { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  -1
}

/// The escape at b[i] (a backslash) of a string literal, written to sb as protoc reads it: `\n \t \r \a \b
/// \f \v \\ \' \" \?`, up to 3 octal digits, `\x` and up to 2 hex digits, `\u` and 4 or `\U` and 8 hex digits
/// (as UTF-8); any other character stands for itself. The index after it.
fn str_escape(b: Bytes, i0: Int, var sb: BytesBuilder) -> Int {
  var i = i0 + 1
  let e = Int(b[i])
  i += 1
  if e >= 48 && e <= 55 {
    var v = e - 48
    var n = 1
    while n < 3 && i < b.len() && Int(b[i]) >= 48 && Int(b[i]) <= 55 {
      v = v * 8 + Int(b[i]) - 48
      i += 1
      n += 1
    }
    sb.write_byte(UInt8.wrapping_from(v))
    return i
  }
  if (e == 120 || e == 88) && i < b.len() && hex_val(Int(b[i])) >= 0 {
    var v = 0
    var n = 0
    while n < 2 && i < b.len() && hex_val(Int(b[i])) >= 0 {
      v = v * 16 + hex_val(Int(b[i]))
      i += 1
      n += 1
    }
    sb.write_byte(UInt8.wrapping_from(v))
    return i
  }
  if e == 117 || e == 85 {
    let want = if e == 117 { 4 } else { 8 }
    var v = 0
    var n = 0
    while n < want && i < b.len() && hex_val(Int(b[i])) >= 0 {
      v = v * 16 + hex_val(Int(b[i]))
      i += 1
      n += 1
    }
    // the code point as UTF-8
    if v < 128 {
      sb.write_byte(UInt8.wrapping_from(v))
    } else if v < 2048 {
      sb.write_byte(UInt8.wrapping_from(192 | (v >> 6)))
      sb.write_byte(UInt8.wrapping_from(128 | (v & 63)))
    } else if v < 65536 {
      sb.write_byte(UInt8.wrapping_from(224 | (v >> 12)))
      sb.write_byte(UInt8.wrapping_from(128 | ((v >> 6) & 63)))
      sb.write_byte(UInt8.wrapping_from(128 | (v & 63)))
    } else {
      sb.write_byte(UInt8.wrapping_from(240 | ((v >> 18) & 7)))
      sb.write_byte(UInt8.wrapping_from(128 | ((v >> 12) & 63)))
      sb.write_byte(UInt8.wrapping_from(128 | ((v >> 6) & 63)))
      sb.write_byte(UInt8.wrapping_from(128 | (v & 63)))
    }
    return i
  }
  let c = match e {
    110 => 10
    116 => 9
    114 => 13
    97 => 7
    98 => 8
    102 => 12
    118 => 11
    _ => e
  }
  sb.write_byte(UInt8.wrapping_from(c))
  i
}

/// protocompile's lexer rule: of the comments between two tokens, the first is the earlier token's
/// trailing comment when it starts on that token's line, the later token (the end of the file counts
/// as on the next line) is on a later line, and it is a line comment, one of several, or a block
/// comment ending before the later token's line. The rest lead the later token.
fn attribute_comments(var cs: List[Comment], toks: List[Token], eof_line: Int) {
  var i = 0
  while i < cs.len() {
    let k = cs[i].tok
    var j = i
    while j < cs.len() && cs[j].tok == k { j += 1 }
    if k > 0 {
      let prev_end = toks[k - 1].line - 1
      var n_start = if k < toks.len() { toks[k].line - 1 } else { eof_line }
      if k == toks.len() && n_start == prev_end { n_start += 1 }
      let c = cs[i]
      if n_start > prev_end && c.line == prev_end && (c.text.starts_with("//") || j - i > 1 || c.end_line < n_start) {
        var t = c
        t.trailing = true
        t.tok = k - 1
        cs[i] = t
      }
    }
    i = j
  }
}

/// A field of a message. `typ` is the type as written (`int32`, `Other.Msg`); for a map it is the
/// value type and `key` the key type. `oneof` names the oneof it belongs to, or is empty.
pub struct Field {
  pub name: Str
  pub num: Int
  pub typ: Str
  pub key: Str
  pub repeated: Bool
  pub optional: Bool
  /// proto2 `required`
  pub required: Bool
  pub oneof: Str
  /// A proto2 `group`: `typ` is its nested message, `name` that name in lower case.
  pub group: Bool = false
  /// The `default` option's value as written (a string unquoted, its escapes applied, so a bytes
  /// default may hold any bytes).
  pub default_value: Bytes = b""
  /// The `json_name` option, empty when not given.
  pub json_name: Str = ""
  /// The field's other options, (name, value as written) in order.
  pub options: List[(Str, Bytes)] = []
}

/// An `extend NAME { ... }` block: the extended message as written and the extension fields.
pub struct Extend {
  pub extendee: Str
  pub fields: List[Field]
}

pub struct EnumValue {
  pub name: Str
  pub num: Int
  pub options: List[(Str, Bytes)] = []
}

pub struct Enum {
  pub name: Str
  pub values: List[EnumValue]
  pub options: List[(Str, Bytes)] = []
  /// `reserved` numbers, (start, end) with end included; `max` is 2147483647.
  pub reserved: List[(Int, Int)] = []
  pub reserved_names: List[Str] = []
}

pub struct Message {
  pub name: Str
  pub fields: List[Field]
  pub oneofs: List[Str]
  pub nested: List[Message]
  pub enums: List[Enum]
  pub options: List[(Str, Bytes)] = []
  /// `reserved` numbers, (start, end) with end included; `max` is 536870911.
  pub reserved: List[(Int, Int)] = []
  pub reserved_names: List[Str] = []
  /// `extensions` ranges, (start, end) with end included.
  pub extensions: List[(Int, Int)] = []
  /// Each range's options (those of its `extensions` statement), parallel to `extensions`.
  pub extension_options: List[List[(Str, Bytes)]] = []
  /// For each map field, in field order, how many of `nested` came before it (protoc puts a map's
  /// entry message among the nested messages where the field is).
  pub map_at: List[Int] = []
  /// `extend` blocks inside the message, in order.
  pub extends: List[Extend] = []
  /// Each oneof's options, parallel to `oneofs`.
  pub oneof_options: List[List[(Str, Bytes)]] = []
}

pub struct Rpc {
  pub name: Str
  pub req: Str
  pub resp: Str
  pub client_stream: Bool
  pub server_stream: Bool
  pub options: List[(Str, Bytes)] = []
  /// The rpc had a `{ ... }` body (protoc then writes its options message, also when empty).
  pub body: Bool = false
}

pub struct Service {
  pub name: Str
  pub rpcs: List[Rpc]
  pub options: List[(Str, Bytes)] = []
}

pub struct File {
  pub syntax: Str
  pub package: Str
  pub imports: List[Str]
  /// the imports marked `import public` (also in `imports`)
  pub public_imports: List[Str] = []
  pub messages: List[Message]
  pub enums: List[Enum]
  pub services: List[Service]
  pub options: List[(Str, Bytes)] = []
  /// the imports marked `import weak` (also in `imports`)
  pub weak_imports: List[Str] = []
  /// Top level `extend` blocks, in order.
  pub extends: List[Extend] = []
  /// An editions file's edition (`edition = "2023"`; syntax is then `editions`), else "".
  pub edition: Str = ""
}

/// Parses a proto3 or proto2 file. Options are kept as (name, value) pairs on the file, messages,
/// fields, enums, values, services and rpcs (an aggregate value as `{}`), with
/// a field's `default` and `json_name` in their own fields; `reserved` and `extensions` ranges and
/// names are kept; `extend` blocks are read and dropped. In proto2 every field outside a oneof needs a
/// label (`required`, `optional` or `repeated`); a `group` becomes a nested message and a field of
/// that type named in lower case. A proto3 file rejects `required` and `group`.
pub fn parse(src: Str) -> File ! ParseErr {
  // a file with no syntax statement is proto2, as protoc reads it
  var p = P{ts: tokens(src)?, at: 0, proto2: true}
  var f = File{syntax: "proto2", package: "", imports: [], messages: [], enums: [], services: []}
  while p.at < p.ts.len() {
    if p_is(p, "syntax") {
      p.at += 1
      p_expect(p, "=")?
      let sat = p.at
      f.syntax = p_str(p)?
      if !(f.syntax is "proto2" | "proto3") {
        p.at = sat
        return Err(p_err(p, "syntax value must be \"proto2\" or \"proto3\""))
      }
      p.proto2 = f.syntax == "proto2"
      p_expect(p, ";")?
    } else if p_is(p, "edition") {
      p.at += 1
      p_expect(p, "=")?
      let ed = p_str(p)?
      // protoc 36.2 compiles editions 2023 and 2024
      if !(ed is "2023" | "2024") {
        return Err(p_err(p, "edition ${ed.quote()} is not supported (2023 and 2024 are)"))
      }
      f.syntax = "editions"
      f.edition = ed
      p.editions = true
      p.proto2 = false
      p_expect(p, ";")?
    } else if p_is(p, "package") {
      p.at += 1
      f.package = p_type(p)?
      p_expect(p, ";")?
    } else if p_is(p, "import") {
      p.at += 1
      let public = p_is(p, "public")
      let weak = !public && p_is(p, "weak")
      if public || weak { p.at += 1 }
      let path = p_str(p)?
      f.imports.push(path)
      if public { f.public_imports.push(path) }
      if weak { f.weak_imports.push(path) }
      p_expect(p, ";")?
    } else if p_is(p, "option") {
      f.options.push(p_option_stmt(p)?)
    } else if p_is(p, "extend") {
      p.at += 1
      let (x, groups) = p_extend(p)?
      f.extends.push(x)
      for g in groups { f.messages.push(g) }
    } else if p_is(p, "message") {
      p.at += 1
      f.messages.push(p_message(p)?)
    } else if p_is(p, "enum") {
      p.at += 1
      f.enums.push(p_enum(p)?)
    } else if p_is(p, "service") {
      p.at += 1
      f.services.push(p_service(p)?)
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      return Err(p_err(p, "unexpected `${p_peek(p)}`"))
    }
  }
  Ok(f)
}

/// Xo source for the messages, enums and oneofs of `f`, using `derive Proto` (decision 0530):
/// a nested type `Inner` of `Outer` becomes `OuterInner`, a oneof `kind` of `Msg` the enum
/// `MsgKind` held in an optional field marked `proto "oneof"`, an enum an open `Int` enum with a
/// catch-all `Other(v: Int)`. Fields keep their proto names. Services are not generated here.
pub fn gen(f: File) -> Str ! ParseErr {
  let out = gen_set([("", f)])?
  Ok(out[0])
}

/// The Xo source of each file of a set, in the order given; each file is `(import path, File)`, the path as
/// other files of the set import it, or a path ending in `/` and that import path. A type resolves as protoc
/// resolves it: in the file's own package scopes first, then among the types of the files it imports and the
/// files those import with `import public`. The generated sources share one Xo package (`xo proto gen
/// --out=DIR`), so a message keeps the name `gen` gives it in its own file and every type is `pub`; an
/// enum of another file is taken as derive Proto takes it (decision 0683 item 4). A well-known type of
/// google/protobuf is std/protowkt's (`google.protobuf.Timestamp` is `protowkt.Timestamp`, and the
/// source starts `use std/protowkt`); any other type outside the set is an error.
pub fn gen_set(files: List[(Str, File)]) -> List[Str] ! ParseErr {
  var res: List[Str] = []
  for (_, f) in files {
    var names: List[(Str, Str)] = []
    names = g_names(f, names)
    var visible: List[Str] = []
    var queue = f.imports
    while !queue.is_empty() {
      let path = queue[0]
      queue = queue[1..]
      if visible.contains(path) { continue }
      visible.push(path)
      for (q, g) in files {
        if q != "" && (q == path || q.ends_with("/${path}")) {
          names = g_names(g, names)
          for pp in g.public_imports { queue.push(pp) }
        }
      }
    }
    let scope = if f.package == "" { "" } else { "${f.package}." }
    // the set's sources share one Xo package, so an enum's generated name is unique in the set
    var enums: List[Str] = []
    for (_, g) in files {
      for e in g.enums { enums.push(e.name) }
      for m in g.messages { enums = g_enum_gens("", m, enums) }
    }
    let pk = GenPack{proto2: f.syntax == "proto2", enums: enums, editions: f.syntax == "editions",
      presence: g_feature(f.options, "field_presence") ?? "EXPLICIT", repeated: g_feature(f.options, "repeated_field_encoding") ?? "PACKED",
      encoding: g_feature(f.options, "message_encoding") ?? "LENGTH_PREFIXED"}
    var o: List[Str] = []
    for e in f.enums { o = g_enum(e, e.name, o) }
    for m in f.messages { o = g_message(m, scope, "", names, pk, o)? }
    var src = o.join("\n")
    // a well-known type is std/protowkt's (decision 0683 item 4): the only use line gen writes
    if src.contains(": protowkt.") || src.contains("[protowkt.") || src.contains("(v: protowkt.") {
      src = "use std/protowkt\n\n${src}"
    }
    res.push(src)
  }
  Ok(res)
}

/// The declared names of `f`'s types, fully qualified by its package, with their generated names (the
/// same for an imported file's: the set's sources share one Xo package, and derive Proto takes an enum
/// of another file of it, decision 0683 item 4).
fn g_names(f: File, out: List[(Str, Str)]) -> List[(Str, Str)] {
  var names = out
  let pre = if f.package == "" { "" } else { "${f.package}." }
  for m in f.messages { names = g_collect(pre, "", m, names) }
  for e in f.enums { names.push(("${pre}${e.name}", e.name)) }
  names
}

fn is_letter(c: Int) -> Bool { (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 }

fn is_digit(c: Int) -> Bool { c >= 48 && c <= 57 }

struct P {
  ts: List[Token]
  at: Int
  proto2: Bool
  /// an editions file: no `optional`, `required` or `group`; reserved names are identifiers
  editions: Bool = false
}

fn p_err(p: P, msg: Str) -> ParseErr {
  if p.at < p.ts.len() {
    let t = p.ts[p.at]
    ParseErr{line: t.line, col: t.col, msg: msg}
  } else if p.ts.len() > 0 {
    let t = p.ts[p.ts.len() - 1]
    ParseErr{line: t.line, col: t.col + t.text.len(), msg: msg}
  } else {
    ParseErr{line: 1, col: 1, msg: msg}
  }
}

fn p_peek(p: P) -> Str { if p.at < p.ts.len() { p.ts[p.at].text } else { "" } }

fn p_is(p: P, s: Str) -> Bool {
  p.at < p.ts.len() && p.ts[p.at].text == s && p.ts[p.at].kind != Kind.Str
}

fn p_expect(var p: P, s: Str) ! ParseErr {
  if !p_is(p, s) { return Err(p_err(p, "expected `${s}`, found `${p_peek(p)}`")) }
  p.at += 1
  Ok(())
}

fn p_ident(var p: P) -> Str ! ParseErr {
  if p.at >= p.ts.len() || p.ts[p.at].kind != Kind.Ident {
    return Err(p_err(p, "expected a name, found `${p_peek(p)}`"))
  }
  p.at += 1
  Ok(p.ts[p.at - 1].text)
}

/// A type name, possibly starting with a dot. Its parts may be apart (`foo . Bar`, a comment or a line
/// between them), as protoc reads it.
fn p_type(var p: P) -> Str ! ParseErr {
  var s = ""
  if p_is(p, ".") {
    p.at += 1
    s = "."
  }
  s = s + p_ident(p)?
  while true {
    if s.ends_with(".") {
      s = s + p_ident(p)?
    } else if p_is(p, ".") && p.at + 1 < p.ts.len() && p.ts[p.at + 1].kind == Kind.Ident {
      p.at += 1
      s = s + "." + p_ident(p)?
    } else {
      break
    }
  }
  Ok(s)
}

fn p_int(var p: P) -> Int ! ParseErr {
  var neg = false
  if p_is(p, "-") {
    neg = true
    p.at += 1
  }
  if p.at >= p.ts.len() || p.ts[p.at].kind != Kind.Int {
    return Err(p_err(p, "expected an integer, found `${p_peek(p)}`"))
  }
  let t = p.ts[p.at].text
  let v = Int.parse_base(t, 0)
  match v {
    Some(n) => {
      p.at += 1
      Ok(if neg { -n } else { n })
    }
    None => Err(p_err(p, "bad integer `${t}`"))
  }
}

fn p_str(var p: P) -> Str ! ParseErr {
  Ok(p_str_bytes(p)?.to_str_lossy())
}

/// A string literal's bytes, adjacent literals concatenated: escapes that give invalid UTF-8 (`"\377"`)
/// keep their bytes, as protoc reads them.
fn p_str_bytes(var p: P) -> Bytes ! ParseErr {
  if p.at >= p.ts.len() || p.ts[p.at].kind != Kind.Str {
    return Err(p_err(p, "expected a string, found `${p_peek(p)}`"))
  }
  p.at += 1
  var s = p.ts[p.at - 1].raw
  // adjacent string literals concatenate
  while p.at < p.ts.len() && p.ts[p.at].kind == Kind.Str {
    s = s + p.ts[p.at].raw
    p.at += 1
  }
  Ok(s)
}

/// Skips tokens up to and including the next `;` outside brackets and braces.
fn p_skip_stmt(var p: P) ! ParseErr {
  var depth = 0
  while p.at < p.ts.len() {
    let t = p.ts[p.at]
    p.at += 1
    if t.kind == Kind.Sym {
      if t.text == "{" || t.text == "[" || t.text == "(" {
        depth += 1
      } else if t.text == "}" || t.text == "]" || t.text == ")" {
        depth -= 1
      } else if t.text == ";" && depth <= 0 {
        return Ok(())
      }
    }
  }
  Err(p_err(p, "unexpected end of file, expected `;`"))
}

/// `extend NAME { fields }` after `extend`: the fields as a message's, and the messages of its groups
/// (protoc puts them among the messages of the scope the `extend` is in, where it is).
fn p_extend(var p: P) -> (Extend, List[Message]) ! ParseErr {
  let name = p_type(p)?
  p_expect(p, "{")?
  var m = Message{name: name, fields: [], oneofs: [], nested: [], enums: []}
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated `extend` block")) }
    // protoc's grammar has no empty statement in an extend block
    // (protocompile: "syntax error: unexpected ';'"), unlike a message's
    if p_is(p, ";") {
      return Err(p_err(p, "syntax error: unexpected ';'"))
    }
    m = p_field(p, "", m)?
  }
  p.at += 1
  Ok((Extend{extendee: name, fields: m.fields}, m.nested))
}

/// `option NAME = VALUE;`: (NAME, VALUE as written; an aggregate `{ ... }` is `{}`).
fn p_option_stmt(var p: P) -> (Str, Bytes) ! ParseErr {
  p.at += 1
  let o = p_option(p)?
  p_expect(p, ";")?
  Ok(o)
}

/// `NAME = VALUE` of an option: NAME's tokens joined (`(my.ext).field`), VALUE a constant (a string
/// unquoted, a negative number with its sign) or an aggregate `{ key: value ... }`, kept as `{`, then
/// each key and value separated by U+1F and the pairs by U+1E, then `}` (`aggregate_pairs` reads
/// it); an aggregate holding another one is `{}`.
/// protocompile's keywords: its errors quote one (`unexpected "enum"`)
/// where another identifier is `identifier`.
const KEYWORDS = ["syntax", "edition", "import", "weak", "public", "package", "option", "true", "false", "inf", "nan", "repeated", "optional", "required", "double", "float", "int32", "int64", "uint32", "uint64", "sint32", "sint64", "fixed32", "fixed64", "sfixed32", "sfixed64", "bool", "string", "bytes", "group", "oneof", "map", "extensions", "to", "max", "reserved", "enum", "message", "extend", "service", "rpc", "stream", "returns"]

/// The types a map's key may have (protoc's mapKeyType).
const MAP_KEYS = ["int32", "int64", "uint32", "uint64", "sint32", "sint64", "fixed32", "fixed64", "sfixed32", "sfixed64", "bool", "string"]

/// The token at p as protocompile's syntax errors name it.
fn tok_desc(p: P) -> Str {
  if p.at >= p.ts.len() {
    return "EOF"
  }
  let t = p.ts[p.at]
  match t.kind {
    Kind.Int => "int literal"
    Kind.Float => "float literal"
    Kind.Str => "string literal"
    Kind.Sym => "'${t.text}'"
    Kind.Ident => if KEYWORDS.contains(t.text) { "\"${t.text}\"" } else { "identifier" }
  }
}

/// protocompile's syntax error at p: `syntax error: unexpected X`, and
/// `, expecting Y` when one token would do.
fn p_unexpected(p: P, expecting: Str = "") -> ParseErr {
  p_err(p, "syntax error: unexpected ${tok_desc(p)}" + (if expecting.is_empty() { "" } else { ", expecting ${expecting}" }))
}

fn p_ident_tok(p: P) -> Bool { p.at < p.ts.len() && p.ts[p.at].kind == Kind.Ident }

fn p_option(var p: P, compact: Bool = false) -> (Str, Bytes) ! ParseErr {
  // protoc's optionName: parts joined by `.`, each an identifier or a
  // parenthesized full name (`(my.ext)`, `(.pkg.ext)`)
  var name = ""
  while true {
    if p_is(p, "(") {
      name = name + "("
      p.at += 1
      if p_is(p, ".") {
        name = name + "."
        p.at += 1
      }
      if !p_ident_tok(p) { return Err(p_unexpected(p)) }
      name = name + p.ts[p.at].text
      p.at += 1
      while p_is(p, ".") && p.at + 1 < p.ts.len() && p.ts[p.at + 1].kind == Kind.Ident {
        name = name + "." + p.ts[p.at + 1].text
        p.at += 2
      }
      if !p_is(p, ")") { return Err(p_unexpected(p, "')'")) }
      name = name + ")"
      p.at += 1
    } else if p_ident_tok(p) {
      name = name + p.ts[p.at].text
      p.at += 1
    } else {
      return Err(p_unexpected(p))
    }
    if p_is(p, ".") {
      name = name + "."
      p.at += 1
      continue
    }
    break
  }
  if !p_is(p, "=") {
    if compact { return Err(p_err(p, "compact option must have a value")) }
    return Err(p_unexpected(p, "'='"))
  }
  p.at += 1
  if p_is(p, "{") {
    var pairs: List[Bytes] = []
    p_aggregate(p, "", pairs)?
    var sb = BytesBuilder.new()
    sb.write(b"{")
    var first = true
    for x in pairs {
      if !first { sb.write(b"\x1e") }
      first = false
      sb.write(x)
    }
    sb.write(b"}")
    return Ok((name, sb.freeze()))
  }
  Ok((name, p_constant(p)?))
}

/// An aggregate option value `{ key: value ... }` from its `{`: each scalar as `KEY\u{1f}VALUE` in
/// pairs, a nested message's keys joined to its own with a dot (`limits.min`), in the order written.
fn p_aggregate(var p: P, prefix: Str, var pairs: List[Bytes]) -> () ! ParseErr {
  let close = if p_is(p, "<") { ">" } else { "}" }
  p.at += 1
  while !p_is(p, close) {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated option value")) }
    if p_is(p, ",") || p_is(p, ";") {
      p.at += 1
      continue
    }
    // an extension (`[pkg.ext]`) or an Any's type URL (`[type.googleapis.com/pkg.Msg]`) is kept bracketed
    var name = ""
    if p_is(p, "[") {
      p.at += 1
      name = "["
      while !p_is(p, "]") {
        if p.at >= p.ts.len() { return Err(p_err(p, "unterminated `[` in an option value")) }
        name = name + p.ts[p.at].text
        p.at += 1
      }
      p.at += 1
      name = name + "]"
    } else {
      name = p_ident(p)?
    }
    let key = prefix + name
    if p_is(p, ":") { p.at += 1 }
    if p_is(p, "{") || p_is(p, "<") {
      pairs.push(key.bytes() + b"{\x1f")
      p_aggregate(p, key + ".", pairs)?
      continue
    }
    // a list `[a, b]` or `[{ ... }, { ... }]`: each element under the same key, in order
    if p_is(p, "[") {
      p.at += 1
      while !p_is(p, "]") {
        if p.at >= p.ts.len() { return Err(p_err(p, "unterminated list in an option value")) }
        if p_is(p, ",") {
          p.at += 1
        } else if p_is(p, "{") || p_is(p, "<") {
          pairs.push(key.bytes() + b"{\x1f")
          p_aggregate(p, key + ".", pairs)?
        } else {
          pairs.push(key.bytes() + b"\x1f" + p_constant(p)?)
        }
      }
      p.at += 1
      continue
    }
    pairs.push(key.bytes() + b"\x1f" + p_constant(p)?)
  }
  p.at += 1
}

/// The (key, value) pairs of an aggregate option value as `p_option` keeps it.
pub fn aggregate_pairs(v: Bytes) -> List[(Str, Bytes)] {
  aggregate_items(v).filter(fn(kv: (Str, Bytes)) -> Bool { !kv.0.ends_with("{") })
}

/// aggregate_pairs with an item (`KEY{`, "") where each nested message starts (`m { k: 1 } m { k: 2 }` is
/// `m{`, `m.k`, `m{`, `m.k`), so a repeated message field's elements stay apart.
pub fn aggregate_items(v: Bytes) -> List[(Str, Bytes)] {
  var out: List[(Str, Bytes)] = []
  if v.len() < 3 || !v.starts_with(b"{") || !v.ends_with(b"}") { return out }
  for pair in v[1..v.len() - 1].split(b"\x1e") {
    let kv = pair.split_n(b"\x1f", 2)
    if kv.len() == 2 { out.push((kv[0].to_str_lossy(), kv[1])) }
  }
  out
}

/// A constant: a string (adjacent ones joined, unquoted), or one token with an optional sign.
fn p_constant(var p: P) -> Bytes ! ParseErr {
  if p.at < p.ts.len() && p.ts[p.at].kind == Kind.Str {
    return p_str_bytes(p)
  }
  var v = ""
  if p_is(p, "-") || p_is(p, "+") {
    if p_is(p, "-") { v = "-" }
    p.at += 1
  }
  if p.at >= p.ts.len() { return Err(p_err(p, "expected an option value")) }
  // a constant: a number, or an identifier (true, an enum value, inf)
  if !(p.ts[p.at].kind is Kind.Int | Kind.Float | Kind.Ident) {
    return Err(p_unexpected(p))
  }
  v = v + p.ts[p.at].text
  p.at += 1
  Ok(v.bytes())
}

/// A `[ ... ]` option list when present.
fn p_opts(var p: P) -> List[(Str, Bytes)] ! ParseErr {
  var out: List[(Str, Bytes)] = []
  if !p_is(p, "[") { return Ok(out) }
  p.at += 1
  while true {
    out.push(p_option(p, compact: true)?)
    if p_is(p, ",") {
      p.at += 1
    } else {
      break
    }
  }
  p_expect(p, "]")?
  Ok(out)
}

/// `reserved` or `extensions` ranges (`1, 5 to 9, 20 to max`), or reserved names (`"a", "b"`), up to `;`.
fn p_ranges(var p: P, max: Int) -> (List[(Int, Int)], List[Str]) ! ParseErr {
  let (rs, ns, _) = p_ranges_opts(p, max)?
  Ok((rs, ns))
}

/// p_ranges, and the statement's `[ ... ]` options.
fn p_ranges_opts(var p: P, max: Int) -> (List[(Int, Int)], List[Str], List[(Str, Bytes)]) ! ParseErr {
  p.at += 1
  var rs: List[(Int, Int)] = []
  var ns: List[Str] = []
  while true {
    if p.at < p.ts.len() && p.ts[p.at].kind == Kind.Str {
      if p.editions { return Err(p_err(p, "reserved names are identifiers in editions, not strings")) }
      ns.push(p_str(p)?)
    } else if p.editions && p.at < p.ts.len() && p.ts[p.at].kind == Kind.Ident {
      ns.push(p_ident(p)?)
    } else {
      let a = p_int(p)?
      var b = a
      if p_is(p, "to") {
        p.at += 1
        if p_is(p, "max") {
          p.at += 1
          b = max
        } else {
          b = p_int(p)?
        }
      }
      rs.push((a, b))
    }
    if p_is(p, ",") {
      p.at += 1
    } else {
      break
    }
  }
  let opts = p_opts(p)?
  p_expect(p, ";")?
  Ok((rs, ns, opts))
}

/// The indexes of rs sorted by start, then end (protocompile's tagRanges).
fn range_order(rs: List[(Int, Int)]) -> List[Int] {
  var idx: List[Int] = []
  for i in 0..rs.len() {
    var j = idx.len()
    idx.push(i)
    while j > 0 && (rs[idx[j - 1]].0 > rs[i].0 || (rs[idx[j - 1]].0 == rs[i].0 && rs[idx[j - 1]].1 > rs[i].1)) {
      idx[j] = idx[j - 1]
      j -= 1
    }
    idx[j] = i
  }
  idx
}

/// protocompile's validate.go: ranges (end included) that overlap, sorted,
/// fail at the later one's statement (at, a token index per range).
fn check_overlap(var p: P, scope: Str, what: Str, rs: List[(Int, Int)], at: List[Int]) ! ParseErr {
  let o = range_order(rs)
  for k in 1..o.len() {
    let (a, b) = rs[o[k - 1]]
    let (c, d) = rs[o[k]]
    if c <= b {
      p.at = at[o[k]]
      return Err(p_err(p, "${scope}: ${what} ranges overlap: ${a} to ${b} and ${c} to ${d}"))
    }
  }
  Ok(())
}

/// protocompile's check that no extension range overlaps a reserved one
/// (its merge of the two sorted lists).
fn check_ext_reserved(var p: P, scope: Str, rs: List[(Int, Int)], rat: List[Int], xs: List[(Int, Int)], xat: List[Int]) ! ParseErr {
  let ro = range_order(rs)
  let xo = range_order(xs)
  var i = 0
  var j = 0
  while i < ro.len() && j < xo.len() {
    let (rs0, re) = rs[ro[i]]
    let (xs0, xe) = xs[xo[j]]
    let r_in_x = rs0 >= xs0 && rs0 <= xe
    if r_in_x || (xs0 >= rs0 && xs0 <= re) {
      p.at = if r_in_x { rat[ro[i]] } else { xat[xo[j]] }
      return Err(p_err(p, "${scope}: extension range ${xs0} to ${xe} overlaps reserved range ${rs0} to ${re}"))
    }
    if rs0 < xs0 { i += 1 } else { j += 1 }
  }
  Ok(())
}

fn p_enum(var p: P) -> Enum ! ParseErr {
  let name = p_ident(p)?
  p_expect(p, "{")?
  var e = Enum{name: name, values: []}
  // token indexes for the checks at the end: allow_alias's value, each
  // value's number, each reserved range's statement
  var alias_at = -1
  var val_at: List[Int] = []
  var rsv_at: List[Int] = []
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated enum `${name}`")) }
    if p_is(p, "option") {
      let at = p.at
      let o = p_option_stmt(p)?
      if o.0 == "allow_alias" {
        alias_at = if o.1 == b"true" { at + 3 } else { -1 }
      }
      e.options.push(o)
    } else if p_is(p, "reserved") {
      let at = p.at
      let (rs, ns) = p_ranges(p, 2147483647)?
      for r in rs {
        e.reserved.push(r)
        rsv_at.push(at)
      }
      for n in ns { e.reserved_names.push(n) }
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      let vn = p_ident(p)?
      p_expect(p, "=")?
      val_at.push(p.at)
      let n = p_int(p)?
      let opts = p_opts(p)?
      p_expect(p, ";")?
      e.values.push(EnumValue{name: vn, num: n, options: opts})
    }
  }
  let end = p.at
  // protocompile's validateEnum: aliases, then reserved ranges
  let scope = "enum ${name}"
  var has_alias = false
  for i in 0..e.values.len() {
    for j in 0..i {
      if e.values[j].num == e.values[i].num {
        if alias_at < 0 {
          p.at = val_at[i]
          return Err(p_err(p, "${scope}: values ${e.values[j].name} and ${e.values[i].name} both have the same numeric value ${e.values[i].num}; use allow_alias option if intentional"))
        }
        has_alias = true
      }
    }
  }
  if alias_at >= 0 && !has_alias {
    p.at = alias_at
    return Err(p_err(p, "${scope}: allow_alias is true but no values are aliases"))
  }
  check_overlap(p, scope, "reserved", e.reserved, rsv_at)?
  p.at = end + 1
  Ok(e)
}

fn p_field(var p: P, oneof: Str, var m: Message) -> Message ! ParseErr {
  var repeated = false
  var optional = false
  var required = false
  var labeled = false
  if oneof == "" {
    if p_is(p, "repeated") {
      repeated = true
      labeled = true
      p.at += 1
    } else if p_is(p, "optional") {
      if p.editions { return Err(p_err(p, "`optional` is not allowed in editions (presence is features.field_presence)")) }
      optional = true
      labeled = true
      p.at += 1
    } else if p_is(p, "required") {
      if p.editions { return Err(p_err(p, "`required` is not allowed in editions (use features.field_presence = LEGACY_REQUIRED)")) }
      if !p.proto2 { return Err(p_err(p, "`required` is proto2 only")) }
      required = true
      labeled = true
      p.at += 1
    }
    // a map field takes no label in proto2 either
    let is_map = p_is(p, "map") && p.at + 1 < p.ts.len() && p.ts[p.at + 1].text == "<"
    if p.proto2 && !labeled && !is_map {
      return Err(p_err(p, "proto2 field needs `required`, `optional` or `repeated`, found `${p_peek(p)}`"))
    }
  }
  if p_is(p, "group") {
    if p.editions { return Err(p_err(p, "`group` is not allowed in editions (use features.message_encoding = DELIMITED)")) }
    if !p.proto2 { return Err(p_err(p, "`group` is proto2 only")) }
    p.at += 1
    let gname = p_ident(p)?
    let g0 = if gname.len() > 0 { Int(gname.bytes()[0]) } else { 0 }
    if !(g0 >= 65 && g0 <= 90) {
      p.at -= 1
      return Err(p_err(p, "group ${gname} should have a name that starts with a capital letter"))
    }
    p_expect(p, "=")?
    if p_is(p, "-") { return Err(p_unexpected(p, "int literal")) }
    let gn = p_int(p)?
    let (opts, dv, jn) = field_opts(p_opts(p)?)
    m.nested.push(p_message_body(p, gname)?)
    m.fields.push(Field{name: gname.to_lower(), num: gn, typ: gname, key: "", repeated: repeated, optional: optional, required: required, oneof: oneof, group: true, default_value: dv, json_name: jn, options: opts})
    return Ok(m)
  }
  var key = ""
  var typ = ""
  if p_is(p, "map") && p.at + 1 < p.ts.len() && p.ts[p.at + 1].text == "<" {
    p.at += 2
    if !(p_ident_tok(p) && MAP_KEYS.contains(p.ts[p.at].text)) {
      return Err(p_unexpected(p))
    }
    key = p_ident(p)?
    p_expect(p, ",")?
    typ = p_type(p)?
    p_expect(p, ">")?
  } else {
    typ = p_type(p)?
  }
  let name = p_ident(p)?
  p_expect(p, "=")?
  // a field number has no sign (protoc's grammar)
  if p_is(p, "-") { return Err(p_unexpected(p, "int literal")) }
  let n = p_int(p)?
  let (opts, dv, jn) = field_opts(p_opts(p)?)
  p_expect(p, ";")?
  if !key.is_empty() {
    m.map_at.push(m.nested.len())
  }
  m.fields.push(Field{name: name, num: n, typ: typ, key: key, repeated: repeated, optional: optional, required: required, oneof: oneof, default_value: dv, json_name: jn, options: opts})
  Ok(m)
}

/// A field's options without the `default` and `json_name` pseudo options, and those two.
fn field_opts(all: List[(Str, Bytes)]) -> (List[(Str, Bytes)], Bytes, Str) {
  var opts: List[(Str, Bytes)] = []
  var dv = b""
  var jn = ""
  for (k, v) in all {
    if k == "default" {
      dv = v
    } else if k == "json_name" {
      jn = v.to_str_lossy()
    } else {
      opts.push((k, v))
    }
  }
  (opts, dv, jn)
}

fn p_message(var p: P) -> Message ! ParseErr {
  let name = p_ident(p)?
  p_message_body(p, name)
}

fn p_message_body(var p: P, name: Str) -> Message ! ParseErr {
  p_expect(p, "{")?
  var m = Message{name: name, fields: [], oneofs: [], nested: [], enums: []}
  // each reserved and extensions range's statement (token index)
  var rsv_at: List[Int] = []
  var ext_at: List[Int] = []
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated message `${name}`")) }
    if p_is(p, "message") {
      p.at += 1
      m.nested.push(p_message(p)?)
    } else if p_is(p, "enum") {
      p.at += 1
      m.enums.push(p_enum(p)?)
    } else if p_is(p, "option") {
      m.options.push(p_option_stmt(p)?)
    } else if p_is(p, "reserved") {
      let at = p.at
      let (rs, ns) = p_ranges(p, 536870911)?
      for r in rs {
        m.reserved.push(r)
        rsv_at.push(at)
      }
      for n in ns { m.reserved_names.push(n) }
    } else if p_is(p, "extensions") {
      let at = p.at
      let (rs, _, opts) = p_ranges_opts(p, 536870911)?
      for r in rs {
        m.extensions.push(r)
        m.extension_options.push(opts)
        ext_at.push(at)
      }
    } else if p_is(p, "extend") {
      p.at += 1
      let (x, groups) = p_extend(p)?
      m.extends.push(x)
      for g in groups { m.nested.push(g) }
    } else if p_is(p, "oneof") {
      p.at += 1
      let on = p_ident(p)?
      p_expect(p, "{")?
      m.oneofs.push(on)
      var oo: List[(Str, Bytes)] = []
      while !p_is(p, "}") {
        if p.at >= p.ts.len() { return Err(p_err(p, "unterminated oneof `${on}`")) }
        if p_is(p, "option") {
          oo.push(p_option_stmt(p)?)
        } else {
          m = p_field(p, on, m)?
        }
      }
      m.oneof_options.push(oo)
      p.at += 1
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      m = p_field(p, "", m)?
    }
  }
  // protocompile's validateMessage: reserved ranges, extension ranges,
  // then one against the other
  let end = p.at
  let scope = "message ${name}"
  check_overlap(p, scope, "reserved", m.reserved, rsv_at)?
  check_overlap(p, scope, "extension", m.extensions, ext_at)?
  check_ext_reserved(p, scope, m.reserved, rsv_at, m.extensions, ext_at)?
  p.at = end + 1
  Ok(m)
}

fn p_service(var p: P) -> Service ! ParseErr {
  let name = p_ident(p)?
  p_expect(p, "{")?
  var rpcs: List[Rpc] = []
  var sopts: List[(Str, Bytes)] = []
  while !p_is(p, "}") {
    if p.at >= p.ts.len() { return Err(p_err(p, "unterminated service `${name}`")) }
    if p_is(p, "option") {
      sopts.push(p_option_stmt(p)?)
    } else if p_is(p, ";") {
      p.at += 1
    } else {
      p_expect(p, "rpc")?
      let rn = p_ident(p)?
      p_expect(p, "(")?
      var cs = false
      if p_is(p, "stream") {
        cs = true
        p.at += 1
      }
      let req = p_type(p)?
      p_expect(p, ")")?
      p_expect(p, "returns")?
      p_expect(p, "(")?
      var ss = false
      if p_is(p, "stream") {
        ss = true
        p.at += 1
      }
      let resp = p_type(p)?
      p_expect(p, ")")?
      var ropts: List[(Str, Bytes)] = []
      let body = p_is(p, "{")
      if body {
        // the rpc's options block
        p.at += 1
        while !p_is(p, "}") {
          if p.at >= p.ts.len() { return Err(p_err(p, "unterminated rpc `${rn}`")) }
          if p_is(p, "option") {
            ropts.push(p_option_stmt(p)?)
          } else if p_is(p, ";") {
            p.at += 1
          } else {
            return Err(p_err(p, "unexpected `${p_peek(p)}` in rpc `${rn}`"))
          }
        }
        p.at += 1
      } else {
        p_expect(p, ";")?
      }
      rpcs.push(Rpc{name: rn, req: req, resp: resp, client_stream: cs, server_stream: ss, options: ropts, body: body})
    }
  }
  p.at += 1
  Ok(Service{name: name, rpcs: rpcs, options: sopts})
}

fn g_camel(s: Str) -> Str {
  var o = ""
  for part in s.split("_") {
    if part.is_empty() { continue }
    o = o + part[0..1].to_upper() + part[1..]
  }
  o
}

/// std/protowkt's type for a well-known type of google/protobuf (`google.protobuf.Timestamp`), None
/// for any other name.
fn g_wkt(typ: Str) -> Str? {
  let t = typ.trim_prefix(".")
  if !t.starts_with("google.protobuf.") { return None }
  let n = t["google.protobuf.".len()..t.len()]
  if n is "Timestamp" | "Duration" | "Empty" | "FieldMask" | "Any" | "Struct" | "Value" | "ListValue" | "DoubleValue" | "FloatValue" | "Int64Value" | "UInt64Value" | "Int32Value" | "UInt32Value" | "BoolValue" | "StringValue" | "BytesValue" {
    return Some("protowkt.${n}")
  }
  None
}

/// The Xo type name of a scalar proto type, with the field option it needs.
fn g_scalar(t: Str) -> (Str, Str)? {
  match t {
    "int64" => Some(("Int", ""))
    "int32" => Some(("Int32", ""))
    "uint32" => Some(("UInt32", ""))
    "uint64" => Some(("UInt64", ""))
    "sint32" => Some(("Int32", ",zigzag"))
    "sint64" => Some(("Int", ",zigzag"))
    "fixed32" => Some(("UInt32", ",fixed"))
    "fixed64" => Some(("UInt64", ",fixed"))
    "sfixed32" => Some(("Int32", ",fixed"))
    "sfixed64" => Some(("Int", ",fixed"))
    "double" => Some(("Float", ""))
    "float" => Some(("Float32", ""))
    "bool" => Some(("Bool", ""))
    "string" => Some(("Str", ""))
    "bytes" => Some(("Bytes", ""))
    _ => None
  }
}

/// Every type name declared in the file as (full dotted name inside the package, generated name).
fn g_collect(prefix_dot: Str, prefix_gen: Str, m: Message, out: List[(Str, Str)]) -> List[(Str, Str)] {
  var o = out
  let d = "${prefix_dot}${m.name}"
  let g = "${prefix_gen}${m.name}"
  o.push((d, g))
  for e in m.enums { o.push(("${d}.${e.name}", "${g}${e.name}")) }
  for n in m.nested { o = g_collect("${d}.", g, n, o) }
  o
}

/// Resolves a type name used in the scope `scope` (the dotted name of the enclosing message)
/// the way protoc does: the innermost scope that declares the first component wins.
fn g_resolve(typ: Str, scope: Str, names: List[(Str, Str)]) -> Str? {
  var t = typ
  if t.starts_with(".") { t = t[1..] }
  var sc = scope
  while true {
    let cand = if sc == "" { t } else { "${sc}.${t}" }
    for (d, g) in names { if d == cand { return Some(g) } }
    if sc == "" { break }
    sc = match sc.rfind(".") {
      Some(at) => sc[0..at]
      None => ""
    }
  }
  // a name qualified by the package: keep the last components that match
  for (d, g) in names { if t.ends_with(".${d}") { return Some(g) } }
  None
}

fn g_enum(e: Enum, gname: Str, out: List[Str]) -> List[Str] {
  var o = out
  o.push("pub enum ${gname}: Int {")
  var seen: List[Int] = []
  for v in e.values {
    // an alias of an earlier number is dropped
    if seen.contains(v.num) { continue }
    seen.push(v.num)
    o.push("  ${g_camel(v.name.to_lower())} = ${v.num}")
  }
  o.push("  Other(v: Int)")
  o.push("}")
  o.push("")
  o
}

/// What gen needs to write a repeated field unpacked as protoc does: the file's syntax and the generated
/// names of its enums.
struct GenPack {
  proto2: Bool
  enums: List[Str]
  /// an editions file, with its file level field_presence, repeated_field_encoding and
  /// message_encoding (the edition 2023 defaults EXPLICIT, PACKED and LENGTH_PREFIXED)
  editions: Bool = false
  presence: Str = "EXPLICIT"
  repeated: Str = "PACKED"
  encoding: Str = "LENGTH_PREFIXED"
}

/// The value of the `features.NAME` option in opts, None when not set.
fn g_feature(opts: List[(Str, Bytes)], name: Str) -> Str? {
  var v: Str? = None
  for (k, x) in opts {
    if k == "features.${name}" { v = Some(x.to_str_lossy()) }
  }
  v
}

/// The generated names of the enums nested in m, appended to out.
fn g_enum_gens(prefix_gen: Str, m: Message, out: List[Str]) -> List[Str] {
  var o = out
  let g = "${prefix_gen}${m.name}"
  for e in m.enums { o.push("${g}${e.name}") }
  for n in m.nested { o = g_enum_gens(g, n, o) }
  o
}

/// True when a repeated field of type typ (generated as gtyp) goes on the wire unpacked, one element per
/// key: a number, Bool or enum in a proto2 file unless `[packed = true]`, or in proto3 with
/// `[packed = false]` (protoc's encoding; `derive Proto` packs by default).
fn g_unpacked(fl: Field, gtyp: Str, pk: GenPack) -> Bool {
  let packable = match g_scalar(fl.typ) {
    Some(_) => !(fl.typ is "string" | "bytes")
    None => pk.enums.contains(gtyp)
  }
  if !packable { return false }
  if pk.editions {
    return (g_feature(fl.options, "repeated_field_encoding") ?? pk.repeated) == "EXPANDED"
  }
  var packed = !pk.proto2
  for (k, v) in fl.options {
    if k == "packed" { packed = v == b"true" }
  }
  !packed
}

/// Whether fl's message is written as a group: proto2's `group`, or editions'
/// `features.message_encoding = DELIMITED` on the field or the file. A scalar,
/// enum or map field ignores the feature, as protoc does.
fn g_delimited(fl: Field, msg: Bool, pk: GenPack) -> Bool {
  fl.group || (msg && fl.key == "" && (g_feature(fl.options, "message_encoding") ?? pk.encoding) == "DELIMITED")
}

/// Whether field fl, generated as gtyp, holds a message (not a scalar or an enum).
fn g_is_msg(fl: Field, gtyp: Str, pk: GenPack) -> Bool {
  g_scalar(fl.typ) is None && !pk.enums.contains(gtyp)
}

fn g_message(m: Message, scope: Str, gprefix: Str, names: List[(Str, Str)], pk: GenPack, out: List[Str]) -> List[Str] ! ParseErr {
  var o = out
  let d = "${scope}${m.name}"
  let g = "${gprefix}${m.name}"
  for n in m.nested { o = g_message(n, "${d}.", g, names, pk, o)? }
  for e in m.enums { o = g_enum(e, "${g}${e.name}", o) }
  // oneof enums first
  for on in m.oneofs {
    o.push("pub enum ${g}${g_camel(on)} {")
    for fl in m.fields {
      if fl.oneof != on { continue }
      let ty = g_type(fl.typ, d, names)?
      if g_delimited(fl, g_is_msg(fl, ty.0, pk), pk) {
        // derive Proto writes a oneof variant length prefixed; a group's start and end tags would be wrong bytes
        return Err(ParseErr{line: 0, col: 0, msg: "field `${fl.name}` of `${m.name}` is a group (delimited encoding) in a oneof, which derive Proto does not write"})
      }
      o.push("  ${g_camel(fl.name)} as \"${fl.num}\"(v: ${ty.0})")
    }
    o.push("} derive Proto")
    o.push("")
  }
  o.push("pub struct ${g} {")
  var done: List[Str] = []
  for fl in m.fields {
    if fl.oneof != "" {
      if done.contains(fl.oneof) { continue }
      done.push(fl.oneof)
      o.push("  pub ${fl.oneof} proto \"oneof\": ${g}${g_camel(fl.oneof)}?")
      continue
    }
    let ty = g_type(fl.typ, d, names)?
    var tx = ty.0
    if fl.key != "" {
      let kt = g_type(fl.key, d, names)?
      tx = "Map[${kt.0}, ${ty.0}]"
    } else if fl.repeated {
      tx = "List[${tx}]"
    } else if fl.optional {
      tx = "${tx}?"
    } else if pk.editions && (g_feature(fl.options, "field_presence") ?? pk.presence) == "EXPLICIT" {
      // edition 2023: a singular field has presence unless IMPLICIT (or LEGACY_REQUIRED, a plain field
      // as proto2's required)
      tx = "${tx}?"
    }
    var opts = if fl.key != "" { "" } else { ty.1 }
    if g_delimited(fl, g_is_msg(fl, ty.0, pk), pk) {
      // a proto2 group or an editions DELIMITED message: start and end tags, no length (decision 0530)
      opts = "${opts},group"
    }
    if fl.repeated && fl.key == "" && g_unpacked(fl, ty.0, pk) {
      opts = "${opts},unpacked"
    }
    o.push("  pub ${fl.name} proto \"${fl.num}${opts}\": ${tx}")
  }
  o.push("} derive Proto")
  o.push("")
  Ok(o)
}

fn g_type(typ: Str, scope: Str, names: List[(Str, Str)]) -> (Str, Str) ! ParseErr {
  if let Some(s) = g_scalar(typ) { return Ok(s) }
  match g_resolve(typ, scope, names) {
    Some(g) => {
      Ok((g, ""))
    }
    None => match g_wkt(typ) {
      Some(w) => Ok((w, ""))
      None => Err(ParseErr{line: 0, col: 0, msg: "unknown type `${typ}`"})
    }
  }
}
