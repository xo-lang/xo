const ESCAPED_CHARS = "&'<>\"\r"

fn escape_into(var out: StrBuilder, s: Str) {
  var rest = s
  while true {
    match rest.find_any(ESCAPED_CHARS) {
      Some(i) => {
        out.write(rest[0..i])
        let c = rest.bytes()[i]
        if c == 38 {
          out.write("&amp;")
        } else if c == 39 {
          out.write("&#39;")
        } else if c == 60 {
          out.write("&lt;")
        } else if c == 62 {
          out.write("&gt;")
        } else if c == 34 {
          out.write("&#34;")
        } else {
          out.write("&#13;")
        }
        rest = rest[i + 1..]
      }
      None => {
        out.write(rest)
        break
      }
    }
  }
}

/// escapeComment: every `&`, and a `>` at the start of the data or after `!` or `-`.
fn escape_comment_into(var out: StrBuilder, s: Str) {
  if s.len() == 0 {
    return
  }
  let b = s.bytes()
  var i = 0
  var j = 0
  while j < b.len() {
    var esc = ""
    if b[j] == 38 {
      esc = "&amp;"
    } else if b[j] == 62 {
      if j > 0 {
        let prev = b[j - 1]
        if prev != 33 && prev != 45 {
          j += 1
          continue
        }
      }
      esc = "&gt;"
    } else {
      j += 1
      continue
    }
    if i < j {
      out.write(s[i..j])
    }
    out.write(esc)
    i = j + 1
    j += 1
  }
  if i < b.len() {
    out.write(s[i..])
  }
}

fn is_void_element(d: Str) -> Bool {
  match d {
    "area" | "base" | "br" | "col" | "embed" | "hr" | "img" | "input" | "keygen" | "link" | "meta" | "param" |
    "source" | "track" | "wbr" => true
    _ => false
  }
}

/// childTextNodesAreLiteral: the text of a script-like element is written as is, when the parser would keep the
/// element in the html namespace on re-parse.
fn child_text_nodes_are_literal(p: Tree, n: Int) -> Bool {
  if p.nodes[n].namespace.len() != 0 {
    return false
  }
  match p.nodes[n].data {
    "iframe" | "noembed" | "noframes" | "noscript" | "plaintext" | "script" | "style" | "xmp" => {
      var c = n
      var par = p.nodes[n].parent
      while par != -1 {
        if p.nodes[par].namespace.len() != 0 && p.nodes[par].namespace != p.nodes[c].namespace && !html_integration_point_t(p, par) {
          return false
        }
        c = par
        par = p.nodes[par].parent
      }
      true
    }
    _ => false
  }
}

fn html_integration_point_t(t: Tree, n: Int) -> Bool {
  if t.nodes[n].typ != NodeType.Element {
    return false
  }
  let ns = t.nodes[n].namespace
  let d = t.nodes[n].data
  if ns == "math" {
    if d == "annotation-xml" {
      for a in t.nodes[n].attrs {
        if a.key == "encoding" && (a.val.equal_fold("text/html") || a.val.equal_fold("application/xhtml+xml")) {
          return true
        }
      }
    }
  } else if ns == "svg" {
    return d == "desc" || d == "foreignObject" || d == "title"
  }
  false
}

fn write_doctype_quoted(var out: StrBuilder, s: Str) -> Str {
  var q = "\""
  if s.contains("\"") {
    if s.contains("'") {
      return "doctype contains both quote types, cannot be safely rendered"
    }
    q = "'"
  }
  out.write(q)
  out.write(s.replace(">", "&gt;"))
  out.write(q)
  ""
}

const PLAINTEXT_ABORT = "html: internal error (plaintext abort)"

/// render1: "" on success, PLAINTEXT_ABORT after a plaintext element, else the error text.
fn render1(t: Tree, var out: StrBuilder, n: Int) -> Str {
  let node = t.nodes[n]
  match node.typ {
    NodeType.Error => {
      return "html: cannot render an ErrorNode node"
    }
    NodeType.Text => {
      escape_into(out, node.data)
      return ""
    }
    NodeType.Document => {
      var c = node.first_child
      while c != -1 {
        let e = render1(t, out, c)
        if e != "" {
          return e
        }
        c = t.nodes[c].next
      }
      return ""
    }
    NodeType.Element => {}
    NodeType.Comment => {
      out.write("<!--")
      escape_comment_into(out, node.data)
      out.write("-->")
      return ""
    }
    NodeType.Doctype => {
      out.write("<!DOCTYPE ")
      escape_into(out, node.data)
      if node.attrs.len() > 0 {
        var pubid = ""
        var sys = ""
        for a in node.attrs {
          if a.key == "public" {
            pubid = a.val
          } else if a.key == "system" {
            sys = a.val
          }
        }
        if pubid != "" {
          out.write(" PUBLIC ")
          let e = write_doctype_quoted(out, pubid)
          if e != "" {
            return e
          }
          if sys != "" {
            out.write(" ")
            let e2 = write_doctype_quoted(out, sys)
            if e2 != "" {
              return e2
            }
          }
        } else if sys != "" {
          out.write(" SYSTEM ")
          let e = write_doctype_quoted(out, sys)
          if e != "" {
            return e
          }
        }
      }
      out.write(">")
      return ""
    }
    NodeType.Raw => {
      out.write(node.data)
      return ""
    }
  }
  out.write("<")
  out.write(node.data)
  for a in node.attrs {
    out.write(" ")
    if a.namespace.len() != 0 {
      out.write(a.namespace)
      out.write(":")
    }
    out.write(a.key)
    out.write("=\"")
    escape_into(out, a.val)
    out.write("\"")
  }
  if is_void_element(node.data) {
    if node.first_child != -1 {
      return "html: void element <${node.data}> has child nodes"
    }
    out.write("/>")
    return ""
  }
  out.write(">")
  let fc = node.first_child
  if fc != -1 && t.nodes[fc].typ == NodeType.Text && t.nodes[fc].data.starts_with("\n") {
    if node.data == "pre" || node.data == "listing" || node.data == "textarea" {
      out.write("\n")
    }
  }
  if child_text_nodes_are_literal(t, n) {
    var c = node.first_child
    while c != -1 {
      if t.nodes[c].typ == NodeType.Text {
        out.write(t.nodes[c].data)
      } else {
        let e = render1(t, out, c)
        if e != "" {
          return e
        }
      }
      c = t.nodes[c].next
    }
    if node.data == "plaintext" {
      return PLAINTEXT_ABORT
    }
  } else {
    var c = node.first_child
    while c != -1 {
      let e = render1(t, out, c)
      if e != "" {
        return e
      }
      c = t.nodes[c].next
    }
  }
  out.write("</")
  out.write(node.data)
  out.write(">")
  ""
}
