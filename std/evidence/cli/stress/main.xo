// cli stress program (decision 0616 section 2): 64 tasks declare 64 commands
// (single_dash_long and stop_at_positional, long flags of every kind) and parse
// their argument lists against Go's flag package (the seed 1 rows of
// internal/stdtest/clifuzz_test.go), for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB of
// its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/cli

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int, env: Env) -> Int ! Str uses env {
  for k in 0..CASES.len() {
    let (decl, args, want) = CASES[(start + k) % CASES.len()]
    let got = answer(decl, args, env)
    if got != want {
      return Err("${decl} ${args.quote()}: ${got.quote()} want ${want.quote()}")
    }
  }
  CASES.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i, os.env)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("cli stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn flag_of(d: Str) -> cli.Flag {
  let (name, kind) = d.cut(":") ?? fault("flag ${d}")
  match kind {
    "bool" => cli.bool_flag(name, "b")
    "str" => cli.str_flag(name, "s")
    "int" => cli.int_flag(name, "i")
    "dur" => cli.duration_flag(name, "d")
    "float" => cli.float_flag(name, "f")
    _ => cli.strs_flag(name, "r")
  }
}

fn value_of(p: cli.Parsed, d: Str) -> Str {
  let (name, kind) = d.cut(":") ?? fault("flag ${d}")
  let v = match kind {
    "bool" => "${p.bool(name)}"
    "str" => p.str(name)
    "int" => "${p.int(name)}"
    "dur" => "${p.duration(name).nanos()}"
    "float" => if p.float(name).is_nan() { "nan" } else { "${p.float(name).to_bits()}" }
    _ => p.strs(name).join("\u{1e}")
  }
  "${name}=${v}"
}

fn answer(decl: Str, args: Str, env: Env) -> Str uses env {
  let ds = decl.split(" ")
  let cmd = cli.command("t", "a tool", flags: ds.map(flag_of), args: [cli.rest("args", "the rest")], single_dash_long: true, stop_at_positional: true)
  let av = if args == "" { [] } else { args.split("\u{1f}").map(fn(a: Str) -> Str { if a == "\u{1d}" { "" } else { a } }) }
  match cli.parse(cmd, av, env) {
    Ok(p) => {
      var parts = ["ok"]
      for d in ds {
        parts.push(value_of(p, d))
      }
      parts.push("rest=${p.rest("args").join("\u{1e}")}")
      parts.join("\u{1f}")
    }
    Err(cli.CliErr.Help(_)) => "help"
    Err(_) => "usage"
  }
}


/// (the flags as name:kind, the arguments joined by U+001F (U+001D an empty one), Go's answer: help, usage, or ok and each value and the rest, joined by U+001F)
const CASES: List[(Str, Str, Str)] = [
  ("name:strs level:str dry-run:str verbose:float ratio:str", "-verbose\u{1f}nan\u{1f}--level=a=b\u{1f}x=1\u{1f}\u{1d}\u{1f}-v\u{1f}--verbose\u{1f}7\u{1f}x=1\u{1f}a b\u{1f}-name\u{1f}word\u{1f}-verbose\u{1f}inf", "ok\u{1f}name=\u{1f}level=a=b\u{1f}dry-run=\u{1f}verbose=nan\u{1f}ratio=\u{1f}rest=x=1\u{1e}\u{1e}-v\u{1e}--verbose\u{1e}7\u{1e}x=1\u{1e}a b\u{1e}-name\u{1e}word\u{1e}-verbose\u{1e}inf"),
