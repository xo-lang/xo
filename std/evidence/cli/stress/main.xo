  ("x64:bool name:bool timeout:bool", "--timeout\u{1f}--timeout\u{1f}file", "ok\u{1f}x64=false\u{1f}name=false\u{1f}timeout=true\u{1f}rest=file"),
  ("count:bool", "-\u{1f}--count=1\u{1f}a b", "ok\u{1f}count=false\u{1f}rest=-\u{1e}--count=1\u{1e}a b"),
  ("x64:bool timeout:float level:dur count:dur", "--count=1.5h\u{1f}-count\u{1f}0\u{1f}--x64\u{1f}-count=1m30s\u{1f}--x64\u{1f}file\u{1f}\u{1d}\u{1f}\u{1d}\u{1f}--nope", "ok\u{1f}x64=true\u{1f}timeout=0\u{1f}level=0\u{1f}count=90000000000\u{1f}rest=file\u{1e}\u{1e}\u{1e}--nope"),
