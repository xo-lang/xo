// base32 stress program (decision 0616 section 2): 64 tasks run 64 cases
// against Go's encoding/base32 (xostressgen, seeded: random bytes in each
// of the four encodings, Std and Hex padded and raw, and a text near each
// encoding: as is, with \r and \n put in, cut, a byte replaced by a lower
// case letter, a digit outside the alphabet, `=`, a space or multi-byte
// text, padding dropped or added, two encodings joined, a random string
// over the alphabet). Each case encodes its bytes and checks Go's
// EncodeToString, decodes that back to the bytes, and decodes the text,
// checking DecodeString's bytes or CorruptInputError text, for a fixed
// time. A background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/base32

const VARIANTS: List[base32.Base32] = [base32.Base32.Std, base32.Base32.Hex, base32.Base32.RawStd, base32.Base32.RawHex]

/// A decode result as the cases write Go's: ok HEX or err TEXT.
fn answer(r: Result[Bytes, base32.DecodeErr]) -> Str {
  match r {
    Ok(b) => "ok ${b.to_hex()}"
    Err(e) => "err ${e.display()}"
  }
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (v, h, enc, text, want) = CASES[i]
    let variant = VARIANTS[v]
    let d = Bytes.from_hex(h).or_fault("hex")
    let e = base32.encode(d, variant)
    if e != enc {
      return Err("case ${i}: encode gave ${e}")
    }
    let back = answer(base32.decode(e, variant))
    if back != "ok ${h}" {
      return Err("case ${i}: decode of the encoding gave ${back}")
    }
    let got = answer(base32.decode(text, variant))
    if got != want {
      return Err("case ${i}: decode gave ${got}")
    }
    ops += 3
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("base32 stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

