// rate stress program (decision 0616 section 2): 64 tasks replay 64 operation
// sequences on std/rate Limiters (tokens, allow_n, reserve_n and its delay,
// cancel, set_limit, set_burst) at times each task's own clock sets, against
// golang.org/x/time/rate v0.16.0 at the same times (the seed 1 rows of
// scripts/stdcorpus/rateoracle fuzz), for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB of
// its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/rate

/// A clock the stress program sets (each task its own): std/rate's
/// Limiter reads the Clock it holds.
struct VClock {
  at: Mutex[Time]
}

fn (c: VClock) now() -> Time uses clock { c.at.with_read(fn(t: Time) -> Time { t }) }
fn (c: VClock) sleep(d: Duration) uses clock { c.at.with(fn(var t: Time) { t = t + d }) }
fn (c: VClock) sleep_or_cancel(d: Duration) -> () ! ClockErr uses clock {
  c.sleep(d)
  Ok(())
}
fn (c: VClock) since(t: Time) -> Duration uses clock { c.now() - t }
fn (c: VClock) set(t: Time) { c.at.with(fn(var x: Time) { x = t }) }

/// The answers of the operations on a limiter (limit, burst) at c's times.
fn vreplay(c: VClock, lim: Float, burst: Int, ops: Str) -> Str uses clock {
  c.set(t0())
  let l = rate.new(lim, burst, c)
  var rs: List[rate.Reservation] = []
  var ans: List[Str] = []
  if ops == "" {
    return ""
  }
  for w in ops.split(" ") {
    match w.bytes()[0] {
      't' => c.set(t0() + Duration.from_nanos(arg(w)))
      'k' => ans.push("${l.tokens().to_bits()}")
      'a' => ans.push(if l.allow_n(arg(w)) { "1" } else { "0" })
      'r' => {
        let r = l.reserve_n(arg(w))
        rs.push(r)
        ans.push("${if r.ok() { "1" } else { "0" }},${r.delay().nanos()}")
      }
      'd' => ans.push("${rs[arg(w)].delay().nanos()}")
      'c' => rs[arg(w)].cancel()
      'l' => l.set_limit(Float.from_bits(arg(w)))
      _ => l.set_burst(arg(w))
    }
  }
  ans.join(" ")
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  let c = VClock{at: Mutex.new(t0())}
  var ops = 0
  for k in 0..CASES.len() {
    let (lim, burst, ol, want) = CASES[(start + k) % CASES.len()]
    let got = vreplay(c, Float.from_bits(lim), burst, ol)
    if got != want {
      return Err("case ${(start + k) % CASES.len()}: ${got} want ${want}")
    }
    ops += if ol == "" { 0 } else { ol.split(" ").len() }
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("rate stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

