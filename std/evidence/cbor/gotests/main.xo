// The Xo side of std/cbor's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/cbor's result as text, as go/main.go prints fxamacker/cbor v2's.
// The input is the case's CBOR in hex. Kind diag: cbor.diagnose's text, or
// "err"; kind decode: cbor.decode, then "ok" and that text, or "err". See scripts/stdproven/gotests.go.
use std/cbor
use std/base64

fn diag(data: Bytes) -> Str {
  match cbor.diagnose(data) {
    Ok(s) => s
    Err(_) => "err"
  }
}

fn decode(data: Bytes) -> Str {
  match cbor.decode(data) {
    Ok(_) => "ok ${diag(data)}"
    Err(_) => "err"
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  let data = Bytes.from_hex(inp[0]) ?? return "bad hex"
  match kind {
    "diag" => diag(data)
    "decode" => decode(data)
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
