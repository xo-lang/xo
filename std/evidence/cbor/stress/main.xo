// cbor stress program (decision 0616 section 2): 64 tasks run std/cbor's
// decode (plain and with reject_dup_keys), well_formed, diagnostic and
// encode (plain and deterministic, decoded back) on the rows of the cbor
// corpus (internal/stdtest/testdata/corpus/cbor: RFC 8949's Appendix A,
// malformed and edge inputs and changed copies, each answered by
// fxamacker/cbor v2.9.0 through internal/stdtest/cborref), for a fixed
// time. A background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/cbor

fn check(data: Bytes, wf: Bool, diag: Str, canon: Str, dup: Str) -> Str {
  if cbor.well_formed(data) != wf {
    return "well_formed " + data.to_hex()
  }
  match cbor.decode(data) {
    Ok(v) => {
      if !wf || diag == "UTF8" {
        return "decode accepted " + data.to_hex()
      }
      if diag != "SKIP" && diag != "ERR" && v.diagnostic() != diag {
        return "diagnostic " + data.to_hex() + ": " + v.diagnostic() + " want " + diag
      }
      match cbor.decode(data, reject_dup_keys: true) {
        Ok(_) => {
          if dup == "yes" {
            return "dup accepted " + data.to_hex()
          }
          if canon != "ERR" && canon != "SKIP" {
            match cbor.encode(v, deterministic: true) {
              Ok(e) => {
                if e.to_hex() != canon {
                  return "encode " + data.to_hex() + ": " + e.to_hex() + " want " + canon
                }
              }
              Err(e) => return "encode failed " + data.to_hex() + ": " + e.display()
            }
          }
        }
        Err(_) => {
          if dup == "no" {
            return "dup refused " + data.to_hex()
          }
        }
      }
      // what encode writes decodes back to the same item
      match cbor.encode(v) {
        Ok(e) => {
          match cbor.decode(e) {
            Ok(w) => {
              if w.diagnostic() != v.diagnostic() {
                return "round trip " + data.to_hex()
              }
            }
            Err(x) => return "round trip decode " + data.to_hex() + ": " + x.display()
          }
        }
        Err(x) => return "round trip encode " + data.to_hex() + ": " + x.display()
      }
      ""
    }
    Err(_) => {
      if wf && diag != "ERR" && diag != "UTF8" {
        return "decode refused " + data.to_hex()
      }
      ""
    }
  }
}

/// One pass over the rows from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..CASES.len() {
    let (data, wf, diag, canon, dup) = CASES[(start + k) % CASES.len()]
    let m = check(data, wf, diag, canon, dup)
    if m != "" {
      return Err(m)
    }
  }
  4 * CASES.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("cbor stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

