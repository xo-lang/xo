// x509 stress program (decision 0616 section 2): 64 tasks run std/x509's
// main operations (parse a leaf, its field summary, verify its chain
// through an intermediate to a root for a host name, verify_hostname,
// check_signature_from, parse_pem of the chain) over 32 leaves for a fixed
// time, each result checked against Go's crypto/x509 (xstressgen). A
// background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/crypto
use std/x509

fn ku_index(u: x509.KeyUsage) -> Int {
  match u {
    DigitalSignature => 0
    ContentCommitment => 1
    KeyEncipherment => 2
    DataEncipherment => 3
    KeyAgreement => 4
    CertSign => 5
    CrlSign => 6
    EncipherOnly => 7
    DecipherOnly => 8
  }
}

fn eku_oid(u: x509.ExtKeyUsage) -> Str {
  match u {
    Any => "2.5.29.37.0"
    ServerAuth => "1.3.6.1.5.5.7.3.1"
    ClientAuth => "1.3.6.1.5.5.7.3.2"
    CodeSigning => "1.3.6.1.5.5.7.3.3"
    EmailProtection => "1.3.6.1.5.5.7.3.4"
    TimeStamping => "1.3.6.1.5.5.7.3.8"
    OcspSigning => "1.3.6.1.5.5.7.3.9"
    Other(oid) => oid
  }
}

fn key_name(k: crypto.PublicKey?) -> Str {
  match k {
    Some(x) => match x.alg() {
      Rsa => "Rsa"
      EcdsaP224 => "EcdsaP224"
      EcdsaP256 => "EcdsaP256"
      EcdsaP384 => "EcdsaP384"
      EcdsaP521 => "EcdsaP521"
      Ed25519 => "Ed25519"
    }
    None => "none"
  }
}

fn summary(c: x509.Certificate) -> Str {
  let ips = c.ip_addresses.map(fn(a) { a.display() }).join(",")
  let mpl = match c.max_path_len {
    Some(n) => "${n}"
    None => "none"
  }
  let ku = c.key_usage.map(fn(u) { "${ku_index(u)}" }).join(",")
  let eku = c.ext_key_usage.map(fn(u) { eku_oid(u) }).join(",")
  let ext = c.extensions.map(fn(e) { "${e.oid}/${e.critical}/${e.value.len()}" }).join(",")
  let attrs = c.subject.attributes().map(fn(a) { "${a.0}=${a.1}" }).join(";")
  "v=${c.version} serial=${c.serial.to_hex()} sig=${c.signature_algorithm} subj=${c.subject.display()} iss=${c.issuer.display()} nb=${c.not_before.unix()} na=${c.not_after.unix()} dns=${c.dns_names.join(",")} ip=${ips} email=${c.email_addresses.join(",")} uri=${c.uris.join(",")} ca=${c.is_ca} mpl=${mpl} ku=${ku} eku=${eku} ski=${c.subject_key_id.to_hex()} aki=${c.authority_key_id.to_hex()} ext=${ext} key=${key_name(c.public_key)} attrs=${attrs}"
}

/// One pass over the leaves from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int, roots: List[x509.Certificate], inters: List[x509.Certificate]) -> Int ! Str {
  var ops = 0
  let at = Time.from_unix(VERIFY_AT)
  for k in 0..LEAVES.len() {
    let i = (start + k) % LEAVES.len()
    let (hex, want_sum, host, want_verify) = LEAVES[i]
    let der = Bytes.from_hex(hex) ?? return Err("hex of leaf ${i}")
    let c = x509.parse(der).map_err(fn(e) { "parse of leaf ${i}: ${e.display()}" })?
    let s = summary(c)
    if s != want_sum {
      return Err("summary of leaf ${i}: got ${s}")
    }
    let got = match c.verify(x509.VerifyOptions{roots: roots, intermediates: inters, dns_name: host, at: at}) {
      Ok(chains) => chains[0].map(fn(x) { x.subject.common_name }).join(">")
      Err(e) => "error: ${e.display()}"
    }
    if got != want_verify {
      return Err("verify of leaf ${i}: got ${got}")
    }
    let host_ok = c.verify_hostname(host).is_ok()
    if host_ok == want_verify.contains("is valid for") {
      return Err("verify_hostname of leaf ${i}")
    }
    c.check_signature_from(inters[0]).map_err(fn(e) { "check_signature_from of leaf ${i}: ${e.display()}" })?
    if c.check_signature_from(roots[0]).is_ok() {
      return Err("leaf ${i} checks against the root")
    }
    ops += 6
  }
  let chain = x509.parse_pem("${INTER_PEM}${ROOT_PEM}".bytes()).map_err(fn(e) { "parse_pem: ${e.display()}" })?
  if chain.len() != 2 || chain[1].raw != roots[0].raw {
    return Err("parse_pem of the chain")
  }
  ops + 1
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let roots = x509.parse_pem(ROOT_PEM.bytes()).map_err(fn(e) { e.display() })?
  let inters = x509.parse_pem(INTER_PEM.bytes()).map_err(fn(e) { e.display() })?
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i, roots, inters)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("x509 stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

// Written by xstressgen (Xo Lang 3, 2026-11-13) from Go's crypto/x509 (go1.26.1): a root (ECDSA P-256) and an
// intermediate (Ed25519) as PEM, and for each leaf its DER in hexadecimal, Go's field summary, the host it is
// checked for, and Go's Verify (the chain's subjects) or error text at VERIFY_AT.
