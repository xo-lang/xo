// amqptest stress program (decision 0616 section 2): an std/amqptest
// broker serves 4 queues (maximum delivery count 5) on loopback. TASKS
// producers each send numbered messages to the queues in turn, and TASKS
// consumers each hold a peek-lock receiver (credit 8) on one queue and
// settle what they get: mostly accept, sometimes release, abandon
// (modify) or dead letter, each over its own std/amqp connection. When
// the time is up (or every producer has sent its share) the producers
// stop and the consumers drain the queues. Every message must end
// accepted exactly once or in its queue's dead letter queue, none lost,
// none accepted twice, and the broker must hold nothing ready or locked.
// The producers wait while more than INFLIGHT messages are neither
// accepted nor dead lettered, and the consumers record each accepted
// message as a bit per producer and number, so the program's own memory
// stays flat: unthrottled producers outran the consumers (a backlog of
// 225,000 messages after 2 minutes, 2026-11-18) and a map of every
// accepted id held each message's frame, which the resident set check
// read as a leak. A drainer per queue receives its dead letter queue
// over std/amqp (receive and delete, as Service Bus's dead letter
// receivers do), so the dead letters do not pile up in the broker either:
// 84,883 of them held about 90 MB at the end of a 20 minute run
// (2026-11-18, task #323).
// A background task samples the resident set every 10 s (Linux
// /proc/self/status) and prints it each minute. Pass: those checks, no
// fault, and the resident set at the end within 10% or 4 MB of its sample
// at 15 minutes.
//
//   main [MINUTES (30); 0: 300 messages per producer] [TASKS (16)]
use std/amqp
use std/amqptest

const QUEUES: Int = 4

/// Messages sent but not yet accepted or dead lettered, at most.
const INFLIGHT: Int = 4096

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

fn body_of(m: amqp.Message) -> Str {
  match m.body {
    Data(sections) => if sections.is_empty() { "" } else { sections[0].to_str_lossy() }
    _ => ""
  }
}

/// An error's text (AmqpErr is open and has no display).
fn es(e: amqp.AmqpErr) -> Str {
  match e {
    Decode(m) => "decode: ${m}"
    Encode(m) => "encode: ${m}"
    Net(m) => "net: ${m}"
    Protocol(m) => "protocol: ${m}"
    Peer(w) => "peer: ${w.condition} ${w.description}"
    _ => "another error"
  }
}

fn opts(os: Os) -> amqp.ConnOptions {
  amqp.ConnOptions{container_id: "stress", clock: Some(os.clock), sasl: amqp.Sasl.Anonymous, timeout_ms: 10000}
}

fn producer(os: Os, addr: Str, t: Int, end: Time, passes: Int, stop: Mutex[Bool], sent: Mutex[Int], done: Mutex[Int]) -> Int ! Str uses (net, clock) {
  let c = amqp.dial(os.net, addr, opts(os)).map_err(fn(e) { "producer ${t}: dial: ${es(e)}" })?
  let sess = c.begin().map_err(fn(e) { "producer ${t}: begin: ${es(e)}" })?
  var snds: List[amqp.Sender] = []
  for q in 0..QUEUES {
    snds.push(c.new_sender(sess, "q${q}", amqp.SenderOptions{name: "p${t}.${q}"}).map_err(fn(e) { "producer ${t}: sender: ${es(e)}" })?)
  }
  var k = 0
  while if passes > 0 { k < passes } else { os.clock.now() < end && !stop.with_read(fn(b: Bool) -> Bool { b }) } {
    if k % 16 == 0 {
      // the backlog stays bounded: wait while INFLIGHT are outstanding
      while sent.with_read(fn(n: Int) -> Int { n }) - done.with_read(fn(n: Int) -> Int { n }) > INFLIGHT && os.clock.now() < end {
        os.clock.sleep(1ms)
      }
    }
    let m = amqp.Message{body: amqp.Body.Data(sections: ["${t}.${k}".bytes()])}
    match snds[k % QUEUES].send(m).map_err(fn(e) { "producer ${t} message ${k}: ${es(e)}" })? {
      Some(amqp.DeliveryState.Accepted) => {}
      _ => return Err("producer ${t} message ${k}: not accepted")
    }
    sent.with(fn(var n: Int) { n += 1 })
    k += 1
  }
  c.close().map_err(fn(e) { "producer ${t}: close: ${es(e)}" })?
  Ok(k)
}

/// One drainer: receives queue `q`'s dead letters until the consumers are done and none are left,
/// counting each in `drained` and `done`.
fn drainer(os: Os, b: amqptest.Broker, addr: Str, q: Int, drained: Mutex[Int], done: Mutex[Int], consuming: Mutex[Bool]) -> Int ! Str uses (net, clock) {
  let c = amqp.dial(os.net, addr, opts(os)).map_err(fn(e) { "drainer ${q}: dial: ${es(e)}" })?
  let sess = c.begin().map_err(fn(e) { "drainer ${q}: begin: ${es(e)}" })?
  let rcv = c.new_receiver(sess, "q${q}/$DeadLetterQueue", amqp.ReceiverOptions{name: "d${q}", credit: 64}).map_err(fn(e) { "drainer ${q}: receiver: ${es(e)}" })?
  var n = 0
  while true {
    match rcv.receive(300) {
      Ok(_) => {
        n += 1
        drained.with(fn(var x: Int) { x += 1 })
        done.with(fn(var x: Int) { x += 1 })
      }
      Err(_) => {
        if !consuming.with_read(fn(p: Bool) -> Bool { p }) && b.dead_letters("q${q}").is_empty() { break }
      }
    }
  }
  c.close().map_err(fn(e) { "drainer ${q}: close: ${es(e)}" })?
  Ok(n)
}

/// One consumer: settles until `drained` says the producers are done and its queue is empty.
fn consumer(os: Os, b: amqptest.Broker, addr: Str, t: Int, accepted: Mutex[List[List[Int]]], done: Mutex[Int], producing: Mutex[Bool]) -> Int ! Str uses (net, clock) {
  let q = "q${t % QUEUES}"
  let c = amqp.dial(os.net, addr, opts(os)).map_err(fn(e) { "consumer ${t}: dial: ${es(e)}" })?
  let sess = c.begin().map_err(fn(e) { "consumer ${t}: begin: ${es(e)}" })?
  let rcv = c.new_receiver(sess, q, amqp.ReceiverOptions{name: "c${t}", credit: 8, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).map_err(fn(e) { "consumer ${t}: receiver: ${es(e)}" })?
  var x = next(t + 77)
  var n = 0
  while true {
    let d = match rcv.receive(300) {
      Ok(d) => d
      Err(_) => {
        // nothing came: done once the producers are and the queue is empty
        if !producing.with_read(fn(p: Bool) -> Bool { p }) && b.ready(q).is_empty() && b.locked(q) == 0 {
          break
        }
        continue
      }
    }
    x = next(x)
    let id = body_of(d.message)
    match (x >> 40) % 20 {
      0 => rcv.release(d).map_err(fn(e) { "consumer ${t}: release ${id}: ${es(e)}" })?
      1 => rcv.modify(d).map_err(fn(e) { "consumer ${t}: abandon ${id}: ${es(e)}" })?
      2 => {
        if (x >> 20) % 8 == 0 {
          rcv.reject(d, Some(amqp.WireError{condition: "com.microsoft:dead-letter", info: [("DeadLetterReason", amqp.Value.Str(v: "stress"))]})).map_err(fn(e) { "consumer ${t}: dead letter ${id}: ${es(e)}" })?
        } else {
          rcv.release(d).map_err(fn(e) { "consumer ${t}: release ${id}: ${es(e)}" })?
        }
      }
      _ => {
        rcv.accept(d).map_err(fn(e) { "consumer ${t}: accept ${id}: ${es(e)}" })?
        let parts = id.split(".")
        let (pt, pk) = if parts.len() == 2 { (Int.parse(parts[0]) ?? -1, Int.parse(parts[1]) ?? -1) } else { (-1, -1) }
        let twice = accepted.with(fn(var m: List[List[Int]]) -> Bool {
          if pt < 0 || pt >= m.len() || pk < 0 { return true }
          var w = m[pt]
          let none: List[Int] = []
          m[pt] = none
          while w.len() <= pk / 32 { w.push(0) }
          let bit = 1 << (pk % 32)
          let seen = (w[pk / 32] & bit) != 0
          w[pk / 32] = w[pk / 32] | bit
          m[pt] = w
          seen
        })
        done.with(fn(var d: Int) { d += 1 })
        if twice {
          return Err("consumer ${t}: ${id} accepted twice")
        }
        n += 1
      }
    }
  }
  c.close().map_err(fn(e) { "consumer ${t}: close: ${es(e)}" })?
  Ok(n)
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 16 } else { 16 }
  let passes = if minutes == 0 { 300 } else { 0 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let b = amqptest.new(os.clock)
  for q in 0..QUEUES {
    b.queue("q${q}", amqptest.QueueOptions{max_delivery_count: 5})
  }
  let l = os.net.listen("127.0.0.1:0")?
  let addr = l.addr()
  let no_bits: List[Int] = []
  let accepted = Mutex[List[List[Int]]].new(List[List[Int]].filled(tasks, no_bits))
  // accepted plus dead lettered (the dead ones counted by the drainers)
  let done = Mutex[Int].new(0)
  let drained = Mutex[Int].new(0)
  let consuming = Mutex[Bool].new(true)
  let producing = Mutex[Bool].new(true)
  let stop = Mutex[Bool].new(false)
  let sent = Mutex[Int].new(0)
  let (made, took) = scope s {
    b.serve(s.group(), l)
    s.spawn_background(fn() {
      var marked = false
      var ticks = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        ticks += 1
        if ticks % 6 == 0 && v > 0 {
          os.stdio.println("rss ${ticks / 6} min: ${v / 1024} MB, ${sent.with_read(fn(n: Int) -> Int { n })} sent")
        }
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var x) {
          var (m, p) = x
          if after_mark && v > 0 { m.push(v) }
          x = (m, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var cs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      cs.push(s.spawn(fn() -> Int ! Str { consumer(os, b, addr, t, accepted, done, producing) }))
    }
    var ds: List[Task[Int, Str]] = []
    for q in 0..QUEUES {
      ds.push(s.spawn(fn() -> Int ! Str { drainer(os, b, addr, q, drained, done, consuming) }))
    }
    var ps: List[Task[Int, Str]] = []
    for t in 0..tasks {
      ps.push(s.spawn(fn() -> Int ! Str { producer(os, addr, t, end, passes, stop, sent, done) }))
    }
    var made = 0
    for h in ps {
      made += h.await.map_err(fn(e) { "a producer: ${e}" })?
    }
    producing.with(fn(var p: Bool) { p = false })
    var took = 0
    for h in cs {
      took += h.await.map_err(fn(e) { "a consumer: ${e}" })?
    }
    consuming.with(fn(var p: Bool) { p = false })
    for h in ds {
      let _ = h.await.map_err(fn(e) { "a drainer: ${e}" })?
    }
    l.close()
    s.cancel()
    (made, took)
  }
  // every message accepted once or dead lettered, and nothing left
  var dead = drained.with_read(fn(n: Int) -> Int { n })
  for q in 0..QUEUES {
    dead += b.dead_letters("q${q}").len()
    if !b.ready("q${q}").is_empty() || b.locked("q${q}") != 0 {
      return Err("q${q} still holds messages")
    }
  }
  let once = accepted.with_read(fn(m: List[List[Int]]) -> Int {
    var n = 0
    for w in m {
      for x in w {
        var y = x
        while y != 0 {
          y = y & (y - 1)
          n += 1
        }
      }
    }
    n
  })
  if once != took || took + dead != made {
    return Err("${made} sent, ${took} accepted (${once} distinct), ${dead} dead lettered: lost or duplicated")
  }
  let (rss_after, peak) = samples.with_read(fn(x) { x })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("amqptest stress: ${made} messages by ${tasks} producers, ${took} accepted once and ${dead} dead lettered by ${tasks} consumers in ${minutes} min, none lost, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
