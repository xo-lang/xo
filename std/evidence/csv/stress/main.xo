  ("|\tbc\n\"a\"\"b\"\t|\n", '\t', true, false, -1, false, "ok R2|1:||2:bcR2|3:a\"b|1:|"),
  ("x y|#c\nx y|trail \r\ntrail \ntrail |\"c|d\"\n\"c|d\"|x y", '|', false, false, -1, false, "ok R2|3:x y|2:#cR2|3:x y|6:trail R1|6:trail R2|6:trail |3:c|dR2|3:c|d|3:x y"),
  ("\n\na\n;\n", '|', false, false, -1, true, "ok R1|1:aR1|1:;"),
  ("bc\t\n\r\n", '\t', false, false, -1, false, "ok R2|2:bc|0:"),
  ("z\"z\"\n\"\r\n\"\r\n", ';', false, false, -1, false, "err parse error on line 1, column 2: bare \" in non-quoted-field"),
  ("trail \r\n", '\t', false, false, -1, false, "ok R1|6:trail "),
  ("bc|bc|\"multi\nline\"| lead\r\ntrail |a|bc|\"\r\ntrail |\"multi\nline\"|#c|a\n\"|a\"b|,|a\"b\nz\"z\"|#c|\"|\"c|d\"\n", '|', false, false, -1, false, "err record on line 3; parse error on line 4, column 8: extraneous or missing \" in quoted-field"),
]

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 5 to 7 of a 30 minute run) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
