// csv stress program (decision 0616 section 2): 64 tasks parse 96 texts
// (records of quoted, multi-line, lead-spaced and bare-quote fields, four
// separators, `#` comments, lazy quotes, trimmed leading space, fields
// per record of the first record or any) and check each against Go 1.26's
// encoding/csv answer (its records, or its ParseError's text; the table
// is generated by a Go program from seed 641); for each that parses,
// format with LF and with CRLF and parse back to the same records, for a
// fixed time. A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the
// resident set at the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/csv

/// Records as one string: `R` and the field count per record, then each
/// field as `|` length `:` text (the generator's canon).
fn canon(recs: List[List[Str]]) -> Str {
  var b = ""
  for r in recs {
    b = b + "R${r.len()}"
    for f in r {
      b = b + "|${f.len()}:${f}"
    }
  }
  b
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (text, sep, lazy, trim, fields, hash, want) = CASES[i]
    let comment = if hash { '#' } else { '\0' }
    let got = match csv.parse(text, sep: sep, comment: comment, fields: fields, lazy_quotes: lazy, trim_leading_space: trim) {
      Ok(recs) => "ok ${canon(recs)}"
      Err(e) => "err ${e.display()}"
    }
    if got != want {
      return Err("case ${i}: ${got}")
    }
    ops += 1
    if let Ok(recs) = csv.parse(text, sep: sep, comment: comment, fields: fields, lazy_quotes: lazy, trim_leading_space: trim) {
      for crlf in [false, true] {
        let back = csv.parse(csv.format(recs, sep: sep, crlf: crlf), sep: sep)
        if back.ok() != Some(recs) {
          return Err("round trip of case ${i} (crlf ${crlf})")
        }
        ops += 2
      }
    }
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes 5 to 7), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("csv stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

