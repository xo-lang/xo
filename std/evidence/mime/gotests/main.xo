// The Xo side of std/mime's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/mime's result as text, as go/main.go prints package mime's.
// Kinds word, header: decode_word and decode_header against WordDecoder's
// Decode and DecodeHeader; media: parse_media_type's type and sorted
// parameters against ParseMediaType's; an error as its text.
// See scripts/stdproven/gotests.go.
use std/mime
use std/base64

fn media(s: Str) -> Str {
  match mime.parse_media_type(s) {
    Ok(m) => {
      var keys: List[Str] = []
      for (k, _) in m.params {
        keys.push(k)
      }
      keys = keys.sort()
      var out = m.kind
      for k in keys {
        out = out + ";${k}=${m.params.get(k) ?? ""}"
      }
      out
    }
    Err(e) => "err ${e.display()}"
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "word" => match mime.decode_word(inp[0]) {
      Ok(s) => s
      Err(e) => "err ${e.display()}"
    }
    "header" => match mime.decode_header(inp[0]) {
      Ok(s) => s
      Err(e) => "err ${e.display()}"
    }
    "media" => media(inp[0])
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
