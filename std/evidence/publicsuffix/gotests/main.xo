// The Xo side of std/publicsuffix's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/publicsuffix's result as text, as go/main.go prints package publicsuffix's.
// Kinds ps and etld1 over Go's x/net publicsuffix tables.
// See scripts/stdproven/gotests.go.
use std/publicsuffix
use std/base64

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "ps" => {
      let (s, icann) = publicsuffix.public_suffix(inp[0])
      "${s} ${icann}"
    }
    "etld1" => match publicsuffix.effective_tld_plus_one(inp[0]) {
      Ok(s) => s
      Err(_) => ""
    }
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
