// compress stress program (decision 0616 section 2): TASKS tasks run
// std/compress's operations on 12 inputs (empty to 70 KB: text, random,
// zeros, short periods) for a fixed time, each result checked against Go's
// answer (cstressgen, in the table below): gzip, deflate and zlib at six
// levels one shot, a Compressor in 1000 byte writes and in 3000 byte writes
// with a flush after each, every output decoded back one shot, by a
// Decompressor in 777 byte writes and with max_size one byte short; LZW in
// both bit orders at literal widths 8 and 7; and Go's default streams with a
// byte changed or cut short, decoded as Go decodes them (its bytes or its
// error text). A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/compress
use std/crc32

const WORDS: List[Str] = ["the", "cache", "stores", "every", "entry", "once", "by", "key", "and", "reads", "it", "back", "with", "a", "check", "of", "its", "version", "before", "use", "\n"]

fn next(x: Int) -> Int { (x * 1103515245 + 12345) % 2147483648 }

/// prev, then words and spaces up to exactly n bytes (Go appends a word and
/// its space, then cuts to n), and the generator's state after.
fn text(prev: Bytes, r0: Int, n: Int) -> (Bytes, Int) {
  var b = BytesBuilder.new()
  b.write(prev)
  var r = r0
  while b.len() < n {
    r = next(r)
    let w = WORDS[(r >> 8) % 21] + " "
    let room = n - b.len()
    b.write_str(if w.len() <= room { w } else { w[0..room] })
  }
  (b.freeze(), r)
}

/// prev, then generated bytes up to n.
fn random(prev: Bytes, r0: Int, n: Int) -> (Bytes, Int) {
  var b = BytesBuilder.new()
  b.write(prev)
  var r = r0
  while b.len() < n {
    r = next(r)
    b.write_byte(UInt8((r >> 16) & 255))
  }
  (b.freeze(), r)
}

/// Input k, as cstressgen's input(k) builds it.
fn input(k: Int) -> Bytes {
  let r = 1000 + k
  let none = BytesBuilder.new().freeze()
  if k == 1 {
    return "a".bytes()
  } else if k == 2 {
    return text(none, r, 100).0
  } else if k == 3 {
    return text(none, r, 4096).0
  } else if k == 4 {
    return text(none, r, 33000).0
  } else if k == 5 {
    return text(none, r, 70000).0
  } else if k == 6 {
    return random(none, r, 4096).0
  } else if k == 7 {
    return random(none, r, 40000).0
  }
  var b = BytesBuilder.new()
  if k == 8 {
    for _ in 0..50000 {
      b.write_byte(0)
    }
  } else if k == 9 {
    var cur = none
    var rr = r
    while cur.len() < 20000 {
      let (t, r1) = text(cur, rr, cur.len() + 500)
      let (u, r2) = random(t, r1, t.len() + 300)
      cur = u
      rr = r2
    }
    return cur[0..20000]
  } else if k == 10 {
    while b.len() < 10000 {
      b.write_str("abc")
    }
    return b.freeze()[0..10000]
  } else if k == 11 {
    while b.len() < 3000 {
      b.write_byte(UInt8(b.len() % 256))
    }
  }
  b.freeze()
}

fn sum(b: Bytes) -> (Int, Int) { (b.len(), crc32.checksum(b)) }

fn show(s: (Int, Int)) -> Str { "(${s.0}, ${s.1})" }

fn format_of(f: Str) -> compress.Format {
  match f {
    "gzip" => compress.Format.Gzip
    "deflate" => compress.Format.Deflate
    _ => compress.Format.Zlib
  }
}

fn pack(f: Str, data: Bytes, level: Int) -> Bytes {
  let l = compress.Level.Of(level)
  match f {
    "gzip" => compress.gzip(data, level: l)
    "deflate" => compress.deflate(data, level: l)
    _ => compress.zlib(data, level: l)
  }
}

fn unpack(f: Str, data: Bytes, max: Int) -> Bytes ! compress.CompressErr {
  match f {
    "gzip" => compress.gunzip(data, max_size: max)
    "deflate" => compress.inflate(data, max_size: max)
    _ => compress.unzlib(data, max_size: max)
  }
}

fn stream_pack(f: Str, data: Bytes, level: Int, chunk: Int, flush: Bool) -> Bytes {
  var c = compress.compressor(format_of(f), level: compress.Level.Of(level))
  var out = BytesBuilder.new()
  var i = 0
  while i < data.len() {
    let j = if i + chunk < data.len() { i + chunk } else { data.len() }
    out.write(c.write(data[i..j]))
    if flush {
      out.write(c.flush())
    }
    i = j
  }
  out.write(c.finish())
  out.freeze()
}

fn stream_unpack(f: Str, data: Bytes, chunk: Int) -> Bytes ! compress.CompressErr {
  var d = compress.decompressor(format_of(f))
  var out = BytesBuilder.new()
  var i = 0
  while i < data.len() {
    let j = if i + chunk < data.len() { i + chunk } else { data.len() }
    out.write(d.write(data[i..j])?)
    i = j
  }
  out.write(d.finish()?)
  out.freeze()
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(ins: List[Bytes], start: Int) -> Int ! Str {
  var ops = 0
  for n in 0..CASES.len() {
    let (k, f, level, chunk, flush, want) = CASES[(start + n) % CASES.len()]
    let data = ins[k]
    let what = "${f} level ${level} chunk ${chunk} of input ${k}"
    let c = if chunk == 0 { pack(f, data, level) } else { stream_pack(f, data, level, chunk, flush) }
    if sum(c) != want {
      return Err("${what}: got ${show(sum(c))}, Go ${show(want)}")
    }
    let back = unpack(f, c, 1073741824).map_err(fn(e) { "${what}: decode: ${e.display()}" })?
    if back != data {
      return Err("${what}: decode differs")
    }
    let sback = stream_unpack(f, c, 777).map_err(fn(e) { "${what}: stream decode: ${e.display()}" })?
    if sback != data {
      return Err("${what}: stream decode differs")
    }
    if data.len() > 0 && unpack(f, c, data.len() - 1).is_ok() {
      return Err("${what}: max_size one short did not fail")
    }
    ops += 4
  }
  for n in 0..LZW.len() {
    let (k, msb, lw, want, werr) = LZW[(start + n) % LZW.len()]
    let order = if msb { compress.LzwOrder.MSB } else { compress.LzwOrder.LSB }
    let what = "lzw ${order} width ${lw} of input ${k}"
    match compress.lzw_encode(ins[k], order, lw) {
      Ok(c) => {
        if werr != "" || sum(c) != want {
          return Err("${what}: got ${show(sum(c))}, Go ${show(want)} ${werr}")
        }
        let back = compress.lzw_decode(c, order, lw).map_err(fn(e) { "${what}: decode: ${e.display()}" })?
        if back != ins[k] {
          return Err("${what}: decode differs")
        }
      }
      Err(e) => {
        if e.display() != werr {
          return Err("${what}: error ${e.display()}, Go ${werr}")
        }
      }
    }
    ops += 2
  }
  for n in 0..BAD.len() {
    let (k, f, num, cut, want, werr) = BAD[(start + n) % BAD.len()]
    let c = pack(f, ins[k], -1)
    let p = c.len() * num / 8
    let x = if cut { c[0..p] } else {
      var b = BytesBuilder.new()
      b.write(c[0..p])
      b.write_byte(UInt8(Int(c[p]) ^ 0x5a))
      b.write(c[p + 1..c.len()])
      b.freeze()
    }
    let what = "${f} of input ${k} ${if cut { "cut" } else { "changed" }} at ${num}/8"
    match unpack(f, x, 1073741824) {
      Ok(b) => {
        if werr != "" || sum(b) != want {
          return Err("${what}: got ${show(sum(b))}, Go ${show(want)} ${werr}")
        }
      }
      Err(e) => {
        if e.display() != werr {
          return Err("${what}: error ${e.display()}, Go ${werr}")
        }
      }
    }
    ops += 1
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  var ins: List[Bytes] = []
  for k in 0..12 {
    ins.push(input(k))
  }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t * 7
        while clock.now() < end {
          n += pass(ins, i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("compress stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

