// std/toml stress (decision 0616, task #108): 64 tasks decode, convert to JSON,
// encode and decode again the tomlfuzz corpus's documents (seed 1) for 30
// minutes, then a resident set check.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/json
use std/toml

/// One pass over the documents from offset start: to_json and decode agree,
/// and encode then decode gives the same value. The operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..DOCS.len() {
    let d = DOCS[(start + k) % DOCS.len()]
    let bad = tf_check(d)
    if bad != "" {
      return Err("toml ${d.quote()}: ${bad}")
    }
  }
  DOCS.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("toml stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn tf_r(v: json.Value) -> Str {
  match v {
    json.Value.Null => "null"
    json.Value.Bool(b) => if b { "t" } else { "f" }
    json.Value.Int(n) => "n${n}"
    json.Value.Num(f) => {
      if f == f.floor() && f.abs() < 9.2e18 {
        return "n${Int(f)}"
      }
      "f${f.to_bits()}"
    }
    json.Value.Str(s) => "s${tf_frac(s).bytes().to_hex()}"
    json.Value.List(items) => {
      var parts: List[Str] = []
      for x in items {
        parts.push(tf_r(x))
      }
      "[" + parts.join(",") + "]"
    }
    json.Value.Object(fields) => {
      var parts: List[Str] = []
      for (k, x) in fields {
        parts.push("${k.bytes().to_hex()}:${tf_r(x)}")
      }
      "{" + parts.sort().join(",") + "}"
    }
    _ => "other"
  }
}

/// s with the trailing zeros of a seconds fraction dropped (".600" is
/// ".6", ".000" nothing): toml-test compares datetimes as instants.
fn tf_frac(s: Str) -> Str {
  let b = s.bytes()
  var i = 3
  while i < b.len() && !(b[i] == 46 && b[i - 3] == 58) {
    i += 1
  }
  if i >= b.len() {
    return s
  }
  var j = i + 1
  while j < b.len() && b[j] >= 48 && b[j] <= 57 {
    j += 1
  }
  var k = j
  while k > i + 1 && b[k - 1] == 48 {
    k -= 1
  }
  if k == i + 1 {
    k = i
  }
  s[..k] + s[j..]
}

fn tf_line(text: Str) -> Str {
  match toml.to_json(text) {
    Ok(j) => match json.parse_value(j) {
      Ok(v) => "ok " + tf_r(v)
      Err(e) => "bad json " + e.msg
    }
    Err(_) => "err"
  }
}

/// The invariants every document holds: to_json and decode agree on
/// whether it is TOML, to_json's text is JSON, and a decoded value
/// encodes to a document that decodes to the same value (key order
/// aside: encode writes a table's plain keys before its tables).
fn tf_check(text: Str) -> Str {
  let j = toml.to_json(text)
  let d = toml.decode[Map[Str, json.Value]](text)
  if j.is_ok() != d.is_ok() {
    return "to_json ok ${j.is_ok()} but decode ok ${d.is_ok()}"
  }
  match j {
    Ok(s) => {
      if json.parse_value(s).is_err() {
        return "to_json wrote text that is not JSON: " + s
      }
    }
    Err(_) => return ""
  }
  match d {
    Ok(v) => {
      let first = tf_r(json.to_value(v))
      match toml.encode(v) {
        Ok(doc) => match toml.decode[Map[Str, json.Value]](doc) {
          Ok(v2) => {
            let second = tf_r(json.to_value(v2))
            if second != first {
              return "round trip changed " + first + " to " + second + " through " + doc
            }
          }
          Err(e) => return "encode wrote a document decode refuses: " + e.display() + " in " + doc
        }
        Err(e) => return "encode failed: " + e.display()
      }
    }
    Err(_) => {}
  }
  ""
}


