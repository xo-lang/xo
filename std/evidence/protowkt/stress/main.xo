  ("0a2232200a0d320b0a000a0208000a031a01300a0d320b0a0911000000000000f03f0a000a000a4f2a4d0a160a0012122a100a050a013012000a070a0161120220010a100a036b6179120911000000000000f0bf0a210a1b747970652e676f6f676c65617069732e636f6d2f706b672e4d7367120208000a09110000000000000000", "[[[z,z,s1:0],[n3ff0000000000000],z],z,{0:={1:0=z,1:a=b1},3:kay=nbff0000000000000,27:type.googleapis.com/pkg.Msg=z},n0]"),
  ("0a000a023200", "[z,[]]"),
  ("0a0220010a0208000a1f321d0a0220010a0232000a1332110a09119a9999999999b93f0a000a0208000a020800", "[b1,z,[b1,[],[n3fb999999999999a,z,z]],z]"),
  ("0a0220010a1d1a1b747970652e676f6f676c65617069732e636f6d2f706b672e4d7367", "[b1,s27:type.googleapis.com/pkg.Msg]"),
  ("0a022a00", "[{}]"),
  ("0a081a0668c3a96c6c6f", "[s6:héllo]"),
  ("0a5632540a0911000000000000f0bf0a432a410a070a0161120208000a130a0668c3a96c6c6f120911000000000000f03f0a210a1b747970652e676f6f676c65617069732e636f6d2f706b672e4d7367120220010a020800", "[[nbff0000000000000,{1:a=z,6:héllo=n3ff0000000000000,27:type.googleapis.com/pkg.Msg=b1},z]]"),
  ("0a0208000a000a081a06e697a5e69cac", "[z,z,s6:日本]"),
  ("0a1d1a1b747970652e676f6f676c65617069732e636f6d2f706b672e4d73670a000a051a037820790a0632040a020800", "[s27:type.googleapis.com/pkg.Msg,z,s3:x y,[z]]"),
  ("0a000a0220000a0432020a000a0911000000000000f07f", "[z,b0,[z],s8:Infinity]"),
]


fn hex(b: Bytes) -> Str {
  let digits = "0123456789abcdef".bytes()
  var o = BytesBuilder.new()
  for c in b {
    o.write_byte(digits[Int(c) / 16])
    o.write_byte(digits[Int(c) % 16])
  }
  o.freeze().to_str_lossy()
}

fn unhex(s: Str) -> Bytes {
  var o = BytesBuilder.new()
  let b = s.bytes()
  var i = 0
  while i + 1 < b.len() {
    o.write_byte(UInt8.wrapping_from(nib(Int(b[i])) * 16 + nib(Int(b[i + 1]))))
    i += 2
  }
  o.freeze()
}

fn nib(c: Int) -> Int { if c >= 97 { c - 87 } else { c - 48 } }

fn val(v: protowkt.Value) -> Str {
  match v {
    Unset => "u"
    Null => "z"
    Number(x) => "n" + hexint(x.to_bits())
    Text(s) => "s${s.len()}:${s}"
    Flag(b) => if b { "b1" } else { "b0" }
    Object(s) => strct(s)
    Array(l) => lst(l)
  }
}

fn hexint(x: Int) -> Str {
  if x == 0 {
    return "0"
  }
  let digits = "0123456789abcdef".bytes()
  var out: List[Int] = []
  var v = x
  while v != 0 {
    out.push(Int(digits[v & 15]))
    v = v.shr_logical(4)
  }
  var o = BytesBuilder.new()
  var i = out.len() - 1
  while i >= 0 {
    o.write_byte(UInt8.wrapping_from(out[i]))
    i -= 1
  }
  o.freeze().to_str_lossy()
}

fn strct(s: protowkt.Struct) -> Str {
  let keys = s.fields.keys().sort_by(fn(k: Str) -> Str { k })
  var parts: List[Str] = []
  for k in keys {
    parts.push("${k.len()}:${k}=${val(s.fields.get(k) ?? protowkt.Value.Unset)}")
  }
  "{" + parts.join(",") + "}"
}

fn lst(l: protowkt.ListValue) -> Str {
  var parts: List[Str] = []
  for v in l.values {
    parts.push(val(v))
  }
  "[" + parts.join(",") + "]"
}

/// the corpus test "Timestamp and Duration"
fn check_1() -> Str {
  for (h, want) in TIMESTAMPS {
    let m = protowkt.decode_timestamp(unhex(h)).or_fault("ts")
    if ("${m.seconds},${m.nanos}") != (want) {
      return "check_1 line 3948"
    }
    if (hex(protowkt.encode_timestamp(m))) != (h) {
      return "check_1 line 3949"
    }
  }
  for (h, want) in DURATIONS {
    let m = protowkt.decode_duration(unhex(h)).or_fault("du")
    if ("${m.seconds},${m.nanos}") != (want) {
      return "check_1 line 3953"
    }
    if (hex(protowkt.encode_duration(m))) != (h) {
      return "check_1 line 3954"
    }
  }
  ""
}

/// the corpus test "FieldMask, Any and Empty"
fn check_2() -> Str {
  for (h, want) in MASKS {
    let m = protowkt.decode_field_mask(unhex(h)).or_fault("fm")
    if ("${m.paths.len()}|${m.paths.join("|")}") != (want) {
      return "check_2 line 3961"
    }
    if (hex(protowkt.encode_field_mask(m))) != (h) {
      return "check_2 line 3962"
    }
  }
  for (h, want) in ANYS {
    let m = protowkt.decode_any(unhex(h)).or_fault("any")
    if ("${m.type_url.len()}:${m.type_url},${hex(m.value)}") != (want) {
      return "check_2 line 3966"
    }
    if (hex(protowkt.encode_any(m))) != (h) {
      return "check_2 line 3967"
    }
  }
  for (h, _) in EMPTIES {
    let m = protowkt.decode_empty(unhex(h)).or_fault("empty")
    if (hex(protowkt.encode_empty(m))) != (h) {
      return "check_2 line 3971"
    }
  }
  ""
}

/// the corpus test "the wrappers"
fn check_3() -> Str {
  for (h, want) in WRAPPERS {
    let b = unhex(h)
    if want.starts_with("d") {
      let m = protowkt.decode_double_value(b).or_fault("w")
      if ("d" + hexint(m.value.to_bits())) != (want) {
        return "check_3 line 3980"
      }
      if (hex(protowkt.encode_double_value(m))) != (h) {
        return "check_3 line 3981"
      }
    } else if want.starts_with("f") {
      let m = protowkt.decode_float_value(b).or_fault("w")
      if ("f" + hexint(Int(m.value.to_bits()))) != (want) {
        return "check_3 line 3984"
      }
      if (hex(protowkt.encode_float_value(m))) != (h) {
        return "check_3 line 3985"
      }
    } else if want.starts_with("i64:") {
      let m = protowkt.decode_int64_value(b).or_fault("w")
      if ("i64:${m.value}") != (want) {
        return "check_3 line 3988"
      }
      if (hex(protowkt.encode_int64_value(m))) != (h) {
        return "check_3 line 3989"
      }
    } else if want.starts_with("u64:") {
      let m = protowkt.decode_uint64_value(b).or_fault("w")
      if ("u64:${m.value}") != (want) {
        return "check_3 line 3992"
      }
      if (hex(protowkt.encode_uint64_value(m))) != (h) {
        return "check_3 line 3993"
      }
    } else if want.starts_with("i32:") {
      let m = protowkt.decode_int32_value(b).or_fault("w")
      if ("i32:${m.value}") != (want) {
        return "check_3 line 3996"
      }
      if (hex(protowkt.encode_int32_value(m))) != (h) {
        return "check_3 line 3997"
      }
    } else if want.starts_with("u32:") {
      let m = protowkt.decode_uint32_value(b).or_fault("w")
      if ("u32:${m.value}") != (want) {
        return "check_3 line 4000"
      }
      if (hex(protowkt.encode_uint32_value(m))) != (h) {
        return "check_3 line 4001"
      }
    } else if want.starts_with("bool:") {
      let m = protowkt.decode_bool_value(b).or_fault("w")
      if ("bool:${if m.value { 1 } else { 0 }}") != (want) {
        return "check_3 line 4004"
      }
      if (hex(protowkt.encode_bool_value(m))) != (h) {
        return "check_3 line 4005"
      }
    } else if want.starts_with("str:") {
      let m = protowkt.decode_string_value(b).or_fault("w")
      if ("str:${m.value.len()}:${m.value}") != (want) {
        return "check_3 line 4008"
      }
      if (hex(protowkt.encode_string_value(m))) != (h) {
        return "check_3 line 4009"
      }
    } else {
      let m = protowkt.decode_bytes_value(b).or_fault("w")
      if ("bytes:" + hex(m.value)) != (want) {
        return "check_3 line 4012"
      }
      if (hex(protowkt.encode_bytes_value(m))) != (h) {
        return "check_3 line 4013"
      }
    }
  }
  ""
}

/// the corpus test "wire Go never writes: wide 32 bit varints, Empty's unknown fields"
fn check_4() -> Str {
  for (h, want) in WIDE {
    let b = unhex(h)
    let k = want.split(":")[0]
    let got = if k == "ts" {
      let m = protowkt.decode_timestamp(b).or_fault("ts")
      "ts:${m.seconds},${m.nanos}|" + hex(protowkt.encode_timestamp(m))
    } else if k == "du" {
      let m = protowkt.decode_duration(b).or_fault("du")
      "du:${m.seconds},${m.nanos}|" + hex(protowkt.encode_duration(m))
    } else if k == "i32" {
      let m = protowkt.decode_int32_value(b).or_fault("i32")
      "i32:${m.value}|" + hex(protowkt.encode_int32_value(m))
    } else if k == "u32" {
      let m = protowkt.decode_uint32_value(b).or_fault("u32")
      "u32:${m.value}|" + hex(protowkt.encode_uint32_value(m))
    } else {
      "empty:|" + hex(protowkt.encode_empty(protowkt.decode_empty(b).or_fault("e")))
    }
    if ((h, got)) != ((h, want)) {
      return "check_4 line 4037"
    }
  }
  ""
}

/// the corpus test "Value, Struct and ListValue"
fn check_5() -> Str {
  for (h, want) in VALUES {
    let m = protowkt.decode_value(unhex(h)).or_fault("v")
    if (val(m)) != (want) {
      return "check_5 line 4044"
    }
    if (hex(protowkt.encode_value(m))) != (h) {
      return "check_5 line 4045"
    }
  }
  for (h, want) in STRUCTS {
    let m = protowkt.decode_struct(unhex(h)).or_fault("s")
    if (strct(m)) != (want) {
      return "check_5 line 4049"
    }
    if (hex(protowkt.encode_struct(m))) != (h) {
      return "check_5 line 4050"
    }
  }
  for (h, want) in LISTS {
    let m = protowkt.decode_list_value(unhex(h)).or_fault("l")
    if (lst(m)) != (want) {
      return "check_5 line 4054"
    }
    if (hex(protowkt.encode_list_value(m))) != (h) {
      return "check_5 line 4055"
    }
  }
  ""
}

fn masks_of(text: Str) -> List[protowkt.FieldMask] {
  text.split(";").map(fn(m: Str) -> protowkt.FieldMask {
    protowkt.FieldMask{paths: if m.is_empty() { [] } else { m.split("|") }}
  })
}

fn json_of(h: Str) -> json.Value {
  json.parse_value(unhex(h).to_str_lossy()).or_fault("json")
}

/// the corpus test "timestamp_of and duration_from_nanos, as timestamppb.New and durationpb.New"
fn check_6() -> Str {
  for (ns, h) in TIMES_OF {
    let n = Int.parse(ns) ?? 0
    if (hex(protowkt.encode_timestamp(protowkt.timestamp_of(Time.from_unix_nanos(n))))) != (h) {
      return "check_6 line 4072"
    }
  }
  for (ns, h) in DURATIONS_OF {
    let n = Int.parse(ns) ?? 0
    if (hex(protowkt.encode_duration(protowkt.duration_from_nanos(n)))) != (h) {
      return "check_6 line 4076"
    }
  }
  ""
}

/// the corpus test "pack_any, as anypb.New"
fn check_7() -> Str {
  for (src, h) in PACKS {
    let parts = src.split(",")
    if (hex(protowkt.encode_any(protowkt.pack_any(parts[0], unhex(parts[1]))))) != (h) {
      return "check_7 line 4083"
    }
  }
  ""
}

/// the corpus test "union_masks and intersect_masks, as fieldmaskpb.Union and Intersect"
fn check_8() -> Str {
  for (src, want) in UNIONS {
    if (protowkt.union_masks(masks_of(src)).paths.join("|")) != (want) {
      return "check_8 line 4089"
    }
  }
  for (src, want) in INTERSECTS {
    if (protowkt.intersect_masks(masks_of(src)).paths.join("|")) != (want) {
      return "check_8 line 4092"
    }
  }
  ""
}

/// the corpus test "value_from_json, struct_from_json and list_from_json, as structpb.NewValue, NewStruct and NewList"
fn check_9() -> Str {
  for (h, want) in JSON_VALUES {
    if (val(protowkt.value_from_json(json_of(h)).or_fault("v"))) != (want) {
      return "check_9 line 4098"
    }
  }
  for (h, want) in JSON_STRUCTS {
    if (strct(protowkt.struct_from_json(json_of(h)).or_fault("s"))) != (want) {
      return "check_9 line 4101"
    }
  }
  for (h, want) in JSON_LISTS {
    let items = match json_of(h) {
      json.Value.List(items: xs) => xs
      _ => []
    }
    if (lst(protowkt.list_from_json(items).or_fault("l"))) != (want) {
      return "check_9 line 4108"
    }
  }
  if (protowkt.struct_from_json(json.Value.Null).is_err()) != (true) {
    return "check_9 line 4110"
  }
  ""
}

fn jr(v: json.Value) -> Str {
  match v {
    Null => "z"
    Bool(b) => if b { "b1" } else { "b0" }
    Num(n) => "n" + hexint(n.to_bits())
    Int(n) => "i${n}"
    Str(s) => "s${s.len()}:${s}"
    List(items) => "[" + items.map(fn(x: json.Value) -> Str { jr(x) }).join(",") + "]"
    Object(fields) => "{" + fields.map(fn(f: (Str, json.Value)) -> Str { "${f.0.len()}:${f.0}=${jr(f.1)}" }).join(",") + "}"
    Trusted(_, s) => "t${s}"
  }
}

fn sn(src: Str) -> (Int, Int) {
  let p = src.split(",")
  (Int.parse(p[0]) ?? 0, Int.parse(p[1]) ?? 0)
}

/// the corpus test "Timestamp and Duration is_valid, check_valid, as_time and as_nanos, as timestamppb's and durationpb's"
fn check_10() -> Str {
  var bad: List[Str] = []
  for (src, want) in TS_CHECKS {
    let (s, n) = sn(src)
    let ts = protowkt.Timestamp{seconds: s, nanos: Int32.wrapping_from(n)}
    let at = match ts.as_time() {
      Some(t) => "${t.unix_nanos()}"
      None => "none"
    }
    let got = "${ts.is_valid()},${ts.check_valid().is_ok()},${at}"
    if got != want {
      bad.push("ts ${src}: ${got} want ${want}")
    }
  }
  for (src, want) in DU_CHECKS {
    let (s, n) = sn(src)
    let du = protowkt.Duration{seconds: s, nanos: Int32.wrapping_from(n)}
    let got = "${du.is_valid()},${du.check_valid().is_ok()},${du.as_nanos()}"
    if got != want {
      bad.push("du ${src}: ${got} want ${want}")
    }
  }
  if (bad[0..(if bad.len() < 4 { bad.len() } else { 4 })]) != ([]) {
    return "check_10 line 4153"
  }
  ""
}

/// the corpus test "Any's message_name, message_is and unpack, as anypb's MessageName, MessageIs and UnmarshalTo"
fn check_11() -> Str {
  for (src, want) in ANY_CHECKS {
    let at = src.rfind(",") ?? 0
    let a = protowkt.Any{type_url: src[0..at], value: b"\x08\x01"}
    let name = src[at + 1..src.len()]
    let un = match a.unpack(name) {
      Ok(v) => v == a.value
      Err(_) => false
    }
    if ("${a.message_name()},${a.message_is(name)},${un}") != (want) {
      return "check_11 line 4165"
    }
  }
  ""
}

/// the corpus test "FieldMask.normalize, as fieldmaskpb's Normalize"
fn check_12() -> Str {
  for (src, want) in NORMALIZES {
    let paths = if src.is_empty() { [] } else { src.split("|") }
    if (protowkt.FieldMask{paths: paths}.normalize().paths.join("|")) != (want) {
      return "check_12 line 4172"
    }
  }
  ""
}

/// the corpus test "Value, Struct and ListValue to_json, as structpb's AsInterface, AsMap and AsSlice"
fn check_13() -> Str {
  var bad: List[Str] = []
  for (h, want) in VALUE_JSON {
    let got = jr(protowkt.decode_value(unhex(h)).or_fault("v").to_json())
    if got != want {
      bad.push("v ${got} want ${want}")
    }
  }
  for (h, want) in STRUCT_JSON {
    let got = jr(protowkt.decode_struct(unhex(h)).or_fault("s").to_json())
    if got != want {
      bad.push("s ${got} want ${want}")
    }
  }
  for (h, want) in LIST_JSON {
    let got = jr(protowkt.decode_list_value(unhex(h)).or_fault("l").to_json())
    if got != want {
      bad.push("l ${got} want ${want}")
    }
  }
  if (bad[0..(if bad.len() < 4 { bad.len() } else { 4 })]) != ([]) {
    return "check_13 line 4196"
  }
  ""
}

