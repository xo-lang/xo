// protowkt stress program (decision 0616 section 2): 64 tasks run every
// check of the protowkt corpus (internal/stdtest/testdata/corpus/protowkt,
// made by scripts/stdcorpus from protobuf-go v1.36.12's well known types:
// decode and encode of every type, the wrappers, Value, Struct and
// ListValue, timestamp_of, pack_any, the mask operations, the JSON forms,
// validity and conversions), each test of the corpus a check here with
// its expectations as mismatches, for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB
// of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/json
use std/protowkt

/// One pass over every check (start unused: the checks share no state).
fn pass(start: Int) -> Int ! Str {
  let _ = start
  let m1 = check_1()
  if m1 != "" {
    return Err(m1)
  }
  let m2 = check_2()
  if m2 != "" {
    return Err(m2)
  }
  let m3 = check_3()
  if m3 != "" {
    return Err(m3)
  }
  let m4 = check_4()
  if m4 != "" {
    return Err(m4)
  }
  let m5 = check_5()
  if m5 != "" {
    return Err(m5)
  }
  let m6 = check_6()
  if m6 != "" {
    return Err(m6)
  }
  let m7 = check_7()
  if m7 != "" {
    return Err(m7)
  }
  let m8 = check_8()
  if m8 != "" {
    return Err(m8)
  }
  let m9 = check_9()
  if m9 != "" {
    return Err(m9)
  }
  let m10 = check_10()
  if m10 != "" {
    return Err(m10)
  }
  let m11 = check_11()
  if m11 != "" {
    return Err(m11)
  }
  let m12 = check_12()
  if m12 != "" {
    return Err(m12)
  }
  let m13 = check_13()
  if m13 != "" {
    return Err(m13)
  }
  13
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("protowkt stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}


