// The Xo side of std/crc64's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/crc64's result as text, as go/main.go prints package crc64's.
// Kind sum: the CRC-64 of the input whole and as an update of its first
// half's checksum by the rest (ISO and ECMA checksums and update), one line per polynomial joined by
// "; ". See scripts/stdproven/gotests.go.
use std/crc64
use std/base64

fn sums(d: Bytes) -> Str {
  let h = d.len() / 2
  var out: List[Str] = []
  out.push("${crc64.checksum(d, crc64.Poly.Iso)} ${crc64.update(crc64.checksum(d[0..h], crc64.Poly.Iso), d[h..d.len()], crc64.Poly.Iso)}")
  out.push("${crc64.checksum(d, crc64.Poly.Ecma)} ${crc64.update(crc64.checksum(d[0..h], crc64.Poly.Ecma), d[h..d.len()], crc64.Poly.Ecma)}")
  out.join("; ")
}

fn run(kind: Str, inp: List[Bytes]) -> Str {
  match kind {
    "sum" => sums(inp[0])
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Bytes] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?)
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
