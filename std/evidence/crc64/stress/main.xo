// crc64 stress program (decision 0616 section 2): 64 tasks run 64 inputs
// against Go's hash/crc64 (xostressgen, seeded: 0 to 600 random bytes, a
// tenth up to 9,000, past std/native's slicing-by-8 words). Each case
// checks the Iso, Ecma and Nvme checksums against Checksum with
// MakeTable(ISO), MakeTable(ECMA) and MakeTable(0x9a6c9329ac4bc9b5), update
// continued from a split point, and update over the bytes in chunks of the
// case's size (1 to 4,096), which must give the one-shot checksum as Go's
// hash.Hash64 does, for a fixed time. A background task samples the
// resident set every 10 s (Linux /proc/self/status). Pass: no mismatch, no
// fault, and the resident set at the end within 10% or 4 MB of its sample
// at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/crc64

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (h, split, chunk, iso, ecma, nvme) = CASES[i]
    let d = Bytes.from_hex(h).or_fault("hex")
    let n = d.len()
    for (p, want) in [(crc64.Poly.Iso, iso), (crc64.Poly.Ecma, ecma), (crc64.Poly.Nvme, nvme)] {
      let g = crc64.checksum(d, p)
      if g != want {
        return Err("case ${i} (${n} bytes): checksum ${g}, want ${want}")
      }
      let u = crc64.update(crc64.checksum(d[0..split], p), d[split..n], p)
      if u != want {
        return Err("case ${i} (${n} bytes): update at ${split} gave ${u}")
      }
      var c = 0
      var at = 0
      while at < n {
        let e = (at + chunk).min(n)
        c = crc64.update(c, d[at..e], p)
        at = e
      }
      if c != want {
        return Err("case ${i} (${n} bytes): update in chunks of ${chunk} gave ${c}")
      }
      ops += 3
    }
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("crc64 stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}


