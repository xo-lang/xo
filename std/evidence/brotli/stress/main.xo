// brotli stress program (decision 0616 section 2): 64 tasks run std/brotli's decode, a Decompressor in
// 997-byte pieces and encode back to the same bytes over andybalholm/brotli's
// streams, and decode over damaged streams (the corpus .../corpus/brotli),
// for a fixed time. A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/brotli

/// One pass over the streams from offset start: decode, a Decompressor
/// fed 997 bytes at a time, and (for a stream written with no Flush) encode
/// at its quality and window back to the same bytes; then the damaged
/// streams. The operations done, or the first mismatch.
fn pass(start: Int) -> Int ! Str {
  var n = 0
  for k in 0..STREAMS.len() {
    let (how, s, size, h) = STREAMS[(start + k) % STREAMS.len()]
    let data = unhex(s)
    if outcome(data) != "${size} ${h}" || stream_outcome(data, 997, 1073741824) != "${size} ${h}" {
      return Err("decode ${how}")
    }
    let f = how.split(" ")
    if f[3] == "0" {
      let q = Int.parse(f[0].trim_prefix("q")) ?? -1
      let w = Int.parse(f[1].trim_prefix("w")) ?? -1
      if brotli.encode(brotli.decode(data).or_fault("decode"), q, w).to_hex() != s {
        return Err("encode ${how}")
      }
      n += 1
    }
    n += 2
  }
  for k in 0..DAMAGED.len() {
    let (s, size, h, e) = DAMAGED[(start + k) % DAMAGED.len()]
    if outcome(unhex(s)) != (if e == "" { "${size} ${h}" } else { e }) {
      return Err("damaged ${s[0..(if s.len() < 40 { s.len() } else { 40 })]}")
    }
    n += 1
  }
  n
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("brotli stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

