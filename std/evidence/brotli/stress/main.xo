fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

fn fnv(b: Bytes) -> Int {
  var h = -3750763034362895579
  for c in b {
    h = (h ^ Int(c)).wrapping_mul(1099511628211)
  }
  h
}

fn outcome(data: Bytes) -> Str {
  match brotli.decode(data) {
    Ok(out) => "${out.len()} ${fnv(out)}"
    Err(e) => e.display()
  }
}


/// what a Decompressor gives for data written step bytes at a time: the
/// output's length and FNV-1a 64, or the error
fn stream_outcome(data: Bytes, step: Int, max_size: Int) -> Str {
  var z = brotli.decompressor(max_size)
  var out = BytesBuilder.new()
  var at = 0
  while at < data.len() {
    let e = if at + step < data.len() { at + step } else { data.len() }
    match z.write(data[at..e]) {
      Ok(b) => out.write(b)
      Err(er) => return er.display()
    }
    at = e
  }
  match z.finish() {
    Ok(b) => out.write(b)
    Err(er) => return er.display()
  }
  let o = out.freeze()
  "${o.len()} ${fnv(o)}"
}

fn decode_outcome(data: Bytes, max_size: Int) -> Str {
  match brotli.decode(data, max_size) {
    Ok(out) => "${out.len()} ${fnv(out)}"
    Err(e) => e.display()
  }
}





/// replay each stream written with Flush at qualities lo to hi on a
/// Compressor (its Write sizes, a Flush between each two, then Close): how
/// many there were and the ones whose bytes differ
fn flush_band(lo: Int, hi: Int) -> (Int, List[Str]) {
  var bad: List[Str] = []
  var n = 0
  for (how, s, _, _) in STREAMS {
    let f = how.split(" ")
    let q = Int.parse(f[0].trim_prefix("q")) ?? -1
    if f[3] != "0" && q >= lo && q <= hi {
      let w = Int.parse(f[1].trim_prefix("w")) ?? -1
      let data = brotli.decode(unhex(s)).or_fault("decode")
      var e = brotli.compressor(q, w)
      var out = BytesBuilder.new()
      var at = 0
      for (i, k) in f[5].split(",").indexed() {
        let size = Int.parse(k) ?? -1
        if i > 0 {
          out.write(e.flush())
        }
        out.write(e.write(data[at..at + size]))
        at += size
      }
      out.write(e.finish())
      if out.freeze().to_hex() != s {
        bad.push(how)
      }
      n += 1
    }
  }
  (n, bad)
}

/// encode each stream written with no Flush at qualities lo to hi, every
/// parts-th from the part-th: how many there were and the ones whose
/// bytes differ
fn encode_band(lo: Int, hi: Int, part: Int, parts: Int) -> (Int, List[Str]) {
  var bad: List[Str] = []
  var n = 0
  var seen = 0
  for (how, s, _, _) in STREAMS {
    let f = how.split(" ")
    let q = Int.parse(f[0].trim_prefix("q")) ?? -1
    if f[3] == "0" && q >= lo && q <= hi {
      if seen % parts == part {
        let w = Int.parse(f[1].trim_prefix("w")) ?? -1
        let data = brotli.decode(unhex(s)).or_fault("decode")
        if brotli.encode(data, q, w).to_hex() != s {
          bad.push(how)
        }
        n += 1
      }
      seen += 1
    }
  }
  (n, bad)
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
