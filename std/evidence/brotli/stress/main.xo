/// how many STREAMS written with no Flush each encode test checks (encode
/// gives each back byte for byte)
const UNFLUSHED: List[Int] = [39, 54, 8, 10]

/// how many flushed STREAMS each Compressor test checks (the Compressor replays
/// their Write and Flush calls byte for byte)
const FLUSHED: List[Int] = [17, 24, 6, 2]

