// task stress program (decision 0616 section 2): 64 tasks replay the seed 1
// cases of internal/stdtest/taskfuzz_test.go (map_concurrent's results and
// limit, Semaphore's permits, Once's single run, the limit and permit
// faults), each result checked against the answer computed in Go, for a
// fixed time. Every pass also goes through one Semaphore of 8 permits that
// all tasks share, checking that no more than 8 hold it at once. A
// background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its median at the mark.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/task

/// One pass over the cases from offset start: the checks done, or the first
/// mismatch.
fn pass(start: Int, shared: task.Semaphore, held: Mutex[(Int, Int)]) -> Int ! Str {
  var n = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (kind, limit, items, want, msg) = CASES[i]
    if kind >= 3 {
      let got = fault_of(kind, limit)
      if got != msg {
        return Err("case ${i}: fault ${got}")
      }
    } else {
      let (got, most, runs) = run(kind, limit, items)
      if got != want {
        return Err("case ${i}: results ${got.debug()}")
      }
      if kind < 2 && most > limit {
        return Err("case ${i}: ${most} in flight, limit ${limit}")
      }
      if kind == 2 && runs != 1 {
        return Err("case ${i}: f ran ${runs} times")
      }
    }
    let over = shared.with(fn() -> Int ! Never {
      held.with(fn(var p: (Int, Int)) { p = (p.0 + 1, p.1.max(p.0 + 1)) })
      defer held.with(fn(var p: (Int, Int)) { p = (p.0 - 1, p.1) })
      held.with_read(fn(p: (Int, Int)) -> Int { p.0 })
    })
    if over > 8 {
      return Err("case ${i}: ${over} hold the shared semaphore of 8")
    }
    n += 1 + items.len()
  }
  n
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak)
  let shared = task.semaphore(8)
  let held = Mutex[(Int, Int)].new((0, 0))
  let checks = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i, shared, held)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let most = held.with_read(fn(p: (Int, Int)) -> Int { p.1 })
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("task stress: ${checks} checks by ${tasks} tasks in ${minutes} min, 0 mismatches, shared semaphore held by at most ${most} of 8, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}

fn mix(x: Int) -> Int { (x % 1000003) * 2654435761 % 1000003 }

/// An item's work: spin, then Err(x / 2 + 7) when it fails, else Ok(mix(x)).
fn work(x: Int, fail: Bool, spin: Int) -> Int ! Int {
  var acc = 0
  for k in 0..spin {
    acc += k
  }
  if fail {
    return Err(x / 2 + 7 + acc * 0)
  }
  mix(x) + acc * 0
}

fn flat(rs: List[Result[Int, Int]]) -> List[(Bool, Int)] {
  var out: List[(Bool, Int)] = []
  for r in rs {
    match r {
      Ok(v) => out.push((true, v))
      Err(e) => out.push((false, e))
    }
  }
  out
}

/// A case's results, the most items in flight at once, and how many times
/// a Once ran f.
fn run(kind: Int, limit: Int, items: List[(Int, Bool, Int)]) -> (List[(Bool, Int)], Int, Int) {
  let live = Mutex[(Int, Int)].new((0, 0))
  let runs = Mutex[Int].new(0)
  let all = items.len().max(1)
  var rs: List[Result[Int, Int]] = []
  if kind == 0 {
    rs = task.map_concurrent(items, limit, fn(it: (Int, Bool, Int)) -> Int ! Int {
      live.with(fn(var p: (Int, Int)) { p = (p.0 + 1, p.1.max(p.0 + 1)) })
      defer live.with(fn(var p: (Int, Int)) { p = (p.0 - 1, p.1) })
      work(it.0, it.1, it.2)
    })
  } else if kind == 1 {
    let sem = task.semaphore(limit)
    rs = task.map_concurrent(items, all, fn(it: (Int, Bool, Int)) -> Int ! Int {
      sem.with(fn() -> Int ! Int {
        live.with(fn(var p: (Int, Int)) { p = (p.0 + 1, p.1.max(p.0 + 1)) })
        defer live.with(fn(var p: (Int, Int)) { p = (p.0 - 1, p.1) })
        work(it.0, it.1, it.2)
      })
    })
  } else {
    let o: task.Once[Int, Int] = task.once()
    let first = items[0]
    rs = task.map_concurrent(items, all, fn(it: (Int, Bool, Int)) -> Int ! Int {
      o.get(fn() -> Int ! Int {
        runs.with(fn(var n: Int) { n += 1 })
        work(first.0, first.1, it.2)
      })
    })
  }
  (flat(rs), live.with_read(fn(p: (Int, Int)) -> Int { p.1 }), runs.with_read(fn(n: Int) -> Int { n }))
}

/// The fault a limit or permit count of n raises, caught by task.isolate.
fn fault_of(kind: Int, n: Int) -> Str {
  let r = task.isolate(fn() -> Int ! Never {
    if kind == 3 {
      let _ = task.map_concurrent([1], n, fn(x: Int) -> Int ! Never { x })
    } else {
      let _ = task.semaphore(n)
    }
    0
  })
  match r {
    Err(task.Isolated.Faulted(f)) => f.msg
    _ => "no fault"
  }
}

