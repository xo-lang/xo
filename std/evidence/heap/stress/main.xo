// heap stress program (decision 0616 section 2): 64 tasks replay 64
// operation sequences (push, pop, remove, fix, peek) on std/heap heaps from
// from_list against Go's container/heap order and answers, and on tracked
// heaps whose moved callback must leave each element's place (the seed 1 rows
// of internal/stdtest/heapfuzz_test.go), for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB of
// its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/heap

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch. Each case runs on a heap from from_list (Go's order and
/// answers) and on a tracked heap (each element's reported place).
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let (init_s, ops_s, got_s, end_s) = CASES[(start + k) % CASES.len()]
    let (init, ol, want_got, want_end) = (ints(init_s), ops_of(ops_s), ints(got_s), ints(end_s))
    let (got, end) = replay(heap.from_list(with_ids(init), less), ol)
    if got != want_got || keys(end) != want_end {
      return Err("case ${(start + k) % CASES.len()}: got ${got.debug()} ${keys(end).debug()}")
    }
    let at = Mutex[Map[Int, Int]].new({})
    var h = heap.tracked(less, fn(x: (Int, Int), i: Int) { at.with(fn(var m: Map[Int, Int]) { m[x.1] = i }) })
    for x in with_ids(init) {
      h.push(x)
    }
    let (_, items) = replay(h, ol)
    for i in 0..items.len() {
      if at.with_read(fn(m: Map[Int, Int]) -> Int { m.get(items[i].1) ?? -1 }) != i {
        return Err("case ${(start + k) % CASES.len()}: tracked element ${items[i].1} not at ${i}")
      }
    }
    ops += 2 * (init.len() + ol.len())
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("heap stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

/// The operations on h: the values pop, remove and peek gave (-999999 for
/// None), and the final elements.
fn replay(h0: heap.Heap[(Int, Int)], ops: List[(Int, Int)]) -> (List[Int], List[(Int, Int)]) {
  var h = h0
  var got: List[Int] = []
  var id = 1000000
  for (code, arg) in ops {
    match code {
      0 => {
        h.push((arg, id))
        id += 1
      }
      1 => got.push(h.pop().map(fn(x: (Int, Int)) -> Int { x.0 }) ?? -999999)
      2 => got.push(h.remove(arg).map(fn(x: (Int, Int)) -> Int { x.0 }) ?? -999998)
      3 => {
        let i = arg / 1000000000
        let v = arg % 1000000000 - 500000000
        h.fix(i, (v, id))
        id += 1
      }
      _ => got.push(h.peek().map(fn(x: (Int, Int)) -> Int { x.0 }) ?? -999999)
    }
  }
  (got, h.to_list())
}

fn less(a: (Int, Int), b: (Int, Int)) -> Bool { a.0 < b.0 }

fn with_ids(xs: List[Int]) -> List[(Int, Int)] {
  var out: List[(Int, Int)] = []
  for i in 0..xs.len() {
    out.push((xs[i], i))
  }
  out
}

fn keys(xs: List[(Int, Int)]) -> List[Int] { xs.map(fn(x: (Int, Int)) -> Int { x.0 }) }

/// Space separated Ints ("" for none).
fn ints(s: Str) -> List[Int] {
  if s == "" {
    return []
  }
  s.split(" ").map(fn(w: Str) -> Int { Int.parse(w) ?? fault("int ${w}") })
}

/// Space separated code:arg pairs.
fn ops_of(s: Str) -> List[(Int, Int)] {
  if s == "" {
    return []
  }
  s.split(" ").map(fn(w: Str) -> (Int, Int) {
    let (a, b) = w.cut(":") ?? fault("op ${w}")
    (Int.parse(a) ?? fault("code"), Int.parse(b) ?? fault("arg"))
  })
}



