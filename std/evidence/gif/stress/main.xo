// gif stress program (decision 0616 section 2): 64 tasks run 64 GIFs
// against Go's image/gif (xostressgen, seeded: Go's EncodeAll of 1 to 4
// frames of up to 40 by 40 pixels with global or local palettes of 1 to
// 256 entries, delays, disposal methods and loop counts, half of them
// mutated by flipped, set, cut or inserted bytes). Each case checks
// decode_all, decode and decode_config against Go's DecodeAll, Decode and
// DecodeConfig (bounds, delay, disposal, palette and pixels of each frame,
// or Go's error text), and encode_all of what decode_all gave against Go's
// EncodeAll of what DecodeAll gave, for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB
// of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/gif
use std/image

fn hexs(v: List[Int]) -> Str {
  var parts: List[Str] = []
  for x in v {
    parts.push(x.to_str_width(8, 16, true))
  }
  parts.join(",")
}

fn frame_text(m: image.Image, delay: Int, disposal: Int) -> Str {
  "|${m.min_x},${m.min_y},${m.width},${m.height},d${delay},p${disposal},[${hexs(m.palette)}],${m.pix.to_hex()}"
}

/// decode_all's summary and encode_all of its result.
fn all_text(data: Bytes) -> (Str, Str) {
  match gif.decode_all(data) {
    Ok(g) => {
      var s = "${g.width}x${g.height} loop=${g.loop_count} bg=${g.background_index} gpal=[${hexs(g.palette)}] frames=${g.frames.len()}"
      var i = 0
      for f in g.frames {
        s = s + frame_text(f, g.delay[i], if g.disposal.is_empty() { 0 } else { g.disposal[i] })
        i += 1
      }
      let enc = match gif.encode_all(g) {
        Ok(b) => b.to_hex()
        Err(e) => "ERR ${e.msg}"
      }
      (s, enc)
    }
    Err(e) => ("ERR ${e.msg}", "-")
  }
}

fn first_text(data: Bytes) -> Str {
  match gif.decode(data) {
    Ok(m) => frame_text(m, 0, 0)
    Err(e) => "ERR ${e.msg}"
  }
}

fn cfg_text(data: Bytes) -> Str {
  match gif.decode_config(data) {
    Ok(c) => "${c.width}x${c.height} gpal=[${hexs(c.palette)}]"
    Err(e) => "ERR ${e.msg}"
  }
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (h, all, first, cfg, reenc) = CASES[i]
    let d = Bytes.from_hex(h).or_fault("hex")
    let (a, e) = all_text(d)
    if a != all {
      return Err("case ${i}: decode_all ${a}, Go ${all}")
    }
    if e != reenc {
      return Err("case ${i}: encode_all ${e}, Go ${reenc}")
    }
    let f = first_text(d)
    if f != first {
      return Err("case ${i}: decode ${f}, Go ${first}")
    }
    let c = cfg_text(d)
    if c != cfg {
      return Err("case ${i}: decode_config ${c}, Go ${cfg}")
    }
    ops += 4
  }
  Ok(ops)
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("gif stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}


