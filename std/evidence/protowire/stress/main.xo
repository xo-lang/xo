// protowire stress program (decision 0616 section 2): 64 tasks run std/protowire's walk (its fields'
// count and wire kinds, or its error) and wv and wtag against protobuf-go's
// protowire (the seed 0 rows of std/protowire_test.xo),
// for a fixed time. A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/protobuf
use std/protowire

/// One pass over the messages from offset start (deep:n rows are groups
/// nested n deep) and the writes. The operations done, or the first
/// mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..WALK.len() {
    let (b, want) = WALK[(start + k) % WALK.len()]
    var got = ""
    var w = want
    if b.starts_with("deep:") {
      let n = Int.parse(b[5..]) ?? 0
      var o = BytesBuilder.new()
      for _ in 0..n {
        o.write_byte(0x0b)
      }
      for _ in 0..n {
        o.write_byte(0x0c)
      }
      got = walked(o.freeze())
      if !got.starts_with("err:") {
        got = "ok"
      }
    } else {
      got = walked(Bytes.from_hex(b) ?? b"")
      w = letters(want)
    }
    if got != w {
      return Err("walk ${b[0..(if b.len() < 32 { b.len() } else { 32 })]}: ${got} want ${w}")
    }
  }
  for k in 0..WRITE.len() {
    let i = (start + k) % WRITE.len()
    let (n, v, want) = WRITE[i]
    var o = BytesBuilder.new()
    protowire.wv(o, v)
    if n > 0 {
      protowire.wtag(o, n, i % 6)
    }
    if o.freeze().to_hex() != want {
      return Err("write ${n} ${v}")
    }
  }
  WALK.len() + WRITE.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("protowire stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

/// walk's fields as one letter each (s: length delimited, v: varint, o:
/// other), or err:Kind: what the public API shows of a walk.
fn walked(b: Bytes) -> Str {
  match protowire.walk(b) {
    Ok(fs) => fs.map(fn(f: protowire.Fld) -> Str { if protowire.is_s(f) { "s" } else if protowire.is_v(f) { "v" } else { "o" } }).join("")
    Err(e) => "err:" + match e {
      protobuf.ProtoErr.Truncated => "Truncated"
      protobuf.ProtoErr.Overflow => "Overflow"
      protobuf.ProtoErr.BadTag => "BadTag"
      protobuf.ProtoErr.BadWire(_) => "BadWire"
      protobuf.ProtoErr.EndGroup => "EndGroup"
      protobuf.ProtoErr.Recursion => "Recursion"
      protobuf.ProtoErr.BadLength => "BadLength"
      protobuf.ProtoErr.Utf8 => "Utf8"
      _ => "other"
    }
  }
}

/// Go's walk in the same letters.
fn letters(want: Str) -> Str {
  if want.starts_with("err:") {
    return want
  }
  want.split(";").filter(fn(f: Str) -> Bool { !f.is_empty() }).map(fn(f: Str) -> Str {
    let w = f.split("/")[1]
    if w == "2" { "s" } else if w == "0" { "v" } else { "o" }
  }).join("")
}



