/// (set kind, main source, the name render_named executes, missingkey=error, Go's output or err TEXT)
const NAMED_CASES: List[(Int, Str, Str, Bool, Str)] = [
  (0, "A{{.s}}B", "main", false, "AhelloB"),
  (0, "{{define \"d\"}}D{{.i}}{{end}}M", "d", false, "D17"),
  (0, "{{define \"d\"}}D{{.i}}{{end}}M", "main", false, "M"),
  (0, "M", "nope", false, "err template: no template \"nope\" associated with template \"main\""),
  (0, "{{.missing}}", "main", true, "err template: main:1:2: executing \"main\" at <.missing>: map has no entry for key \"missing\""),
  (1, "A{{template \"sub\" .}}B", "main", false, "As:helloB"),
  (1, "A{{template \"sub\" .}}B", "sub", false, "s:hello"),
  (2, "{{template \"a\" .}}", "a", false, "[B17]"),
  (2, "X", "b", false, "B17"),
]

fn first_bad[T](bad: List[T]) -> List[T] { bad[0..(if bad.len() < 20 { bad.len() } else { 20 })] }


fn named_set(kind: Int, main: Str) -> template.Template ! template.TemplateErr {
  let base = template.parse("main", main)?
  if kind == 1 {
    return base.add("sub", "s:{{.s}}")?
  }
  if kind == 2 {
    return base.add("a", "[{{template \"b\" .}}]")?.add("b", "B{{.i}}")?
  }
  base
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
