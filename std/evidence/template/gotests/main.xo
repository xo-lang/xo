// The Xo side of std/template's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/template's result as text, as go/main.go prints package template's.
// Kinds exec, cmp and parse over Go's text/template tables.
// See scripts/stdproven/gotests.go.
use std/template
use std/json
use std/base64

/// Parses a template (exec, parse: name and text; cmp: "{{EXPR}}") and,
/// but for parse, renders it on null data.
fn trun(kind: Str, inp: List[Str]) -> Str {
  let (name, src) = if kind == "cmp" { ("cmp", "{{${inp[0]}}}") } else { (inp[0], inp[1]) }
  let t = match template.parse(name, src) {
    Ok(t) => t
    Err(e) => return "err ${e.display()}"
  }
  if kind == "parse" {
    return "ok"
  }
  match t.render(json.Value.Null) {
    Ok(s) => "ok ${s}"
    Err(e) => "err ${e.display()}"
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "exec" | "parse" | "cmp" => trun(kind, inp)
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
