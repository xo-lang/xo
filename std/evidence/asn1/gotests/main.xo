// The Xo side of std/asn1's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/asn1's result as text, as go/main.go prints package asn1's.
// Kinds bool, int64, int32, bigint, bitstring, oid, utc, gen and bmp
// read one DER value; rightalign is BitString.RightAlign.
// See scripts/stdproven/gotests.go.
use std/asn1
use std/base64

fn bytes_of(s: Str) -> Bytes {
  var b = BytesBuilder.with_capacity(16)
  if !s.is_empty() {
    for p in s.split(",") {
      b.write_byte(UInt8(Int.parse(p) ?? 0))
    }
  }
  b.freeze()
}

fn bytes_text(b: Bytes) -> Str {
  var out = ""
  for i in 0..b.len() {
    if i > 0 {
      out = out + ","
    }
    out = out + "${Int(b[i])}"
  }
  out
}

fn hex_of(s: Str) -> Bytes {
  var b = BytesBuilder.with_capacity(16)
  let digits = "0123456789abcdef"
  var i = 0
  while i + 1 < s.len() {
    let hi = digits.find(s[i..i + 1]) ?? 0
    let lo = digits.find(s[i + 1..i + 2]) ?? 0
    b.write_byte(UInt8(hi * 16 + lo))
    i = i + 2
  }
  b.freeze()
}

/// DER for tag (universal, primitive) and content c.
fn tlv(tag: Int, c: Bytes) -> Bytes {
  var b = BytesBuilder.with_capacity(c.len() + 6)
  b.write_byte(UInt8(tag))
  let n = c.len()
  if n < 128 {
    b.write_byte(UInt8(n))
  } else {
    var k = 0
    var m = n
    while m > 0 {
      k = k + 1
      m = m / 256
    }
    b.write_byte(UInt8(128 + k))
    b.write_be(n, k)
  }
  b.write(c)
  b.freeze()
}

fn parse(kind: Str, inp: List[Str]) -> Str {
  let der = match kind {
    "bool" => tlv(1, bytes_of(inp[0]))
    "int64" | "int32" | "bigint" => tlv(2, bytes_of(inp[0]))
    "bitstring" => tlv(3, bytes_of(inp[0]))
    "oid" => tlv(6, bytes_of(inp[0]))
    "utc" => tlv(23, inp[0].bytes())
    "gen" => tlv(24, inp[0].bytes())
    _ => tlv(30, hex_of(inp[0]))
  }
  let v = match asn1.parse(der) {
    Ok(v) => v
    Err(e) => return if kind == "utc" || kind == "gen" { "err" } else { "err ${e.display()}" }
  }
  match (kind, v) {
    ("bool", asn1.Value.Bool(b)) => "ok ${b}"
    ("int64", asn1.Value.Int(n)) => match n.to_int() {
      Some(i) => "ok ${i}"
      None => "err asn1: structure error: integer too large"
    }
    ("int32", asn1.Value.Int(n)) => match n.to_int() {
      Some(i) => if i < -2147483648 || i > 2147483647 { "err asn1: structure error: integer too large" } else { "ok ${i}" }
      None => "err asn1: structure error: integer too large"
    }
    ("bigint", asn1.Value.Int(n)) => "ok ${n}"
    ("bitstring", asn1.Value.BitString(bs, n)) => "ok ${bytes_text(bs)}/${n}"
    ("oid", asn1.Value.Oid(o)) => "ok ${o.display()}"
    ("utc", asn1.Value.UtcTime(t)) => "ok ${t.unix_nanos()}"
    ("gen", asn1.Value.GeneralizedTime(t)) => "ok ${t.unix_nanos()}"
    ("bmp", asn1.Value.Bmp(s)) => "ok ${s.debug()}"
    _ => "other value"
  }
}

fn right_align(inp: List[Str]) -> Str {
  bytes_text(asn1.right_align(bytes_of(inp[0]), Int.parse(inp[1]) ?? 0))
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "rightalign" => right_align(inp)
    "bool" | "int64" | "int32" | "bigint" | "bitstring" | "oid" | "utc" | "gen" | "bmp" => parse(kind, inp)
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
