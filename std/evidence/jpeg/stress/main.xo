// jpeg stress program (decision 0616 section 2): 64 tasks decode 64
// files (Go's test images and images Go encodes, half of them changed as
// TestJpegFuzz changes them so the decoder fails in many ways) and check
// Decode and DecodeConfig against Go's image/jpeg (jstressgen: the planes'
// CRC-32 and the RGBA conversion, or the error's kind and text), and
// encode each decoded image twice, which must give the same bytes, for a
// fixed time. A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/crc32
use std/jpeg

fn jx_describe(data: Bytes) -> Str {
  match jpeg.decode(data) {
    Ok(img) => {
      if img.model == jpeg.Model.YCbCr && img.cb.len() != img.chroma_width() * img.chroma_height() {
        fault("chroma plane size")
      }
      let rgba = img.to_rgba()
      "ok ${img.model} ${img.width}x${img.height} ${img.subsample} y=${crc32.checksum(img.y)}/${img.y.len()} cb=${crc32.checksum(img.cb)} cr=${crc32.checksum(img.cr)} pix=${crc32.checksum(img.pix)}/${img.pix.len()} rgba=${crc32.checksum(rgba)}"
    }
    Err(e) => jx_kind(e)
  }
}

fn jx_kind(e: jpeg.JpegErr) -> Str {
  match e {
    jpeg.JpegErr.Format(_) => "err format ${e.display()}"
    jpeg.JpegErr.Unsupported(_) => "err unsupported ${e.display()}"
    jpeg.JpegErr.Truncated => "err truncated"
    jpeg.JpegErr.Encode(_) => "err encode ${e.display()}"
  }
}

fn jx_config(data: Bytes) -> Str {
  match jpeg.decode_config(data) {
    Ok(c) => "ok ${c.model} ${c.width}x${c.height}"
    Err(e) => jx_kind(e)
  }
}



/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (data, want, cfg) = CASES[i]
    let got = jx_describe(data)
    if got != want && !got.ends_with("image too large") {
      return Err("decode of case ${i}: ${got}")
    }
    if jx_config(data) != cfg {
      return Err("decode_config of case ${i}")
    }
    if let Ok(img) = jpeg.decode(data) {
      let q = 50 + (start + k) % 50
      let a = jpeg.encode(img, q).map_err(fn(e) { e.display() })?
      let b = jpeg.encode(img, q).map_err(fn(e) { e.display() })?
      if a != b {
        return Err("encode of case ${i} differs between runs")
      }
      ops += 2
    }
    ops += 2
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("jpeg stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

