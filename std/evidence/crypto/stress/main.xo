// crypto stress program (decision 0616 section 2): TASKS tasks run the
// cases below against Go 1.26.11's crypto packages and x/crypto v0.58.0
// (cryptostressgen, seed 616: ~/xo-lead/notes/aws-43/cryptostressgen,
// its source beside this file as gen.go.txt): digests, HMAC and HKDF over
// all 17 hashes at block boundary and random lengths; AES-128-GCM,
// AES-256-GCM, ChaCha20-Poly1305 and XChaCha20-Poly1305 seal, open and a
// forged open; Ed25519 sign and verify; ECDH on X25519, P-256, P-384 and
// P-521; ECDSA P-256 and P-384 verify of Go's signatures (a third of them
// on a changed message); RSA-2048 PKCS #1 v1.5 sign and verify, PSS
// verify of Go's signatures, OAEP decrypt of Go's ciphertexts; ML-KEM-768
// decapsulation of Go's ciphertexts. Each task parses the RSA key once.
// A background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set
// at the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/crypto

const HASHES: List[crypto.Hash] = [crypto.Hash.Md5, crypto.Hash.Sha1, crypto.Hash.Sha224, crypto.Hash.Sha256, crypto.Hash.Sha384, crypto.Hash.Sha512, crypto.Hash.Sha3_256, crypto.Hash.Sha3_512, crypto.Hash.Sha3_224, crypto.Hash.Sha3_384, crypto.Hash.Sha512_224, crypto.Hash.Sha512_256, crypto.Hash.Blake2b_256, crypto.Hash.Blake2b_384, crypto.Hash.Blake2b_512, crypto.Hash.Keccak256, crypto.Hash.Keccak512]

const AEADS: List[(crypto.Aead, Int)] = [(crypto.Aead.AesGcm, 16), (crypto.Aead.AesGcm, 32), (crypto.Aead.ChaCha20Poly1305, 32), (crypto.Aead.XChaCha20Poly1305, 32)]

const CURVES: List[crypto.EcdhCurve] = [crypto.EcdhCurve.X25519, crypto.EcdhCurve.P256, crypto.EcdhCurve.P384, crypto.EcdhCurve.P521]

fn hb(s: Str) -> Bytes { Bytes.from_hex(s) ?? fault("bad hex") }

fn hx(r: Result[Bytes, crypto.KeyErr]) -> Str {
  match r {
    Ok(b) => b.to_hex()
    Err(e) => "err ${e.msg}"
  }
}

/// One case: the operations done, or the mismatch.
fn run_case(i: Int, rsa: crypto.PrivateKey) -> Int ! Str {
  let (kind, sub, a, b, c, d, want) = CASES[i]
  match kind {
    0 => {
      let got = crypto.digest(HASHES[sub], hb(a)).to_hex()
      if got != want {
        return Err("case ${i}: digest ${sub} gave ${got}")
      }
      var x = crypto.hasher(HASHES[sub])
      let m = hb(a)
      let half = m.len() / 2
      x.write(m[0..half])
      x.write(m[half..m.len()])
      if x.sum().to_hex() != want {
        return Err("case ${i}: Hasher ${sub} in two writes")
      }
      2
    }
    1 => {
      let got = crypto.hmac(HASHES[sub], hb(a), hb(b)).to_hex()
      if got != want {
        return Err("case ${i}: hmac ${sub} gave ${got}")
      }
      1
    }
    2 => {
      let n = Int.parse(want.split(" ")[0]) ?? 0
      let got = "${n} ${crypto.hkdf(HASHES[sub], hb(a), hb(b), hb(c), n).to_hex()}"
      if got != want {
        return Err("case ${i}: hkdf ${sub} gave ${got}")
      }
      1
    }
    3 => {
      let (alg, _) = AEADS[sub]
      let k = crypto.aead_key(alg, hb(a)) ?? e => return Err("case ${i}: aead_key ${e.display()}")
      let sealed = k.seal(hb(b), hb(c), hb(d))
      if sealed.to_hex() != want {
        return Err("case ${i}: seal ${sub} gave ${sealed.to_hex()}")
      }
      if k.open(hb(b), sealed, hb(d)).ok() != Some(hb(c)) {
        return Err("case ${i}: open ${sub}")
      }
      let forged = crypto.xor(sealed, Bytes.from_hex("01").or_fault("hex") + b"\x00".repeat(sealed.len() - 1))
      if k.open(hb(b), forged, hb(d)).is_ok() {
        return Err("case ${i}: open ${sub} took a forged message")
      }
      3
    }
    4 => {
      let sig = crypto.ed25519_sign(hb(a), hb(b))
      if sig.to_hex() != want {
        return Err("case ${i}: ed25519_sign gave ${sig.to_hex()}")
      }
      if !crypto.ed25519_verify(crypto.ed25519_public_key(hb(a)), hb(b), sig) {
        return Err("case ${i}: ed25519_verify")
      }
      2
    }
    5 => {
      let ka = crypto.ecdh_private_key(CURVES[sub], hb(a)) ?? e => return Err("case ${i}: ecdh key ${e.msg}")
      let kb = crypto.ecdh_private_key(CURVES[sub], hb(b)) ?? e => return Err("case ${i}: ecdh key ${e.msg}")
      let got = hx(ka.ecdh(kb.public_key()))
      if got != want || hx(kb.ecdh(ka.public_key())) != want {
        return Err("case ${i}: ecdh ${sub} gave ${got}")
      }
      2
    }
    6 => {
      let k = crypto.parse_public_key(hb(a)) ?? e => return Err("case ${i}: parse_public_key ${e.msg}")
      let got = crypto.verify(k, HASHES[Int(hb(d)[0])], hb(b), hb(c))
      if "${got}" != want {
        return Err("case ${i}: ecdsa verify gave ${got}")
      }
      1
    }
    7 => {
      let h = HASHES[Int(hb(d)[0])]
      let p = rsa.public_key()
      if sub == 0 {
        let msg = hb(a)
        let got = hx(crypto.sign_pkcs1v15_digest(rsa, Some(h), crypto.digest(h, msg)))
        if got != want {
          return Err("case ${i}: rsa sign gave ${got}")
        }
        if !crypto.verify(p, h, msg, hb(want)) {
          return Err("case ${i}: rsa verify")
        }
        2
      } else if sub == 1 {
        if !crypto.verify_pss(p, h, hb(a), hb(b)) {
          return Err("case ${i}: rsa verify_pss")
        }
        1
      } else {
        let got = hx(crypto.decrypt_oaep(rsa, h, hb(a), hb(b)))
        if got != want {
          return Err("case ${i}: rsa decrypt_oaep gave ${got}")
        }
        1
      }
    }
    _ => {
      let k = crypto.mlkem_decapsulation_key(crypto.MlkemParams.Mlkem768, hb(a)) ?? e => return Err("case ${i}: mlkem key ${e.msg}")
      let got = hx(k.decapsulate(hb(b)))
      if got != want {
        return Err("case ${i}: decapsulate gave ${got}")
      }
      1
    }
  }
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int, rsa: crypto.PrivateKey) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    ops += run_case((start + k) % CASES.len(), rsa)?
  }
  ops
}

fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        let rsa = crypto.parse_private_key(hb(RSA_KEY)) ?? e => return Err("RSA_KEY: ${e.msg}")
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i, rsa)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("crypto stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

