// RSA decryption timing test (decision 0616 checklist item 3, decision
// 0618): dudect's method (Reparaz, Balasch, Verbauwhede 2017). Two classes
// of ciphertexts that decrypt to blocks failing different padding checks
// (ctgen's data), measured interleaved in a random order, Welch's t-test
// on the times, also on the times below each of several percentiles of a
// warm-up sample (dudect's cropping). Pass: every |t| < 4.5.
//
//   main CLASS_A CLASS_B N    (classes: oaep_first oaep_lhash oaep_sep
//                              v15_head v15_nozero v15_short)
use std/crypto

struct Stat {
  n: List[Int]
  mean: List[Float]
  m2: List[Float]
}

fn (var s: Stat) add(c: Int, x: Float) {
  s.n[c] += 1
  let d = x - s.mean[c]
  s.mean[c] += d / Float(s.n[c])
  s.m2[c] += d * (x - s.mean[c])
}

fn (s: Stat) t() -> Float {
  if s.n[0] < 2 || s.n[1] < 2 {
    return 0.0
  }
  let v0 = s.m2[0] / Float(s.n[0] - 1)
  let v1 = s.m2[1] / Float(s.n[1] - 1)
  (s.mean[0] - s.mean[1]) / (v0 / Float(s.n[0]) + v1 / Float(s.n[1])).sqrt()
}

fn class(name: Str) -> (Str, List[Str]) {
  match name {
    "oaep_first" => ("oaep", OAEP_FIRST)
    "oaep_lhash" => ("oaep", OAEP_LHASH)
    "oaep_sep" => ("oaep", OAEP_SEP)
    "v15_head" => ("pkcs1v15", V15_HEAD)
    "v15_nozero" => ("pkcs1v15", V15_NOZERO)
    _ => ("pkcs1v15", V15_SHORT)
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let n = Int.parse(args[2]) ?? 1000000
  let k = crypto.parse_private_key(Bytes.from_hex(KEY) ?? b"").map_err(fn(e) { e.msg })?
  let (scheme, a) = class(args[0])
  let (_, b) = class(args[1])
  let cs = [a.map(fn(h) { Bytes.from_hex(h) ?? b"" }), b.map(fn(h) { Bytes.from_hex(h) ?? b"" })]
  let clock = os.clock
  // xorshift for the order and the ciphertext picked: public choices
  var x = 0x2545F4914F6CDD1D
  let warm = 20000
  var sample: List[Float] = []
  let pcts = [1.0, 0.99, 0.95, 0.9, 0.75, 0.5]
  var thr: List[Float] = []
  var stats: List[Stat] = []
  for _ in pcts {
    stats.push(Stat{n: [0, 0], mean: [0.0, 0.0], m2: [0.0, 0.0]})
  }
  var faults = 0
  for i in 0..warm + n {
    x = x ^ x.wrapping_shl(13)
    x = x ^ x.shr_logical(7)
    x = x ^ x.wrapping_shl(17)
    let c = x & 1
    let ct = cs[c][(x.shr_logical(8)) & 127]
    let t0 = clock.now()
    let r = if scheme == "oaep" { crypto.decrypt_oaep(k, crypto.Hash.Sha256, ct) } else { crypto.decrypt_pkcs1v15(k, ct) }
    let dt = Float(clock.since(t0).nanos())
    if r.is_ok() {
      faults += 1
    }
    if i < warm {
      sample.push(dt)
      if i == warm - 1 {
        let s = sample.sort()
        for p in pcts {
          thr.push(if p >= 1.0 { 1.0e18 } else { s[Int(p * Float(warm))] })
        }
      }
      continue
    }
    for j in 0..pcts.len() {
      if dt < thr[j] {
        stats[j].add(c, dt)
      }
    }
  }
  var worst = 0.0
  for j in 0..pcts.len() {
    let t = stats[j].t()
    if t.abs() > worst {
      worst = t.abs()
    }
    os.stdio.println("crop ${pcts[j]}: n ${stats[j].n[0]}/${stats[j].n[1]} mean ${stats[j].mean[0].round()}/${stats[j].mean[1].round()} ns t ${t}")
  }
  os.stdio.println("${args[0]} vs ${args[1]}: ${n} measurements, max |t| ${worst}, ${if worst < 4.5 { "pass" } else { "FAIL" }}${if faults > 0 { ", ${faults} decrypted (the data is wrong)" } else { "" }}")
}

