const API_COUNT: Int = 596

fn type_name(t: htmltok.TokenType) -> Str {
  match t {
    Error => "Error"
    Text => "Text"
    StartTag => "StartTag"
    EndTag => "EndTag"
    SelfClosingTag => "SelfClosingTag"
    Comment => "Comment"
    Doctype => "Doctype"
  }
}

/// The escapes of the oracle's q: backslash, quote, dollar, newline, carriage return, tab, controls as \xHH.
fn q(s: Str) -> Str {
  var o = BytesBuilder.new()
  let hex = "0123456789abcdef".bytes()
  for c in s.bytes() {
    if c == 92 {
      o.write_str("\\\\")
    } else if c == 10 {
      o.write_str("\\n")
    } else if c == 13 {
      o.write_str("\\r")
    } else if c == 9 {
      o.write_str("\\t")
    } else if c == 34 {
      o.write_str("\\\"")
    } else if c == 36 {
      o.write_str("\\$")
    } else if c < 32 || c == 127 {
      o.write_str("\\x")
      o.write_byte(hex[Int(c) / 16])
      o.write_byte(hex[Int(c) % 16])
    } else {
      o.write_byte(c)
    }
  }
  o.freeze().to_str_lossy()
}

fn render(input: Str, mode: Int, max_buf: Int) -> (Str, Str) {
  let ctx = ["", "", "title", "textarea", "script", "plaintext", "style"]
  var z = htmltok.tokenizer_fragment(input, ctx[mode])
  if mode == 1 {
    z.allow_cdata(true)
  }
  if max_buf > 0 {
    z.set_max_buf(max_buf)
  }
  var out = ""
  var raws = ""
  while true {
    let tt = z.next()
    let raw = z.raw()
    raws += raw
    if tt == htmltok.TokenType.Error {
      out += "E ${z.err() ?? "?"}\n"
      break
    }
    let t = z.token()
    out += "${type_name(tt)} ${q(t.data)}"
    for a in t.attrs {
      out += " [${q(a.key)}=${q(a.val)}]"
    }
    out += " <${q(raw)}>\n"
  }
  (out, raws)
}




fn render_api(input: Str, mode: Int) -> Str {
  let ctx = ["", "", "title", "textarea", "script", "plaintext", "style"]
  var z = htmltok.tokenizer_fragment(input, ctx[mode])
  var z2 = htmltok.tokenizer_fragment(input, ctx[mode])
  if mode == 1 {
    z.allow_cdata(true)
    z2.allow_cdata(true)
  }
  var out = ""
  while true {
    let tt = z.next()
    let _ = z2.next()
    if tt == htmltok.TokenType.Error {
      out += "E\n"
      break
    }
    out += "${tt} S=${q(z2.token().display())}"
    match tt {
      Text | Comment | Doctype => {
        let t1 = z.text() ?? "?"
        let t2 = z.text() ?? "?"
        out += " T=${q(t1)}|${q(t2)}"
      }
      _ => {
        var (name, more) = z.tag_name()
        out += " N=${q(name)},${more}"
        while more {
          let (k, v, m) = z.tag_attr()
          more = m
          out += " A=${q(k)}=${q(v)},${m}"
        }
        let (k, v, m) = z.tag_attr()
        let (n2, m2) = z.tag_name()
        out += " X=${q(k)}=${q(v)},${m} N2=${q(n2)},${m2}"
      }
    }
    out += "\n"
  }
  out
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 5 to 7 of a 30 minute run) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
