const RENDER_COUNT: Int = 906

/// (s, Go's html.EscapeString)
const ESCAPES: List[(Str, Str)] = [
  ("'\n\t \n<", "&#39;\n\t \n&lt;"),
  ("é\r\r", "é&#13;&#13;"),
  ("\r'", "&#13;&#39;"),
  ("&日 <&amp;\t", "&amp;日 &lt;&amp;amp;\t"),
  (" '\"", " &#39;&#34;"),
  ("a é\"\"", "a é&#34;&#34;"),
  ("&日é a", "&amp;日é a"),
  ("日\n&amp;'", "日\n&amp;amp;&#39;"),
  ("><", "&gt;&lt;"),
  ("'&", "&#39;&amp;"),
  ("\n&\t\"", "\n&amp;\t&#34;"),
  ("ééé<\r", "ééé&lt;&#13;"),
  ("'&a", "&#39;&amp;a"),
  ("é\né\r", "é\né&#13;"),
  ("&\n&amp;&a", "&amp;\n&amp;amp;&amp;a"),
  ("> ", "&gt; "),
  ("\t'a>>>", "\t&#39;a&gt;&gt;&gt;"),
  ("&\r\n ", "&amp;&#13;\n "),
  ("\r", "&#13;"),
  ("\n\n", "\n\n"),
  ("日a&amp;a", "日a&amp;amp;a"),
  ("<\ré", "&lt;&#13;é"),
  ("", ""),
  ("", ""),
  ("éa\r\t", "éa&#13;\t"),
  ("'a\t< ", "&#39;a\t&lt; "),
  ("&amp;a<&\r", "&amp;amp;a&lt;&amp;&#13;"),
  ("<", "&lt;"),
  (">", "&gt;"),
  ("éé\n", "éé\n"),
  ("'\n'<", "&#39;\n&#39;&lt;"),
  ("\n'\"&amp;\t&amp;", "\n&#39;&#34;&amp;amp;\t&amp;amp;"),
  ("\"é\né\n", "&#34;é\né\n"),
  ("\t&amp; \"é&amp;", "\t&amp;amp; &#34;é&amp;amp;"),
  ("&amp;&", "&amp;amp;&amp;"),
  ("&&<\t<", "&amp;&amp;&lt;\t&lt;"),
  ("<", "&lt;"),
  ("\n<", "\n&lt;"),
  ("\"\n日日\n ", "&#34;\n日日\n "),
  ("日日", "日日"),
  ("", ""),
  ("\t\réa", "\t&#13;éa"),
  ("\t日\t\ta", "\t日\t\ta"),
  ("\n<a&日", "\n&lt;a&amp;日"),
  ("", ""),
  ("\t", "\t"),
  ("\na", "\na"),
  ("\"", "&#34;"),
]

/// The escapes of the oracle's q: backslash, quote, dollar, newline, carriage return, tab, controls as \\xHH.
fn q(s: Str) -> Str {
  var o = BytesBuilder.new()
  let hex = "0123456789abcdef".bytes()
  for c in s.bytes() {
    if c == 92 {
      o.write_str("\\\\")
    } else if c == 10 {
      o.write_str("\\n")
    } else if c == 13 {
      o.write_str("\\r")
    } else if c == 9 {
      o.write_str("\\t")
    } else if c == 34 {
      o.write_str("\\\"")
    } else if c == 36 {
      o.write_str("\\$")
    } else if c < 32 || c == 127 {
      o.write_str("\\x")
      o.write_byte(hex[Int(c) / 16])
      o.write_byte(hex[Int(c) % 16])
    } else {
      o.write_byte(c)
    }
  }
  o.freeze().to_str_lossy()
}

fn dump_case(input: Str, ns: Str, tag: Str, scripting: Bool) -> Str {
  let r = if tag == "" {
    htmlparse.parse_with(input, scripting)
  } else if scripting {
    htmlparse.parse_fragment(input, ns, tag)
  } else {
    htmlparse.parse_fragment_with(input, ns, tag, scripting)
  }
  match r {
    Ok(t) => t.dump()
    Err(e) => "ERR ${e.display()}"
  }
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 5 to 7 of a 30 minute run) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
