// png stress program (decision 0616 section 2): 64 tasks decode 80 files
// (40 that decode and 40 that do not: every color type and bit depth,
// interlaced, palettes and tRNS, bad chunks, flipped bits, cut files),
// taken from the fuzz corpus internal/stdtest/testdata/corpus/pngfuzz
// (seed 1), and check decode and decode_config against Go 1.26's
// image/png answers recorded there (the image's model, size, pixels'
// CRC-32 and palette, or the error; two errors of the pixel data stream
// count as the same, as the corpus test counts them); for each that
// decodes, encode it at two levels and decode it back to the same
// pixels (8 bits a channel, Image.at), for a fixed time. A background task samples the resident set
// every 10 s (Linux /proc/self/status). Pass: no mismatch, no fault, and
// the resident set at the end within 10% or 4 MB of its sample at 5
// minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/binary
use std/crc32
use std/png

fn pf_describe(data: Bytes) -> Str {
  match png.decode(data) {
    Ok(img) => {
      var pb = BytesBuilder.new()
      for p in img.palette {
        pb.write(binary.u32_be(p))
      }
      "ok ${img.model} ${img.width}x${img.height} pix=${crc32.checksum(img.pix)}/${img.pix.len()} pal=${img.palette.len()}/${crc32.checksum(pb.freeze())}"
    }
    Err(e) => pf_kind(e)
  }
}

fn pf_kind(e: png.PngErr) -> Str {
  match e {
    png.PngErr.Format(_) => "err format ${e.display()}"
    png.PngErr.Unsupported(_) => "err unsupported ${e.display()}"
    png.PngErr.Truncated => "err truncated"
    png.PngErr.Flate(_) => "err flate"
  }
}

fn pf_config(data: Bytes) -> Str {
  match png.decode_config(data) {
    Ok(c) => "ok ${c.model} ${c.width}x${c.height}"
    Err(e) => pf_kind(e)
  }
}

fn pf_stream(e: Str) -> Bool {
  e.starts_with("err flate") || e == "err truncated" || e.contains("pixel data") || e.contains("bad filter type") || e.contains("zlib:") || e.contains("flate:") || e.contains("unexpected EOF")
}

fn pf_same(got: Str, want: Str) -> Bool {
  got == want || (got.starts_with("err ") && want.starts_with("err ") && pf_stream(got) && pf_stream(want)) || got.ends_with("image too large")
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (s, want, want_config) = CASES[i]
    let got = pf_describe(s)
    if !pf_same(got, want) {
      return Err("case ${i} decode: ${got}")
    }
    let gc = pf_config(s)
    if !pf_same(gc, want_config) {
      return Err("case ${i} decode_config: ${gc}")
    }
    ops += 2
    if let Ok(img) = png.decode(s) {
      for level in [png.Compression.Default, png.Compression.Speed] {
        let enc = png.encode(img, level: level).map_err(fn(e) { "case ${i} encode: ${e.display()}" })?
        let back = png.decode(enc).map_err(fn(e) { "case ${i} decode of the encoding: ${e.display()}" })?
        if back.width != img.width || back.height != img.height {
          return Err("case ${i} round trip size")
        }
        for y in 0..img.height {
          for x in 0..img.width {
            if back.at(x, y) != img.at(x, y) {
              return Err("case ${i} round trip pixel (${x}, ${y})")
            }
          }
        }
        ops += 2
      }
    }
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("png stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

