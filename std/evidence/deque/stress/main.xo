// deque stress program (decision 0616 section 2): 64 tasks replay 64
// operation sequences on std/deque (pushes and pops at both ends, get, front,
// back, a copy written beside the original) against a Go slice model (the
// seed 1 rows of internal/stdtest/dequefuzz_test.go), for a fixed time. A
// background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/deque

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let (cap, ol, answers, end, cpy) = CASES[(start + k) % CASES.len()]
    let (a, e, c) = replay(cap, ol)
    if a != answers || e != end || c != cpy {
      return Err("case ${(start + k) % CASES.len()}: answers ${a} want ${answers}")
    }
    ops += ol.split(" ").len()
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("deque stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn show(x: Int?) -> Str {
  match x {
    Some(v) => "${v}"
    None => "none"
  }
}

fn join(xs: List[Int]) -> Str { xs.map(fn(x: Int) -> Str { "${x}" }).join(" ") }

/// The answers, the final elements, and the copy's elements.
fn replay(cap: Int, ops: Str) -> (Str, Str, Str) {
  var d: deque.Deque[Int] = deque.new(cap: cap)
  var ans: List[Str] = []
  var cpy = ""
  if ops == "" {
    return ("", "", "")
  }
  for w in ops.split(" ") {
    let (cs, avs) = w.cut(":") ?? fault("op ${w}")
    let code = Int.parse(cs) ?? fault("code")
    let arg = Int.parse(avs) ?? fault("arg")
    match code {
      0 => d.push_back(arg)
      1 => d.push_front(arg)
      2 => ans.push(show(d.pop_front()))
      3 => ans.push(show(d.pop_back()))
      4 => ans.push(show(d.get(arg)))
      5 => ans.push(show(d.front()))
      6 => ans.push(show(d.back()))
      _ => {
        var c = d
        c.push_front(arg)
        let _ = c.pop_back()
        cpy = join(c.to_list())
        ans.push("${d.len()}")
      }
    }
  }
  (ans.join(" "), join(d.to_list()), cpy)
}


