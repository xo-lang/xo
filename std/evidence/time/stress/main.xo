// time stress program (decision 0616 section 2): 64 tasks run std/time's
// main operations (format with a layout text and with a parsed Layout,
// parse of what format printed, civil, weekday, RFC 3339 text and parse,
// adding a Duration) over 64 cases for a fixed time, each result checked
// against Go's time package (tstressgen). A background task samples the
// resident set every 10 s (Linux /proc/self/status). Pass: no mismatch, no
// fault, and the resident set at the end within 10% or 4 MB of its sample
// at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/time

fn zone_for(off: Int) -> time.Zone {
  if off == 0 { time.utc() } else { time.fixed("ZZ", Duration.from_secs_int(off)) }
}

/// Go's weekday number (Sunday 0) of an Xo Weekday.
fn go_weekday(w: time.Weekday) -> Int {
  match w {
    Sunday => 0
    Monday => 1
    Tuesday => 2
    Wednesday => 3
    Thursday => 4
    Friday => 5
    Saturday => 6
  }
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (layout, ns, off, text, rfc, year, month, day, wd, later) = CASES[i]
    let z = zone_for(off)
    let t = Time.from_unix_nanos(ns)
    let f = time.format(t, z, layout)
    if f != text {
      return Err("format of case ${i}: got ${f}")
    }
    let l = time.layout(layout)
    if l.format(t, z) != text {
      return Err("Layout.format of case ${i}")
    }
    // what format printed parses back to an instant that prints the same
    let back = time.parse(text, layout, z).map_err(fn(e) { "parse of case ${i}: ${e.display()}" })?
    if time.format(back, z, layout) != text {
      return Err("parse of case ${i}: prints ${time.format(back, z, layout)}")
    }
    if t.format_rfc3339() != rfc {
      return Err("RFC 3339 of case ${i}: got ${t.format_rfc3339()}")
    }
    let p = Time.parse_rfc3339(rfc) ?? return Err("parse_rfc3339 of case ${i}")
    if p.unix_nanos() != ns {
      return Err("parse_rfc3339 of case ${i}: ${p.unix_nanos()}")
    }
    let c = time.civil(t, z)
    if c.date.year != year || c.date.month != month || c.date.day != day || go_weekday(c.date.weekday()) != wd {
      return Err("civil of case ${i}: ${c.date.year}-${c.date.month}-${c.date.day}")
    }
    let lt = t + Duration.from_secs_int(45 * 24 * 3600)
    if lt.format_rfc3339() != later {
      return Err("45 days after case ${i}: got ${lt.format_rfc3339()}")
    }
    ops += 8
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("time stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

