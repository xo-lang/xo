// image stress program (decision 0616 section 2): 64 tasks run std/image's color conversions, draw,
// fill and scale against Go's image, image/draw and x/image/draw (the corpus
// .../corpus/image),
// for a fixed time. A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 15 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/image
use std/jpeg

/// One pass over the cases from offset start: the color conversions, then
/// draw, fill and scale onto fresh images. The operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..COLORS.len() {
    let (r, g, b, a, gray, gray16, nrgba) = COLORS[(start + k) % COLORS.len()]
    let c = image.Color{r: r, g: g, b: b, a: a}
    if (c.gray(), c.gray16(), c.nrgba()) != (gray, gray16, nrgba) {
      return Err("color ${r} ${g} ${b} ${a}")
    }
  }
  for k in 0..TO_YCC.len() {
    let (r, g, b, y, cb, cr) = TO_YCC[(start + k) % TO_YCC.len()]
    if image.rgb_to_ycbcr(r, g, b) != (y, cb, cr) {
      return Err("to ycbcr ${r} ${g} ${b}")
    }
  }
  for k in 0..TO_CMYK.len() {
    let (r, g, b, c, m, y, kk) = TO_CMYK[(start + k) % TO_CMYK.len()]
    if image.rgb_to_cmyk(r, g, b) != (c, m, y, kk) {
      return Err("to cmyk ${r} ${g} ${b}")
    }
  }
  for k in 0..DRAW_CASES.len() {
    let (dn, dpix, sn, spix, pal, planes, rc, sp, opi, want) = DRAW_CASES[(start + k) % DRAW_CASES.len()]
    var dst = image.Image{width: 5, height: 4, model: model_of(dn), pix: dpix, palette: if dn == "Paletted" { DRAW_PAL } else { [] }}
    let (yp, cbp, crp) = planes
    var src = image.Image{width: 4, height: 3, model: model_of(sn), pix: spix, palette: pal}
    if sn == "YCbCr" {
      src = image.Image{width: 4, height: 4, model: image.Model.YCbCr, pix: b"", y: yp, cb: cbp, cr: crp, subsample: jpeg.Subsample.S420}
    }
    let (x0, y0, x1, y1) = rc
    let (spx, spy) = sp
    dst.draw(image.Rect{x0: x0, y0: y0, x1: x1, y1: y1}, src, spx, spy, if opi == 0 { image.Op.Over } else { image.Op.Src })
    if dst.pix != want {
      return Err("draw ${dn} from ${sn} op ${opi}")
    }
  }
  for k in 0..FILL_CASES.len() {
    let (dn, dpix, c, rc, opi, want) = FILL_CASES[(start + k) % FILL_CASES.len()]
    var dst = image.Image{width: 5, height: 4, model: model_of(dn), pix: dpix, palette: if dn == "Paletted" { DRAW_PAL } else { [] }}
    let (cr, cg, cb, ca) = c
    let (x0, y0, x1, y1) = rc
    dst.fill(image.Rect{x0: x0, y0: y0, x1: x1, y1: y1}, image.Color{r: cr, g: cg, b: cb, a: ca}, if opi == 0 { image.Op.Over } else { image.Op.Src })
    if dst.pix != want {
      return Err("fill ${dn} op ${opi}")
    }
  }
  for k in 0..NN_CASES.len() {
    let (ki, dn, dpix, sn, spix, drc, src_rc, opi, want) = NN_CASES[(start + k) % NN_CASES.len()]
    var dst = image.Image{width: 5, height: 4, model: model_of(dn), pix: dpix, palette: if dn == "Paletted" { DRAW_PAL } else { [] }}
    let src = image.Image{width: 4, height: 3, model: model_of(sn), pix: spix, palette: if sn == "Paletted" { DRAW_PAL } else { [] }}
    let (dx0, dy0, dx1, dy1) = drc
    let (sx0, sy0, sx1, sy1) = src_rc
    dst.scale(image.Rect{x0: dx0, y0: dy0, x1: dx1, y1: dy1}, src, image.Rect{x0: sx0, y0: sy0, x1: sx1, y1: sy1}, if opi == 0 { image.Op.Over } else { image.Op.Src }, if ki == 0 { image.Kernel.NearestNeighbor } else if ki == 1 { image.Kernel.BiLinear } else if ki == 2 { image.Kernel.CatmullRom } else { image.Kernel.ApproxBiLinear })
    if dst.pix[0..want.len()] != want {
      return Err("scale kernel ${ki} ${dn} from ${sn} op ${opi}")
    }
  }
  COLORS.len() + TO_YCC.len() + TO_CMYK.len() + DRAW_CASES.len() + FILL_CASES.len() + NN_CASES.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("image stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

