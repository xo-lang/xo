// jwt stress program (decision 0616 section 2, task #99): TASKS tasks
// sign seeded claims with HS256, HS384, HS512, ES256, EdDSA, RS256 and
// PS256 (one RSA key made at the start) and encrypt seeded payloads as
// JWE (dir, A128KW, A256GCMKW), and check: a token verifies to its
// claims and its kid, and is refused once expired, with a changed
// signature or for an algorithm not allowed; a JWE decrypts to its
// payload and is refused with another key.
// A background task samples the resident set every 10 s (Linux
// /proc/self/status) and prints it each minute. Pass: no identity
// broken, no fault, and the resident set at the end within 10% or
// 4 MB of its sample at 15 minutes.
//
//   main [MINUTES (30); 0: 500 tokens per task] [TASKS (16)]
use std/crypto
use std/jwt

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

fn bytes_of(x0: Int, n: Int) -> Bytes {
  var x = x0
  var b = BytesBuilder.with_capacity(n)
  for i in 0..n {
    if i % 8 == 0 {
      x = next(x)
    }
    b.write_byte(UInt8((x >> (i % 8 * 7)) & 255))
  }
  b.freeze()
}


struct Claims {
  exp: Int
  iss: Str
  sub: Str
  n: Int
} derive Json, Eq

fn check(os: Os, rsa: crypto.PrivateKey, t: Int, k: Int) -> () ! Str uses rand {
  let at = "task ${t} token ${k}"
  let x = next(t * 1000003 + k)
  let (alg, skey, vkey) = match x % 7 {
    0 | 1 | 2 => {
      let s = jwt.Key.Hmac(secret: Secret.new(bytes_of(x, 16 + (x >> 8) % 64)))
      (if x % 7 == 0 { jwt.Alg.HS256 } else if x % 7 == 1 { jwt.Alg.HS384 } else { jwt.Alg.HS512 }, s, s)
    }
    3 => {
      let p = crypto.generate_key(os.rand, crypto.KeyAlg.EcdsaP256).map_err(fn(e) { "${at}: key: ${e:?}" })?
      (jwt.Alg.ES256, jwt.Key.Private(key: p), jwt.Key.Public(key: p.public_key()))
    }
    4 => {
      let p = crypto.generate_key(os.rand, crypto.KeyAlg.Ed25519).map_err(fn(e) { "${at}: key: ${e:?}" })?
      (jwt.Alg.EdDSA, jwt.Key.Private(key: p), jwt.Key.Public(key: p.public_key()))
    }
    5 => (jwt.Alg.RS256, jwt.Key.Private(key: rsa), jwt.Key.Public(key: rsa.public_key()))
    _ => (jwt.Alg.PS256, jwt.Key.Private(key: rsa), jwt.Key.Public(key: rsa.public_key()))
  }
  let c = Claims{exp: 2000 + k, iss: "issuer ${t}", sub: "s\u{e9}${x % 1000}", n: x}
  let tok = jwt.sign(os.rand, alg, skey, c, Some("kid${t}")).map_err(fn(e) { "${at}: sign: ${e}" })?
  let now = Time.UNIX_EPOCH + Duration.from_secs_int(1000)
  let got = jwt.verify_with[Claims](tok, vkey, jwt.Options{algs: [alg], now: now}).map_err(fn(e) { "${at}: verify: ${e}" })?
  if got != c {
    return Err("${at}: the token verified to other claims")
  }
  let h = jwt.peek_header(tok).map_err(fn(e) { "${at}: header: ${e}" })?
  if h.kid != Some("kid${t}") {
    return Err("${at}: kid ${h.kid:?}")
  }
  let late = Time.UNIX_EPOCH + Duration.from_secs_int(2000 + k + 1)
  if jwt.verify_with[Claims](tok, vkey, jwt.Options{algs: [alg], now: late}) is Ok(..) {
    return Err("${at}: an expired token verified")
  }
  let other = if alg == jwt.Alg.HS256 { jwt.Alg.HS512 } else { jwt.Alg.HS256 }
  if jwt.verify_with[Claims](tok, vkey, jwt.Options{algs: [other], now: now}) is Ok(..) {
    return Err("${at}: a token verified for an algorithm not allowed")
  }
  // a character in the middle of the signature changed (all six bits are data)
  let tb = tok.bytes()
  let i = tb.len() - 10
  var b = BytesBuilder.with_capacity(tb.len())
  for j in 0..tb.len() {
    b.write_byte(if j == i { if tb[j] == 'A' { UInt8('B') } else { UInt8('A') } } else { tb[j] })
  }
  if jwt.verify_with[Claims](b.freeze().to_str() ?? "", vkey, jwt.Options{algs: [alg], now: now}) is Ok(..) {
    return Err("${at}: a changed signature verified")
  }
  let (ka, enc, n) = match (x >> 30) % 4 {
    0 => (jwt.KeyAlg.Dir, jwt.Enc.A256Gcm, 32)
    1 => (jwt.KeyAlg.Dir, jwt.Enc.A128CbcHs256, 32)
    2 => (jwt.KeyAlg.A128KW, jwt.Enc.A128Gcm, 16)
    _ => (jwt.KeyAlg.A256GCMKW, jwt.Enc.A256CbcHs512, 32)
  }
  let key = jwt.JweKey.Symmetric(key: Secret.new(bytes_of(x + 7, n)))
  let payload = bytes_of(x + 9, (x >> 36) % 5000)
  let jwe = jwt.encrypt(os.rand, ka, enc, key, payload).map_err(fn(e) { "${at}: encrypt: ${e}" })?
  let back = jwt.decrypt(jwe, key, [ka], [enc]).map_err(fn(e) { "${at}: decrypt: ${e}" })?
  if back != payload {
    return Err("${at}: the JWE decrypted to other bytes")
  }
  let wrong = jwt.JweKey.Symmetric(key: Secret.new(bytes_of(x + 8, n)))
  if jwt.decrypt(jwe, wrong, [ka], [enc]) is Ok(..) {
    return Err("${at}: a JWE decrypted with another key")
  }
  Ok(())
}

fn worker(os: Os, rsa: crypto.PrivateKey, t: Int, end: Time, passes: Int) -> Int ! Str uses (clock, rand) {
  var k = 0
  while if passes > 0 { k < passes } else { os.clock.now() < end } {
    check(os, rsa, t, k)?
    k += 1
  }
  Ok(k)
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 16 } else { 16 }
  let passes = if minutes == 0 { 500 } else { 0 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let rsa = crypto.generate_key(os.rand, crypto.KeyAlg.Rsa, 2048).or_fault("rsa key")
  let total = scope s {
    s.spawn_background(fn() {
      var marked = false
      var ticks = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        ticks += 1
        if ticks % 6 == 0 && v > 0 {
          os.stdio.println("rss ${ticks / 6} min: ${v / 1024} MB")
        }
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var x) {
          var (m, p) = x
          if after_mark && v > 0 { m.push(v) }
          x = (m, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str { worker(os, rsa, t, end, passes) }))
    }
    var n = 0
    for h in hs {
      n += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    s.cancel()
    n
  }
  let (rss_after, peak) = samples.with_read(fn(x) { x })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("jwt stress: ${total} tokens by ${tasks} tasks in ${minutes} min, 0 identities broken, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
