// The Xo side of std/protobuf's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/protobuf's result as text, as go/main.go prints package protowire's.
// Kind zigzag: encode_zigzag of dec, then decode_zigzag of enc.
// See scripts/stdproven/gotests.go.
use std/protobuf
use std/base64

fn u64(s: Str) -> UInt64 {
  var n: UInt64 = 0
  for c in s.bytes() {
    n = n * 10 + UInt64(Int(c) - 48)
  }
  n
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "zigzag" => "${protobuf.encode_zigzag(Int.parse(inp[0]) ?? 0)}\n${protobuf.decode_zigzag(u64(inp[1]))}"
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
