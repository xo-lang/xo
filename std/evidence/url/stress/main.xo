// url stress program (decision 0616 section 2): 64 tasks run std/url's
// operations (query_escape, path_escape, their inverses, parse_query and
// Values.encode, and Values edits) over 64 cases for a fixed time, each
// result checked against Go's net/url (ustressgen). A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB
// of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/url

fn unescaped(r: Result[Str, url.EscapeErr]) -> Str {
  match r {
    Ok(s) => "ok ${s}"
    Err(e) => "err ${e.display()}"
  }
}

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (text, qe, pe, qu, pu, qv) = CASES[i]
    if url.query_escape(text) != qe {
      return Err("query_escape of case ${i}: got ${url.query_escape(text)}")
    }
    if url.path_escape(text) != pe {
      return Err("path_escape of case ${i}: got ${url.path_escape(text)}")
    }
    if unescaped(url.query_unescape(text)) != qu {
      return Err("query_unescape of case ${i}")
    }
    if unescaped(url.path_unescape(text)) != pu {
      return Err("path_unescape of case ${i}")
    }
    // what an escape printed unescapes back to the text
    if url.query_unescape(qe).ok() != Some(text) || url.path_unescape(pe).ok() != Some(text) {
      return Err("round trip of case ${i}")
    }
    let got = match url.parse_query(text) {
      Ok(v) => "ok ${v.encode()}"
      Err(e) => "err ${e.display()}"
    }
    if got != qv {
      return Err("parse_query of case ${i}: got ${got}")
    }
    // edits: the text under two keys, one replaced, one removed
    var v = url.values()
    v.add("k", text)
    v.add("k", qe)
    v.add("x y", pe)
    v.set("z", text)
    v.remove("z")
    let want = "k=${qe}&k=${url.query_escape(qe)}&x+y=${url.query_escape(pe)}"
    if v.encode() != want {
      return Err("Values edits of case ${i}: got ${v.encode()}")
    }
    ops += 9
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("url stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

