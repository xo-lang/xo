// jsonrpc stress program (decision 0616 section 2): two Conns, A and B,
// joined by two byte pipes in Content-Length framing (header_frame), each
// frame cut into chunks of seeded sizes (1 byte to whole frames) that the
// reading side feeds a HeaderReader. TASKS tasks on each side call the
// other at once: "echo" (a seeded JSON value: nested lists and objects,
// escapes, non-ASCII, strings of up to 64 KiB) must come back exactly;
// "fail" must come back as the peer's error, code and data; "nope" as
// METHOD_NOT_FOUND; now and then a notification (counted by the peer)
// and a call to "slow" whose task is cancelled while it waits (the
// connections carry MCP's cancel notification: the peer's handler task
// must be cancelled, or the program never ends). A background task
// samples the resident set every 10 s (Linux /proc/self/status) and
// prints it each minute. Pass: every answer right, every notification
// counted, no call left in flight, and the resident set at the end within
// 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30); 0: 2,000 calls per task] [TASKS (16)]
use std/json
use std/jsonrpc
use std/task

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

fn str_of(x0: Int) -> Str {
  var x = next(x0)
  let n = if (x >> 40) % 50 == 0 { (x >> 20) % 65536 } else { (x >> 20) % 24 }
  var b = StrBuilder.new()
  for _ in 0..n {
    x = next(x)
    b.write(match (x >> 40) % 12 {
      0 => "\""
      1 => "\\"
      2 => "\n"
      3 => "é"
      4 => "日"
      5 => "\u{1F600}"
      6 => "\u{2028}"
      7 => "<&>"
      8 => "\t"
      _ => "q${(x >> 20) % 10}"
    })
  }
  b.freeze()
}

fn value_of(x0: Int, depth: Int) -> json.Value {
  let x = next(x0)
  match (x >> 50) % (if depth > 3 { 5 } else { 8 }) {
    0 => json.Value.Null
    1 => json.Value.Bool((x >> 30) % 2 == 0)
    2 => json.Value.Int((x >> 10) - (1 << 51))
    3 | 4 => json.Value.Str(str_of(x))
    5 => {
      var xs: List[json.Value] = []
      var y = x
      for _ in 0..(x >> 20) % 5 {
        y = next(y)
        xs.push(value_of(y, depth + 1))
      }
      json.Value.List(xs)
    }
    _ => {
      var fs: List[(Str, json.Value)] = []
      var y = x
      for i in 0..(x >> 20) % 5 {
        y = next(y)
        fs.push(("k${i}${str_of(y >> 3).len() % 3}", value_of(y, depth + 1)))
      }
      json.Value.Object(fs)
    }
  }
}

/// The reading side of a pipe, in g: frames' chunks in, one message at
/// a time out (a frame error ends the stream, and with it the connection).
fn reader(os: Os, g: task.Group, p: Chan[Bytes]) -> fn() -> Str? ! IoErr uses sync {
  let q = Chan[Str].new(cap: 64)
  g.spawn_background(fn() {
    var r = jsonrpc.header_reader()
    while let Some(chunk) = p.recv() {
      match r.feed(chunk) {
        Ok(ms) => {
          for m in ms {
            q.send(m)
          }
        }
        Err(e) => {
          os.stdio.eprintln("jsonrpc stress: frame: ${e.display()}")
          break
        }
      }
    }
    q.close()
  })
  fn() -> Str? ! IoErr uses sync { Ok(q.recv()) }
}

fn writer(p: Chan[Bytes], seed: Int) -> fn(Str) -> () ! IoErr uses sync {
  let cut = Mutex[Int].new(seed)
  fn(t: Str) -> () ! IoErr uses sync {
    let f = jsonrpc.header_frame(t)
    var x = cut.with(fn(var c: Int) -> Int {
      c = next(c)
      c
    })
    var i = 0
    while i < f.len() {
      x = next(x)
      let n = match (x >> 40) % 4 {
        0 => 1
        1 => 1 + (x >> 20) % 16
        2 => 1 + (x >> 20) % 4096
        _ => f.len()
      }
      let j = if i + n > f.len() { f.len() } else { i + n }
      p.send(f[i..j])
      i = j
    }
    Ok(())
  }
}

fn handler(ticks: Atomic[Int]) -> fn(jsonrpc.Request) -> json.Value ! jsonrpc.RpcError uses sync {
  fn(r: jsonrpc.Request) -> json.Value ! jsonrpc.RpcError uses sync {
    if r.method == "echo" {
      return Ok(json.Value.Object([("v", r.params ?? json.Value.Null)]))
    }
    if r.method == "fail" {
      return Err(jsonrpc.RpcError{code: -32001, message: "failed é", data: r.params})
    }
    if r.method == "slow" {
      // waits until its task is cancelled (the peer's cancel notification)
      let _x = Chan[Int].new(cap: 1).recv()
      return Ok(json.Value.Null)
    }
    if r.method == "tick" {
      let _n = ticks.add(1)
      return Ok(json.Value.Null)
    }
    Err(jsonrpc.error_of(jsonrpc.METHOD_NOT_FOUND))
  }
}

fn worker(os: Os, c: jsonrpc.Conn[sync], side: Str, t: Int, end: Time, passes: Int) -> Int ! Str uses (clock, sync) {
  var k = 0
  var notes = 0
  while if passes > 0 { k < passes } else { os.clock.now() < end } {
    let x = next(t * 1000003 + k * 7 + (if side == "a" { 0 } else { 1 << 40 }))
    let at = "${side} task ${t} call ${k}"
    let v = value_of(x, 0)
    match (x >> 45) % 16 {
      0 => {
        match c.call("fail", Some(v)) {
          Err(jsonrpc.CallErr.Rpc(e)) => {
            if e.code != -32001 || e.message != "failed é" || (e.data ?? json.Value.Null).encode() != v.encode() {
              return Err("${at}: fail answered ${e.code} ${e.message} ${(e.data ?? json.Value.Null).encode()}")
            }
          }
          Err(e) => return Err("${at}: fail: ${e.display()}")
          Ok(r) => return Err("${at}: fail answered ${r.encode()}")
        }
      }
      1 => {
        match c.call("nope") {
          Err(jsonrpc.CallErr.Rpc(e)) => {
            if e.code != jsonrpc.METHOD_NOT_FOUND {
              return Err("${at}: nope answered ${e.code}")
            }
          }
          other => return Err("${at}: nope: ${other.is_ok()}")
        }
      }
      2 => {
        c.notify("tick").map_err(fn(e) { "${at}: notify: ${e.display()}" })?
        notes += 1
      }
      3 => {
        // a call cancelled while it waits: dropped here, cancelled there
        scope inner {
          // the task ends in its own error, so nothing awaits it (awaiting a
          // cancelled task is a fault)
          let _t = inner.spawn(fn() {
            c.call("slow").ignore_err("the call is cancelled: its error is the point")
          })
          os.clock.sleep(Duration.from_millis((x >> 20) % 3))
          inner.cancel()
        }
      }
      _ => {
        let got = c.call("echo", Some(v)).map_err(fn(e) { "${at}: echo: ${e.display()}" })?
        let want = json.Value.Object([("v", v)]).encode()
        if got.encode() != want {
          return Err("${at}: echo of ${want.len()} bytes came back as ${got.encode().len()} bytes, not the same")
        }
      }
    }
    k += 1
  }
  Ok(k * 1000000 + notes)
}

fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 16 } else { 16 }
  let passes = if minutes == 0 { 2000 } else { 0 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0)) // (rss at the mark, last rss, peak)
  let ab = Chan[Bytes].new(cap: 64)
  let ba = Chan[Bytes].new(cap: 64)
  let ticks_a = Atomic[Int].new(0)
  let ticks_b = Atomic[Int].new(0)
  let (calls, notes, left) = scope s {
    s.spawn_background(fn() {
      var marked = false
      var n = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        n += 1
        if n % 6 == 0 && v > 0 {
          os.stdio.println("rss ${n / 6} min: ${v / 1024} MB")
        }
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var x) {
          let (m, _, p) = x
          x = (if now_marked { v } else { m }, v, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    let a = jsonrpc.conn(writer(ab, 11), cancel: Some(jsonrpc.mcp_cancel()))
    let b = jsonrpc.conn(writer(ba, 23), cancel: Some(jsonrpc.mcp_cancel()))
    a.serve(s.group(), reader(os, s.group(), ba), handler(ticks_a))
    b.serve(s.group(), reader(os, s.group(), ab), handler(ticks_b))
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str { worker(os, a, "a", t, end, passes) }))
      hs.push(s.spawn(fn() -> Int ! Str { worker(os, b, "b", t, end, passes) }))
    }
    var n = 0
    var notes = 0
    var first: Str? = None
    for h in hs {
      match h.await {
        Ok(r) => {
          n += r / 1000000
          // a's notifications reach b, b's reach a
          notes += r % 1000000
        }
        Err(e) => {
          if first == None {
            first = Some(e)
          }
        }
      }
    }
    if let Some(e) = first {
      ab.close()
      ba.close()
      s.cancel()
      return Err("a task: ${e}")
    }
    // the last notifications are on their way: a call each way behind them
    let _x = a.call("echo").map_err(fn(e) { "a final call: ${e.display()}" })?
    let _y = b.call("echo").map_err(fn(e) { "b final call: ${e.display()}" })?
    let left = a.in_flight() + b.in_flight()
    ab.close()
    ba.close()
    s.cancel()
    (n, notes, left)
  }
  let got_notes = ticks_a.get() + ticks_b.get()
  if got_notes != notes {
    return Err("${notes} notifications sent, ${got_notes} handled")
  }
  if left != 0 {
    return Err("${left} calls still in flight")
  }
  let (at_mark, last, peak) = samples.with_read(fn(x) { x })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("jsonrpc stress: ${calls} calls by ${tasks * 2} tasks in ${minutes} min, ${notes} notifications, every answer right, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}
