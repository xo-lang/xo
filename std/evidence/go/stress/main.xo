// go stress program (decision 0616 section 2): 64 tasks replay the seed 1
// cases of internal/stdtest/gofuzz_test.go at once (Ints, Strs, Bytes,
// Floats, Lists and Maps through go.any and back, strconv, strings, fmt and
// encoding/json calls, go.Error values), each report checked against the
// one Go's own packages give, for a fixed time, so every task crosses the
// Go boundary (goroutine handoff, value conversion) concurrently. std/go
// builds only on the Go backend (decision 0248), so stdproven runs this
// there alone (#152). A background task samples the resident set every 10 s
// (Linux /proc/self/status). Pass: no mismatch, no fault, and the resident
// set at the end within 10% or 4 MB of its median at the mark.
//
//   main [MINUTES (30)] [TASKS (64)]
use go "encoding/json"
use go "fmt"
use go "strconv"
use go "strings"
use std/go


/// One pass over the cases from offset start: the reports checked, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (kind, x, s, sub, b, li, keys, want) = CASES[i]
    let got = report(kind, x, s, sub, b, li, keys)
    if got != want {
      return Err("case ${i} (kind ${kind}): got ${got.debug()}, want ${want.debug()}")
    }
  }
  CASES.len()
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 }   // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak)
  let checks = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("go stress: ${checks} checks by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    // the series shows a steady climb (a leak) from the Go collector's
    // swings between cycles
    os.stdio.println("rss after the mark, MB every 10 s: ${rss_after.map(fn(k) { "${k / 1024}" }).join(" ")}")
    return Err("memory grew ${growth}%")
  }
}

fn opt(o: Str?) -> Str {
  match o {
    Some(v) => "some ${v}"
    None => "none"
  }
}

fn join(xs: List[Int]) -> Str { xs.map(fn(x: Int) -> Str { "${x}" }).join(",") }

/// A case's report, built from what std/go and the Go calls give back; the
/// generator builds the same report from Go's answers.
fn report(kind: Int, x: Int, s: Str, sub: Str, b: Bytes, li: List[Int], keys: List[Str]) -> Str {
  if kind == 0 {
    let a = go.any(x)
    let i = match a.as_int() {
      Some(v) => "some ${v}"
      None => "none"
    }
    return "${a.type_name()}|${a.display()}|${i}|${opt(a.as_str())}|${strconv.itoa(x)}|${fmt.sprintf("%x %d", [x, x])}"
  }
  if kind == 1 {
    let a = go.any(s)
    let f = if a.as_float() == None { "none" } else { "some" }
    return "${a.type_name()}|${a.display()}|${opt(a.as_str())}|${f}|${strings.index(s, sub)}|${strconv.quote(s)}"
  }
  if kind == 2 {
    let a = go.any(b)
    return "${a.type_name()}|${a.display()}|${a.as_bytes() == Some(b)}|${opt(a.as_str())}|${fmt.sprintf("%x", [b])}"
  }
  if kind == 3 {
    let f = Float.from_bits(x)
    let a = go.any(f)
    return "${a.type_name()}|${a.display()}|${a.as_float() == Some(f)}|${strconv.format_float(f, 103, -1, 64)}"
  }
  if kind == 4 {
    return match strconv.atoi(s) {
      Ok(v) => "ok ${v}"
      Err(e) => "err ${e.display()}|${e.go_type()}"
    }
  }
  if kind == 5 {
    let a = go.any(li)
    let back = (a.as_list() ?? []).map(fn(e: go.Any) -> Int { e.as_int() ?? -424242 })
    return "${a.type_name()}|${a.display()}|${join(back)}"
  }
  if kind == 6 {
    var m: Map[Str, Int] = {}
    for (i, k) in keys.indexed() {
      m.put(k, i + 1)
    }
    let a = go.any(m)
    let back = a.as_map() ?? {}
    let es = back.keys().sort().map(fn(k: Str) -> Str { "${k}=${back.get(k).map(fn(e: go.Any) -> Int { e.as_int() ?? -424242 }) ?? -1}" })
    return "${a.type_name()}|${a.display()}|${es.join(",")}"
  }
  if kind == 7 {
    let l = go.out[List[Int]]()
    return match json.unmarshal(s.bytes(), l.any()) {
      Ok(_) => "ok ${join(l.get())}"
      Err(e) => "err ${e.display()}|${e.go_type()}"
    }
  }
  let e = go.error(s)
  "${e.message()}|${e.display()}|${e.go_type()}"
}

