// The Xo side of std/xml's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/xml's result as text, as go/main.go prints package xml's.
// Kinds tok and raw read every token of one text.
// See scripts/stdproven/gotests.go.
use std/xml
use std/base64

fn xrun(kind: Str, inp: List[Str]) -> Str {
  let r = if kind == "raw" { xml.raw_tokens(inp[0]) } else { xml.tokens(inp[0]) }
  match r {
    Ok(ts) => "ok ${ts.len()}"
    Err(e) => "err ${e.display()}"
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "tok" | "raw" => xrun(kind, inp)
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
