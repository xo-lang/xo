struct XInner {
  name: Str
  n xml "n,attr": Int
} derive Xml

struct XBasic {
  id xml "id,attr": Int
  title: Str
  score: Float
  ok: Bool
  note xml "note,omitempty": Str?
  tags xml "tags>tag": List[Str]
  count xml "count,omitempty": Int
  lang xml "lang,attr,omitempty": Str
  inner: XInner
  items xml "item": List[XInner]
  opt: XInner?
  skip xml "-": Str
  text xml ",chardata": Str
} derive Xml

fn show_inner(v: XInner) -> Str { "I{${v.name.quote()} ${v.n}}" }

fn show_basic(v: XBasic) -> Str {
  let note = match v.note {
    Some(s) => s.quote()
    None => "nil"
  }
  let opt = match v.opt {
    Some(i) => show_inner(i)
    None => "nil"
  }
  let tags = v.tags.map(fn(t) { t.quote() }).join(",")
  let items = v.items.map(show_inner).join(",")
  "B{id=${v.id} title=${v.title.quote()} score=${v.score} ok=${v.ok} note=${note} tags=[${tags}] count=${v.count} lang=${v.lang.quote()} inner=${show_inner(v.inner)} items=[${items}] opt=${opt} skip=${v.skip.quote()} text=${v.text.quote()}}"
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 5 to 7 of a 30 minute run) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
