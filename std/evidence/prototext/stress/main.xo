// prototext stress program (decision 0616 section 2): 64 tasks share one
// protojson registry (std/protojson's corpus schema: proto2, proto3 and
// editions messages and the well known types) and write every row of the
// prototext corpus (internal/stdtest/testdata/corpus/prototext, made by
// scripts/stdcorpus/prototextoracle from protobuf-go v1.36.12's
// prototext.Marshal and Format of the same wire bytes), checking each text
// against Go's, for a fixed time. A background task samples the resident
// set every 10 s (Linux /proc/self/status). Pass: no mismatch, no fault,
// and the resident set at the end within 10% or 4 MB of its sample at 5
// minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/protojson
use std/prototext

fn unhex(s: Str) -> Bytes { Bytes.from_hex(s).or_fault("hex") }

/// Where got and want first differ, with some text around it from each.
fn first_diff(got: Str, want: Str) -> Str {
  let g = got.bytes()
  let w = want.bytes()
  var i = 0
  while i < g.len() && i < w.len() && g[i] == w[i] {
    i += 1
  }
  let lo = (i - 30).max(0)
  "at ${i}: got ${g[lo..(i + 40).min(g.len())].to_str_lossy().quote()} want ${w[lo..(i + 40).min(w.len())].to_str_lossy().quote()}"
}

fn opts(fl: Int) -> prototext.Opts {
  prototext.Opts{multiline: (fl & 1) != 0, emit_ascii: (fl & 2) != 0, emit_unknown: (fl & 4) != 0, allow_partial: (fl & 8) != 0}
}

/// One pass over the rows from offset start with registry r: the
/// operations done, or the first mismatch.
fn pass_with(r: protojson.Registry, start: Int) -> Int ! Str {
  for k in 0..MARSHAL.len() {
    let (name, fl, wire, want) = MARSHAL[(start + k) % MARSHAL.len()]
    let got = match prototext.marshal(r, name, unhex(wire), opts(fl)) {
      Ok(t) => t
      Err(e) => "ERR:" + e.display()
    }
    if got != want {
      return Err("marshal ${name} ${fl} ${wire[0..wire.len().min(40)]}: " + first_diff(got, want))
    }
  }
  for k in 0..FORMAT.len() {
    let (name, wire, want) = FORMAT[(start + k) % FORMAT.len()]
    let got = prototext.format(r, name, unhex(wire))
    if got != want {
      return Err("format ${name} ${wire[0..wire.len().min(40)]}: " + first_diff(got, want))
    }
  }
  MARSHAL.len() + FORMAT.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let reg = protojson.registry_from_set(unhex(SCHEMA)).map_err(fn(e) { "schema: ${e}" })?
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass_with(reg, i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("prototext stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}


