// binary stress program (decision 0616 section 2): 64 tasks run std/binary's
// puts, varints and reads over 128 cases against Go's encoding/binary (the
// seed 1 rows of internal/stdtest/binaryfuzz_test.go: values small, near
// powers of two, negative and extreme; bytes with varints cut short and the
// 10 byte overflow forms), for a fixed time. A background task samples the
// resident set every 10 s (Linux /proc/self/status). Pass: no mismatch, no
// fault, and the resident set at the end within 10% or 4 MB of its sample
// at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/binary

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..PUT.len() {
    let (n, want) = PUT[(start + k) % PUT.len()]
    let got = [binary.u16_be(n), binary.u32_be(n), binary.u64_be(n), binary.u16_le(n), binary.u32_le(n), binary.u64_le(n), binary.uvarint(n), binary.varint(n)].map(fn(b) { b.to_hex() }).join(" ")
    if got != want {
      return Err("put ${n}: ${got} want ${want}")
    }
    ops += 8
  }
  for k in 0..GET.len() {
    let (h, at, want) = GET[(start + k) % GET.len()]
    let b = Bytes.from_hex(h).or_fault("hex")
    var w: List[Str] = []
    let fits = fn(sz: Int) -> Bool { at + sz <= b.len() }
    w.push(if fits(2) { "${binary.get_u16_be(b, at)}" } else { "-" })
    w.push(if fits(4) { "${binary.get_u32_be(b, at)}" } else { "-" })
    w.push(if fits(8) { "${binary.get_u64_be(b, at)}" } else { "-" })
    w.push(if fits(2) { "${binary.get_i16_be(b, at)}" } else { "-" })
    w.push(if fits(4) { "${binary.get_i32_be(b, at)}" } else { "-" })
    w.push(if fits(2) { "${binary.get_u16_le(b, at)}" } else { "-" })
    w.push(if fits(4) { "${binary.get_u32_le(b, at)}" } else { "-" })
    w.push(if fits(8) { "${binary.get_u64_le(b, at)}" } else { "-" })
    w.push(if fits(2) { "${binary.get_i16_le(b, at)}" } else { "-" })
    w.push(if fits(4) { "${binary.get_i32_le(b, at)}" } else { "-" })
    w.push(var_text(binary.get_uvarint(b, at)))
    w.push(var_text(binary.get_varint(b, at)))
    if w.join(" ") != want {
      return Err("get ${h} at ${at}: ${w.join(" ")} want ${want}")
    }
    ops += 12
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("binary stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn first_bad[T](bad: List[T]) -> List[T] { bad[0..(if bad.len() < 20 { bad.len() } else { 20 })] }


fn var_text(r: (Int, Int)?) -> Str {
  match r {
    Some((v, n)) => "${v}/${n}"
    None => "none"
  }
}


