// bufio stress program (decision 0616 section 2): 64 tasks read 64 scripted
// streams (data up to 9,000 bytes in chunks of 1 byte to 4 KB) with
// std/bufio's read_line, read_until, read_exact, peek and read against Go's
// bufio.Reader (the seed 1 rows of internal/stdtest/bufiofuzz_test.go), for a
// fixed time. A background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/bufio

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..CASES.len() {
    let (h, sizes, ol, want) = CASES[(start + k) % CASES.len()]
    let data = Bytes.from_hex(h) ?? b""
    let o = ops_of(ol)
    let got = run_ops(bufio.reader(fake(data, ints(sizes))), o).join("|")
    if got != want {
      return Err("case ${(start + k) % CASES.len()} (${data.len()} bytes) differs")
    }
    ops += o.len()
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes 5 to 7), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("bufio stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

/// What a test reads from: data in scripted chunks, optionally an error
/// after some chunks.
struct Chunks {
  data: Bytes
  sizes: List[Int]
  pos: Int = 0
  k: Int = 0
  fail_at: Int = -1
}

struct Fake {
  st: Mutex[Chunks]
}

fn fake(data: Bytes, sizes: List[Int], fail_at: Int = -1) -> Fake {
  Fake{st: Mutex[Chunks].new(Chunks{data: data, sizes: sizes, fail_at: fail_at})}
}

fn (f: Fake) read(max: Int) -> Bytes? ! NetErr uses net {
  f.st.with(fn(var s: Chunks) -> Bytes? ! NetErr {
    if s.k == s.fail_at {
      return Err(NetErr.Timeout)
    }
    if s.pos >= s.data.len() {
      return Ok(None)
    }
    var n = s.sizes[s.k % s.sizes.len()]
    s.k += 1
    if n > max {
      n = max
    }
    if n > s.data.len() - s.pos {
      n = s.data.len() - s.pos
    }
    let out = s.data[s.pos..s.pos + n]
    s.pos += n
    Ok(Some(out))
  })
}

fn (f: Fake) write(data: Bytes) -> () ! NetErr uses net { Ok(()) }

fn (f: Fake) close() {}

fn hex_of(b: Bytes) -> Str {
  var s = ""
  let digits = "0123456789abcdef"
  for c in b {
    let v = Int(c)
    s = s + digits[v >> 4..(v >> 4) + 1] + digits[v & 15..(v & 15) + 1]
  }
  s
}

fn run_ops(r0: bufio.Reader, ops: List[(Str, Int)]) -> List[Str] uses net {
  var r = r0
  var out: List[Str] = []
  for (kind, n) in ops {
    match kind {
      "line" => {
        match r.read_line() {
          Ok(Some(s)) => out.push("s:" + hex_of(s.bytes()))
          Ok(None) => out.push("none")
          Err(e) => out.push("err " + e.display())
        }
      }
      "until" => {
        match r.read_until(UInt8(n)) {
          Ok(Some(b)) => out.push("b:" + hex_of(b))
          Ok(None) => out.push("none")
          Err(e) => out.push("err " + e.display())
        }
      }
      "exact" => {
        match r.read_exact(n) {
          Ok(b) => out.push("b:" + hex_of(b))
          Err(_) => out.push("eof")
        }
      }
      "peek" => {
        match r.peek(n) {
          Ok(b) => out.push("b:" + hex_of(b))
          Err(e) => out.push("err " + e.display())
        }
      }
      _ => {
        match r.read(n) {
          Ok(Some(b)) => out.push("b:" + hex_of(b))
          Ok(None) => out.push("none")
          Err(e) => out.push("err " + e.display())
        }
      }
    }
  }
  out
}

fn ints(s: Str) -> List[Int] { s.split(" ").map(fn(w: Str) -> Int { Int.parse(w) ?? fault("int ${w}") }) }

fn ops_of(s: Str) -> List[(Str, Int)] {
  s.split(" ").map(fn(w: Str) -> (Str, Int) {
    let (k, n) = w.cut(":") ?? fault("op ${w}")
    (k, Int.parse(n) ?? fault("n"))
  })
}


