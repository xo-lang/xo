// sse stress program (decision 0616 section 2): an event stream server in
// this program (std/http on loopback) serves TASKS subscribers, each its
// own numbered stream. A connection streams the subscriber's events from
// the one after its Last-Event-ID, then ends: after 1 to 40 events, cleanly
// or in the middle of an event (its blank line never sent, so the
// subscriber must drop it), with comments as keep-alives, `retry: 0` now
// and then, and data of several lines. The subscriber (sse.subscribe, a
// Source that reconnects with Last-Event-ID) must see every event once, in
// order, with its data, whatever the breaks; at the end of its events the
// server answers 204 and the Source stops. A background task samples the
// resident set every 10 s (Linux /proc/self/status) and prints it each
// minute. Pass: every event once and in order, no fault, and the resident
// set at the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30); 0: 400 events per subscriber] [TASKS (32)]
use std/http
use std/sse

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

/// Event k of stream t: its name and data (lines joined by LF).
fn event_of(t: Int, k: Int) -> (Str, Str) {
  let x = next(t * 1000003 + k)
  let name = ["", "update", "message", "tick é"][(x >> 20) % 4]
  var lines: List[Str] = []
  for i in 0..1 + (x >> 30) % 4 {
    lines.push(match (x >> (32 + i * 3)) % 5 {
      0 => ""
      1 => " lead ${k}"
      2 => "data: ${t}:${k}"
      3 => "日本 ${i}"
      _ => "x".repeat(Int((x >> 8) % 300))
    })
  }
  (name, lines.join("\n"))
}

/// The stream of t from event `from`: Ok when it ended as planned.
fn serve(w: http.BodyWriter, t: Int, from: Int, total: Int, conn: Int, cuts: Atomic[Int]) -> () ! IoErr {
  // each connection its own length and cut: a stream that cut its only
  // event, asked for again from the same event, must not cut it again
  var x = next(t * 7919 + from * 31 + conn * 1000003 + 17)
  let n = 1 + (x >> 20) % 40
  var k = from
  if (x >> 26) % 3 == 0 {
    sse.send(w, sse.comment("keep-alive ${k}"))?
  }
  while k < from + n && (total < 0 || k < total) {
    x = next(x)
    if (x >> 40) % 9 == 0 {
      sse.send(w, "retry: 0\n")?
    }
    let (name, data) = event_of(t, k)
    let text = sse.encode(data, event: name, id: Some("${k}"))
    if k == from + n - 1 && (x >> 33) % 4 == 0 {
      // cut inside the event: the subscriber must drop it and ask for it again
      // half its bytes, backed off to the start of a UTF-8 sequence: the
      // names and data hold é and 日本, and a Str slice inside one faults
      // (the handler's fault ended the connection unseen, a stand-in cut)
      let cut = text.trim_suffix("\n")
      let b = cut.bytes()
      var m = cut.len() / 2
      while m > 0 && (Int(b[m]) & 0xC0) == 0x80 {
        m -= 1
      }
      let _b = cuts.add(1)
      let piece = cut[0..m]
      let _e = cuts.add(-1)
      sse.send(w, piece)?
      return Ok(())
    }
    sse.send(w, text)?
    k += 1
  }
  Ok(())
}

fn subscriber(os: Os, c: http.Client, url: Str, t: Int, end: Time, total: Int) -> Int ! Str uses (net.dial, clock) {
  var s = sse.subscribe(c, os.clock, "${url}/events?t=${t}", retry_ms: 0, max_retries: 20)
  var want = 0
  while true {
    if total < 0 && os.clock.now() >= end {
      break
    }
    match s.next() {
      Ok(Some(e)) => {
        let (name, data) = event_of(t, want)
        let ename = if name.is_empty() { "message" } else { name }
        if e.id != "${want}" || e.event != ename || e.data != data {
          return Err("stream ${t}: got event ${e.id} (${e.event}, ${e.data.len()} bytes), want ${want} (${ename}, ${data.len()} bytes)")
        }
        want += 1
      }
      Ok(None) => break
      Err(e) => return Err("stream ${t} at ${want}: ${e.display()}")
    }
  }
  if total >= 0 && want != total {
    return Err("stream ${t}: ${want} events, want ${total}")
  }
  Ok(want)
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 32 } else { 32 }
  let total = if minutes == 0 { 400 } else { -1 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let streams = Atomic[Int].new(0)
  // cuts begun and never made: a stream whose cut faulted (a fault logs
  // and closes the connection, which the subscriber takes as a cut, so
  // only this count shows it)
  let cuts = Atomic[Int].new(0)
  var r = http.router()
  r.handle("GET /events", fn(req) {
    let t = Int.parse(req.query("t") ?? "") ?? 0
    let from = match req.header("Last-Event-ID") {
      Some(id) => (Int.parse(id) ?? -1) + 1
      None => 0
    }
    if total >= 0 && from >= total {
      return http.text(204, "")
    }
    let conn = streams.add(1)
    var resp = http.stream(200, fn(w) { serve(w, t, from, total, conn, cuts) })
    for (k, v) in sse.headers() {
      resp = resp.with_header(k, v)
    }
    resp
  })
  let srv = http.server(os.net.listen("127.0.0.1:0")?, r)
  let url = "http://${srv.addr()}"
  // a connection per subscriber kept idle between its streams (Go's
  // default of 2 idle per host would redial the rest)
  let client = http.client(os.net).with_max_idle_per_host(tasks + 4)
  let got = scope s {
    s.spawn_background(fn() { srv.serve().ignore_err("the server stops when the stress ends") })
    s.spawn_background(fn() {
      var marked = false
      var ticks = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        ticks += 1
        if ticks % 6 == 0 && v > 0 {
          os.stdio.println("rss ${ticks / 6} min: ${v / 1024} MB")
        }
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var x) {
          var (m, p) = x
          if after_mark && v > 0 { m.push(v) }
          x = (m, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str { subscriber(os, client, url, t, end, total) }))
    }
    var n = 0
    for h in hs {
      n += h.await.map_err(fn(e) { "a subscriber: ${e}" })?
    }
    s.cancel()
    n
  }
  let (rss_after, peak) = samples.with_read(fn(x) { x })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes 5 to 7), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("sse stress: ${got} events by ${tasks} subscribers in ${minutes} min over ${streams.get()} streams, every event once and in order, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if cuts.get() != 0 {
    return Err("${cuts.get()} cuts faulted before they were sent")
  }
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 5 to 7 of a 30 minute run) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
