// The Xo side of std/multipart's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/multipart's result as text, as go/main.go prints package multipart's.
// Kinds boundary: writer(b) against Writer.SetBoundary, ok and the
// boundary or the error's text; disp: file_content_disposition.
// See scripts/stdproven/gotests.go.
use std/multipart
use std/base64

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "boundary" => match multipart.writer(inp[0]) {
      Ok(w) => "ok ${w.boundary()}"
      Err(e) => "err ${e.display()}"
    }
    "disp" => multipart.file_content_disposition(inp[0], inp[1])
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
