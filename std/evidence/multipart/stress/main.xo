// multipart stress program (decision 0616 section 2): TASKS tasks each
// make forms of 1 to 12 parts (fields and files, names and file names
// with quotes, spaces and non-ASCII, extra headers, data of 0 to 70,000
// bytes holding CR, LF, dashes, lines like a boundary and bytes that are
// not UTF-8) under a random boundary, write each with multipart.write, and
// read it back three ways: parse (the body in memory), parse_form, and
// the streaming reader fed chunks of 1 to 9,000 bytes. Every read must
// give back the parts written: names, file names, headers and data. A
// background task samples the resident set every 10 s (Linux
// /proc/self/status) and prints it each minute. Pass: every form read
// back the same, no fault, and the resident set at the end within 10% or
// 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30); 0: 50 forms per task] [TASKS (32)]
use std/multipart

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

fn data(x0: Int, boundary: Str) -> Bytes {
  var x = next(x0)
  let size = match (x >> 30) % 8 {
    0 => 0
    1 => 70000
    2 => 4090 + (x >> 8) % 20
    _ => (x >> 12) % 9000
  }
  var b = BytesBuilder.with_capacity(size + 64)
  while b.len() < size {
    x = next(x)
    match (x >> 40) % 10 {
      0 => b.write(b"\r\n")
      1 => b.write(b"\n--")
      2 => b.write("\r\n--${boundary}x".bytes())
      3 => b.write("x--${boundary}-".bytes())
      4 => b.write(b"\xff\xfe\r")
      _ => {
        for j in 0..(x >> 20) % 200 {
          b.write_byte(UInt8(32 + (j + (x >> 8)) % 95))
        }
      }
    }
  }
  // whole pieces (a cut could leave the boundary at the end, a delimiter)
  b.freeze()
}

fn form(t: Int, k: Int, boundary: Str) -> List[multipart.Part] {
  var x = next(t * 1000003 + k + 7)
  var ps: List[multipart.Part] = []
  let names = ["f", "field two", "caf\u{e9}", "a\"b", "x\\y", "\u{2603}"]
  for i in 0..1 + (x >> 33) % 12 {
    x = next(x)
    let name = "${names[(x >> 10) % names.len()]}${i}"
    let file = if (x >> 20) % 3 == 0 { Some("dir/\u{fc}${i} \"q\".bin") } else { None }
    var h: Map[Str, Str] = {}
    if (x >> 24) % 4 == 0 {
      h.put("X-Extra", "v${i} \u{e9}")
    }
    if file != None {
      h.put("Content-Type", "application/octet-stream")
    }
    ps.push(multipart.Part{name: name, filename: file, headers: h, data: data(x, boundary)})
  }
  ps
}

/// The part as read back (a written part has its Content-Disposition).
fn same(w: multipart.Part, g: multipart.Part) -> Bool {
  if w.name != g.name || w.data != g.data {
    return false
  }
  // the file name is the last path element
  let wf = match w.filename {
    Some(f) => Some(f.split("/").last() ?? f)
    None => None
  }
  if wf != g.filename {
    return false
  }
  for k in w.headers.keys() {
    if w.headers.get(k) != g.headers.get(k) {
      return false
    }
  }
  g.headers.contains("Content-Disposition")
}

fn check(t: Int, k: Int, boundary: Str) -> Int ! Str {
  let ps = form(t, k, boundary)
  let body = multipart.write(ps, boundary)
  let at = "task ${t} form ${k}"
  // in memory
  let got = multipart.parse(body, boundary).map_err(fn(e) { "${at}: parse: ${e}" })?
  if got.len() != ps.len() {
    return Err("${at}: parse: ${got.len()} parts, want ${ps.len()}")
  }
  for i in 0..ps.len() {
    if !same(ps[i], got[i]) {
      return Err("${at}: parse: part ${i} (${ps[i].name}) differs")
    }
  }
  // as a form
  let f = multipart.parse_form(body, boundary).map_err(fn(e) { "${at}: parse_form: ${e}" })?
  for p in ps {
    match p.filename {
      None => {
        if f.values.all(p.name) != [p.data.to_str_lossy()] {
          return Err("${at}: parse_form: field ${p.name} differs")
        }
      }
      Some(_) => {
        let fs = f.files.get(p.name) ?? []
        if fs.len() != 1 || !same(p, fs[0]) {
          return Err("${at}: parse_form: file ${p.name} differs")
        }
      }
    }
  }
  // streamed in chunks
  let pos = Mutex[(Int, Int)].new((0, next(k + t * 31)))
  var r = multipart.reader(fn() -> Bytes? ! Str {
    pos.with(fn(var s) -> Bytes? {
      let (p, x) = s
      if p >= body.len() {
        return None
      }
      let n = 1 + (x >> 20) % 9000
      let e = if p + n > body.len() { body.len() } else { p + n }
      s = (e, next(x))
      Some(body[p..e])
    })
  }, boundary)
  var i = 0
  while let Some(h) = r.next_part().map_err(fn(e) { "${at}: reader: ${e}" })? {
    var d = BytesBuilder.new()
    while let Some(c) = r.read().map_err(fn(e) { "${at}: reader: ${e}" })? {
      d.write(c)
    }
    if i >= ps.len() {
      return Err("${at}: reader: more parts than written")
    }
    let g = multipart.Part{name: h.name, filename: h.filename, headers: h.headers, data: d.freeze()}
    if !same(ps[i], g) {
      return Err("${at}: reader: part ${i} (${ps[i].name}) differs")
    }
    i += 1
  }
  if i != ps.len() {
    return Err("${at}: reader: ${i} parts, want ${ps.len()}")
  }
  Ok(body.len())
}

fn worker(os: Os, t: Int, end: Time, passes: Int) -> (Int, Int) ! Str uses (clock, rand) {
  var k = 0
  var bytes = 0
  while if passes > 0 { k < passes } else { os.clock.now() < end } {
    let boundary = multipart.random_boundary(os.rand)
    bytes += check(t, k, boundary)?
    k += 1
  }
  Ok((k, bytes))
}

fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 32 } else { 32 }
  let passes = if minutes == 0 { 50 } else { 0 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0)) // (rss at the mark, last rss, peak)
  let (forms, bytes) = scope s {
    s.spawn_background(fn() {
      var marked = false
      var ticks = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        ticks += 1
        if ticks % 6 == 0 && v > 0 {
          os.stdio.println("rss ${ticks / 6} min: ${v / 1024} MB")
        }
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var x) {
          let (m, _, p) = x
          x = (if now_marked { v } else { m }, v, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[(Int, Int), Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> (Int, Int) ! Str { worker(os, t, end, passes) }))
    }
    var n = 0
    var b = 0
    for h in hs {
      let (k, x) = h.await.map_err(fn(e) { "a task: ${e}" })?
      n += k
      b += x
    }
    s.cancel()
    (n, b)
  }
  let (at_mark, last, peak) = samples.with_read(fn(x) { x })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("multipart stress: ${forms} forms by ${tasks} tasks in ${minutes} min (${bytes / 1048576} MB written and read back 3 ways), 0 differences, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}
