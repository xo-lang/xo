// std/log stress (decision 0616, task #108): 64 tasks put in the same JSON and
// text handlers at once and write the logfuzz corpus's records (seed 1) for 30
// minutes; every line must be one of the cases' records (Go's encoding/json for
// JSON); then a resident set check.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/log

/// One pass over the cases from offset start: every task puts in the same
/// pair of handlers (configure_handler from 64 tasks at once) and writes
/// the cases; the sink faults on a line that is not one of the cases' JSON
/// or text records. The operations done.
fn pass(start: Int) -> Int ! Str {
  var want: Map[Str, Bool] = {}
  for (_, _, _, _, j, t) in CASES {
    want[j] = true
    want[t] = true
  }
  let sink = log.func_sink(fn(l: Str) {
    if !(want.get(json_t(l)) ?? false) && !(want.get(text_t(l)) ?? false) {
      fault("a record that is no case's: ${l.quote()}")
    }
  })
  log.configure_handler(log.multi([log.json_handler(sink, level: log.Level.Debug), log.text_handler(sink, level: log.Level.Debug)]))
  for k in 0..CASES.len() {
    let (level, msg, with, fields, _, _) = CASES[(start + k) % CASES.len()]
    write(level, msg, with, fields)
  }
  CASES.len()
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let none_yet: List[Int] = []
  let samples = Mutex.new((none_yet, 0))   // (every rss after the mark, peak): decision 0616, medians since 2026-11-17
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        let after_mark = marked || now_marked
        samples.with(fn(var t) {
          var (m, p) = t
          if after_mark && r > 0 { m.push(r) }
          t = (m, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (rss_after, peak) = samples.with_read(fn(t) { t })
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes 5 to 7), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("log stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

fn fields_of(rows: List[(Str, Str, Str)]) -> Map[Str, Debug] {
  var m: Map[Str, Debug] = {}
  for (k, kind, text) in rows {
    match kind {
      "i" => m[k] = Int.parse(text) ?? fault("int ${text}")
      "f" => m[k] = Float.from_bits(Int.parse(text) ?? fault("float ${text}"))
      "b" => m[k] = text == "true"
      _ => m[k] = text
    }
  }
  m
}

fn write(level: Str, msg: Str, with: List[(Str, Str, Str)], fields: List[(Str, Str, Str)]) uses log {
  let fs = fields_of(fields)
  if with.is_empty() {
    match level {
      "DEBUG" => log.debug(msg, fs)
      "INFO" => log.info(msg, fs)
      "WARN" => log.warn(msg, fs)
      _ => log.error(msg, fs)
    }
    return
  }
  let l = log.with(fields_of(with))
  match level {
    "DEBUG" => l.debug(msg, fs)
    "INFO" => l.info(msg, fs)
    "WARN" => l.warn(msg, fs)
    _ => l.error(msg, fs)
  }
}

/// A JSON record with its time as T.
fn json_t(line: Str) -> Str {
  match line.cut("\"time\":\"") {
    Some((a, rest)) => match rest.cut("\"") {
      Some((_, b)) => a + "\"time\":\"T\"" + b
      None => line
    }
    None => line
  }
}

/// A text record without its time.
fn text_t(line: Str) -> Str {
  match line.cut(" ") {
    Some((_, rest)) => rest
    None => line
  }
}


