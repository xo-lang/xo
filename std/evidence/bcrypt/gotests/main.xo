// The Xo side of std/bcrypt's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/bcrypt's result as text, as go/main.go prints package bcrypt's.
// Kind invalid: compare's error for the hash and "anything", then cost's
// result.
// See scripts/stdproven/gotests.go.
use std/bcrypt
use std/base64

fn err_text(r: Result[(), bcrypt.BcryptErr]) -> Str {
  match r {
    Ok(_) => "ok"
    Err(e) => e.display()
  }
}

fn cost_text(h: Str) -> Str {
  match bcrypt.cost(h) {
    Ok(c) => "${c}"
    Err(e) => e.display()
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "invalid" => "${err_text(bcrypt.compare(inp[0], b"anything"))}\n${cost_text(inp[0])}"
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
