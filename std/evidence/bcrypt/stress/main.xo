// bcrypt stress program (decision 0616 section 2, task #99): TASKS tasks
// hash seeded passwords of 0 to 73 bytes at cost 4 (every 50th at 6)
// and check: the hash compares equal to its password and to no other,
// its cost reads back, a password past 72 bytes is refused, and a hash
// with a changed character is refused or does not match.
// A background task samples the resident set every 10 s (Linux
// /proc/self/status) and prints it each minute. Pass: no identity
// broken, no fault, and the resident set at the end within 10% or
// 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30); 0: 300 passwords per task] [TASKS (16)]
use std/bcrypt

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

fn bytes_of(x0: Int, n: Int) -> Bytes {
  var x = x0
  var b = BytesBuilder.with_capacity(n)
  for i in 0..n {
    if i % 8 == 0 {
      x = next(x)
    }
    b.write_byte(UInt8((x >> (i % 8 * 7)) & 255))
  }
  b.freeze()
}


fn check(os: Os, t: Int, k: Int) -> () ! Str uses rand {
  let at = "task ${t} password ${k}"
  let x = next(t * 1000003 + k)
  let n = (x >> 40) % 74
  let pw = bytes_of(x, n)
  let c = if k % 50 == 0 { 6 } else { 4 }
  let h = match bcrypt.hash(pw, os.rand, c) {
    Ok(h) => h
    Err(e) => {
      if n > 72 {
        return Ok(())
      }
      return Err("${at}: hash: ${e}")
    }
  }
  if n > 72 {
    return Err("${at}: a ${n} byte password hashed")
  }
  bcrypt.compare(h, pw).map_err(fn(e) { "${at}: compare: ${e}" })?
  match bcrypt.cost(h) {
    Ok(v) => {
      if v != c {
        return Err("${at}: cost ${v}, want ${c}")
      }
    }
    Err(e) => return Err("${at}: cost: ${e}")
  }
  let other = bytes_of(x + 1, n + 1)
  if bcrypt.compare(h, other) is Ok(..) {
    return Err("${at}: another password matches")
  }
  // a changed character of the hash's last 31 (the checksum) never matches
  let i = h.len() - 1 - (x >> 20) % 31
  let hb = h.bytes()
  var b = BytesBuilder.with_capacity(hb.len())
  for j in 0..hb.len() {
    b.write_byte(if j == i { if hb[j] == 'a' { UInt8('b') } else { UInt8('a') } } else { hb[j] })
  }
  let bad = b.freeze().to_str() ?? ""
  if bcrypt.compare(bad, pw) is Ok(..) {
    return Err("${at}: a changed hash matches")
  }
  Ok(())
}

fn worker(os: Os, t: Int, end: Time, passes: Int) -> Int ! Str uses (clock, rand) {
  var k = 0
  while if passes > 0 { k < passes } else { os.clock.now() < end } {
    check(os, t, k)?
    k += 1
  }
  Ok(k)
}

fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 16 } else { 16 }
  let passes = if minutes == 0 { 300 } else { 0 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0)) // (rss at the mark, last rss, peak)
  let total = scope s {
    s.spawn_background(fn() {
      var marked = false
      var ticks = 0
      while true {
        clock.sleep(10s)
        let v = rss_kib(os)
        ticks += 1
        if ticks % 6 == 0 && v > 0 {
          os.stdio.println("rss ${ticks / 6} min: ${v / 1024} MB")
        }
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var x) {
          let (m, _, p) = x
          x = (if now_marked { v } else { m }, v, if v > p { v } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str { worker(os, t, end, passes) }))
    }
    var n = 0
    for h in hs {
      n += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    s.cancel()
    n
  }
  let (at_mark, last, peak) = samples.with_read(fn(x) { x })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let mem_ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("bcrypt stress: ${total} passwords by ${tasks} tasks in ${minutes} min, 0 identities broken, ${mem}, ${if mem_ok { "pass" } else { "FAIL (memory grew)" }}")
  if !mem_ok {
    return Err("memory grew ${growth}%")
  }
}
