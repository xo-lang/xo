// json stress program (decision 0616 section 2): 64 tasks run std/json's
// main operations (compact, indent, a typed decode and encode, parse_value)
// on 64 documents for a fixed time, each result checked against Go's
// encoding/json answer (jstressgen). A background task samples the
// resident set every 10 s (Linux /proc/self/status). Pass: no mismatch, no
// fault, and the resident set at the end within 10% or 4 MB of its sample
// at 5 minutes (a 6 MB program grew 0.9 MB in 25 minutes and 25.8 billion
// operations on host 2, 2026-11-12: allocator growth, not a leak, which
// would grow with the operations).
//
//   main [MINUTES (30)] [TASKS (64)]
use std/json

struct Item {
  key: Str
  value: Float
} derive Json

struct Doc {
  id: Int
  name: Str
  tags: List[Str]
  score: Float
  active: Bool
  items: List[Item]
} derive Json

/// One pass over the documents from offset start: the operations done, or
/// the first mismatch.
fn pass(start: Int) -> Int ! Str {
  var ops = 0
  for k in 0..DOCS.len() {
    let (input, compact, indent, round) = DOCS[(start + k) % DOCS.len()]
    let c = json.compact(input).map_err(fn(e) { "compact: ${e.go_text()}" })?
    if c != compact {
      return Err("compact of document ${(start + k) % DOCS.len()}: got ${c}")
    }
    let ind = json.indent(c, "", "\t").map_err(fn(e) { "indent: ${e.go_text()}" })?
    if ind != indent {
      return Err("indent of document ${(start + k) % DOCS.len()}")
    }
    let d = json.decode_str[Doc](input).map_err(fn(e) { "decode: ${e.go_text()}" })?
    let back = json.encode_str(d)
    if back != round {
      return Err("round trip of document ${(start + k) % DOCS.len()}: got ${back}")
    }
    let v = json.parse_value(input).map_err(fn(e) { "parse_value: ${e.go_text()}" })?
    if json.decode_str[Doc](json.encode_str(v)).map_err(fn(e) { e.go_text() })? != d {
      return Err("value round trip of document ${(start + k) % DOCS.len()}")
    }
    ops += 5
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("json stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

