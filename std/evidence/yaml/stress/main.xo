// yaml stress program (decision 0616 section 2): 64 tasks decode 64 seeded
// random documents into structs that derive Yaml and parse, re-emit and
// convert to JSON 64 more, against gopkg.in/yaml.v3 v3.0.1 (the seed 1 rows
// of scripts/stdcorpus/yamloracle fuzz), for a fixed time. A background task
// samples the resident set every 10 s (Linux /proc/self/status). Pass: no
// mismatch, no fault, and the resident set at the end within 10% or 4 MB of
// its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/yaml
use std/time

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int) -> Int ! Str {
  for k in 0..CASES.len() {
    let (text, want) = CASES[(start + k) % CASES.len()]
    if show(text) != want {
      return Err("decode ${text.quote()}")
    }
  }
  var ops = CASES.len()
  for k in 0..NODE_CASES.len() {
    let (text, nodes, emit, json) = NODE_CASES[(start + k) % NODE_CASES.len()]
    if show_nodes(text) != nodes {
      return Err("parse_all ${text.quote()}")
    }
    if emit != "SKIP" && show_emit(text) != emit {
      return Err("encode_node ${text.quote()}")
    }
    if json != "SKIP" && show_json(text) != json {
      return Err("to_json ${text.quote()}")
    }
    ops += 3
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("yaml stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

struct Inner {
  x: Int
} derive Yaml

struct T {
  n: Int
  f: Float
  s: Str
  b: Bool
  o: Str?
  l: List[Int]
  m: Map[Str, Str]
  in_ as "in": Inner
} derive Yaml

struct P {
  x: Int
  y: Int
} derive Yaml

struct Opts {
  a as "a,omitempty": Str
  b as "b,omitempty": Int
  c as "c,omitempty": List[Int]
  d yaml "d,flow": List[Int]
  e yaml "e,flow": Map[Str, Int]
  f yaml "f,flow": P
  g yaml "g,omitempty,flow": List[Str]
  h as "h,omitempty": Str?
  i yaml "i,flow": List[P]
  j yaml "j,flow": Str
  k as "k,omitempty": Bool
  l as "l,omitempty": Float
  m: List[Int]
} derive Yaml

struct Item {
  n: Int
  tags: List[Str]
} derive Yaml

struct Cfg {
  name: Str
  api_version as "apiVersion": Str
  port: Int
  ratio: Float
  on: Bool
  o: Str?
  none: Str?
  items: List[Item]
  m: Map[Str, Int]
  empty: List[Int]
  text: Str
  yes: Str
  num: Str
  inner: Item
} derive Yaml

struct Meta {
  name: Str
  tags: List[Str]
} derive Yaml

struct Base {
  id: Int
  meta: Meta
} derive Yaml

struct Top {
  base yaml ",inline": Base
  extra: Str
  hidden as "-": Int
  n: Int
} derive Yaml

struct Im {
  a: Int
  base yaml ",inline": Base
  rest yaml ",inline": Map[Str, Int]
  b: Str
} derive Yaml

fn show_im(text: Str, strict: Bool) -> Str {
  match yaml.decode[Im](text, strict) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(t) => match yaml.encode_value[Im](t) {
      Ok(y) => "OK ${y}"
      Err(e) => "ERR ${e.display().quote()}"
    }
  }
}

fn show_top(text: Str) -> Str {
  show_top_with(text, false)
}

fn show_top_with(text: Str, strict: Bool) -> Str {
  match yaml.decode[Top](text, strict) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(t) => "id=${t.base.id} meta=${t.base.meta.name}/${t.base.meta.tags.join(",")} extra=${t.extra} hidden=${t.hidden} n=${t.n}"
  }
}

struct Rt {
  d: Duration
  b: Bytes
  p: Duration?
  e yaml ",omitempty": Duration
  f yaml ",omitempty": Bytes
} derive Yaml

fn show_rt(text: Str) -> Str {
  match yaml.decode[Rt](text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(r) => {
      var bs: List[Str] = []
      for i in 0..r.b.len() {
        bs.push("${r.b[i]}")
      }
      var fs: List[Str] = []
      for i in 0..r.f.len() {
        fs.push("${r.f[i]}")
      }
      let p = match r.p {
        Some(v) => "${v.nanos()}"
        None => "nil"
      }
      "d=${r.d.nanos()} b=[${bs.join(" ")}] p=${p} e=${r.e.nanos()} f=[${fs.join(" ")}]"
    }
  }
}

struct Nd {
  a: Int
  n: yaml.Node
  z: Str
} derive Yaml

fn show_nd(text: Str) -> Str {
  match yaml.decode[Nd](text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(t) => {
      var out = StrBuilder.new()
      out.write("a=${t.a} z=${t.z}\n")
      if t.n.line == 0 && t.n.value == "null" {
        out.write("zero\n")
      } else {
        dump_node(out, t.n, 0)
      }
      out.freeze()
    }
  }
}

struct Tm {
  t: Time
  p: Time?
  n: Int
} derive Yaml

fn show_tm(text: Str) -> Str {
  match yaml.decode[Tm](text) {
    Err(e) => if e.display().starts_with("yaml: parsing time") { "ERRPARSE" } else { "ERR ${e.display().quote()}" }
    Ok(t) => {
      let p = match t.p {
        Some(v) => "${(v - Time.UNIX_EPOCH).nanos()}"
        None => "nil"
      }
      "t=${(t.t - Time.UNIX_EPOCH).nanos()} p=${p} n=${t.n}"
    }
  }
}

struct Cv {
  t: time.Civil
  p: time.Civil?
  n: Int
} derive Yaml

fn show_cv(text: Str) -> Str {
  match yaml.decode[Cv](text) {
    Err(e) => if e.display().starts_with("yaml: parsing time") { "ERRPARSE" } else { "ERR ${e.display().quote()}" }
    Ok(c) => match yaml.encode_value[Cv](c) {
      Ok(t) => "OK ${t}"
      Err(e) => "ERR ${e.display().quote()}"
    }
  }
}

struct Deep {
  d: List[List[List[List[Str]]]]
} derive Yaml

fn show_deep(text: Str) -> Str {
  match yaml.decode[Deep](text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(v) => {
      var n = 0
      for a in v.d {
        for b in a {
          for c in b {
            n += c.len()
          }
        }
      }
      "leaves=${n}"
    }
  }
}

fn fl(f: Float) -> Str {
  if f.is_nan() {
    return "nan"
  }
  if f.is_inf() {
    return if f > 0.0 { "inf" } else { "-inf" }
  }
  f.to_general(-1)
}

fn show(text: Str) -> Str {
  match yaml.decode[T](text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(t) => show_t(t)
  }
}

fn show_t(t: T) -> Str {
  var ls: List[Str] = []
  for x in t.l {
    ls.push("${x}")
  }
  var ms: List[Str] = []
  for k in t.m.keys().sort() {
    ms.push("${k.quote()}=${(t.m.get(k) ?? "").quote()}")
  }
  let o = match t.o {
    Some(v) => v.quote()
    None => "nil"
  }
  "n=${t.n} f=${fl(t.f)} s=${t.s.quote()} b=${t.b} o=${o} l=[${ls.join(",")}] m={${ms.join(",")}} in=${t.in_.x}"
}

fn node_kind_n(k: yaml.NodeKind) -> Int {
  match k {
    Document => 1
    Sequence => 2
    Mapping => 4
    Scalar => 8
    Alias => 16
  }
}

fn dump_node(var out: StrBuilder, n: yaml.Node, depth: Int) {
  let a = match n.alias {
    Some(t) => t.anchor
    None => "-"
  }
  out.write("${" ".repeat(depth)}${node_kind_n(n.kind)} ${n.tag} ${n.style} ${n.value.quote()} ${n.anchor.quote()} ${n.line}:${n.column} ->${a} ${n.head_comment.quote()} ${n.line_comment.quote()} ${n.foot_comment.quote()}\n")
  for c in n.content {
    dump_node(out, c, depth + 1)
  }
}

fn show_nodes(text: Str) -> Str {
  var out = StrBuilder.new()
  match yaml.parse_all(text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(ns) => {
      for n in ns {
        out.write("doc\n")
        dump_node(out, n, 0)
      }
      out.freeze()
    }
  }
}

fn show_emit(text: Str) -> Str {
  match yaml.parse(text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(n) => {
      if n.content.is_empty() {
        return "SKIP"
      }
      match yaml.encode_node(n) {
        Ok(t) => "OK ${t}"
        Err(e) => "ERR ${e.display().quote()}"
      }
    }
  }
}

fn show_json(text: Str) -> Str {
  match yaml.to_json(text) {
    Ok(t) => "OK ${t}"
    Err(_) => "ERR"
  }
}

fn show_all(text: Str) -> Str {
  match yaml.decode_all[T](text) {
    Err(e) => "ERR ${e.display().quote()}"
    Ok(ts) => {
      var parts: List[Str] = []
      for t in ts {
        parts.push(show_t(t))
      }
      "${ts.len()} docs: ${parts.join(" | ")}"
    }
  }
}

/// (the YAML text, what yaml.v3 decodes it into T as)
const CASES: List[(Str, Str)] = [
  ("f: 1.5", "n=0 f=1.5 s=\"\" b=false o=nil l=[] m={} in=0"),
  ("s: ~\r\ns: x\r\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"s\\\" already defined at line 1\""),
  ("in: {x: 1} # c\r\nin:\n  x: 3\n  y: 4\r\nf: 1.5\r\nl: [1, 2,] # c\r\nf: +1.5\r\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"in\\\" already defined at line 1\\n  line 7: mapping key \\\"f\\\" already defined at line 5\""),
  ("%YAML 1.1\n---\nn: 9223372036854775808\n", "ERR \"yaml: unmarshal errors:\\n  line 3: cannot unmarshal !!int `9223372...` into int\""),
  ("# a comment\r\n<<: 5\r\ns: 123\r\nm: {a: }\r\n", "ERR \"yaml: map merge requires map or sequence of maps as the value\""),
  ("l> [1.5]\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!str `l> [1.5]` into T\""),
  ("<<: 5\nl: [1, ~, 3] # c\nb: n\ns: *a\n", "ERR \"yaml: unknown anchor 'a' referenced\""),
  ("# comment\r\nb: 1\r\n<<: [{n: 3}, {n: 4, s: z}]\r\nin: {x: 1, x: 2}\r\nm: {a: b}\r\nin: 5 # c\r\n# a comment\r\n", "ERR \"yaml: unmarshal errors:\\n  line 6: mapping key \\\"in\\\" already defined at line 4\""),
  ("---\r\no: \"\\x41\"", "n=0 f=0 s=\"\" b=false o=\"A\" l=[] m={} in=0"),
  ("s: null\nn: 2001-12-14\n", "ERR \"yaml: unmarshal errors:\\n  line 2: cannot unmarshal !!timestamp `2001-12-14` into int\""),
  ("in: {}\n's': true # c\n", "n=0 f=0 s=\"true\" b=false o=nil l=[] m={} in=0"),
  ("l: {a: 1}\r\nin:\n  x: 3\n  y: 4\r\nn: 0x # c\r\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!map into List[Int]\\n  line 5: cannot unmarshal !!str `0x` into int\""),
  ("o: !!binary @@ # c\nn: abc # c\nin: {x: 1} # c\n# a comment\nb: \"true\"\no: *a\n", "ERR \"yaml: found character that cannot start any token\""),
  ("{in: {x: 1,", "ERR \"yaml: line 1: did not find expected node content\""),
  ("in: ~\no: &a v ", "n=0 f=0 s=\"\" b=false o=\"v\" l=[] m={} in=0"),
  ("m: {a: b, a: c}\nn: !!str 5\nb: !!bool true\nl:\n  - 1\n  - ~\n  ] 3\nn: !!str 5 # c\n", "ERR \"yaml: line 4: did not find expected '-' indicator\""),
  ("f: .inf # c\r\nl:\n- 4\n- 5\r\nb: on\r\nl: [a] # c\r\ns: 1.50\r\nb: !!bool yes # c\r\ns: *a # c\r\n", "ERR \"yaml: unknown anchor 'a' referenced\""),
  ("n: !=5\r\no: 0x1F\r\ns: &a v # c\r\nm: {a: {b: c}} # c\r\n<<: 5\r\n", "ERR \"yaml: map merge requires map or sequence of maps as the value\""),
  ("l: [] # c\no:|\n  line1\n  line2\n# a comment\n", "ERR \"yaml: line 2: could not find expected ':'\""),
  ("---\nm: ~ # c\ns: a: b\n<<: [{n: 3}, {n: 4, s: z}]\nn: .inf\ns: yes\n<<: ~\nb: y # c\n", "ERR \"yaml: line 3: mapping values are not allowed in this context\""),
  ("l: [[1]]\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!seq into int\""),
  ("---\nin: !!map {x: 1}\n's': {a: b}\nf: -.5 # c\nb: off # c\nin: {x: a} # c\n", "ERR \"yaml: unmarshal errors:\\n  line 6: mapping key \\\"in\\\" already defined at line 2\""),
  ("o: hello world\nn: 0b101\n", "n=5 f=0 s=\"\" b=false o=\"hello world\" l=[] m={} in=0"),
  ("# comment\n\"n\": ~\n", "n=0 f=0 s=\"\" b=false o=nil l=[] m={} in=0"),
  ("f: 1_0.5\nf: 1.5\nn: 9223372036854775807\no: !!binary aGVsbG8=\nb: 0\nm: {1: x}\nf: -0\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"f\\\" already defined at line 1\\n  line 7: mapping key \\\"f\\\" already defined at line 1\\n  line 7: mapping key \\\"f\\\" already defined at line 2\""),
  ("%YAML 1.1\r\n---\r\nn: !!float 3\r\nbase: &a {n: 1, s: from_anchor}\r\n<<: *a\r\ns: \"q\\nr\"\r\nl:\n  - 1\n  - ~\n  - 3\r\nin: {y: 1}\r\ntrue: !!binary @@\r\nn: +3\r\n...\n---\nn: 2\n", "ERR \"yaml: line 12: found character that cannot start any token\""),
  ("# comment\nl:\n- 4\n- 5\n", "n=0 f=0 s=\"\" b=false o=nil l=[4,5] m={} in=0"),
  ("b: 0\r\nl: [[1]]\r\ns: !!str 5\r\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!int `0` into bool\\n  line 2: cannot unmarshal !!seq into int\""),
  ("s: hello world\r\n", "n=0 f=0 s=\"hello world\" b=false o=nil l=[] m={} in=0"),
  ("l: [\"1\"] # c\nzz: 1.50\nm: {true: y}\nb: null\no: \"\\u00e9\"\no: hello world\nf: 0x10\n", "ERR \"yaml: unmarshal errors:\\n  line 6: mapping key \\\"o\\\" already defined at line 5\""),
  ("# comment\nn: !!int 7 # c\nf: ~\nm: {? [a]: b}\ns: a #c\n", "ERR \"yaml: unmarshal errors:\\n  line 4: cannot unmarshal !!seq into string\""),
  ("n: {a: 1}\nb: 1\no: *a\n...\n---\nn: 2\n", "ERR \"yaml: unknown anchor 'a' referenced\""),
  ("{o: !!bina=y @@, in: {x: 1}, m: x}\r\n", "ERR \"yaml: found character that cannot start any token\""),
  ("f: true\nbase: &a {n: 1, s: from_anchor}\n<<: *a\nm:\n  a: 1\n  b: \"2\"\nf: .inf # c\nn : '5'\nb: On\n<<: {n: 2}\n", "ERR \"yaml: unmarshal errors:\\n  line 7: mapping key \\\"f\\\" already defined at line 1\\n  line 10: mapping key \\\"<<\\\" already defined at line 3\""),
  ("N:|\n  line1\n  line2\nb: [true] # c\nin: {x: a}\nb: 1\ns: hello world # c\nin: {}\n", "ERR \"yaml: line 4: mapping values are not allowed in this context\""),
  ("{s: ?23}\n", "ERR \"yaml: did not find expected node content\""),
  ("b: n.\r\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!str `n.` into bool\""),
  ("<<: ~\no: 123\ns: [1, 2]\nm: {a: [1]} # c\n", "ERR \"yaml: map merge requires map or sequence of maps as the value\""),
  ("%YAML 1.1\r\n---\r\nn: true # c\r\nf: 1e400\r\ns: 'it''s'\r\nm: {a: } # c\r\ns: '' # c\r\no: 1.50\r\n", "ERR \"yaml: unmarshal errors:\\n  line 7: mapping key \\\"s\\\" already defined at line 5\""),
  ("o: # not comment # c\n1: - x # c\nin", "ERR \"yaml: line 2: block sequence entries are not allowed in this context\""),
  ("m: {a: {b: c}}\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!map into string\""),
  ("f: -0\r\nf: 1e400\r\nm: [a]\r\nin: {x: 1}\r\nm: {? a}\r\nin:\n  x: 3\r\n", "ERR \"yaml: unmarshal errors:\\n  line 2: mapping key \\\"f\\\" already defined at line 1\\n  line 5: mapping key \\\"m\\\" already defined at line 3\\n  line 6: mapping key \\\"in\\\" already defined at line 4\""),
  ("n: !!str 5\n---\ns: second\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!str `5` into int\""),
  ("s: [1, 2] # c\nl:\n  - 1\n  - 2\n\"n\": 017 # c\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!seq into string\""),
  ("%YAML 1.1\n---\nl: [1.5]\no: 0x1F\nf: 5.\nb: [true] # c\n", "ERR \"yaml: unmarshal errors:\\n  line 6: cannot unmarshal !!seq into bool\""),
  ("{b: 0}\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!int `0` into bool\""),
  ("%YAML 1.1\r\n---\r\nin:\n  x: 3\n  y: 4\r\nm: {true: y}\r\n? n: ~\r\n", "ERR \"yaml: unmarshal errors:\\n  line 7: cannot unmarshal !!map into string\""),
  ("{b: 0, n: 0o17}\n", "ERR \"yaml: unmarshal errors:\\n  line 1: cannot unmarshal !!int `0` into bool\""),
  ("m: {a: }\nf: true\ns: ~ # c\nb: !!bool true # c\nin: !!map ", "ERR \"yaml: unmarshal errors:\\n  line 2: cannot unmarshal !!bool `true` into float64\\n  line 5: cannot unmarshal !!map into Inner\""),
  ("# comment\n# a comment\ns: &a v\nf: [1.5]\n---\ns: second\n", "ERR \"yaml: unmarshal errors:\\n  line 4: cannot unmarshal !!seq into float64\""),
  ("l:\n  - 1\n  - ~\n  - 3\ns: hello world\no: \"\\x41\"\nb: True\nbase: &a {n: 1, s: from_anchor}\n<<: *a\nm: ~\n", "n=1 f=0 s=\"hello world\" b=true o=\"A\" l=[1,3] m={} in=0"),
  ("<<: ~\nl: [[1]]\n", "ERR \"yaml: map merge requires map or sequence of maps as the value\""),
  ("%YAML 1.1\r\n---\r\no: true\r\n", "n=0 f=0 s=\"\" b=false o=\"true\" l=[] m={} in=0"),
  ("in: [", "ERR \"yaml: line 1: did not find expected node content\""),
  ("f: !!float x\r\n# a comment\r\n# a comment\r\n", "ERR \"yaml: cannot decode !!str `x` as a !!float\""),
  ("s: é日本\r\nf: .5\r\nm: {a: [1]}\r\nf: 1.2.3\r\nin: [1] # c\r\nm: {1: x} # c\r\n", "ERR \"yaml: unmarshal errors:\\n  line 4: mapping key \\\"f\\\" already defined at line 2\\n  line 6: mapping key \\\"m\\\" already defined at line 3\""),
  ("o: a: b\nn: 0 # c\n", "ERR \"yaml: mapping values are not allowed in this context\""),
  ("---\nl: [true] # c\nl: [1, ~, 3]\nl: [[1]]\ns: # not comment\no: null # c\nn: 0o17 # c\nn: +3\n", "ERR \"yaml: unmarshal errors:\\n  line 3: mapping key \\\"l\\\" already defined at line 2\\n  line 4: mapping key \\\"l\\\" already defined at line 2\\n  line 4: mapping key \\\"l\\\" already defined at line 3\\n  line 8: mapping key \\\"n\\\" already defined at line 7\""),
  ("b: True\nin:\n  x: 3\nm: {? [a]: b}\n# a comment\nb: on\no: hello world # c\n", "ERR \"yaml: unmarshal errors:\\n  line 6: mapping key \\\"b\\\" already defined at line 1\""),
