  ("(?i)^\\p{Spacingmark}\$", "\u{40b5c}\u{7}\u{fb9}\u{3915d}g\u{2028}\u{c3828}\u{e0001}\u{a8}\u{313b9}\u{f1fd3}\u{c2}\u{ed}\u{a68}\u{109884}\u{2ad4d}\u{d5}\u{c4c56}\u{bffae}\u{9e}\u{aeb8b}\u{50d52}\u{86a25}\u{ef}", "000000000000000000000000"),
