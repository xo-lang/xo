// The Xo side of std/html's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/html's result as text, as go/main.go prints package html's.
// Kind unescape: unescape_string of the input, then escape_string of it
// and of the unescaped text.
// See scripts/stdproven/gotests.go.
use std/html
use std/base64

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "unescape" => "${html.unescape_string(inp[0])}\n${html.escape_string(inp[0])}\n${html.escape_string(html.unescape_string(inp[0]))}"
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
