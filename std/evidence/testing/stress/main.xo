// std/testing stress program (decision 0616 section 2). The fakes live
// only in tests, so this program writes a test file (TEST below) to a
// temporary directory and runs it with `xo test` ($XO_CLI, else bin/xo,
// from the checkout stdproven runs in, on its default backend: the
// program is built per backend, the fakes run where xo test runs them).
// The file has two tests, both
// with TASKS tasks per round on one TestOs:
//
// - every fake at once, 400 rounds: each task works its own MemFs
//   directory (write, append, read, rename, list, remove_all, its view
//   checked after every step), sleeps on the FakeClock, sets and reads
//   the FakeEnv, prints to the FakeStdio and runs a command on the
//   FakeProc; the fakes' totals (lines printed, sleeps and runs
//   recorded) are checked. These fakes record their history by design,
//   so their memory grows with the rounds and is not judged.
// - MemFs and FakeEnv alone for LONG rounds, which keep no history: the
//   test samples the resident set every EVERY rounds from round MARK
//   (about 10 s apart from minute 15 of a 30 minute run, decision 0717)
//   and logs the samples; this program reads them from `xo test -v` and
//   judges them with rss_medians, the rule every stress program shares
//   (decision 0616 as amended 2026-11-17: the median of the 2 minutes
//   after the mark against the median of the last 3, under 10% or 4 MB
//   of growth).
//
// A first run with LONG = 1000 times the rounds; LONG is then set so the
// second run takes MINUTES (0: the first run only).
//
//   main [MINUTES (30)] [TASKS (16)]

/// The test file with TASKS and LONG filled in.
fn rss_kib(os: Os) -> Int {
  // stdproven sets XO_STRESS_CHECK=1 for the --check=all run, whose leak
  // report judges memory there: the resident set is not sampled
  if (os.env.get("XO_STRESS_CHECK") ?? "") == "1" { return 0 }
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn test_file(tasks: Int, long: Int, mark: Int, every: Int) -> Str {
  TEST.replace("@TEST@", "test").replace("@TASKS@", "${tasks}").replace("@LONG@", "${long}").replace("@MARK@", "${mark}").replace("@EVERY@", "${every}")
}

/// Runs the test file in dir with xo -v: its wall time in milliseconds
/// and its output. minutes bounds the run (xo test's own limit is 1
/// minute of real time a test, shorter than the long run).
fn run(os: Os, xo: Str, dir: Str, what: Str, minutes: Int) -> (Int, Str) ! {
  let t0 = os.clock.now()
  let out = os.proc.run(xo, ["test", "-v", "--count=1", "--timeout=${minutes}m", dir])?
  let ms = (os.clock.now() - t0).millis()
  let text = out.stdout.to_str_lossy() + out.stderr.to_str_lossy()
  if out.code != 0 || !text.contains("ok: 2 passed, 0 failed") {
    return Err("the ${what} run: exit ${out.code}\n${text}")
  }
  (ms, text)
}

/// The resident set samples (KiB) the long test logged: the words after
/// "kib=" on its log line, comma separated.
fn logged_rss(text: Str) -> List[Int] {
  var xs: List[Int] = []
  for line in text.lines() {
    match line.find("kib=") {
      Some(i) => {
        for w in line[i + 4..].trim().trim_prefix("\"").trim_suffix("\"").split(",") {
          match Int.parse(w.trim()) {
            Some(v) => xs.push(v)
            None => {}
          }
        }
      }
      None => {}
    }
  }
  xs
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 16 } else { 16 }
  let xo = os.env.get("XO_CLI") ?? "bin/xo"
  let dir = "${temp_dir(os.env)}/xo-testing-stress-${os.proc.pid()}"
  os.fs.create_dir_all(dir)?
  let file = "${dir}/fakes_test.xo"
  // the memory check runs where rss_kib reads a resident set: not under
  // XO_STRESS_CHECK (the leak report judges memory there)
  let mem = rss_kib(os) > 0
  var long = 1020
  os.fs.write(file, test_file(tasks, long, 0, 34).bytes())?
  // the first run builds the test: the second times 1020 rounds
  let r1 = run(os, xo, dir, "first", 10)
  let r2 = if r1.is_ok() { run(os, xo, dir, "timing", 10) } else { r1 }
  var ms = r2.map(fn(t: (Int, Str)) -> Int { t.0 }).ok() ?? 0
  var r = r2.map(fn(_t: (Int, Str)) {})
  var rss_after: List[Int] = []
  // the long run's rounds stand for its minutes (the timing run set
  // LONG): the test samples from the mark's round, one every 10 s of rounds
  let clock = os.clock
  let start = clock.now()
  let mark_s = if minutes >= 30 { 900 } else { minutes * 30 } // decision 0717: minute 15 of a 30 minute run
  let mark = start + Duration.from_secs(Float(mark_s))
  if r.is_ok() && minutes > 0 {
    long = Int(Float(1020) * Float(minutes * 60000) / Float(if ms > 0 { ms } else { 1 }))
    long = (long / 30 + 1) * 30
    let every = if long / (minutes * 6) > 0 { long / (minutes * 6) } else { 1 }
    os.fs.write(file, test_file(tasks, long, long * mark_s / (minutes * 60), every).bytes())?
    let r3 = run(os, xo, dir, "long", minutes * 2 + 10)
    ms = r3.map(fn(t: (Int, Str)) -> Int { t.0 }).ok() ?? 0
    rss_after = logged_rss(r3.map(fn(t: (Int, Str)) -> Str { t.1 }).ok() ?? "")
    r = r3.map(fn(_t: (Int, Str)) {})
    if r.is_ok() && clock.now() < mark {
      r = Err("the long run ended before the mark (${mark_s} s): its samples are not from after minute ${mark_s / 60}")
    }
    if r.is_ok() && rss_after.is_empty() {
      r = Err("the long run logged no resident set samples")
    }
  }
  os.fs.remove_all(dir)?
  r?

  if !mem {
    rss_after = []
  }
  var peak = 0
  for v in rss_after {
    if v > peak { peak = v }
  }
  let (at_mark, last) = rss_medians(rss_after)
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem_text = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark (median of minutes ${mark_s / 60} to ${mark_s / 60 + 2}), ${last / 1024} MB at the end (median of the last 3 minutes; ${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("testing stress: 400 rounds of every fake, then ${long} rounds of MemFs and FakeEnv (${long * tasks} task rounds) by ${tasks} tasks in ${ms / 1000} s, 0 mismatches, ${mem_text}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

/// The test each run executes (std/testing's fakes under TASKS tasks).
const TEST: Str = r#"// std/testing stress round, written by std/evidence/testing/stress/main.xo.
use std/log

const TASKS: Int = @TASKS@
const ROUNDS: Int = 400
const LONG: Int = @LONG@
const MARK: Int = @MARK@
const EVERY: Int = @EVERY@

/// A step of a 64-bit LCG (Knuth's MMIX constants), kept to 62 bits.
fn next(x: Int) -> Int { x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407) & 0x3fffffffffffffff }

/// One task's round on the shared MemFs: its own directory, files
/// written, appended, renamed, copied, listed and removed; the answer is
/// the number of checks made, or a fault on the first wrong one.
fn fs_round(fs: Fs, t: Int, r: Int, seed: Int) -> Int uses fs {
  let dir = "t${t}/r${r % 4}"
  var x = seed
  var checks = 0
  fs.create_dir_all(dir) ?? e => fault("create_dir_all ${dir}: ${e}")
  var want: Map[Str, Str] = {}
  for i in 0..16 {
    x = next(x)
    let name = "${dir}/f${x % 8}"
    let text = "${t}.${r}.${i}.${x % 1000}"
    match x.shr_logical(20) % 4 {
      0 => {
        fs.write(name, text.bytes()) ?? e => fault("write ${name}: ${e}")
        want[name] = text
      }
      1 => {
        fs.append(name, text.bytes()) ?? e => fault("append ${name}: ${e}")
        want[name] = (want.get(name) ?? "") + text
      }
      2 => {
        match want.get(name) {
          Some(w) => {
            let got = fs.read_text(name) ?? e => fault("read ${name}: ${e}")
            if got != w {
              fault("read ${name}: got ${got.len()} bytes, want ${w.len()}")
            }
            checks += 1
          }
          None => {
            if fs.exists(name) ?? e => fault("exists ${name}: ${e}") {
              fault("${name} exists, never written")
            }
            checks += 1
          }
        }
      }
      _ => {
        if want.get(name).is_some() {
          let to = "${dir}/g${x % 3}"
          fs.rename(name, to) ?? e => fault("rename ${name}: ${e}")
          let moved = want.get(name) ?? ""
          want.remove(name)
          want[to] = moved
        }
      }
    }
  }
  var names: List[Str] = []
  for (k, _) in want {
    names.push(k.trim_prefix("${dir}/"))
  }
  let listed = (fs.read_dir(dir) ?? e => fault("read_dir ${dir}: ${e}")).map(fn(i: FileInfo) -> Str { i.name })
  if listed.sort() != names.sort() {
    fault("read_dir ${dir}: ${listed.join(",")}, want ${names.sort().join(",")}")
  }
  checks += 1
  fs.remove_all(dir) ?? e => fault("remove_all ${dir}: ${e}")
  if fs.exists(dir) ?? e => fault("exists ${dir}: ${e}") {
    fault("${dir} left after remove_all")
  }
  checks + 1
}

@TEST@ "the fakes stand up to TASKS tasks at once" {
  var ops = 0
  os.proc.on_run("echo", ProcOutput{code: 0, stdout: b"hi\n", stderr: b""})
  for r in 0..ROUNDS {
    var tasks: List[Task[Int, Never]] = []
    for t in 0..TASKS {
      let fs = os.fs.cwd()
      let clock = os.clock
      let env = os.env
      let stdio = os.stdio
      let proc = os.proc
      let seed = next(r * 1000 + t)
      tasks.push(os.tasks.spawn(fn() -> Int ! Never uses (fs, clock, env, stdio, proc) {
        var n = fs_round(fs, t, r, seed)
        clock.sleep(Duration.from_millis(t + 1))
        env.set("T${t}", "${r}")
        if env.get("T${t}") != Some("${r}") {
          fault("env T${t}")
        }
        stdio.println("${t} ${r}")
        let out = proc.run("echo", ["${t}"]) ?? e => fault("run: ${e}")
        if out.stdout != b"hi\n" {
          fault("run echo: ${out.stdout.len()} bytes")
        }
        n + 4
      }))
    }
    for h in tasks {
      ops += h.await
    }
  }
  let lines = os.stdio.output().split("\n").len() - 1
  expect(lines) == ROUNDS * TASKS
  expect(os.clock.sleeps().len()) == ROUNDS * TASKS
  expect(os.proc.runs().len()) == ROUNDS * TASKS
  expect(ops) >= ROUNDS * TASKS * 5
}

@TEST@ "MemFs and FakeEnv hold their memory over LONG rounds" {
  // the fakes that keep no history, so the resident set must level off:
  // a sample (KiB) every EVERY rounds from round MARK, logged for main.xo,
  // which judges them (rss_medians, decision 0616 as amended 2026-11-17)
  var rss: List[Str] = []
  var ops = 0
  for r in 0..LONG {
    var tasks: List[Task[Int, Never]] = []
    for t in 0..TASKS {
      let fs = os.fs.cwd()
      let env = os.env
      let seed = next(r * 1000 + t)
      tasks.push(os.tasks.spawn(fn() -> Int ! Never uses (fs, env) {
        let n = fs_round(fs, t, r, seed)
        env.set("T${t}", "${r}")
        if env.get("T${t}") != Some("${r}") {
          fault("env T${t}")
        }
        n + 1
      }))
    }
    for h in tasks {
      ops += h.await
    }
    if r + 1 >= MARK && (r + 1 - MARK) % EVERY == 0 {
      rss.push("${os.proc.usage().max_rss / 1024}")
    }
  }
  log.info("rss", {"kib": rss.join(",")})
  expect(ops) >= LONG * TASKS * 3
}
"#

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
