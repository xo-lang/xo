// The Xo side of std/uuid's gotests evidence (decision 0720, task #403):
// main CASES prints, for each case line `KIND<TAB>B64...`, the base64 of
// std/uuid's result as text, as go/main.go prints package uuid's.
// Kinds parse and parseup over google/uuid's tables.
// See scripts/stdproven/gotests.go.
use std/uuid
use std/base64

fn show(s: Str) -> Str {
  match uuid.parse(s) {
    Ok(u) => "ok ${u} ${u.version()} ${u.variant()}"
    Err(e) => "err ${e}"
  }
}

fn run(kind: Str, inp: List[Str]) -> Str {
  match kind {
    "parse" => show(inp[0])
    "parseup" => show(inp[0].to_upper())
    _ => "unknown kind ${kind}"
  }
}

fn main(os: Os) ! {
  let args = os.env.args()
  let text = os.fs.read_text(args[0])?
  for line in text.split("\n") {
    if line.is_empty() {
      continue
    }
    let f = line.split("\t")
    var inp: List[Str] = []
    for s in f[1..f.len()] {
      inp.push(base64.decode(s)?.to_str() ?? "")
    }
    os.stdio.println(base64.encode(run(f[0], inp).bytes()))
  }
}
