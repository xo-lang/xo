// uuid stress program (decision 0616 section 2): 64 tasks parse 64 texts
// (half of them valid, half near a valid form: cut, recased, multi-byte)
// and check each against github.com/google/uuid v1.6.0's answer
// (ustressgen); for each valid one, bytes, display and from_bytes round
// trip and order against the next; and each pass makes 4 v4 and 4 v7
// UUIDs and checks their version and variant bits, for a fixed time. A
// background task samples the resident set every 10 s (Linux
// /proc/self/status). Pass: no mismatch, no fault, and the resident set at
// the end within 10% or 4 MB of its sample at 5 minutes.
//
//   main [MINUTES (30)] [TASKS (64)]
use std/uuid

/// One pass over the cases from offset start: the operations done, or the
/// first mismatch.
fn pass(start: Int, r: Rand, c: Clock) -> Int ! Str uses (rand, clock) {
  var ops = 0
  var prev: uuid.Uuid? = None
  for k in 0..CASES.len() {
    let i = (start + k) % CASES.len()
    let (s, want) = CASES[i]
    let got = match uuid.parse(s) {
      Ok(u) => "ok ${u} ${u.version()} ${u.bytes().to_hex()}"
      Err(e) => "err ${e.display()}"
    }
    if got != want {
      return Err("case ${i}: ${got}")
    }
    if let Ok(u) = uuid.parse(s) {
      if uuid.from_bytes(u.bytes()).ok() != Some(u) || uuid.parse(u.display()).ok() != Some(u) {
        return Err("round trip of case ${i}")
      }
      if let Some(p) = prev {
        let less = p.bytes().to_hex() < u.bytes().to_hex()
        if (p < u) != less {
          return Err("order at case ${i}")
        }
      }
      prev = Some(u)
      ops += 3
    }
    ops += 1
  }
  for _ in 0..4 {
    let a = uuid.v4(r)
    let b = uuid.v7(r, c)
    let va = Int(a.bytes()[8]) >> 6
    let vb = Int(b.bytes()[8]) >> 6
    if a.version() != 4 || b.version() != 7 || va != 2 || vb != 2 || a == b {
      return Err("v4 or v7 bits: ${a} ${b}")
    }
    ops += 2
  }
  ops
}

/// The resident set in KiB (VmRSS), or 0 where /proc is not there.
fn rss_kib(os: Os) -> Int {
  let text = os.fs.read_text("/proc/self/status").ok() ?? ""
  for line in text.lines() {
    if line.starts_with("VmRSS:") {
      return Int.parse(line.trim_prefix("VmRSS:").trim().trim_suffix(" kB").trim()) ?? 0
    }
  }
  0
}

fn main(os: Os) ! {
  let args = os.env.args()
  let minutes = if args.len() > 0 { Int.parse(args[0]) ?? 30 } else { 30 }
  let tasks = if args.len() > 1 { Int.parse(args[1]) ?? 64 } else { 64 }
  let clock = os.clock
  let rng = os.rand
  let start = clock.now()
  let end = start + Duration.from_secs(Float(minutes * 60))
  let mark = start + Duration.from_secs(Float(if minutes >= 10 { 300 } else { minutes * 30 }))
  let samples = Mutex.new((0, 0, 0))   // (rss at the mark, last rss, peak)
  let ops = scope s {
    s.spawn_background(fn() {
      var marked = false
      while true {
        clock.sleep(10s)
        let r = rss_kib(os)
        let now_marked = !marked && clock.now() >= mark
        samples.with(fn(var t) {
          let (m, _, p) = t
          t = (if now_marked { r } else { m }, r, if r > p { r } else { p })
        })
        if clock.now() >= mark {
          marked = true
        }
      }
    })
    var hs: List[Task[Int, Str]] = []
    for t in 0..tasks {
      hs.push(s.spawn(fn() -> Int ! Str {
        var n = 0
        var i = t
        while clock.now() < end {
          n += pass(i, rng, clock)?
          i += 1
        }
        n
      }))
    }
    var total = 0
    for h in hs {
      total += h.await.map_err(fn(e) { "a task: ${e}" })?
    }
    total
  }
  let (at_mark, last, peak) = samples.with_read(fn(t) { t })
  let growth = if at_mark > 0 { Float(last - at_mark) * 100.0 / Float(at_mark) } else { 0.0 }
  let mem = if at_mark > 0 { "rss ${at_mark / 1024} MB at the mark, ${last / 1024} MB at the end (${growth.round()}%), peak ${peak / 1024} MB" } else { "rss not sampled" }
  let ok = at_mark == 0 || growth < 10.0 || last - at_mark < 4096
  os.stdio.println("uuid stress: ${ops} operations by ${tasks} tasks in ${minutes} min, 0 mismatches, ${mem}, ${if ok { "pass" } else { "FAIL (memory grew)" }}")
  if !ok {
    return Err("memory grew ${growth}%")
  }
}

