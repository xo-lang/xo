  ("6", "7ffffffffffffff", -1),
  ("a9c", "8000000000000000000000000000001", -1),
  ("3ffffffffffffffffffffffffffffffffffffffffffff", "3", 0),
  ("186acf191df05e3114f028be", "10000000001", -1),
  ("0", "1", 1),
  ("100000000000000000000000000000000", "1", 1),
  ("-42cd91", "3b", 1),
  ("10", "11", 1),
]


fn h(s: Str) -> big.BigInt { big.parse(s, base: 16).or_fault("corpus hex") }

fn hx(x: big.BigInt) -> Str { x.text(base: 16) }

fn first_bad[T](bad: List[T]) -> List[T] { bad[0..(if bad.len() < 20 { bad.len() } else { 20 })] }

fn run(op: Str, a: big.BigInt, b: big.BigInt, k: Int) -> Str {
  match op {
    "add" => hx(a.add(b))
    "sub" => hx(a.sub(b))
    "mul" => hx(a.mul(b))
    "quo" => hx(a.quo(b))
    "rem" => hx(a.rem(b))
    "div" => hx(a.div(b))
    "mod" => hx(a.mod(b))
    "gcd" => hx(a.gcd(b))
    "modinv" => a.mod_inverse(b).map(hx) ?? "none"
    "expmod" => hx(a.exp(big.from_int(k), m: Some(b)))
    "sqrt" => hx(a.sqrt())
    "lsh" => hx(a.lsh(k))
    "rsh" => hx(a.rsh(k))
    "and" => hx(a.and(b))
    "or" => hx(a.or(b))
    "xor" => hx(a.xor(b))
    "andnot" => hx(a.and_not(b))
    "not" => hx(a.not())
    "bit" => "${a.bit(k)}"
    "bitlen" => "${a.bit_len()}"
    "tz" => "${a.trailing_zeros()}"
    "text" => a.text(base: k)
    "bytes" => a.bytes().to_hex()
    "toint" => a.to_int().map(fn(n) { "${n}" }) ?? "none"
    "tofloat" => "${a.to_float().to_bits()}"
    "cmp" => "${a.cmp(b)}"
    "cmpabs" => "${a.cmp_abs(b)}"
    "abs" => hx(a.abs())
    "neg" => hx(a.neg())
    "sign" => "${a.sign()}"
    _ => "${a.probably_prime(k)}"
  }
}

/// The resident set early and late, in KiB (decision 0616 as amended
/// 2026-11-17, owner): the median of the samples in the 2 minutes after
/// the mark (minutes 15 to 17 of a 30 minute run, decision 0717) and the median of the last
/// 3 minutes' samples, 10 s apart, so one dip or spike does not decide; a
/// short run takes a third of its samples each. (0, 0) when none.
fn rss_medians(xs: List[Int]) -> (Int, Int) {
  if xs.is_empty() {
    return (0, 0)
  }
  let early = if xs.len() >= 30 { 12 } else { (xs.len() + 2) / 3 }
  let late = if xs.len() >= 30 { 18 } else { (xs.len() + 2) / 3 }
  (rss_median(xs[0..early]), rss_median(xs[xs.len() - late..]))
}

fn rss_median(xs: List[Int]) -> Int {
  let s = xs.sort()
  s[s.len() / 2]
}
