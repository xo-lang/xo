// std/image (decision 0578). Go's image and image/color
// over one Image: the pixel models of std/png and std/jpeg in one enum, Go's
// exact integer color conversions, and the accessors a decoder's output
// needs. Pure.
//
// std/image on the native backends and, through std/go_compiled.txt, on
// the Go backend (decision 0578): Go's image/color conversions
// (Copyright 2009 The Go Authors, BSD-style license) in integer
// arithmetic, so the values are the bytes Go computes.

use std/binary
use std/jpeg
use std/png

/// Go's image.Rectangle: x0 <= x < x1 and y0 <= y < y1.
pub struct Rect {
  pub x0: Int
  pub y0: Int
  pub x1: Int
  pub y1: Int
} derive Eq

/// Go's color.Color.RGBA(): 16 bit channels, alpha premultiplied (each of
/// r, g and b is at most a).
pub struct Color {
  pub r: Int
  pub g: Int
  pub b: Int
  pub a: Int
} derive Eq

/// The pixel models of image/png and image/jpeg, with Go's layouts:
/// Gray (1 byte), Gray16 (2, big endian), Paletted (1, an index),
/// RGBA (4, premultiplied), NRGBA (4), RGBA64 (8, big endian), NRGBA64 (8),
/// CMYK (4, 255 is full ink) and YCbCr (the planes `y`, `cb` and `cr`).
pub enum Model {
  Gray
  Gray16
  Paletted
  RGBA
  NRGBA
  RGBA64
  NRGBA64
  CMYK
  YCbCr
} derive Eq, Display

/// A raster image whose top left pixel is (`min_x`, `min_y`) (Go's
/// Rect().Min; 0, 0 for a decoded image) and whose size is `width` by
/// `height`. `pix` holds rows of `stride` bytes; a view made by
/// `sub_image` keeps the parent's stride. `palette` is for Paletted, one
/// `0xRRGGBBAA` (not premultiplied) per index. A YCbCr image keeps its samples
/// in the planes `y`, `cb` and `cr` (rows of `y_stride` and `c_stride` bytes,
/// 0 for tight rows; the chroma subsampled by `subsample`) and `pix` is empty.
pub struct Image {
  pub width: Int
  pub height: Int
  pub model: Model
  pub pix: Bytes
  pub stride: Int = 0
  pub palette: List[Int] = []
  pub min_x: Int = 0
  pub min_y: Int = 0
  pub y: Bytes = b""
  pub cb: Bytes = b""
  pub cr: Bytes = b""
  pub y_stride: Int = 0
  pub c_stride: Int = 0
  pub subsample: jpeg.Subsample = jpeg.Subsample.S444
}

/// Go's color.GrayModel: the 8 bit luma of c, (19595 r + 38470 g + 7471 b +
/// 1<<15) >> 24 over the 16 bit premultiplied channels.
pub fn (c: Color) gray() -> Int { (19595 * c.r + 38470 * c.g + 7471 * c.b + (1 << 15)) >> 24 }

/// Go's color.Gray16Model: the same sum >> 16.
pub fn (c: Color) gray16() -> Int { (19595 * c.r + 38470 * c.g + 7471 * c.b + (1 << 15)) >> 16 }

/// Go's color.NRGBAModel: 8 bit channels, not premultiplied, as 0xRRGGBBAA.
pub fn (c: Color) nrgba() -> Int {
  if c.a == 65535 {
    return ((c.r >> 8) << 24) | ((c.g >> 8) << 16) | ((c.b >> 8) << 8) | 255
  }
  if c.a == 0 {
    return 0
  }
  let r = (c.r * 65535) / c.a
  let g = (c.g * 65535) / c.a
  let b = (c.b * 65535) / c.a
  ((r >> 8) << 24) | ((g >> 8) << 16) | ((b >> 8) << 8) | (c.a >> 8)
}

/// Go's color.AlphaModel: the 8 bit alpha.
pub fn (c: Color) alpha() -> Int { (c.a >> 8) & 255 }

/// Go's color.Alpha16Model: the 16 bit alpha.
pub fn (c: Color) alpha16() -> Int { c.a & 65535 }

/// Go's color.RGBAModel: 8 bit premultiplied (r, g, b, a).
pub fn (c: Color) rgba() -> (Int, Int, Int, Int) { ((c.r >> 8) & 255, (c.g >> 8) & 255, (c.b >> 8) & 255, (c.a >> 8) & 255) }

/// Go's color.NRGBA64Model: 16 bit (r, g, b, a), not premultiplied.
pub fn (c: Color) nrgba64() -> (Int, Int, Int, Int) {
  if c.a == 65535 {
    return (c.r, c.g, c.b, 65535)
  }
  if c.a == 0 {
    return (0, 0, 0, 0)
  }
  // Go's uint16 of a channel above alpha (not a premultiplied color)
  // keeps the low 16 bits
  (((c.r * 65535) / c.a) & 65535, ((c.g * 65535) / c.a) & 65535, ((c.b * 65535) / c.a) & 65535, c.a)
}

/// Go's color.CMYKModel: (c, m, y, k), alpha ignored.
pub fn (c: Color) cmyk() -> (Int, Int, Int, Int) { rgb_to_cmyk(c.r >> 8, c.g >> 8, c.b >> 8) }

/// Go's color.YCbCrModel: (y, cb, cr), alpha ignored.
pub fn (c: Color) ycbcr() -> (Int, Int, Int) { rgb_to_ycbcr(c.r >> 8, c.g >> 8, c.b >> 8) }

/// Go's color.NYCbCrAModel: (y, cb, cr, a), the color divided by alpha.
pub fn (c: Color) nycbcra() -> (Int, Int, Int, Int) {
  var r = c.r
  var g = c.g
  var b = c.b
  if c.a != 0 {
    r = (r * 65535) / c.a
    g = (g * 65535) / c.a
    b = (b * 65535) / c.a
  }
  let (y, cb, cr) = rgb_to_ycbcr((r >> 8) & 255, (g >> 8) & 255, (b >> 8) & 255)
  (y, cb, cr, (c.a >> 8) & 255)
}

/// color.Gray{y}.RGBA().
pub fn from_gray(y: Int) -> Color {
  let v = y * 257
  Color{r: v, g: v, b: v, a: 65535}
}

/// color.Gray16{y}.RGBA().
pub fn from_gray16(y: Int) -> Color { Color{r: y, g: y, b: y, a: 65535} }

/// color.Alpha{a}.RGBA().
pub fn from_alpha(a: Int) -> Color {
  let v = a * 257
  Color{r: v, g: v, b: v, a: v}
}

/// color.Alpha16{a}.RGBA().
pub fn from_alpha16(a: Int) -> Color { Color{r: a, g: a, b: a, a: a} }

/// color.RGBA{r, g, b, a}.RGBA(): 8 bit premultiplied channels.
pub fn from_rgba(r: Int, g: Int, b: Int, a: Int) -> Color { Color{r: r * 257, g: g * 257, b: b * 257, a: a * 257} }

/// color.RGBA64{r, g, b, a}.RGBA(): 16 bit premultiplied channels.
pub fn from_rgba64(r: Int, g: Int, b: Int, a: Int) -> Color { Color{r: r, g: g, b: b, a: a} }

/// color.NRGBA64{r, g, b, a}.RGBA(): 16 bit channels, not premultiplied.
pub fn from_nrgba64(r: Int, g: Int, b: Int, a: Int) -> Color { Color{r: r * a / 65535, g: g * a / 65535, b: b * a / 65535, a: a} }

/// color.CMYK{c, m, y, k}.RGBA().
pub fn from_cmyk(c: Int, m: Int, y: Int, k: Int) -> Color {
  let w = 65535 - k * 257
  Color{r: (65535 - c * 257) * w / 65535, g: (65535 - m * 257) * w / 65535, b: (65535 - y * 257) * w / 65535, a: 65535}
}

/// color.YCbCr{y, cb, cr}.RGBA().
pub fn from_ycbcr(y: Int, cb: Int, cr: Int) -> Color { ycc_color(y, cb, cr) }

/// color.NYCbCrA{y, cb, cr, a}.RGBA().
pub fn from_nycbcra(y: Int, cb: Int, cr: Int, a: Int) -> Color {
  let c = ycc_color(y, cb, cr)
  let a1 = a * 257
  Color{r: c.r * a1 / 65535, g: c.g * a1 / 65535, b: c.b * a1 / 65535, a: a1}
}

/// color.Black (Gray16{0}).
pub fn black() -> Color { Color{r: 0, g: 0, b: 0, a: 65535} }

/// color.White (Gray16{0xffff}).
pub fn white() -> Color { Color{r: 65535, g: 65535, b: 65535, a: 65535} }

/// color.Transparent (Alpha16{0}).
pub fn transparent() -> Color { Color{r: 0, g: 0, b: 0, a: 0} }

/// color.Opaque (Alpha16{0xffff}).
pub fn opaque() -> Color { Color{r: 65535, g: 65535, b: 65535, a: 65535} }

/// Go's Palette.Index over a palette of 0xRRGGBBAA entries (not
/// premultiplied): the first entry with the least sum of squared channel
/// differences; 0 for an empty palette.
pub fn palette_index(palette: List[Int], c: Color) -> Int {
  var best = 0
  var best_sum = 4294967295
  var i = 0
  for v in palette {
    let p = from_nrgba(v)
    let sum = (sq_diff(p.r, c.r) + sq_diff(p.g, c.g) + sq_diff(p.b, c.b) + sq_diff(p.a, c.a)) & 4294967295
    if sum < best_sum {
      if sum == 0 {
        return i
      }
      best = i
      best_sum = sum
    }
    i += 1
  }
  best
}

/// Go's Palette.Convert: the nearest entry's color, None for an empty
/// palette (Go's nil).
pub fn palette_convert(palette: List[Int], c: Color) -> Color? {
  if palette.is_empty() {
    return None
  }
  Some(from_nrgba(palette[palette_index(palette, c)]))
}

/// Go's color.RGBToYCbCr over 8 bit channels: (y, cb, cr).
pub fn rgb_to_ycbcr(r: Int, g: Int, b: Int) -> (Int, Int, Int) {
  let y = (19595 * r + 38470 * g + 7471 * b + (1 << 15)) >> 16
  let cb = clamp16(-11056 * r - 21712 * g + 32768 * b + (257 << 15))
  let cr = clamp16(32768 * r - 27440 * g - 5328 * b + (257 << 15))
  (y, cb, cr)
}

/// Go's color.YCbCrToRGB: 8 bit (r, g, b).
pub fn ycbcr_to_rgb(y: Int, cb: Int, cr: Int) -> (Int, Int, Int) {
  let yy1 = y * 65793
  let cb1 = cb - 128
  let cr1 = cr - 128
  (clamp16(yy1 + 91881 * cr1), clamp16(yy1 - 22554 * cb1 - 46802 * cr1), clamp16(yy1 + 116130 * cb1))
}

/// Go's color.RGBToCMYK: 8 bit (c, m, y, k).
pub fn rgb_to_cmyk(r: Int, g: Int, b: Int) -> (Int, Int, Int, Int) {
  var w = r
  if g > w {
    w = g
  }
  if b > w {
    w = b
  }
  if w == 0 {
    return (0, 0, 0, 255)
  }
  ((w - r) * 255 / w, (w - g) * 255 / w, (w - b) * 255 / w, 255 - w)
}

/// Go's color.CMYKToRGB: 8 bit (r, g, b).
pub fn cmyk_to_rgb(c: Int, m: Int, y: Int, k: Int) -> (Int, Int, Int) {
  let w = 65535 - k * 257
  (((65535 - c * 257) * w / 65535) >> 8, ((65535 - m * 257) * w / 65535) >> 8, ((65535 - y * 257) * w / 65535) >> 8)
}

/// The color.Color of a 0xRRGGBBAA value that is not premultiplied (Go's
/// color.NRGBA.RGBA()).
pub fn from_nrgba(v: Int) -> Color {
  let a8 = v & 255
  let r = (((v >> 24) & 255) * 257 * a8) / 255
  let g = (((v >> 16) & 255) * 257 * a8) / 255
  let b = (((v >> 8) & 255) * 257 * a8) / 255
  Color{r: r, g: g, b: b, a: a8 * 257}
}

/// Go's Image.At for the pixel models that keep their samples in `pix`
/// (everything but YCbCr): the color at (x, y) as 16 bit premultiplied
/// channels. Outside the image it is what Go's zero value gives (Gray and
/// Gray16: opaque black, RGBA, NRGBA, RGBA64 and NRGBA64: transparent,
/// CMYK: opaque white, Paletted: palette entry 0).
pub fn (im: Image) at(x: Int, y: Int) -> Color {
  let x1 = x - im.min_x
  let y1 = y - im.min_y
  let stride = if im.stride > 0 { im.stride } else { 0 }
  let inside = x1 >= 0 && y1 >= 0 && x1 < im.width && y1 < im.height
  match im.model {
    Model.Gray => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 65535}
      }
      let v = Int(im.pix[y1 * (if stride > 0 { stride } else { im.width }) + x1]) * 257
      Color{r: v, g: v, b: v, a: 65535}
    }
    Model.Gray16 => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 65535}
      }
      let i = y1 * (if stride > 0 { stride } else { im.width * 2 }) + x1 * 2
      let v = (Int(im.pix[i]) << 8) | Int(im.pix[i + 1])
      Color{r: v, g: v, b: v, a: 65535}
    }
    Model.Paletted => {
      if im.palette.len() == 0 {
        return Color{r: 0, g: 0, b: 0, a: 0}
      }
      var idx = 0
      if inside {
        idx = Int(im.pix[y1 * (if stride > 0 { stride } else { im.width }) + x1])
      }
      if idx >= im.palette.len() {
        idx = 0
      }
      from_nrgba(im.palette[idx])
    }
    Model.RGBA => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 0}
      }
      let i = y1 * (if stride > 0 { stride } else { im.width * 4 }) + x1 * 4
      Color{r: Int(im.pix[i]) * 257, g: Int(im.pix[i + 1]) * 257, b: Int(im.pix[i + 2]) * 257, a: Int(im.pix[i + 3]) * 257}
    }
    Model.NRGBA => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 0}
      }
      let i = y1 * (if stride > 0 { stride } else { im.width * 4 }) + x1 * 4
      nrgba_color(Int(im.pix[i]), Int(im.pix[i + 1]), Int(im.pix[i + 2]), Int(im.pix[i + 3]))
    }
    Model.RGBA64 => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 0}
      }
      let i = y1 * (if stride > 0 { stride } else { im.width * 8 }) + x1 * 8
      Color{r: (Int(im.pix[i]) << 8) | Int(im.pix[i + 1]), g: (Int(im.pix[i + 2]) << 8) | Int(im.pix[i + 3]), b: (Int(im.pix[i + 4]) << 8) | Int(im.pix[i + 5]), a: (Int(im.pix[i + 6]) << 8) | Int(im.pix[i + 7])}
    }
    Model.NRGBA64 => {
      if !inside {
        return Color{r: 0, g: 0, b: 0, a: 0}
      }
      let i = y1 * (if stride > 0 { stride } else { im.width * 8 }) + x1 * 8
      nrgba64_color((Int(im.pix[i]) << 8) | Int(im.pix[i + 1]), (Int(im.pix[i + 2]) << 8) | Int(im.pix[i + 3]), (Int(im.pix[i + 4]) << 8) | Int(im.pix[i + 5]), (Int(im.pix[i + 6]) << 8) | Int(im.pix[i + 7]))
    }
    Model.CMYK => {
      var c = 0
      var m = 0
      var yy = 0
      var k = 0
      if inside {
        let i = y1 * (if stride > 0 { stride } else { im.width * 4 }) + x1 * 4
        c = Int(im.pix[i])
        m = Int(im.pix[i + 1])
        yy = Int(im.pix[i + 2])
        k = Int(im.pix[i + 3])
      }
      // color.CMYK.RGBA keeps the 16 bit values (cmyk_to_rgb shifts them to 8)
      let w = 65535 - k * 257
      Color{r: ((65535 - c * 257) * w) / 65535, g: ((65535 - m * 257) * w) / 65535, b: ((65535 - yy * 257) * w) / 65535, a: 65535}
    }
    Model.YCbCr => {
      var yy = 0
      var cb = 0
      var cr = 0
      if inside {
        let ys = if im.y_stride > 0 { im.y_stride } else { im.width }
        let yi = y1 * ys + x1
        let ci = chroma_index(im, x, y)
        yy = Int(im.y[yi])
        cb = Int(im.cb[ci])
        cr = Int(im.cr[ci])
      }
      ycc_color(yy, cb, cr)
    }
  }
}

/// Go's palette.WebSafe: the 216 colors with each channel one of 0, 51, 102,
/// 153, 204, 255, red the slowest index and blue the fastest, as
/// `0xRRGGBBAA` (alpha 255).
pub fn web_safe() -> List[Int] {
  var out: List[Int] = []
  for r in 0..6 {
    for g in 0..6 {
      for b in 0..6 {
        out.push(((r * 51) << 24) | ((g * 51) << 16) | ((b * 51) << 8) | 255)
      }
    }
  }
  out
}

/// Go's palette.Plan9: the 256 colors of Plan 9's default palette, as
/// `0xRRGGBBAA` (alpha 255), in Go's order.
pub fn plan9() -> List[Int] { PLAN9_COLORS }

/// Go's im.ColorModel().Convert(c): c as the image's model stores it,
/// back as a Color (Paletted: the nearest palette entry; YCbCr: Go's
/// YCbCrModel).
pub fn (im: Image) convert(c: Color) -> Color {
  match im.model {
    Model.Gray => from_gray(c.gray())
    Model.Gray16 => from_gray16(c.gray16())
    Model.Paletted => palette_convert(im.palette, c) ?? c
    Model.RGBA => {
      let (r, g, b, a) = c.rgba()
      from_rgba(r, g, b, a)
    }
    Model.NRGBA => from_nrgba(c.nrgba())
    Model.RGBA64 => c
    Model.NRGBA64 => {
      let (r, g, b, a) = c.nrgba64()
      from_nrgba64(r, g, b, a)
    }
    Model.CMYK => {
      let (cc, m, y, k) = c.cmyk()
      from_cmyk(cc, m, y, k)
    }
    Model.YCbCr => {
      let (y, cb, cr) = c.ycbcr()
      ycc_color(y, cb, cr)
    }
  }
}

/// Go's Image.Set for the models that keep their samples in `pix` (not
/// YCbCr): stores c converted by the model as Go's color model does (Gray,
/// Gray16, NRGBA, NRGBA64, CMYK from the premultiplied channels; Paletted
/// picks the nearest entry by Go's Palette.Index). A point outside the image
/// is ignored, as in Go.
pub fn (var im: Image) set(x: Int, y: Int, c: Color) {
  let x1 = x - im.min_x
  let y1 = y - im.min_y
  if x1 < 0 || y1 < 0 || x1 >= im.width || y1 >= im.height || im.model == Model.YCbCr {
    return
  }
  var b = BytesBuilder.with_capacity(im.pix.len())
  b.write(im.pix)
  store_color(b, im, x, y, c)
  im.pix = b.freeze()
}

/// Go's Image.SubImage for the models that keep their samples in `pix` (not
/// YCbCr): the part of the image inside r (clipped to the image) sharing the
/// pixels of the parent, with its coordinates kept (min_x, min_y are r's
/// corner) and the parent's stride. An empty intersection gives the empty
/// image Go returns.
pub fn (im: Image) sub_image(r: Rect) -> Image {
  let bpp = model_bpp(im.model)
  let x0 = if r.x0 > im.min_x { r.x0 } else { im.min_x }
  let y0 = if r.y0 > im.min_y { r.y0 } else { im.min_y }
  let x1 = if r.x1 < im.min_x + im.width { r.x1 } else { im.min_x + im.width }
  let y1 = if r.y1 < im.min_y + im.height { r.y1 } else { im.min_y + im.height }
  if x0 >= x1 || y0 >= y1 || (bpp == 0 && im.model != Model.YCbCr) {
    return Image{width: 0, height: 0, model: im.model, pix: b"", palette: im.palette}
  }
  if im.model == Model.YCbCr {
    let ys = if im.y_stride > 0 { im.y_stride } else { im.width }
    let cs = if im.c_stride > 0 { im.c_stride } else { chroma_width(im.width, im.subsample) }
    let sub = Image{width: x1 - x0, height: y1 - y0, model: im.model, pix: b"", min_x: x0, min_y: y0, y_stride: ys, c_stride: cs, subsample: im.subsample}
    let yi = (y0 - im.min_y) * ys + (x0 - im.min_x)
    let ci = chroma_index(im, x0, y0)
    return sub with {y: im.y[yi..im.y.len()], cb: im.cb[ci..im.cb.len()], cr: im.cr[ci..im.cr.len()]}
  }
  let stride = if im.stride > 0 { im.stride } else { im.width * bpp }
  let off = (y0 - im.min_y) * stride + (x0 - im.min_x) * bpp
  Image{width: x1 - x0, height: y1 - y0, model: im.model, pix: im.pix[off..im.pix.len()], stride: stride, palette: im.palette, min_x: x0, min_y: y0}
}

/// A tightly packed copy of the part of the image inside r (stride 0, min
/// at r's corner after clipping).
pub fn (im: Image) crop(r: Rect) -> Image {
  let s = im.sub_image(r)
  let bpp = model_bpp(s.model)
  if s.width == 0 || s.model == Model.YCbCr {
    return s
  }
  var b = BytesBuilder.with_capacity(s.width * s.height * bpp)
  for row in 0..s.height {
    let o = row * s.stride
    b.write(s.pix[o..o + s.width * bpp])
  }
  Image{width: s.width, height: s.height, model: s.model, pix: b.freeze(), stride: 0, palette: s.palette, min_x: s.min_x, min_y: s.min_y}
}

/// The image as an RGBA image (Go's draw.Draw of it onto image.NewRGBA with
/// Src, i.e. color.RGBAModel on every pixel): premultiplied 8 bit samples,
/// tight rows, the same size and corner. Not YCbCr yet.
pub fn (im: Image) to_rgba() -> Image { image_convert_all(im, false) }

/// The image as an NRGBA image (color.NRGBAModel on every pixel).
pub fn (im: Image) to_nrgba() -> Image { image_convert_all(im, true) }

/// The image of a decoded PNG (the pixels move, no copy): the same model, tight
/// rows, corner (0, 0).
pub fn from_png(p: png.Image) -> Image {
  Image{width: p.width, height: p.height, model: from_png_model(p.model), pix: p.pix, stride: 0, palette: p.palette}
}

/// The PNG form of the image (std/png's Image, tight rows from the corner
/// (0, 0): a sub image is cropped first), or None for a model PNG has no
/// layout for (CMYK, YCbCr).
pub fn (im: Image) to_png() -> png.Image? {
  // a match, not `?? return None`: the Go backend's code for that form in
  // a method generated into std/rt fails go vet (unreachable code)
  let m = match to_png_model(im.model) {
    Some(x) => x
    None => return None
  }
  let tight = im.stride == 0 && im.min_x == 0 && im.min_y == 0
  let src = if tight { im } else { im.crop(Rect{x0: im.min_x, y0: im.min_y, x1: im.min_x + im.width, y1: im.min_y + im.height}) }
  Some(png.Image{width: src.width, height: src.height, model: m, pix: src.pix, palette: src.palette})
}

/// The image of a decoded JPEG (the samples move, no copy): Gray, CMYK and
/// RGBA keep their layout, YCbCr keeps its planes and chroma subsampling.
pub fn from_jpeg(j: jpeg.Image) -> Image {
  let m = match j.model {
    jpeg.Model.Gray => Model.Gray
    jpeg.Model.YCbCr => Model.YCbCr
    jpeg.Model.CMYK => Model.CMYK
    jpeg.Model.RGBA => Model.RGBA
  }
  Image{width: j.width, height: j.height, model: m, pix: j.pix, y: j.y, cb: j.cb, cr: j.cr, subsample: j.subsample}
}

/// The JPEG form of the image (std/jpeg's Image, tight rows from (0, 0)), or
/// None for a model JPEG has no layout for (everything but Gray, YCbCr, CMYK
/// and RGBA) and for a YCbCr sub image (crop does not pack planes yet).
pub fn (im: Image) to_jpeg() -> jpeg.Image? {
  let tight = im.stride == 0 && im.min_x == 0 && im.min_y == 0 && im.y_stride == 0 && im.c_stride == 0
  match im.model {
    Model.YCbCr => {
      if !tight {
        return None
      }
      Some(jpeg.Image{width: im.width, height: im.height, model: jpeg.Model.YCbCr, subsample: im.subsample, y: im.y, cb: im.cb, cr: im.cr})
    }
    Model.Gray => {
      let src = if tight { im } else { im.crop(Rect{x0: im.min_x, y0: im.min_y, x1: im.min_x + im.width, y1: im.min_y + im.height}) }
      Some(jpeg.Image{width: src.width, height: src.height, model: jpeg.Model.Gray, pix: src.pix})
    }
    Model.CMYK => {
      let src = if tight { im } else { im.crop(Rect{x0: im.min_x, y0: im.min_y, x1: im.min_x + im.width, y1: im.min_y + im.height}) }
      Some(jpeg.Image{width: src.width, height: src.height, model: jpeg.Model.CMYK, pix: src.pix})
    }
    Model.RGBA => {
      let src = if tight { im } else { im.crop(Rect{x0: im.min_x, y0: im.min_y, x1: im.min_x + im.width, y1: im.min_y + im.height}) }
      Some(jpeg.Image{width: src.width, height: src.height, model: jpeg.Model.RGBA, pix: src.pix})
    }
    Model.Gray16 | Model.Paletted | Model.NRGBA | Model.RGBA64 | Model.NRGBA64 => None
  }
}

/// Go's draw.Op: how the source combines with the destination.
pub enum Op {
  Over
  Src
} derive Eq, Display

/// Go's draw.Draw (a nil mask): draws the part of src that lies over r onto
/// the image, aligning r's corner with the source point (sp_x, sp_y), after
/// clipping r to the image and to the source (draw.clip). Src replaces the
/// pixels, Over composites the source over them (Porter-Duff, alpha
/// premultiplied). Each pixel comes out as Go's fast paths compute it (an
/// RGBA destination takes 16 bit source channels and 8 bit destination
/// channels as drawRGBA does; NRGBA and NRGBA64 copy a source of their own
/// model with Src; the rest go through the RGBA64 formula and Set). A YCbCr
/// destination is left alone (Go has no Set for it). The samples are copied
/// once per call.
pub fn (var dst: Image) draw(r: Rect, src: Image, sp_x: Int, sp_y: Int, op: Op) {
  if dst.model == Model.YCbCr {
    return
  }
  let (x0, y0, x1, y1, sp_x1, sp_y1) = draw_clip(dst, r, src, sp_x, sp_y)
  if x0 >= x1 || y0 >= y1 {
    return
  }
  if dst.model == Model.RGBA && (src.model == Model.RGBA || src.model == Model.NRGBA || src.model == Model.Gray) {
    dst.pix = draw_rgba_rows(dst, src, x0, y0, x1, y1, sp_x1, sp_y1, op)
    return
  }
  var b = BytesBuilder.with_capacity(dst.pix.len())
  b.write(dst.pix)
  let copy_nrgba = op == Op.Src && dst.model == Model.NRGBA && src.model == Model.NRGBA
  let copy_nrgba64 = op == Op.Src && dst.model == Model.NRGBA64 && src.model == Model.NRGBA64
  for y in y0..y1 {
    for x in x0..x1 {
      let sx = sp_x1 + (x - x0)
      let sy = sp_y1 + (y - y0)
      if copy_nrgba {
        let si = pix_off(src, sx - src.min_x, sy - src.min_y, 4)
        let di = pix_off(dst, x - dst.min_x, y - dst.min_y, 4)
        b.put_be(di, binary.get_u32_be(src.pix, si), 4)
      } else if copy_nrgba64 {
        let si = pix_off(src, sx - src.min_x, sy - src.min_y, 8)
        let di = pix_off(dst, x - dst.min_x, y - dst.min_y, 8)
        b.put_be(di, binary.get_u32_be(src.pix, si), 4)
        b.put_be(di + 4, binary.get_u32_be(src.pix, si + 4), 4)
      } else if dst.model == Model.RGBA {
        let sc = draw_src_color(src, sx, sy)
        let di = pix_off(dst, x - dst.min_x, y - dst.min_y, 4)
        if op == Op.Over {
          let a = (65535 - sc.a) * 257
          let rr = (((Int(dst.pix[di]) * a) / 65535 + sc.r) >> 8) & 255
          let gg = (((Int(dst.pix[di + 1]) * a) / 65535 + sc.g) >> 8) & 255
          let bb = (((Int(dst.pix[di + 2]) * a) / 65535 + sc.b) >> 8) & 255
          let aa = (((Int(dst.pix[di + 3]) * a) / 65535 + sc.a) >> 8) & 255
          b.put_be(di, (rr << 24) | (gg << 16) | (bb << 8) | aa, 4)
        } else {
          b.put_be(di, ((sc.r >> 8) << 24) | ((sc.g >> 8) << 16) | ((sc.b >> 8) << 8) | (sc.a >> 8), 4)
        }
      } else {
        let sc = src.at(sx, sy)
        if op == Op.Over {
          let dc = dst.at(x, y)
          let a = 65535 - sc.a
          let oc = Color{r: (((dc.r * a) / 65535) + sc.r) & 65535, g: (((dc.g * a) / 65535) + sc.g) & 65535, b: (((dc.b * a) / 65535) + sc.b) & 65535, a: (((dc.a * a) / 65535) + sc.a) & 65535}
          store_color(b, dst, x, y, oc)
        } else {
          store_color(b, dst, x, y, sc)
        }
      }
    }
  }
  dst.pix = b.freeze()
}

/// Go's draw.DrawMask: as draw, with the alpha of mask (at mask point
/// (mp_x, mp_y) for r's corner) scaling the source: Over composites
/// src * mask over the pixels, Src replaces them with src * mask. r is also
/// clipped to the mask's bounds. Any model's alpha serves as the mask (an
/// opaque Gray, say, is a mask of all ones); the mask's own coordinates are
/// its min_x and min_y. Each pixel comes out as Go's general path computes
/// it (16 bit channels, premultiplied), which is what Go's glyph and mask
/// fast paths compute too.
pub fn (var dst: Image) draw_mask(r: Rect, src: Image, sp_x: Int, sp_y: Int, mask: Image, mp_x: Int, mp_y: Int, op: Op) {
  draw_general(dst, r, src, false, Color{r: 0, g: 0, b: 0, a: 0}, sp_x, sp_y, Some(mask), mp_x, mp_y, op)
}

/// Go's draw.Draw with an image.Uniform source of color c (16 bit
/// premultiplied channels, as Color is everywhere): fills r clipped to the
/// image, with Src or Over (an opaque c fills as Src either way).
pub fn (var dst: Image) fill(r: Rect, c: Color, op: Op) {
  draw_general(dst, r, dst, true, c, 0, 0, None, 0, 0, op)
}

/// The interpolation algorithms of golang.org/x/image/draw.
pub enum Kernel {
  NearestNeighbor
  ApproxBiLinear
  BiLinear
  CatmullRom
} derive Eq, Display

/// golang.org/x/image/draw's Scale: scales the part of src over sr to the
/// part of the image over dr (clipped to the image), with the Porter-Duff op
/// and the interpolator. Equal sizes of dr and sr draw without scaling, as
/// the Go function does. NearestNeighbor picks, for destination pixel
/// (dx, dy) of dr, the source pixel at ((2 dx + 1) sw / (2 dw), (2 dy + 1) sh /
/// (2 dh)) from sr's corner; source pixels outside the source image read as
/// transparent black (or the palette's first entry). ApproxBiLinear blends the
/// four nearest source pixels by the fractions of the source position. BiLinear (the tent
/// kernel, support 1) and CatmullRom (support 2) blend the source pixels the
/// kernel reaches in two passes, columns then rows, in float64 as x/image does,
/// and round each channel to 16 bits; an opaque source takes Src for Over.
pub fn (var dst: Image) scale(dr: Rect, src: Image, sr: Rect, op: Op, kernel: Kernel) {
  let dw = dr.x1 - dr.x0
  let dh = dr.y1 - dr.y0
  let sw = sr.x1 - sr.x0
  let sh = sr.y1 - sr.y0
  if dw == sw && dh == sh && kernel == Kernel.NearestNeighbor {
    // only the nearest neighbor Scale turns equal sizes into a Copy
    dst.draw(dr, src, sr.x0, sr.y0, op)
    return
  }
  if dst.model == Model.YCbCr || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0 {
    return
  }
  let ax0 = imax(dr.x0, dst.min_x)
  let ay0 = imax(dr.y0, dst.min_y)
  let ax1 = imin(dr.x1, dst.min_x + dst.width)
  let ay1 = imin(dr.y1, dst.min_y + dst.height)
  if ax0 >= ax1 || ay0 >= ay1 {
    return
  }
  var op1 = op
  if op1 == Op.Over && image_opaque(src) {
    op1 = Op.Src
  }
  var b = BytesBuilder.with_capacity(dst.pix.len())
  b.write(dst.pix)
  if kernel == Kernel.NearestNeighbor {
    for y in ay0..ay1 {
      let sy = sr.y0 + (2 * (y - dr.y0) + 1) * sh / (2 * dh)
      for x in ax0..ax1 {
        let sx = sr.x0 + (2 * (x - dr.x0) + 1) * sw / (2 * dw)
        let sc = src.at(sx, sy)
        if op1 == Op.Over {
          let dc = dst.at(x, y)
          let pa1 = 65535 - sc.a
          store_color(b, dst, x, y, Color{r: (dc.r * pa1 / 65535 + sc.r) & 65535, g: (dc.g * pa1 / 65535 + sc.g) & 65535, b: (dc.b * pa1 / 65535 + sc.b) & 65535, a: (dc.a * pa1 / 65535 + sc.a) & 65535})
        } else {
          store_color(b, dst, x, y, sc)
        }
      }
    }
    dst.pix = b.freeze()
    return
  }
  if kernel == Kernel.ApproxBiLinear {
    let yscale = Float(sh) / Float(dh)
    let xscale = Float(sw) / Float(dw)
    for y in ay0..ay1 {
      let (sy0, sy1, yf0, yf1) = abl_pos(y - dr.y0, yscale, sh)
      for x in ax0..ax1 {
        let (sx0, sx1, xf0, xf1) = abl_pos(x - dr.x0, xscale, sw)
        let sc = abl_pixel(src, sr, sx0, sx1, xf0, xf1, sy0, sy1, yf0, yf1)
        if op1 == Op.Over {
          let dc = dst.at(x, y)
          let pa1 = 65535 - sc.a
          store_color(b, dst, x, y, Color{r: (dc.r * pa1 / 65535 + sc.r) & 65535, g: (dc.g * pa1 / 65535 + sc.g) & 65535, b: (dc.b * pa1 / 65535 + sc.b) & 65535, a: (dc.a * pa1 / 65535 + sc.a) & 65535})
        } else {
          store_color(b, dst, x, y, sc)
        }
      }
    }
    dst.pix = b.freeze()
    return
  }
  let kind = if kernel == Kernel.BiLinear { 0 } else { 1 }
  let hz = new_distrib(kind, dw, sw)
  let vt = new_distrib(kind, dh, sh)
  // scaleX: the source columns distributed over a dw by sh buffer, four channels each
  let nrgba_fast = src.model == Model.NRGBA && sr.x0 >= src.min_x && sr.y0 >= src.min_y && sr.x1 <= src.min_x + src.width && sr.y1 <= src.min_y + src.height
  var tmp: List[Float] = []
  for y in 0..sh {
    for k in 0..dw {
      var pr = 0.0
      var pg = 0.0
      var pb = 0.0
      var pa = 0.0
      for n in hz.si[k]..hz.sj[k] {
        var c = Color{r: 0, g: 0, b: 0, a: 0}
        if nrgba_fast {
          // x/image's scaleX_NRGBA widens the alpha only and divides by 0xff once
          let o = pix_off(src, sr.x0 + hz.cc[n] - src.min_x, sr.y0 + y - src.min_y, 4)
          let pau = Int(src.pix[o + 3]) * 257
          c = Color{r: Int(src.pix[o]) * pau / 255, g: Int(src.pix[o + 1]) * pau / 255, b: Int(src.pix[o + 2]) * pau / 255, a: pau}
        } else {
          c = src.at(sr.x0 + hz.cc[n], sr.y0 + y)
        }
        let w = hz.cw[n]
        pr = pr + Float(c.r) * w
        pg = pg + Float(c.g) * w
        pb = pb + Float(c.b) * w
        pa = pa + Float(c.a) * w
      }
      tmp.push(pr * hz.itw_ffff[k])
      tmp.push(pg * hz.itw_ffff[k])
      tmp.push(pb * hz.itw_ffff[k])
      tmp.push(pa * hz.itw_ffff[k])
    }
  }
  // scaleY: the buffer's rows distributed over the destination
  for x in ax0..ax1 {
    let dx = x - dr.x0
    for y in ay0..ay1 {
      let k = y - dr.y0
      var pr = 0.0
      var pg = 0.0
      var pb = 0.0
      var pa = 0.0
      for n in vt.si[k]..vt.sj[k] {
        let o = (vt.cc[n] * dw + dx) * 4
        let w = vt.cw[n]
        pr = pr + tmp[o] * w
        pg = pg + tmp[o + 1] * w
        pb = pb + tmp[o + 2] * w
        pa = pa + tmp[o + 3] * w
      }
      if pr > pa {
        pr = pa
      }
      if pg > pa {
        pg = pa
      }
      if pb > pa {
        pb = pa
      }
      let sc = Color{r: ftou(pr * vt.itw[k]), g: ftou(pg * vt.itw[k]), b: ftou(pb * vt.itw[k]), a: ftou(pa * vt.itw[k])}
      if op1 == Op.Over {
        let dc = dst.at(x, y)
        let pa1 = 65535 - sc.a
        store_color(b, dst, x, y, Color{r: (dc.r * pa1 / 65535 + sc.r) & 65535, g: (dc.g * pa1 / 65535 + sc.g) & 65535, b: (dc.b * pa1 / 65535 + sc.b) & 65535, a: (dc.a * pa1 / 65535 + sc.a) & 65535})
      } else {
        store_color(b, dst, x, y, sc)
      }
    }
  }
  dst.pix = b.freeze()
}

/// Go's draw.FloydSteinberg.Draw (the Src op with Floyd-Steinberg error
/// diffusion) onto a Paletted image: the part of src over r, clipped as draw
/// clips it, quantized to the nearest palette entry (Go's sum of squared
/// differences over the four 16 bit channels) with the error spread to the
/// neighbours in sixteenths. Any other destination model is left alone.
pub fn (var dst: Image) floyd_steinberg(r: Rect, src: Image, sp_x: Int, sp_y: Int) {
  if dst.model != Model.Paletted || dst.palette.len() == 0 {
    return
  }
  let (x0, y0, x1, y1, sp_x1, sp_y1) = draw_clip(dst, r, src, sp_x, sp_y)
  if x0 >= x1 || y0 >= y1 {
    return
  }
  let w = x1 - x0
  var pal: List[Color] = []
  for v in dst.palette {
    pal.push(from_nrgba(v))
  }
  var curr: List[Int] = []
  var next: List[Int] = []
  for _ in 0..(w + 2) * 4 {
    curr.push(0)
    next.push(0)
  }
  var b = BytesBuilder.with_capacity(dst.pix.len())
  b.write(dst.pix)
  for y in 0..(y1 - y0) {
    for x in 0..w {
      let sc = src.at(sp_x1 + x, sp_y1 + y)
      let er0 = fs_clamp(sc.r + curr[(x + 1) * 4] / 16)
      let eg0 = fs_clamp(sc.g + curr[(x + 1) * 4 + 1] / 16)
      let eb0 = fs_clamp(sc.b + curr[(x + 1) * 4 + 2] / 16)
      let ea0 = fs_clamp(sc.a + curr[(x + 1) * 4 + 3] / 16)
      var best = 0
      var best_sum = 4294967295
      var i = 0
      for p in pal {
        let sum = (sq_diff(er0, p.r) + sq_diff(eg0, p.g) + sq_diff(eb0, p.b) + sq_diff(ea0, p.a)) & 4294967295
        if sum < best_sum {
          best = i
          best_sum = sum
          if sum == 0 {
            break
          }
        }
        i += 1
      }
      b.put_be(pix_off(dst, x0 - dst.min_x + x, y0 - dst.min_y + y, 1), best, 1)
      let er = er0 - pal[best].r
      let eg = eg0 - pal[best].g
      let eb = eb0 - pal[best].b
      let ea = ea0 - pal[best].a
      next[x * 4] += er * 3
      next[x * 4 + 1] += eg * 3
      next[x * 4 + 2] += eb * 3
      next[x * 4 + 3] += ea * 3
      next[(x + 1) * 4] += er * 5
      next[(x + 1) * 4 + 1] += eg * 5
      next[(x + 1) * 4 + 2] += eb * 5
      next[(x + 1) * 4 + 3] += ea * 5
      next[(x + 2) * 4] += er
      next[(x + 2) * 4 + 1] += eg
      next[(x + 2) * 4 + 2] += eb
      next[(x + 2) * 4 + 3] += ea
      curr[(x + 2) * 4] += er * 7
      curr[(x + 2) * 4 + 1] += eg * 7
      curr[(x + 2) * 4 + 2] += eb * 7
      curr[(x + 2) * 4 + 3] += ea * 7
    }
    let t = curr
    curr = next
    next = t
    for k in 0..next.len() {
      next[k] = 0
    }
  }
  dst.pix = b.freeze()
}

/// An int32 sum scaled by 1<<16 to 8 bits as color.RGBToYCbCr clamps it:
/// out of the 24 bit range is 0 below and 255 above.
fn clamp16(v: Int) -> Int {
  if v < 0 {
    return 0
  }
  if v >= (1 << 24) {
    return 255
  }
  v >> 16
}

fn nrgba_color(r: Int, g: Int, b: Int, a: Int) -> Color {
  from_nrgba((r << 24) | (g << 16) | (b << 8) | a)
}

fn nrgba64_color(r: Int, g: Int, b: Int, a: Int) -> Color {
  if a == 65535 {
    return Color{r: r, g: g, b: b, a: a}
  }
  if a == 0 {
    return Color{r: 0, g: 0, b: 0, a: 0}
  }
  Color{r: (r * a) / 65535, g: (g * a) / 65535, b: (b * a) / 65535, a: a}
}

/// Go's color.YCbCr.RGBA: 16 bit channels with the clamp of its int32 math.
fn ycc_color(y: Int, cb: Int, cr: Int) -> Color {
  let yy1 = y * 65793
  let cb1 = cb - 128
  let cr1 = cr - 128
  Color{r: ycc_clamp(yy1 + 91881 * cr1), g: ycc_clamp(yy1 - 22554 * cb1 - 46802 * cr1), b: ycc_clamp(yy1 + 116130 * cb1), a: 65535}
}

fn ycc_clamp(v: Int) -> Int {
  if (v & 4278190080) == 0 {
    return v >> 8
  }
  if v < 0 {
    return 0
  }
  65535
}

/// Go's YCbCr.COffset: the index of the chroma sample of the absolute pixel
/// (ax, ay), for the subsampling ratio.
fn chroma_index(im: Image, ax: Int, ay: Int) -> Int {
  let cs = if im.c_stride > 0 { im.c_stride } else { chroma_width(im.width, im.subsample) }
  let rx = ax - im.min_x
  let ry = ay - im.min_y
  match im.subsample {
    jpeg.Subsample.S444 => ry * cs + rx
    jpeg.Subsample.S422 => ry * cs + (ax / 2 - im.min_x / 2)
    jpeg.Subsample.S420 => (ay / 2 - im.min_y / 2) * cs + (ax / 2 - im.min_x / 2)
    jpeg.Subsample.S440 => (ay / 2 - im.min_y / 2) * cs + rx
    jpeg.Subsample.S411 => ry * cs + (ax / 4 - im.min_x / 4)
    jpeg.Subsample.S410 => (ay / 2 - im.min_y / 2) * cs + (ax / 4 - im.min_x / 4)
  }
}

/// The width of a chroma row of a tight YCbCr image (Go's CStride).
fn chroma_width(w: Int, s: jpeg.Subsample) -> Int {
  match s {
    jpeg.Subsample.S444 => w
    jpeg.Subsample.S440 => w
    jpeg.Subsample.S422 => (w + 1) / 2
    jpeg.Subsample.S420 => (w + 1) / 2
    jpeg.Subsample.S411 => (w + 3) / 4
    jpeg.Subsample.S410 => (w + 3) / 4
  }
}

