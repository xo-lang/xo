  2857762815, 3149594879, 3149618687, 3149642751, 2863333375, 2868838655, 2868860415, 2868882175,
  3422604543, 3427008767, 3427026175, 3427043583, 3427060991, 3431465215, 3431482623, 3431500031,
  3431517439, 3435921663, 3435939071, 3435956479, 3435973887, 3422552319, 3422569727, 3422587135,
  3707802623, 3707821567, 3712549119, 3712567807, 3712586751, 3712605695, 3717398783, 3717417471,
  3717436415, 3717455359, 3722248447, 3722267135, 3722286079, 3722305023, 3707764991, 3707783679,
  3992997887, 3993018111, 3993038591, 3998155007, 3998175231, 3998195455, 3998215935, 4003332351,
  4003352575, 4003372799, 4003393279, 4008575231, 4008595455, 4008615679, 4008636159, 3992977663,
  4278190335, 4278212095, 4278233855, 4278255615, 4283760895, 4283782655, 4283804415, 4283826175,
  4289331455, 4289353215, 4289374975, 4289396735, 4294902015, 4294923775, 4294945535, 4294967295,
]

/// Go's sqDiff on uint32: ((x - y) mod 2^32 squared mod 2^32) >> 2. The
/// square of d and of -d agree modulo 2^32, so the absolute difference (at
/// most 65535 for 16 bit channels) gives the same value without overflow.
fn sq_diff(x: Int, y: Int) -> Int {
  let e = if x > y { x - y } else { y - x }
  ((e * e) & 4294967295) >> 2
}

/// Stores c into the pixel (ax, ay) of the pixel buffer b (the samples of im)
/// as Go's Image.Set does; a point outside is ignored. Bytes is immutable, so the pixels are copied into a
/// BytesBuilder, patched in place and frozen again: a set costs time linear in
/// the image (bulk writers, like the draw step of decision 0578, build their
/// own buffers).
fn store_color(var b: BytesBuilder, im: Image, ax: Int, ay: Int, c: Color) -> () {
  let x = ax - im.min_x
  let y = ay - im.min_y
  if x < 0 || y < 0 || x >= im.width || y >= im.height {
    return
  }
  let stride = im.stride
  var at = 0
  var v = 0
  var n = 1
  match im.model {
    Model.Gray => {
      at = y * (if stride > 0 { stride } else { im.width }) + x
      v = c.gray()
    }
    Model.Gray16 => {
      at = y * (if stride > 0 { stride } else { im.width * 2 }) + x * 2
      v = c.gray16()
      n = 2
    }
    Model.Paletted => {
      if im.palette.len() == 0 {
        return
      }
      at = y * (if stride > 0 { stride } else { im.width }) + x
      v = palette_index(im.palette, c)
    }
    Model.RGBA => {
      at = y * (if stride > 0 { stride } else { im.width * 4 }) + x * 4
      v = ((c.r >> 8) << 24) | ((c.g >> 8) << 16) | ((c.b >> 8) << 8) | (c.a >> 8)
      n = 4
    }
    Model.NRGBA => {
      at = y * (if stride > 0 { stride } else { im.width * 4 }) + x * 4
      v = c.nrgba()
      n = 4
    }
    Model.CMYK => {
      at = y * (if stride > 0 { stride } else { im.width * 4 }) + x * 4
      let (cc, m, yy, k) = rgb_to_cmyk(c.r >> 8, c.g >> 8, c.b >> 8)
      v = (cc << 24) | (m << 16) | (yy << 8) | k
      n = 4
    }
    Model.RGBA64 => {
      at = y * (if stride > 0 { stride } else { im.width * 8 }) + x * 8
      b.put_be(at, c.r, 2)
      b.put_be(at + 2, c.g, 2)
      b.put_be(at + 4, c.b, 2)
      b.put_be(at + 6, c.a, 2)
      return
    }
    Model.NRGBA64 => {
      at = y * (if stride > 0 { stride } else { im.width * 8 }) + x * 8
      var r = c.r
      var g = c.g
      var bl = c.b
      if c.a == 0 {
        r = 0
        g = 0
        bl = 0
      } else if c.a != 65535 {
        r = (c.r * 65535) / c.a
        g = (c.g * 65535) / c.a
        bl = (c.b * 65535) / c.a
      }
      b.put_be(at, r, 2)
      b.put_be(at + 2, g, 2)
      b.put_be(at + 4, bl, 2)
      b.put_be(at + 6, c.a, 2)
      return
    }
    Model.YCbCr => {
      return
    }
  }
  b.put_be(at, v, n)
}

/// Bytes per pixel of a model that keeps its samples in pix (0 for YCbCr).
fn model_bpp(m: Model) -> Int {
  match m {
    Model.Gray => 1
    Model.Paletted => 1
    Model.Gray16 => 2
    Model.RGBA => 4
    Model.NRGBA => 4
    Model.CMYK => 4
    Model.RGBA64 => 8
    Model.NRGBA64 => 8
    Model.YCbCr => 0
  }
}

/// Image.to_rgba and to_nrgba: every pixel through at(), then the model of
/// the result (to_nrgba true for NRGBA).
fn image_convert_all(im: Image, nrgba: Bool) -> Image {
  var b = BytesBuilder.with_capacity(im.width * im.height * 4)
  for yy in 0..im.height {
    for xx in 0..im.width {
      let c = im.at(im.min_x + xx, im.min_y + yy)
      if nrgba {
        // Go's NRGBAModel hands an NRGBA color back as it is: NRGBA samples and
        // palette entries (color.NRGBA) skip the premultiplied round trip
        if im.model == Model.NRGBA {
          let st = if im.stride > 0 { im.stride } else { im.width * 4 }
          b.write(im.pix[yy * st + xx * 4..yy * st + xx * 4 + 4])
        } else if im.model == Model.Paletted && im.palette.len() > 0 {
          let st = if im.stride > 0 { im.stride } else { im.width }
          var idx = Int(im.pix[yy * st + xx])
          if idx >= im.palette.len() {
            idx = 0
          }
          b.write_be(im.palette[idx], 4)
        } else {
          b.write_be(c.nrgba(), 4)
        }
      } else {
        b.write_be(((c.r >> 8) << 24) | ((c.g >> 8) << 16) | ((c.b >> 8) << 8) | (c.a >> 8), 4)
      }
    }
  }
  let m = if nrgba { Model.NRGBA } else { Model.RGBA }
  Image{width: im.width, height: im.height, model: m, pix: b.freeze(), stride: 0, min_x: im.min_x, min_y: im.min_y}
}

fn from_png_model(m: png.Model) -> Model {
  match m {
    png.Model.Gray => Model.Gray
    png.Model.Gray16 => Model.Gray16
    png.Model.Paletted => Model.Paletted
    png.Model.RGBA => Model.RGBA
    png.Model.NRGBA => Model.NRGBA
    png.Model.RGBA64 => Model.RGBA64
    png.Model.NRGBA64 => Model.NRGBA64
  }
}

fn to_png_model(m: Model) -> png.Model? {
  match m {
    Model.Gray => Some(png.Model.Gray)
    Model.Gray16 => Some(png.Model.Gray16)
    Model.Paletted => Some(png.Model.Paletted)
    Model.RGBA => Some(png.Model.RGBA)
    Model.NRGBA => Some(png.Model.NRGBA)
    Model.RGBA64 => Some(png.Model.RGBA64)
    Model.NRGBA64 => Some(png.Model.NRGBA64)
    Model.CMYK => None
    Model.YCbCr => None
  }
}

fn imax(a: Int, b: Int) -> Int { if a > b { a } else { b } }

fn imin(a: Int, b: Int) -> Int { if a < b { a } else { b } }

/// Byte offset of the pixel (rx, ry) (relative to the corner) in a pix model
/// with bpp bytes a pixel.
fn pix_off(im: Image, rx: Int, ry: Int, bpp: Int) -> Int {
  let st = if im.stride > 0 { im.stride } else { im.width * bpp }
  ry * st + rx * bpp
}

/// The source color of Go's drawRGBA fast paths into an RGBA destination:
/// as at(), except YCbCr, which draw.DrawYCbCr converts with the 8 bit
/// color.YCbCrToRGB and an opaque alpha.
fn draw_src_color(src: Image, sx: Int, sy: Int) -> Color {
  if src.model != Model.YCbCr {
    return src.at(sx, sy)
  }
  let rx = sx - src.min_x
  let ry = sy - src.min_y
  if rx < 0 || ry < 0 || rx >= src.width || ry >= src.height {
    return src.at(sx, sy)
  }
  let ys = if src.y_stride > 0 { src.y_stride } else { src.width }
  let ci = chroma_index(src, sx, sy)
  let (r, g, b) = ycbcr_to_rgb(Int(src.y[ry * ys + rx]), Int(src.cb[ci]), Int(src.cr[ci]))
  Color{r: r * 257, g: g * 257, b: b * 257, a: 65535}
}

/// One pixel of Go's drawCopyOver, drawNRGBAOver, drawGray (and the Src
/// forms) for an RGBA destination: the new 0xRRGGBBAA of the destination
/// pixel at di given the source pixel at si. mk is 0 for an RGBA source, 1 for
/// NRGBA and 2 for Gray.
fn draw_px(dp: Bytes, di: Int, sp: Bytes, si: Int, mk: Int, over: Bool) -> Int {
  var sr = 0
  var sg = 0
  var sb = 0
  var sa = 65535
  if mk == 0 {
    sr = Int(sp[si]) * 257
    sg = Int(sp[si + 1]) * 257
    sb = Int(sp[si + 2]) * 257
    sa = Int(sp[si + 3]) * 257
  } else if mk == 1 {
    sa = Int(sp[si + 3]) * 257
    sr = Int(sp[si]) * sa / 255
    sg = Int(sp[si + 1]) * sa / 255
    sb = Int(sp[si + 2]) * sa / 255
  } else {
    let g = Int(sp[si]) * 257
    sr = g
    sg = g
    sb = g
  }
  if over && sa != 65535 {
    let a = (65535 - sa) * 257
    return ((((Int(dp[di]) * a) / 65535 + sr) >> 8) << 24) | ((((Int(dp[di + 1]) * a) / 65535 + sg) >> 8) << 16) | ((((Int(dp[di + 2]) * a) / 65535 + sb) >> 8) << 8) | (((Int(dp[di + 3]) * a) / 65535 + sa) >> 8)
  }
  ((sr >> 8) << 24) | ((sg >> 8) << 16) | ((sb >> 8) << 8) | (sa >> 8)
}

/// Go's drawCopyOver, drawCopySrc, drawNRGBAOver, drawNRGBASrc and drawGray
/// for an RGBA destination: the new samples built front to back, rows of the
/// destination outside the rectangle (and the bytes around it) copied as
/// slices, the pixels inside computed from the source bytes directly, two to
/// a word pushed.
fn draw_rgba_rows(dst: Image, src: Image, x0: Int, y0: Int, x1: Int, y1: Int, sp_x: Int, sp_y: Int, op: Op) -> Bytes {
  var b = BytesBuilder.with_capacity(dst.pix.len())
  var pos = 0
  let over = op == Op.Over
  let mk = if src.model == Model.RGBA { 0 } else if src.model == Model.NRGBA { 1 } else { 2 }
  let sbpp = if mk == 2 { 1 } else { 4 }
  let w = x1 - x0
  let dp = dst.pix
  let spx = src.pix
  for y in y0..y1 {
    let rowstart = pix_off(dst, x0 - dst.min_x, y - dst.min_y, 4)
    b.write(dp[pos..rowstart])
    var si = pix_off(src, sp_x - src.min_x, sp_y + (y - y0) - src.min_y, sbpp)
    var di = rowstart
    if !over && mk == 0 {
      // Go's drawCopySrc: a Src copy of RGBA samples is a copy of the row
      b.write(spx[si..si + w * 4])
      pos = di + w * 4
      continue
    }
    var x = 0
    while x + 1 < w {
      let p0 = draw_px(dp, di, spx, si, mk, over)
      let p1 = draw_px(dp, di + 4, spx, si + sbpp, mk, over)
      b.write_be(p0.wrapping_shl(32) | p1, 8)
      si += 2 * sbpp
      di += 8
      x += 2
    }
    if x < w {
      b.write_be(draw_px(dp, di, spx, si, mk, over), 4)
      di += 4
    }
    pos = di
  }
  b.write(dp[pos..dp.len()])
  b.freeze()
}

/// Go's draw.clip: r clipped to dst and to src (translated by r's corner minus
/// the source point), and the source point moved by as much as r's corner
/// moved. (x0, y0, x1, y1, sp_x, sp_y); empty when x0 >= x1 or y0 >= y1.
fn draw_clip(dst: Image, r: Rect, src: Image, spx: Int, spy: Int) -> (Int, Int, Int, Int, Int, Int) {
  let ox = r.x0
  let oy = r.y0
  var x0 = imax(r.x0, dst.min_x)
  var y0 = imax(r.y0, dst.min_y)
  var x1 = imin(r.x1, dst.min_x + dst.width)
  var y1 = imin(r.y1, dst.min_y + dst.height)
  x0 = imax(x0, src.min_x + ox - spx)
  y0 = imax(y0, src.min_y + oy - spy)
  x1 = imin(x1, src.min_x + src.width + ox - spx)
  y1 = imin(y1, src.min_y + src.height + oy - spy)
  (x0, y0, x1, y1, spx + (x0 - ox), spy + (y0 - oy))
}

fn fs_clamp(v: Int) -> Int {
  if v < 0 {
    return 0
  }
  if v > 65535 {
    return 65535
  }
  v
}

/// Go's clip with a mask: r clipped to dst, to src (unless uniform) and to
/// mask (unless absent), with both points moved by as much as r's corner.
/// (x0, y0, x1, y1, sp_x, sp_y, mp_x, mp_y).
fn draw_clip_mask(dst: Image, r: Rect, src: Image, uniform: Bool, spx: Int, spy: Int, mask: Image?, mpx: Int, mpy: Int) -> (Int, Int, Int, Int, Int, Int, Int, Int) {
  let ox = r.x0
  let oy = r.y0
  var x0 = imax(r.x0, dst.min_x)
  var y0 = imax(r.y0, dst.min_y)
  var x1 = imin(r.x1, dst.min_x + dst.width)
  var y1 = imin(r.y1, dst.min_y + dst.height)
  if !uniform {
    x0 = imax(x0, src.min_x + ox - spx)
    y0 = imax(y0, src.min_y + oy - spy)
    x1 = imin(x1, src.min_x + src.width + ox - spx)
    y1 = imin(y1, src.min_y + src.height + oy - spy)
  }
  if let m = mask {
    x0 = imax(x0, m.min_x + ox - mpx)
    y0 = imax(y0, m.min_y + oy - mpy)
    x1 = imin(x1, m.min_x + m.width + ox - mpx)
    y1 = imin(y1, m.min_y + m.height + oy - mpy)
  }
  (x0, y0, x1, y1, spx + (x0 - ox), spy + (y0 - oy), mpx + (x0 - ox), mpy + (y0 - oy))
}

/// Go's DrawMask general path (and drawRGBA's formulas for an RGBA
/// destination) for a source image or a uniform color and an optional mask.
fn draw_general(var dst: Image, r: Rect, src: Image, uniform: Bool, uc: Color, spx: Int, spy: Int, mask: Image?, mpx: Int, mpy: Int, op: Op) -> () {
  if dst.model == Model.YCbCr {
    return
  }
  let (x0, y0, x1, y1, sp_x, sp_y, mp_x, mp_y) = draw_clip_mask(dst, r, src, uniform, spx, spy, mask, mpx, mpy)
  if x0 >= x1 || y0 >= y1 {
    return
  }
  let over = op == Op.Over
  var b = BytesBuilder.with_capacity(dst.pix.len())
  b.write(dst.pix)
  for y in y0..y1 {
    for x in x0..x1 {
      let sc = if uniform { uc } else { src.at(sp_x + (x - x0), sp_y + (y - y0)) }
      var ma = 65535
      if let m = mask {
        ma = m.at(mp_x + (x - x0), mp_y + (y - y0)).a
      }
      if dst.model == Model.RGBA {
        let di = pix_off(dst, x - dst.min_x, y - dst.min_y, 4)
        if over {
          let a = (65535 - sc.a * ma / 65535) * 257
          let rr = ((Int(dst.pix[di]) * a + sc.r * ma) / 65535) >> 8
          let gg = ((Int(dst.pix[di + 1]) * a + sc.g * ma) / 65535) >> 8
          let bb = ((Int(dst.pix[di + 2]) * a + sc.b * ma) / 65535) >> 8
          let aa = ((Int(dst.pix[di + 3]) * a + sc.a * ma) / 65535) >> 8
          b.put_be(di, ((rr & 255) << 24) | ((gg & 255) << 16) | ((bb & 255) << 8) | (aa & 255), 4)
        } else {
          let rr = (sc.r * ma / 65535) >> 8
          let gg = (sc.g * ma / 65535) >> 8
          let bb = (sc.b * ma / 65535) >> 8
          let aa = (sc.a * ma / 65535) >> 8
          b.put_be(di, ((rr & 255) << 24) | ((gg & 255) << 16) | ((bb & 255) << 8) | (aa & 255), 4)
        }
      } else if ma == 0 {
        if !over {
          store_color(b, dst, x, y, Color{r: 0, g: 0, b: 0, a: 0})
        }
      } else if ma == 65535 && !over {
        store_color(b, dst, x, y, sc)
      } else if over {
        let dc = dst.at(x, y)
        let a = 65535 - sc.a * ma / 65535
        store_color(b, dst, x, y, Color{r: (dc.r * a + sc.r * ma) / 65535, g: (dc.g * a + sc.g * ma) / 65535, b: (dc.b * a + sc.b * ma) / 65535, a: (dc.a * a + sc.a * ma) / 65535})
      } else {
        store_color(b, dst, x, y, Color{r: sc.r * ma / 65535, g: sc.g * ma / 65535, b: sc.b * ma / 65535, a: sc.a * ma / 65535})
      }
    }
  }
  dst.pix = b.freeze()
}

/// The kernels of x/image/draw: BiLinear (kind 0, support 1) and CatmullRom
/// (kind 1, support 2), as the float64 expressions Go writes (no fused
/// multiply adds).
fn kern_support(kind: Int) -> Float {
  if kind == 0 { 1.0 } else { 2.0 }
}

fn kern_at(kind: Int, t: Float) -> Float {
  if kind == 0 {
    return 1.0 - t
  }
  if t < 1.0 {
    return ((1.5 * t) - 2.5) * t * t + 1.0
  }
  (((-0.5 * t) + 2.5) * t - 4.0) * t + 2.0
}

/// x/image's distrib: how the sw source columns (or rows) distribute over the
/// dw destination ones. Source k owns contribs si[k]..sj[k] (coordinates cc,
/// weights cw), itw[k] is the inverse total weight and itw_ffff[k] that over
/// 0xffff.
struct Distrib {
  si: List[Int]
  sj: List[Int]
  itw: List[Float]
  itw_ffff: List[Float]
  cc: List[Int]
  cw: List[Float]
}

fn new_distrib(kind: Int, dw: Int, sw: Int) -> Distrib {
  let support = kern_support(kind)
  let scale = Float(sw) / Float(dw)
  var half_width = support
  var arg_scale = 1.0
  if scale > 1.0 {
    half_width = half_width * scale
    arg_scale = 1.0 / scale
  }
  var lo: List[Int] = []
  var hi: List[Int] = []
  var center: List[Float] = []
  for x in 0..dw {
    let c = (Float(x) + 0.5) * scale - 0.5
    var i = Int((c - half_width).floor())
    if i < 0 {
      i = 0
    }
    var j = Int((c + half_width).ceil())
    if j > sw {
      j = sw
      if j < i {
        j = i
      }
    }
    lo.push(i)
    hi.push(j)
    center.push(c)
  }
  var d = Distrib{si: [], sj: [], itw: [], itw_ffff: [], cc: [], cw: []}
  for k in 0..dw {
    var total = 0.0
    let l = d.cc.len()
    for coord in lo[k]..hi[k] {
      var t = (center[k] - Float(coord)) * arg_scale
      if t < 0.0 {
        t = -t
      }
      if t >= support {
        continue
      }
      let w = kern_at(kind, t)
      if w == 0.0 {
        continue
      }
      total = total + w
      d.cc.push(coord)
      d.cw.push(w)
    }
    total = 1.0 / total
    d.si.push(l)
    d.sj.push(d.cc.len())
    d.itw.push(total)
    d.itw_ffff.push(total / 65535.0)
  }
  d
}

/// x/image's ftou: [0, 1] scaled to [0, 0xffff], rounded, clamped. A NaN
/// (0 times an infinite inverse weight) is 0, as Go's int32(NaN) makes it
/// on arm64; Xo orders NaN above +Inf, so the plain comparisons would give
/// 65535.
fn ftou(f: Float) -> Int {
  let x = 65535.0 * f + 0.5
  if x.is_nan() || x < 1.0 {
    return 0
  }
  if x >= 65536.0 {
    return 65535
  }
  Int(x)
}

/// Whether every pixel of the image is opaque (the Opaque method of Go's
/// image types).
fn image_opaque(im: Image) -> Bool {
  if im.model == Model.Gray || im.model == Model.Gray16 || im.model == Model.CMYK || im.model == Model.YCbCr {
    return true
  }
  if im.model == Model.Paletted {
    for v in im.palette {
      if v & 255 != 255 {
        return false
      }
    }
    return true
  }
  for y in 0..im.height {
    for x in 0..im.width {
      if im.at(im.min_x + x, im.min_y + y).a != 65535 {
        return false
      }
    }
  }
  true
}

/// x/image's ApproxBiLinear scaler (see the declaration): the four nearest
/// source pixels blended with the fractions of the source position, in float64
/// as x/image does, the result truncated to 16 bits.
fn abl_tap(src: Image, sx: Int, sy: Int) -> (Float, Float, Float, Float) {
  let c = src.at(sx, sy)
  (Float(c.r), Float(c.g), Float(c.b), Float(c.a))
}

fn abl_pos(d: Int, scale: Float, n: Int) -> (Int, Int, Float, Float) {
  let s = (Float(d) + 0.5) * scale - 0.5
  var s0 = Int(s)
  var f0 = s - Float(s0)
  var f1 = 1.0 - f0
  var s1 = s0 + 1
  if s < 0.0 {
    s0 = 0
    s1 = 0
    f0 = 0.0
    f1 = 1.0
  } else if s1 > n - 1 {
    s0 = n - 1
    s1 = n - 1
    f0 = 1.0
    f1 = 0.0
  }
  (s0, s1, f0, f1)
}

fn abl_pixel(src: Image, sr: Rect, sx0: Int, sx1: Int, xf0: Float, xf1: Float, sy0: Int, sy1: Int, yf0: Float, yf1: Float) -> Color {
  let (r00, g00, b00, a00) = abl_tap(src, sr.x0 + sx0, sr.y0 + sy0)
  let (r10, g10, b10, a10) = abl_tap(src, sr.x0 + sx1, sr.y0 + sy0)
  let (r01, g01, b01, a01) = abl_tap(src, sr.x0 + sx0, sr.y0 + sy1)
  let (r11, g11, b11, a11) = abl_tap(src, sr.x0 + sx1, sr.y0 + sy1)
  let hr0 = xf1 * r00 + xf0 * r10
  let hg0 = xf1 * g00 + xf0 * g10
  let hb0 = xf1 * b00 + xf0 * b10
  let ha0 = xf1 * a00 + xf0 * a10
  let hr1 = xf1 * r01 + xf0 * r11
  let hg1 = xf1 * g01 + xf0 * g11
  let hb1 = xf1 * b01 + xf0 * b11
  let ha1 = xf1 * a01 + xf0 * a11
  Color{r: Int(yf1 * hr0 + yf0 * hr1) & 65535, g: Int(yf1 * hg0 + yf0 * hg1) & 65535, b: Int(yf1 * hb0 + yf0 * hb1) & 65535, a: Int(yf1 * ha0 + yf0 * ha1) & 65535}
}
