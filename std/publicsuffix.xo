use std/netip

/// Why a domain has no registrable domain (Go's EffectiveTLDPlusOne
/// errors, their texts).
pub struct PslErr {
  pub msg: Str
}

pub fn (e: PslErr) display() -> Str { e.msg }

/// The public suffix of domain (Go's PublicSuffix) and whether it is an
/// ICANN suffix (false for a private one, such as `github.io`, or one the
/// list does not have, whose last label is then the suffix). domain is
/// lower case ASCII (IDNA's form); an IP address is its own suffix.
pub fn public_suffix(domain: Str) -> (Str, Bool) {
  if netip.parse_addr(domain) is Ok(_) {
    return (domain, false)
  }
  var lo = 0
  var hi = NUM_TLD
  var s = domain
  var suffix = domain.len()
  var icann_node = false
  var wildcard = false
  var icann = false
  while true {
    let dot = last_dot(s)
    if wildcard {
      icann = icann_node
      suffix = 1 + dot
    }
    if lo == hi {
      break
    }
    let f = find(s[1 + dot..], lo, hi)
    if f < 0 {
      break
    }
    var u = node(f).shr_logical(NODES_BITS_TEXT_OFFSET + NODES_BITS_TEXT_LENGTH)
    icann_node = (u & ((1 << NODES_BITS_ICANN) - 1)) != 0
    u = u.shr_logical(NODES_BITS_ICANN)
    u = child(u & ((1 << NODES_BITS_CHILDREN) - 1))
    lo = u & ((1 << CHILDREN_BITS_LO) - 1)
    u = u.shr_logical(CHILDREN_BITS_LO)
    hi = u & ((1 << CHILDREN_BITS_HI) - 1)
    u = u.shr_logical(CHILDREN_BITS_HI)
    let kind = u & ((1 << CHILDREN_BITS_NODE_TYPE) - 1)
    if kind == 0 {
      suffix = 1 + dot
    } else if kind == 1 {
      // an exception: the label is not part of the suffix
      suffix = 1 + s.len()
      break
    }
    u = u.shr_logical(CHILDREN_BITS_NODE_TYPE)
    wildcard = (u & ((1 << CHILDREN_BITS_WILDCARD) - 1)) != 0
    if !wildcard {
      icann = icann_node
    }
    if dot == -1 {
      break
    }
    s = s[..dot]
  }
  if suffix == domain.len() {
    return (domain[1 + last_dot(domain)..], icann)
  }
  (domain[suffix..], icann)
}

/// The registrable domain of domain: its public suffix and one more label
/// (Go's EffectiveTLDPlusOne): `www.example.co.uk` is `example.co.uk`. A
/// domain that is itself a public suffix, or has an empty label, is an
/// error with Go's text.
pub fn effective_tld_plus_one(domain: Str) -> Str ! PslErr {
  if domain.starts_with(".") || domain.ends_with(".") || domain.contains("..") {
    return Err(PslErr{msg: "publicsuffix: empty label in domain ${go_q(domain)}"})
  }
  let (suffix, _) = public_suffix(domain)
  if domain.len() <= suffix.len() {
    return Err(PslErr{msg: "publicsuffix: cannot derive eTLD+1 for domain ${go_q(domain)}"})
  }
  let i = domain.len() - suffix.len() - 1
  if domain.bytes()[i] != 46 {
    return Err(PslErr{msg: "publicsuffix: invalid public suffix ${go_q(suffix)} for domain ${go_q(domain)}"})
  }
  Ok(domain[1 + last_dot(domain[..i])..])
}

/// Go's %q of an ASCII domain.
fn go_q(s: Str) -> Str { "\"" + s.replace("\\", "\\\\").replace("\"", "\\\"") + "\"" }

fn last_dot(s: Str) -> Int { s.rfind(".") ?? -1 }

/// The node of the label in [lo, hi), or -1 (Go's find: a binary search;
/// labels compare as bytes).
fn find(label: Str, lo0: Int, hi0: Int) -> Int {
  var lo = lo0
  var hi = hi0
  let want = label.bytes()
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    let c = compare_label(mid, want)
    if c < 0 {
      lo = mid + 1
    } else if c == 0 {
      return mid
    } else {
      hi = mid
    }
  }
  -1
}

/// Node i's label compared with want: negative, zero or positive.
fn compare_label(i: Int, want: Bytes) -> Int {
  let x = node(i)
  let n = x & ((1 << NODES_BITS_TEXT_LENGTH) - 1)
  let off = x.shr_logical(NODES_BITS_TEXT_LENGTH) & ((1 << NODES_BITS_TEXT_OFFSET) - 1)
  let m = if n < want.len() { n } else { want.len() }
  for k in 0..m {
    let a = Int(TEXT[off + k])
    let b = Int(want[k])
    if a != b {
      return a - b
    }
  }
  n - want.len()
}

/// Node i: 5 bytes, big endian.
fn node(i: Int) -> Int {
  let o = i * 5
  (Int(NODES[o]) << 32) | (Int(NODES[o + 1]) << 24) | (Int(NODES[o + 2]) << 16) | (Int(NODES[o + 3]) << 8) | Int(NODES[o + 4])
}

/// Children entry i: 4 bytes, big endian.
fn child(i: Int) -> Int {
  let o = i * 4
  (Int(CHILDREN[o]) << 24) | (Int(CHILDREN[o + 1]) << 16) | (Int(CHILDREN[o + 2]) << 8) | Int(CHILDREN[o + 3])
}

