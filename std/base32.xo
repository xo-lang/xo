// Origin: Go's encoding/base32 (base32.go of go1.26: Encode, and DecodeString:
// newlines stripped, then decode), with the same output and error offsets.
// Go returns the bytes decoded before an error; Xo returns the error alone.
// std/base32 (spec/std.md 21, decision 0279). Encoding rules
// are listed at the top of std/prelude.xo. Go's encoding/base32:
// the alphabets of RFC 4648. Pure.

/// RFC 4648 section 6 (`Std`, `A-Z2-7`) and section 7 (`Hex`,
/// `0-9A-V`); the Raw forms write and read no `=` padding.
pub enum Base32 {
  Std
  Hex
  RawStd
  RawHex
}

/// Displays as Go's CorruptInputError: `illegal base32 data at input byte 4`.
pub struct DecodeErr {
  /// the byte offset of the error in the input without `\r` and `\n`
  pub at: Int
}

pub fn (e: DecodeErr) display() -> Str { "illegal base32 data at input byte ${e.at}" }

const STD: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567"
const HEX: Str = "0123456789ABCDEFGHIJKLMNOPQRSTUV"

fn alphabet(enc: Base32) -> Bytes {
  match enc {
    Std => STD.bytes()
    RawStd => STD.bytes()
    Hex => HEX.bytes()
    RawHex => HEX.bytes()
  }
}

fn padded(enc: Base32) -> Bool { enc is Std | Hex }

/// The value of each byte in the alphabet, or 255 (also for `=`).
const DEC_STD: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x1a\x1b\x1c\x1d\x1e\x1f\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
const DEC_HEX: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\xff\xff\xff\xff\xff\xff\xff\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

pub fn encode(data: Bytes, enc: Base32 = Base32.Std) -> Str {
  encode_with(data, alphabet(enc), if padded(enc) { 61 } else { -1 })
}

/// encode over alphabet a, writing pad (a byte, or -1 for none) after a
/// partial block.
fn encode_with(data: Bytes, a: Bytes, pad: Int) -> Str {
  var out = BytesBuilder.with_capacity((data.len() + 4) / 5 * 8)
  // whole five byte blocks: one 40 bit word, eight symbols, no per byte
  // test (Go's Encode loop; 2026-10-26: the block loop below ran encode at
  // 2.1x Go's time)
  let n = data.len()
  let full = n - n % 5
  var si = 0
  while si < full {
    let v = (Int(data[si]) << 32) | (Int(data[si + 1]) << 24) | (Int(data[si + 2]) << 16) | (Int(data[si + 3]) << 8) | Int(data[si + 4])
    out.write_byte(a[(v >> 35) & 31])
    out.write_byte(a[(v >> 30) & 31])
    out.write_byte(a[(v >> 25) & 31])
    out.write_byte(a[(v >> 20) & 31])
    out.write_byte(a[(v >> 15) & 31])
    out.write_byte(a[(v >> 10) & 31])
    out.write_byte(a[(v >> 5) & 31])
    out.write_byte(a[v & 31])
    si += 5
  }
  // the last, partial block
  while si < data.len() {
    let remain = (data.len() - si).min(5)
    // the block's 40 bits, zero filled past the data
    var v = 0
    for k in 0..5 {
      v = (v << 8) | (if k < remain { Int(data[si + k]) } else { 0 })
    }
    // symbols carrying data: 2, 4, 5, 7, 8 for 1 to 5 bytes
    let syms = (remain * 8 + 4) / 5
    for k in 0..syms {
      out.write_byte(a[(v >> (35 - 5 * k)) & 31])
    }
    if pad >= 0 {
      for _ in syms..8 { out.write_byte(UInt8(pad)) }
    }
    si += 5
  }
  out.freeze().to_str() ?? ""
}

/// `\r` and `\n` are removed first; anything else outside the alphabet,
/// or padding where the encoding has none, is DecodeErr at its byte
/// offset in the input without them.
pub fn decode(s: Str, enc: Base32 = Base32.Std) -> Bytes ! DecodeErr {
  decode_with(s, if enc is Hex | RawHex { DEC_HEX } else { DEC_STD }, if padded(enc) { 61 } else { -1 })
}

/// decode with the value table tbl (255 outside the alphabet) and pad (a
/// byte, or -1 for none).
fn decode_with(s: Str, tbl: Bytes, pad_byte: Int) -> Bytes ! DecodeErr {
  // copy only when there is a newline to drop (Go skips them in place)
  var src = s.bytes()
  if s.contains("\n") || s.contains("\r") {
    var stripped = BytesBuilder.with_capacity(s.len())
    for c in s.bytes() {
      if c != 10 && c != 13 { stripped.write_byte(c) }
    }
    src = stripped.freeze()
  }
  let pad = pad_byte >= 0
  let olen = src.len()
  var out = BytesBuilder.with_capacity(olen / 8 * 5 + 5)
  var at = 0
  var end = false
  while at < olen && !end {
    // eight plain symbols, the usual case
    if at + 8 <= olen {
      var acc = 0
      var bad = 0
      for k in 0..8 {
        let v = Int(tbl[Int(src[at + k])])
        bad = bad | v
        acc = (acc << 5) | (v & 31)
      }
      if bad < 32 {
        out.write_byte(UInt8(acc >> 32))
        out.write_byte(UInt8((acc >> 24) & 255))
        out.write_byte(UInt8((acc >> 16) & 255))
        out.write_byte(UInt8((acc >> 8) & 255))
        out.write_byte(UInt8(acc & 255))
        at += 8
        continue
      }
    }
    // the j symbols read, 5 bits each, in acc
    var acc = 0
    var dlen = 8
    var j = 0
    while j < 8 {
      if at == olen {
        if pad {
          return Err(DecodeErr{at: olen - (olen - at) - j})
        }
        dlen = j
        end = true
        break
      }
      let c = src[at]
      at += 1
      let rest = olen - at
      if pad && Int(c) == pad_byte && j >= 2 && rest < 8 {
        if rest + j < 7 {
          return Err(DecodeErr{at: olen})
        }
        for k in 0..7 - j {
          if rest > k && Int(src[at + k]) != pad_byte {
            return Err(DecodeErr{at: olen - rest + k - 1})
          }
        }
        dlen = j
        end = true
        if dlen == 1 || dlen == 3 || dlen == 6 {
          return Err(DecodeErr{at: olen - rest - 1})
        }
        break
      }
      let v = Int(tbl[Int(c)])
      if v == 255 {
        return Err(DecodeErr{at: olen - rest - 1})
      }
      acc = (acc << 5) | v
      j += 1
    }
    // Go's switch on dlen: 8, 7, 5, 4, 2 symbols give 5, 4, 3, 2, 1
    // bytes; 1, 3, and 6 (only at the end of a Raw input) give none; the
    // missing symbols are zero bits
    let count = match dlen {
      8 => 5
      7 => 4
      5 => 3
      4 => 2
      2 => 1
      _ => 0
    }
    let val = acc << (5 * (8 - j))
    for k in 0..count {
      out.write_byte(UInt8((val >> (32 - 8 * k)) & 255))
    }
  }
  out.freeze()
}

/// An encoding over an alphabet of the caller's (Go's NewEncoding, with
/// WithPadding): made by `custom`.
pub struct Encoding {
  _alphabet: Bytes
  _table: Bytes
  _pad: Int
}

/// The encoding over alphabet (32 distinct bytes, none of them `\r`, `\n`
/// or the padding), padded with `padding` (one byte, `=` as RFC 4648, or ""
/// for none: Go's WithPadding(NoPadding)). Anything else is a fault, as Go's
/// NewEncoding and WithPadding panic: a programmer error, found at start.
pub fn custom(alphabet: Str, padding: Str = "=") -> Encoding {
  let a = alphabet.bytes()
  if a.len() != 32 {
    fault("base32: encoding alphabet is not 32-bytes long")
  }
  if padding.len() > 1 {
    fault("base32: padding is not one byte")
  }
  let pad = if padding.is_empty() { -1 } else { Int(padding.bytes()[0]) }
  if pad == 13 || pad == 10 {
    fault("base32: invalid padding")
  }
  var tbl: List[Int] = List.with_capacity(256)
  for _ in 0..256 { tbl.push(255) }
  for (i, c) in a.indexed() {
    if c == 10 || c == 13 {
      fault("base32: encoding alphabet contains newline character")
    }
    if Int(c) == pad {
      fault("base32: padding contained in alphabet")
    }
    if tbl[Int(c)] != 255 {
      fault("base32: encoding alphabet includes duplicate symbols")
    }
    tbl[Int(c)] = i
  }
  var t = BytesBuilder.with_capacity(256)
  for v in tbl { t.write_byte(UInt8(v)) }
  Encoding{_alphabet: a, _table: t.freeze(), _pad: pad}
}

/// data in the encoding (Go's Encoding.EncodeToString).
pub fn (e: Encoding) encode(data: Bytes) -> Str { encode_with(data, e._alphabet, e._pad) }

/// s decoded, with `encode`'s rules for `\r`, `\n` and errors (Go's
/// Encoding.DecodeString).
pub fn (e: Encoding) decode(s: Str) -> Bytes ! DecodeErr { decode_with(s, e._table, e._pad) }
