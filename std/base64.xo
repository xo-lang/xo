// std/base64 (spec/std.md 21, decision 0279). Encoding
// rules are listed at the top of std/prelude.xo. Go's encoding/base64:
// the four alphabets of RFC 4648. Pure. `Bytes.to_base64` and
// `from_base64` (std.md 2.2) are `Std`.
//
// std/base64 on the native backends (decision 0279): Go's
// encoding/base64 ported from base64.go of go1.26 (Encode, and Decode as
// decodeQuantum does it; the 8 and 4 byte fast paths of Decode give the
// same results and are not ported), with the same output and error
// offsets. Go returns the bytes decoded before an error; Xo returns the
// error alone.

/// RFC 4648 section 4 (`Std`, `+/`) and section 5 (`Url`, `-_`); the Raw
/// forms write and read no `=` padding.
pub enum Base64 {
  Std
  Url
  RawStd
  RawUrl
}

/// Displays as Go's CorruptInputError: `illegal base64 data at input byte 4`.
pub struct DecodeErr {
  pub at: Int
}

pub fn (e: DecodeErr) display() -> Str { "illegal base64 data at input byte ${e.at}" }

pub fn encode(data: Bytes, enc: Base64 = Base64.Std) -> Str {
  // the standard alphabet with padding is Bytes.to_base64 (a word at a time
  // on the native backends, Go's encoding/base64 on the Go backend)
  if enc is Std {
    return data.to_base64()
  }
  encode_with(data, alphabet(enc), if padded(enc) { 61 } else { -1 })
}

/// encode over alphabet a, with pad the padding byte (-1: none).
fn encode_with(data: Bytes, a: Bytes, pad: Int) -> Str {
  var out = BytesBuilder.with_capacity((data.len() + 2) / 3 * 4)
  let n = data.len() / 3 * 3
  var si = 0
  while si < n {
    let v = (Int(data[si]) << 16) | (Int(data[si + 1]) << 8) | Int(data[si + 2])
    out.write_byte(a[(v >> 18) & 63])
    out.write_byte(a[(v >> 12) & 63])
    out.write_byte(a[(v >> 6) & 63])
    out.write_byte(a[v & 63])
    si += 3
  }
  let remain = data.len() - si
  if remain > 0 {
    var v = Int(data[si]) << 16
    if remain == 2 {
      v = v | (Int(data[si + 1]) << 8)
    }
    out.write_byte(a[(v >> 18) & 63])
    out.write_byte(a[(v >> 12) & 63])
    if remain == 2 {
      out.write_byte(a[(v >> 6) & 63])
      if pad >= 0 { out.write_byte(UInt8(pad)) }
    } else if pad >= 0 {
      out.write_byte(UInt8(pad))
      out.write_byte(UInt8(pad))
    }
  }
  out.freeze().to_str() ?? ""
}

/// `\r` and `\n` are skipped; anything else outside the alphabet, or
/// padding where the encoding has none, is DecodeErr at its byte offset.
pub fn decode(s: Str, enc: Base64 = Base64.Std) -> Bytes ! DecodeErr {
  // the text Bytes.from_base64 takes is the text decode accepts, with the
  // same result; its None (an error, no offset) goes on to the loop below,
  // which finds the offset
  if enc is Std {
    if let Some(b) = Bytes.from_base64(s) {
      return Ok(b)
    }
  }
  decode_with(s, if enc is Url | RawUrl { DEC_URL } else { DEC_STD }, if padded(enc) { 61 } else { -1 }, false)
}

/// decode with tbl the symbol values (255: not a symbol), pad the padding
/// byte (-1: none), and strict Go's Strict: the bits a final quantum
/// leaves over must be zero.
fn decode_with(s: Str, tbl: Bytes, pad: Int, strict: Bool) -> Bytes ! DecodeErr {
  let src = s.bytes()
  let n = src.len()
  var out = BytesBuilder.with_capacity(n / 4 * 3 + 3)
  var si = 0
  while si < n {
    // four plain symbols, the usual case (Go's decode fast path)
    if si + 4 <= n {
      let a = Int(tbl[Int(src[si])])
      let b = Int(tbl[Int(src[si + 1])])
      let c = Int(tbl[Int(src[si + 2])])
      let d = Int(tbl[Int(src[si + 3])])
      if (a | b | c | d) < 64 {
        let val = (a << 18) | (b << 12) | (c << 6) | d
        out.write_byte(UInt8(val >> 16))
        out.write_byte(UInt8((val >> 8) & 255))
        out.write_byte(UInt8(val & 255))
        si += 4
        continue
      }
    }
    // decodeQuantum: up to four symbols, skipping \r and \n; acc holds
    // the j symbols read, 6 bits each
    var acc = 0
    var dlen = 4
    var j = 0
    var stop = false
    while j < 4 {
      if si == n {
        if j == 0 {
          // only newlines after the last quantum
          dlen = 0
          break
        }
        if j == 1 || pad >= 0 {
          return Err(DecodeErr{at: si - j})
        }
        dlen = j
        break
      }
      let c = src[si]
      si += 1
      let v = Int(tbl[Int(c)])
      if v != 255 {
        acc = (acc << 6) | v
        j += 1
        continue
      }
      if is_nl(c) {
        continue
      }
      if pad < 0 || Int(c) != pad {
        return Err(DecodeErr{at: si - 1})
      }
      // padding
      if j < 2 {
        return Err(DecodeErr{at: si - 1})
      }
      if j == 2 {
        while si < n && is_nl(src[si]) { si += 1 }
        if si == n {
          return Err(DecodeErr{at: n})
        }
        if Int(src[si]) != pad {
          return Err(DecodeErr{at: si - 1})
        }
        si += 1
      }
      while si < n && is_nl(src[si]) { si += 1 }
      if si < n {
        stop = true
      }
      dlen = j
      break
    }
    // the missing symbols are zero bits
    let val = acc << (6 * (4 - j))
    // Go's Strict: the bits past the last whole byte must be zero
    if strict && dlen == 3 && (val & 255) != 0 {
      return Err(DecodeErr{at: si - 1})
    }
    if strict && dlen == 2 && (val & 65535) != 0 {
      return Err(DecodeErr{at: si - 2})
    }
    if dlen >= 2 { out.write_byte(UInt8((val >> 16) & 255)) }
    if dlen >= 3 { out.write_byte(UInt8((val >> 8) & 255)) }
    if dlen == 4 { out.write_byte(UInt8(val & 255)) }
    if stop {
      return Err(DecodeErr{at: si})
    }
  }
  out.freeze()
}

/// An encoding over an alphabet of the caller's (Go's NewEncoding, with
/// WithPadding and Strict), made by `custom` or `of`.
pub struct Encoding {
  _alphabet: Bytes
  _table: Bytes
  _pad: Int
  _strict: Bool
}

/// The encoding of a 64 byte alphabet (Go's NewEncoding) padded with
/// `padding`, one byte, or none for "" (WithPadding(NoPadding)). An
/// alphabet that is not 64 bytes, holds `\r`, `\n` or a byte twice, or
/// holds the padding, and a padding of `\r`, `\n` or more than one byte,
/// fault with Go's panic text: a programmer error, found at start.
pub fn custom(alphabet: Str, padding: Str = "=") -> Encoding {
  let a = alphabet.bytes()
  if a.len() != 64 {
    fault("base64: encoding alphabet is not 64-bytes long")
  }
  if padding.len() > 1 {
    fault("base64: padding is not one byte")
  }
  let pad = if padding.is_empty() { -1 } else { Int(padding.bytes()[0]) }
  if pad == 13 || pad == 10 {
    fault("base64: invalid padding")
  }
  var tbl: List[Int] = List.with_capacity(256)
  for _ in 0..256 { tbl.push(255) }
  for (i, c) in a.indexed() {
    if c == 10 || c == 13 {
      fault("base64: encoding alphabet contains newline character")
    }
    if tbl[Int(c)] != 255 {
      fault("base64: encoding alphabet includes duplicate symbols")
    }
    tbl[Int(c)] = i
  }
  if pad >= 0 && tbl[pad] != 255 {
    fault("base64: padding contained in alphabet")
  }
  var t = BytesBuilder.with_capacity(256)
  for v in tbl { t.write_byte(UInt8(v)) }
  Encoding{_alphabet: a, _table: t.freeze(), _pad: pad, _strict: false}
}

/// One of the four RFC 4648 encodings as an Encoding (Go's StdEncoding,
/// URLEncoding, RawStdEncoding, RawURLEncoding), to make strict.
pub fn of(enc: Base64) -> Encoding {
  Encoding{_alphabet: alphabet(enc), _table: if enc is Url | RawUrl { DEC_URL } else { DEC_STD }, _pad: if padded(enc) { 61 } else { -1 }, _strict: false}
}

/// The same encoding decoding strictly (Go's Encoding.Strict): a final
/// quantum whose unused bits are not zero is DecodeErr, so each text has
/// one decoding (`\r` and `\n` are still skipped).
pub fn (e: Encoding) strict() -> Encoding { Encoding{_alphabet: e._alphabet, _table: e._table, _pad: e._pad, _strict: true} }

/// data in the encoding (Go's Encoding.EncodeToString).
pub fn (e: Encoding) encode(data: Bytes) -> Str { encode_with(data, e._alphabet, e._pad) }

/// The bytes of s in the encoding, skipping `\r` and `\n` (Go's
/// Encoding.DecodeString).
pub fn (e: Encoding) decode(s: Str) -> Bytes ! DecodeErr { decode_with(s, e._table, e._pad, e._strict) }

const STD: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

const URL: Str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

fn alphabet(enc: Base64) -> Bytes {
  match enc {
    Std => STD.bytes()
    RawStd => STD.bytes()
    Url => URL.bytes()
    RawUrl => URL.bytes()
  }
}

fn padded(enc: Base64) -> Bool { enc is Std | Url }

/// The value of each byte in the alphabet, or 255 (also for `=` and the
/// newlines, which decode handles itself).
const DEC_STD: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x3e\xff\xff\xff\x3f\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\xff\xff\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

const DEC_URL: Bytes = b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\x3e\xff\xff\x34\x35\x36\x37\x38\x39\x3a\x3b\x3c\x3d\xff\xff\xff\xff\xff\xff\xff\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\xff\xff\xff\xff\x3f\xff\x1a\x1b\x1c\x1d\x1e\x1f\x20\x21\x22\x23\x24\x25\x26\x27\x28\x29\x2a\x2b\x2c\x2d\x2e\x2f\x30\x31\x32\x33\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"

fn is_nl(c: UInt8) -> Bool { c == 10 || c == 13 }
