use std/amqp
fn text(m: amqp.Message) -> Str {
  match m.body {
    Data(sections) => (sections[0]).to_str_lossy()
    _ => "?"
  }
}

fn msg(t: Str) -> amqp.Message { amqp.Message{body: amqp.Body.Data(sections: [t.bytes()])} }

fn opts(clk: Clock[clock]) -> amqp.ConnOptions {
  amqp.ConnOptions{container_id: "tester", clock: Some(clk), sasl: amqp.Sasl.Anonymous, timeout_ms: 5000}
}

/// Waits for `cond` to hold, up to two seconds.
fn until(clk: Clock, cond: fn() -> Bool uses (clock, sync)) uses clock {
  for _ in 0..400 {
    if cond() { return }
    clk.sleep(5ms)
  }
  fault("condition not reached")
}

/// The lock token of a delivery, from its delivery annotations (where Go's azservicebus reads it).
fn token_of(d: amqp.Delivery) -> Bytes {
  for (k, v) in d.message.delivery_annotations ?? [] {
    match (k, v) {
      (Symbol(n), Uuid(bs)) => { if n == "x-opt-lock-token" { return bs } }
      _ => {}
    }
  }
  b""
}

/// A tag in .NET GUID order: the first three groups reversed.
fn guid_swap(t: Bytes) -> Bytes {
  Bytes.from_hex(t[3..4].to_hex() + t[2..3].to_hex() + t[1..2].to_hex() + t[0..1].to_hex() + t[5..6].to_hex() + t[4..5].to_hex() + t[7..8].to_hex() + t[6..7].to_hex() + t[8..16].to_hex()) ?? b""
}

struct Mgmt {
  snd: amqp.Sender
  rcv: amqp.Receiver
}

fn mgmt_open(c: amqp.Connection, sess: amqp.Session, entity: Str) -> Mgmt uses (net, clock) {
  let snd = c.new_sender(sess, entity + "/$management", amqp.SenderOptions{name: "mgmt-s"}).or_fault("mgmt sender")
  let rcv = c.new_receiver(sess, entity + "/$management", amqp.ReceiverOptions{name: "mgmt-r", target: "client-reply", credit: 5}).or_fault("mgmt receiver")
  Mgmt{snd: snd, rcv: rcv}
}

fn mgmt_call(m: Mgmt, op: Str, body: amqp.Value) -> amqp.Message ! amqp.AmqpErr uses (net, clock) {
  let req = amqp.Message{
    properties: Some(amqp.Properties{message_id: amqp.Value.Str(v: "req-${op}"), reply_to: Some("client-reply")}),
    app_properties: Some([("operation", amqp.Value.Str(v: "com.microsoft:" + op))]),
    body: amqp.Body.Value(v: body)}
  m.snd.send(req)?
  let d = m.rcv.receive(2000)?
  m.rcv.accept(d)?
  Ok(d.message)
}

fn status(m: amqp.Message) -> Int {
  for (k, v) in m.app_properties ?? [] {
    if k == "statusCode" {
      match v {
        Int(x) => { return Int(x) }
        _ => {}
      }
    }
  }
  -1
}

fn cond(m: amqp.Message) -> Str {
  for (k, v) in m.app_properties ?? [] {
    if k == "errorCondition" {
      match v {
        Str(x) => { return x }
        _ => {}
      }
    }
  }
  ""
}

fn body_map(m: amqp.Message) -> List[(amqp.Value, amqp.Value)] {
  match m.body {
    Value(Map(ps)) => ps
    _ => []
  }
}

fn key(ps: List[(amqp.Value, amqp.Value)], k: Str) -> amqp.Value {
  for (a, b) in ps {
    if a == amqp.Value.Str(v: k) { return b }
  }
  amqp.Value.Null
}

fn dial_broker(n: Net, clk: Clock[clock], l: Listener) -> amqp.Connection uses (net, clock) {
  amqp.dial(n, l.addr(), opts(clk)).or_fault("dial")
}

test "send, receive and complete through the broker, with CBS" uses (net, clock) {
  let b = new(os.clock)
  b.queue("orders")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    amqp.cbs_put_token(c, sess, "sb://ns/orders", "tok-1").or_fault("put-token")
    expect(b.tokens()) == [("sb://ns/orders", "tok-1")]
    let snd = c.new_sender(sess, "orders").or_fault("sender")
    expect(snd.send(msg("one")).or_fault("send")) == Some(amqp.DeliveryState.Accepted)
    expect(b.ready("orders").len()) == 1
    let rcv = c.new_receiver(sess, "orders", amqp.ReceiverOptions{credit: 5}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    expect(text(d.message)) == "one"
    expect(d.tag.len()) == 16
    expect(guid_swap(d.tag)) == token_of(d)
    expect(d.tag != token_of(d)) == true
    expect(b.locked("orders")) == 1
    rcv.accept(d).or_fault("accept")
    until(os.clock, fn() -> Bool { b.locked("orders") == 0 && b.ready("orders").len() == 0 })
    rcv.close().or_fault("close receiver")
    snd.close().or_fault("close sender")
    c.end_session(sess).or_fault("end")
    c.close().or_fault("close")
  }
}

test "a sender gets more link credit as it spends it (amqp stress hang, task #152)" uses (net, clock) {
  // the broker granted 100,000 once and never again: the amqp stress
  // program's senders waited for credit forever past their 100,000th send
  let b = new(os.clock)
  b.st.with(fn(var x) { x.link_credit = 6 })
  b.queue("q")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let snd = c.new_sender(sess, "q").or_fault("sender")
    s.spawn_background(fn() {
      for i in 0..20 {
        snd.send(msg("m${i}")).or_fault("send")
      }
    })
    until(os.clock, fn() -> Bool { b.ready("q").len() == 20 })
    s.cancel()
  }
}

// The reader task can apply a send's disposition right after the write of
// its last frame, before send's turn ends: the outcome must still reach
// send (it was dropped, and send waited forever, 2026-11-06). The race
// needs a loaded machine, so this rarely fails on the old code; see
// gotchas/reader-task-applies-reply-between-locks.md.
test "every unsettled send gets its outcome with the reader task running" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let snd = c.new_sender(sess, "q").or_fault("sender")
    for i in 0..30 {
      expect(snd.send(msg("m${i}")).or_fault("send")) == Some(amqp.DeliveryState.Accepted)
    }
    expect(b.ready("q").len()) == 30
    c.close().or_fault("close")
  }
}

test "abandon redelivers, reject and the delivery limit dead letter" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{max_delivery_count: 2})
  b.put("q", msg("a"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let a1 = rcv.receive(2000).or_fault("receive a")
    expect(text(a1.message)) == "a"
    rcv.modify(a1).or_fault("abandon")
    let a2 = rcv.receive(2000).or_fault("receive a again")
    expect(text(a2.message)) == "a"
    rcv.modify(a2).or_fault("abandon again")
    // two deliveries used: a is dead lettered
    until(os.clock, fn() -> Bool { b.dead_letters("q").len() == 1 && b.ready("q").len() == 0 })
    b.put("q", msg("b"))
    let b1 = rcv.receive(2000).or_fault("receive b")
    expect(text(b1.message)) == "b"
    rcv.reject(b1, Some(amqp.WireError{condition: "my-reason", description: "bad"})).or_fault("reject")
    until(os.clock, fn() -> Bool { b.dead_letters("q").len() == 2 })
    expect(text(b.dead_letters("q")[0])) == "a"
    c.close().or_fault("close")
  }
}

fn app_prop(m: amqp.Message, k: Str) -> Str {
  for (n, v) in m.app_properties ?? [] {
    match v {
      Str(x) => { if n == k { return x } }
      _ => {}
    }
  }
  "-"
}

// A lock that runs out is a delivery attempt: past the maximum the message is dead lettered, as
// Service Bus does, not delivered again (TestAmqptestFuzz, 2026-11-16).
test "a lock that runs out past the delivery limit dead letters" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{max_delivery_count: 2, lock_ms: 50})
  b.put("q", msg("a"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let a1 = rcv.receive(2000).or_fault("receive a")
    expect(text(a1.message)) == "a"
    os.clock.sleep(80ms)
    let a2 = rcv.receive(2000).or_fault("receive a again")
    expect(text(a2.message)) == "a"
    os.clock.sleep(80ms)
    // two deliveries used and the second lock ran out: a is dead lettered
    expect(b.ready("q").len()) == 0
    expect(b.dead_letters("q").len()) == 1
    expect(app_prop(b.dead_letters("q")[0], "DeadLetterReason")) == "MaxDeliveryCountExceeded"
    c.close().or_fault("close")
  }
}

// When a lock runs out the message goes to a receiver that waits, under a new lock; the old
// delivery's lock is lost (it was never delivered again, and with that fixed its settle was
// accepted: TestAmqptestFuzz, 2026-11-16).
test "a lock that runs out redelivers to a waiting receiver, and the old delivery is lock lost" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 100})
  b.put("q", msg("a"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 2, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver")
    let d1 = rcv.receive(2000).or_fault("receive a")
    let d2 = rcv.receive(2000).or_fault("receive a again after its lock ran out")
    expect(text(d2.message)) == "a"
    expect(d2.message.header.or_fault("header").delivery_count) == 1
    match rcv.accept(d1) {
      Ok(_) => fault("the old delivery's settle was accepted")
      Err(e) => {
        match e {
          Peer(w) => expect(w.condition) == "com.microsoft:message-lock-lost"
          _ => fault("wrong error")
        }
      }
    }
    rcv.accept(d2).or_fault("accept the new delivery")
    until(os.clock, fn() -> Bool { b.ready("q").len() == 0 && b.locked("q") == 0 })
    c.close().or_fault("close")
  }
}

/// The real clock moved forward by jumps: a lock runs out before the broker's timer wakes.
struct JumpClock {
  base: Clock
  ms: Mutex[Int]
}

fn (c: JumpClock) now() -> Time uses clock { c.base.now() + Duration.from_millis(c.ms.with_read(fn(n: Int) -> Int { n })) }
fn (c: JumpClock) sleep(d: Duration) uses clock { c.base.sleep(d) }
fn (c: JumpClock) sleep_or_cancel(d: Duration) -> () ! ClockErr uses clock { c.base.sleep_or_cancel(d) }
fn (c: JumpClock) since(t: Time) -> Duration uses clock { c.now() - t }

// A lock that ran out counted as a delivery; closing the receiver after that gave the message
// back uncounted, as if it had not been delivered (TestAmqptestFuzz, 2026-11-16).
test "closing a receiver after its lock ran out keeps the delivery counted" uses (net, clock) {
  let clk = JumpClock{base: os.clock, ms: Mutex[Int].new(0)}
  let b = new(clk)
  b.queue("q", QueueOptions{max_delivery_count: 2})
  b.put("q", msg("a"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let r1 = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver 1")
    let d1 = r1.receive(2000).or_fault("receive a")
    expect(d1.message.header.or_fault("header").delivery_count) == 0
    clk.ms.with(fn(var n: Int) { n += 61000 })
    r1.close().or_fault("close receiver 1")
    let r2 = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver 2")
    let d2 = r2.receive(2000).or_fault("receive a again")
    expect(d2.message.header.or_fault("header").delivery_count) == 1
    // and its lock running out too reaches the limit of 2
    clk.ms.with(fn(var n: Int) { n += 61000 })
    r2.close().or_fault("close receiver 2")
    expect(b.ready("q").len()) == 0
    expect(app_prop(b.dead_letters("q")[0], "DeadLetterReason")) == "MaxDeliveryCountExceeded"
    c.close().or_fault("close")
  }
}

// A receiver's credit tops up to its target less the deliveries it holds untaken: it granted the
// whole target on each receive, so its prefetch grew without bound and the broker's locks ran out in
// it (TestAmqptestFuzz's stress, 2026-11-16).
test "a receiver's prefetch stays within its credit" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  for i in 0..100 { b.put("q", msg("m${i}")) }
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 4, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver")
    for i in 0..20 {
      let d = rcv.receive(2000).or_fault("receive")
      expect(text(d.message)) == "m${i}"
      rcv.accept(d).or_fault("accept")
      // what the broker has locked is what the receiver holds or may still get
      expect(b.locked("q") <= 4) == true
    }
    c.close().or_fault("close")
  }
}

// Go's azservicebus dead letters with the condition com.microsoft:dead-letter and the reason in the
// error's info, and reads the reason from the dead lettered message's application properties
// (TestAmqptestFuzz, 2026-11-16).
test "a dead letter's reason as azservicebus sends and reads it" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  b.put("q", msg("a"))
  b.put("q", msg("b"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let a = rcv.receive(2000).or_fault("receive a")
    rcv.reject(a, Some(amqp.WireError{condition: "com.microsoft:dead-letter", info: [("DeadLetterReason", amqp.Value.Str(v: "why")), ("DeadLetterErrorDescription", amqp.Value.Str(v: "because")), ("extra", amqp.Value.Str(v: "x"))]})).or_fault("dead letter a")
    let d = rcv.receive(2000).or_fault("receive b")
    rcv.reject(d, Some(amqp.WireError{condition: "my-reason", description: "bad"})).or_fault("reject b")
    until(os.clock, fn() -> Bool { b.dead_letters("q").len() == 2 })
    let dl = b.dead_letters("q")
    expect((app_prop(dl[0], "DeadLetterReason"), app_prop(dl[0], "DeadLetterErrorDescription"), app_prop(dl[0], "extra"))) == ("why", "because", "x")
    expect((app_prop(dl[1], "DeadLetterReason"), app_prop(dl[1], "DeadLetterErrorDescription"))) == ("my-reason", "bad")
    // and a receiver of the dead letter queue sees them
    let dq = c.new_receiver(sess, "q/$DeadLetterQueue", amqp.ReceiverOptions{credit: 1}).or_fault("dlq receiver")
    let x = dq.receive(2000).or_fault("receive the dead letter")
    expect(app_prop(x.message, "DeadLetterReason")) == "why"
    c.close().or_fault("close")
  }
}

test "management: renew-lock, peek, schedule and cancel" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 300})
  b.put("q", msg("m1"))
  b.put("q", msg("m2"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let mg = mgmt_open(c, sess, "q")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    // renew the lock before it runs out, twice, while a receive waits on another link
    for _ in 0..2 {
      os.clock.sleep(200ms)
      let r = mgmt_call(mg, "renew-lock", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "lock-tokens"), amqp.Value.Array(items: [amqp.Value.Uuid(bytes: token_of(d))]))])).or_fault("renew")
      expect(status(r)) == 200
    }
    expect(b.locked("q")) == 1
    // peek sees both, locked or not
    let p = mgmt_call(mg, "peek-message", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "from-sequence-number"), amqp.Value.Long(v: Int64(0))), (amqp.Value.Str(v: "message-count"), amqp.Value.Int(v: Int32(10)))])).or_fault("peek")
    expect(status(p)) == 200
    match key(body_map(p), "messages") {
      List(items) => expect(items.len()) == 2
      _ => fault("no messages")
    }
    // schedule one for an hour from now, then cancel it
    let when = os.clock.now().unix_millis() + 3600000
    let sched = amqp.encode_message(amqp.Message{
      annotations: Some([(amqp.Value.Symbol(v: "x-opt-scheduled-enqueue-time"), amqp.Value.Timestamp(ms: when))]),
      body: amqp.Body.Data(sections: [b"later"])}).or_fault("encode")
    let sr = mgmt_call(mg, "schedule-message", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "messages"), amqp.Value.List(items: [amqp.Value.Map(pairs: [(amqp.Value.Str(v: "message"), amqp.Value.Binary(v: sched))])]))])).or_fault("schedule")
    expect(status(sr)) == 200
    expect(b.scheduled("q").len()) == 1
    let seqs = key(body_map(sr), "sequence-numbers")
    let cr = mgmt_call(mg, "cancel-scheduled-message", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "sequence-numbers"), seqs)])).or_fault("cancel")
    expect(status(cr)) == 200
    expect(b.scheduled("q").len()) == 0
    c.close().or_fault("close")
  }
}

test "an expired lock returns the message and a stale renew is lock lost" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 100})
  b.put("q", msg("x"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let mg = mgmt_open(c, sess, "q")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    os.clock.sleep(250ms)
    expect(b.ready("q").len()) == 1
    let r = mgmt_call(mg, "renew-lock", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "lock-tokens"), amqp.Value.Array(items: [amqp.Value.Uuid(bytes: token_of(d))]))])).or_fault("renew")
    expect(status(r)) == 410
    expect(cond(r)) == "com.microsoft:message-lock-lost"
    c.close().or_fault("close")
  }
}

test "receive and delete, and a topic fans out to subscriptions" uses (net, clock) {
  let b = new(os.clock)
  b.topic("events")
  b.subscription("events", "s1")
  b.subscription("events", "s2")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let snd = c.new_sender(sess, "events").or_fault("sender")
    expect(snd.send(msg("hello")).or_fault("send")) == Some(amqp.DeliveryState.Accepted)
    expect(b.ready("events/Subscriptions/s1").len()) == 1
    expect(b.ready("events/Subscriptions/s2").len()) == 1
    let rcv = c.new_receiver(sess, "events/Subscriptions/s1", amqp.ReceiverOptions{credit: 2, sender_settle_mode: Some(amqp.SenderSettleMode.Settled)}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    expect(text(d.message)) == "hello"
    expect(d.settled) == true
    expect(b.ready("events/Subscriptions/s1").len()) == 0
    expect(b.locked("events/Subscriptions/s1")) == 0
    expect(b.ready("events/Subscriptions/s2").len()) == 1
    c.close().or_fault("close")
  }
}

test "defer, receive by sequence number and update disposition" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  b.put("q", msg("later"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let mg = mgmt_open(c, sess, "q")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    var seq = 0
    match d.message.annotations {
      Some(ps) => {
        for (k, v) in ps {
          if k == amqp.Value.Symbol(v: "x-opt-sequence-number") {
            match v {
              Long(x) => { seq = Int(x) }
              _ => {}
            }
          }
        }
      }
      None => {}
    }
    expect(seq > 0) == true
    rcv.modify(d, false, true).or_fault("defer")
    until(os.clock, fn() -> Bool { b.deferred("q").len() == 1 })
    let r = mgmt_call(mg, "receive-by-sequence-number", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "sequence-numbers"), amqp.Value.Array(items: [amqp.Value.Long(v: Int64(seq))]))])).or_fault("receive deferred")
    expect(status(r)) == 200
    var lock = b""
    match key(body_map(r), "messages") {
      List(items) => {
        match items[0] {
          Map(ps) => {
            match key(ps, "lock-token") {
              Uuid(bs) => { lock = bs }
              _ => {}
            }
          }
          _ => {}
        }
      }
      _ => {}
    }
    expect(lock.len()) == 16
    let u = mgmt_call(mg, "update-disposition", amqp.Value.Map(pairs: [
      (amqp.Value.Str(v: "disposition-status"), amqp.Value.Str(v: "completed")),
      (amqp.Value.Str(v: "lock-tokens"), amqp.Value.Array(items: [amqp.Value.Uuid(bytes: lock)]))])).or_fault("update")
    expect(status(u)) == 200
    expect(b.deferred("q").len()) == 0
    c.close().or_fault("close")
  }
}

test "session queues, session state and the session lock" uses (net, clock) {
  let b = new(os.clock)
  b.queue("sq", QueueOptions{sessions: true})
  b.put("sq", amqp.Message{properties: Some(amqp.Properties{group_id: Some("s-a")}), body: amqp.Body.Data(sections: [b"a1"])})
  b.put("sq", amqp.Message{properties: Some(amqp.Properties{group_id: Some("s-b")}), body: amqp.Body.Data(sections: [b"b1"])})
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let filter = ("com.microsoft:session-filter", amqp.Value.Described(descriptor: amqp.Value.Symbol(v: "com.microsoft:session-filter"), value: amqp.Value.Str(v: "s-b")))
    let rcv = c.new_receiver(sess, "sq", amqp.ReceiverOptions{credit: 5, filters: [filter]}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    expect(text(d.message)) == "b1"
    // the session is locked by this connection: a second receiver for it times out
    let c2 = dial_broker(os.net, os.clock, l)
    c2.keepalive(s.group()).or_fault("keepalive 2")
    let sess2 = c2.begin().or_fault("begin 2")
    match c2.new_receiver(sess2, "sq", amqp.ReceiverOptions{credit: 1, filters: [filter]}) {
      Ok(_) => fault("the session is locked")
      Err(Peer(e)) => expect(e.condition) == "com.microsoft:timeout"
      Err(_) => fault("wrong error")
    }
    let mg = mgmt_open(c, sess, "sq")
    let set = mgmt_call(mg, "set-session-state", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "session-id"), amqp.Value.Str(v: "s-b")), (amqp.Value.Str(v: "session-state"), amqp.Value.Binary(v: b"state-1"))])).or_fault("set state")
    expect(status(set)) == 200
    expect(b.session_state("sq", "s-b")) == b"state-1"
    let got = mgmt_call(mg, "get-session-state", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "session-id"), amqp.Value.Str(v: "s-b"))])).or_fault("get state")
    expect(key(body_map(got), "session-state")) == amqp.Value.Binary(v: b"state-1")
    let ren = mgmt_call(mg, "renew-session-lock", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "session-id"), amqp.Value.Str(v: "s-b"))])).or_fault("renew session")
    expect(status(ren)) == 200
    c2.close().or_fault("close 2")
    c.close().or_fault("close")
  }
}

test "faults: unknown entity, missing token, injected errors, forced detach and close" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    match c.new_receiver(sess, "nope", amqp.ReceiverOptions{credit: 1}) {
      Ok(_) => fault("unknown entity")
      Err(Peer(e)) => expect(e.condition) == "amqp:not-found"
      Err(_) => fault("wrong error")
    }
    b.require_token(true)
    match c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}) {
      Ok(_) => fault("no token")
      Err(Peer(e)) => expect(e.condition) == "amqp:unauthorized-access"
      Err(_) => fault("wrong error")
    }
    amqp.cbs_put_token(c, sess, "sb://ns/q", "tok").or_fault("put-token")
    // a fresh token on the same $cbs link is accepted again
    amqp.cbs_put_token(c, sess, "sb://ns/q", "tok-2").or_fault("refresh")
    expect(b.tokens().len()) == 2
    b.fail_next("attach", 0, "com.microsoft:server-busy", "busy")
    match c.new_sender(sess, "q") {
      Ok(_) => fault("injected attach failure")
      Err(Peer(e)) => expect(e.condition) == "com.microsoft:server-busy"
      Err(_) => fault("wrong error")
    }
    let snd = c.new_sender(sess, "q").or_fault("sender")
    b.fail_next("transfer", 0, "amqp:resource-limit-exceeded", "full")
    expect(snd.send(msg("x")).or_fault("send")) == Some(amqp.DeliveryState.Rejected(error: Some(amqp.WireError{condition: "amqp:resource-limit-exceeded", description: "full"})))
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    b.detach_links("q", amqp.WireError{condition: "amqp:link:detach-forced", description: "forced"})
    match rcv.receive(2000) {
      Ok(_) => fault("detached")
      Err(Peer(e)) => expect(e.condition) == "amqp:link:detach-forced"
      Err(_) => fault("wrong error")
    }
    b.disconnect_all(Some(amqp.WireError{condition: "amqp:connection:forced", description: "bye"}))
    match c.begin() {
      Ok(_) => fault("closed")
      Err(_) => {}
    }
  }
}

/// The next frame of the connection with a body of interest (others are skipped).
fn raw_until(c: amqp.Connection, want: fn(amqp.FrameBody) -> Bool) -> amqp.FrameBody uses (net, clock) {
  for _ in 0..50 {
    let f = c.recv().or_fault("recv")
    if want(f.body) { return f.body }
  }
  fault("frame not seen")
}

fn is_attach(b: amqp.FrameBody) -> Bool {
  match b {
    Attach(_) => true
    _ => false
  }
}

test "raw links: a null session filter takes the next session and the attach says which" uses (net, clock) {
  let b = new(os.clock)
  b.queue("sq", QueueOptions{sessions: true, lock_ms: 5000})
  b.put("sq", amqp.Message{properties: Some(amqp.Properties{group_id: Some("s-a")}), body: amqp.Body.Data(sections: [b"a1"])})
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    let sess = c.begin().or_fault("begin")
    let key = "com.microsoft:session-filter"
    c.send(amqp.Frame{channel: UInt16.wrapping_from(sess.channel), body: amqp.FrameBody.Attach(v: amqp.Attach{
      name: "raw", handle: UInt32(0), role: amqp.Role.Receiver, sender_settle_mode: None, receiver_settle_mode: None,
      source: Some(amqp.Source{address: "sq", filter: [(key, amqp.Value.Described(descriptor: amqp.Value.Symbol(v: key), value: amqp.Value.Null))]}),
      target: Some(amqp.Target{address: "client"})})}).or_fault("attach")
    match raw_until(c, is_attach) {
      Attach(a) => {
        match a.source {
          Some(src) => expect(src.filter[0].1) == amqp.Value.Described(descriptor: amqp.Value.Symbol(v: key), value: amqp.Value.Str(v: "s-a"))
          None => fault("no source")
        }
        var seen = false
        for (k, v) in a.properties {
          if k == "com.microsoft:locked-until-utc" {
            match v {
              Timestamp(ms) => { seen = ms > os.clock.now().unix_millis() }
              _ => {}
            }
          }
        }
        expect(seen) == true
      }
      _ => fault("no attach")
    }
    c.abort()
  }
}

test "raw links: a batch is unpacked and a drain gives up the credit" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    let sess = c.begin().or_fault("begin")
    let ch = UInt16.wrapping_from(sess.channel)
    c.send(amqp.Frame{channel: ch, body: amqp.FrameBody.Attach(v: amqp.Attach{
      name: "snd", handle: UInt32(0), role: amqp.Role.Sender, sender_settle_mode: None, receiver_settle_mode: None,
      source: Some(amqp.Source{address: "client"}), target: Some(amqp.Target{address: "q"})})}).or_fault("attach sender")
    let _ = raw_until(c, is_attach)
    let m1 = amqp.encode_message(msg("one")).or_fault("enc 1")
    let m2 = amqp.encode_message(msg("two")).or_fault("enc 2")
    let batch = amqp.encode_message(amqp.Message{body: amqp.Body.Data(sections: [m1, m2])}).or_fault("enc batch")
    c.send(amqp.Frame{channel: ch, body: amqp.FrameBody.Transfer(v: amqp.Transfer{handle: UInt32(0), delivery_id: Some(UInt32(0)), delivery_tag: b"t",
      message_format: Some(UInt32.wrapping_from(2147563264)), receiver_settle_mode: None, state: None, payload: batch})}).or_fault("transfer")
    let d = raw_until(c, fn(x: amqp.FrameBody) -> Bool {
      match x {
        Disposition(_) => true
        _ => false
      }
    })
    match d {
      Disposition(x) => expect(x.state) == Some(amqp.DeliveryState.Accepted)
      _ => fault("no disposition")
    }
    expect(b.ready("q").len()) == 2
    // a receiver with credit 5 and one message ready: one comes, the drain gives the rest up
    b.queue("one")
    b.put("one", msg("only"))
    c.send(amqp.Frame{channel: ch, body: amqp.FrameBody.Attach(v: amqp.Attach{
      name: "rcv", handle: UInt32(1), role: amqp.Role.Receiver, sender_settle_mode: None, receiver_settle_mode: None,
      source: Some(amqp.Source{address: "one"}), target: Some(amqp.Target{address: "client"})})}).or_fault("attach receiver")
    let _ = raw_until(c, is_attach)
    c.send(amqp.Frame{channel: ch, body: amqp.FrameBody.Flow(v: amqp.Flow{next_incoming_id: Some(UInt32(0)), incoming_window: UInt32(100), next_outgoing_id: UInt32(1),
      outgoing_window: UInt32(100), handle: Some(UInt32(1)), delivery_count: Some(UInt32(0)), link_credit: Some(UInt32(5)), available: None, drain: true})}).or_fault("flow")
    var transfers = 0
    var drained = false
    for _ in 0..20 {
      if drained { break }
      let f = c.recv().or_fault("recv")
      match f.body {
        Transfer(_) => { transfers += 1 }
        Flow(x) => {
          if x.drain && x.link_credit == Some(UInt32(0)) {
            drained = true
            expect(x.delivery_count) == Some(UInt32(5))
          }
        }
        _ => {}
      }
    }
    expect(transfers) == 1
    expect(drained) == true
    c.abort()
  }
}

test "a scheduled message appears at its time on the broker's clock" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  let at = os.clock.now().unix_millis() + 200
  b.put("q", amqp.Message{annotations: Some([(amqp.Value.Symbol(v: "x-opt-scheduled-enqueue-time"), amqp.Value.Timestamp(ms: at))]), body: amqp.Body.Data(sections: [b"soon"])})
  expect(b.ready("q").len()) == 0
  expect(b.scheduled("q").len()) == 1
  os.clock.sleep(350ms)
  expect(b.ready("q").len()) == 1
  expect(b.scheduled("q").len()) == 0
}

test "receive on an empty queue times out in the test world" {
  let b = new(os.clock)
  b.queue("q")
  let l = os.net.listen("broker.example.test:5672").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = amqp.dial(os.net, "broker.example.test:5672", amqp.ConnOptions{container_id: "t", clock: Some(os.clock), sasl: amqp.Sasl.Anonymous, timeout_ms: 5000}).or_fault("dial")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q").or_fault("receiver")
    match rcv.receive(20) {
      Ok(_) => fault("a message from an empty queue")
      Err(e) => {
        match e {
          Net(m) => expect(m.contains("timeout")) == true
          _ => fault("wrong error")
        }
      }
    }
    c.close().or_fault("close")
  }
}

test "Sender.send with a message format sends a Service Bus batch as one transfer" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let snd = c.new_sender(sess, "q").or_fault("sender")
    let m1 = amqp.encode_message(msg("one")).or_fault("enc 1")
    let m2 = amqp.encode_message(msg("two")).or_fault("enc 2")
    let batch = amqp.Message{body: amqp.Body.Data(sections: [m1, m2])}
    expect(snd.send(batch, message_format: 2147563264).or_fault("send")) == Some(amqp.DeliveryState.Accepted)
    expect(b.ready("q").len()) == 2
    snd.close().or_fault("close sender")
    c.end_session(sess).or_fault("end")
    c.close().or_fault("close")
  }
}

test "manual credit: issue_credit grants exactly that much and drain leaves nothing locked" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  for t in ["a", "b", "c"] { b.put("q", msg(t)) }
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 0}).or_fault("receiver")
    rcv.issue_credit(2).or_fault("credit")
    let d1 = rcv.receive(2000).or_fault("receive 1")
    let d2 = rcv.receive(2000).or_fault("receive 2")
    expect([text(d1.message), text(d2.message)]) == ["a", "b"]
    rcv.accept(d1).or_fault("accept 1")
    rcv.accept(d2).or_fault("accept 2")
    // no credit left: the third message stays on the broker, and the drain gives back no delivery
    expect(rcv.drain(2000).or_fault("drain").len()) == 0
    until(os.clock, fn() -> Bool { b.ready("q").len() == 1 && b.locked("q") == 0 })
    // credit 5 for one message ready: it arrives, the drain returns it and nothing else is locked
    rcv.issue_credit(5).or_fault("credit 5")
    until(os.clock, fn() -> Bool { b.locked("q") == 1 })
    let got = rcv.drain(2000).or_fault("drain 2")
    expect(got.len()) == 1
    expect(text(got[0].message)) == "c"
    rcv.accept(got[0]).or_fault("accept 3")
    rcv.close().or_fault("close receiver")
    c.end_session(sess).or_fault("end")
    c.close().or_fault("close")
  }
}

test "settle mode Second: accept waits for the peer, a lost lock is reported, modify carries annotations" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 100})
  b.put("q", msg("x"))
  b.put("q", msg("y"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 2, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver")
    let d1 = rcv.receive(2000).or_fault("receive 1")
    let d2 = rcv.receive(2000).or_fault("receive 2")
    // a good accept returns after the broker settled it, so the queue is already updated
    rcv.accept(d1).or_fault("accept")
    expect(b.locked("q")) == 1
    os.clock.sleep(250ms)
    match rcv.modify(d2, annotations: [("x-opt-note", amqp.Value.Str(v: "n"))]) {
      Ok(_) => fault("a lost lock was accepted")
      Err(e) => {
        match e {
          Peer(w) => expect(w.condition) == "com.microsoft:message-lock-lost"
          _ => fault("wrong error")
        }
      }
    }
    c.close().or_fault("close")
  }
}

test "settle mode Second: a dead letter is settled without an error, so reject succeeds" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 5000})
  b.put("q", msg("x"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1, settle_mode: Some(amqp.ReceiverSettleMode.Second)}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    rcv.reject(d, Some(amqp.WireError{condition: "com.microsoft:dead-letter", description: "why"})).or_fault("dead letter")
    expect(b.dead_letters("q").len()) == 1
    expect(b.locked("q")) == 0
    c.close().or_fault("close")
  }
}

test "a Modified outcome's annotations land in the message's application properties" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q", QueueOptions{lock_ms: 5000})
  b.put("q", msg("x"))
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let rcv = c.new_receiver(sess, "q", amqp.ReceiverOptions{credit: 1}).or_fault("receiver")
    let d = rcv.receive(2000).or_fault("receive")
    rcv.modify(d, annotations: [("note", amqp.Value.Str(v: "n1"))]).or_fault("modify")
    c.close().or_fault("close")
  }
  let ready = b.ready("q")
  expect(ready.len()) == 1
  expect(ready[0].app_properties ?? []) == [("note", amqp.Value.Str(v: "n1"))]
}

test "get-message-sessions lists the sessions with messages, pages by skip and top, and answers 204 when none" uses (net, clock) {
  let b = new(os.clock)
  b.queue("sq", QueueOptions{sessions: true, lock_ms: 5000})
  for id in ["s-c", "s-a", "s-b"] {
    b.put("sq", amqp.Message{properties: Some(amqp.Properties{group_id: Some(id)}), body: amqp.Body.Data(sections: [b"x"])})
  }
  b.queue("empty", QueueOptions{sessions: true})
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let mg = mgmt_open(c, sess, "sq")
    let no_filter = amqp.Value.Timestamp(ms: 253402300800000)
    let all = mgmt_call(mg, "get-message-sessions", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "last-updated-time"), no_filter), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: 0)), (amqp.Value.Str(v: "top"), amqp.Value.Int(v: 2))])).or_fault("sessions")
    expect(status(all)) == 200
    expect(key(body_map(all), "sessions-ids")) == amqp.Value.Array(items: [amqp.Value.Str(v: "s-a"), amqp.Value.Str(v: "s-b")])
    expect(key(body_map(all), "skip")) == amqp.Value.Int(v: 2)
    let rest = mgmt_call(mg, "get-message-sessions", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "last-updated-time"), no_filter), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: 2)), (amqp.Value.Str(v: "top"), amqp.Value.Int(v: 2))])).or_fault("sessions 2")
    expect(key(body_map(rest), "sessions-ids")) == amqp.Value.Array(items: [amqp.Value.Str(v: "s-c")])
    let none = mgmt_open(c, sess, "empty")
    let r = mgmt_call(none, "get-message-sessions", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "last-updated-time"), no_filter), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: 0)), (amqp.Value.Str(v: "top"), amqp.Value.Int(v: 10))])).or_fault("none")
    expect(status(r)) == 204
    c.close().or_fault("close")
  }
}

fn selector(expr: Str) -> (Str, amqp.Value) {
  let k = "apache.org:selector-filter:string"
  (k, amqp.Value.Described(descriptor: amqp.Value.Symbol(v: k), value: amqp.Value.Str(v: expr)))
}

fn ann_of(m: amqp.Message, k: Str) -> amqp.Value {
  for (a, v) in m.annotations ?? [] {
    if a == amqp.Value.Symbol(v: k) { return v }
  }
  amqp.Value.Null
}

test "an event hub stores events per partition with x-opt annotations and serves selector reads" uses (net, clock) {
  let b = new(os.clock)
  b.event_hub("hub", 2)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let to1 = c.new_sender(sess, "hub/Partitions/1", amqp.SenderOptions{name: "s1"}).or_fault("sender 1")
    expect(to1.send(msg("a")).or_fault("send a")) == Some(amqp.DeliveryState.Accepted)
    expect(to1.send(msg("b")).or_fault("send b")) == Some(amqp.DeliveryState.Accepted)
    // a partition key picks a partition, deterministically, and is echoed
    let any = c.new_sender(sess, "hub", amqp.SenderOptions{name: "s2"}).or_fault("sender any")
    let keyed = amqp.Message{annotations: Some([(amqp.Value.Symbol(v: "x-opt-partition-key"), amqp.Value.Str(v: "k1"))]), body: amqp.Body.Data(sections: [b"c"])}
    any.send(keyed).or_fault("send keyed")
    any.send(keyed).or_fault("send keyed 2")
    let evs = b.events("hub", 1)
    expect(evs.len() >= 2) == true
    expect(text(evs[0])) == "a"
    expect(ann_of(evs[0], "x-opt-sequence-number")) == amqp.Value.Long(v: 0)
    expect(ann_of(evs[1], "x-opt-sequence-number")) == amqp.Value.Long(v: 1)
    expect(ann_of(evs[1], "x-opt-offset") != ann_of(evs[0], "x-opt-offset")) == true
    match ann_of(evs[0], "x-opt-enqueued-time") {
      Timestamp(_) => {}
      _ => fault("no enqueued time")
    }
    expect(b.events("hub", 0).len() + b.events("hub", 1).len()) == 4
    // a read from the start sees every event and removes nothing
    let rd = c.new_receiver(sess, "hub/ConsumerGroups/\$Default/Partitions/1", amqp.ReceiverOptions{name: "r1", credit: 10, filters: [selector("amqp.annotation.x-opt-offset > '-1'")]}).or_fault("receiver")
    let d0 = rd.receive(2000).or_fault("receive 0")
    expect(text(d0.message)) == "a"
    let d1 = rd.receive(2000).or_fault("receive 1")
    expect(text(d1.message)) == "b"
    expect(b.events("hub", 1).len() >= 2) == true
    // @latest sees only what arrives later, and a sequence number selects the rest
    let late = c.new_receiver(sess, "hub/ConsumerGroups/\$Default/Partitions/1", amqp.ReceiverOptions{name: "r2", credit: 10, filters: [selector("amqp.annotation.x-opt-offset > '@latest'")]}).or_fault("latest")
    to1.send(msg("z")).or_fault("send z")
    expect(text(late.receive(2000).or_fault("receive z").message)) == "z"
    let by_seq = c.new_receiver(sess, "hub/ConsumerGroups/\$Default/Partitions/1", amqp.ReceiverOptions{name: "r3", credit: 10, filters: [selector("amqp.annotation.x-opt-sequence-number >= '1'")]}).or_fault("by seq")
    expect(text(by_seq.receive(2000).or_fault("receive seq").message)) == "b"
    // an unknown partition, hub and group are refused
    match c.new_receiver(sess, "hub/ConsumerGroups/\$Default/Partitions/9", amqp.ReceiverOptions{name: "r4"}) {
      Err(Peer(e)) => expect(e.condition) == "com.microsoft:argument-out-of-range"
      _ => fault("unknown partition")
    }
    match c.new_receiver(sess, "hub/ConsumerGroups/nope/Partitions/0", amqp.ReceiverOptions{name: "r5"}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:not-found"
      _ => fault("unknown group")
    }
    c.close().or_fault("close")
  }
}

test "an event hub link under require_token accepts a claim on the hub or on its own path" uses (net, clock) {
  let b = new(os.clock)
  b.event_hub("eh1", 2)
  b.require_token(true)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    match c.new_sender(sess, "eh1/Partitions/1", amqp.SenderOptions{name: "s0"}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:unauthorized-access"
      _ => fault("no claim authorized the link")
    }
    amqp.cbs_put_token(c, sess, "amqps://ns/eh1/Partitions/1", "p1").or_fault("put path token")
    c.new_sender(sess, "eh1/Partitions/1", amqp.SenderOptions{name: "s1"}).or_fault("partition sender")
    match c.new_sender(sess, "eh1/Partitions/0", amqp.SenderOptions{name: "s2"}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:unauthorized-access"
      _ => fault("a claim on another path authorized the link")
    }
    amqp.cbs_put_token(c, sess, "amqps://ns/eh1/ConsumerGroups/$Default/Partitions/0", "r0").or_fault("put receiver token")
    c.new_receiver(sess, "eh1/ConsumerGroups/$Default/Partitions/0", amqp.ReceiverOptions{name: "r0"}).or_fault("receiver")
    amqp.cbs_put_token(c, sess, "amqps://ns/eh1", "hub").or_fault("put hub token")
    c.new_sender(sess, "eh1/Partitions/0", amqp.SenderOptions{name: "s3"}).or_fault("hub claim covers the partition")
    c.close().or_fault("close")
  }
}

test "an event hub receiver with a higher epoch takes the partition with amqp:link:stolen" uses (net, clock) {
  let b = new(os.clock)
  b.event_hub("hub", 1)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let path = "hub/ConsumerGroups/\$Default/Partitions/0"
    let lo = c.new_receiver(sess, path, amqp.ReceiverOptions{name: "lo", properties: [("com.microsoft:epoch", amqp.Value.Long(v: 5))]}).or_fault("epoch 5")
    let hi = c.new_receiver(sess, path, amqp.ReceiverOptions{name: "hi", properties: [("com.microsoft:epoch", amqp.Value.Long(v: 7))]}).or_fault("epoch 7")
    match lo.receive(1000) {
      Err(Peer(e)) => expect(e.condition) == "amqp:link:stolen"
      _ => fault("the lower epoch was not detached")
    }
    // a lower epoch, or none, is refused while the higher one holds the partition
    match c.new_receiver(sess, path, amqp.ReceiverOptions{name: "late", properties: [("com.microsoft:epoch", amqp.Value.Long(v: 6))]}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:link:stolen"
      _ => fault("a lower epoch attached")
    }
    match c.new_receiver(sess, path, amqp.ReceiverOptions{name: "none"}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:link:stolen"
      _ => fault("no epoch attached")
    }
    hi.close().or_fault("close hi")
    c.close().or_fault("close")
  }
}

test "an event hub answers the hub and partition properties on the namespace management link, and the broker logs each attach" uses (net, clock) {
  let b = new(os.clock)
  b.event_hub("hub", 3)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let geo = "com.microsoft:georeplication"
    let snd = c.new_sender(sess, "hub/Partitions/2", amqp.SenderOptions{name: "es", desired_capabilities: [geo]}).or_fault("event sender")
    snd.send(msg("a")).or_fault("send")
    let ms = c.new_sender(sess, "\$management", amqp.SenderOptions{name: "m-s"}).or_fault("mgmt sender")
    let mr = c.new_receiver(sess, "\$management", amqp.ReceiverOptions{name: "m-r", target: "client-reply", credit: 5, desired_capabilities: [geo]}).or_fault("mgmt receiver")
    let ask = fn(props: List[(Str, amqp.Value)]) -> amqp.Message uses (net, clock, sync) {
      let req = amqp.Message{
        properties: Some(amqp.Properties{message_id: amqp.Value.Str(v: "r-1"), reply_to: Some("client-reply")}),
        app_properties: Some([("operation", amqp.Value.Str(v: "READ")), ("name", amqp.Value.Str(v: "hub"))] + props),
        body: amqp.Body.Value(v: amqp.Value.Null)}
      ms.send(req).or_fault("ask")
      let d = mr.receive(2000).or_fault("answer")
      mr.accept(d).or_fault("accept")
      d.message
    }
    let hub = ask([("type", amqp.Value.Str(v: "com.microsoft:eventhub"))])
    expect(key_of(hub, "status-code")) == amqp.Value.Int(v: 200)
    expect(key(body_map(hub), "partition_count")) == amqp.Value.Int(v: 3)
    expect(key(body_map(hub), "partition_ids")) == amqp.Value.Array(items: [amqp.Value.Str(v: "0"), amqp.Value.Str(v: "1"), amqp.Value.Str(v: "2")])
    // Event Hubs v2 (azeventhubs v2.0.2) refuses a READ reply without it
    expect(key(body_map(hub), "georeplication_factor")) == amqp.Value.Long(v: 1)
    b.event_hub_geo_factor("hub", 2)
    expect(key(body_map(ask([("type", amqp.Value.Str(v: "com.microsoft:eventhub"))])), "georeplication_factor")) == amqp.Value.Long(v: 2)
    expect(b.attaches()) == [("hub/Partitions/2", "sender", [geo]), ("\$management", "sender", []), ("\$management", "receiver", [geo])]
    let part = ask([("type", amqp.Value.Str(v: "com.microsoft:partition")), ("partition", amqp.Value.Str(v: "2"))])
    expect(key(body_map(part), "last_enqueued_sequence_number")) == amqp.Value.Long(v: 0)
    expect(key(body_map(part), "is_partition_empty")) == amqp.Value.Bool(v: false)
    let empty = ask([("type", amqp.Value.Str(v: "com.microsoft:partition")), ("partition", amqp.Value.Str(v: "0"))])
    expect(key(body_map(empty), "is_partition_empty")) == amqp.Value.Bool(v: true)
    expect(key(body_map(empty), "last_enqueued_offset")) == amqp.Value.Str(v: "-1")
    c.close().or_fault("close")
  }
}

fn key_of(m: amqp.Message, k: Str) -> amqp.Value {
  for (a, v) in m.app_properties ?? [] {
    if a == k { return v }
  }
  amqp.Value.Null
}

test "put-token takes expiration as a string of Unix seconds, as Go's clients send it" uses (net, clock) {
  let b = new(os.clock)
  b.queue("q")
  b.require_token(true)
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let now = os.clock.now().unix()
    amqp.cbs_put_token(c, sess, "sb://x/q", "old", expiration: Some(amqp.Value.Str(v: "${now - 10}"))).or_fault("put old")
    match c.new_sender(sess, "q", amqp.SenderOptions{name: "s1"}) {
      Err(Peer(e)) => expect(e.condition) == "amqp:unauthorized-access"
      _ => fault("an expired token authorized the link")
    }
    amqp.cbs_put_token(c, sess, "sb://x/q", "fresh", expiration: Some(amqp.Value.Str(v: "${now + 3600}"))).or_fault("put fresh")
    c.new_sender(sess, "q", amqp.SenderOptions{name: "s2"}).or_fault("sender")
    c.close().or_fault("close")
  }
}

test "a typed receiver exposes the peer's attach: the echoed session filter and locked-until" uses (net, clock) {
  let b = new(os.clock)
  b.queue("sq", QueueOptions{sessions: true, lock_ms: 5000})
  b.put("sq", amqp.Message{properties: Some(amqp.Properties{group_id: Some("s-a")}), body: amqp.Body.Data(sections: [b"a1"])})
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope s {
    b.serve(s.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(s.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let key = "com.microsoft:session-filter"
    let rcv = c.new_receiver(sess, "sq", amqp.ReceiverOptions{filters: [(key, amqp.Value.Described(descriptor: amqp.Value.Symbol(v: key), value: amqp.Value.Null))]}).or_fault("receiver")
    let a = rcv.remote_attach() ?? fault("no remote attach")
    match a.source {
      Some(src) => expect(src.filter[0].1) == amqp.Value.Described(descriptor: amqp.Value.Symbol(v: key), value: amqp.Value.Str(v: "s-a"))
      None => fault("no source")
    }
    var seen = false
    for (k, v) in a.properties {
      if k == "com.microsoft:locked-until-utc" {
        match v {
          Timestamp(ms) => { seen = ms > os.clock.now().unix_millis() }
          _ => {}
        }
      }
    }
    expect(seen) == true
    c.close().or_fault("close")
  }
}

fn sql_msg() -> amqp.Message {
  amqp.Message{
    properties: Some(amqp.Properties{message_id: amqp.Value.Str(v: "m-1"), subject: Some("order"), correlation_id: amqp.Value.ULong(v: UInt64(42)),
      content_type: Some("application/json"), group_id: Some("s-7"), to: Some("dest")}),
    app_properties: Some([("Color", amqp.Value.Str(v: "red")), ("qty", amqp.Value.Int(v: Int32(5))), ("price", amqp.Value.Double(v: 2.5)),
      ("vip", amqp.Value.Bool(v: true)), ("note", amqp.Value.Null), ("path", amqp.Value.Str(v: "a%b_c")), ("Prop With Space", amqp.Value.Long(v: Int64(9)))]),
    body: amqp.Body.Data(sections: [b"x"])}
}

fn sql_res(expr: Str) -> Str {
  match sql_parse(expr) {
    Ok(f) => {
      let v = sql_eval(f, f.root, sql_msg())
      if v.k == 1 { if v.b { "T" } else { "F" } } else if v.k == 0 { "U" } else { "value" }
    }
    Err(e) => "error: " + e
  }
}

test "SQL filters: comparisons, three valued logic, IN, LIKE, EXISTS, IS NULL and system properties" {
  let cases: List[(Str, Str)] = [
    ("color = 'red'", "T"),
    ("COLOR = 'Red'", "F"),
    ("user.Color <> 'blue'", "T"),
    ("qty > 4 AND qty <= 5", "T"),
    ("qty = 5.0", "T"),
    ("price * 2 = 5", "T"),
    ("qty / 2 = 2", "T"),
    ("qty % 3 = 2", "T"),
    ("-qty < 0", "T"),
    ("qty + 1 = 6 OR missing = 1", "T"),
    ("missing = 1", "U"),
    ("missing = 1 AND qty = 5", "U"),
    ("missing = 1 AND qty = 4", "F"),
    ("missing = 1 OR qty = 4", "U"),
    ("NOT missing = 1", "U"),
    ("NOT qty = 4", "T"),
    ("missing IS NULL", "T"),
    ("note IS NULL", "T"),
    ("color IS NOT NULL", "T"),
    ("EXISTS(note)", "T"),
    ("EXISTS(missing)", "F"),
    ("color IN ('blue', 'red')", "T"),
    ("color NOT IN ('blue', 'red')", "F"),
    ("missing IN (1, 2)", "U"),
    ("color LIKE 'r%'", "T"),
    ("color LIKE '_e_'", "T"),
    ("color NOT LIKE '%d'", "F"),
    ("path LIKE 'a!%b!_c' ESCAPE '!'", "T"),
    ("path LIKE 'a!%bxc' ESCAPE '!'", "F"),
    ("vip = TRUE", "T"),
    ("vip", "T"),
    ("color = 'it''s'", "F"),
    ("[Prop With Space] = 9", "T"),
    ("\"Prop With Space\" = 9", "T"),
    ("p('qty') = 5 AND property('COLOR') = 'red'", "T"),
    ("sys.Label = 'order' AND sys.MessageId = 'm-1'", "T"),
    ("sys.CorrelationId = '42' AND sys.SessionId = 's-7'", "T"),
    ("sys.ContentType LIKE 'application/%' AND sys.To = 'dest'", "T"),
    ("sys.ReplyTo IS NULL", "T"),
    ("color = 5", "U"),
    ("color > 'a'", "U"),
    ("qty / 0 = 1", "U"),
    ("1.5E1 = 15", "T"),
    ("(qty = 5 OR qty = 6) AND NOT (color = 'blue')", "T"),
    ("sys.Nope = 1", "error: sys.Nope is not a system property"),
    ("color = 'red", "error: an unterminated string"),
    ("color == 'red'", "error: unexpected \"=\""),
    ("color NOT 'red'", "error: expected IN or LIKE after NOT at \"red\""),
    ("qty >", "error: unexpected end of the expression"),
    ("newid() = 1", "error: newid() is not supported by the test broker"),
    ("color = 'red' extra", "error: unexpected \"extra\""),
  ]
  var bad: List[(Str, Str, Str)] = []
  for (e, want) in cases {
    let got = sql_res(e)
    if got != want { bad.push((e, got, want)) }
  }
  expect(bad) == []
}

test "correlation filters match every field and property they set" {
  let m = sql_msg()
  expect(corr_match(CorrelationFilter{subject: Some("order")}, m)) == true
  expect(corr_match(CorrelationFilter{subject: Some("order"), correlation_id: Some("42")}, m)) == true
  expect(corr_match(CorrelationFilter{subject: Some("Order")}, m)) == false
  expect(corr_match(CorrelationFilter{session_id: Some("s-7"), content_type: Some("application/json"), to: Some("dest")}, m)) == true
  expect(corr_match(CorrelationFilter{reply_to: Some("x")}, m)) == false
  expect(corr_match(CorrelationFilter{properties: [("qty", amqp.Value.Long(v: Int64(5))), ("Color", amqp.Value.Str(v: "red"))]}, m)) == true
  expect(corr_match(CorrelationFilter{properties: [("color", amqp.Value.Str(v: "red"))]}, m)) == false
  expect(corr_match(CorrelationFilter{}, m)) == true
}

fn labelled(t: Str, label: Str, qty: Int) -> amqp.Message {
  amqp.Message{properties: Some(amqp.Properties{subject: Some(label)}), app_properties: Some([("qty", amqp.Value.Int(v: Int32(qty)))]),
    body: amqp.Body.Data(sections: [t.bytes()])}
}

test "subscription rules decide which subscriptions get a topic's messages" {
  let b = new(os.clock)
  b.subscription("orders", "all")
  b.subscription("orders", "big")
  b.subscription("orders", "refunds")
  b.subscription("orders", "none")
  expect(b.rules("orders", "big")) == [("$Default", RuleFilter.True)]
  b.add_rule("orders", "big", "big", RuleFilter.Sql(expr: "qty >= 10")).or_fault("big")
  expect(b.remove_rule("orders", "big", "$default")) == true
  b.add_rule("orders", "refunds", "r", RuleFilter.Correlation(c: CorrelationFilter{subject: Some("refund")})).or_fault("r")
  expect(b.remove_rule("orders", "refunds", "$Default")) == true
  b.add_rule("orders", "refunds", "huge", RuleFilter.Sql(expr: "qty > 100")).or_fault("huge")
  b.add_rule("orders", "none", "f", RuleFilter.Sql(expr: "1 = 0")).or_fault("f")
  expect(b.remove_rule("orders", "none", "$Default")) == true
  expect(b.rules("orders", "none")) == [("f", RuleFilter.False)]
  expect(b.add_rule("orders", "big", "BIG", RuleFilter.True)) == Err("the rule \"BIG\" already exists")
  expect(b.add_rule("orders", "big", "bad", RuleFilter.Sql(expr: "qty >"))) == Err("unexpected end of the expression")
  expect(b.remove_rule("orders", "big", "nope")) == false
  b.put("orders", labelled("a", "sale", 1))
  b.put("orders", labelled("b", "sale", 12))
  b.put("orders", labelled("c", "refund", 3))
  b.put("orders", labelled("d", "refund", 500))
  expect(b.ready("orders/Subscriptions/all").map(text)) == ["a", "b", "c", "d"]
  expect(b.ready("orders/Subscriptions/big").map(text)) == ["b", "d"]
  // a message goes once to a subscription however many of its rules match
  expect(b.ready("orders/Subscriptions/refunds").map(text)) == ["c", "d"]
  expect(b.ready("orders/Subscriptions/none").len()) == 0
}

fn rule_names(m: amqp.Message) -> List[Str] {
  var out: List[Str] = []
  match key(body_map(m), "rules") {
    List(items) => {
      for it in items {
        match it {
          Map(ps) => match key(ps, "rule-description") {
            Described(_, List(fields)) => match fields[2] {
              Str(n) => out.push(n)
              _ => {}
            }
            _ => {}
          }
          _ => {}
        }
      }
    }
    _ => {}
  }
  out
}

fn rule_field(m: amqp.Message, i: Int, f: Int) -> amqp.Value {
  match key(body_map(m), "rules") {
    List(items) => match items[i] {
      Map(ps) => match key(ps, "rule-description") {
        Described(_, List(fields)) => fields[f]
        _ => amqp.Value.Null
      }
      _ => amqp.Value.Null
    }
    _ => amqp.Value.Null
  }
}

fn rule_req(name: Str, desc: List[(amqp.Value, amqp.Value)]) -> amqp.Value {
  amqp.Value.Map(pairs: [(amqp.Value.Str(v: "rule-name"), amqp.Value.Str(v: name)), (amqp.Value.Str(v: "rule-description"), amqp.Value.Map(pairs: desc))])
}

fn smap(k: Str, v: Str) -> (amqp.Value, amqp.Value) {
  (amqp.Value.Str(v: k), amqp.Value.Map(pairs: [(amqp.Value.Str(v: "expression"), amqp.Value.Str(v: v))]))
}

test "management: add-rule, enumerate-rules and remove-rule on a subscription" uses (net, clock) {
  let b = new(os.clock)
  b.subscription("t", "s")
  let l = os.net.listen("127.0.0.1:0").or_fault("listen")
  scope sc {
    b.serve(sc.group(), l)
    let c = dial_broker(os.net, os.clock, l)
    c.keepalive(sc.group()).or_fault("keepalive")
    let sess = c.begin().or_fault("begin")
    let mg = mgmt_open(c, sess, "t/Subscriptions/s")
    let page = amqp.Value.Map(pairs: [(amqp.Value.Str(v: "top"), amqp.Value.Int(v: Int32(10))), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: Int32(0)))])
    let r0 = mgmt_call(mg, "enumerate-rules", page).or_fault("enum0")
    expect(status(r0)) == 200
    expect(rule_names(r0)) == ["$Default"]
    expect(rule_field(r0, 0, 0)) == amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64(0x0000013700000007)), value: amqp.Value.List(items: [amqp.Value.Str(v: "1=1"), amqp.Value.Int(v: Int32(20))]))
    expect(rule_field(r0, 0, 1)) == amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64(0x0000013700000005)), value: amqp.Value.List(items: []))
    let a1 = mgmt_call(mg, "add-rule", rule_req("cheap", [smap("sql-filter", "price < 10"), smap("sql-rule-action", "SET tier = 'low'")])).or_fault("add1")
    expect(status(a1)) == 200
    let corr = amqp.Value.Map(pairs: [(amqp.Value.Str(v: "label"), amqp.Value.Str(v: "refund")),
      (amqp.Value.Str(v: "properties"), amqp.Value.Map(pairs: [(amqp.Value.Str(v: "region"), amqp.Value.Str(v: "eu"))]))])
    let a2 = mgmt_call(mg, "add-rule", rule_req("refunds", [(amqp.Value.Str(v: "correlation-filter"), corr)])).or_fault("add2")
    expect(status(a2)) == 200
    let dup = mgmt_call(mg, "add-rule", rule_req("Cheap", [smap("sql-filter", "1=1")])).or_fault("dup")
    expect(status(dup)) == 409
    expect(cond(dup)) == "com.microsoft:entity-already-exists"
    let bad = mgmt_call(mg, "add-rule", rule_req("bad", [smap("sql-filter", "price <")])).or_fault("bad")
    expect(status(bad)) == 400
    expect(cond(bad)) == "com.microsoft:argument-error"
    let r1 = mgmt_call(mg, "enumerate-rules", page).or_fault("enum1")
    expect(rule_names(r1)) == ["$Default", "cheap", "refunds"]
    expect(rule_field(r1, 1, 0)) == amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64(0x0000013700000006)), value: amqp.Value.List(items: [amqp.Value.Str(v: "price < 10"), amqp.Value.Int(v: Int32(20))]))
    expect(rule_field(r1, 1, 1)) == amqp.Value.Described(descriptor: amqp.Value.ULong(v: UInt64(0x0000013700000006)), value: amqp.Value.List(items: [amqp.Value.Str(v: "SET tier = 'low'"), amqp.Value.Int(v: Int32(20))]))
    match rule_field(r1, 2, 0) {
      Described(d, List(fs)) => {
        expect(d) == amqp.Value.ULong(v: UInt64(0x0000013700000009))
        expect(fs[4]) == amqp.Value.Str(v: "refund")
        expect(fs[0]) == amqp.Value.Null
        expect(fs[8]) == amqp.Value.Map(pairs: [(amqp.Value.Str(v: "region"), amqp.Value.Str(v: "eu"))])
      }
      _ => fault("correlation filter")
    }
    let skip2 = amqp.Value.Map(pairs: [(amqp.Value.Str(v: "top"), amqp.Value.Int(v: Int32(1))), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: Int32(2)))])
    expect(rule_names(mgmt_call(mg, "enumerate-rules", skip2).or_fault("enum2"))) == ["refunds"]
    let rm = mgmt_call(mg, "remove-rule", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "rule-name"), amqp.Value.Str(v: "$Default"))])).or_fault("rm")
    expect(status(rm)) == 200
    let rm2 = mgmt_call(mg, "remove-rule", amqp.Value.Map(pairs: [(amqp.Value.Str(v: "rule-name"), amqp.Value.Str(v: "$Default"))])).or_fault("rm2")
    expect(status(rm2)) == 404
    let past = amqp.Value.Map(pairs: [(amqp.Value.Str(v: "top"), amqp.Value.Int(v: Int32(10))), (amqp.Value.Str(v: "skip"), amqp.Value.Int(v: Int32(5)))])
    expect(status(mgmt_call(mg, "enumerate-rules", past).or_fault("enum3"))) == 204
    // the rules now decide what the subscription gets
    b.put("t", amqp.Message{app_properties: Some([("price", amqp.Value.Int(v: Int32(3)))]), body: amqp.Body.Data(sections: [b"cheap"])})
    b.put("t", amqp.Message{app_properties: Some([("price", amqp.Value.Int(v: Int32(30)))]), body: amqp.Body.Data(sections: [b"dear"])})
    b.put("t", amqp.Message{properties: Some(amqp.Properties{subject: Some("refund")}), app_properties: Some([("region", amqp.Value.Str(v: "eu"))]), body: amqp.Body.Data(sections: [b"refund"])})
    expect(b.ready("t/Subscriptions/s").map(text)) == ["cheap", "refund"]
    c.close().or_fault("close")
  }
}

fn app_of(m: amqp.Message, k: Str) -> amqp.Value {
  for (a, v) in m.app_properties ?? [] {
    if a == k { return v }
  }
  amqp.Value.Symbol(v: "absent")
}

test "rule actions: a copy per matching rule with an action, SET and REMOVE, and RuleName" {
  let b = new(os.clock)
  b.subscription("t", "s")
  b.add_rule("t", "s", "tag", RuleFilter.Sql(expr: "qty > 1"), "SET tier = 'bulk'; SET Qty = qty * 2; REMOVE color; SET sys.Label = 'big'").or_fault("tag")
  b.add_rule("t", "s", "copy", RuleFilter.True, "SET n = 1.5 SET flag = TRUE SET gone = missing").or_fault("copy")
  expect(b.add_rule("t", "s", "bad", RuleFilter.True, "SET sys.Nope = 1")) == Err("sys.Nope is not a system property")
  expect(b.add_rule("t", "s", "bad", RuleFilter.True, "REMOVE sys.Label")) == Err("REMOVE takes a user property")
  expect(b.add_rule("t", "s", "bad", RuleFilter.True, "UPDATE x")) == Err("expected SET or REMOVE at \"UPDATE\"")
  b.put("t", amqp.Message{properties: Some(amqp.Properties{subject: Some("order")}),
    app_properties: Some([("qty", amqp.Value.Int(v: Int32(3))), ("Color", amqp.Value.Str(v: "red"))]), body: amqp.Body.Data(sections: [b"m"])})
  let got = b.ready("t/Subscriptions/s")
  // $Default (no action), then the two action copies in rule order
  expect(got.len()) == 3
  expect(app_of(got[0], "RuleName")) == amqp.Value.Symbol(v: "absent")
  expect(app_of(got[0], "Color")) == amqp.Value.Str(v: "red")
  expect(app_of(got[1], "RuleName")) == amqp.Value.Str(v: "tag")
  expect(app_of(got[1], "tier")) == amqp.Value.Str(v: "bulk")
  expect(app_of(got[1], "qty")) == amqp.Value.Long(v: Int64(6))
  expect(app_of(got[1], "Color")) == amqp.Value.Symbol(v: "absent")
  expect((got[1].properties ?? amqp.Properties{}).subject) == Some("big")
  expect((got[0].properties ?? amqp.Properties{}).subject) == Some("order")
  expect(app_of(got[2], "RuleName")) == amqp.Value.Str(v: "copy")
  expect(app_of(got[2], "n")) == amqp.Value.Double(v: 1.5)
  expect(app_of(got[2], "flag")) == amqp.Value.Bool(v: true)
  expect(app_of(got[2], "gone")) == amqp.Value.Null
  b.put("t", amqp.Message{app_properties: Some([("qty", amqp.Value.Int(v: Int32(1)))]), body: amqp.Body.Data(sections: [b"one"])})
  expect(b.ready("t/Subscriptions/s").len()) == 5
}

// Settling a message changes it in place (stress heap profile, 2026-11-17): unlock, apply_modified,
// defer_msg and dead_letter copied the queue, so the first write copied its whole message list, and
// 65% of the stress run's allocation was those copies. 8,000 releases, abandons, defers and dead
// letters on a queue of 8,000 messages copied 128 M messages before; the budget is 1 s.
test "settling a message does not copy the queue's message list" uses clock {
  let n = 8000
  var s = BrokerState{}
  var msgs: List[FakeMsg] = []
  for i in 0..n { msgs.push(FakeMsg{seq: i + 1, m: msg("m${i}"), locked_until: 1, lock_token: b"t", delivery_count: 1}) }
  s.queues.push(FakeQueue{name: "q", opts: QueueOptions{max_delivery_count: 1000}, msgs: msgs})
  let ann = [(amqp.Value.Symbol(v: "k"), amqp.Value.Str(v: "v"))]
  let t0 = os.clock.now()
  for i in 0..n / 2 {
    unlock(s, 0, i + 1, false)
    apply_modified(s, 0, i + 1, ann)
  }
  for i in n / 2..n * 3 / 4 { defer_msg(s, 0, i + 1) }
  for i in n * 3 / 4..n { dead_letter(s, 0, i + 1, "r", "d") }
  let took = os.clock.now() - t0
  expect(s.queues[0].msgs.len()) == n * 3 / 4
  expect(s.queues[0].dead.len()) == n / 4
  expect(s.queues[0].msgs[0].locked_until) == 0
  expect(s.queues[0].msgs[0].delivery_count) == 0
  expect(s.queues[0].msgs[n / 2].deferred) == true
  expect(s.queues[0].dead[0].dead_reason) == "r"
  expect(took < 1000ms) == true
}

// A delivery no longer scans the whole queue for expired locks (stress run, 2026-11-17): take
// called expire_locks, which walked every message each time, so a delivery cost O(queue length)
// and the stress consumers fell behind as the backlog grew. 4,000 locked takes from a queue of
// 40,000 walked 160 M messages before (362 ms on the Mac Studio, 15 ms after); the budget is 100 ms,
// and the locks still expire on time.
test "a delivery does not scan the queue for expired locks" uses clock {
  let n = 40000
  let k = 4000
  var s = BrokerState{}
  var msgs: List[FakeMsg] = []
  for i in 0..n { msgs.push(FakeMsg{seq: i + 1, m: msg("m${i}")}) }
  s.queues.push(FakeQueue{name: "q", opts: QueueOptions{lock_ms: 1000, max_delivery_count: 10}, msgs: msgs})
  let t0 = os.clock.now()
  for i in 0..k {
    match take(s, 0, 1, 5000 + i % 500, "", false) {
      Some(m) => expect(m.seq) == i + 1
      None => fault("take ${i}: none")
    }
  }
  let took = os.clock.now() - t0
  expect(s.queues[0].msgs[0].locked_until) == 6000
  // the first lock (taken at 5000) has expired at 6000: the next take gets message 1 again
  match take(s, 0, 2, 6000, "", false) {
    Some(m) => {
      expect(m.seq) == 1
      expect(m.delivery_count) == 2
    }
    None => fault("no expired lock")
  }
  // taken at 5001: still locked; message 501 (taken at 5000) has expired
  expect(s.queues[0].msgs[1].locked_until) == 6001
  expect(s.queues[0].msgs[500].locked_until) == 0
  expect(s.queues[0].msgs[k - 1].locked_until) == 5000 + (k - 1) % 500 + 1000
  expect(took < 100ms) == true
}

// A settle finds its message by binary search (task #323, 2026-11-18): find_seq scanned the queue
// from the front, so each settle cost O(queue depth) and the stress run's broker work per message
// grew with its backlog. 10,000 unlocks at the back of a queue of 100,000 walked about 950 M
// messages before; the budget is 100 ms. Lookups across gaps and of missing numbers still answer.
test "a settle does not scan the queue for its message" uses clock {
  let n = 100000
  let k = 10000
  var s = BrokerState{}
  var msgs: List[FakeMsg] = []
  for i in 0..n { msgs.push(FakeMsg{seq: i + 1, m: msg("m${i}"), locked_until: 1, lock_token: b"t", delivery_count: 1}) }
  s.queues.push(FakeQueue{name: "q", opts: QueueOptions{max_delivery_count: 1000}, msgs: msgs})
  let t0 = os.clock.now()
  for i in 0..k { unlock(s, 0, n - i, false) }
  let took = os.clock.now() - t0
  expect(s.queues[0].msgs[n - 1].locked_until) == 0
  expect(s.queues[0].msgs[n - k].locked_until) == 0
  expect(s.queues[0].msgs[n - k - 1].locked_until) == 1
  expect(took < 100ms) == true
  // gaps: remove every other message among the first 10
  for i in 0..5 { dead_letter(s, 0, 2 * i + 2, "r", "d") }
  expect(find_seq(s.queues[0], 1)) == 0
  expect(find_seq(s.queues[0], 2)) == -1
  expect(find_seq(s.queues[0], 3)) == 1
  expect(find_seq(s.queues[0], 11)) == 5
  expect(find_seq(s.queues[0], n)) == n - 6
  expect(find_seq(s.queues[0], n + 1)) == -1
  expect(find_seq(s.queues[0], 0)) == -1
}
