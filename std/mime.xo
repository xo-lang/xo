    ".xbm" => Some("image/x-xbitmap")
    ".xht" => Some("application/xhtml+xml")
    ".xhtml" => Some("application/xhtml+xml")
    ".xls" => Some("application/vnd.ms-excel")
    ".xlsx" => Some("application/vnd.openxmlformats-officedocument.spreadsheetml.sheet")
    ".xml" => Some("text/xml; charset=utf-8")
    ".xsl" => Some("text/xml; charset=utf-8")
    ".zip" => Some("application/zip")
    _ => None
  }
}

enum Sig {
  Html(p: Bytes)
  Masked(mask: Bytes, pat: Bytes, skip_ws: Bool, ct: Str)
  Exact(sig: Bytes, ct: Str)
  Mp4
  Text
}

/// sniff.go's sniffSignatures in order, made once (sigs() built the list,
/// and each HTML pattern's Bytes, on every call: 2026-10-26, with the
/// slices below, detect_content_type ran at 8.3x Go's time), decoded from
/// SIG_DATA (as 51 enum literals the list was 6 KB of a wasm module's code).
const SIGS: List[Sig] = sigs_of(SIG_DATA)

/// The signatures' records in sniff.go's order: a kind byte (0 Html,
/// 1 Masked, 2 Masked after leading white space, 3 Exact, 4 Mp4, 5 Text);
/// for Html a length and the pattern; for Masked a length, the mask and the
/// pattern (each that long) and the index of the content type in
/// SIG_TYPES; for Exact a length, the signature and the type's index.
const SIG_DATA: Bytes = b"\x00\x0E<!DOCTYPE HTML\x00\x05<HTML\x00\x05<HEAD\x00\x07<SCRIPT\x00\x07<IFRAME\x00\x03<H1\x00\x04<DIV\x00\x05<FONT\x00\x06<TABLE\x00\x02<A\x00\x06<STYLE\x00\x06<TITLE\x00\x02<B\x00\x05<BODY\x00\x03<BR\x00\x02<P\x00\x04<!--\x02\x05\xFF\xFF\xFF\xFF\xFF<?xml\x00\x03\x05%PDF-\x01\x03\x0B%!PS-Adobe-\x02\x01\x04\xFF\xFF\x00\x00\xFE\xFF\x00\x00\x03\x01\x04\xFF\xFF\x00\x00\xFF\xFE\x00\x00\x04\x01\x04\xFF\xFF\xFF\x00\xEF\xBB\xBF\x00\x05\x03\x04\x00\x00\x01\x00\x06\x03\x04\x00\x00\x02\x00\x06\x03\x02BM\x07\x03\x06GIF87a\x08\x03\x06GIF89a\x08\x01\x0E\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFF\xFF\xFFRIFF\x00\x00\x00\x00WEBPVP\x09\x03\x08\x89PNG\x0D\x0A\x1A\x0A\x0A\x03\x03\xFF\xD8\xFF\x0B\x01\x0C\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFFFORM\x00\x00\x00\x00AIFF\x0C\x01\x03\xFF\xFF\xFFID3\x0D\x01\x05\xFF\xFF\xFF\xFF\xFFOggS\x00\x0E\x01\x08\xFF\xFF\xFF\xFF\xFF\xFF\xFF\xFFMThd\x00\x00\x00\x06\x0F\x01\x0C\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFFRIFF\x00\x00\x00\x00AVI \x10\x01\x0C\xFF\xFF\xFF\xFF\x00\x00\x00\x00\xFF\xFF\xFF\xFFRIFF\x00\x00\x00\x00WAVE\x11\x04\x03\x04\x1AE\xDF\xA3\x12\x01\x24\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xFF\xFF\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00LP\x13\x03\x04\x00\x01\x00\x00\x14\x03\x04OTTO\x15\x03\x04ttcf\x16\x03\x04wOFF\x17\x03\x04wOF2\x18\x03\x03\x1F\x8B\x08\x19\x03\x04PK\x03\x04\x1A\x03\x07Rar!\x1A\x07\x00\x1B\x03\x08Rar!\x1A\x07\x01\x00\x1B\x03\x04\x00asm\x1C\x05"

/// The content types SIG_DATA's records name, by index (one literal: as
/// a list literal, 29 elements were built one by one).
const SIG_TYPES: List[Str] = "text/xml; charset=utf-8\napplication/pdf\napplication/postscript\ntext/plain; charset=utf-16be\ntext/plain; charset=utf-16le\ntext/plain; charset=utf-8\nimage/x-icon\nimage/bmp\nimage/gif\nimage/webp\nimage/png\nimage/jpeg\naudio/aiff\naudio/mpeg\napplication/ogg\naudio/midi\nvideo/avi\naudio/wave\nvideo/webm\napplication/vnd.ms-fontobject\nfont/ttf\nfont/otf\nfont/collection\nfont/woff\nfont/woff2\napplication/x-gzip\napplication/zip\napplication/x-rar-compressed\napplication/wasm".split("\n")

/// The signatures of SIG_DATA's records.
fn sigs_of(d: Bytes) -> List[Sig] {
  var out: List[Sig] = []
  var i = 0
  while i < d.len() {
    let k = Int(d[i])
    if k == 4 || k == 5 {
      out.push(if k == 4 { Sig.Mp4 } else { Sig.Text })
      i += 1
      continue
    }
    let n = Int(d[i + 1])
    let a = d[i + 2..i + 2 + n]
    if k == 0 {
      out.push(Sig.Html(p: a))
      i += 2 + n
    } else if k == 3 {
      out.push(Sig.Exact(sig: a, ct: SIG_TYPES[Int(d[i + 2 + n])]))
      i += 3 + n
    } else {
      let pat = d[i + 2 + n..i + 2 + 2 * n]
      out.push(Sig.Masked(mask: a, pat: pat, skip_ws: k == 2, ct: SIG_TYPES[Int(d[i + 2 + 2 * n])]))
      i += 3 + 2 * n
    }
  }
  out
}

fn is_ws(b: UInt8) -> Bool { b == 9 || b == 10 || b == 12 || b == 13 || b == 32 }

/// Whether data starts with p, compared in place (no slice: a view pays a
/// range check, a count and a drop).
fn has_prefix(data: Bytes, p: Bytes) -> Bool {
  if data.len() < p.len() {
    return false
  }
  for i in 0..p.len() {
    if data[i] != p[i] {
      return false
    }
  }
  true
}

/// Whether data matches s (sniff.go's match); its type is sig_type's, made
/// only on a match (a Str result per signature released an empty Str ~40
/// times a call).
fn sig_hit(s: Sig, data: Bytes, first: Int) -> Bool {
  match s {
    Html(h) => {
      // data from first, by offset (a view per pattern paid its checks,
      // count and drop)
      if data.len() - first < h.len() + 1 {
        return false
      }
      for i in 0..h.len() {
        var db = data[first + i]
        if h[i] >= 65 && h[i] <= 90 {
          db = db & 0xDF
        }
        if h[i] != db {
          return false
        }
      }
      let t = data[first + h.len()]
      t == 32 || t == 62
    }
    Masked(mask, pat, skip_ws, _) => {
      let o = if skip_ws { first } else { 0 }
      if pat.len() != mask.len() || data.len() - o < pat.len() {
        return false
      }
      for i in 0..pat.len() {
        if (data[o + i] & mask[i]) != pat[i] {
          return false
        }
      }
      true
    }
    Exact(sig, _) => has_prefix(data, sig)
    Mp4 => {
      if data.len() < 12 {
        return false
      }
      let box = (Int(data[0]) << 24) | (Int(data[1]) << 16) | (Int(data[2]) << 8) | Int(data[3])
      if data.len() < box || box % 4 != 0 {
        return false
      }
      if data[4] != 102 || data[5] != 116 || data[6] != 121 || data[7] != 112 {
        return false
      }
      var st = 8
      while st < box {
        if st != 12 && data[st] == 109 && data[st + 1] == 112 && data[st + 2] == 52 {
          return true
        }
        st += 4
      }
      false
    }
    Text => {
      var i = first
      while i < data.len() {
        let b = data[i]
        if b <= 8 || b == 11 || (b >= 14 && b <= 26) || (b >= 28 && b <= 31) {
          return false
        }
        i += 1
      }
      true
    }
  }
}

fn sig_type(s: Sig) -> Str {
  match s {
    Html(_) => "text/html; charset=utf-8"
    Masked(_, _, _, ct) => ct
    Exact(_, ct) => ct
    Mp4 => "video/mp4"
    Text => "text/plain; charset=utf-8"
  }
}

// ---- RFC 2047 encoded words (Go's mime/encodedword.go, go1.26) ----

/// The encoding of an encoded word (Go's WordEncoder): base64 (`b`) or
/// quoted-printable (`q`).
pub enum WordEncoding {
  B
  Q
}

/// s as RFC 2047 encoded words (WordEncoder.Encode): s itself when every
/// rune is printable ASCII or a tab, else `=?charset?q?...?=` words of
/// at most 75 bytes, split between runes when charset is UTF-8 in any
/// case, joined by a space. The bytes of s are written as they are, the
/// charset only labels them.
pub fn encode_word(s: Str, charset: Str = "utf-8", encoding: WordEncoding = WordEncoding.Q) -> Str {
  if !needs_encoding(s) {
    return s
  }
  var buf = StrBuilder.new()
  open_word(buf, charset, encoding)
  if encoding is B {
    b_encode(buf, charset, encoding, s.bytes())
  } else {
    q_encode(buf, charset, encoding, s.bytes())
  }
  buf.write("?=")
  buf.freeze()
}

/// One encoded word decoded (WordDecoder.Decode with no CharsetReader):
/// the charsets UTF-8, ISO-8859-1 and US-ASCII in any case (a byte above
/// 127 in US-ASCII, and bytes that are not UTF-8 in UTF-8, become U+FFFD:
/// a Str holds UTF-8, decision 0259). Go's errors: `mime: invalid RFC 2047
/// encoded-word`, base64's `illegal base64 data at input byte N`, `mime:
/// invalid hex byte 0x..`, `mime: unhandled charset "x"`.
pub fn decode_word(word: Str) -> Str ! MimeErr {
  let (charset, content) = word_parts(word)?
  convert_charset(charset, content)
}

/// An encoded word's charset (as written) and decoded bytes.
fn word_parts(word: Str) -> (Str, Bytes) ! MimeErr {
  let b = word.bytes()
  if b.len() < 8 || !word.starts_with("=?") || !word.ends_with("?=") || count_q(b) != 4 {
    return Err(err(INVALID_WORD))
  }
  let inner = word[2..word.len() - 2]
  let (charset, rest) = inner.cut("?") ?? (inner, "")
  if charset.is_empty() {
    return Err(err(INVALID_WORD))
  }
  let (enc, text) = rest.cut("?") ?? (rest, "")
  if enc.len() != 1 {
    return Err(err(INVALID_WORD))
  }
  (charset, word_content(enc.bytes()[0], text)?)
}

/// decode_word with Go's WordDecoder.CharsetReader: a charset other than
/// UTF-8, ISO-8859-1 and US-ASCII goes to reader, in lower case, with the
/// word's bytes, and its text (or error) is the result.
pub fn decode_word_with[fx: Effects](word: Str, reader: fn(Str, Bytes) -> Str ! MimeErr uses fx) -> Str ! MimeErr uses fx {
  let (charset, content) = word_parts(word)?
  match known_charset(charset, content) {
    Some(t) => Ok(t)
    None => reader(charset.to_lower(), content)
  }
}

/// A header with its encoded words decoded (WordDecoder.DecodeHeader):
/// text between two encoded words that is only white space is dropped, a
/// word that does not decode is kept as written; an unhandled charset is
/// the error, as decode_word's.
pub fn decode_header(header: Str) -> Str ! MimeErr {
  decode_header_by(header, fn(charset: Str, _content: Bytes) -> Str ! MimeErr { Err(err("mime: unhandled charset ${charset.quote()}")) })
}

/// decode_header with Go's WordDecoder.CharsetReader (decode_word_with's
/// reader for the other charsets).
pub fn decode_header_with[fx: Effects](header: Str, reader: fn(Str, Bytes) -> Str ! MimeErr uses fx) -> Str ! MimeErr uses fx {
  decode_header_by(header, fn(charset: Str, content: Bytes) -> Str ! MimeErr { reader(charset.to_lower(), content) })
}

/// DecodeHeader with other's text for a charset the three are not (given
/// as the word wrote it).
fn decode_header_by[fx: Effects](header: Str, other: fn(Str, Bytes) -> Str ! MimeErr uses fx) -> Str ! MimeErr uses fx {
  let first = match header.find("=?") {
    Some(i) => i
    None => return header
  }
  var buf = StrBuilder.new()
  buf.write(header[0..first])
  var h = header[first..]
  var between = false
  while true {
    let start = match h.find("=?") {
      Some(i) => i
      None => break
    }
    var cur = start + 2
    let i = match h[cur..].find("?") {
      Some(x) => x
      None => break
    }
    let charset = h[cur..cur + i]
    cur += i + 1
    if h.len() < cur + 4 {
      break
    }
    let enc = h.bytes()[cur]
    cur += 1
    if h.bytes()[cur] != '?' {
      break
    }
    cur += 1
    let j = match h[cur..].find("?=") {
      Some(x) => x
      None => break
    }
    let text = h[cur..cur + j]
    let end = cur + j + 2
    match word_content(enc, text) {
      Ok(content) => {
        if start > 0 && (!between || has_non_ws(h[0..start])) {
          buf.write(h[0..start])
        }
        buf.write(match known_charset(charset, content) {
          Some(t) => t
          None => other(charset, content)?
        })
        h = h[end..]
        between = true
      }
      Err(_) => {
        between = false
        buf.write(h[0..end])
        h = h[end..]
      }
    }
  }
  buf.write(h)
  buf.freeze()
}

const INVALID_WORD: Str = "mime: invalid RFC 2047 encoded-word"
const MAX_CONTENT_LEN: Int = 63
/// base64.StdEncoding.DecodedLen(63)
const MAX_BASE64_LEN: Int = 45

fn needs_encoding(s: Str) -> Bool {
  for r in s.runes() {
    if (r < ' ' || r > '~') && r != '\t' {
      return true
    }
  }
  false
}

fn is_utf8_name(charset: Str) -> Bool { charset.to_lower() == "utf-8" }

fn enc_letter(e: WordEncoding) -> Str { if e is B { "b" } else { "q" } }

fn open_word(var buf: StrBuilder, charset: Str, e: WordEncoding) {
  buf.write("=?")
  buf.write(charset)
  buf.write("?")
  buf.write(enc_letter(e))
  buf.write("?")
}

fn split_word(var buf: StrBuilder, charset: Str, e: WordEncoding) {
  buf.write("?= ")
  open_word(buf, charset, e)
}

fn rune_len_at(b: Bytes, i: Int) -> Int { b.decode_rune(i).1 }

fn b_encode(var buf: StrBuilder, charset: Str, e: WordEncoding, s: Bytes) {
  if !is_utf8_name(charset) || (s.len() + 2) / 3 * 4 <= MAX_CONTENT_LEN {
    buf.write(s.to_base64())
    return
  }
  var cur = 0
  var last = 0
  var i = 0
  while i < s.len() {
    let n = rune_len_at(s, i)
    if cur + n <= MAX_BASE64_LEN {
      cur += n
    } else {
      buf.write(s[last..i].to_base64())
      split_word(buf, charset, e)
      last = i
      cur = n
    }
    i += n
  }
  buf.write(s[last..].to_base64())
}

fn q_plain(c: UInt8) -> Bool { c >= 32 && c <= 126 && c != '=' && c != '?' && c != '_' }

fn q_encode(var buf: StrBuilder, charset: Str, e: WordEncoding, s: Bytes) {
  if !is_utf8_name(charset) {
    write_q(buf, s)
    return
  }
  var cur = 0
  var i = 0
  while i < s.len() {
    var n = 1
    var el = 1
    if !q_plain(s[i]) {
      n = rune_len_at(s, i)
      el = 3 * n
    }
    if cur + el > MAX_CONTENT_LEN {
      split_word(buf, charset, e)
      cur = 0
    }
    write_q(buf, s[i..i + n])
    cur += el
    i += n
  }
}

fn write_q(var buf: StrBuilder, s: Bytes) {
  var out = BytesBuilder.with_capacity(s.len() * 3)
  for c in s {
    if c == ' ' {
      out.write_byte('_')
    } else if c >= '!' && c <= '~' && c != '=' && c != '?' && c != '_' {
      out.write_byte(c)
    } else {
      out.write_byte('=')
      out.write_byte(UPPER_HEX.bytes()[Int(c) >> 4])
      out.write_byte(UPPER_HEX.bytes()[Int(c) & 15])
    }
  }
  // ASCII only
  buf.write(out.freeze().to_str() ?? "")
}

fn count_q(b: Bytes) -> Int {
  var n = 0
  for c in b {
    if c == '?' {
      n += 1
    }
  }
  n
}

fn word_content(enc: UInt8, text: Str) -> Bytes ! MimeErr {
  if enc == 'B' || enc == 'b' {
    if let Some(b) = Bytes.from_base64(text) {
      return b
    }
    return Err(err("illegal base64 data at input byte ${b64_bad_at(text.bytes())}"))
  }
  if enc == 'Q' || enc == 'q' {
    return q_decode(text.bytes())
  }
  Err(err(INVALID_WORD))
}

fn q_decode(s: Bytes) -> Bytes ! MimeErr {
  var out = BytesBuilder.with_capacity(s.len())
  var i = 0
  while i < s.len() {
    let c = s[i]
    if c == '_' {
      out.write_byte(' ')
    } else if c == '=' {
      if i + 2 >= s.len() {
        return Err(err(INVALID_WORD))
      }
      let hi = from_hex(s[i + 1])?
      let lo = from_hex(s[i + 2])?
      out.write_byte(UInt8(hi * 16 + lo))
      i += 2
    } else if (c <= '~' && c >= ' ') || c == '\n' || c == '\r' || c == '\t' {
      out.write_byte(c)
    } else {
      return Err(err(INVALID_WORD))
    }
    i += 1
  }
  out.freeze()
}

fn from_hex(b: UInt8) -> Int ! MimeErr {
  if b >= '0' && b <= '9' {
    return Int(b - '0')
  }
  if b >= 'A' && b <= 'F' {
    return Int(b - 'A') + 10
  }
  if b >= 'a' && b <= 'f' {
    return Int(b - 'a') + 10
  }
  Err(err("mime: invalid hex byte ${hex_byte(b)}"))
}

/// Go's %#02x of a byte: 0x and two hex digits.
fn hex_byte(b: UInt8) -> Str {
  let h = "0123456789abcdef"
  "0x" + h[(Int(b) >> 4)..(Int(b) >> 4) + 1] + h[(Int(b) & 15)..(Int(b) & 15) + 1]
}

fn convert_charset(charset: Str, content: Bytes) -> Str ! MimeErr {
  match known_charset(charset, content) {
    Some(t) => Ok(t)
    None => Err(err("mime: unhandled charset ${charset.quote()}"))
  }
}

/// content in UTF-8, ISO-8859-1 or US-ASCII as text; None for another
/// charset.
fn known_charset(charset: Str, content: Bytes) -> Str? {
  let l = charset.to_lower()
  if l == "utf-8" {
    return Some(to_text(content))
  }
  if l == "iso-8859-1" {
    var out = StrBuilder.new()
    for c in content {
      out.write("${Rune(Int(c))}")
    }
    return Some(out.freeze())
  }
  if l == "us-ascii" {
    var out = StrBuilder.new()
    for c in content {
      out.write(if c >= 128 { "\u{FFFD}" } else { "${Rune(Int(c))}" })
    }
    return Some(out.freeze())
  }
  None
}

/// content as UTF-8, a U+FFFD for each byte that is not.
fn to_text(b: Bytes) -> Str {
  if let Some(s) = b.to_str() {
    return s
  }
  var out = StrBuilder.new()
  var i = 0
  while i < b.len() {
    let (r, n) = b.decode_rune(i)
    out.write("${r}")
    i += n
  }
  out.freeze()
}

fn has_non_ws(s: Str) -> Bool {
  for c in s.bytes() {
    if !(c == ' ' || c == '\t' || c == '\n' || c == '\r') {
      return true
    }
  }
  false
}

/// The value of a standard base64 symbol, -1 for another byte.
fn b64_val(c: UInt8) -> Int {
  if c >= 'A' && c <= 'Z' { return Int(c - 'A') }
  if c >= 'a' && c <= 'z' { return Int(c - 'a') + 26 }
  if c >= '0' && c <= '9' { return Int(c - '0') + 52 }
  if c == '+' { return 62 }
  if c == '/' { return 63 }
  -1
}

/// Where Go's base64.StdEncoding.DecodeString reports a CorruptInputError
/// in src, which Bytes.from_base64 refused (std/base64 decode_with's walk,
/// padded, not strict; std/mime is compiled alone on the Go backend).
fn b64_bad_at(src: Bytes) -> Int {
  let n = src.len()
  var si = 0
  while si < n {
    var j = 0
    while j < 4 {
      if si == n {
        if j == 0 {
          return n
        }
        return si - j
      }
      let c = src[si]
      si += 1
      if b64_val(c) >= 0 {
        j += 1
        continue
      }
      if c == '\r' || c == '\n' {
        continue
      }
      if c != '=' || j < 2 {
        return si - 1
      }
      if j == 2 {
        while si < n && (src[si] == '\r' || src[si] == '\n') { si += 1 }
        if si == n {
          return n
        }
        if src[si] != '=' {
          return si - 1
        }
        si += 1
      }
      while si < n && (src[si] == '\r' || src[si] == '\n') { si += 1 }
      if si < n {
        return si
      }
      return n
    }
  }
  n
}

// Quoted-printable (RFC 2045 section 6.7): Go's mime/quotedprintable
// (go1.26 reader.go and writer.go), its Writer over all of data and then
// Close, and its Reader over all of data.

/// Go's quotedprintable.Writer: data in quoted-printable, lines of at most
/// 76 bytes broken by a soft line break (`=` CRLF), `=` and the bytes
/// outside `!` to `~` (but space and tab) as `=XX`, a line break as CRLF,
/// and a space or tab before a line break or at the end as `=20` or
/// `=09`. With binary (Go's Writer.Binary) CR and LF are bytes like any
/// other (`=0D`, `=0A`).
pub fn qp_encode(data: Bytes, binary: Bool = false) -> Bytes {
  var w = QpWriter{out: BytesBuilder.with_capacity(data.len() + data.len() / 8 + 8), col: 0, pend: -1, cr: false}
  let n = data.len()
  var i = 0
  while i < n {
    let b = data[i]
    if qp_plain(b) {
      // a run of plain bytes goes out as slices of what fits on the line
      var j = i + 1
      while j < n && qp_plain(data[j]) {
        j += 1
      }
      w.run(data, i, j)
      i = j
      continue
    }
    if qp_ws(b) || !binary && (b == 10 || b == 13) {
      w.put(b)
    } else {
      w.encode(b)
    }
    i += 1
  }
  w.check_last()
  w.out.freeze()
}

/// Go's quotedprintable.Reader over all of data: `=XX` (upper or lower
/// case hex) is the byte, a soft line break (`=` then CRLF or LF, spaces
/// and tabs between) is nothing, a line's trailing spaces, tabs and CR are
/// dropped (its LF or CRLF kept), and a `=` not followed by two hex digits
/// is itself unless the line ends there. Bytes from 128 up pass through.
/// Go's errors: `quotedprintable: invalid unescaped byte 0x00 in body`,
/// `quotedprintable: invalid hex byte 0x0d`, `quotedprintable: invalid
/// bytes after =: "\r"`, `unexpected EOF`, and `bufio: buffer full` for a
/// line of 4096 bytes or more before its LF (the Reader's bufio buffer).
pub fn qp_decode(data: Bytes) -> Bytes ! MimeErr {
  var out = BytesBuilder.with_capacity(data.len())
  var at = 0
  let n = data.len()
  while at < n {
    // ReadSlice('\n') over a 4096 byte bufio.Reader
    var end = at
    while end < n && data[end] != 10 {
      end += 1
    }
    // a line of 4096 bytes before its LF fills the buffer: its first
    // 4096 bytes are read, then the error
    let full = end - at >= 4096
    let has_lf = end < n && !full
    let stop = if full { at + 4096 } else if has_lf { end + 1 } else { end }
    let whole = data[at..stop]
    at = stop
    // ReadSlice's io.EOF: the last line, without an LF
    let eof = !has_lf && !full
    var k = whole.len()
    while k > 0 && (whole[k - 1] == 32 || whole[k - 1] == 9 || whole[k - 1] == 13 || whole[k - 1] == 10) {
      k -= 1
    }
    var line = whole[0..k]
    var tail = b""
    var after: List[MimeErr] = if full { [err("bufio: buffer full")] } else { [] }
    if k > 0 && whole[k - 1] == 61 {
      var j = k
      while j < whole.len() && (whole[j] == 32 || whole[j] == 9) {
        j += 1
      }
      let rest = whole[j..]
      line = whole[0..k - 1]
      let crlf_next = rest.len() >= 1 && rest[0] == 10 || rest.len() >= 2 && rest[0] == 13 && rest[1] == 10
      if !crlf_next && !(rest.len() == 0 && line.len() > 0 && eof) {
        after = [err("quotedprintable: invalid bytes after =: ${qp_quote(rest)}")]
      }
    } else if has_lf {
      tail = if whole.len() >= 2 && whole[whole.len() - 2] == 13 { b"\r\n" } else { b"\n" }
    }
    let l = if tail.len() == 0 { line } else { line + tail }
    var i = 0
    while i < l.len() {
      let b = l[i]
      if b == 61 {
        let hb = if i + 1 < l.len() { qp_hex(l[i + 1]) } else { -2 }
        let lb = if i + 2 < l.len() { qp_hex(l[i + 2]) } else { -2 }
        if hb >= 0 && lb >= 0 {
          out.write_byte(UInt8(hb * 16 + lb))
          i += 3
          continue
        }
        if i + 1 < l.len() && l[i + 1] != 13 && l[i + 1] != 10 {
          // a = not followed by two hex digits is itself
          out.write_byte(b)
          i += 1
          continue
        }
        if i + 2 >= l.len() {
          return Err(err("unexpected EOF"))
        }
        let bad = if hb < 0 { l[i + 1] } else { l[i + 2] }
        return Err(err("quotedprintable: invalid hex byte 0x${qp_hex2(bad)}"))
      }
      if !(b == 9 || b == 13 || b == 10 || b >= 128) && (b < 32 || b > 126) {
        return Err(err("quotedprintable: invalid unescaped byte 0x${qp_hex2(b)} in body"))
      }
      out.write_byte(b)
      i += 1
    }
    if !after.is_empty() {
      return Err(after[0])
    }
  }
  out.freeze()
}

/// Go's Writer, with its line held as what went out: col bytes of the
/// line so far, the last of them a space or tab not yet written when pend
/// is that byte (checkLastByte may encode it), and whether the last byte
/// was CR.
struct QpWriter {
  out: BytesBuilder
  col: Int
  pend: Int
  cr: Bool
}

fn qp_ws(b: UInt8) -> Bool { b == 32 || b == 9 }

/// Go's batched bytes: `!` to `~` but `=`.
fn qp_plain(b: UInt8) -> Bool { b >= 33 && b <= 126 && b != 61 }

/// The held space or tab, as itself.
fn (var w: QpWriter) release() {
  if w.pend >= 0 {
    w.out.write_byte(UInt8(w.pend))
    w.pend = -1
  }
}

/// Go's write of data[i..j], all plain: as many as fit before column 75,
/// then a soft line break, as Go's byte loop does.
fn (var w: QpWriter) run(data: Bytes, i: Int, j: Int) {
  w.release()
  var at = i
  while at < j {
    if w.col == 75 {
      w.soft_break()
    }
    let k = if j - at < 75 - w.col { j } else { at + 75 - w.col }
    w.out.write(data[at..k])
    w.col += k - at
    at = k
  }
  w.cr = false
}

/// Go's write, one byte: a line break, or a space or tab (held) after a
/// soft line break at 75.
fn (var w: QpWriter) put(b: UInt8) {
  if b == 10 || b == 13 {
    // the CRLF of a CR LF pair went out with the CR
    if w.cr && b == 10 {
      w.cr = false
      return
    }
    if b == 13 {
      w.cr = true
    }
    w.check_last()
    w.crlf()
    return
  }
  if w.col == 75 {
    w.soft_break()
  }
  w.release()
  w.pend = Int(b)
  w.col += 1
  w.cr = false
}

fn (var w: QpWriter) encode(b: UInt8) {
  if 75 - w.col < 3 {
    w.soft_break()
  }
  w.release()
  w.out.write_byte(61)
  w.out.write_byte(qp_upper_hex(Int(b) >> 4))
  w.out.write_byte(qp_upper_hex(Int(b) & 15))
  w.col += 3
}

/// checkLastByte: a space or tab at the end of a line is encoded.
fn (var w: QpWriter) check_last() {
  if w.pend >= 0 {
    let b = UInt8(w.pend)
    w.pend = -1
    w.col -= 1
    w.encode(b)
  }
}

fn (var w: QpWriter) soft_break() {
  w.release()
  w.out.write_byte(61)
  w.crlf()
}

fn (var w: QpWriter) crlf() {
  w.release()
  w.out.write_byte(13)
  w.out.write_byte(10)
  w.col = 0
}

/// Go's upperhex digit of d (0 to 15).
fn qp_upper_hex(d: Int) -> UInt8 { UInt8(if d < 10 { 48 + d } else { 55 + d }) }

fn qp_hex(c: UInt8) -> Int {
  if c >= 48 && c <= 57 {
    Int(c) - 48
  } else if c >= 65 && c <= 70 {
    Int(c) - 55
  } else if c >= 97 && c <= 102 {
    Int(c) - 87
  } else {
    -1
  }
}

fn qp_hex2(b: UInt8) -> Str {
  let h = "0123456789abcdef"
  h[Int(b) >> 4..(Int(b) >> 4) + 1] + h[Int(b) & 15..(Int(b) & 15) + 1]
}

/// Go's %q of the bytes after a soft break's =: spaces, tabs, CR and LF.
fn qp_quote(b: Bytes) -> Str {
  var s = "\""
  for c in b {
    s += if c == 13 { "\\r" } else if c == 10 { "\\n" } else if c == 9 { "\\t" } else { " " }
  }
  s + "\""
}
