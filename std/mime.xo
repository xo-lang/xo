// std/mime (spec/std.md 23, decision 0282). Encoding
// rules are listed at the top of std/prelude.xo. Go's mime: media types
// (RFC 2045, 2231), the extension table (Go's builtin one only, the same
// on every OS), and content sniffing (net/http's DetectContentType). Pure.
//
// std/mime on the native backends (decision 0282): Go's mime ported from
// mediatype.go, grammar.go, and type.go of go1.26 (ParseMediaType,
// FormatMediaType, TypeByExtension and ExtensionsByType over the builtin
// table only), with the same results and error texts; and net/http's
// sniff.go (DetectContentType) in mime_sniff.xo. Go's ParseMediaType
// also returns the media type with ErrInvalidMediaParameter; Xo returns
// the error alone.

/// A media type: the type and subtype in lower case ("text/html") and its
/// parameters, names in lower case.
pub struct MediaType {
  pub kind: Str
  pub params: Map[Str, Str]
}

/// Go's error texts: `mime: no media type`, `mime: invalid media parameter`, ...
pub struct MimeErr {
  pub msg: Str
}

pub fn (e: MimeErr) display() -> Str { e.msg }

/// `text/html; charset=utf-8` into its parts (mime.ParseMediaType): RFC
/// 2231 continuations and charsets (utf-8, us-ascii) decoded.
pub fn parse_media_type(v: Str) -> MediaType ! MimeErr {
  let base = match v.find(";") {
    Some(i) => v[0..i]
    None => v
  }
  // kind and the parameters are stored in the result: copies for a long v0,
  // so a long-lived token does not keep it alive (decision 0330, Str.clone;
  // a copy per token is +14% on a 40 byte media type)
  let big = v.len() > OWN_MIN
  let kind = own(base.to_lower().trim(), big)
  check_media_type_disposition(kind)?
  var params: Map[Str, Str] = {}
  // the RFC 2231 pieces of each name: name*, name*0, name*0*, ...
  var cont: Map[Str, Map[Str, Str]] = {}
  var v1 = v[base.len()..]
  while !v1.is_empty() {
    v1 = v1.trim_start()
    if v1.is_empty() {
      break
    }
    let (key, value, rest) = consume_media_param(v1)
    if key.is_empty() {
      if rest.trim() == ";" {
        // a trailing semicolon
        break
      }
      return Err(err("mime: invalid media parameter"))
    }
    match key.find("*") {
      Some(i) => {
        let name = key[0..i]
        var pieces = cont.get(name) ?? {}
        if let Some(old) = pieces.get(key) {
          if old != value {
            return Err(err("mime: duplicate parameter name"))
          }
        }
        pieces.put(key, value)
        cont.put(name, pieces)
      }
      None => {
        if let Some(old) = params.get(key) {
          if old != value {
            return Err(err("mime: duplicate parameter name"))
          }
        }
        params.put(own(key, big), own(value, big))
      }
    }
    v1 = rest
  }
  // most values have no RFC 2231 piece: no entries list to build
  if cont.is_empty() {
    return Ok(MediaType{kind: kind, params: params})
  }
  for (key, pieces) in cont.entries() {
    if let Some(single) = pieces.get(key + "*") {
      if let Some(d) = decode_2231(single) {
        params.put(own(key, big), own(d, big))
      }
      continue
    }
    var buf = StrBuilder.new()
    var valid = false
    var n = 0
    while {
      let simple = "${key}*${n}"
      if let Some(p) = pieces.get(simple) {
        valid = true
        buf.write(p)
        n += 1
        continue
      }
      match pieces.get(simple + "*") {
        None => break
        Some(p) => {
          valid = true
          if n == 0 {
            if let Some(d) = decode_2231(p) {
              buf.write(d)
            }
          } else {
            buf.write(percent_hex_unescape(p) ?? "")
          }
        }
      }
      n += 1
    }
    if valid {
      params.put(own(key, big), buf.freeze())
    }
  }
  MediaType{kind: kind, params: params}
}

/// The text of a media type and its parameters, sorted by name, quoted or
/// RFC 2231 encoded as needed (mime.FormatMediaType); "" when the type or
/// a name is not a token.
pub fn format_media_type(kind: Str, params: Map[Str, Str]) -> Str {
  var b = StrBuilder.new()
  match kind.find("/") {
    None => {
      let kc = token_case(kind)
      if kc < 0 {
        return ""
      }
      write_cased(b, kind, kc)
    }
    Some(i) => {
      let major = kind[0..i]
      let sub = kind[i + 1..]
      let mc = token_case(major)
      let sc = token_case(sub)
      if mc < 0 || sc < 0 {
        return ""
      }
      write_cased(b, major, mc)
      b.write("/")
      write_cased(b, sub, sc)
    }
  }
  let hex = UPPER_HEX.bytes()
  // the (attribute, value) pairs by attribute: one walk of the map and an
  // insertion sort (a few parameters), where keys().sort() and a lookup a
  // key hashed each again
  var ps: List[(Str, Str)] = []
  for (k, v) in params {
    var at = ps.len()
    while at > 0 && ps[at - 1].0 > k {
      at -= 1
    }
    ps.insert(at, (k, v))
  }
  for (attr, value) in ps {
    b.write("; ")
    let ac = token_case(attr)
    if ac < 0 {
      return ""
    }
    write_cased(b, attr, ac)
    let vc = value_class(value)
    if vc == 2 {
      b.write("*=utf-8''")
      var out = BytesBuilder.new()
      for ch in value.bytes() {
        if ch <= 32 || ch >= 127 || ch == 42 || ch == 39 || ch == 37 || is_tspecial(ch) {
          out.write_byte(37)
          out.write_byte(hex[Int(ch) >> 4])
          out.write_byte(hex[Int(ch) & 15])
        } else {
          out.write_byte(ch)
        }
      }
      b.write(out.freeze().to_str() ?? "")
      continue
    }
    b.write("=")
    if vc == 0 {
      b.write(value)
      continue
    }
    // the quoted string in one pass (Go's FormatMediaType loop), where
    // two replace calls each scanned and copied the value
    b.write("\"")
    let vb = value.bytes()
    var from = 0
    for k in 0..vb.len() {
      if vb[k] == 92 || vb[k] == 34 {
        b.write(value[from..k])
        b.write("\\")
        from = k
      }
    }
    b.write(value[from..vb.len()])
    b.write("\"")
  }
  b.freeze()
}

/// The type of an extension (".png" -> "image/png"), from Go's builtin
/// table: an exact match, else without ASCII case.
pub fn type_by_extension(ext: Str) -> Str? {
  if let Some(t) = builtin_type(ext) {
    return Some(t)
  }
  // Go lowers ASCII letters, or the whole text when it is not ASCII; an
  // extension with neither (most misses) cannot match lowered
  var upper = false
  for c in ext.bytes() {
    if c >= 65 && c <= 90 || c >= 128 {
      upper = true
      break
    }
  }
  if !upper {
    return None
  }
  builtin_type(ext.to_lower())
}

/// The extensions of a media type, sorted (mime.ExtensionsByType).
pub fn extensions_by_type(kind: Str) -> List[Str] ! MimeErr {
  let t = parse_media_type(kind)?.kind
  var out: List[Str] = []
  for (k, v) in BUILTIN {
    if (parse_media_type(v).ok() ?? MediaType{kind: "", params: {}}).kind == t {
      out.push(k)
    }
  }
  out.sort()
}

/// The media type of data from its first 512 bytes (WHATWG MIME Sniffing,
/// net/http's DetectContentType); "application/octet-stream" when nothing
/// matches.
pub fn detect_content_type(data: Bytes) -> Str {
  let data1 = if data.len() > 512 { data[0..512] } else { data }
  var first = 0
  while first < data1.len() && is_ws(data1[first]) {
    first += 1
  }
  for s in SIGS {
    if sig_hit(s, data1, first) {
      return sig_type(s)
    }
  }
  "application/octet-stream"
}

fn err(msg: Str) -> MimeErr { MimeErr{msg: msg} }

const UPPER_HEX: Str = "0123456789ABCDEF"

/// grammar.go isTSpecial: ( ) < > @ , ; : \ " / [ ] ? =
fn is_tspecial(c: UInt8) -> Bool {
  c == 40 || c == 41 || c == 60 || c == 62 || c == 64 || c == 44 || c == 59 || c == 58 || c == 92 || c == 34 ||
    c == 47 || c == 91 || c == 93 || c == 63 || c == 61
}

/// grammar.go isTokenChar: a US-ASCII character but space, controls, and tspecials.
/// One for each token character (the table of is_token_char).
const TOKEN_CHARS: Bytes = b"\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x01\x01\x01\x01\x01\x00\x00\x01\x01\x00\x01\x01\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00"

fn is_token_char(c: UInt8) -> Bool {
  let i = Int(c)
  TOKEN_CHARS[i] == 1
}

/// -1 when s is not a token, else 1 when it has an upper case letter and 0
/// when not: is_token and the lower case test in one pass.
fn token_case(s: Str) -> Int {
  if s.is_empty() {
    return -1
  }
  var upper = 0
  for c in s.bytes() {
    if !is_token_char(c) {
      return -1
    }
    if c >= 65 && c <= 90 {
      upper = 1
    }
  }
  upper
}

/// s (a token) in lower case, given its token_case.
fn write_cased(var b: StrBuilder, s: Str, upper: Int) {
  if upper == 1 {
    b.write(s.to_lower())
  } else {
    b.write(s)
  }
}

fn is_token(s: Str) -> Bool {
  if s.is_empty() {
    return false
  }
  for c in s.bytes() {
    if !is_token_char(c) {
      return false
    }
  }
  true
}

/// One scan of a parameter value: 2 when it needs encoding (mediatype.go needsEncoding),
/// else 1 when it is not a token, else 0.
fn value_class(s: Str) -> Int {
  var cls = if s.is_empty() { 1 } else { 0 }
  for c in s.bytes() {
    if (c < 32 || c > 126) && c != 9 {
      return 2
    }
    if !is_token_char(c) {
      cls = 1
    }
  }
  cls
}

/// The token at the start of v and the rest (consumeToken).
fn consume_token(v: Str) -> (Str, Str) {
  let b = v.bytes()
  var i = 0
  while i < b.len() && is_token_char(b[i]) {
    i += 1
  }
  (v[0..i], v[i..])
}

fn check_media_type_disposition(s: Str) -> () ! MimeErr {
  let (typ, rest0) = consume_token(s)
  if typ.is_empty() {
    return Err(err("mime: no media type"))
  }
  if rest0.is_empty() {
    return Ok(())
  }
  if !rest0.starts_with("/") {
    return Err(err("mime: expected slash after first token"))
  }
  let (sub, rest) = consume_token(rest0[1..])
  if sub.is_empty() {
    return Err(err("mime: expected token after slash"))
  }
  if !rest.is_empty() {
    return Err(err("mime: unexpected content after media subtype"))
  }
}

/// consumeValue: a token or a quoted string; ("", v) when malformed.
fn consume_value(v: Str) -> (Str, Str) {
  if v.is_empty() {
    return ("", "")
  }
  if !v.starts_with("\"") {
    return consume_token(v)
  }
  let b = v.bytes()
  // a quoted string with no backslash is its bytes as they are: a view of
  // v, not a copy (Go's loop copies into a builder either way)
  var j = 1
  while j < b.len() {
    let r = b[j]
    if r == 34 {
      return (v[1..j], v[j + 1..])
    }
    if r == 92 || r == 13 || r == 10 {
      break
    }
    j += 1
  }
  if j >= b.len() {
    return ("", v)
  }
  var out = BytesBuilder.new()
  var i = 1
  var end = -1
  while i < b.len() {
    let r = b[i]
    if r == 34 {
      end = i
      break
    }
    if r == 92 && i + 1 < b.len() && is_tspecial(b[i + 1]) {
      out.write_byte(b[i + 1])
      i += 2
      continue
    }
    if r == 13 || r == 10 {
      break
    }
    out.write_byte(r)
    i += 1
  }
  if end < 0 {
    return ("", v)
  }
  (out.freeze().to_str() ?? "", v[end + 1..])
}

/// consumeMediaParam: (name, value, rest), or ("", "", v) when v does not
/// start with a parameter.
fn consume_media_param(v: Str) -> (Str, Str, Str) {
  var rest = v.trim_start()
  if !rest.starts_with(";") {
    return ("", "", v)
  }
  rest = rest[1..].trim_start()
  let (p0, r1) = consume_token(rest)
  let param = p0.to_lower()
  if param.is_empty() {
    return ("", "", v)
  }
  rest = r1.trim_start()
  if !rest.starts_with("=") {
    return ("", "", v)
  }
  rest = rest[1..].trim_start()
  let (value, rest2) = consume_value(rest)
  if value.is_empty() && rest2 == rest {
    return ("", "", v)
  }
  (param, value, rest2)
}

fn is_hex(c: UInt8) -> Bool { (c >= 48 && c <= 57) || (c >= 97 && c <= 102) || (c >= 65 && c <= 70) }

fn unhex(c: UInt8) -> Int {
  let v = Int(c)
  if v <= 57 { v - 48 } else if v <= 70 { v - 55 } else { v - 87 }
}

/// percentHexUnescape; None for a bad escape.
fn percent_hex_unescape(s: Str) -> Str? {
  let b = s.bytes()
  if !s.contains("%") {
    return Some(s)
  }
  var out = BytesBuilder.with_capacity(b.len())
  var i = 0
  while i < b.len() {
    if b[i] != 37 {
      out.write_byte(b[i])
      i += 1
      continue
    }
    if i + 2 >= b.len() || !is_hex(b[i + 1]) || !is_hex(b[i + 2]) {
      return None
    }
    out.write_byte(UInt8(unhex(b[i + 1]) * 16 + unhex(b[i + 2])))
    i += 3
  }
  // bytes that are not UTF-8 cannot be a Str: such a value is dropped as
  // an undecodable one
  out.freeze().to_str()
}

/// decode2231Enc: charset'language'value with utf-8 or us-ascii.
fn decode_2231(v: Str) -> Str? {
  let q1 = v.find("'")?
  let charset = v[0..q1].to_lower()
  let rest = v[q1 + 1..]
  let q2 = rest.find("'")?
  if !(charset is "us-ascii" | "utf-8") {
    return None
  }
  percent_hex_unescape(rest[q2 + 1..])
}

/// A media type longer than this has its tokens copied (Str.clone). The rule
/// depends on the value being a small object of its own: the server's header
/// values are copies (http1 text_of, text_at), never slices of the read buffer.
const OWN_MIN = 4096

fn own(s: Str, big: Bool) -> Str { if big { s.clone() } else { s } }

