// std/protodesc (decision 0546, item 1). Encoding rules are
// listed at the top of std/prelude.xo. The descriptors of google/protobuf/
// descriptor.proto that reflection, ProtoJSON and Any resolve names through:
// FileDescriptorProto and the messages under it as Xo values, with the wire
// codec written by hand over std/protobuf (derive Proto does not expand in std).
// Options messages are kept as their wire bytes (`options`), unknown fields as
// theirs (`unknown`, written after the known ones), so a descriptor made by
// protoc or protobuf-go decodes and encodes back to the same bytes. Pure.
//
// std/protodesc on the native backends (decision 0546): descriptor.proto's
// FileDescriptorProto and its messages, read and written by hand.

use std/protobuf
use std/protoparse
use std/protowire as pw

/// FieldDescriptorProto.Label.
pub const LABEL_OPTIONAL: Int = 1

pub const LABEL_REQUIRED: Int = 2

pub const LABEL_REPEATED: Int = 3

/// FieldDescriptorProto.Type.
pub const TYPE_DOUBLE: Int = 1

pub const TYPE_FLOAT: Int = 2

pub const TYPE_INT64: Int = 3

pub const TYPE_UINT64: Int = 4

pub const TYPE_INT32: Int = 5

pub const TYPE_FIXED64: Int = 6

pub const TYPE_FIXED32: Int = 7

pub const TYPE_BOOL: Int = 8

pub const TYPE_STRING: Int = 9

pub const TYPE_GROUP: Int = 10

pub const TYPE_MESSAGE: Int = 11

pub const TYPE_BYTES: Int = 12

pub const TYPE_UINT32: Int = 13

pub const TYPE_ENUM: Int = 14

pub const TYPE_SFIXED32: Int = 15

pub const TYPE_SFIXED64: Int = 16

pub const TYPE_SINT32: Int = 17

pub const TYPE_SINT64: Int = 18

/// A `start` to `end` range (DescriptorProto.ReservedRange and EnumReservedRange; end is exclusive for
/// messages and inclusive for enums, as in descriptor.proto).
pub struct ReservedRange {
  pub start: Int
  pub end: Int
} derive Eq

pub struct ExtensionRange {
  pub start: Int
  pub end: Int
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
} derive Eq

pub struct OneofDesc {
  pub name: Str
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
} derive Eq

/// FieldDescriptorProto. `kind` is the proto `type` (TYPE_*), `type_name` the fully qualified name with
/// its leading dot (`.pkg.Msg`) for a message or enum field.
pub struct FieldDesc {
  pub name: Str
  pub extendee: Str = ""
  pub number: Int
  pub label: Int = 0
  pub kind: Int = 0
  pub type_name: Str = ""
  pub default_value: Str = ""
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
  pub oneof_index: Int? = None
  pub json_name: Str = ""
  /// json_name was on the wire, also when empty (protoc writes a field named `_` an empty one).
  pub json_name_set: Bool = false
  pub proto3_optional: Bool = false
  /// proto3_optional was on the wire, also when false (protobuf-go writes it back).
  pub proto3_optional_set: Bool = false
  pub unknown: Bytes = b""
} derive Eq

pub struct EnumValueDesc {
  pub name: Str
  pub number: Int
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
} derive Eq

pub struct EnumDesc {
  pub name: Str
  pub value: List[EnumValueDesc] = []
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
  pub reserved_range: List[ReservedRange] = []
  pub reserved_name: List[Str] = []
} derive Eq

pub struct MessageDesc {
  pub name: Str
  pub field: List[FieldDesc] = []
  pub extension: List[FieldDesc] = []
  pub nested_type: List[MessageDesc] = []
  pub enum_type: List[EnumDesc] = []
  pub extension_range: List[ExtensionRange] = []
  pub oneof_decl: List[OneofDesc] = []
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
  pub reserved_range: List[ReservedRange] = []
  pub reserved_name: List[Str] = []
} derive Eq

pub struct MethodDesc {
  pub name: Str
  pub input_type: Str
  pub output_type: Str
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
  pub client_streaming: Bool = false
  pub server_streaming: Bool = false
  /// Bit 1: `client_streaming` and bit 2: `server_streaming` were present on the wire, also when false (a proto2
  /// optional field written as false), so the descriptor encodes back to the same bytes.
  pub streaming_set: Int = 0
} derive Eq

pub struct ServiceDesc {
  pub name: Str
  pub method: List[MethodDesc] = []
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
} derive Eq

/// FileDescriptorProto. `syntax` is `proto2` (written as empty), `proto3` or `editions`.
pub struct FileDesc {
  pub name: Str
  pub package: Str = ""
  pub dependency: List[Str] = []
  pub public_dependency: List[Int] = []
  pub weak_dependency: List[Int] = []
  pub message_type: List[MessageDesc] = []
  pub enum_type: List[EnumDesc] = []
  pub service: List[ServiceDesc] = []
  pub extension: List[FieldDesc] = []
  pub options: Bytes = b""
  /// The options message was on the wire, also when empty.
  pub options_set: Bool = false
  pub source_code_info: Bytes = b""
  pub syntax: Str = ""
  pub edition: Int = 0
} derive Eq

/// The wire bytes of `f` (a serialized FileDescriptorProto), fields in field number order.
pub fn encode(f: FileDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, f.name)
  pw.ws(o, 2, f.package)
  for d in f.dependency {
    pw.wsa(o, 3, d)
  }
  for m in f.message_type {
    pw.wm(o, 4, enc_message(m))
  }
  for e in f.enum_type {
    pw.wm(o, 5, enc_enum(e))
  }
  for s in f.service {
    pw.wm(o, 6, enc_service(s))
  }
  for x in f.extension {
    pw.wm(o, 7, enc_field(x))
  }
  pw.wop(o, 8, f.options, f.options_set)
  pw.wo(o, 9, f.source_code_info)
  for i in f.public_dependency {
    pw.wia(o, 10, i)
  }
  for i in f.weak_dependency {
    pw.wia(o, 11, i)
  }
  pw.ws(o, 12, f.syntax)
  pw.wi(o, 14, f.edition)
  o.freeze()
}

/// A singular string field's text and `bad` with the field's bit set when its bytes are not UTF-8,
/// cleared when they are: protobuf-go keeps a repeated singular field's last value, so only the last
/// one has to be text (decode fails with `Utf8` when a bit is still set at the end).
fn last_text(f: pw.Fld, bad: Int) -> (Str, Int) {
  let bit = 1 << f.num
  match f.data.to_str() {
    Some(s) => (s, if bad & bit != 0 { bad - bit } else { bad })
    None => ("", bad | bit)
  }
}

/// The FileDescriptorProto of `data`; the wire reader's errors, and `Utf8` for a name that is not text.
pub fn decode(data: Bytes) -> FileDesc ! protobuf.ProtoErr {
  var d = FileDesc{name: "", package: "", dependency: [], public_dependency: [], weak_dependency: [], message_type: [], enum_type: [], service: [], extension: [], options: b"", source_code_info: b"", syntax: "", edition: 0}
  var bad = 0
  for f in pw.walk(data)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      (d.package, bad) = last_text(f, bad)
    } else if f.num == 3 && pw.is_s(f) {
      d.dependency.push(pw.text(f)?)
    } else if f.num == 4 && pw.is_s(f) {
      d.message_type.push(dec_message(f.data)?)
    } else if f.num == 5 && pw.is_s(f) {
      d.enum_type.push(dec_enum(f.data)?)
    } else if f.num == 6 && pw.is_s(f) {
      d.service.push(dec_service(f.data)?)
    } else if f.num == 7 && pw.is_s(f) {
      d.extension.push(dec_field(f.data)?)
    } else if f.num == 8 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    } else if f.num == 9 && pw.is_s(f) {
      d.source_code_info = f.data
    } else if f.num == 10 && pw.is_v(f) {
      d.public_dependency.push(f.v)
    } else if f.num == 10 && pw.is_s(f) {
      for v in packed(f.data)? {
        d.public_dependency.push(v)
      }
    } else if f.num == 11 && pw.is_v(f) {
      d.weak_dependency.push(f.v)
    } else if f.num == 12 && pw.is_s(f) {
      (d.syntax, bad) = last_text(f, bad)
    } else if f.num == 14 && pw.is_v(f) {
      d.edition = f.v
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn enc_range(r: ReservedRange) -> Bytes {
  var o = BytesBuilder.new()
  pw.wia(o, 1, r.start)
  pw.wia(o, 2, r.end)
  o.freeze()
}

fn enc_ext_range(r: ExtensionRange) -> Bytes {
  var o = BytesBuilder.new()
  pw.wia(o, 1, r.start)
  pw.wia(o, 2, r.end)
  pw.wop(o, 3, r.options, r.options_set)
  o.freeze()
}

fn enc_oneof(d: OneofDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, d.name)
  pw.wop(o, 2, d.options, d.options_set)
  o.freeze()
}

fn enc_field(f: FieldDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, f.name)
  pw.ws(o, 2, f.extendee)
  pw.wi(o, 3, f.number)
  pw.wi(o, 4, f.label)
  pw.wi(o, 5, f.kind)
  pw.ws(o, 6, f.type_name)
  pw.ws(o, 7, f.default_value)
  pw.wop(o, 8, f.options, f.options_set)
  match f.oneof_index {
    Some(i) => pw.wia(o, 9, i)
    None => {}
  }
  if f.json_name_set && f.json_name.is_empty() {
    pw.wtag(o, 10, 2)
    pw.wv(o, 0)
  } else {
    pw.ws(o, 10, f.json_name)
  }
  pw.wbp(o, 17, f.proto3_optional, f.proto3_optional_set)
  o.write(f.unknown)
  o.freeze()
}

fn enc_value(v: EnumValueDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, v.name)
  pw.wia(o, 2, v.number)
  pw.wop(o, 3, v.options, v.options_set)
  o.freeze()
}

fn enc_enum(e: EnumDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, e.name)
  for v in e.value {
    pw.wm(o, 2, enc_value(v))
  }
  pw.wop(o, 3, e.options, e.options_set)
  for r in e.reserved_range {
    pw.wm(o, 4, enc_range(r))
  }
  for n in e.reserved_name {
    pw.wsa(o, 5, n)
  }
  o.freeze()
}

fn enc_message(m: MessageDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, m.name)
  for f in m.field {
    pw.wm(o, 2, enc_field(f))
  }
  for n in m.nested_type {
    pw.wm(o, 3, enc_message(n))
  }
  for e in m.enum_type {
    pw.wm(o, 4, enc_enum(e))
  }
  for r in m.extension_range {
    pw.wm(o, 5, enc_ext_range(r))
  }
  for f in m.extension {
    pw.wm(o, 6, enc_field(f))
  }
  pw.wop(o, 7, m.options, m.options_set)
  for d in m.oneof_decl {
    pw.wm(o, 8, enc_oneof(d))
  }
  for r in m.reserved_range {
    pw.wm(o, 9, enc_range(r))
  }
  for n in m.reserved_name {
    pw.wsa(o, 10, n)
  }
  o.freeze()
}

fn enc_method(m: MethodDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, m.name)
  pw.ws(o, 2, m.input_type)
  pw.ws(o, 3, m.output_type)
  pw.wop(o, 4, m.options, m.options_set)
  pw.wbp(o, 5, m.client_streaming, (m.streaming_set & 1) != 0)
  pw.wbp(o, 6, m.server_streaming, (m.streaming_set & 2) != 0)
  o.freeze()
}

fn enc_service(s: ServiceDesc) -> Bytes {
  var o = BytesBuilder.new()
  pw.ws(o, 1, s.name)
  for m in s.method {
    pw.wm(o, 2, enc_method(m))
  }
  pw.wop(o, 3, s.options, s.options_set)
  o.freeze()
}

fn dec_range(b: Bytes) -> ReservedRange ! protobuf.ProtoErr {
  var r = ReservedRange{start: 0, end: 0}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_v(f) {
      r.start = f.v
    } else if f.num == 2 && pw.is_v(f) {
      r.end = f.v
    }
  }
  Ok(r)
}

fn dec_ext_range(b: Bytes) -> ExtensionRange ! protobuf.ProtoErr {
  var r = ExtensionRange{start: 0, end: 0, options: b""}
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_v(f) {
      r.start = f.v
    } else if f.num == 2 && pw.is_v(f) {
      r.end = f.v
    } else if f.num == 3 && pw.is_s(f) {
      r.options = f.data
      r.options_set = true
    }
  }
  Ok(r)
}

fn dec_oneof(b: Bytes) -> OneofDesc ! protobuf.ProtoErr {
  var d = OneofDesc{name: "", options: b""}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_field(b: Bytes) -> FieldDesc ! protobuf.ProtoErr {
  var d = FieldDesc{name: "", extendee: "", number: 0, label: 0, kind: 0, type_name: "", default_value: "", options: b"", oneof_index: None, json_name: "", proto3_optional: false, unknown: b""}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      (d.extendee, bad) = last_text(f, bad)
    } else if f.num == 3 && pw.is_v(f) {
      d.number = f.v
    } else if f.num == 4 && pw.is_v(f) {
      d.label = f.v
    } else if f.num == 5 && pw.is_v(f) {
      d.kind = f.v
    } else if f.num == 6 && pw.is_s(f) {
      (d.type_name, bad) = last_text(f, bad)
    } else if f.num == 7 && pw.is_s(f) {
      (d.default_value, bad) = last_text(f, bad)
    } else if f.num == 8 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    } else if f.num == 9 && pw.is_v(f) {
      d.oneof_index = Some(f.v)
    } else if f.num == 10 && pw.is_s(f) {
      (d.json_name, bad) = last_text(f, bad)
      d.json_name_set = true
    } else if f.num == 17 && pw.is_v(f) {
      d.proto3_optional = f.v != 0
      d.proto3_optional_set = true
    } else {
      d.unknown = pw.cat(d.unknown, f.raw)
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_value(b: Bytes) -> EnumValueDesc ! protobuf.ProtoErr {
  var d = EnumValueDesc{name: "", number: 0, options: b""}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_v(f) {
      d.number = f.v
    } else if f.num == 3 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_enum(b: Bytes) -> EnumDesc ! protobuf.ProtoErr {
  var d = EnumDesc{name: "", value: [], options: b"", reserved_range: [], reserved_name: []}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      d.value.push(dec_value(f.data)?)
    } else if f.num == 3 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    } else if f.num == 4 && pw.is_s(f) {
      d.reserved_range.push(dec_range(f.data)?)
    } else if f.num == 5 && pw.is_s(f) {
      d.reserved_name.push(pw.text(f)?)
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_message(b: Bytes) -> MessageDesc ! protobuf.ProtoErr {
  var d = MessageDesc{name: "", field: [], extension: [], nested_type: [], enum_type: [], extension_range: [], oneof_decl: [], options: b"", reserved_range: [], reserved_name: []}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      d.field.push(dec_field(f.data)?)
    } else if f.num == 3 && pw.is_s(f) {
      d.nested_type.push(dec_message(f.data)?)
    } else if f.num == 4 && pw.is_s(f) {
      d.enum_type.push(dec_enum(f.data)?)
    } else if f.num == 5 && pw.is_s(f) {
      d.extension_range.push(dec_ext_range(f.data)?)
    } else if f.num == 6 && pw.is_s(f) {
      d.extension.push(dec_field(f.data)?)
    } else if f.num == 7 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    } else if f.num == 8 && pw.is_s(f) {
      d.oneof_decl.push(dec_oneof(f.data)?)
    } else if f.num == 9 && pw.is_s(f) {
      d.reserved_range.push(dec_range(f.data)?)
    } else if f.num == 10 && pw.is_s(f) {
      d.reserved_name.push(pw.text(f)?)
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_method(b: Bytes) -> MethodDesc ! protobuf.ProtoErr {
  var d = MethodDesc{name: "", input_type: "", output_type: "", options: b"", client_streaming: false, server_streaming: false, streaming_set: 0}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      (d.input_type, bad) = last_text(f, bad)
    } else if f.num == 3 && pw.is_s(f) {
      (d.output_type, bad) = last_text(f, bad)
    } else if f.num == 4 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    } else if f.num == 5 && pw.is_v(f) {
      d.client_streaming = f.v != 0
      d.streaming_set = d.streaming_set | 1
    } else if f.num == 6 && pw.is_v(f) {
      d.server_streaming = f.v != 0
      d.streaming_set = d.streaming_set | 2
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

fn dec_service(b: Bytes) -> ServiceDesc ! protobuf.ProtoErr {
  var d = ServiceDesc{name: "", method: [], options: b""}
  var bad = 0
  for f in pw.walk(b)? {
    if f.num == 1 && pw.is_s(f) {
      (d.name, bad) = last_text(f, bad)
    } else if f.num == 2 && pw.is_s(f) {
      d.method.push(dec_method(f.data)?)
    } else if f.num == 3 && pw.is_s(f) {
      d.options = f.data
      d.options_set = true
    }
  }
  if bad != 0 { return Err(protobuf.ProtoErr.Utf8) }
  Ok(d)
}

/// The values of a packed varint run (descriptor.proto writes these unpacked; a reader accepts both).
fn packed(b: Bytes) -> List[Int] ! protobuf.ProtoErr {
  var out: List[Int] = []
  var at = 0
  while at < b.len() {
    let (v, next) = protobuf.read_varint(b, at)?
    out.push(v.to_bits())
    at = next
  }
  Ok(out)
}

// Building descriptors from std/protoparse (#109), as protoc's parser and its descriptor
// builder do: names resolved by protobuf's scoping rules, a map field's entry message, a proto3
// `optional` field's synthetic oneof, json_name, and the options descriptor.proto defines.

/// The indexes into imports of the paths in marked (public_dependency,
/// weak_dependency), in import order.
fn import_indexes(imports: List[Str], marked: List[Str]) -> List[Int] {
  var out: List[Int] = []
  for (i, p) in imports.indexed() {
    if marked.contains(p) {
      out.push(i)
    }
  }
  out
}

/// The FileDescriptorProto protoc writes (`--descriptor_set_out`, no source info) for `f` parsed from
/// the file `name`; `deps` are the descriptors of the files it imports (and theirs), for the names it
/// uses from them. An unknown type is an error at line 0. Options descriptor.proto does not define
/// (custom options) and aggregate option values are left out.
pub fn build(f: protoparse.File, name: Str, deps: List[FileDesc] = []) -> FileDesc ! protoparse.ParseErr {
  var syms: Map[Str, Int] = {}
  for d in deps {
    let pre = if d.package.is_empty() { "" } else { d.package + "." }
    for m in d.message_type { b_syms_desc(syms, pre, m) }
    for e in d.enum_type { syms[pre + e.name] = TYPE_ENUM }
  }
  let pre = if f.package.is_empty() { "" } else { f.package + "." }
  for m in f.messages { b_syms(syms, pre, m) }
  for e in f.enums { syms[pre + e.name] = TYPE_ENUM }
  let proto3 = f.syntax == "proto3"
  var out = FileDesc{name: name, package: f.package, dependency: f.imports, public_dependency: import_indexes(f.imports, f.public_imports),
    weak_dependency: import_indexes(f.imports, f.weak_imports), syntax: if proto3 { "proto3" } else { "" }}
  if f.syntax == "editions" {
    // an editions file: syntax "editions" and the Edition enum's number (EDITION_2023 is 1000)
    out.syntax = "editions"
    for pair in EDITIONS.split(",") {
      let kv = pair.split(":")
      if kv[0] == "EDITION_${f.edition}" { out.edition = Int.parse(kv[1]) ?? 0 }
    }
  }
  for m in f.messages {
    out.message_type.push(b_message(syms, f.package, m, proto3)?)
  }
  for e in f.enums {
    out.enum_type.push(b_enum(e))
  }
  for x in f.extends {
    for fd in b_extend(syms, f.package, x, f.syntax == "proto3")? { out.extension.push(fd) }
  }
  for sv in f.services {
    var sd = ServiceDesc{name: sv.name}
    let (so, sset) = b_opts(sv.options, SERVICE_OPTS)
    sd.options = so
    sd.options_set = sset
    for r in sv.rpcs {
      let (mo, mset) = b_opts(r.options, METHOD_OPTS)
      sd.method.push(MethodDesc{name: r.name, input_type: b_resolve(syms, f.package, r.req)?.0,
        output_type: b_resolve(syms, f.package, r.resp)?.0, options: mo, options_set: mset || r.body,
        client_streaming: r.client_stream, server_streaming: r.server_stream,
        streaming_set: (if r.client_stream { 1 } else { 0 }) | (if r.server_stream { 2 } else { 0 })})
    }
    out.service.push(sd)
  }
  let (fo, fset) = b_opts(f.options, FILE_OPTS)
  out.options = fo
  out.options_set = fset
  // custom options: extensions of descriptor.proto's options messages, from this file and deps
  let cx = co_cx(out, deps)
  if cx.exts.is_empty() { return Ok(out) }
  Ok(co_file(f, out, cx))
}

// Custom options (protoc): an option named `(ext)` or `(ext).field.field` sets an extension of the
// options message (`extend google.protobuf.FieldOptions { ... }` in this file or an import). protoc
// serializes the options message, so the extensions follow descriptor.proto's own options (their
// numbers are 1000 and up) in number order, a message extension set by several options (an aggregate,
// `(ext).a`, `(ext).b`) is one message with its fields in number order, and a repeated one keeps the
// order written. An option no extension resolves is left out.

/// An extension of an options message, by its full name (`.pkg.name`).
struct CoExt {
  full: Str
  extendee: Str
  number: Int
  label: Int
  kind: Int
  type_name: Str
}

/// The extensions, messages and enums custom option values resolve against.
struct CoCx {
  exts: List[CoExt]
  msgs: Map[Str, MessageDesc]
  enums: Map[Str, EnumDesc]
}

fn co_ext(full: Str, x: FieldDesc) -> CoExt {
  CoExt{full: full, extendee: x.extendee, number: x.number, label: x.label, kind: x.kind, type_name: x.type_name}
}

fn co_collect_msg(cx0: CoCx, pre: Str, m: MessageDesc) -> CoCx {
  var cx = cx0
  let full = pre + "." + m.name
  cx.msgs[full] = m
  for x in m.extension { cx.exts.push(co_ext(full + "." + x.name, x)) }
  for e in m.enum_type { cx.enums[full + "." + e.name] = e }
  for n in m.nested_type { cx = co_collect_msg(cx, full, n) }
  cx
}

fn co_collect(cx0: CoCx, f: FileDesc) -> CoCx {
  var cx = cx0
  let pre = if f.package.is_empty() { "" } else { "." + f.package }
  for x in f.extension { cx.exts.push(co_ext(pre + "." + x.name, x)) }
  for e in f.enum_type { cx.enums[pre + "." + e.name] = e }
  for m in f.message_type { cx = co_collect_msg(cx, pre, m) }
  cx
}

/// The extension of extendee an option's `(name)` names: by full name with a leading dot, else the one
/// whose full name ends with `.name`.
fn co_resolve(name: Str, extendee: Str, cx: CoCx) -> CoExt? {
  for x in cx.exts {
    if x.extendee != extendee { continue }
    if name.starts_with(".") {
      if x.full == name { return Some(x) }
    } else if x.full == "." + name || x.full.ends_with("." + name) {
      return Some(x)
    }
  }
  None
}

fn co_le(var o: BytesBuilder, v: Int, n: Int) {
  for i in 0..n { o.write_byte(UInt8.wrapping_from((v >> (8 * i)) & 255)) }
}

/// A scalar value as written for a field of kind, with its tag; None when it does not parse.
fn co_scalar(num: Int, kind: Int, type_name: Str, raw: Bytes, cx: CoCx) -> Bytes? {
  var o = BytesBuilder.new()
  if kind == TYPE_STRING || kind == TYPE_BYTES {
    // a string literal's bytes as its escapes give them, not read as UTF-8 (`"\377"` is byte 0xFF)
    pw.wtag(o, num, 2)
    pw.wv(o, raw.len())
    o.write(raw)
    return Some(o.freeze())
  }
  let v = raw.to_str_lossy()
  if kind == TYPE_DOUBLE || kind == TYPE_FLOAT {
    let f = Float.parse(v)?
    if kind == TYPE_DOUBLE {
      pw.wtag(o, num, 1)
      co_le(o, f.to_bits(), 8)
    } else {
      pw.wtag(o, num, 5)
      co_le(o, Int(Float32(f).to_bits()), 4)
    }
    return Some(o.freeze())
  }
  var n = 0
  if kind == TYPE_BOOL {
    n = match v {
      "true" => 1
      "false" => 0
      _ => return None
    }
  } else if kind == TYPE_ENUM {
    var found: Int? = Int.parse_base(v, 0)
    if let Some(e) = cx.enums.get(type_name) {
      for ev in e.value {
        if ev.name == v { found = Some(ev.number) }
      }
    }
    n = found?
  } else {
    n = Int.parse_base(v, 0)?
  }
  if kind == TYPE_FIXED32 || kind == TYPE_SFIXED32 {
    pw.wtag(o, num, 5)
    co_le(o, n, 4)
  } else if kind == TYPE_FIXED64 || kind == TYPE_SFIXED64 {
    pw.wtag(o, num, 1)
    co_le(o, n, 8)
  } else {
    if kind == TYPE_SINT32 || kind == TYPE_SINT64 { n = (n << 1) ^ (n >> 63) }
    pw.wtag(o, num, 0)
    pw.wv(o, n)
  }
  Some(o.freeze())
}

/// A field a custom option value sets: by its name (an extension as `[full.name]`), number, kind, type
/// and label.
struct CoField {
  key: Str
  number: Int
  kind: Int
  type_name: Str
  label: Int
}

/// A message field's value: its elements (one for a singular field, merged; each `{ ... }` of a repeated
/// one apart) from entries (path under the field, value), a path ending in `{` starting an element.
fn co_elements(entries: List[(List[Str], Bytes)], repeated: Bool) -> List[List[(List[Str], Bytes)]] {
  var out: List[List[(List[Str], Bytes)]] = []
  var cur: List[(List[Str], Bytes)] = []
  var have = false
  for (path, v) in entries {
    if path.len() == 1 && path[0] == "{" {
      if repeated && have {
        out.push(cur)
        cur = []
      }
      have = true
      continue
    }
    cur.push((path, v))
    have = true
  }
  if have { out.push(cur) }
  out
}

fn co_write_message(var o: BytesBuilder, f: CoField, entries: List[(List[Str], Bytes)], cx: CoCx) {
  for el in co_elements(entries, f.label == LABEL_REPEATED) {
    let body = co_message(f.type_name, el, cx)
    if f.kind == TYPE_GROUP {
      pw.wtag(o, f.number, 3)
      o.write(body)
      pw.wtag(o, f.number, 4)
    } else {
      pw.wtag(o, f.number, 2)
      pw.wv(o, body.len())
      o.write(body)
    }
  }
}

/// The fields of the message type_name that entries set ((path, value), path under that message), in
/// field number order; an extension of it named `[name]` among them.
fn co_message(type_name: Str, entries: List[(List[Str], Bytes)], cx: CoCx) -> Bytes {
  var o = BytesBuilder.new()
  let md = match cx.msgs.get(type_name) {
    Some(m) => m
    None => return o.freeze()
  }
  var fields: List[CoField] = []
  for fd in md.field { fields.push(CoField{key: fd.name, number: fd.number, kind: fd.kind, type_name: fd.type_name, label: fd.label}) }
  for (path, _) in entries {
    if path.is_empty() || !path[0].starts_with("[") { continue }
    let key = path[0].trim_end_chars("{")
    var known = false
    for f in fields {
      if f.key == key { known = true }
    }
    if known { continue }
    if let Some(x) = co_resolve(key[1..key.len() - 1], type_name, cx) {
      fields.push(CoField{key: key, number: x.number, kind: x.kind, type_name: x.type_name, label: x.label})
    }
  }
  let sorted = fields.sort_with(fn(a: CoField, b: CoField) -> Ordering { a.number.cmp(b.number) })
  // a map's entry message: protoc writes its key and value also when not set
  let map_entry = md.options == b"\x38\x01"
  for f in sorted {
    var sub: List[(List[Str], Bytes)] = []
    for (path, v) in entries {
      if path.is_empty() { continue }
      if path[0] == f.key {
        sub.push((path[1..], v))
      } else if path[0] == f.key + "{" {
        sub.push((["{"], v))
      }
    }
    if sub.is_empty() && map_entry {
      if f.kind == TYPE_MESSAGE {
        sub.push((["{"], b""))
      } else {
        sub.push(([], co_zero(f, cx).bytes()))
      }
    }
    if sub.is_empty() { continue }
    if f.kind == TYPE_MESSAGE || f.kind == TYPE_GROUP {
      co_write_message(o, f, sub, cx)
      continue
    }
    for (path, v) in sub {
      if !path.is_empty() { continue }
      if let Some(b) = co_scalar(f.number, f.kind, f.type_name, v, cx) { o.write(b) }
    }
  }
  o.freeze()
}

/// A field's zero value as an option value is written (a map entry's unset key or value).
fn co_zero(f: CoField, cx: CoCx) -> Str {
  if f.kind == TYPE_STRING || f.kind == TYPE_BYTES { return "" }
  if f.kind == TYPE_BOOL { return "false" }
  if f.kind == TYPE_ENUM {
    if let Some(e) = cx.enums.get(f.type_name) {
      if !e.value.is_empty() { return "${e.value[0].number}" }
    }
  }
  "0"
}

/// The custom options among opts as the extensions of extendee (`.google.protobuf.FieldOptions`), in
/// extension number order; each option of a repeated message extension is one element.
fn co_opts(opts: List[(Str, Bytes)], extendee: Str, cx: CoCx) -> Bytes {
  var items: List[(CoExt, Int, List[Str], Bytes)] = []
  for (oi, (k, v)) in opts.indexed() {
    if !k.starts_with("(") { continue }
    let close = match k.find(")") {
      Some(i) => i
      None => continue
    }
    let x = match co_resolve(k[1..close], extendee, cx) {
      Some(x) => x
      None => continue
    }
    let rest = k[close + 1..k.len()]
    let path: List[Str] = if rest.starts_with(".") { co_key_path(rest[1..rest.len()]) } else { [] }
    if v.starts_with(b"{") {
      // the message the option sets starts here (an element of a repeated one)
      if path.is_empty() {
        items.push((x, oi, ["{"], b""))
      } else {
        items.push((x, oi, path[0..path.len() - 1] + [path[path.len() - 1] + "{"], b""))
      }
      for (ak, av) in protoparse.aggregate_items(v) { items.push((x, oi, path + co_key_path(ak), av)) }
    } else {
      items.push((x, oi, path, v))
    }
  }
  var o = BytesBuilder.new()
  if items.is_empty() { return o.freeze() }
  var nums: List[Int] = []
  for (x, _, _, _) in items {
    if !nums.contains(x.number) { nums.push(x.number) }
  }
  for num in nums.sort() {
    var x0: CoExt? = None
    var sub: List[(List[Str], Bytes)] = []
    var last_stmt = -1
    for (x, oi, path, v) in items {
      if x.number != num { continue }
      x0 = Some(x)
      // a repeated message extension: each option statement is an element
      if (x.kind == TYPE_MESSAGE || x.kind == TYPE_GROUP) && oi != last_stmt && !(path.len() == 1 && path[0] == "{") {
        sub.push((["{"], b""))
      }
      last_stmt = oi
      sub.push((path, v))
    }
    let x = x0.or_fault("co_opts: an extension number with no item")
    let f = CoField{key: "", number: num, kind: x.kind, type_name: x.type_name, label: x.label}
    if x.kind == TYPE_MESSAGE || x.kind == TYPE_GROUP {
      co_write_message(o, f, sub, cx)
    } else {
      for (path, v) in sub {
        if !path.is_empty() { continue }
        if let Some(b) = co_scalar(num, x.kind, x.type_name, v, cx) { o.write(b) }
      }
    }
  }
  o.freeze()
}

/// An aggregate key or an option name's path as a path: dotted names, an extension's name kept whole
/// and bracketed (`[a.b].c` and `(a.b).c` are `[a.b]`, `c`).
fn co_key_path(k: Str) -> List[Str] {
  var out: List[Str] = []
  let b = k.bytes()
  var start = 0
  var depth = 0
  for (i, x) in b.indexed() {
    let c = Int(x)
    if c == 91 || c == 40 { depth += 1 }
    if c == 93 || c == 41 { depth -= 1 }
    if c == 46 && depth == 0 {
      out.push(co_bracket(k[start..i]))
      start = i + 1
    }
  }
  out.push(co_bracket(k[start..k.len()]))
  out
}

fn co_bracket(p: Str) -> Str {
  if p.starts_with("(") && p.ends_with(")") { "[" + p[1..p.len() - 1] + "]" } else { p }
}

const CO_PRE: Str = ".google.protobuf."

fn co_enum(e: protoparse.Enum, d0: EnumDesc, cx: CoCx) -> EnumDesc {
  var d = d0
  let eo = co_opts(e.options, CO_PRE + "EnumOptions", cx)
  if !eo.is_empty() {
    d.options = d.options + eo
    d.options_set = true
  }
  var vals: List[EnumValueDesc] = []
  for vd0 in d.value {
    var vd = vd0
    for v in e.values {
      if v.name != vd.name { continue }
      let vo = co_opts(v.options, CO_PRE + "EnumValueOptions", cx)
      if !vo.is_empty() {
        vd.options = vd.options + vo
        vd.options_set = true
      }
    }
    vals.push(vd)
  }
  d.value = vals
  d
}

fn co_message_desc(m: protoparse.Message, d0: MessageDesc, cx: CoCx) -> MessageDesc {
  var d = d0
  let mo = co_opts(m.options, CO_PRE + "MessageOptions", cx)
  if !mo.is_empty() {
    d.options = d.options + mo
    d.options_set = true
  }
  var fields: List[FieldDesc] = []
  for fd0 in d.field {
    var fd = fd0
    for fl in m.fields {
      if fl.name != fd.name { continue }
      let fo = co_opts(fl.options, CO_PRE + "FieldOptions", cx)
      if !fo.is_empty() {
        fd.options = fd.options + fo
        fd.options_set = true
      }
    }
    fields.push(fd)
  }
  d.field = fields
  var ranges: List[ExtensionRange] = []
  for (k, r0) in d.extension_range.indexed() {
    var r = r0
    if k < m.extension_options.len() {
      let ro = co_opts(m.extension_options[k], CO_PRE + "ExtensionRangeOptions", cx)
      if !ro.is_empty() {
        r.options = r.options + ro
        r.options_set = true
      }
    }
    ranges.push(r)
  }
  d.extension_range = ranges
  var oneofs: List[OneofDesc] = []
  for (k, od0) in d.oneof_decl.indexed() {
    var od = od0
    if k < m.oneof_options.len() {
      let oo = co_opts(m.oneof_options[k], CO_PRE + "OneofOptions", cx)
      if !oo.is_empty() {
        od.options = od.options + oo
        od.options_set = true
      }
    }
    oneofs.push(od)
  }
  d.oneof_decl = oneofs
  var nested: List[MessageDesc] = []
  for nd in d.nested_type {
    var done = nd
    for n in m.nested {
      if n.name == nd.name { done = co_message_desc(n, nd, cx) }
    }
    nested.push(done)
  }
  d.nested_type = nested
  var enums: List[EnumDesc] = []
  for ed in d.enum_type {
    var done = ed
    for e in m.enums {
      if e.name == ed.name { done = co_enum(e, ed, cx) }
    }
    enums.push(done)
  }
  d.enum_type = enums
  d
}

/// out with the custom options of f's file, messages, fields, enums, values, services and methods.
fn co_file(f: protoparse.File, out0: FileDesc, cx: CoCx) -> FileDesc {
  var out = out0
  let fo = co_opts(f.options, CO_PRE + "FileOptions", cx)
  if !fo.is_empty() {
    out.options = out.options + fo
    out.options_set = true
  }
  var msgs: List[MessageDesc] = []
  for md in out.message_type {
    var done = md
    for m in f.messages {
      if m.name == md.name { done = co_message_desc(m, md, cx) }
    }
    msgs.push(done)
  }
  out.message_type = msgs
  var enums: List[EnumDesc] = []
  for ed in out.enum_type {
    var done = ed
    for e in f.enums {
      if e.name == ed.name { done = co_enum(e, ed, cx) }
    }
    enums.push(done)
  }
  out.enum_type = enums
  var svcs: List[ServiceDesc] = []
  for sd0 in out.service {
    var sd = sd0
    for sv in f.services {
      if sv.name != sd.name { continue }
      let so = co_opts(sv.options, CO_PRE + "ServiceOptions", cx)
      if !so.is_empty() {
        sd.options = sd.options + so
        sd.options_set = true
      }
      var ms: List[MethodDesc] = []
      for md0 in sd.method {
        var md = md0
        for r in sv.rpcs {
          if r.name != md.name { continue }
          let ro = co_opts(r.options, CO_PRE + "MethodOptions", cx)
          if !ro.is_empty() {
            md.options = md.options + ro
            md.options_set = true
          }
        }
        ms.push(md)
      }
      sd.method = ms
    }
    svcs.push(sd)
  }
  out.service = svcs
  out
}

fn b_syms(var syms: Map[Str, Int], pre: Str, m: protoparse.Message) {
  let full = pre + m.name
  syms[full] = TYPE_MESSAGE
  for n in m.nested { b_syms(syms, full + ".", n) }
  for e in m.enums { syms[full + "." + e.name] = TYPE_ENUM }
}

fn b_syms_desc(var syms: Map[Str, Int], pre: Str, m: MessageDesc) {
  let full = pre + m.name
  syms[full] = TYPE_MESSAGE
  for n in m.nested_type { b_syms_desc(syms, full + ".", n) }
  for e in m.enum_type { syms[full + "." + e.name] = TYPE_ENUM }
}

/// The scalar type of a proto keyword, 0 for a named type.
fn b_scalar(t: Str) -> Int {
  match t {
    "double" => TYPE_DOUBLE
    "float" => TYPE_FLOAT
    "int64" => TYPE_INT64
    "uint64" => TYPE_UINT64
    "int32" => TYPE_INT32
    "fixed64" => TYPE_FIXED64
    "fixed32" => TYPE_FIXED32
    "bool" => TYPE_BOOL
    "string" => TYPE_STRING
    "bytes" => TYPE_BYTES
    "uint32" => TYPE_UINT32
    "sfixed32" => TYPE_SFIXED32
    "sfixed64" => TYPE_SFIXED64
    "sint32" => TYPE_SINT32
    "sint64" => TYPE_SINT64
    _ => 0
  }
}

/// protobuf's scoping: `.a.B` is absolute; otherwise the innermost scope outward whose
/// `scope.FIRST` names a symbol or a package prefix decides, and the whole name must then be found
/// there. The type name with its leading dot, and TYPE_MESSAGE or TYPE_ENUM.
fn b_resolve(syms: Map[Str, Int], scope: Str, t: Str) -> (Str, Int) ! protoparse.ParseErr {
  if t.starts_with(".") {
    return match syms.get(t[1..]) {
      Some(k) => Ok((t, k))
      None => Err(protoparse.ParseErr{line: 0, col: 0, msg: "unknown type `${t}`"})
    }
  }
  let first = t.split(".")[0]
  var sc = scope
  while true {
    let cand = if sc.is_empty() { t } else { sc + "." + t }
    let head = if sc.is_empty() { first } else { sc + "." + first }
    if syms.contains(head) || b_is_package(syms, head) {
      match syms.get(cand) {
        Some(k) => return Ok(("." + cand, k))
        None => {
          // protoc goes on outward only past a name that is not a scope (a field's type here)
          if syms.contains(head) && (syms.get(head) ?? 0) == TYPE_MESSAGE || b_is_package(syms, head) {
            return Err(protoparse.ParseErr{line: 0, col: 0, msg: "unknown type `${t}` (`${head}` has no `${t}`)"})
          }
        }
      }
    }
    if sc.is_empty() { break }
    sc = match sc.rfind(".") {
      Some(i) => sc[..i]
      None => ""
    }
  }
  Err(protoparse.ParseErr{line: 0, col: 0, msg: "unknown type `${t}`"})
}

fn b_is_package(syms: Map[Str, Int], name: Str) -> Bool {
  let pre = name + "."
  for (k, _) in syms {
    if k.starts_with(pre) { return true }
  }
  false
}

/// protoc's ToJsonName: each `_` dropped and the character after it in upper case.
fn json_name_of(name: Str) -> Str {
  var out = StrBuilder.new()
  var first = true
  for part in name.split("_") {
    out.write(if first { part } else { b_cap(part) })
    first = false
  }
  out.freeze()
}

/// protoc's MapEntryName: the field name in CamelCase and `Entry`.
fn map_entry_name(field: Str) -> Str {
  var out = StrBuilder.new()
  for part in field.split("_") {
    out.write(b_cap(part))
  }
  out.freeze() + "Entry"
}

/// s with its first byte in upper case (proto names are ASCII).
fn b_cap(s: Str) -> Str {
  if s.is_empty() { s } else { s[..1].to_upper() + s[1..] }
}

fn b_label(f: protoparse.Field) -> Int {
  if f.required { LABEL_REQUIRED } else if f.repeated { LABEL_REPEATED } else { LABEL_OPTIONAL }
}

/// The field's type: a scalar, or a message or enum resolved in scope.
fn b_type(syms: Map[Str, Int], scope: Str, t: Str) -> (Int, Str) ! protoparse.ParseErr {
  let k = b_scalar(t)
  if k != 0 { return Ok((k, "")) }
  let (n, kind) = b_resolve(syms, scope, t)?
  Ok((kind, n))
}

fn b_message(syms: Map[Str, Int], scope: Str, m: protoparse.Message, proto3: Bool) -> MessageDesc ! protoparse.ParseErr {
  let full = if scope.is_empty() { m.name } else { scope + "." + m.name }
  var d = MessageDesc{name: m.name}
  for (k, o) in m.oneofs.indexed() {
    let oo = if k < m.oneof_options.len() { m.oneof_options[k] } else { [] }
    let (ob, oset) = b_opts(oo, ONEOF_OPTS)
    d.oneof_decl.push(OneofDesc{name: o, options: ob, options_set: oset})
  }
  var entries: List[(Int, MessageDesc)] = []
  var synthetic: List[Str] = []
  var mi = 0
  for f in m.fields {
    var fd = FieldDesc{name: f.name, number: f.num, label: b_label(f), json_name: if f.json_name.is_empty() { json_name_of(f.name) } else { f.json_name },
      json_name_set: true}
    if !f.key.is_empty() {
      let en = map_entry_name(f.name)
      let (vk, vt) = b_type(syms, full, f.typ)?
      var entry = MessageDesc{name: en, options: b"\x38\x01", options_set: true}
      entry.field.push(FieldDesc{name: "key", number: 1, label: LABEL_OPTIONAL, kind: b_scalar(f.key), json_name: "key"})
      entry.field.push(FieldDesc{name: "value", number: 2, label: LABEL_OPTIONAL, kind: vk, type_name: vt, json_name: "value"})
      entries.push((m.map_at[mi], entry))
      mi += 1
      fd.label = LABEL_REPEATED
      fd.kind = TYPE_MESSAGE
      fd.type_name = ".${full}.${en}"
    } else if f.group {
      fd.kind = TYPE_GROUP
      fd.type_name = ".${full}.${f.typ}"
    } else {
      let (k, tn) = b_type(syms, full, f.typ)?
      fd.kind = k
      fd.type_name = tn
      fd.default_value = b_default(k, f.default_value)
    }
    if !f.oneof.is_empty() {
      fd.oneof_index = m.oneofs.index_of(f.oneof)
    } else if proto3 && f.optional {
      // a synthetic oneof, after the declared ones; its name `_field`, prefixed with X until unique
      var on = "_" + f.name
      while m.oneofs.contains(on) || synthetic.contains(on) || m.fields.any(fn(x: protoparse.Field) -> Bool { x.name == on }) {
        on = "X" + on
      }
      synthetic.push(on)
      fd.proto3_optional = true
      fd.oneof_index = Some(m.oneofs.len() + synthetic.len() - 1)
    }
    let (fo, fset) = b_opts(f.options, FIELD_OPTS)
    fd.options = fo
    fd.options_set = fset
    d.field.push(fd)
  }
  for o in synthetic { d.oneof_decl.push(OneofDesc{name: o}) }
  // nested messages in source order, each map's entry where its field was
  var ei = 0
  var ni = 0
  while ni < m.nested.len() || ei < entries.len() {
    if ei < entries.len() && entries[ei].0 <= ni {
      d.nested_type.push(entries[ei].1)
      ei += 1
    } else {
      d.nested_type.push(b_message(syms, full, m.nested[ni], proto3)?)
      ni += 1
    }
  }
  for e in m.enums { d.enum_type.push(b_enum(e)) }
  for x in m.extends {
    for fd in b_extend(syms, full, x, proto3)? { d.extension.push(fd) }
  }
  var ri = 0
  for (a, b) in m.extensions {
    let ro = if ri < m.extension_options.len() { m.extension_options[ri] } else { [] }
    let (eo, eset) = b_opts(ro, EXT_RANGE_OPTS)
    d.extension_range.push(ExtensionRange{start: a, end: b + 1, options: eo, options_set: eset})
    ri += 1
  }
  for (a, b) in m.reserved { d.reserved_range.push(ReservedRange{start: a, end: b + 1}) }
  d.reserved_name = m.reserved_names
  let (mo, mset) = b_opts(m.options, MESSAGE_OPTS)
  d.options = mo
  d.options_set = mset
  Ok(d)
}

/// A number default as protoc writes it: an integer in decimal (`0x10` is `16`), a float or double as
/// protoc's SimpleDtoa (15 significant digits, 17 when 15 do not round trip; `.25` is `0.25`, `inf`,
/// `nan`); other kinds as written.
fn b_default(kind: Int, raw: Bytes) -> Str {
  if kind == TYPE_BYTES { return c_escape(raw) }
  let v = raw.to_str_lossy()
  if v.is_empty() || kind == TYPE_STRING || kind == TYPE_ENUM || kind == TYPE_BOOL { return v }
  let neg = v.starts_with("-")
  let body = if neg { v[1..v.len()] } else { v }
  let sign = if neg { "-" } else { "" }
  if kind == TYPE_DOUBLE || kind == TYPE_FLOAT {
    if body is "inf" | "nan" { return sign + body }
    let f = match Int.parse_base(body, 0) {
      Some(n) => Float(n)
      None => match Float.parse(body) {
        Some(x) => x
        None => return v
      }
    }
    if f.is_inf() { return sign + "inf" }
    if kind == TYPE_FLOAT {
      // SimpleFtoa: 6 significant digits, 9 when 6 do not give the float back
      let x = Float(Float32(f))
      if x.is_inf() { return sign + "inf" }
      let s6 = x.to_general(6)
      let back = match Float.parse(s6) {
        Some(y) => Float(Float32(y)) == x
        None => false
      }
      return sign + if back { s6 } else { x.to_general(9) }
    }
    let s15 = f.to_general(15)
    let s = if Float.parse(s15) == Some(f) { s15 } else { f.to_general(17) }
    return sign + s
  }
  match Int.parse_base(body, 0) {
    Some(n) => sign + "${n}"
    None => v
  }
}

/// protoc's CEscape: `\n \r \t \" \' \\` escaped, other bytes outside printable ASCII as 3 octal digits.
fn c_escape(b: Bytes) -> Str {
  var o = BytesBuilder.new()
  for x in b {
    let c = Int(x)
    match c {
      10 => o.write(b"\\n")
      13 => o.write(b"\\r")
      9 => o.write(b"\\t")
      34 => o.write(b"\\\"")
      39 => o.write(b"\\'")
      92 => o.write(b"\\\\")
      _ => {
        if c < 32 || c >= 127 {
          o.write("\\${c >> 6}${(c >> 3) & 7}${c & 7}".bytes())
        } else {
          o.write_byte(x)
        }
      }
    }
  }
  o.freeze().to_str_lossy()
}

/// An `extend` block's fields, the extendee and types resolved in scope.
fn b_extend(syms: Map[Str, Int], scope: Str, x: protoparse.Extend, proto3: Bool) -> List[FieldDesc] ! protoparse.ParseErr {
  let (ext, _) = b_resolve(syms, scope, x.extendee)?
  var out: List[FieldDesc] = []
  for f in x.fields {
    let (k0, tn) = b_type(syms, scope, f.typ)?
    let k = if f.group { TYPE_GROUP } else { k0 }
    let (fo, fset) = b_opts(f.options, FIELD_OPTS)
    out.push(FieldDesc{name: f.name, extendee: ext, number: f.num, label: b_label(f), kind: k, type_name: tn,
      default_value: b_default(k, f.default_value), options: fo, options_set: fset, json_name_set: true,
      proto3_optional: proto3 && f.optional,
      json_name: if f.json_name.is_empty() { json_name_of(f.name) } else { f.json_name }})
  }
  Ok(out)
}

fn b_enum(e: protoparse.Enum) -> EnumDesc {
  var d = EnumDesc{name: e.name}
  for v in e.values {
    let (vo, vset) = b_opts(v.options, ENUM_VALUE_OPTS)
    d.value.push(EnumValueDesc{name: v.name, number: v.num, options: vo, options_set: vset})
  }
  for (a, b) in e.reserved { d.reserved_range.push(ReservedRange{start: a, end: b}) }
  d.reserved_name = e.reserved_names
  let (eo, eset) = b_opts(e.options, ENUM_OPTS)
  d.options = eo
  d.options_set = eset
  d
}

/// descriptor.proto's options: (name, field number, kind: 0 bool, 1 string, 2 enum (`NAME:N` pairs), 3 int,
/// 4 an aggregate of the message `aggregate_fields` names).
const FILE_OPTS: List[(Str, Int, Int, Str)] = [
  ("java_package", 1, 1, ""), ("java_outer_classname", 8, 1, ""), ("optimize_for", 9, 2, "SPEED:1,CODE_SIZE:2,LITE_RUNTIME:3"),
  ("java_multiple_files", 10, 0, ""), ("go_package", 11, 1, ""), ("cc_generic_services", 16, 0, ""),
  ("java_generic_services", 17, 0, ""), ("py_generic_services", 18, 0, ""), ("java_generate_equals_and_hash", 20, 0, ""),
  ("deprecated", 23, 0, ""), ("java_string_check_utf8", 27, 0, ""), ("cc_enable_arenas", 31, 0, ""),
  ("objc_class_prefix", 36, 1, ""), ("csharp_namespace", 37, 1, ""), ("swift_prefix", 39, 1, ""),
  ("php_class_prefix", 40, 1, ""), ("php_namespace", 41, 1, ""), ("php_metadata_namespace", 44, 1, ""),
  ("ruby_package", 45, 1, ""), ("features", 50, 5, ""),
]
const MESSAGE_OPTS: List[(Str, Int, Int, Str)] = [
  ("message_set_wire_format", 1, 0, ""), ("no_standard_descriptor_accessor", 2, 0, ""), ("deprecated", 3, 0, ""),
  ("map_entry", 7, 0, ""), ("features", 12, 5, ""),
]
const FIELD_OPTS: List[(Str, Int, Int, Str)] = [
  ("ctype", 1, 2, "STRING:0,CORD:1,STRING_PIECE:2"), ("packed", 2, 0, ""), ("deprecated", 3, 0, ""), ("lazy", 5, 0, ""),
  ("jstype", 6, 2, "JS_NORMAL:0,JS_STRING:1,JS_NUMBER:2"), ("weak", 10, 0, ""), ("unverified_lazy", 15, 0, ""),
  ("debug_redact", 16, 0, ""), ("retention", 17, 2, "RETENTION_UNKNOWN:0,RETENTION_RUNTIME:1,RETENTION_SOURCE:2"),
  ("edition_defaults", 20, 4, "EditionDefault"), ("feature_support", 22, 4, "FeatureSupport"), ("features", 21, 5, ""),
  ("targets", 19, 2, "TARGET_TYPE_UNKNOWN:0,TARGET_TYPE_FILE:1,TARGET_TYPE_EXTENSION_RANGE:2,TARGET_TYPE_MESSAGE:3,TARGET_TYPE_FIELD:4,TARGET_TYPE_ONEOF:5,TARGET_TYPE_ENUM:6,TARGET_TYPE_ENUM_ENTRY:7,TARGET_TYPE_SERVICE:8,TARGET_TYPE_METHOD:9"),
]
// ExtensionRangeOptions' declaration and verification are source retention options, which protoc leaves out
// of the descriptors it writes; so are FeatureSet's enforce_naming_style and the others marked so.
const EXT_RANGE_OPTS: List[(Str, Int, Int, Str)] = []
const ONEOF_OPTS: List[(Str, Int, Int, Str)] = [("features", 1, 5, "")]
const EDITIONS: Str = "EDITION_UNKNOWN:0,EDITION_LEGACY:900,EDITION_PROTO2:998,EDITION_PROTO3:999,EDITION_2023:1000,EDITION_2024:1001,EDITION_2026:1002,EDITION_UNSTABLE:9999,EDITION_1_TEST_ONLY:1,EDITION_2_TEST_ONLY:2,EDITION_99997_TEST_ONLY:99997,EDITION_99998_TEST_ONLY:99998,EDITION_99999_TEST_ONLY:99999,EDITION_MAX:2147483647"

/// The fields of the aggregate option values build writes (descriptor.proto's own options).
fn aggregate_fields(kind: Str) -> List[(Str, Int, Int, Str)] {
  match kind {
    "EditionDefault" => [("edition", 3, 2, EDITIONS), ("value", 2, 1, "")]
    "FeatureSupport" => [("edition_introduced", 1, 2, EDITIONS), ("edition_deprecated", 2, 2, EDITIONS),
      ("deprecation_warning", 3, 1, ""), ("edition_removed", 4, 2, EDITIONS), ("removal_error", 5, 1, "")]
    _ => []
  }
}

const ENUM_OPTS: List[(Str, Int, Int, Str)] = [("allow_alias", 2, 0, ""), ("deprecated", 3, 0, ""), ("features", 7, 5, "")]
const ENUM_VALUE_OPTS: List[(Str, Int, Int, Str)] = [("deprecated", 1, 0, ""), ("debug_redact", 3, 0, ""), ("features", 2, 5, "")]
const SERVICE_OPTS: List[(Str, Int, Int, Str)] = [("deprecated", 33, 0, ""), ("features", 34, 5, "")]
const METHOD_OPTS: List[(Str, Int, Int, Str)] = [("deprecated", 33, 0, ""), ("idempotency_level", 34, 2, "IDEMPOTENCY_UNKNOWN:0,NO_SIDE_EFFECTS:1,IDEMPOTENT:2"), ("features", 35, 5, "")]
/// FeatureSet's fields an edition file sets with `option features.NAME = VALUE` (kind 5 above: the
/// `features.` options of a descriptor gathered into one FeatureSet); enforce_naming_style and
/// default_symbol_visibility are source retention, which protoc leaves out of what it writes.
const FEATURE_FIELDS: List[(Str, Int, Int, Str)] = [
  ("field_presence", 1, 2, "FIELD_PRESENCE_UNKNOWN:0,EXPLICIT:1,IMPLICIT:2,LEGACY_REQUIRED:3"),
  ("enum_type", 2, 2, "ENUM_TYPE_UNKNOWN:0,OPEN:1,CLOSED:2"),
  ("repeated_field_encoding", 3, 2, "REPEATED_FIELD_ENCODING_UNKNOWN:0,PACKED:1,EXPANDED:2"),
  ("utf8_validation", 4, 2, "UTF8_VALIDATION_UNKNOWN:0,VERIFY:2,NONE:3"),
  ("message_encoding", 5, 2, "MESSAGE_ENCODING_UNKNOWN:0,LENGTH_PREFIXED:1,DELIMITED:2"),
  ("json_format", 6, 2, "JSON_FORMAT_UNKNOWN:0,ALLOW:1,LEGACY_BEST_EFFORT:2"),
]

/// The options message of the known options in `opts`, fields in number order (protoc serializes the
/// options message), and whether any was given.
fn b_opts(opts: List[(Str, Bytes)], known: List[(Str, Int, Int, Str)]) -> (Bytes, Bool) {
  var parts: List[(Int, Bytes)] = []
  for (k, raw) in opts {
    let v = raw.to_str_lossy()
    for (n, num, kind, enums) in known {
      if n != k { continue }
      var o = BytesBuilder.new()
      if kind == 0 {
        pw.wtag(o, num, 0)
        pw.wv(o, if v == "true" { 1 } else { 0 })
      } else if kind == 1 {
        pw.wtag(o, num, 2)
        pw.wv(o, raw.len())
        o.write(raw)
      } else if kind == 2 {
        var ev = Int.parse(v) ?? 0
        for pair in enums.split(",") {
          let kv = pair.split(":")
          if kv[0] == v { ev = Int.parse(kv[1]) ?? 0 }
        }
        pw.wtag(o, num, 0)
        pw.wv(o, ev)
      } else if kind == 5 {
        continue
      } else if kind == 4 {
        let pairs = protoparse.aggregate_pairs(raw)
        if pairs.is_empty() { continue }
        let (body, _) = b_opts(pairs, aggregate_fields(enums))
        pw.wtag(o, num, 2)
        pw.wv(o, body.len())
        o.write(body)
      } else {
        pw.wtag(o, num, 0)
        pw.wv(o, Int.parse(v) ?? 0)
      }
      parts.push((num, o.freeze()))
    }
  }
  // an edition's `features.NAME` options: one FeatureSet at the options message's features field
  var feats: List[(Str, Bytes)] = []
  for (k, v) in opts {
    if k.starts_with("features.") { feats.push((k["features.".len()..k.len()], v)) }
  }
  if !feats.is_empty() {
    for (_, num, kind, _) in known {
      if kind != 5 { continue }
      let (body, _) = b_opts(feats, FEATURE_FIELDS)
      var o = BytesBuilder.new()
      pw.wtag(o, num, 2)
      pw.wv(o, body.len())
      o.write(body)
      parts.push((num, o.freeze()))
    }
  }
  if parts.is_empty() { return (b"", false) }
  let sorted = parts.sort_with(fn(a: (Int, Bytes), b: (Int, Bytes)) -> Ordering { a.0.cmp(b.0) })
  var out = BytesBuilder.new()
  for (_, b) in sorted { out.write(b) }
  (out.freeze(), true)
}

// Source info (protoc --include_source_info, protocompile's sourceinfo in its standard mode): a
// SourceCodeInfo location for the file and each declaration and part of one, in source order, with the
// path of descriptor fields and indexes that reaches it, its span (0 based line and columns, the end
// column after the last byte; 3 numbers when on one line, else 4), and the comments it takes.

/// `src` parsed and built (as `build`), with `source_code_info` set as protoc writes it with
/// `--include_source_info`: the locations of the file, its declarations and their parts (names,
/// numbers, labels, types, options), and the leading, trailing and detached comments of each
/// declaration. `extra_comments` and `extra_option_locations` are protocompile's
/// SourceInfoExtraComments (every location takes the comments around it, not only a declaration's)
/// and SourceInfoExtraOptionLocations (a location for each field set inside an option's message
/// literal) modes.
pub fn build_with_source_info(src: Str, name: Str, deps: List[FileDesc] = [], extra_comments: Bool = false, extra_option_locations: Bool = false) -> FileDesc ! protoparse.ParseErr {
  let f = protoparse.parse(src)?
  var out = build(f, name, deps)?
  let lx = protoparse.lex(src)?
  var w = Sw{ts: lx.tokens, cs: lx.comments, lead: [], trail: [], used: [], at: 0, o: BytesBuilder.new(), cx: co_cx(out, deps), eof_line: lx.eof_line, extra: extra_comments, xopts: extra_option_locations}
  for _ in 0..w.ts.len() + 1 {
    w.lead.push([])
    w.trail.push([])
  }
  for (i, c) in lx.comments.indexed() {
    if c.trailing {
      w.trail[c.tok].push(i)
    } else {
      w.lead[c.tok].push(i)
    }
    w.used.push(false)
  }
  sw_file(w)
  out.source_code_info = w.o.freeze()
  Ok(out)
}

/// The source info walk: the tokens and comments, the comments' groups already given to a location,
/// the next token, and the locations written so far.
struct Sw {
  ts: List[protoparse.Token]
  cs: List[protoparse.Comment]
  /// for each token (and the end of the file), its leading comments and its trailing ones
  lead: List[List[Int]]
  trail: List[List[Int]]
  used: List[Bool]
  at: Int
  o: BytesBuilder
  cx: CoCx
  eof_line: Int
  /// protocompile's SourceInfoExtraComments and SourceInfoExtraOptionLocations modes
  extra: Bool = false
  xopts: Bool = false
}

fn co_cx(out: FileDesc, deps: List[FileDesc]) -> CoCx {
  var cx = CoCx{exts: [], msgs: {}, enums: {}}
  cx = co_collect(cx, out)
  for d in deps { cx = co_collect(cx, d) }
  cx
}

fn sw_is(w: Sw, s: Str) -> Bool {
  w.at < w.ts.len() && w.ts[w.at].text == s && w.ts[w.at].kind != protoparse.Kind.Str
}

fn sw_tok_is(w: Sw, i: Int, s: Str) -> Bool {
  i < w.ts.len() && w.ts[i].text == s && w.ts[i].kind != protoparse.Kind.Str
}

/// The index of the token closing the bracket opened at token `open` (`{`, `[`, `(` or `<`).
fn sw_close(w: Sw, open: Int) -> Int {
  var depth = 0
  var i = open
  while i < w.ts.len() {
    let t = w.ts[i]
    if t.kind == protoparse.Kind.Sym {
      if t.text is "{" | "[" | "(" | "<" {
        depth += 1
      } else if t.text is "}" | "]" | ")" | ">" {
        depth -= 1
        if depth == 0 { return i }
      }
    }
    i += 1
  }
  w.ts.len() - 1
}

/// The last token of the value starting at token `i` (an aggregate, a list, a signed number, adjacent
/// strings, or one token).
fn sw_value_end(w: Sw, i: Int) -> Int {
  if sw_tok_is(w, i, "{") || sw_tok_is(w, i, "[") { return sw_close(w, i) }
  if sw_tok_is(w, i, "-") || sw_tok_is(w, i, "+") { return i + 1 }
  var j = i
  if w.ts[i].kind == protoparse.Kind.Str {
    while j + 1 < w.ts.len() && w.ts[j + 1].kind == protoparse.Kind.Str { j += 1 }
  }
  j
}

/// The last token of a type name starting at token `i` (`.a.b` is `.` then `a.b`; parts may be apart,
/// `a . b` or `a.` then `b`).
fn sw_type_end(w: Sw, i: Int) -> Int {
  var j = if sw_tok_is(w, i, ".") { i + 1 } else { i }
  while true {
    if w.ts[j].text.ends_with(".") && j + 1 < w.ts.len() {
      j += 1
    } else if sw_tok_is(w, j + 1, ".") && j + 2 < w.ts.len() && w.ts[j + 2].kind == protoparse.Kind.Ident {
      j += 2
    } else {
      break
    }
  }
  j
}

// comments (protocompile's sourceinfo rules)

/// Comments in groups: consecutive line comments with no blank line between are one group; each
/// block comment starts one.
fn sw_group(w: Sw, ids: List[Int]) -> List[List[Int]] {
  var out: List[List[Int]] = []
  if ids.is_empty() { return out }
  var cur: List[Int] = [ids[0]]
  var single = w.cs[ids[0]].text.starts_with("//")
  var line = w.cs[ids[0]].end_line
  for k in 1..ids.len() {
    let c = w.cs[ids[k]]
    let prev_single = single
    single = c.text.starts_with("//")
    if !single || prev_single != single || c.line > line + 1 {
      out.push(cur)
      cur = []
    }
    cur.push(ids[k])
    line = c.end_line
  }
  out.push(cur)
  out
}

fn sw_start_line(w: Sw, t: Int) -> Int { if t < w.ts.len() { w.ts[t].line - 1 } else { w.eof_line } }

/// (trailing comments of prev, detached groups and leading comments of tok); prev is -1 for none.
fn sw_attribute(w: Sw, prev: Int, tok: Int) -> (List[Int], List[List[Int]], List[Int]) {
  var detached = sw_group(w, w.lead[tok])
  var trail: List[Int] = []
  if prev >= 0 {
    trail = w.trail[prev]
    if trail.is_empty() {
      let (t, d) = sw_donate(w, prev, tok, detached)
      trail = t
      detached = d
    }
  }
  let (d, l) = sw_attach(w, prev, tok, !trail.is_empty(), detached)
  (trail, d, l)
}

fn sw_donate(w: Sw, prev: Int, tok: Int, lead: List[List[Int]]) -> (List[Int], List[List[Int]]) {
  if lead.is_empty() { return ([], []) }
  let prev_end = w.ts[prev].line - 1
  let first = w.cs[lead[0][0]]
  if first.line > prev_end + 1 { return ([], lead) }
  if lead.len() > 1 { return (lead[0], lead[1..]) }
  let comment = lead[0]
  let last = w.cs[comment[comment.len() - 1]]
  let tok_line = sw_start_line(w, tok)
  if last.end_line < tok_line - 1 { return (comment, []) }
  let txt = if tok < w.ts.len() { w.ts[tok].text } else { "" }
  if txt == "" || (w.ts[tok].kind == protoparse.Kind.Sym && txt is "}" | "]" | ")" | "," | ";") {
    // protoc leaves a comment between two tokens of one line to neither; the extra comments
    // mode gives it to the earlier token, since these symbols have no location of their own
    if !w.extra && txt != "" && first.line == prev_end && last.end_line == tok_line { return ([], lead) }
    return (comment, [])
  }
  ([], lead)
}

fn sw_attach(w: Sw, prev: Int, tok: Int, has_trail: Bool, lead: List[List[Int]]) -> (List[List[Int]], List[Int]) {
  if lead.is_empty() { return ([], []) }
  let tok_line = sw_start_line(w, tok)
  if lead.len() == 1 && !has_trail && prev >= 0 {
    let c = lead[0]
    let to_prev = w.cs[c[0]].line == w.ts[prev].line - 1
    let to_next = w.cs[c[c.len() - 1]].end_line == tok_line
    if to_prev && to_next { return (lead, []) }
  }
  let last = lead[lead.len() - 1]
  if w.cs[last[last.len() - 1]].end_line >= tok_line - 1 { return (lead[0..lead.len() - 1], last) }
  (lead, [])
}

/// Whether the group starting with comment g[0] went to a location already (and marks it).
fn sw_used(var w: Sw, g: List[Int]) -> Bool {
  if g.is_empty() { return false }
  if w.used[g[0]] { return true }
  w.used[g[0]] = true
  false
}

/// A group's text as protoc keeps it: line comments without `//`, each with its newline; a block
/// comment without `/*` and `*/`, each later line without its indent and a leading `*`.
fn sw_text(w: Sw, g: List[Int]) -> Str {
  var sb = StrBuilder.new()
  for id in g {
    let c = w.cs[id]
    let t = c.text
    if t.starts_with("//") {
      sb.write(t[2..t.len()])
      if c.nl { sb.write("\n") }
      continue
    }
    let lines = t[2..t.len() - 2].split("\n")
    for (k, l0) in lines.indexed() {
      if k == 0 {
        sb.write(l0)
        continue
      }
      sb.write("\n")
      var j = 0
      let lb = l0.bytes()
      while j < lb.len() && (Int(lb[j]) == 32 || Int(lb[j]) == 9) { j += 1 }
      if j == lb.len() {
        continue
      } else if Int(lb[j]) == 42 {
        sb.write(l0[j + 1..l0.len()])
      } else {
        sb.write(l0[j..l0.len()])
      }
    }
  }
  sb.freeze()
}

// locations

fn sw_packed(var o: BytesBuilder, num: Int, vs: List[Int]) {
  if vs.is_empty() { return }
  var b = BytesBuilder.new()
  for v in vs { pw.wv(b, v) }
  let bb = b.freeze()
  pw.wtag(o, num, 2)
  pw.wv(o, bb.len())
  o.write(bb)
}

fn sw_str(var o: BytesBuilder, num: Int, s: Str) {
  let b = s.bytes()
  pw.wtag(o, num, 2)
  pw.wv(o, b.len())
  o.write(b)
}

fn sw_span(w: Sw, s: Int, e: Int) -> List[Int] {
  let a = w.ts[s]
  let z = w.ts[e]
  if a.line == z.line { [a.line - 1, a.pcol, z.pend] } else { [a.line - 1, a.pcol, z.line - 1, z.pend] }
}

fn sw_emit(var w: Sw, path: List[Int], span: List[Int], lead: Str?, trail: Str?, det: List[Str]) {
  var b = BytesBuilder.new()
  sw_packed(b, 1, path)
  sw_packed(b, 2, span)
  if let Some(l) = lead { sw_str(b, 3, l) }
  if let Some(t) = trail { sw_str(b, 4, t) }
  for d in det { sw_str(b, 6, d) }
  let bb = b.freeze()
  pw.wtag(w.o, 1, 2)
  pw.wv(w.o, bb.len())
  w.o.write(bb)
}

/// A location for tokens s..e: without comments, or with the comments around them in the
/// SourceInfoExtraComments mode (protocompile's newLoc).
fn sw_loc(var w: Sw, s: Int, e: Int, path: List[Int]) {
  if w.extra {
    sw_loc_c(w, s, e, e, path)
  } else {
    sw_loc0(w, s, e, path)
  }
}

/// A location without comments in every mode (protocompile's newLocWithoutComments: the file, an
/// option statement, a group's field, label and name, whose comments go to the group's message).
fn sw_loc0(var w: Sw, s: Int, e: Int, path: List[Int]) { sw_emit(w, path, sw_span(w, s, e), None, None, []) }

/// A location for tokens s..e with the comments before s and the trailing comment of token `tr`.
fn sw_loc_c(var w: Sw, s: Int, e: Int, tr: Int, path: List[Int]) {
  let (_, det0, lead0) = sw_attribute(w, s - 1, s)
  let (trail0, _, _) = sw_attribute(w, tr, tr + 1)
  var det = det0
  var lead = lead0
  var trail = trail0
  if (!det.is_empty() && sw_used(w, det[0])) || (det.is_empty() && sw_used(w, lead)) {
    det = []
    lead = []
  }
  if sw_used(w, trail) { trail = [] }
  var ds: List[Str] = []
  for g in det { ds.push(sw_text(w, g)) }
  let l: Str? = if lead.is_empty() { None } else { Some(sw_text(w, lead)) }
  let t: Str? = if trail.is_empty() { None } else { Some(sw_text(w, trail)) }
  sw_emit(w, path, sw_span(w, s, e), l, t, ds)
}

// options

const SW_FILE: Int = 0
const SW_MSG: Int = 1
const SW_FIELD: Int = 2
const SW_ENUM: Int = 3
const SW_VALUE: Int = 4
const SW_SVC: Int = 5
const SW_METHOD: Int = 6
const SW_ONEOF: Int = 7
const SW_EXTR: Int = 8

fn sw_extendee(kind: Int) -> Str {
  CO_PRE + match kind {
    0 => "FileOptions"
    1 => "MessageOptions"
    2 => "FieldOptions"
    3 => "EnumOptions"
    4 => "EnumValueOptions"
    5 => "ServiceOptions"
    6 => "MethodOptions"
    7 => "OneofOptions"
    _ => "ExtensionRangeOptions"
  }
}

/// A known option's field number in the options message of kind, whether it is repeated, and its
/// message type (`builtin:NAME`, sw_fields) or "".
fn sw_known(kind: Int, name: Str) -> (Int, Bool, Str)? {
  let table = match kind {
    0 => FILE_OPTS + [("php_generic_services", 42, 0, "")]
    1 => MESSAGE_OPTS + [("deprecated_legacy_json_field_conflicts", 11, 0, "")]
    2 => FIELD_OPTS
    3 => ENUM_OPTS + [("deprecated_legacy_json_field_conflicts", 6, 0, "")]
    4 => ENUM_VALUE_OPTS + [("feature_support", 4, 4, "")]
    5 => SERVICE_OPTS
    6 => METHOD_OPTS
    7 => ONEOF_OPTS
    _ => [("declaration", 2, 4, ""), ("verification", 3, 2, ""), ("features", 50, 5, "")]
  }
  for (n, num, k, enums) in table {
    if n != name { continue }
    let tn = if k == 5 { "builtin:FeatureSet" } else if k == 4 && kind == 8 { "builtin:Declaration" } else if k == 4 { "builtin:" + enums } else { "" }
    return Some((num, (kind == 2 && (num == 19 || num == 20)) || (kind == 8 && num == 2), tn))
  }
  None
}

/// The fields of message type_name as (name, number, repeated, message, type name): from w.cx, or,
/// for descriptor.proto's own option messages (`builtin:NAME`), from the tables build uses, so a
/// file that does not import descriptor.proto has them too.
fn sw_fields(w: Sw, type_name: Str) -> List[(Str, Int, Bool, Bool, Str)] {
  var out: List[(Str, Int, Bool, Bool, Str)] = []
  if type_name.starts_with("builtin:") {
    let n = type_name[8..type_name.len()]
    if n == "FeatureSet" {
      for (fname, num, _, _) in FEATURE_FIELDS { out.push((fname, num, false, false, "")) }
      out.push(("enforce_naming_style", 7, false, false, ""))
      out.push(("default_symbol_visibility", 8, false, false, ""))
    } else if n == "Declaration" {
      for (fname, num) in [("number", 1), ("full_name", 2), ("type", 3), ("reserved", 5), ("repeated", 6)] {
        out.push((fname, num, false, false, ""))
      }
    } else {
      for (fname, num, _, _) in aggregate_fields(n) { out.push((fname, num, false, false, "")) }
    }
    return out
  }
  let md = match w.cx.msgs.get(type_name) {
    Some(m) => m
    None => return out
  }
  for fd in md.field {
    let fname = if fd.kind == TYPE_GROUP { fd.type_name[(fd.type_name.rfind(".") ?? -1) + 1..fd.type_name.len()] } else { fd.name }
    out.push((fname, fd.number, fd.label == LABEL_REPEATED, fd.kind == TYPE_MESSAGE || fd.kind == TYPE_GROUP, fd.type_name))
  }
  out
}

/// The extendee name of type_name (a builtin: one's descriptor.proto name).
fn sw_extendee_of(type_name: Str) -> Str {
  if type_name.starts_with("builtin:") { CO_PRE + type_name[8..type_name.len()] } else { type_name }
}

/// The path within the options message of kind that the option `name` sets (`-1` first for a field's
/// `default` and `json_name`, which are the field's own), with the index of a repeated field's value
/// counted in `seen`; None when it names nothing known.
fn sw_opt_path(w: Sw, kind: Int, name: Str, var seen: Map[Str, Int]) -> (List[Int], Str)? {
  if kind == SW_FIELD && name == "default" { return Some(([-1, 7], "")) }
  if kind == SW_FIELD && name == "json_name" { return Some(([-1, 10], "")) }
  var path: List[Int] = []
  var repeated = false
  var rest = ""
  var type_name = ""
  if name.starts_with("(") {
    let close = name.find(")")?
    let x = co_resolve(name[1..close], sw_extendee(kind), w.cx)?
    path.push(x.number)
    repeated = x.label == LABEL_REPEATED
    type_name = x.type_name
    rest = name[close + 1..name.len()]
    if rest.starts_with(".") { rest = rest[1..rest.len()] }
  } else {
    let parts = name.split(".")
    let (num, rep, tn0) = sw_known(kind, parts[0])?
    path.push(num)
    repeated = rep
    type_name = tn0
    if parts.len() > 1 {
      if parts[0] != "features" || parts.len() != 2 { return None }
      var fnum = match parts[1] {
        "enforce_naming_style" => 7
        "default_symbol_visibility" => 8
        _ => 0
      }
      for (n, num2, _, _) in FEATURE_FIELDS {
        if n == parts[1] { fnum = num2 }
      }
      if fnum == 0 { return None }
      path.push(fnum)
      return Some((path, ""))
    }
  }
  if !rest.is_empty() {
    for part in co_key_path(rest) {
      if part.starts_with("[") {
        let x = co_resolve(part[1..part.len() - 1], type_name, w.cx)?
        path.push(x.number)
        type_name = x.type_name
        repeated = x.label == LABEL_REPEATED
        continue
      }
      let md = w.cx.msgs.get(type_name)?
      var found = false
      for fd in md.field {
        if fd.name == part {
          path.push(fd.number)
          type_name = fd.type_name
          repeated = fd.label == LABEL_REPEATED
          found = true
        }
      }
      if !found { return None }
    }
  }
  if repeated {
    path.push(sw_next_index(path, seen))
  }
  Some((path, type_name))
}

/// The next index of the repeated field at path (relative to the options message) among the
/// element's options, counted in seen.
fn sw_next_index(path: List[Int], var seen: Map[Str, Int]) -> Int {
  var key = ""
  for x in path { key = key + "${x},"}
  let n = seen.get(key) ?? 0
  seen[key] = n + 1
  n
}

/// SourceInfoExtraOptionLocations: a location for each field an option's message literal (at token
/// v) sets, its path the option's (rel, relative to the options message at opts_path) and the field's
/// number, and its index when repeated; a list's elements each have one, and not the field
/// (protocompile's generateSourceInfoForOptionChildren). type_name is the literal's message type.
fn sw_children(var w: Sw, v: Int, opts_path: List[Int], rel: List[Int], type_name: Str, var seen: Map[Str, Int]) {
  if !sw_tok_is(w, v, "{") && !sw_tok_is(w, v, "<") { return }
  let close = sw_close(w, v)
  let fields = sw_fields(w, type_name)
  var i = v + 1
  while i < close {
    let ns = i
    var name = ""
    var ne = i
    let ext = sw_tok_is(w, i, "[")
    if ext {
      ne = sw_close(w, i)
      for k in i + 1..ne { name = name + w.ts[k].text }
    } else {
      name = w.ts[i].text
    }
    var vs = ne + 1
    if sw_tok_is(w, vs, ":") { vs += 1 }
    let ve = if sw_tok_is(w, vs, "<") { sw_close(w, vs) } else { sw_value_end(w, vs) }
    // the field's location ends with its value, not a `,` or `;` after it
    let fe = ve
    i = if sw_tok_is(w, ve + 1, ",") || sw_tok_is(w, ve + 1, ";") { ve + 2 } else { ve + 1 }
    var num = 0
    var repeated = false
    var msg = false
    var tn = ""
    if ext {
      let x = match co_resolve(name, sw_extendee_of(type_name), w.cx) {
        Some(x) => x
        None => continue
      }
      num = x.number
      repeated = x.label == LABEL_REPEATED
      msg = x.kind == TYPE_MESSAGE || x.kind == TYPE_GROUP
      tn = x.type_name
    } else {
      for (fname, fnum, frep, fmsg, ftn) in fields {
        if fname == name {
          num = fnum
          repeated = frep
          msg = fmsg
          tn = ftn
        }
      }
      if num == 0 { continue }
    }
    let fr = rel + [num]
    if sw_tok_is(w, vs, "[") {
      // a list: each element, at its index
      let lc = sw_close(w, vs)
      var j = vs + 1
      while j < lc {
        let ee = if sw_tok_is(w, j, "<") { sw_close(w, j) } else { sw_value_end(w, j) }
        let er = fr + [sw_next_index(fr, seen)]
        sw_loc(w, j, ee, sw_opt_full(opts_path, er))
        if msg { sw_children(w, j, opts_path, er, tn, seen) }
        j = ee + 1
        if sw_tok_is(w, j, ",") { j += 1 }
      }
      continue
    }
    let r = if repeated { fr + [sw_next_index(fr, seen)] } else { fr }
    sw_loc(w, ns, fe, sw_opt_full(opts_path, r))
    if msg { sw_children(w, vs, opts_path, r, tn, seen) }
  }
}

/// The option's path joined to the options path (a `-1` path is the element's own field).
fn sw_opt_full(opts_path: List[Int], p: List[Int]) -> List[Int] {
  if !p.is_empty() && p[0] == -1 { return opts_path[0..opts_path.len() - 1] + p[1..] }
  opts_path + p
}

/// `NAME = VALUE` from token at: its name, its value's first token and its last token.
fn sw_opt_node(w: Sw, at: Int) -> (Str, Int, Int) {
  var name = ""
  var i = at
  while i < w.ts.len() && !sw_tok_is(w, i, "=") {
    name = name + w.ts[i].text
    i += 1
  }
  (name, i + 1, sw_value_end(w, i + 1))
}

/// An `option NAME = VALUE;` statement at w.at.
fn sw_option_stmt(var w: Sw, opts_path: List[Int], kind: Int, var seen: Map[Str, Int]) {
  let s = w.at
  let (name, vs, ve) = sw_opt_node(w, s + 1)
  let e = if sw_tok_is(w, ve + 1, ";") { ve + 1 } else { ve }
  w.at = e + 1
  sw_loc0(w, s, e, opts_path)
  if let Some((p, tn)) = sw_opt_path(w, kind, name, seen) {
    sw_loc_c(w, s, e, e, sw_opt_full(opts_path, p))
    if w.xopts { sw_children(w, vs, opts_path, p, tn, seen) }
  }
}

/// A `[ ... ]` option list at w.at, when there is one.
fn sw_compact(var w: Sw, opts_path: List[Int], kind: Int) {
  if !sw_is(w, "[") { return }
  let open = w.at
  let close = sw_close(w, open)
  sw_loc(w, open, close, opts_path)
  var seen: Map[Str, Int] = {}
  var i = open + 1
  while i < close {
    let (name, vs, ve) = sw_opt_node(w, i)
    if let Some((p, tn)) = sw_opt_path(w, kind, name, seen) {
      // a field's `default` (its own field): protoc's location is the value's; `json_name` has the
      // option's and then the value's
      sw_loc(w, if p == [-1, 7] { vs } else { i }, ve, sw_opt_full(opts_path, p))
      if p == [-1, 10] { sw_loc(w, vs, ve, sw_opt_full(opts_path, p)) }
      if w.xopts { sw_children(w, vs, opts_path, p, tn, seen) }
    }
    i = ve + 1
    if sw_tok_is(w, i, ",") { i += 1 }
  }
  w.at = close + 1
}

// declarations

const SW_SCALARS: Str = " double float int32 int64 uint32 uint64 sint32 sint64 fixed32 fixed64 sfixed32 sfixed64 bool string bytes "

fn sw_file(var w: Sw) {
  if w.ts.is_empty() {
    sw_emit(w, [], [0, 0, 0], None, None, [])
    return
  }
  sw_loc0(w, 0, w.ts.len() - 1, [])
  var dep = 0
  var pub_dep = 0
  var weak_dep = 0
  var msg = 0
  var en = 0
  var ext = 0
  var svc = 0
  var seen: Map[Str, Int] = {}
  // syntax and edition come first, wherever they are
  if (sw_tok_is(w, 0, "syntax") || sw_tok_is(w, 0, "edition")) && sw_tok_is(w, 1, "=") {
    var e = 2
    while e < w.ts.len() && !sw_tok_is(w, e, ";") { e += 1 }
    // protoc gives an `edition = "2023";` statement the syntax field's path too
    sw_loc_c(w, 0, e, e, [12])
  }
  while w.at < w.ts.len() {
    let s = w.at
    if sw_is(w, "syntax") || sw_is(w, "edition") || sw_is(w, "package") || sw_is(w, "import") {
      var e = s
      while e < w.ts.len() && !sw_tok_is(w, e, ";") { e += 1 }
      w.at = e + 1
      if w.ts[s].text == "package" {
        sw_loc_c(w, s, e, e, [2])
      } else if w.ts[s].text == "import" {
        sw_loc_c(w, s, e, e, [3, dep])
        dep += 1
        if sw_tok_is(w, s + 1, "public") {
          sw_loc(w, s + 1, s + 1, [10, pub_dep])
          pub_dep += 1
        } else if sw_tok_is(w, s + 1, "weak") {
          sw_loc(w, s + 1, s + 1, [11, weak_dep])
          weak_dep += 1
        }
      }
    } else if sw_is(w, "option") {
      sw_option_stmt(w, [8], SW_FILE, seen)
    } else if sw_is(w, "message") {
      sw_message(w, s, s + 1, [4, msg], [])
      msg += 1
    } else if sw_is(w, "enum") {
      sw_enum(w, [5, en])
      en += 1
    } else if sw_is(w, "extend") {
      let (e2, m2) = sw_extend(w, [7], ext, [4], msg)
      ext = e2
      msg = m2
    } else if sw_is(w, "service") {
      sw_service(w, [6, svc])
      svc += 1
    } else {
      w.at += 1
    }
  }
}

/// A message (or a group's message) whose declaration starts at token s, its name at token n and its
/// `{` after the name (after the group's number and options); field_path is the group field's path.
fn sw_message(var w: Sw, s: Int, n: Int, path: List[Int], field_path: List[Int]) {
  var open = n + 1
  while open < w.ts.len() && !sw_tok_is(w, open, "{") { open += 1 }
  let close = sw_close(w, open)
  sw_loc_c(w, s, close, open, path)
  sw_loc(w, n, n, path + [1])
  if !field_path.is_empty() { sw_loc(w, n, n, field_path + [6]) }
  w.at = open + 1
  var field = 0
  var oneof = 0
  var ext = 0
  var nested = 0
  var en = 0
  var ext_range = 0
  var res_range = 0
  var res_name = 0
  var seen: Map[Str, Int] = {}
  while w.at < close {
    let t = w.at
    if sw_is(w, "option") {
      sw_option_stmt(w, path + [7], SW_MSG, seen)
    } else if sw_is(w, "message") {
      sw_message(w, t, t + 1, path + [3, nested], [])
      nested += 1
    } else if sw_is(w, "enum") {
      sw_enum(w, path + [4, en])
      en += 1
    } else if sw_is(w, "extend") {
      let (e2, n2) = sw_extend(w, path + [6], ext, path + [3], nested)
      ext = e2
      nested = n2
    } else if sw_is(w, "extensions") {
      ext_range = sw_ext_ranges(w, path + [5], ext_range)
    } else if sw_is(w, "reserved") {
      let (r2, n2) = sw_reserved(w, path, 9, 10, res_range, res_name)
      res_range = r2
      res_name = n2
    } else if sw_is(w, "oneof") {
      let (f2, n2) = sw_oneof(w, path + [8, oneof], path + [2], field, path + [3], nested)
      field = f2
      nested = n2
      oneof += 1
    } else if sw_is(w, ";") {
      w.at += 1
    } else {
      let kind = sw_field(w, path + [2, field], -1, -1, false, path + [3, nested])
      field += 1
      if kind != 0 { nested += 1 }
    }
  }
  w.at = close + 1
}

/// A field at w.at (path its location; extendee the tokens of an extension's extendee, or -1), and
/// whether it was a map (1), a group (2, its message at msg_path) or neither (0).
fn sw_field(var w: Sw, path: List[Int], ext_s: Int, ext_e: Int, in_oneof: Bool, msg_path: List[Int]) -> Int {
  let s = w.at
  var label = -1
  if !in_oneof && (sw_is(w, "repeated") || sw_is(w, "optional") || sw_is(w, "required")) {
    label = w.at
    w.at += 1
  }
  if sw_is(w, "group") {
    let g = w.at
    let n = g + 1
    let num = n + 2
    let num_e = num
    var open = num + 1
    while open < w.ts.len() && !sw_tok_is(w, open, "{") { open += 1 }
    let close = sw_close(w, open)
    sw_loc0(w, s, close, path)
    if ext_s >= 0 { sw_loc(w, ext_s, ext_e, path + [2]) }
    if label >= 0 { sw_loc0(w, label, label, path + [4]) }
    sw_loc(w, g, g, path + [5])
    sw_loc0(w, n, n, path + [1])
    sw_loc(w, num, num_e, path + [3])
    w.at = num_e + 1
    sw_compact(w, path + [8], SW_FIELD)
    sw_message(w, s, n, msg_path, path)
    return 2
  }
  var map = false
  let ts = w.at
  var te = sw_type_end(w, ts)
  if sw_is(w, "map") && sw_tok_is(w, ts + 1, "<") {
    te = sw_close(w, ts + 1)
    map = true
  }
  let n = te + 1
  let num = n + 2
  let num_e = num
  w.at = num_e + 1
  var e = w.at
  if sw_tok_is(w, e, "[") { e = sw_close(w, e) + 1 }
  sw_loc_c(w, s, e, e, path)
  if ext_s >= 0 { sw_loc(w, ext_s, ext_e, path + [2]) }
  if label >= 0 { sw_loc(w, label, label, path + [4]) }
  let scalar = !map && te == ts && SW_SCALARS.contains(" " + w.ts[ts].text + " ")
  sw_loc(w, ts, te, path + [if scalar { 5 } else { 6 }])
  sw_loc(w, n, n, path + [1])
  sw_loc(w, num, num_e, path + [3])
  sw_compact(w, path + [8], SW_FIELD)
  w.at = e + 1
  if map { 1 } else { 0 }
}

/// An `extend NAME { ... }` at w.at: its fields at exts_path + [index from ext], a group's message at
/// msgs_path + [index from msg]; the next indexes.
fn sw_extend(var w: Sw, exts_path: List[Int], ext0: Int, msgs_path: List[Int], msg0: Int) -> (Int, Int) {
  let s = w.at
  let es = s + 1
  let ee = sw_type_end(w, es)
  let open = ee + 1
  let close = sw_close(w, open)
  sw_loc_c(w, s, close, open, exts_path)
  w.at = open + 1
  var ext = ext0
  var msg = msg0
  while w.at < close {
    if sw_is(w, ";") {
      w.at += 1
      continue
    }
    let kind = sw_field(w, exts_path + [ext], es, ee, false, msgs_path + [msg])
    ext += 1
    if kind == 2 { msg += 1 }
  }
  w.at = close + 1
  (ext, msg)
}

/// A `oneof NAME { ... }` at w.at; the next field and nested message indexes.
fn sw_oneof(var w: Sw, path: List[Int], fields_path: List[Int], field0: Int, msgs_path: List[Int], msg0: Int) -> (Int, Int) {
  let s = w.at
  let n = s + 1
  let open = n + 1
  let close = sw_close(w, open)
  sw_loc_c(w, s, close, open, path)
  sw_loc(w, n, n, path + [1])
  w.at = open + 1
  var field = field0
  var msg = msg0
  var seen: Map[Str, Int] = {}
  while w.at < close {
    if sw_is(w, "option") {
      sw_option_stmt(w, path + [2], SW_ONEOF, seen)
    } else if sw_is(w, ";") {
      w.at += 1
    } else {
      let kind = sw_field(w, fields_path + [field], -1, -1, true, msgs_path + [msg])
      field += 1
      if kind == 2 { msg += 1 }
    }
  }
  w.at = close + 1
  (field, msg)
}

/// The tokens of a range or number starting at i (`-` and its number, `a to b`, `a to max`): its last
/// token, and the start's and the end's last tokens and the end's first.
fn sw_range(w: Sw, i: Int) -> (Int, Int, Int) {
  let se = if sw_tok_is(w, i, "-") { i + 1 } else { i }
  if !sw_tok_is(w, se + 1, "to") { return (se, se, i) }
  let es = se + 2
  let ee = if sw_tok_is(w, es, "-") { es + 1 } else { es }
  (ee, se, es)
}

/// `reserved ...;` at w.at in a message or enum (ranges at path + [ranges_tag], names at
/// path + [names_tag]); the next range and name indexes.
fn sw_reserved(var w: Sw, path: List[Int], ranges_tag: Int, names_tag: Int, r0: Int, n0: Int) -> (Int, Int) {
  let s = w.at
  var e = s
  while e < w.ts.len() && !sw_tok_is(w, e, ";") { e += 1 }
  w.at = e + 1
  let names = w.ts[s + 1].kind == protoparse.Kind.Str || w.ts[s + 1].kind == protoparse.Kind.Ident
  var r = r0
  var nn = n0
  var i = s + 1
  if names {
    sw_loc_c(w, s, e, e, path + [names_tag])
    while i < e {
      var j = i
      while j + 1 < e && w.ts[j + 1].kind == protoparse.Kind.Str && w.ts[i].kind == protoparse.Kind.Str { j += 1 }
      sw_loc(w, i, j, path + [names_tag, nn])
      nn += 1
      i = j + 1
      if sw_tok_is(w, i, ",") { i += 1 }
    }
    return (r, nn)
  }
  sw_loc_c(w, s, e, e, path + [ranges_tag])
  while i < e {
    let (last, se, es) = sw_range(w, i)
    sw_loc(w, i, last, path + [ranges_tag, r])
    sw_loc(w, i, se, path + [ranges_tag, r, 1])
    if last == se {
      // a single number's end: protoc's location is its first token (the `-` alone of a negative one)
      sw_loc(w, i, i, path + [ranges_tag, r, 2])
    } else {
      sw_loc(w, es, last, path + [ranges_tag, r, 2])
    }
    r += 1
    i = last + 1
    if sw_tok_is(w, i, ",") { i += 1 }
  }
  (r, nn)
}

/// `extensions ...;` at w.at; the next range index.
fn sw_ext_ranges(var w: Sw, path: List[Int], r0: Int) -> Int {
  let s = w.at
  var e = s
  while e < w.ts.len() && !sw_tok_is(w, e, ";") {
    if sw_tok_is(w, e, "[") { e = sw_close(w, e) }
    e += 1
  }
  w.at = e + 1
  sw_loc_c(w, s, e, e, path)
  var r = r0
  var i = s + 1
  while i < e && !sw_tok_is(w, i, "[") {
    let (last, se, es) = sw_range(w, i)
    sw_loc(w, i, last, path + [r])
    sw_loc(w, i, se, path + [r, 1])
    if last == se {
      sw_loc(w, i, i, path + [r, 2])
    } else {
      sw_loc(w, es, last, path + [r, 2])
    }
    r += 1
    i = last + 1
    if sw_tok_is(w, i, ",") { i += 1 }
  }
  if sw_tok_is(w, i, "[") {
    for k in r0..r {
      w.at = i
      sw_compact(w, path + [k, 3], SW_EXTR)
    }
  }
  w.at = e + 1
  r
}

fn sw_enum(var w: Sw, path: List[Int]) {
  let s = w.at
  let n = s + 1
  let open = n + 1
  let close = sw_close(w, open)
  sw_loc_c(w, s, close, open, path)
  sw_loc(w, n, n, path + [1])
  w.at = open + 1
  var val = 0
  var res_range = 0
  var res_name = 0
  var seen: Map[Str, Int] = {}
  while w.at < close {
    let t = w.at
    if sw_is(w, "option") {
      sw_option_stmt(w, path + [3], SW_ENUM, seen)
    } else if sw_is(w, "reserved") {
      let (r2, n2) = sw_reserved(w, path, 4, 5, res_range, res_name)
      res_range = r2
      res_name = n2
    } else if sw_is(w, ";") {
      w.at += 1
    } else {
      let num = t + 2
      let num_e = if sw_tok_is(w, num, "-") { num + 1 } else { num }
      var e = num_e + 1
      if sw_tok_is(w, e, "[") { e = sw_close(w, e) + 1 }
      let vp = path + [2, val]
      sw_loc_c(w, t, e, e, vp)
      sw_loc(w, t, t, vp + [1])
      sw_loc(w, num, num_e, vp + [2])
      w.at = num_e + 1
      sw_compact(w, vp + [3], SW_VALUE)
      w.at = e + 1
      val += 1
    }
  }
  w.at = close + 1
}

fn sw_service(var w: Sw, path: List[Int]) {
  let s = w.at
  let n = s + 1
  let open = n + 1
  let close = sw_close(w, open)
  sw_loc_c(w, s, close, open, path)
  sw_loc(w, n, n, path + [1])
  w.at = open + 1
  var rpc = 0
  var seen: Map[Str, Int] = {}
  while w.at < close {
    if sw_is(w, "option") {
      sw_option_stmt(w, path + [3], SW_SVC, seen)
    } else if sw_is(w, "rpc") {
      sw_method(w, path + [2, rpc])
      rpc += 1
    } else {
      w.at += 1
    }
  }
  w.at = close + 1
}

fn sw_method(var w: Sw, path: List[Int]) {
  let s = w.at
  let n = s + 1
  var i = n + 2
  var in_stream = -1
  if sw_tok_is(w, i, "stream") && !sw_tok_is(w, i + 1, ")") {
    in_stream = i
    i += 1
  }
  let in_s = i
  let in_e = sw_type_end(w, in_s)
  i = in_e + 4
  var out_stream = -1
  if sw_tok_is(w, i, "stream") && !sw_tok_is(w, i + 1, ")") {
    out_stream = i
    i += 1
  }
  let out_s = i
  let out_e = sw_type_end(w, out_s)
  let after = out_e + 2
  var close = after
  if sw_tok_is(w, after, "{") {
    close = sw_close(w, after)
    sw_loc_c(w, s, close, after, path)
  } else {
    sw_loc_c(w, s, after, after, path)
  }
  sw_loc(w, n, n, path + [1])
  if in_stream >= 0 { sw_loc(w, in_stream, in_stream, path + [5]) }
  sw_loc(w, in_s, in_e, path + [2])
  if out_stream >= 0 { sw_loc(w, out_stream, out_stream, path + [6]) }
  sw_loc(w, out_s, out_e, path + [3])
  if sw_tok_is(w, after, "{") {
    w.at = after + 1
    var seen: Map[Str, Int] = {}
    while w.at < close {
      if sw_is(w, "option") {
        sw_option_stmt(w, path + [4], SW_METHOD, seen)
      } else {
        w.at += 1
      }
    }
  }
  w.at = close + 1
}
