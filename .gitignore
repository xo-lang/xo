# Locally installed tools and built xo binaries (see knowledgebase/infrastructure/toolchain.md)
.tools/

# Go and Xo build outputs
benchtask
*.exe
*.test
*.out
*.prof
/xo
/xoplay
bin/
dist/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log

# xo bind cache (use go bindings, decision 0041)
.xo/

# Agent worktrees
.claude/worktrees/

# Python bytecode (bench/harness)
__pycache__/

# Agent benchmark runs made with bench/harness (keep results in bench/results/)
/runs/

# infra/ci-aws: Terraform state, providers, the generated SSH key, run logs
infra/ci-aws/.terraform*
infra/ci-aws/*.tfstate*
infra/ci-aws/xo-ci-key.pem
infra/ci-aws/logs/
bench/results/remote/
.metadata_never_index
# infra/state and infra/ci-runners: Terraform working files (state lives in S3)
infra/state/.terraform/
infra/state/tfplan
infra/ci-runners/.terraform/
infra/ci-runners/tfplan
infra/ci-runners/lambda/*.zip

# Private values kept out of the repository (decision 0249): Terraform
# variables and S3 backend settings, and the owner's local notes
terraform.tfvars
backend.hcl
CLAUDE.local.md
