// The Xo side of the amqp differential test (internal/stdtest TestAmqpFuzz,
// task #115): each "c HEX" line is a message's bytes; it prints "== " and
// then decode_message's result as the oracle's showMsg text (the printers of
// the amqp corpus, testdata/corpus/amqp), or "error" when it refuses them.
use std/amqp

fn hexn(v: Int, digits: Int) -> Str {
  var s = ""
  var i = digits - 1
  while i >= 0 {
    let d = (v >> (4 * i)) & 15
    s += "0123456789abcdef"[d..d + 1]
    i -= 1
  }
  s
}

/// The canonical text of a value (the same as the oracle's): symbols show as strings, as
/// go-amqp decodes them; maps are sorted by their keys' text.
fn show(v: amqp.Value) -> Str {
  match v {
    Null => "null"
    Bool(b) => "${b}"
    UByte(x) => "ubyte ${x}"
    UShort(x) => "ushort ${x}"
    UInt(x) => "uint ${x}"
    ULong(x) => "ulong ${x}"
    Byte(x) => "byte ${x}"
    Short(x) => "short ${x}"
    Int(x) => "int ${x}"
    Long(x) => "long ${x}"
    Float(v) => "float ${hexn(Int(v.to_bits()), 8)}"
    Double(x) => "double ${hexn(x.to_bits(), 16)}"
    Decimal32(b) => "decimal32 ${hexn(Int(b), 8)}"
    Decimal64(b) => "decimal64 ${hexn(b.to_bits(), 16)}"
    Decimal128(b) => "decimal128 ${b.to_hex()}"
    Char(r) => "char ${Int(r)}"
    Timestamp(ms) => "ts ${ms}"
    Uuid(b) => "uuid ${b.to_hex()}"
    Binary(b) => "bin ${b.to_hex()}"
    Str(s) => "str ${s.bytes().to_hex()}"
    Symbol(s) => "str ${s.bytes().to_hex()}"
    List(items) => "[" + items.map(fn(x) { show(x) }).join(",") + "]"
    // a repeated key once, with its last value, as go-amqp's Go map holds it
    Map(pairs) => {
      var ks: List[Str] = []
      var vs: List[Str] = []
      for p in pairs {
        let k = show(p.0)
        var found = false
        for i in 0..ks.len() {
          if ks[i] == k {
            vs[i] = show(p.1)
            found = true
          }
        }
        if !found {
          ks.push(k)
          vs.push(show(p.1))
        }
      }
      var out: List[Str] = []
      for i in 0..ks.len() {
        out.push(ks[i] + "=" + vs[i])
      }
      "{" + out.sort().join(",") + "}"
    }
    Array(items) => "array[" + items.map(fn(x) { show(x) }).join(",") + "]"
    Described(d, x) => "described " + show(d) + " " + show(x)
  }
}

fn sstr(p: Str?) -> Str {
  match p {
    Some(s) => s.bytes().to_hex()
    None => "-"
  }
}

fn stime(p: Int?) -> Str {
  match p {
    Some(t) => "${t}"
    None => "-"
  }
}

fn sann(a: List[(amqp.Value, amqp.Value)]?) -> Str {
  match a {
    Some(p) => show(amqp.Value.Map(pairs: p))
    None => "-"
  }
}

fn showm(m: amqp.Message) -> Str {
  var parts: List[Str] = []
  match m.header {
    Some(h) => { parts.push("h=${h.durable},${h.priority},${h.ttl_ms},${h.first_acquirer},${h.delivery_count}") }
    None => { parts.push("h=-") }
  }
  parts.push("da=" + sann(m.delivery_annotations))
  parts.push("ann=" + sann(m.annotations))
  match m.properties {
    Some(p) => {
      var gs = "-"
      match p.group_sequence {
        Some(n) => { gs = "${n}" }
        None => {}
      }
      parts.push("p=" + [show(p.message_id), p.user_id.to_hex(), sstr(p.to), sstr(p.subject), sstr(p.reply_to),
        show(p.correlation_id), sstr(p.content_type), sstr(p.content_encoding), stime(p.absolute_expiry_ms),
        stime(p.creation_ms), sstr(p.group_id), gs, sstr(p.reply_to_group_id)].join(";"))
    }
    None => { parts.push("p=-") }
  }
  match m.app_properties {
    Some(p) => {
      var pairs: List[(amqp.Value, amqp.Value)] = []
      for (k, v) in p { pairs.push((amqp.Value.Str(v: k), v)) }
      parts.push("ap=" + show(amqp.Value.Map(pairs: pairs)))
    }
    None => { parts.push("ap=-") }
  }
  match m.body {
    Empty => { parts.push("body=empty") }
    Data(ds) => { parts.push("body=data[" + ds.map(fn(d) { d.to_hex() }).join(",") + "]") }
    Sequence(ss) => { parts.push("body=seq[" + ss.map(fn(s) { show(amqp.Value.List(items: s)) }).join(",") + "]") }
    Value(v) => { parts.push("body=value " + show(v)) }
  }
  parts.push("f=" + sann(m.footer))
  parts.join("|")
}

fn main(os: Os) ! {
  var i = 0
  for line in os.stdio.lines()? {
    let l = line.trim()
    // an empty case is "c " ("c" once trimmed)
    if l != "c" && !l.starts_with("c ") {
      os.stdio.eprintln("line ${i}: ${l.len()} bytes, not a case")
      continue
    }
    os.stdio.println("== ${i}")
    i += 1
    let b = Bytes.from_hex(l.trim_prefix("c").trim()).or_err("bad hex")?
    match amqp.decode_message(b) {
      Ok(m) => os.stdio.println(showm(m))
      Err(e) => {
        // why, for a person sorting differences (the test reads stdout only)
        os.stdio.eprintln("case ${i - 1}: ${e:?}")
        os.stdio.println("error")
      }
    }
  }
}
