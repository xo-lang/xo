// The Xo side of the Postgres differential test (decision 0278): each
// statement on standard input through std/sql's Postgres driver, printed
// as the pgx reference prints it.
use std/sql

fn err_line(e: sql.SqlErr) -> Str {
  match e {
    Constraint(msg, code, _) => "error ${code} ${msg.lines()[0]}"
    Syntax(msg) => "error 42601 ${msg.lines()[0]}"
    NoTable(name) => "error 42P01 relation \"${name}\" does not exist"
    Server(code, msg) => "error ${code} ${msg.lines()[0]}"
    other => "error ${other}"
  }
}

/// The arguments of a case line (after ` ;; `, separated by ` | `), as
/// the reference reads them: T:text, I:int, F:float, B:t or f, N, X:hex,
/// J:json, D:RFC 3339 time, A:ints and S:strs (comma separated, N for
/// NULL).
fn args(s: Str) -> List[sql.SqlValue] {
  var out: List[sql.SqlValue] = []
  for a in s.split(" | ") {
    let (kind, v) = match a.find(":") {
      Some(i) => (a[0..i], a[i + 1..])
      None => (a, "")
    }
    out.push(match kind {
      "T" => sql.str(v)
      "I" => sql.int(Int.parse(v) ?? 0)
      "F" => sql.float(Float.parse(v) ?? 0.0)
      "B" => sql.bool(v == "t")
      "X" => sql.bytes(Bytes.from_hex(v) ?? b"")
      "J" => sql.SqlValue.JsonText(s: v)
      "D" => sql.time(Time.parse_rfc3339(v) ?? Time.UNIX_EPOCH)
      "A" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.int(Int.parse(x) ?? 0) } }))
      "S" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.str(x) } }))
      _ => sql.null()
    })
  }
  out
}

fn main(os: Os) ! {
  let argv = os.env.args()
  // PG_ROOTS: a PEM file of the roots to trust (pgx's sslrootcert)
  let roots = match os.env.get("PG_ROOTS") {
    Some(path) => os.fs.read(path)?
    None => b""
  }
  if argv.first() == Some("probe") {
    // whether a connection opens and answers a ping: "ok" or "fail"
    let r = sql.open(os.net, "postgres", argv[1], max_open: 1, roots: roots)
    os.stdio.println(if r.is_ok() && r.map(fn(db) { db.ping().is_ok() }) == Ok(true) { "ok" } else { "fail" })
    return
  }
  let dsn = argv.first().or_err("usage: diff DSN < cases")?
  let db = sql.open(os.net, "postgres", dsn, max_open: 1, roots: roots)?
  for line in os.stdio.lines()? {
    if line.trim().is_empty() {
      continue
    }
    os.stdio.println("== ${line}")
    let (stmt, xs) = match line.find(" ;; ") {
      Some(i) => (line[0..i], args(line[i + 4..]))
      None => (line, [])
    }
    if line.starts_with("SELECT") {
      match select_lines(db, stmt, xs) {
        Ok(out) => {
          for l in out {
            os.stdio.println(l)
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
    } else {
      match db.exec(stmt, xs) {
        Ok(x) => os.stdio.println("affected ${x.rows_affected}")
        Err(e) => os.stdio.println(err_line(e))
      }
    }
  }
}

/// A SELECT's column types (decision 0609, as the reference prints pgx
/// stdlib's) and then each row as Go's Row Debug text; the whole result
/// first, so an error part way prints the error alone as pgconn's ReadAll.
fn select_lines(db: sql.Db, stmt: Str, xs: List[sql.SqlValue]) -> List[Str] ! sql.SqlErr uses net.dial {
  let rows = db.rows(stmt, xs)?
  defer rows.close()
  let ts = rows.column_types().map(fn(t) {
    let len = t.length.map(fn(n) { "${n}" }) ?? "-"
    let ps = match (t.precision, t.scale) {
      (Some(p), Some(s)) => "${p},${s}"
      _ => "-"
    }
    "${t.name}:${t.database_type}:${len}:${ps}"
  })
  var out = ["types " + ts.join(" ")]
  while let Some(r) = rows.next()? {
    let vals = r.columns().map(fn(c) { r.value(c).or_fault("column") })
    out.push("Row{cols: ${r.columns().debug()}, vals: ${vals.debug()}}")
  }
  out
}
