// The Xo side of the Postgres differential test (decision 0278): each
// statement on standard input through std/sql's Postgres driver, printed
// as the pgx reference prints it.
use std/sql

fn err_line(e: sql.SqlErr) -> Str {
  match e {
    Constraint(msg, code, _) => "error ${code} ${msg.lines()[0]}"
    Syntax(msg) => "error 42601 ${msg.lines()[0]}"
    NoTable(name) => "error 42P01 relation \"${name}\" does not exist"
    Server(code, msg) => "error ${code} ${msg.lines()[0]}"
    other => "error ${other}"
  }
}

/// The arguments of a case line (after ` ;; `, separated by ` | `), as
/// the reference reads them: T:text, I:int, F:float, B:t or f, N, X:hex,
/// J:json, D:RFC 3339 time, A:ints and S:strs (comma separated, N for
/// NULL).
fn args(s: Str) -> List[sql.SqlValue] {
  var out: List[sql.SqlValue] = []
  for a in s.split(" | ") {
    let (kind, v) = match a.find(":") {
      Some(i) => (a[0..i], a[i + 1..])
      None => (a, "")
    }
    out.push(match kind {
      "T" => sql.str(v)
      "I" => sql.int(Int.parse(v) ?? 0)
      "F" => sql.float(Float.parse(v) ?? 0.0)
      "B" => sql.bool(v == "t")
      "X" => sql.bytes(Bytes.from_hex(v) ?? b"")
      "J" => sql.SqlValue.JsonText(s: v)
      "D" => sql.time(Time.parse_rfc3339(v) ?? fault("D: not an RFC 3339 time in range: ${v}"))
      "A" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.int(Int.parse(x) ?? 0) } }))
      "S" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.str(x) } }))
      _ => sql.null()
    })
  }
  out
}

fn main(os: Os) ! {
  let argv = os.env.args()
  // PG_ROOTS: a PEM file of the roots to trust (pgx's sslrootcert)
  let roots = match os.env.get("PG_ROOTS") {
    Some(path) => os.fs.read(path)?
    None => b""
  }
  if argv.first() == Some("probe") {
    // whether a connection opens and answers a ping: "ok" or "fail"
    let r = sql.open(os.net, "postgres", argv[1], max_open: 1, roots: roots)
    os.stdio.println(if r.is_ok() && r.map(fn(db) { db.ping().is_ok() }) == Ok(true) { "ok" } else { "fail" })
    return
  }
  let dsn = argv.first().or_err("usage: diff DSN < cases")?
  // PG_FRESH: a pool of its own for each statement (internal/stdtest
  // TestPgFuzz: a hostile server closes connections at will)
  let fresh = os.env.get("PG_FRESH").is_some()
  var db = sql.open(os.net, "postgres", dsn, max_open: 1, roots: roots)?
  for line in os.stdio.lines()? {
    if fresh {
      db.close().ignore_err("the next statement opens a pool of its own")
      db = sql.open(os.net, "postgres", dsn, max_open: 1, roots: roots)?
    }
    if line.trim().is_empty() {
      continue
    }
    os.stdio.println("== ${line}")
    if line.starts_with("TYPED ") {
      let rest = line[6..]
      let (kind, q) = match rest.find(" ") {
        Some(i) => (rest[0..i], rest[i + 1..])
        None => (rest, "")
      }
      match typed_lines(db, kind, q) {
        Ok(out) => {
          for l in out {
            os.stdio.println(l)
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
      continue
    }
    if line.starts_with("BATCH ") {
      match db.batch(batch_items(line[6..])) {
        Ok(sets) => {
          for s in sets {
            if !s.columns().is_empty() {
              os.stdio.println(types_line(s.column_types()))
              for r in s.rows() {
                os.stdio.println(row_line(r))
              }
            }
            os.stdio.println("affected ${s.rows_affected()}")
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
      continue
    }
    let (stmt, xs) = match line.find(" ;; ") {
      Some(i) => (line[0..i], args(line[i + 4..]))
      None => (line, [])
    }
    if line.starts_with("SELECT") {
      match select_lines(db, stmt, xs) {
        Ok(out) => {
          for l in out {
            os.stdio.println(l)
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
    } else {
      match db.exec(stmt, xs) {
        Ok(x) => os.stdio.println("affected ${x.rows_affected}")
        Err(e) => os.stdio.println(err_line(e))
      }
    }
  }
}

/// A SELECT's column types (decision 0609, as the reference prints pgx
/// stdlib's) and then each row as Go's Row Debug text; the whole result
/// first, so an error part way prints the error alone as pgconn's ReadAll.
fn select_lines(db: sql.Db, stmt: Str, xs: List[sql.SqlValue]) -> List[Str] ! sql.SqlErr uses net.dial {
  let rows = db.rows(stmt, xs)?
  defer rows.close()
  var out = [types_line(rows.column_types())]
  while let Some(r) = rows.next()? {
    out.push(row_line(r))
  }
  out
}

fn types_line(cts: List[sql.ColumnType]) -> Str {
  let ts = cts.map(fn(t) {
    let len = t.length.map(fn(n) { "${n}" }) ?? "-"
    let ps = match (t.precision, t.scale) {
      (Some(p), Some(s)) => "${p},${s}"
      _ => "-"
    }
    "${t.name}:${t.database_type}:${len}:${ps}"
  })
  "types " + ts.join(" ")
}

fn row_line(r: sql.Row) -> Str {
  let vals = r.columns().map(fn(c) { r.value(c).or_fault("column") })
  "Row{cols: ${r.columns().debug()}, vals: ${vals.debug()}}"
}

/// A BATCH line's queries (decision 0648 item 15), as the reference reads
/// them: items separated by ` || `, each a query with ` ;; ` arguments,
/// `N*` before one repeating it N times.
fn batch_items(s: Str) -> List[sql.BatchQuery] {
  var out: List[sql.BatchQuery] = []
  for item in s.split(" || ") {
    var n = 1
    var it = item
    if let Some(i) = item.find("*") {
      if let Some(k) = Int.parse(item[0..i]) {
        n = k
        it = item[i + 1..]
      }
    }
    let q = match it.find(" ;; ") {
      Some(i) => sql.BatchQuery{query: it[0..i], args: args(it[i + 4..])}
      None => sql.BatchQuery{query: it}
    }
    for _ in 0..n {
      out.push(q)
    }
  }
  out
}

/// A `TYPED KIND SELECT ...` line (decision 0679): each cell read by the
/// typed reader for KIND, as the reference prints pgx's pgtype value:
/// its Debug text, NULL, or "error" for a Mismatch.
fn typed_lines(db: sql.Db, kind: Str, q: Str) -> List[Str] ! sql.SqlErr uses net.dial {
  let rows = db.rows(q, [])?
  defer rows.close()
  var out: List[Str] = []
  while let Some(r) = rows.next()? {
    let cells = r.columns().map(fn(c) { typed_cell(r, kind, c) })
    out.push("typed " + cells.join(" | "))
  }
  out
}

fn typed_cell(r: sql.Row, kind: Str, c: Str) -> Str {
  let got: Result[Str?, sql.SqlErr] = match kind {
    "uuid" => r.uuid_opt(c).map(fn(o) { o.map(fn(u) { u.display().debug() }) })
    "date" => r.date_opt(c).map(fn(o) { o.map(fn(d) { d.debug() }) })
    "time" => r.time_of_day_opt(c).map(fn(o) { o.map(fn(t) { t.debug() }) })
    "interval" => r.interval_opt(c).map(fn(o) { o.map(fn(i) { i.debug() }) })
    "inet" => r.prefix_opt(c).map(fn(o) { o.map(fn(p) { p.display().debug() }) })
    "datebound" => r.date_bound_opt(c).map(fn(o) { o.map(fn(b) { b.debug() }) })
    "timebound" => r.time_bound_opt(c).map(fn(o) {
      o.map(fn(b) {
        match b {
          Finite(t) => "Finite(${sql.SqlValue.At(t: t):?})"
          other => other.debug()
        }
      })
    })
    "mac" => r.mac_opt(c).map(fn(o) { o.map(fn(b) { b.to_hex().debug() }) })
    "hstore" => r.hstore_opt(c).map(fn(o) {
      o.map(fn(m) {
        let ks = m.keys().sort()
        "{" + ks.map(fn(k) { "${k.debug()}: ${(m.get(k) ?? None).map(fn(v) { v.debug() }) ?? "NULL"}" }).join(", ") + "}"
      })
    })
    _ => Ok(Some("error unknown kind ${kind}"))
  }
  match got {
    Ok(Some(t)) => t
    Ok(None) => "NULL"
    Err(_) => "error"
  }
}
