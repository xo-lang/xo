// The Xo side of the Postgres differential test (decision 0278): each
// statement on standard input through std/sql's Postgres driver, printed
// as the pgx reference prints it.
use std/sql
use std/time

/// The first line of a server's message, "" for an empty one (an
/// ErrorResponse with no fields, TestPgEmptyError).
fn first_line(s: Str) -> Str {
  let ls = s.lines()
  if ls.is_empty() { "" } else { ls[0] }
}

fn err_line(e: sql.SqlErr) -> Str {
  match e {
    Constraint(msg, code, _) => "error ${code} ${first_line(msg)}"
    Syntax(msg) => "error 42601 ${first_line(msg)}"
    NoTable(name) => "error 42P01 relation \"${name}\" does not exist"
    Server(code, msg) => "error ${code} ${first_line(msg)}"
    other => "error ${other}"
  }
}

/// The arguments of a case line (after ` ;; `, separated by ` | `), as
/// the reference reads them: T:text, I:int, F:float, B:t or f, N, X:hex,
/// J:json, D:RFC 3339 time, A:ints and S:strs (comma separated, N for
/// NULL).
fn args(s: Str) -> List[sql.SqlValue] {
  var out: List[sql.SqlValue] = []
  for a in s.split(" | ") {
    let (kind, v) = match a.find(":") {
      Some(i) => (a[0..i], a[i + 1..])
      None => (a, "")
    }
    out.push(match kind {
      "T" => sql.str(v)
      "I" => sql.int(Int.parse(v) ?? 0)
      "F" => sql.float(Float.parse(v) ?? 0.0)
      "B" => sql.bool(v == "t")
      "X" => sql.bytes(Bytes.from_hex(v) ?? b"")
      "J" => sql.SqlValue.JsonText(s: v)
      "D" => sql.time(Time.parse_rfc3339(v) ?? fault("D: not an RFC 3339 time in range: ${v}"))
      "A" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.int(Int.parse(x) ?? 0) } }))
      "S" => sql.array(v.split(",").map(fn(x) { if x == "N" { sql.null() } else { sql.str(x) } }))
      _ => sql.null()
    })
  }
  out
}

fn main(os: Os) ! {
  let argv = os.env.args()
  // PG_ROOTS: a PEM file of the roots to trust (pgx's sslrootcert)
  let roots = match os.env.get("PG_ROOTS") {
    Some(path) => os.fs.read(path)?
    None => b""
  }
  if argv.first() == Some("probe") {
    // whether a connection opens and answers a ping: "ok" or "fail"
    let r = sql.open(os.net, "postgres", argv[1], max_open: 1, roots: roots)
    os.stdio.println(if r.is_ok() && r.map(fn(db) { db.ping().is_ok() }) == Ok(true) { "ok" } else { "fail" })
    return
  }
  let dsn = argv.first().or_err("usage: diff DSN < cases")?
  // PG_FRESH: a pool of its own for each statement (internal/stdtest
  // TestPgFuzz: a hostile server closes connections at will)
  let fresh = os.env.get("PG_FRESH").is_some()
  var db = sql.open(os.net, "postgres", dsn, max_open: 1, roots: roots)?
  for line in os.stdio.lines()? {
    if fresh {
      db.close().ignore_err("the next statement opens a pool of its own")
      db = sql.open(os.net, "postgres", dsn, max_open: 1, roots: roots)?
    }
    if line.trim().is_empty() {
      continue
    }
    os.stdio.println("== ${line}")
    if line.starts_with("COPYTO ") {
      // COPY ... TO STDOUT: the data out was given (before an error too)
      // and the result, as the reference prints pgconn's CopyTo
      let data = Mutex.new("")
      let r = db.copy_to(line[7..], fn(b) { data.with(fn(var d) { d = d + b.to_str_lossy() }) })
      os.stdio.println("data ${data.with(fn(d) { d }).quote()}")
      match r {
        Ok(n) => os.stdio.println("copied ${n}")
        Err(e) => os.stdio.println(err_line(e))
      }
      continue
    }
    if line.starts_with("LO ") {
      for l in large_object(db, line[3..]) {
        os.stdio.println(l)
      }
      continue
    }
    if line.starts_with("TYPED ") {
      let rest = line[6..]
      let (kind, q) = match rest.find(" ") {
        Some(i) => (rest[0..i], rest[i + 1..])
        None => (rest, "")
      }
      match typed_lines(db, kind, q) {
        Ok(out) => {
          for l in out {
            os.stdio.println(l)
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
      continue
    }
    if line.starts_with("STRUCTARGS ") || line.starts_with("STRICTSTRUCTARGS ") {
      os.stdio.println(struct_args(db, line.starts_with("STRICT"), line[line.find(" ").or_fault("space") + 1..]))
      continue
    }
    if line.starts_with("BATCH ") {
      match db.batch(batch_items(line[6..])) {
        Ok(sets) => {
          for s in sets {
            if !s.columns().is_empty() {
              os.stdio.println(types_line(s.column_types()))
              for r in s.rows() {
                os.stdio.println(row_line(r))
              }
            }
            os.stdio.println("affected ${s.rows_affected()}")
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
      continue
    }
    let (stmt, xs) = match line.find(" ;; ") {
      Some(i) => (line[0..i], args(line[i + 4..]))
      None => (line, [])
    }
    if line.starts_with("SELECT") {
      match select_lines(db, stmt, xs) {
        Ok(out) => {
          for l in out {
            os.stdio.println(l)
          }
        }
        Err(e) => os.stdio.println(err_line(e))
      }
    } else {
      match db.exec(stmt, xs) {
        Ok(x) => os.stdio.println("affected ${x.rows_affected}")
        Err(e) => os.stdio.println(err_line(e))
      }
    }
  }
}

/// A STRUCTARGS line's struct (decision 0682, task #124): the
/// reference's saRow with pgx's db tags, field for field.
struct SaRow {
  name: Str
  n: Int?
  f: Float
  b: Bool
  at: Time
  d: Bytes
  d2: Bytes?
  tags: List[Str]
  ns: List[Int]
  skip as "-": Str = ""
} derive SqlRow

fn sa_rows() -> List[SaRow] {
  [
    SaRow{name: "sa1", n: Some(7), f: 1.5, b: true, at: Time.from_unix(1792458183), d: b"\x00\xff", d2: Some(b"x"), tags: ["x", "y z"], ns: [1, 3], skip: "s"},
    SaRow{name: "sa2", n: None, f: -0.25, b: false, at: Time.from_unix(0), d: b"", d2: None, tags: [], ns: []},
  ]
}

/// `N QUERY` of a STRUCTARGS line: sql.named_args of row N through
/// sql.named (strict for STRICTSTRUCTARGS), as the reference runs pgx's
/// StructArgs; "error rewrite" for a name the rewrite refuses.
fn struct_args(db: sql.Db, strict: Bool, rest: Str) -> Str uses net.dial {
  let sp = rest.find(" ").or_fault("STRUCTARGS N QUERY")
  let k = Int.parse(rest[0..sp]).or_fault("row number")
  let (q, xs) = match sql.named(rest[sp + 1..], sql.named_args(sa_rows()[k - 1]), strict: strict) {
    Ok(r) => r
    Err(_) => return "error rewrite"
  }
  match db.exec(q, xs) {
    Ok(x) => "affected ${x.rows_affected}"
    Err(e) => err_line(e)
  }
}

/// A SELECT's column types (decision 0609, as the reference prints pgx
/// stdlib's) and then each row as Go's Row Debug text; the whole result
/// first, so an error part way prints the error alone as pgconn's ReadAll.
fn select_lines(db: sql.Db, stmt: Str, xs: List[sql.SqlValue]) -> List[Str] ! sql.SqlErr uses net.dial {
  let rows = db.rows(stmt, xs)?
  defer rows.close()
  var out = [types_line(rows.column_types())]
  while let Some(r) = rows.next()? {
    out.push(row_line(r))
  }
  out
}

fn types_line(cts: List[sql.ColumnType]) -> Str {
  let ts = cts.map(fn(t) {
    let len = t.length.map(fn(n) { "${n}" }) ?? "-"
    let ps = match (t.precision, t.scale) {
      (Some(p), Some(s)) => "${p},${s}"
      _ => "-"
    }
    "${t.name}:${t.database_type}:${len}:${ps}"
  })
  "types " + ts.join(" ")
}

fn row_line(r: sql.Row) -> Str {
  // by position: two columns can share a name (SELECT 1 AS c, 2 AS c)
  let vals = r.values()
  "Row{cols: ${r.columns().debug()}, vals: ${vals.debug()}}"
}

/// A BATCH line's queries (decision 0648 item 15), as the reference reads
/// them: items separated by ` || `, each a query with ` ;; ` arguments,
/// `N*` before one repeating it N times.
fn batch_items(s: Str) -> List[sql.BatchQuery] {
  var out: List[sql.BatchQuery] = []
  for item in s.split(" || ") {
    var n = 1
    var it = item
    if let Some(i) = item.find("*") {
      if let Some(k) = Int.parse(item[0..i]) {
        n = k
        it = item[i + 1..]
      }
    }
    let q = match it.find(" ;; ") {
      Some(i) => sql.BatchQuery{query: it[0..i], args: args(it[i + 4..])}
      None => sql.BatchQuery{query: it}
    }
    for _ in 0..n {
      out.push(q)
    }
  }
  out
}

/// A `TYPED KIND SELECT ...` line (decision 0679): each cell read by the
/// typed reader for KIND, as the reference prints pgx's pgtype value:
/// its Debug text, NULL, or "error" for a Mismatch.
fn typed_lines(db: sql.Db, kind: Str, q: Str) -> List[Str] ! sql.SqlErr uses net.dial {
  let rows = db.rows(q, [])?
  defer rows.close()
  var out: List[Str] = []
  while let Some(r) = rows.next()? {
    let cells = r.columns().map(fn(c) { typed_cell(r, kind, c) })
    out.push("typed " + cells.join(" | "))
  }
  out
}

/// A range as the reference prints it: `[a,b)`, `(,b]`, `empty`.
fn rtext[T](r: sql.Range[T], f: fn(T) -> Str) -> Str {
  match r {
    Empty => "empty"
    Span(lo, hi) => {
      let l = match lo {
        Inclusive(v) => "[" + f(v)
        Exclusive(v) => "(" + f(v)
        Unbounded => "("
      }
      let u = match hi {
        Inclusive(v) => f(v) + "]"
        Exclusive(v) => f(v) + ")"
        Unbounded => ")"
      }
      l + "," + u
    }
  }
}

/// A numeric as the reference prints it: COEFeEXP, NaN, Infinity.
fn nparts(n: sql.Numeric) -> Str {
  match n {
    Finite(c, e) => "${c.text()}e${e}"
    other => other.display()
  }
}

fn dtext(d: time.Date) -> Str {
  let m = if d.month < 10 { "0${d.month}" } else { "${d.month}" }
  let dd = if d.day < 10 { "0${d.day}" } else { "${d.day}" }
  "${d.year}-${m}-${dd}"
}

fn typed_cell(r: sql.Row, kind: Str, c: Str) -> Str {
  if kind.starts_with("arr:") {
    // an array: each element through the element kind (decision 0679)
    return match r.elements_opt(c) {
      Ok(None) => "NULL"
      Ok(Some(es)) => "[" + es.map(fn(e) { typed_cell(e, kind[4..], c) }).join(", ") + "]"
      Err(_) => "error"
    }
  }
  let got: Result[Str?, sql.SqlErr] = match kind {
    "uuid" => r.uuid_opt(c).map(fn(o) { o.map(fn(u) { u.display().debug() }) })
    "date" => r.date_opt(c).map(fn(o) { o.map(fn(d) { d.debug() }) })
    "time" => r.time_of_day_opt(c).map(fn(o) { o.map(fn(t) { t.debug() }) })
    "interval" => r.interval_opt(c).map(fn(o) { o.map(fn(i) { i.debug() }) })
    "inet" => r.prefix_opt(c).map(fn(o) { o.map(fn(p) { p.display().debug() }) })
    "fields" => r.fields_opt(c).map(fn(o) { o.map(fn(fs) { fs.debug() }) })
    "numeric" => r.numeric_opt(c).map(fn(o) { o.map(fn(n) { nparts(n) }) })
    "numrange" => r.range_num_opt(c).map(fn(o) { o.map(fn(v) { rtext(v, nparts) }) })
    "nummulti" => r.multirange_num_opt(c).map(fn(o) { o.map(fn(rs) { "{" + rs.map(fn(v) { rtext(v, nparts) }).join(",") + "}" }) })
    "intrange" => r.range_int_opt(c).map(fn(o) { o.map(fn(v) { rtext(v, fn(n) { "${n}" }) }) })
    "daterange" => r.range_date_opt(c).map(fn(o) { o.map(fn(v) { rtext(v, dtext) }) })
    "timerange" => r.range_time_opt(c).map(fn(o) { o.map(fn(v) { rtext(v, fn(t) { t.format_rfc3339() }) }) })
    "intmulti" => r.multirange_int_opt(c).map(fn(o) { o.map(fn(rs) { "{" + rs.map(fn(v) { rtext(v, fn(n) { "${n}" }) }).join(",") + "}" }) })
    "datemulti" => r.multirange_date_opt(c).map(fn(o) { o.map(fn(rs) { "{" + rs.map(fn(v) { rtext(v, dtext) }).join(",") + "}" }) })
    "timemulti" => r.multirange_time_opt(c).map(fn(o) { o.map(fn(rs) { "{" + rs.map(fn(v) { rtext(v, fn(t) { t.format_rfc3339() }) }).join(",") + "}" }) })
    "datebound" => r.date_bound_opt(c).map(fn(o) { o.map(fn(b) { b.debug() }) })
    "timebound" => r.time_bound_opt(c).map(fn(o) {
      o.map(fn(b) {
        match b {
          Finite(t) => "Finite(${sql.SqlValue.At(t: t):?})"
          other => other.debug()
        }
      })
    })
    "mac" => r.mac_opt(c).map(fn(o) { o.map(fn(b) { b.to_hex().debug() }) })
    "hstore" => r.hstore_opt(c).map(fn(o) {
      o.map(fn(m) {
        let ks = m.keys().sort()
        "{" + ks.map(fn(k) { "${k.debug()}: ${(m.get(k) ?? None).map(fn(v) { v.debug() }) ?? "NULL"}" }).join(", ") + "}"
      })
    })
    _ => Ok(Some("error unknown kind ${kind}"))
  }
  match got {
    Ok(Some(t)) => t
    Ok(None) => "NULL"
    Err(_) => "error"
  }
}

fn lo_say[T: Display](what: Str, r: Result[T, sql.SqlErr]) -> Str {
  match r {
    Ok(v) => "${what}: ${v}"
    Err(e) => lo_err(what, e)
  }
}

fn lo_err(what: Str, e: sql.SqlErr) -> Str {
  match e {
    Server(code, _) => "${what}: error ${code}"
    other => "${what}: error ${other}"
  }
}

/// An `LO DATA` line (decision 0679): Tx.lo_* through create, write,
/// seek, read, tell, truncate, close and unlink in one transaction, then
/// an unlink of the removed object in another; as the reference prints
/// pgx's LargeObjects.
fn large_object(db: sql.Db, data: Str) -> List[Str] uses net.dial {
  var out: List[Str] = []
  let tx = match db.begin() {
    Ok(t) => t
    Err(e) => return [lo_err("begin", e)]
  }
  out.push("begin: ok")
  let oid = match tx.lo_create() {
    Ok(o) => o
    Err(e) => {
      out.push(lo_err("create", e))
      return out
    }
  }
  out.push("create: ${oid > 0}")
  let lo = match tx.lo_open(oid) {
    Ok(l) => l
    Err(e) => {
      out.push(lo_err("open", e))
      return out
    }
  }
  out.push("open: ok")
  out.push(lo_say("write", tx.lo_write(lo, data.bytes())))
  out.push(lo_say("seek", tx.lo_seek(lo, 0)))
  out.push(lo_say("read", tx.lo_read(lo, 100).map(fn(b) { b.to_str_lossy().debug() })))
  out.push(lo_say("tell", tx.lo_tell(lo)))
  out.push(lo_say("truncate", tx.lo_truncate(lo, 3).map(fn(_) { "ok" })))
  out.push(lo_say("seek end", tx.lo_seek(lo, -1, whence: 2)))
  out.push(lo_say("read end", tx.lo_read(lo, 100).map(fn(b) { b.to_str_lossy().debug() })))
  out.push(lo_say("close", tx.lo_close(lo).map(fn(_) { "ok" })))
  out.push(lo_say("unlink", tx.lo_unlink(oid).map(fn(_) { "ok" })))
  out.push(lo_say("commit", tx.commit().map(fn(_) { "ok" })))
  let tx2 = match db.begin() {
    Ok(t) => t
    Err(e) => {
      out.push(lo_err("begin", e))
      return out
    }
  }
  out.push("begin: ok")
  out.push(lo_say("unlink again", tx2.lo_unlink(oid).map(fn(_) { "ok" })))
  out.push(lo_say("rollback", tx2.rollback().map(fn(_) { "ok" })))
  out
}
