// The Xo side of the netip differential test (internal/stdtest
// TestNetipFuzz): each line on standard input is an operation and its
// arguments, each "x" then hex, printed as the test prints Go's net/netip
// (and net's SplitHostPort and JoinHostPort):
//   addr S B Z      ParseAddr(S), then every accessor, Prefix(B), WithZone(Z), Next, Prev
//   prefix S A P    ParsePrefix(S), then Masked, Bits, IsSingleIP, Contains(ParseAddr(A)), Overlaps(ParsePrefix(P))
//   addrport S      ParseAddrPort(S)
//   split S         net.SplitHostPort(S), then JoinHostPort of the result
//   from B          AddrFromSlice(B)
//   cmp S T         Compare of ParseAddr(S) and ParseAddr(T)
use std/netip

fn arg(h: Str) -> Bytes ! Str { Bytes.from_hex(h.trim_prefix("x")).or_err("bad hex ${h}") }

fn text(h: Str) -> Str ! Str { arg(h)?.to_str().or_err("not UTF-8: ${h}") }

fn b01(x: Bool) -> Str { if x { "1" } else { "0" } }

fn opt(a: netip.Addr?) -> Str {
  match a {
    Some(x) => "${x}"
    None => "none"
  }
}

fn describe(a: netip.Addr) -> Str {
  let flags = b01(a.is_4()) + b01(a.is_6()) + b01(a.is_4in6()) + b01(a.is_loopback()) + b01(a.is_private()) + b01(a.is_unspecified()) + b01(a.is_link_local_unicast()) + b01(a.is_multicast())
  "${a} bits ${a.bits} zone ${a.zone.quote()} bytes ${a.bytes().to_hex()} flags ${flags} unmap ${a.unmap()}"
}

fn main(os: Os) ! {
  for line in os.stdio.lines()? {
    let w = line.trim().split(" ")
    if w.len() < 2 {
      continue
    }
    os.stdio.println("== ${line.trim()}")
    match w[0] {
      "addr" => {
        match netip.parse_addr(text(w[1])?) {
          Ok(a) => {
            os.stdio.println(describe(a))
            let b = Int.parse(text(w[2])?) ?? 0
            match a.prefix(b) {
              Ok(p) => os.stdio.println("prefix ${b} ${p}")
              Err(e) => os.stdio.println("prefix ${b} error ${e}")
            }
            os.stdio.println("zone ${describe(a.with_zone(text(w[3])?))}")
            os.stdio.println("next ${opt(a.next())} prev ${opt(a.prev())}")
          }
          Err(e) => os.stdio.println("error ${e}")
        }
      }
      "prefix" => {
        match netip.parse_prefix(text(w[1])?) {
          Ok(p) => {
            os.stdio.println("${p} masked ${p.masked()} bits ${p.bits()} single ${b01(p.is_single_ip())}")
            match netip.parse_addr(text(w[2])?) {
              Ok(a) => os.stdio.println("contains ${a} ${b01(p.contains(a))}")
              Err(_) => {}
            }
            match netip.parse_prefix(text(w[3])?) {
              Ok(q) => os.stdio.println("overlaps ${q} ${b01(p.overlaps(q))}")
              Err(_) => {}
            }
          }
          Err(e) => os.stdio.println("error ${e}")
        }
      }
      "addrport" => {
        match netip.parse_addr_port(text(w[1])?) {
          Ok(ap) => os.stdio.println("${ap} addr ${ap.addr} port ${ap.port}")
          Err(e) => os.stdio.println("error ${e}")
        }
      }
      "split" => {
        match netip.split_host_port(text(w[1])?) {
          Ok((h, p)) => os.stdio.println("host ${h.quote()} port ${p.quote()} join ${netip.join_host_port(h, p).quote()}")
          Err(e) => os.stdio.println("error ${e}")
        }
      }
      "from" => os.stdio.println(match netip.addr_from_bytes(arg(w[1])?) {
        Some(a) => describe(a)
        None => "none"
      })
      _ => {
        let a = netip.parse_addr(text(w[1])?)
        let b = netip.parse_addr(text(w[2])?)
        match (a, b) {
          (Ok(x), Ok(y)) => os.stdio.println("cmp ${if x < y { -1 } else if x > y { 1 } else { 0 }}")
          _ => os.stdio.println("cmp skip")
        }
      }
    }
  }
}
