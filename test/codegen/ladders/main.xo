// Codegen patterns (decision 0634, `xo dev codegen`): a release ladder a
// function repeats verbatim becomes one local subroutine. Each arm of
// pick's match but the last releases, at its start, the 26 Lists it does
// not use, the same slots in the same order (26: with 20, the 5 the
// registers hold left 15 slots, under ladders.xo LADDER_MIN once a push
// run's growth was no loop, task #329): one `_ld0` subroutine (with
// a frame record, its slots read 16 bytes further), and each arm calls it;
// on amd64 the same with `callq` and a pushed rbp.
fn pick(os: Os, k: Int, seed: Int) -> Int {
  // arm64: "(?s)bl \.?L[A-Za-z0-9_]*_ld0\n.*bl \.?L[A-Za-z0-9_]*_ld0\n.*bl \.?L[A-Za-z0-9_]*_ld0\n.*_ld0:\n\tstp x29, x30, \[sp, #-16\]!" -"_ld1:"
  // amd64: "(?s)callq \.?L[A-Za-z0-9_]*_ld0\n.*callq \.?L[A-Za-z0-9_]*_ld0\n.*callq \.?L[A-Za-z0-9_]*_ld0\n.*_ld0:\n\tpushq %rbp\n" -"_ld1:"
  let a0 = [seed + 0, k]
  let a1 = [seed + 1, k]
  let a2 = [seed + 2, k]
  let a3 = [seed + 3, k]
  let a4 = [seed + 4, k]
  let a5 = [seed + 5, k]
  let a6 = [seed + 6, k]
  let a7 = [seed + 7, k]
  let a8 = [seed + 8, k]
  let a9 = [seed + 9, k]
  let a10 = [seed + 10, k]
  let a11 = [seed + 11, k]
  let a12 = [seed + 12, k]
  let a13 = [seed + 13, k]
  let a14 = [seed + 14, k]
  let a15 = [seed + 15, k]
  let a16 = [seed + 16, k]
  let a17 = [seed + 17, k]
  let a18 = [seed + 18, k]
  let a19 = [seed + 19, k]
  let a20 = [seed + 20, k]
  let a21 = [seed + 21, k]
  let a22 = [seed + 22, k]
  let a23 = [seed + 23, k]
  let a24 = [seed + 24, k]
  let a25 = [seed + 25, k]
  match k {
    0 => { os.stdio.println("zero ${k}"); 0 }
    1 => { os.stdio.println("one ${k}"); 1 }
    2 => { os.stdio.println("two ${k}"); 2 }
    3 => { os.stdio.println("three ${k}"); 3 }
    4 => { os.stdio.println("four ${k}"); 4 }
    _ => a0.len() + a1.len() + a2.len() + a3.len() + a4.len() + a5.len() + a6.len() + a7.len() + a8.len() + a9.len() + a10.len() + a11.len() + a12.len() + a13.len() + a14.len() + a15.len() + a16.len() + a17.len() + a18.len() + a19.len() + a20.len() + a21.len() + a22.len() + a23.len() + a24.len() + a25.len()
  }
}

fn main(os: Os) {
  for k in 0..6 { os.stdio.println("${pick(os, k, os.env.args().len())}") }
}
