// Codegen patterns (decision 0217, `xo dev codegen`): `==` and `!=` on
// variants known at build time are constants
// (gotchas/arm64-target-enum-eq-not-folded.md).

enum Color {
  Red
  Green
  Blue(n: Int)
}

// The target's fields are variants known at build time: no call to the
// enum's equality, no compare. The emitter writes a call as tab, bl,
// space, symbol (arm64 emit.xo), so the space form is the one that
// recognizes it; the tab form never occurred (2026-10-26).
fn is_mac() -> Bool {
  // arm64: -"\tbl "
  // amd64: -"\tcallq "
  // llvm: -"call " -"icmp"
  target.os == TargetOs.Darwin
}

fn not_wasm() -> Bool {
  // arm64: -"\tbl "
  // amd64: -"\tcallq "
  // llvm: -"call " -"icmp"
  target.arch != TargetArch.Wasm32
}

// Two literal variants of a user enum.
fn same() -> Bool {
  // arm64: -"\tbl "
  // amd64: -"\tcallq "
  // llvm: -"call " -"icmp"
  Color.Red == Color.Green
}

// A variable stays a run-time compare.
fn is_red(c: Color) -> Bool {
  c == Color.Red
}

// A match arm whose variant holds no heap value drops nothing: the Ok
// arm of a Result[Duration, DurationErr] called the Result's drop helper
// (a bl _xo_h<hash>) on every parse; the Err arm still drops its text.
// Between the parse and the return: the text's release on Some and the
// Err arm's drop, not a third (2026-10-26, bench/perf/text dur_parse).
fn ok_nanos(t: Str) -> Int {
  // arm64: "bl _xo_f_text_2eparse__duration" -"(?s)parse__duration.*bl _xo_h.*bl _xo_h.*bl _xo_h.*\tret"
  // amd64: "callq _xo_f_text_2eparse__duration" -"(?s)parse__duration.*callq _xo_h.*callq _xo_h.*callq _xo_h.*\tretq"
  match Duration.parse(t) {
    Ok(d) => d.nanos()
    Err(_) => -1
  }
}

fn main(os: Os) {
  let n = os.env.args().len()
  let c = if n > 5 { Color.Blue(n: n) } else { Color.Red }
  os.stdio.println("${is_mac() || !is_mac()} ${not_wasm()} ${same()} ${is_red(c)} ${ok_nanos("${n}s")}")
}
