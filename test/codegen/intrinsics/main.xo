// Codegen patterns (decision 0217, `xo dev codegen`): the CPU
// instructions of std/native/llrt/cpu.xo (decision 0231) reach the hot
// loops of the field arithmetic. On arm64 each carry is cmn (or cmp) and
// cset, with no branch; on LLVM llvm.uadd.with.overflow and
// llvm.usub.with.overflow. AES-GCM's rounds and GHASH's products are
// AESE/AESMC and PMULL (inline asm on LLVM); SHA-256's compression is
// SHA256H, SHA256H2, SHA256SU0, and SHA256SU1.
use std/compress
use std/crc32
use std/internal

fn main(os: Os) {
  let n = os.env.args().len()
  let k = "0123456789abcdef0123456789abcde${n}".bytes()
  let p = internal.crypto_op("p256.public", k, b"", b"", b"")
  let g = internal.crypto_op("aes.seal", k[0..16], k[0..12], k, b"")
  let c = internal.crypto_op("sysc.present", b"", b"", b"", b"")
  let cc = internal.crypto_op("chacha.seal", k, k[0..12], k, b"")
  let h = internal.crypto_op("hash.sha256", k, b"", b"", b"")
  let s3 = internal.crypto_op("sha3.sha3_256", k, b"", b"", b"")
  // a run long enough for fold_copy_lo's 16 byte lane (decision 0373)
  let f = ("The Quick Brown Fox Jumps Over The Lazy Dog ${n}").to_lower()
  let u = ("the quick brown fox jumps over the lazy dog ${n}").to_upper()
  // the swap's two index checks, from a runtime index so neither is proven
  let xs = [1, 2, 3]
  let ys = xs[0..n]
  internal.list_swap_at(xs, n, n + 1)
  internal.list_swap_both(xs, ys, ys)
  // gzip's CRC-32 of its input (flate.crc32)
  let z = compress.gzip(k)
  // std/crc32's Castagnoli (crc32.castagnoli)
  let cz = crc32.checksum(k, crc32.Poly.Castagnoli)
  os.stdio.println("${z.len() + cz} ${p.to_hex()} ${g.to_hex()} ${c.to_hex()} ${cc.to_hex()} ${h.to_hex()} ${s3.to_hex()} ${f.len() + u.len()}")
}

// ASCII case folding on mixed case text is one 16 byte lane: the range
// test is one unsigned compare of the bytes shifted down by the case's
// first letter, two byte shifts build 0x20 from the all ones mask, and the
// fold is one add (decision 0373). No call to a runtime function.
// func obj.fold_copy_lo
// arm64: "cmhs v31.16b, v31.16b, v30.16b\n\tushr v31.16b, v31.16b, #7\n\tshl v31.16b, v31.16b, #5\n\tadd v30.16b, v30.16b, v31.16b" -"\tbl "
// amd64: "movdqu \(%r[a-z0-9]+,%r[a-z0-9]+\), %xmm" "psubb %xmm" -"\tcallq "
// func obj.fold_copy_up
// arm64: "cmhs v31.16b, v31.16b, v30.16b\n\tushr v31.16b, v31.16b, #7\n\tshl v31.16b, v31.16b, #5\n\tsub v30.16b, v30.16b, v31.16b"
// amd64: "movdqu \(%r[a-z0-9]+,%r[a-z0-9]+\), %xmm"

// The Montgomery product of any 4 limb modulus (P-256's scalars, P-224;
// generated by scripts/gen/nistecmul4p since 2026-10-21): every sum a
// chain of cpu.adc, so each product feeds an adcs with the carry in the
// flags, and no overflow check.
// func nistec.mul4
// arm64: "umulh x[0-9]+, x[0-9]+, x[0-9]+\n\tadcs x[0-9]+, x[0-9]+, x[0-9]+" -"b\.vs"
// amd64: "mulq -?[0-9]*\(%r" "adcq -?[0-9]*\(%r" -"\tbtq " -"(?s)(\timulq .*){8}" -"\tjo "
// llvm: "llvm.uadd.with.overflow.i64"

// P-256's field product adds with carry in (decision 0231's addendum):
// each pair of cpu.adc and adc_carry of the same operands is one adcs
// (adds for a carry in of 0), a chain an instruction per pair with the
// carry in the flags, each product made right before the pair that adds
// it, and one callee saved pair (x20, x19) as LLVM; on LLVM a chain of
// llvm.uadd.with.overflow.
// func nistec.mul4p
// arm64: "adcs x[0-9]+, x[0-9]+, x[0-9]+\n\tcset x[0-9]+, cs" "umulh x[0-9]+, x[0-9]+, x[0-9]+\n\tadcs" -"stp x22, x21"
// amd64: "mulq " "adcq " -"\tbtq " -"imulq"
// llvm: "llvm.uadd.with.overflow.i64"

// P-256's field difference f + ~g + 1 (cpu.adc of ~g): subs, then sbcs
// of g itself (a + ~b with carry in is sbcs a, b: no mvn), the two Not
// values of each ~g (the sum's and the carry's) one operand.
// func nistec.sub4p
// arm64: "subs x[0-9]+, x[0-9]+, x[0-9]+\n\tsbcs x[0-9]+, x[0-9]+, x[0-9]+" -"mvn"
// amd64: "subq " "sbbq -?[0-9]*\(%r" -"notq" -"pushq"

// The point functions' 32 byte copies are loads and stores, not calls
// of memcpy (rt.mem_copy of a known small length).
// func nistec.pt_double256
// arm64: "adcs" -"memcpy"
// amd64: "adcq " -"memcpy"

// Keccak's D = C ^ rot(C, 1): the rotation is eor's shifted operand (a
// rotation by a constant read once folds into eor, bic, orr).
// func sha3.keccak
// arm64: "eor x[0-9]+, x[0-9]+, x[0-9]+, ror #63"
// amd64: "rorq \$63, |rolq \$1, "

// The final subtraction's borrows: f - g as f + ~g with a carry in of 1,
// one subtract with borrow chain (2026-10-19), then the masked add back.
// func nistec.sub4
// arm64: "subs x[0-9]+, x[0-9]+, x[0-9]+\n\tsbcs x[0-9]+, x[0-9]+, x[0-9]+" "adcs"
// amd64: "sbbq " "adcq "
// llvm: "llvm.uadd.with.overflow.i64"

// The CRC-32 of gzip and zip a word a step with arm64's crc32x (decision
// 0231 addendum, 2026-10-28): the IEEE polynomial, inline asm on LLVM;
// amd64's crc32 is Castagnoli only, so the slicing loop stays there.
// func flate.crc32
// arm64: "crc32x w[0-9]+, w[0-9]+, x[0-9]+"
// amd64: -"crc32x"
// llvm/arm64: "crc32x \$\{0:w\}"

// std/crc32's Castagnoli a word a step with arm64's crc32cx (decision
// 0231 addendum, 2026-10-29; Go's castagnoliUpdate on arm64).
// func crc32.castagnoli
// arm64: "crc32cx w[0-9]+, w[0-9]+, x[0-9]+"
// amd64: "crc32q %r[a-z0-9]+, %r[a-z0-9]+"
// llvm/arm64: "crc32cx \$\{0:w\}"

// Keccak-f[1600] with arm64's SHA3 extension (cpu.keccak_f1600, ssa
// a64keccak.xo, Go's keccakF1600NEON; 2026-10-28): theta's eor3 and
// rax1, rho and pi's xar, chi's bcax; inline asm on LLVM; amd64 keeps the
// scalar rounds.
// func sha3.permute
// arm64: "eor3 v25.16b, v10.16b, v15.16b, v20.16b" "rax1 v30.2d, v25.2d, v27.2d" "xar v25.2d, v1.2d, v30.2d, #63" "bcax v20.16b, v26.16b, v22.16b, v8.16b"
// amd64: -"eor3"
// llvm/arm64: "eor3 v25.16b" "bcax v20.16b"

// The CPU's AES rounds (hw4 and encrypt_n call hw_n).
// func aesgcm.hw_n
// arm64: "aese v30.16b, v31.16b\n\taesmc v30.16b, v30.16b" "aese v30.16b, v31.16b\n\tldr q31"
// amd64: "aesenc %xmm"
// llvm/arm64: "aese \$0.16b, \$2.16b\\0Aaesmc"

// AES-GCM's bulk eight blocks a round on amd64 (cpu.aes_gcm8, ssa
// x86aesgcm8.xo, Go's gcmAesEnc): a round key through the eight blocks,
// then one block's GHASH (its bytes swapped, three carry-less products),
// not the portable body's aes_ctr and ghash calls.
// func aesgcm.Gcm.gcm_bulk
// amd64: "(\taesenc %xmm11, %xmm[0-7]\n){7}\taesenc %xmm11, %xmm7\n\tmovdqu -?[0-9]*\(%r[0-9a-z]+\), %xmm12\n\tpshufb %xmm15, %xmm12" "pclmulqdq \$16, %xmm12, %xmm11" "pclmulqdq \$1, %xmm12, %xmm11" "pclmulqdq \$0, %xmm13, %xmm11" -"_xo_f_cpu_2eghash" -"_xo_f_cpu_2eaes__ctr"

// SHA-256's compression with the CPU's instructions (decision 0231's
// SHA-256 section): the state packed into v16 and v17, four rounds a
// sha256h and sha256h2.
// func sha256.block256
// arm64: "sha256su0 v19.4s, v20.4s" "sha256h q16, q17, v31.4s\n\tsha256h2 q17, q18, v31.4s" "uzp1 v16.4s, v16.4s, v17.4s"
// amd64: "sha256rnds2 " "sha256msg1 "
// llvm/arm64: "sha256h \$\{0:q\}" "sha256su1 \$0.4s"

// GHASH's carry-less products.
// func aesgcm.Gcm.mul_hw
// arm64: "pmull v30.1q, v30.1d, v31.1d" "umov x[0-9]+, v30.d\[1\]"
// amd64: "pclmulqdq "
// llvm/arm64: "pmull \$0.1q"

// std/native/sys_c.xo (decision 0232): a strong C call, and a symbol's
// presence read through the GOT (arm64) or compared with null (LLVM);
// ThreadSanitizer's presence is known false outside --race on the native
// backends (compiler/ssa call.xo sym_present; LLVM keeps it, its IR may be
// compiled with -fsanitize=thread: TestSysCTSan), so no ___tsan_ reference is left (14 failed weak
// lookups at every launch before, 2026-10-28; --race keeps it:
// internal/llvm TestRaceDefaultNative)
// func internal.sysc_op
// arm64: "bl _getpid" "_getpid@GOTPAGE\n\tldr x[0-9]+, \[x[0-9]+, _getpid@GOTPAGEOFF\]" -"___tsan_acquire"
// amd64: "callq _getpid" "_getpid@GOTPCREL\(%rip\)" -"___tsan_acquire"
// llvm: "call i32 @getpid\(\)" "icmp ne ptr @getpid, null" "icmp ne ptr @__tsan_acquire, null"

// ChaCha20's adds modulo 2^32 are 32 bit adds (add_w32), not an add and
// an and; Poly1305's limb products have no overflow checks.
// func chacha.xor_stream
// arm64: "add w[0-9]+, w[0-9]+, w[0-9]+"
// amd64: "leal \(%r[a-z0-9]+,%r[a-z0-9]+\), %e" "rorl \$" -"andq \$4294967295"
// amd64: "pshufb %xmm10, %xmm3\n\tpaddd %xmm5, %xmm4" "pshufd \$57, %xmm1, %xmm1" "pshufd \$147, %xmm3, %xmm3" -"_xo_f_cpu_2echacha__block__xor"
// ChaCha20-Poly1305's bulk in one loop (cpu.chacha_poly_seal4 and seal8):
// Poly1305's mulq by r read from its state between the rounds, and the
// AVX2 kernel's two blocks a ymm register (vperm2i128 gathering a block's
// rows, vzeroupper after).
// amd64: "mulq %rbx" "movq 24\(%rdi\), %rax" "vpshufb 272\(%rsi\), %ymm3, %ymm3" "vperm2i128 \$32, %ymm1, %ymm0, %ymm8" "vzeroupper"
// func chacha.absorb26
// arm64: -"smulh" -"b\.vs"
// llvm: -"with.overflow"
// amd64's 64 bit limbs (cpu.poly_blocks): mulq, no overflow checks.
// func cpu.poly_blocks
// amd64: "mulq " -"\tjo "

// A swap checks each index against the list it indexes (2026-10-26): with
// entry parameters as indexes, neither known non negative, both checks
// remain (b.hs to a fault), where before the call carried no position and
// bounds_check emitted nothing at all. With both indexes lengths that the
// guards prove in range there is no check.
// func internal.list_swap_at
// arm64: "b\.hs"
// amd64: "\tjae "
// func internal.list_swap_both
// arm64: -"b\.hs"
// amd64: -"\tjae "
