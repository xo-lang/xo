// Codegen patterns (decision 0217, `xo dev codegen`): the constant time
// code of the native runtime (decision 0222, std/native/llrt/ct.xo)
// keeps no branch on a secret, and rt.ct_barrier reaches the LLVM IR as
// an empty asm. internal/llvm's TestConstantTimeLLVM checks what clang
// -O2 makes of it.
use std/crypto

fn main(os: Os) {
  let n = os.env.args().len()
  let seed = "0123456789abcdef0123456789abcde${n}".bytes()
  os.stdio.println("${crypto.equal(b"abcdefghij", "abcdefghi${n}".bytes())} ${crypto.ed25519_sign(seed, b"m").to_hex()}")
}

// The comparison's accumulator goes through the barrier in both loops
// (no early exit), and the result is one compare after them.
// func ct.bytes_equal
// llvm: "(?s)call i64 asm \"\", \"=r,0\".*call i64 asm \"\", \"=r,0\""
// arm64: "eor x[0-9]+, x[0-9]+, x[0-9]+\n\torr x[0-9]+, x[0-9]+, x[0-9]+" -"csel" -"cbn?z" -"tbn?z"

// A mask is arithmetic only: no branch, no conditional select.
// func ct.mask_nonzero
// llvm: "call i64 asm \"\", \"=r,0\"" -"br i1" -"select" -"icmp"
// arm64: "lsr x[0-9]+, x[0-9]+, #63" -"\tb\." -"cbn?z" -"tbn?z" -"csel" -"cset"

// A masked pick is and and xor on the barrier's value.
// func ct.pick
// llvm: "call i64 asm \"\", \"=r,0\"" -"br i1" -"select"
// arm64: "and x[0-9]+, x[0-9]+, x[0-9]+" -"\tb\." -"cbn?z" -"tbn?z" -"csel"

// Ed25519 (std/native/llrt/ed25519.xo): the window table's lookup
// (a conditional move of every entry with a mask), the scalar
// multiplication, and the scalar reduction's conditional subtraction
// select with masks (the branches left are loops and bounds checks on
// public indices).
// func ed25519.ge_cmov
// arm64: "eor x[0-9]+, x[0-9]+, x[0-9]+" -"\tb\." -"cbn?z" -"tbn?z" -"csel" -"cset"
// llvm: "call i64 @\"x.ct.pick\"" -"br i1" -"select"
// func ed25519.ge_mul
// arm64: -"csel" -"cset"
// llvm: "call i64 @\"x.ct.mask_eq\"" -"select"
// func ed25519.sc_reduce
// llvm: "call i64 @\"x.ct.mask_bit\"" "call i64 @\"x.ct.pick\"" -"select"
// arm64: -"csel" -"cset"
