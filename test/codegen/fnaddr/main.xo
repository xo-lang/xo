// Codegen patterns (decision 0217, `xo dev codegen`) of the address
// intrinsics of decision 0233 through std/internal's test
// hook (std/native/internal.xo rt_op): cabi.xo's fmt_int called through
// rt.fn_addr's address (05 31: the length of "12345" and its "1"), and
// rt.frame_addr (01 01 01: not 0, a callee's frame below it, within
// 64 KiB); rt.sym_addr (decision 0234): xo_entry's and strlen's addresses.
use std/internal

fn main(os: Os) {
  os.stdio.println(internal.crypto_op("rt.fn_addr", b"", b"", b"", b"").to_hex())
  os.stdio.println(internal.crypto_op("rt.frame_addr", b"", b"", b"", b"").to_hex())
  os.stdio.println(internal.crypto_op("rt.sym_addr", b"", b"", b"", b"").to_hex())
}

// rt.fn_addr is the export's symbol address, no call.
// func internal.rt_op
// arm64: "adrp[^\n]*xo_x_fmt_int"
// amd64: "leaq _xo_x_fmt_int\(%rip\)"
// llvm: "ptrtoint ptr @xo_x_fmt_int to i64"

// rt.sym_addr is the C symbol's address under its exact name, declared
// when the module does not define it.
// func internal.rt_op
// arm64: "adrp[^\n]*xo_entry" "adrp[^\n]*(strlen@GOTPAGE|:got:strlen)"
// amd64: "leaq _xo_entry\(%rip\)" "_strlen@GOTPCREL\(%rip\)"
// llvm: "ptrtoint ptr @xo_entry to i64" "ptrtoint ptr @strlen to i64"

// rt.frame_addr is the frame pointer of a function that keeps its frame
// record (a leaf otherwise), is never inlined, and makes no tail call: a
// fault boundary is such a frame (entry.main_on_fiber, tasks.run_entry),
// and a callee that took its place would sit above the boundary, where
// unwind.raise stops (2026-10-31: a split LLVM build at -O2 ran main
// past main_on_fiber's frame and dropped main's defers).
// func internal.frame_below
// arm64: "stp x29, x30" "mov x[0-9]+, x29"
// amd64: "pushq %rbp" "movq %rbp, %r"
// llvm: "llvm.frameaddress.p0" "attributes #[0-9]+ = [{][^}]*noinline \"frame-pointer\"=\"all\" \"disable-tail-calls\"=\"true\""

// The fault boundary frames call the entry (rt.call_c2) with a call, not
// a tail call: the callee's frame stays below the boundary (gotcha
// boundary-frame-tail-call). The LLVM side is the attribute above.
// func entry.main_on_fiber
// arm64: "blr x[0-9]+"
// amd64: "callq \*%r"
// func tasks.run_entry
// arm64: "blr x[0-9]+"
// amd64: "callq \*%r"
