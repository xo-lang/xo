// Codegen patterns (decision 0217, `xo dev codegen`): integer arithmetic
// by constants.

// A multiply by a power of two is a shift; the overflow check stays.
fn times8(x: Int) -> Int {
  // arm64: "lsl x[0-9]+, x[0-9]+, #3" "smulh" -"\tmul "
  // llvm: "llvm.smul.with.overflow.i64\(i64 %v0, i64 8\)"
  x * 8
}

// A signed division by a power of two is shifts, with the rounding
// toward zero; no divide instruction.
fn div4(x: Int) -> Int {
  // arm64: "asr x[0-9]+, x[0-9]+, #2" -"sdiv"
  x / 4
}

// A multiply by 3 is an add of a shifted register.
fn fold() -> Int {
  // arm64: "add x[0-9]+, x[0-9]+, x[0-9]+, lsl #1" -"\tmul "
  3 * 7 + 1
}

// A mask whose ones run past bit 63 is a logical immediate too: one and.
fn clear_low(x: Int) -> Int {
  // arm64: "and x[0-9]+, x[0-9]+, #-4" -"mov x[0-9]+, #-4"
  x & -4
}

// A one bit test branches on the bit: tbz or tbnz, no and and compare.
fn bit1(x: Int) -> Int {
  // arm64: "tb(n)?z x[0-9]+, #1," -"and x[0-9]+, x[0-9]+, #2"
  if x & 2 == 0 {
    return 7
  }
  9
}

// A test of several bits against zero is a tst, no and.
fn low_bits(x: Int) -> Bool {
  // arm64: "tst x[0-9]+, #12" -"and x[0-9]+, x[0-9]+, #12"
  x & 12 != 0
}

fn main(os: Os) {
  let n = os.env.args().len()
  os.stdio.println("${times8(n)} ${div4(n)} ${fold()} ${clear_low(n + 6)} ${bit1(n)} ${low_bits(n)}")
}
