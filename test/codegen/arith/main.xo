// Codegen patterns (decision 0217, `xo dev codegen`): integer arithmetic
// by constants.

// A multiply by a power of two is a shift; the overflow check stays.
fn times8(x: Int) -> Int {
  // arm64: "lsl x[0-9]+, x[0-9]+, #3" "smulh" -"\tmul "
  // amd64: "imulq \$8, %r[a-z0-9]+, %r" -"idivq"
  // llvm: "llvm.smul.with.overflow.i64\(i64 %v0, i64 8\)"
  x * 8
}

// A signed division by a power of two is shifts, with the rounding
// toward zero; no divide instruction.
fn div4(x: Int) -> Int {
  // arm64: "asr x[0-9]+, x[0-9]+, #2" -"sdiv"
  // amd64: "sarq \$2, %r" -"idivq"
  x / 4
}

// Constants fold: the result alone.
fn fold() -> Int {
  // arm64: "mov x0, #22" -"\tmul " -"lsl"
  // amd64: "movl \$22, %eax" -"imul"
  3 * 7 + 1
}

// A multiply by 3 is an add of a shifted register.
fn times3(x: Int) -> Int {
  // arm64: "add x[0-9]+, x[0-9]+, x[0-9]+, lsl #1" -"\tmul "
  // amd64: "imulq \$3, %r[a-z0-9]+, %r" -"idivq"
  x * 3
}

// A mask whose ones run past bit 63 is a logical immediate too: one and.
fn clear_low(x: Int) -> Int {
  // arm64: "and x[0-9]+, x[0-9]+, #-4" -"mov x[0-9]+, #-4"
  // amd64: "andq \$-4, %r" -"movq \$-4"
  x & -4
}

// A one bit test branches on the bit: tbz or tbnz, no and and compare.
fn bit1(x: Int) -> Int {
  // arm64: "tb(n)?z x[0-9]+, #1," -"and x[0-9]+, x[0-9]+, #2"
  // amd64: "btq \$1, %r" -"andq \$2"
  if x & 2 == 0 {
    return 7
  }
  9
}

// A test of several bits against zero is a tst, no and.
fn low_bits(x: Int) -> Bool {
  // arm64: "tst x[0-9]+, #12" -"and x[0-9]+, x[0-9]+, #12"
  // amd64: "testq \$12, %r" -"andq \$12"
  x & 12 != 0
}

const WORD = 3400

// A quotient and a remainder of constants fold: one add of the result,
// no shift or divide at run time.
fn word_index(x: Int) -> Int {
  // arm64: "adds x[0-9]+, x[0-9]+, #425" -"asr" -"sdiv"
  // amd64: "addq \$425, %r" -"sarq" -"idivq"
  x + WORD / 8
}

fn word_rem(x: Int) -> Int {
  // arm64: "adds x[0-9]+, x[0-9]+, #5" -"sdiv" -"msub"
  // amd64: "addq \$5, %r" -"idivq" -"imul"
  x + WORD % 7
}

// A constant division by zero is not folded: it divides (and faults) at
// run time.
fn by_zero(x: Int) -> Int {
  // arm64: "sdiv"
  // amd64: "idivq"
  if x > 100 {
    return WORD / 0
  }
  x
}

// A remainder by a constant under 0x110000 is a valid Rune unless it is
// negative: the ranges decide the over-max and surrogate compares, so the
// check is one compare and branch, no cset or orr chain.
fn rune_rem(v: Int) -> Int {
  // arm64: "cmp x[0-9]+, #0" -"cset" -"#1114111"
  // amd64: "cmpq \$0, %r" -"idivq" -"1114111"
  Int(Rune(v % 55296))
}

// A UInt64 remainder by a constant multiplies high by the unsigned magic
// number (rt.u64_divc), not an sdiv and a zero check (2026-10-23). An
// unsigned value cannot reach smulh, the signed high multiply, so the
// sdiv is the guard that can fire (a variant `x % (x + 1)` shows it,
// 2026-10-26).
fn u64_mod(x: UInt64) -> UInt64 {
  // arm64: "umulh" -"sdiv"
  // amd64: "mulq %r" -"divq"
  x % 1000
}

// `a & (b ^ -1)` is one bic, `a | (b ^ -1)` one orn: the complement as
// the operand, no eor (2026-10-24: the SWAR helpers' `& (w ^ -1)`).
fn and_not(a: Int, b: Int) -> Int {
  // arm64: "bic x[0-9]+, x[0-9]+, x[0-9]+" -"eor"
  a & (b ^ -1)
}

fn or_not(a: Int, b: Int) -> Int {
  // arm64: "orn x[0-9]+, x[0-9]+, x[0-9]+" -"eor"
  (-1 ^ b) | a
}

fn main(os: Os) {
  let n = os.env.args().len()
  os.stdio.println("${times8(n)} ${div4(n)} ${fold()} ${times3(n)} ${clear_low(n + 6)} ${bit1(n)} ${low_bits(n)} ${word_index(n)} ${word_rem(n)} ${by_zero(n)} ${rune_rem(n * 7919)} ${u64_mod(UInt64(n) * 12345)} ${and_not(n * 5, n)} ${or_not(n, n * 3)} ${digit_or(n + 50)} ${packed(n)} ${packed_mask(n)} ${page_cmp(n)} ${page_cmn(n)}")
}

// `d < 0 || d > 9` of a `d = x - 48` is one unsigned compare (isel
// range_or_join), as `x >= 48 && x <= 57` is: no sign test and no second
// branch (DS-1, 2026-10-24).
fn digit_or(x: Int) -> Int {
  // arm64: "cmp x[0-9]+, #9" "b\.(hi|ls)" -"tbnz" -"b\.gt"
  // amd64: "cmpq \$9, %r" "\t(jbe|ja) " -"\tjg "
  let d = x - 48
  if d < 0 || d > 9 {
    return -1
  }
  d
}

// The bounds of `|` and `<<` (ranges.xo, 2026-10-25): a byte shifted up
// and or'd with a constant is below 2^16, so the shift of it by 40 loses
// no bit (no overflow check), and a mask of 2^16 - 1 over it changes
// nothing (no and). text.digits_word's words were checked and masked. A
// checked shift calls the runtime as _xo_x_fault_raise_shl (a variant
// `x << 40` shows the call; the pattern named xo_fault_raise_shl and
// fault_shl, neither of which the assembly holds, 2026-10-26).
fn packed(x: Int) -> Int {
  // arm64: -"fault_raise_shl"
  // amd64: -"fault_raise_shl"
  (((x & 255) << 8) | 48) << 40
}

fn packed_mask(x: Int) -> Int {
  // arm64: -"and x[0-9]+, x[0-9]+, #65535"
  // amd64: -"andq \$65535"
  (((x & 255) << 8) | 48) & 65535
}

// A compare or add with a 12 bit immediate shifted left by 12 (0x2000,
// 0x10000) takes the immediate, which the encoder writes as `#k, lsl
// #12`: no mov of the constant (2026-10-26; a loop that kept those
// constants in registers hoisted them into every call's preheader).
fn page_cmp(x: Int) -> Bool {
  // arm64: "cmp x[0-9]+, #8192" -"mov x[0-9]+, #8192"
  // amd64: "cmpq \$8192, %r" -"movq \$8192"
  x < 0x2000
}

fn page_cmn(x: Int) -> Bool {
  // arm64: "cmn x[0-9]+, #65536" -"mov x[0-9]+, #-65536"
  // amd64: "cmpq \$-65536, %r" -"movq \$-65536"
  x == -0x10000
}
