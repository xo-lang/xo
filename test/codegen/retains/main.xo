// Codegen patterns (decision 0217, `xo dev codegen`): retains and
// releases after inlining (compiler/arm64 rcpair.xo).

// A list's Str passed to Duration.parse, which keeps it only in its
// error: the retain before the call moved into the error path
// (sink_retains), so the Ok path neither counts it up nor releases it.
// An inline retain tests bit 63 of the count (tbnz or tbz); none is laid out
// before the parse call (2026-10-26, bench/perf/text dur_parse). One
// call site, so prelude.duration_parse is inlined.
fn ok_sum(xs: List[Str]) -> Int {
  // arm64: "bl _xo_f_text_2eparse__duration" -"(?s)tbn?z x[0-9]+, #63.*bl _xo_f_text_2eparse__duration"
  // amd64: "callq _xo_f_text_2eparse__duration" -"(?s)btq \$63, [^\n]*\n.*callq _xo_f_text_2eparse__duration"
  var s = 0
  for t in xs {
    match Duration.parse(t) {
      Ok(d) => s += d.nanos() % 1000
      Err(_) => s -= 1
    }
  }
  s
}

// A retain outside loops calls the one out of line copy (rc.xo
// inc_thunk, pass rc_thunk): the object in x16 and a bl, no inline count
// test.
fn twice(xs: List[Int]) -> (List[Int], List[Int]) {
  // arm64: "mov x16, x[0-9]+\n\tbl [L_]*xo_" -"tbn?z x[0-9]+, #63"
  (xs, xs)
}

// In a loop the retain stays inline (its fast path tests bit 63 of the
// count).
fn copies(xs: List[Int], n: Int) -> List[List[Int]] {
  // arm64: "tbn?z x[0-9]+, #63" -"mov x16, x[0-9]+\n\tbl"
  var out: List[List[Int]] = []
  for _ in 0..n {
    out.push(xs)
  }
  out
}

fn main(os: Os) {
  let n = os.env.args().len()
  os.stdio.println("${ok_sum(["${n}s", "x"])}")
  let (a, b) = twice([n, 2])
  os.stdio.println("${a.len() + b.len()} ${copies(a, n).len()}")
}
