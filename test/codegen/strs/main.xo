// Codegen patterns (decision 0217, `xo dev codegen`): string literals.

// The prefix's last word is read from the literal at compile time: "rer "
// (0x20726572) is an immediate, not a load (compiler/arm64 literal_load,
// with fold_consts's Str.len of a literal, 2026-10-23).
use std/uuid

fn token_len(hs: List[Str]) -> Int {
  // arm64: "movk x[0-9]+, #8306, lsl #16"
  // amd64: "\$544367986"
  var n = 0
  for h in hs {
    n += h.trim_prefix("Bearer ").len()
  }
  n
}

// A Str compared with a constant of 1 to 16 bytes, once the lengths are
// equal, is two overlapping loads and immediates, not a call of obj.str_eq
// (compiler/arm64 calls.xo str_eq_const, 2026-10-24); 17 bytes stays a call.
fn count_nobody(hs: List[Str]) -> Int {
  // arm64: "ccmp" -"_xo_x_obj_str_eq"
  // amd64 has no str_eq_const yet (bench/results/amd64-parity-by-target-2026-10-27.md):
  // amd64: "_xo_x_obj_str_eq"
  var n = 0
  for h in hs {
    if h == "nobody" {
      n += 1
    }
  }
  n
}

fn count_long(hs: List[Str]) -> Int {
  // arm64: "_xo_x_obj_str_eq"
  // amd64: "_xo_x_obj_str_eq"
  var n = 0
  for h in hs {
    if h == "abcdefghijklmnopq" {
      n += 1
    }
  }
  n
}

const CS: Bytes = b"  hello, world"
const CP: Bytes = b"  "

// A view of a constant (cut_prefix's of CS) is the constant's immortal
// object: its release at the end of the expression is no call (isel.xo
// Release, rcpair.xo imm_post; DS-2, 2026-10-24: one release call a cut).
// The emitter writes a call as tab, bl, space, symbol (arm64 emit.xo), so
// the space form is the one that recognizes it (the tab form spelled a
// separator no line holds, 2026-10-26).
fn cut_len(n: Int) -> Int {
  // arm64: -"bl _xo_h"
  // amd64: -"callq _xo_h"
  var t = 0
  for _ in 0..n {
    t += (CS.cut_prefix(CP) ?? b"").len()
  }
  t
}

// An index that is a length halved is below the length once the length is
// at least 1, so the bounds check is gone where `len > 0` is known, and the
// shift stays (compiler/arm64 fieldlicm.xo div_of_len and len_pos,
// 2026-10-26: 67 sites of `b[b.len() / 2]` and `b[b.len() >> 1]` in
// bench/perf kept a compare and a branch that cannot fire).
fn half_byte(b: Bytes) -> Int {
  // arm64: "asr x[0-9]+, x[0-9]+, #1" -"_xo_x_fault_raise_bytes_index"
  // amd64: "sarq \$1, %r" -"_xo_x_fault_raise_bytes_index"
  if b.len() > 0 {
    return Int(b[b.len() / 2])
  }
  0
}

fn half_shift(b: Bytes) -> Int {
  // arm64: -"_xo_x_fault_raise_bytes_index"
  // amd64: -"_xo_x_fault_raise_bytes_index"
  if b.len() > 0 {
    return Int(b[b.len() >> 1])
  }
  0
}

// Without the length guard the check stays: a length of 0 makes the index 0
// too, and b[0] into an empty Bytes faults.
fn half_unguarded(b: Bytes) -> Int {
  // arm64: "bl _xo_x_fault_raise_bytes_index"
  // amd64: "callq _xo_x_fault_raise_bytes_index"
  Int(b[b.len() / 2])
}

// A shift of 0 and a division by a non-constant leave the index possibly
// equal to the length.
fn half_none(b: Bytes, one: Int) -> Int {
  // arm64: "bl _xo_x_fault_raise_bytes_index"
  // amd64: "callq _xo_x_fault_raise_bytes_index"
  if b.len() > 0 {
    return Int(b[b.len() >> 0]) + Int(b[b.len() / one])
  }
  0
}

// A list index takes the same rule (calls.xo bounds_check).
fn half_elem(xs: List[Str]) -> Str {
  // arm64: -"_xo_x_fault_raise_index"
  // amd64: -"_xo_x_fault_raise_index"
  if xs.len() > 0 {
    return xs[xs.len() / 2]
  }
  ""
}

// A guard on another Bytes proves nothing about this one's length: the
// check stays (len_pos matches the container by len_root).
fn half_other(a: Bytes, b: Bytes) -> Int {
  // arm64: "bl _xo_x_fault_raise_bytes_index"
  // amd64: "callq _xo_x_fault_raise_bytes_index"
  if a.len() > 0 {
    return Int(b[b.len() / 2])
  }
  0
}

// The false edge of `len > 0` proves nothing about the length there: only
// the true edge of a comparison is a fact (new_proof).
fn half_else(b: Bytes) -> Int {
  // arm64: "bl _xo_x_fault_raise_bytes_index"
  // amd64: "callq _xo_x_fault_raise_bytes_index"
  if b.len() > 0 {
    0
  } else {
    Int(b[b.len() / 2])
  }
}

// A guard in a block that does not dominate the index proves nothing about
// it: the fact belongs to the `> 0` edge's block only.
fn half_after(b: Bytes) -> Int {
  // arm64: "bl _xo_x_fault_raise_bytes_index"
  // amd64: "callq _xo_x_fault_raise_bytes_index"
  if b.len() > 0 {
    0
  } else {
    1
  }
  Int(b[b.len() / 2])
}

// A Str slice in a loop inlines its check (prelude.llrt_str_slice_chk:
// two unsigned compares and the two boundary loads), its fault a cold
// call of its own (prelude.str_slice_bad, ssa.cold_fn), where every
// `s[lo..hi]` was a call (2026-10-27: 19% of path's parts row). Outside a
// loop the check is still a call: 58 instructions with 16 sites is over
// the inliner's budget.
fn count_ab(hs: List[Str]) -> Int {
  // arm64: "str__slice__bad" -"llrt__str__slice__chk"
  // amd64: "str__slice__bad" -"llrt__str__slice__chk"
  var n = 0
  for h in hs {
    if h.len() > 2 && h[1..3] == "ab" {
      n += 1
    }
  }
  n
}

// A uuid's 16 bytes, only read here, are made in the frame (decision
// 0395, stacksmall.xo): no call of the string allocator on arm64; amd64
// and LLVM keep the heap.
fn uuid_byte(u: uuid.Uuid, k: Int) -> Int {
  // arm64: -"rs_with_cap"
  // amd64: "rs_with_cap"
  let b = u.bytes()
  Int(b[k % 16]) + b.len()
}

fn main(os: Os) {
  let hs = ["Bearer abc", "x", "Bearer", "nobody"]
  os.stdio.println("${token_len(hs)} ${count_nobody(hs)} ${count_long(hs)} ${cut_len(hs.len())}")
  let b = "abcde".bytes()
  os.stdio.println("${half_byte(b)} ${half_shift(b)} ${half_unguarded(b)} ${half_none(b, 2)} ${half_elem(hs)}")
  os.stdio.println("${half_other(b, b)} ${half_else(b)} ${half_after(b)} ${count_ab(hs)} ${uuid_byte(uuid.nil(), b.len())}")
}
