// Codegen patterns (decision 0217, `xo dev codegen`): string literals.

// The prefix's last word is read from the literal at compile time: "rer "
// (0x20726572) is an immediate, not a load (compiler/arm64 literal_load,
// with fold_consts's Str.len of a literal, 2026-10-23).
fn token_len(hs: List[Str]) -> Int {
  // arm64: "movk x[0-9]+, #8306, lsl #16"
  var n = 0
  for h in hs {
    n += h.trim_prefix("Bearer ").len()
  }
  n
}

// A Str compared with a constant of 1 to 16 bytes, once the lengths are
// equal, is two overlapping loads and immediates, not a call of obj.str_eq
// (compiler/arm64 calls.xo str_eq_const, 2026-10-24); 17 bytes stays a call.
fn count_nobody(hs: List[Str]) -> Int {
  // arm64: "ccmp" -"_xo_x_obj_str_eq"
  var n = 0
  for h in hs {
    if h == "nobody" {
      n += 1
    }
  }
  n
}

fn count_long(hs: List[Str]) -> Int {
  // arm64: "_xo_x_obj_str_eq"
  var n = 0
  for h in hs {
    if h == "abcdefghijklmnopq" {
      n += 1
    }
  }
  n
}

const CS: Bytes = b"  hello, world"
const CP: Bytes = b"  "

// A view of a constant (cut_prefix's of CS) is the constant's immortal
// object: its release at the end of the expression is no call (isel.xo
// Release, rcpair.xo imm_post; DS-2, 2026-10-24: one release call a cut).
// The emitter writes a call as tab, bl, space, symbol (arm64 emit.xo), so
// the space form is the one that recognizes it (the tab form spelled a
// separator no line holds, 2026-10-26).
fn cut_len(n: Int) -> Int {
  // arm64: -"bl _xo_h"
  var t = 0
  for _ in 0..n {
    t += (CS.cut_prefix(CP) ?? b"").len()
  }
  t
}

fn main(os: Os) {
  let hs = ["Bearer abc", "x", "Bearer", "nobody"]
  os.stdio.println("${token_len(hs)} ${count_nobody(hs)} ${count_long(hs)} ${cut_len(hs.len())}")
}
