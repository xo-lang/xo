// Codegen patterns (decision 0217, `xo dev codegen`): list loops.

// A loop over 0..xs.len() needs no bounds check on arm64 (the length
// fact of the loop), and reads by a scaled register offset (decision
// 0208). The LLVM emitter types the loads for alias analysis (tbaa). A
// bounds check is a b.hs to the function's local fault label (the
// pattern was -"_xo_fault_index", a name the code never has, until
// 2026-10-24).
fn sum(xs: List[Int]) -> Int {
  // arm64: "ldr x[0-9]+, \[x[0-9]+, x[0-9]+, lsl #3\]" -"b\.hs"
  // llvm: "load i64, ptr %t[0-9]+, !tbaa"
  var s = 0
  for i in 0..xs.len() {
    s += xs[i]
  }
  s
}

// An index `i % xs.len()` with i never negative is below the length (a
// length of 0 faults in the remainder): no bounds check (2026-10-24).
fn pick(xs: List[Int], n: Int) -> Int {
  // arm64: "sdiv" -"b\.hs"
  var s = 0
  for i in 0..n {
    s += xs[i % xs.len()]
  }
  s
}

const XS: List[Int] = [3, 1, 4, 1, 5, 9]

// A constant's list read in a loop is kept around it after the first
// read (cache_const_reads), the length's read and the element's are one
// read, and the list is immortal, so no release: no bounds check and no
// call to the allocator's release helpers, which a module function names
// as bl _xo_h<hash> (bl Lxo_drop<n> is a local label inside the runtime's
// own drop code, so it never matched there; a variant holding a List[Str]
// shows the bl _xo_h call, 2026-10-26).
fn cycle(n: Int) -> Int {
  // arm64: "_xo_x_const_once" -"b\.hs" -"bl _xo_h"
  var s = 0
  for i in 0..n {
    s += XS[i % XS.len()]
  }
  s
}

// The other edge of a guard is a fact too: `hi > xs.len()` returning
// leaves `hi <= xs.len()` for everything after it, so a loop bounded by
// hi indexes with no check of its own (2026-10-26).
fn guard_fact(xs: List[Int], hi: Int) -> Int {
  // arm64: "ldr x[0-9]+, \[x[0-9]+, x[0-9]+, lsl #3\]" -"b\.hs"
  if hi > xs.len() {
    return 0
  }
  var s = 0
  for i in 0..hi {
    s += xs[i]
  }
  s
}

// A clamp carries the same fact through the join: after `if h > xs.len()
// { h = xs.len() }` both arms have h at most the length, so the loop's
// index needs no check (the shape std's merge sort has, 2026-10-26).
fn clamp_fact(xs: List[Int], h0: Int) -> Int {
  // arm64: "ldr x[0-9]+, \[x[0-9]+, x[0-9]+, lsl #3\]" -"b\.hs"
  var h = h0
  if h > xs.len() {
    h = xs.len()
  }
  var s = 0
  for i in 0..h {
    s += xs[i]
  }
  s
}

// The fact belongs to the block the guard's other edge enters, so a
// guard on one arm of a branch does not bound the use after the join:
// the check stays (2026-10-26).
fn fact_not_dominating(xs: List[Int], hi: Int, flag: Bool) -> Int {
  // arm64: "b\.hs"
  if flag {
    if hi > xs.len() {
      return 0
    }
  }
  var s = 0
  var i = 0
  while i < hi {
    s += xs[i]
    i += 1
  }
  s
}

fn main(os: Os) {
  let n = os.env.args().len()
  os.stdio.println("${sum([1, 2, n])} ${pick([1, 2, n], 5)} ${cycle(7)}")
  os.stdio.println("${guard_fact([1, 2, n], 2)} ${clamp_fact([1, 2, n], 2)} ${fact_not_dominating([1, 2, n], 2, n > 3)}")
}
