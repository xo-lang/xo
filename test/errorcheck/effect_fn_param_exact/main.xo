// A function type inside a parameter's type is checked (core 6.2): reg
// hands h the callback a, so a handler that takes only a pure callback
// cannot be given where a reads the clock.

fn reg[fx: Effects](a: fn() -> Int uses fx, h: fn(fn() -> Int uses fx) -> Int) -> Int uses fx {
  h(a)
}

fn takes_pure(f: fn() -> Int) -> Int {
  f()
}

fn main(os: Os) {
  let n = reg(fn() -> Int {
    let _now = os.clock.now()
    1
  }, takes_pure) // ERROR XO0701 "is pure, but performs `clock`"
  os.stdio.println("${n}")
}

// the other way is sound and accepted, as on main: a handler that
// accepts a clock reader may be handed a pure callback, and the call is
// not charged the clock
fn takes_clock(f: fn() -> Int uses clock) -> Int {
  0
}

fn one() -> Int {
  1
}

pub fn widening() -> Int {
  reg(one, takes_clock)
}
