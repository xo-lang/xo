// Field wire names (decision 0277): the checker's errors and warning.
struct Dup {
  kind: Str
  other as "kind": Str // ERROR XO0411 "both have the key `kind`"
} derive Json

struct DupCase {
  user_id: Int
  other as "userId": Int // ERROR XO0411 "both have the key `userId`"
} derive Json(case: camel)

struct Empty {
  name as "": Str // ERROR XO0412 "empty wire name"
} derive Json

struct BadCase {
  a: Int
} derive Json(case: shouty) // ERROR XO0413 "unknown case `shouty`"

struct BadKey {
  a: Int
} derive Json(style: camel) // ERROR XO0413 "unknown argument `style`"

struct BadDerive {
  a: Int
} derive Eq(case: camel) // ERROR XO0413 "takes no arguments"

struct BadOption {
  a as "a,string": Int // ERROR XO0422 "unknown wire name option `string`"
  b as ",omitempty,bogus": Int // ERROR XO0422 "unknown wire name option `bogus`"
  c as ",omitempty": Int
} derive Json

struct Formats {
  a json "a" json "b": Int // ERROR XO0423 "two `json` wire strings"
  b sql "b,omitempty": Int // ERROR XO0422 "takes no options"
  c json "c,bogus": Int // ERROR XO0422 "unknown wire name option `bogus`"
  d xml "D,attr": Int // ERROR XO0424 "does not derive Xml"
  e as "e" json "": Int // ERROR XO0412 "empty `json` wire name"
} derive Json, SqlRow

struct NoSql {
  a sql "col": Int // ERROR XO0424 "does not derive SqlRow"
} derive Json

struct Unused {
  a as "A": Int // ERROR XO0414 "wire name of field `a` is unused"
}

fn main(os: Os) {
  os.stdio.println("${Unused{a: 1}.a}")
}

// Variant wire names (decision 0478).
enum DupVariant {
  Say
  Talk as "Say" // ERROR XO0411 "both have the name `Say`"
} derive Json

enum DupVariantCase {
  JoinRoom
  Other as "join_room" // ERROR XO0411 "both have the name `join_room`"
} derive Json(case: snake)

enum EmptyVariant {
  A as "" // ERROR XO0412 "empty wire name"
} derive Json

enum BadVariantCase {
  A
} derive Json(case: shouty) // ERROR XO0413 "unknown case `shouty`"

enum BadVariantKey {
  A
} derive Json(style: snake) // ERROR XO0413 "unknown argument `style`"

enum BadVariantDerive {
  A
} derive Eq(case: snake) // ERROR XO0413 "takes no arguments"

enum UnusedVariantWire {
  A as "a" // ERROR XO0414 "does not derive Json"
}

// Tagged enums (decision 0478).
enum TagNotObject {
  Count(from Int) // ERROR XO0431 "not an object"
  Ok
} derive Json(tag: "type")

enum TagCollides {
  Say(kind: Str) // ERROR XO0411 "has the tag's key `kind`"
} derive Json(tag: "kind")

struct HasKind {
  kind: Str
} derive Json

enum TagCollidesWrapped {
  Wrapped(from HasKind) // ERROR XO0411 "whose field `kind` has the tag's key"
} derive Json(tag: "kind")

enum TagContentSame {
  A(x: Int)
} derive Json(tag: "k", content: "k") // ERROR XO0411 "both have the key `k`"

enum ContentWithoutTag {
  A(x: Int)
} derive Json(content: "c") // ERROR XO0413 "needs `tag:`"

enum TagIdent {
  A(x: Int)
} derive Json(tag: kind) // ERROR XO0413 "takes a string"

enum CaseString {
  A(x: Int)
} derive Json(case: "snake") // ERROR XO0413 "takes a name, not a string"

enum TagContentPayloadOk {
  Count(from Int)
} derive Json(tag: "type", content: "value")
